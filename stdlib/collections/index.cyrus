import std::math::checked{
    checked_mul,
    checked_add,
};
import std::libc{memmove, malloc};
import std::iterator{Iterator};
import std::mem{Allocator};
import std::option{Option};

pub struct Vec<T> {
    allocator: Allocator,
    data: T*,
    cap: usize,
    len: usize,

    /// Create a new array using a specific allocator.
    pub inline fn new(allocator: Allocator) Self {
        const data: T* = allocator.alloc(@sizeof(T));
        if (!data) {
            @panic("allocation failed");
        }

        return Self {
            allocator,
            data,
            cap: 1,
            len: 0,
        };
    }

    /// Pre-allocate memory to avoid initial reallocations.
    pub inline fn with_capacity(allocator: Allocator, cap: usize) Self {
        @assert(cap != 0, "initial capacity cannot be zero");

        const size = checked_mul(cap, @sizeof(T)).unwrap();

        const data: T* = allocator.alloc(size);
        if (data == null) {
            @panic("initial allocation failed");
        }

        return Self { allocator, data, cap, len: 0 };
    }

    pub fn extend(self: const Self*, other: const Self*) {
        if (self == other) {
            const original_len = self->len;

            self->reserve(original_len);

            memmove(
                self->data + original_len,
                self->data,
                checked_mul(original_len, @sizeof(T)).unwrap()
            );

            self->len = checked_add(self->len, original_len).unwrap();
            return;
        }

        self->extend_from_ptr(other->data, other->len);
    }

    pub fn extend_from_ptr(self: Self*, ptr: T*, count: usize) {
        if (count == 0) {
            return;
        }

        const old_len = self->len;

        self->reserve(count);

        memmove(
            self->data + old_len,
            ptr,
            checked_mul(count, @sizeof(T)).unwrap()
        );

        self->len = checked_add(old_len, count).unwrap();
    }

    /// Deep copy of the array. 
    pub inline fn clone(self: const Self*, allocator: Allocator) Self {
        var vec: Vec<T> = Vec.with_capacity(allocator, self->len);
        vec.extend_from_ptr(self->data, self->len);
        return vec;
    }

    // TODO: from<V>(value: V)

    pub fn resize(self: Self*, len: usize, value: T) {
        if (len > self->len) {
            self->reserve(len - self->len);

            while (self->len < len) {
                self->push(value);
            }
        } else {
            self->len = len;
        }
    }

    pub fn reserve(self: Self*, extra: usize) {
        // const required = checked_add(self->len, extra).unwrap();
        const required = self->len + extra;

        if (required < self->len) {
            @panic("array capacity overflow");
        }

        if (required <= self->cap) {
            return;
        }

        self->grow(required);
    }

    pub fn push(self: Self*, value: T) {
        self->reserve(1);

        self->data[self->len] = value;
        self->len += 1;
    }

    pub fn pop(self: Self*) T {
        if (self->len == 0) {
            @panic("cannot pop from empty array");
        }
        
        const ch = self->data[self->len];
        self->len -= 1;
        return ch;
    }

    pub fn insert(self: Self*, index: usize, value: T) {
        if (index > self->len) {
            @panic("insertion index out of bounds");
        }

        self->reserve(1);

        const src: T* = self->data + index;
        const dst: T* = self->data + index + 1;
        const count = self->len - index;

        memmove(dst, src, count * @sizeof(T));

        self->data[index] = value;
        self->len += 1;
    }

    pub fn find(self: const Self*, cond: fn(const T*) bool) Option<T*> {
        for (var i: usize = 0; i < self->len; i += 1) {
            if (cond(self->data + i)) {
                return .Some(self->data + i);
            }
        }

        return .None;
    }

    /// Find the index of a value (Linear Search).
    pub fn index(self: const Self*, value: T) Option<usize> {
        for (var i: usize = 0; i < self->len; i += 1) {
            if (self->data[i] == value) {
                return .Some(i);
            }
        }

        return .None;
    }

    pub fn get(self: const Self*, index: usize) Option<T> {
        if (index >= self->len) {
            return .None;
        }

        return .Some(*(self->data + index));
    }

    pub inline fn get_ref(self: const Self*, index: usize) Option<T*> {
        if (index >= self->len) {
            return .None;
        }

        return .Some(self->data + index);
    }

    pub inline fn get_unchecked(self: const Self*, index: usize) T* {
        return self->data + index;
    }

    pub fn contains(self: const Self*, value: T) bool {
        // linear lookup
        for (var i: usize = 0; i < self->len; i += 1) {
            if (self->data[i] == value) {
                return true;
            }
        }

        return false;
    }

    pub fn last(self: const Self*) Option<T> {
        if (self->len() < 1) {
            return .None;
        }
        return self->get(self->len() - 1);
    }

    pub fn last_ref(self: Self*) Option<T*> {
        if (self->len() < 1) {
            return .None;
        }
        return self->get_ref(self->len() - 1);
    }

    pub fn first(self: const Self*) Option<T> {
        return self->get(0);
    }
    
    pub fn first_ref(self: const Self*) Option<const T*> {
        return self->get_ref(0);
    }

    pub fn remove(self: Self*, index: usize) T {
        if (index >= self->len) {
            @panic("index out of bounds");
        }

        const value = self->data[index];

        const src = self->data + index + 1;
        const dst = self->data + index;

        const count = self->len - index - 1;

        memmove(dst, src, count * @sizeof(T));

        self->len -= 1;

        return value;
    }

    pub inline fn len(self: const Self*) usize {
        return self->len;
    }

    pub inline fn cap(self: const Self*) usize {
        return self->cap;
    }

    pub inline fn is_empty(self: const Self*) bool {
        return self->len == 0;
    }

    pub inline fn clear(self: Self*) {
        self->len = 0;
    }

    pub inline fn reset(self: Self*) {
        self->len = 0;
    }

    pub inline fn data(self: Self*) T* {
        return self->data;
    }

    pub inline fn data_const(self: const Self*) const T* {
        return self->data;
    }

    pub inline fn into_iter(self: const Self*) VecIter<T> {
        return struct { vec: self, idx: 0 };
    }

    pub inline fn free(self: Self*) {
        if (self->data != null) {
            self->allocator.free(self->data);
            self->data = null;
            self->len = 0;
            self->cap = 0;
        }
    }

    // internals 

    fn grow(self: Self*, min_cap: usize) {
        var new_cap: usize;

        if (self->cap == 0) {
            new_cap = 1;
        } else {
            new_cap = self->cap;
        }

        // exponential growth (2x)
        while (new_cap < min_cap) {
            new_cap = checked_mul(new_cap, 2).unwrap();
        }

        const new_data: T* = self->allocator.realloc(
            self->data,
            new_cap * @sizeof(T)
        );

        if (new_data == null) {
            @panic("realloc failed");
        }

        self->data = new_data;
        self->cap = new_cap;
    }
}

pub struct VecIter<T> : Iterator<T> {
    vec: const Vec<T>*,
    idx: usize,

    pub fn next(self: Self*) Option<T*> {
        if (self->idx + 1 > self->vec->len()) {
            return .None;
        }

        const data = self->vec->data();
        const item = &data[self->idx];
        self->idx += 1;
        return .Some(item);
    }

    pub fn next_const(self: const Self*) Option<const T*> {
        if (self->idx + 1 > self->vec->len()) {
            return .None;
        }
        
        const data = self->vec->data();
        const item = &data[self->idx];
        self->idx += 1;
        return .Some(item);
    }
}

pub struct Map<K, V> {
    entries: Vec<(K, V)>,

    pub inline fn new(allocator: Allocator) Self {
        return Self { entries: Vec.new(allocator) };
    }

    pub fn set(self: Self*, key: K, value: V) bool {
        if (self->get(key).is_some()) {
            return false;
        }

        self->entries.push((key, value));
        return true;
    }

    pub fn get(self: const Self*, key: K) Option<V> {
        const len = self->entries.len();
        const data = self->entries.data_const();

        // linear search
        for (var i: usize = 0; i < len; i += 1) {
            const item = data[i];
            
            if (item.0 == key) {
                return .Some(item.1);
            }
        }

        return .None;
    }

    pub inline fn free(self: Self*) {
        self->entries.free();
    }
}
