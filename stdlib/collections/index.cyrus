import std::libc{memmove, malloc};
import std::mem{Allocator};
import std::option{Option};
import std::iterator{Iterator};

pub struct Vec<T> {
    allocator: Allocator,
    data: T*,
    cap: usize,
    len: usize,

    /// Create a new array using a specific allocator.
    pub inline fn new(allocator: Allocator) Self {
        const cap: usize = 1;
        const data: T* = allocator.alloc(cap * @sizeof(T));
        if (!data) {
            @panic("allocation failed");
        }

        return Self {
            allocator,
            data,
            cap,
            len: 0,
        };
    }

    /// Pre-allocate memory to avoid initial reallocations.
    pub inline fn with_capacity(allocator: Allocator, cap: usize) Self {
        @assert(cap != 0, "initial capacity cannot be zero");

        const data: T* = allocator.alloc(cap * @sizeof(T));
        if (data == null) {
            @panic("initial allocation failed");
        }

        return Self { allocator, data, cap, len: 0 };
    }

    pub inline fn extend(self: const Self*, other: const Self*) {
        if (self == other) {
            var original_len = self->len;

            self->reserve(original_len);
            
            memmove(
                self->data + original_len,
                self->data,
                original_len * @sizeof(T)
            );

            self->len += original_len;

            return;
        }

        self->extend_from_ptr(other->data, other->len);
    }

    pub inline fn extend_from_ptr(self: Self*, ptr: T*, count: usize) {
        if (count == 0) {
            return;
        }

        const old_len = self->len;

        self->reserve(count);

        memmove(
            self->data + old_len,
            ptr,
            count * @sizeof(T)
        );

        self->len = old_len + count;
    }

    /// Deep copy of the array. 
    pub inline fn clone(self: const Self*, allocator: Allocator) Self {
        var vec: Vec<T> = Vec.with_capacity(allocator, self->len);
        vec.extend_from_ptr(self->data, self->len);
        return vec;
    }

    // TODO: from<V>(value: V)

    pub inline fn resize(self: Self*, len: usize, value: T) {
        if (len > self->len) {
            self->reserve(len - self->len);

            while (self->len < len) {
                self->push(value);
            }
        } else {
            self->len = len;
        }
    }

    pub inline fn reserve(self: Self*, extra: usize) {
        const required = self->len + extra;

        if (required < self->len) {
            @panic("array capacity overflow");
        }

        if (required <= self->cap) {
            return;
        }

        self->grow(required);
    }

    pub inline fn push(self: Self*, value: T) {
        self->reserve(1);

        self->data[self->len] = value;
        self->len += 1;
    }

    pub inline fn pop(self: Self*) T {
        if (self->len == 0) {
            @panic("cannot pop from empty array");
        }
        
        const ch = self->data[self->len];
        self->len -= 1;
        return ch;
    }

    pub inline fn insert(self: Self*, index: usize, value: T) {
        if (index > self->len) {
            @panic("insertion index out of bounds");
        }

        self->reserve(1);

        const src: T* = self->data + index;
        const dst: T* = self->data + index + 1;
        const count = self->len - index;

        memmove(dst, src, count * @sizeof(T));

        self->data[index] = value;
        self->len += 1;
    }

    /// Find the index of a value (Linear Search).
    pub inline fn index(self: const Self*, value: T) Option<usize> {
        for (var i: usize = 0; i < self->len; i += 1) {
            if (self->data[i] == value) {
                return .Some(i);
            }
        }

        return .None;
    }

    pub inline fn get_unchecked(self: const Self*, index: usize) T* {
        return self->data + index;
    }

    pub inline fn get(self: const Self*, index: usize) Option<T> {
        if (index >= self->len) {
            return .None;
        }

        return .Some(*(self->data + index));
    }

    pub inline fn get_ref(self: const Self*, index: usize) Option<T*> {
        if (index >= self->len) {
            return .None;
        }

        return .Some(self->data + index);
    }

    pub inline fn contains(self: const Self*, value: T) bool {
        // linear lookup
        for (var i: usize = 0; i < self->len; i += 1) {
            if (self->data[i] == value) {
                return true;
            }
        }

        return false;
    }

    pub inline fn len(self: const Self*) usize {
        return self->len;
    }

    pub inline fn cap(self: const Self*) usize {
        return self->cap;
    }

    pub inline fn is_empty(self: const Self*) bool {
        return self->len == 0;
    }

    pub inline fn clear(self: Self*) {
        self->len = 0;
    }

    pub inline fn reset(self: Self*) {
        self->len = 0;
    }

    pub inline fn remove(self: Self*, index: usize) T {
        if (index >= self->len) {
            @panic("index out of bounds");
        }

        const value = self->data[index];

        const src = self->data + index + 1;
        const dst = self->data + index;

        const count = self->len - index - 1;

        memmove(dst, src, count * @sizeof(T));

        self->len -= 1;

        return value;
    }

    pub inline fn data(self: Self*) T* {
        return self->data;
    }

    pub inline fn data_const(self: const Self*) const T* {
        return self->data;
    }

    // FIXME
    // pub inline fn iter(self: const Self*) Iterator<T> {
    //     const vector_iter: VecIter<T> = VecIter {
    //         vector: self,
    //         index: 0
    //     };
        
    //     return dynamic vector_iter;
    //     // @todo();
    // }

    pub inline fn free(self: Self*) {
        if (self->data != null) {
            self->allocator.free(self->data);
            self->data = null;
            self->len = 0;
            self->cap = 0;
        }
    }

    // internals 

    fn grow(self: Self*, min_cap: usize) {
        var new_cap: usize;

        if (self->cap == 0) {
            new_cap = 1;
        } else {
            new_cap = self->cap;
        }

        // exponential growth (2x)
        while (new_cap < min_cap) {
            new_cap *= 2;
        }

        const new_data: T* = self->allocator.realloc(
            self->data,
            new_cap * @sizeof(T)
        );

        if (new_data == null) {
            @panic("realloc failed");
        }

        self->data = new_data;
        self->cap = new_cap;
    }
}

