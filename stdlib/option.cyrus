pub enum Option<T> {
    Some(T),
    None

    pub inline fn unwrap(self: const Self*) T {
        switch (*self) {
            case .Some(value) => return value;
            case .None => @panic("called `Option.unwrap()` on a `None` value");
        }
    }

    pub inline fn unwrap_or(self: const Self*, or_value: T) T {
        switch (*self) {
            case .Some(value) => return value;
            case .None => return or_value;
        }
    }

    pub inline fn expect(self: const Self*, msg: const uint8*) T {
        switch (*self) {
            case .Some(value) => return value;
            case .None => @panic(msg);
        }
    }
    
    pub inline fn is_some(self: const Self*) bool {
        switch (*self) {
            case .Some(_) => return true;
            case .None => return false;
        }
    }

    pub inline fn is_none(self: const Self*) bool {
        switch (*self) {
            case .Some(_) => return false;
            case .None => return true;
        }
    }
}