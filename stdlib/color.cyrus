import std::io{Writer};

pub const RESET = "\x1B[0m";
pub const BOLD = "\x1B[1m";
pub const DIM = "\x1B[2m";
pub const ITALIC = "\x1B[3m";
pub const UNDERLINE = "\x1B[4m";
pub const BLINK = "\x1B[5m";
pub const REVERSE = "\x1B[7m";
pub const HIDDEN = "\x1B[8m";
pub const STRIKE = "\x1B[9m";

pub const FG_BLACK = "\x1B[30m";
pub const FG_RED = "\x1B[31m";
pub const FG_GREEN = "\x1B[32m";
pub const FG_YELLOW = "\x1B[33m";
pub const FG_BLUE = "\x1B[34m";
pub const FG_MAGENTA = "\x1B[35m";
pub const FG_CYAN = "\x1B[36m";
pub const FG_WHITE = "\x1B[37m";
pub const FG_DEFAULT = "\x1B[39m";

pub const BG_BLACK = "\x1B[40m";
pub const BG_RED = "\x1B[41m";
pub const BG_GREEN = "\x1B[42m";
pub const BG_YELLOW = "\x1B[43m";
pub const BG_BLUE = "\x1B[44m";
pub const BG_MAGENTA = "\x1B[45m";
pub const BG_CYAN = "\x1B[46m";
pub const BG_WHITE = "\x1B[47m";
pub const BG_DEFAULT = "\x1B[49m";

pub enum Color {
    Black,
    Red,
    Green,
    Yellow,
    Blue,
    Magenta,
    Cyan,
    White,
    Default
}

pub fn fg_color(color: Color) const uint8* {
    switch (color) {
        case .Black => return FG_BLACK;
        case .Red => return FG_RED;
        case .Green => return FG_GREEN;
        case .Yellow => return FG_YELLOW;
        case .Blue => return FG_BLUE;
        case .Magenta => return FG_MAGENTA;
        case .Cyan => return FG_CYAN;
        case .White => return FG_WHITE;
        case .Default => return FG_DEFAULT;
    }
}

pub fn bg_color(color: Color) const uint8* {
    switch (color) {
        case .Black => return BG_BLACK;
        case .Red => return BG_RED;
        case .Green => return BG_GREEN;
        case .Yellow => return BG_YELLOW;
        case .Blue => return BG_BLUE;
        case .Magenta => return BG_MAGENTA;
        case .Cyan => return BG_CYAN;
        case .White => return BG_WHITE;
        case .Default => return BG_DEFAULT;
    }
}

pub fn colorize(writer: Writer, color: Color) {
    writer.write(fg_color(color));
}

pub fn reset(writer: Writer) {
    writer.write(RESET);
}

pub fn colorize_fg(writer: Writer, color: Color, str: const uint8*) {
    writer.write(fg_color(color));
    writer.write(str);
    writer.write(RESET);
}

pub fn colorize_bg(writer: Writer, color: Color, str: const uint8*) {
    writer.write(bg_color(color));
    writer.write(str);
    writer.write(RESET);
}

pub fn bold(writer: Writer) {
    writer.write(BOLD);
}

pub fn dim(writer: Writer) {
    writer.write(DIM);
}

pub fn italic(writer: Writer) {
    writer.write(ITALIC);
}