import std::libc{getenv};
import std::option{Option};
import std::string{String};
import std::mem{Allocator};

pub extern "C" {
    fn setenv(name: const uint8*, value: const uint8*, overwrite: int32) int32;
    fn unsetenv(name: const uint8*) int32;
}

pub fn get(name: const uint8*) Option<const uint8*> {
    @assert(name != null, "name cannot be null");
    const val = getenv(name);
    if (val == null) {
        return .None;
    }
    return .Some(val);
}

pub fn get_string(allocator: Allocator, name: const uint8*) Option<String> {
    @assert(name != null, "name cannot be null");
    const val = getenv(name);
    if (val == null) {
        return .None;
    }
    return .Some(String.from_str(allocator, val));
}

pub fn has(name: const uint8*) bool {
    @assert(name != null, "name cannot be null");
    return getenv(name) != null;
}

pub fn set(name: const uint8*, value: const uint8*) bool {
    @assert(name != null, "name cannot be null");
    @assert(value != null, "value cannot be null");
    return setenv(name, value, 1) == 0;
}

pub fn remove(name: const uint8*) bool {
    @assert(name != null, "name cannot be null");
    return unsetenv(name) == 0;
}