import std::libc{strlen, strcmp, memmove, isspace, tolower, toupper};
import std::collections{Vec};
import std::libc::types{c_int};
import std::option{Option};
import std::mem{Allocator};
import std::slices{Slice};

pub struct String {
    vec: Vec<uint8>,

    pub fn new(const allocator: Allocator) Self {
        var vec: Vec<uint8> = Vec.new(allocator);
        vec.push('\0'); // null-terminated
        return Self { vec };
    }

    pub fn with_capacity(const allocator: Allocator, const cap: usize) Self {
        var vec: Vec<uint8> = Vec.with_capacity(allocator, cap);
        vec.push('\0'); // null-terminated
        return Self { vec };
    }

    pub fn from_str(const allocator: Allocator, const str: const uint8*) Self {
        @assert(str, "input string cannot be null");

        const len = strlen(str);

        var vec: Vec<uint8> = Vec.new(allocator);
        for (var i: usize = 0; i < len; i += 1) {
            vec.push(str[i]);
        }
        vec.push('\0');
    
        return Self { vec };
    }

    pub fn from_slice(const allocator: Allocator, const slice: const Slice<uint8>) Self {
        var vec: Vec<uint8> = Vec.new(allocator);
        for (var i: usize = 0; i < slice.len(); i += 1) {
            const item = slice.get_const(i).unwrap();

            vec.push(*item);
        }
        vec.push('\0');
        return Self { vec };
    }

    pub fn reserve(self: Self*, const extra: usize) {
        const required = self->len() + extra;
        
        if (required > self->cap()) {
            self->vec.reserve(required);
        }
    }

    pub fn push(self: Self*, const ch: uint8) {        
        var data = self->vec.data();
        var current = &data[self->len()];
        *current = ch;
        self->vec.push('\0');
    }

    pub fn push_str(self: Self*, const str: const uint8*) {
        @assert(str, "input string cannot be null");

        const len = strlen(str);

        self->reserve(len);
        self->vec.pop();
        for (var i: usize = 0; i < len; i += 1) {
            self->vec.push(str[i]);
        }        
        self->vec.push('\0');
    }
    
    // TODO: Add method: replace

    pub inline fn trim(self: Self*) {
        self->trim_start();
        self->trim_end();
    }

    pub fn trim_start(self: Self*) {
        var str: const uint8* = self->as_str_const();
        const len = self->vec.len();

        var start: usize = 0;
        while (start < len - 1 && isspace(@cast(c_int, str[start])) != 0) {
            start += 1;
        }

        if (start >= len - 1) {
            self->clear();
            return;
        }

        const n = len - start;
        memmove(@cast(void*, str), @cast(void*, str + start), n);

        while (start > 0) {
            self->vec.pop();
            start -= 1;
        }
    }

    pub fn trim_end(self: Self*) {
        const str = self->as_str_const();
        var len = self->len();

        if (len <= 1) {
            return;
        }

        while (len > 1 && isspace(@cast(c_int, str[len - 1])) != 0) {
            self->vec.pop();
            len -= 1;
        }
    }

    pub fn to_lower(self: Self*) {
        var str = self->as_str();

        for (var i: usize = 0; i < self->vec.len(); i += 1) {
            str[i] = @cast(uint8, tolower(@cast(c_int, str[i])));
        }
    }

    pub fn to_upper(self: Self*) {
        var str = self->as_str();

        for (var i: usize = 0; i < self->vec.len(); i += 1) {
            str[i] = @cast(uint8, toupper(@cast(c_int, str[i])));
        }
    }

    pub inline fn get(self: const Self*, index: usize) Option<uint8> {
        if (index > self->len()) {
            return .None;
        }

        return .Some(self->as_str_const()[index]);
    }

    pub inline fn as_str(self: Self*) uint8* {
        return self->vec.data();
    }

    pub inline fn as_str_const(self: const Self*) const uint8* {
        return self->vec.data_const();
    }

    pub inline fn is_empty(self: const Self*) bool {
        return self->len() == 0;
    }

    pub inline fn cap(self: const Self*) usize {
        return self->vec.cap();
    }

    pub inline fn len(self: const Self*) usize {
        return self->vec.len() - 1; // exclude '\0'
    }

    pub inline fn eq(self: const Self*, other: Self*) bool {
        return strcmp(self->as_str_const(), other->as_str_const()) == 0;
    }

    pub inline fn clear(self: Self*) {
        self->vec.clear();
        self->vec.push('\0');
    }

    pub inline fn free(self: Self*) {
        self->vec.free();
    }
}
