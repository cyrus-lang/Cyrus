import std::libc;

pub interface Allocator {
	fn alloc(self: Self*, size: usize) void*;
	fn alloc_zeroed(self: Self*, size: usize) void*;
	fn alloc_aligned(self: Self*, size: usize, align: usize) void*;
	fn realloc(self: Self*, ptr: void*, size: usize) void*;
	fn free(self: Self*, ptr: void*) void;
}

[[inline]]
pub fn alloc_init<T>(allocator: Allocator, value: T) T* {
	var heap: T* = allocator.alloc(@sizeof(T));
	if (!heap) { return null; }
	*heap = value;
	return heap;
}

[[inline]]
pub fn align_up(ptr: uintptr, align: usize) uintptr {
	@assert(is_power_of_two(align), "alignment must be power of two");
	
	return (ptr + (align - 1)) & ~(align - 1);
}

[[inline]]
pub fn is_power_of_two<T>(v: T) bool {
	return v != 0 && (v & (v - 1)) == 0;
}