import std::mem{
    Allocator,
    is_power_of_two,
    align_up
};

struct PoolChunk {
    pub next: PoolChunk*,
}

pub struct PoolAllocator : Allocator {
    buffer: uint8*,
    buffer_cap: usize,
    chunk_size: usize,
    actual_chunk_size: usize,
    total_chunks: usize,
    used_chunks: usize,
    free_list: PoolChunk*,

    [[inline]]
    pub fn new(buffer: uint8*, buffer_cap: usize, chunk_size: usize) Self {
        @assert(buffer != null, "buffer cannot be null");
        @assert(chunk_size > 0, "chunk size must be greater than zero");

        var actual_chunk = chunk_size;
        if (actual_chunk < @sizeof(PoolChunk)) {
            actual_chunk = @sizeof(PoolChunk);
        }

        actual_chunk = @cast(usize, align_up(@cast(uintptr, actual_chunk), @sizeof(usize)));

        const total_chunks = buffer_cap / actual_chunk;
        @assert(total_chunks > 0, "buffer is too small for even one chunk");

        var pool = Self {
            buffer,
            buffer_cap,
            chunk_size,
            actual_chunk_size: actual_chunk,
            total_chunks,
            used_chunks: 0,
            free_list: null,
        };

        pool.init_free_list();
        return pool;
    }

    fn init_free_list(self: Self*) {
        self->free_list = null;
        self->used_chunks = 0;

        for (var i: usize = 0; i < self->total_chunks; i += 1) {
            const chunk_offset = i * self->actual_chunk_size;
            var chunk: PoolChunk* = @cast(void*, self->buffer + chunk_offset);
            chunk->next = self->free_list;
            self->free_list = chunk;
        }
    }

    [[inline]]
    pub fn alloc(self: Self*, size: usize) void* {
        if (size > self->chunk_size) {
            return null; // Cannot allocate bigger than chunk_size
        }

        if (self->free_list == null) {
            return null; 
        }

        var chunk = self->free_list;
        self->free_list = chunk->next;
        self->used_chunks += 1;

        return @cast(void*, chunk);
    }

    [[inline]]
    pub fn alloc_aligned(self: Self*, size: usize, align: usize) void* {
        @assert(is_power_of_two(align), "alignment must be a power of two");
        
        if (align > @sizeof(usize)) {
            return null; 
        }

        return self->alloc(size);
    }

    [[inline]]
    pub fn alloc_zeroed(self: Self*, size: usize) void* {
        const ptr = self->alloc(size);
        if (ptr != null) {
            @memset(ptr, 0, self->actual_chunk_size);
        }
        return ptr;
    }

    [[inline]]
    pub fn realloc(self: Self*, ptr: void*, size: usize) void* {
        if (ptr == null) {
            return self->alloc(size);
        }

        if (size == 0) {
            self->free(ptr);
            return null;
        }

        if (size <= self->chunk_size) {
            return ptr; 
        }

        return null; 
    }

    [[inline]]
    pub fn free(self: Self*, ptr: void*) {
        if (ptr == null) {
            return;
        }

        var chunk: PoolChunk* = ptr;
        chunk->next = self->free_list;
        self->free_list = chunk;

        if (self->used_chunks > 0) {
            self->used_chunks -= 1;
        }
    }

    [[inline]]
    pub fn reset(self: Self*) {
        self->init_free_list();
    }

    [[inline]]
    pub fn active_count(self: const Self*) usize {
        return self->used_chunks;
    }

    [[inline]]
    pub fn available_count(self: const Self*) usize {
        return self->total_chunks - self->used_chunks;
    }

    [[inline]]
    pub fn total_capacity(self: const Self*) usize {
        return self->total_chunks;
    }
}