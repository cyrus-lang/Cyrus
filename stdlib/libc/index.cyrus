// time 

[[repr(c)]]
pub struct CTimeSpec {
    tv_sec: types::c_long,
    tv_nsec: types::c_long
}

[[repr(c)]]
pub struct CTimeVal {
    tv_sec: types::c_long,
    tv_usec: types::c_long
}

[[repr(c)]]
pub struct CTm {
    tm_sec: types::c_int,
    tm_min: types::c_int,
    tm_hour: types::c_int,
    tm_mday: types::c_int,
    tm_mon: types::c_int,
    tm_year: types::c_int,
    tm_wday: types::c_int,
    tm_yday: types::c_int,
    tm_isdst: types::c_int,
    tm_gmtoff: types::c_long,
    tm_zone: types::c_char*
}

pub extern "C" {
    fn clock() types::c_long;
    fn difftime(time1: types::c_long, time0: types::c_long) types::c_double;
    fn mktime(tm: CTm*) types::c_long;
    fn time(timer: types::c_long*) types::c_long;

    fn asctime(tm: const CTm*) types::c_char*;
    fn ctime(timer: const types::c_long*) types::c_char*;

    fn gmtime(timer: const types::c_long*) CTm*;
    fn localtime(timer: const types::c_long*) CTm*;

    fn gmtime_r(timer: const types::c_long*, result: CTm*) CTm*;
    fn localtime_r(timer: const types::c_long*, result: CTm*) CTm*;

    fn strftime(
        s: types::c_char*,
        max: types::c_size,
        format: const types::c_char*,
        tm: const CTm*
    ) types::c_size;

    fn timespec_get(ts: CTimeSpec*, base: types::c_int) types::c_int;
}

