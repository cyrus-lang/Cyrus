import std::option{Option};

pub interface Iter<T> {
    fn next(self: Self*) Option<T*>;
}

pub interface IterConst<T> {
    fn next(self: Self*) Option<const T*>;
}

pub interface IterOwned<T> {
    fn next(self: Self*) Option<T>;
}