import std::option{Option};

pub struct Slice<T> {
    ptr: T*,
    len: usize,

    [[inline]]
    pub fn new(ptr: T*, len: usize) Self {
        return Self { ptr, len };
    }

    [[inline]]
    pub fn ptr(self: Self*) T* {
        return self->ptr;
    }

    [[inline]]
    pub fn ptr_const(self: const Self*) const T* {
        return self->ptr;
    }

    [[inline]]
    pub fn get(self: Self*, index: usize) Option<T> {
        if (index >= self->len) {
            return .None;
        }

        return .Some(*(self->ptr + index));
    }
    

    [[inline]]
    pub fn get_ref(self: Self*, index: usize) Option<T*> {
        if (index >= self->len) {
            return .None;
        }

        return .Some(self->ptr + index);
    }
    
    [[inline]]
    pub fn get_const(self: const Self*, index: usize) Option<const T*> {
        if (index >= self->len) {
            return .None;
        }

        return .Some(self->ptr + index);
    }
    
    [[inline]]
    pub fn range(self: const Self*, start: usize, end: usize) Self {
        return Self { ptr: self->ptr + start, len: end - start };
    }

    [[inline]]
    pub fn range_inclusive(self: const Self*, start: usize, end: usize) Self {
        return Self { ptr: self->ptr + start, len: end - start + 1 };
    }

    [[inline]]
    pub fn len(self: const Self*) usize {
        return self->len;
    }
}