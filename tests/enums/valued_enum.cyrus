// @stdout: (errno = 1, mesg = file not found) custom(3, custom err mesg)

import std::libc{printf};

enum OSError {
    FileNotFound = struct { errno: 1, mesg: "file not found" },
    BufferOverflow = struct { errno: 2, mesg: "buffer overflow" },
    Custom(int32, uint8*)
}

fn display_os_error(err: OSError) {
    switch (err) {
        case .FileNotFound(detail) => {
            printf("(errno = %d, mesg = %s) ", detail.errno, detail.mesg);
        }
        case .Custom(errno, mesg) => {
            printf("custom(%d, %s)", errno, mesg);
        }
        else => {
            printf("unknown error");
        }
    }
}

pub fn main() {
    var err = OSError.FileNotFound;

    display_os_error(err);
    display_os_error(.Custom(3, "custom err mesg"));
}