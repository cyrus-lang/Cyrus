// @stdout: id: 99, score: 99.5, flag: 1 | SUCCESS

import std::libc{printf};

struct Data {
    pub id: int32,
    pub score: float64,
    pub flag: bool
}

pub fn main() {
    var src = Data { id: 99, score: 99.5, flag: true };
    var dest: Data;

    // Copy src to dest
    @memcpy(&dest, &src, @sizeof(Data));

    printf("id: %d, score: %.1f, flag: %d", dest.id, dest.score, dest.flag);

    if ((dest.id == 99 && dest.score == 99.5) && dest.flag == true) {
        printf(" | SUCCESS\n");
    } else {
        printf("FAILURE: data mismatch\n");
    }
}