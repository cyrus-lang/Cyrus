// @stdout: name: Cyrus, age: 2500

import std::libc{printf};

struct Data {
    pub name: uint8*,
    pub age: uint32
}

pub fn main() {
    var dest: Data;
    var src = struct {
        name: "Cyrus",
        age: 2500
    };

    @memcpy(&dest, &src, @sizeof(Data));

    printf("name: %s, age: %d\n", dest.name, dest.age);
}