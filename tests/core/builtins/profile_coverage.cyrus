// @stdout: debug validate, 50
// @compilerArgs: --profile=debug

import std::libc{printf};

@debug()
fn validate() {
    printf("debug validate, ");
}

@release()
fn validate() {
    printf("release validate, ");
}

@test()
fn validate() {
    printf("test validate, ");
}

@debug()
const MODE_VAL: int32 = 50;

@release()
const MODE_VAL: int32 = 99;

@test()
const MODE_VAL: int32 = 77;

pub fn main() {
    validate();
    printf("%d\n", MODE_VAL);
}
