// @stdout: 1234 5678

import std::libc{printf};

union DataUnion {
    i_val: int32,
    f_val: float32,
}

struct Inner {
    pub a: int32,
    pub b: int32,
}

struct Outer {
    pub inner: Inner,
    pub u: DataUnion,
}

pub fn main() {
    var o: Outer = Outer {
        inner: Inner { a: 1234, b: 5678 },
        u: DataUnion { i_val: 0 },
    };

    o.u.i_val = o.inner.a;
    printf("%d ", o.u.i_val);

    o.u.i_val = o.inner.b;
    printf("%d\n", o.u.i_val);
}
