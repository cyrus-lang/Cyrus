// @stdout: 10 20 30 none

import std::mem::libc{LibcAllocator};
import std::collections{Vec};
import std::mem{Allocator};
import std::libc{printf};

pub fn main() {
    const allocator: Allocator = dynamic LibcAllocator.new();
    
    const vec: Vec<int32> = Vec.new(allocator);
    defer vec.free();

    vec.push(10);
    vec.push(20);
    vec.push(30);

    const iter = vec.iter_owned();

    printf("%d ", iter.next_owned().unwrap());
    printf("%d ", iter.next_owned().unwrap());
    printf("%d ", iter.next_owned().unwrap());

    switch (iter.next_owned()) {
        case .None => printf("none\n");
        else => {}
    }
}