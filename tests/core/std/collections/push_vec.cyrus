// @stdout: 0 1000

import std::mem::libc{LibcAllocator};
import std::collections{Vec};
import std::mem{Allocator};
import std::libc{printf};

pub fn main() {
    var allocator: Allocator = dynamic LibcAllocator.new();
    
    var vec: Vec<int32> = Vec.new(allocator);
    defer vec.free();

    for (var i: int32 = 0; i <= 1000; i += 1) {
        vec.push(i);
    }

    const len = vec.len();
    const first = vec.first_owned().unwrap();
    const last = vec.last_owned().unwrap();

    printf("%d %d\n", first, last);
}
