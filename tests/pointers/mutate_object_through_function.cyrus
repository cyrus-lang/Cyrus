// @stdout: Cyrus

import std::libc{printf};

type ConstStr = const uint8*;

fn mutate_const_str(var str: ConstStr*) {
    *str = "Cyrus";
}

fn display_const_str(var str: ConstStr) {
    printf("%s\n", str);
}

pub fn main() {
    const name: uint8* = "unknown";

    mutate_const_str(&name);
    display_const_str(name);
}