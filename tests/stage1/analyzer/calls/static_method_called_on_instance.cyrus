struct Counter {
    pub count: int32,

    pub fn new(initial: int32) Self {
        return Self { count: initial };
    }

    pub fn increment(self: Self*) {
        self->count += 1;
    }
}

pub fn main() {
    var counter = Counter.new(1);
    counter.new(5); //~ ERROR cannot call static method `new` on an instance
}
