enum UnitEnum {
    Kind,
}

enum TupleEnum {
    Kind(int32),
}

enum StructEnum {
    Kind { value: int32 },
}

enum ValuedEnum {
    Kind = 1,
}

fn unit_to_tuple(err: UnitEnum) TupleEnum {
    return err; //~ ERROR return statement argument must be a value of type `TupleEnum` but got `UnitEnum`
}

fn tuple_to_struct(err: TupleEnum) StructEnum {
    return err; //~ ERROR return statement argument must be a value of type `StructEnum` but got `TupleEnum`
}

fn unit_to_valued(err: UnitEnum) ValuedEnum {
    return err; //~ ERROR return statement argument must be a value of type `ValuedEnum` but got `UnitEnum`
}

fn valued_to_tuple(err: ValuedEnum) TupleEnum {
    return err; //~ ERROR return statement argument must be a value of type `TupleEnum` but got `ValuedEnum`
}

pub fn main() {
    unit_to_tuple(UnitEnum.Kind);
    tuple_to_struct(TupleEnum.Kind(1));
    unit_to_valued(UnitEnum.Kind);
    valued_to_tuple(ValuedEnum.Kind);
}
