struct Empty {
}

struct Point {
    x: int32,
    y: int64,
}

struct Named {
    name: String,
    count: uint64
}

pub struct Visible {
    pub name: String,
    count: uint64,
}

struct Aligned align(8) {
    value: int32,
}

struct Wrapped<T> {
    item: T,
}

struct Constrained<T: Display + Clone = int32> {
    item: T,
}

struct Guarded : Iface {
    value: int32,
}

struct WithMethods {
    count: uint64,

    fn size(self: Self*) usize {
        return 0;
    }

    pub fn reset(self: Self*) {
    }
}

pub struct Combined align(4) <T> : Base {
    pub item: T,

    fn get(self: Self*) T {
        return item;
    }
}

