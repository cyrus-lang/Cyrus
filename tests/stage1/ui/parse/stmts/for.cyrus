// @parse

fn example() {
    for (var i = 0; i < 10; i += 1) {
        total += i;
    }

    for (var i: usize = 0; i < 5; i += 1) {
        step();
    }

    for (var i = 0; i < 10;) {
        i += 1;
    }

    for (var i = 0;) {
        once();
    }

    for (; running;) {
        tick();
    }

    for (var i = 0; i < 3; i += 1) {
        for (var j = 0; j < 3; j += 1) {
            grid(i, j);
        }
    }
}

