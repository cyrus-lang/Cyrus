fn example() {
    while (i < 10) {
        i += 1;
    }

    while (running) {
        step();
    }

    while (a && b || c) {
        tick();
    }

    while (i < 100) {
        while (j < 50) {
            j += 1;
        }
        i += 1;
    }
}

