// @parse

fn example(x: int32, msg: Msg) {
    switch (x) {
    }

    switch (x) {
        case 0 => {
            zero();
        }
        case 1 | 2 => small(x);
        case 3...7 => range_low(x);
        case 10..=20 => range_high(x);
        else => {
            other(x);
        }
    }

    switch (msg) {
        case .Quit => quit();
        case .Move { x, y } => move(x, y);
        case .Pair(a, b) => pair(a, b);
        case .Rec { var first, second: alias, .. } => rec(first, alias);
        case name => use(name);
        case var mutable => use(mutable);
        case _ => fallback();
    }

    switch (x) {
        case 1 => switch (x) {
            case 2 => deep();
        }
    }
}

