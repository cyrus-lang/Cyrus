// @parse

fn example() {
    if (flag) {
        run();
    }

    if (a == 1) {
        b();
    } else {
        c();
    }

    if (ready) {
        start();
    } else if (loading) {
        wait();
    } else {
        stop();
    }

    if (a) {
        b();
    } else if (c) {
        d();
    } else if (e) {
        f();
    }

    if (outer) {
        if (inner) {
            deep();
        } else {
            shallow();
        }
    }
}

