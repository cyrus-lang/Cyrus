// @parse

type Int = int32;

pub type Visible = uint8;

type Pair<K, V> = Map<K, V>;

type Ptr = int32*;

type StructLit = struct { x: int32, y: uint64 };

type UnionLit = union { a: int32, b: uint8 };

type EnumLit = enum { A, B = 2, C(int32), D { v: int32 } };

type TaggedEnum = enum(uint8) { X, Y };

type Builtin = @int(8);

fn nested() {
    type Local = int32;
}

