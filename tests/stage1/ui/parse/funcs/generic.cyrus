// @parse

fn identity<T>(value: T) T {
    return value;
}

fn pair<A, B>(a: A, b: B) Pair {
    return make(a, b);
}

fn bounded<T: Display + Clone>(value: T) {
}

fn defaulted<T = int32>(value: T) {
}

fn decl<T>(value: T);

