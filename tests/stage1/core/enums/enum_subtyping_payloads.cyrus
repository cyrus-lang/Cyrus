// @stdout: r=eof w=full(4096) p=hdr(2,77) s=len(4:12) pkt=9,8 eq1=1 eq2=1 neq=1

import std::libc{printf};

enum ReadError {
    NotFound,
    UnexpectedEof,
}

enum WriteError {
    PermissionDenied,
    DiskFull(uint64),
}

enum HeaderError {
    TruncatedHeader,
    WrongMagic(uint32),
}

enum FrameError {
    InvalidLength { expected: usize, actual: usize },
    WrongMagic(uint32),
    ChecksumMismatch,
    TruncatedHeader,
}

enum PacketError {
    Packet(uint8[4]),
    TagOnly,
}

enum IOError {
    TagOnly,
    DiskFull(uint64),
    UnexpectedEof,
    PermissionDenied,
    InvalidLength { actual: usize, expected: usize },
    NotFound,
    Packet(uint8[4]),
    WrongMagic(uint32),
    ChecksumMismatch,
    TruncatedHeader,
    Multi(uint16, int32),
}

enum PairError {
    Multi(uint16, int32),
}

fn widen_read(err: ReadError) IOError {
    return err;
}

fn widen_write(err: WriteError) IOError {
    return err;
}

fn widen_header(err: HeaderError) FrameError {
    return err;
}

fn widen_frame(err: FrameError) IOError {
    return err;
}

fn widen_packet(err: PacketError) IOError {
    return err;
}

fn widen_pair(err: PairError) IOError {
    return err;
}

pub fn main() {
    const read_err: ReadError = .UnexpectedEof;
    const write_err: WriteError = .DiskFull(4096);
    const hdr_err: HeaderError = .WrongMagic(77);
    const frame_len_err: FrameError = .InvalidLength { expected: 4, actual: 12 };
    const pkt_err: PacketError = .Packet(uint8[4] { 9, 8, 7, 6 });
    const pair_err: PairError = .Multi(2, 99);

    const a: IOError = widen_read(read_err);
    const b: IOError = widen_write(write_err);
    const c: IOError = widen_frame(widen_header(hdr_err));
    const d: IOError = widen_frame(frame_len_err);
    const e: IOError = widen_packet(pkt_err);
    const f: IOError = widen_pair(pair_err);

    const eq1 = @cast(IOError, read_err) == IOError.UnexpectedEof;
    const eq2 = @cast(IOError, write_err) == IOError.DiskFull(4096);
    const neq = @cast(IOError, pair_err) != IOError.TagOnly;

    switch (a) {
        case .UnexpectedEof => printf("r=eof ");
        else => printf("r=bad ");
    }

    switch (b) {
        case .DiskFull(bytes) => printf("w=full(%llu) ", bytes);
        else => printf("w=bad ");
    }

    var hdr_pair_ok = false;
    switch (f) {
        case .Multi(tag, code) => {
            if (tag == 2 && code == 99) {
                hdr_pair_ok = true;
            }
        }
        else => {}
    }

    switch (c) {
        case .WrongMagic(magic) => {
            if (hdr_pair_ok) {
                printf("p=hdr(2,%u) ", magic);
            }
        }
        else => printf("p=bad ");
    }

    switch (d) {
        case .InvalidLength { expected, actual } => printf("s=len(%zu:%zu) ", expected, actual);
        else => printf("s=bad ");
    }

    switch (e) {
        case .Packet(bytes) => printf("pkt=%u,%u ", bytes[0], bytes[1]);
        else => printf("pkt=bad ");
    }

    printf("eq1=%d eq2=%d neq=%d", eq1, eq2, neq);
}
