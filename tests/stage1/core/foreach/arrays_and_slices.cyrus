// @stdout: sum=60 copy=1,2,3 mut=10,20,30 const_arr=4,5,6 fn=7,8 index=0:10,1:20,2:30 slice=20,30 sm=100,200,300 cs=5,6 empty=0 ign=3

import std::libc{printf};

fn make_pair_arr() int32[2] {
    return int32[2] { 7, 8 };
}

pub fn main() {
    var array = int32[3] { 1, 2, 3 };

    var sum: int32 = 0;
    for (x : int32[3] { 10, 20, 30 }) {
        sum += x;
    }
    printf("sum=%d ", sum);

    for (var x : array) {
        x += 100;
    }
    printf("copy=%d,%d,%d ", array[0], array[1], array[2]);

    for (p : &array) {
        const tmp = *p;

        if (tmp < 0) {
            printf("neg ");
        }
    }

    for (var p : &array) {
        *p *= 10;
    }
    
    printf("mut=%d,%d,%d ", array[0], array[1], array[2]);

    const array2 = int32[3] { 4, 5, 6 };
    printf("const_arr=");
    for (i, p : &array2) {
        if (i > 0) {
            printf(",");
        }
        printf("%d", *p);
    }
    printf(" ");

    var fn_first = true;
    printf("fn=");
    for (x : make_pair_arr()) {
        if (!fn_first) {
            printf(",");
        }
        printf("%d", x);
        fn_first = false;
    }
    printf(" ");

    printf("index=");
    for (var i, x : int32[3] { 10, 20, 30 }) {
        if (i > 0) {
            printf(",");
        }
        printf("%zu:%d", i, x);
        i += 10;
    }
    printf(" ");

    var slice: int32[] = int32[3] { 10, 20, 30 }[1..3];
    printf("slice=");
    for (i, x : slice) {
        if (i > 0) {
            printf(",");
        }
        printf("%d", x);
    }
    printf(" ");

    var backing = int32[3] { 10, 20, 30 };
    var slice2: int32[] = backing[..];
    for (var p : &slice2) {
        *p *= 10;
    }
    printf("sm=%d,%d,%d ", backing[0], backing[1], backing[2]);

    const array3 = int32[2] { 5, 6 };
    const slice3: const int32[] = array3[..];
    printf("cs=");
    for (i, p : &slice3) {
        if (i > 0) {
            printf(",");
        }
        printf("%d", *p);
    }
    printf(" ");

    const empty_array = int32[0] {};
    const empty_slice: int32[] = empty_array[..];
    var empty_count: usize = 0;
    for (_ : empty_slice) {
        empty_count += 1;
    }
    printf("empty=%zu ", empty_count);

    var ignore_count: usize = 0;
    for (_, _ : int32[3] { 1, 2, 3 }) {
        ignore_count += 1;
    }
    printf("ign=%zu\n", ignore_count);
}
