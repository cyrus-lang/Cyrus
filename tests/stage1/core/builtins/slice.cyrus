// @stdout: full=5:10,50 sub=3:20,40 empty=0 round=3:20,30

import std::libc{printf};

pub fn main() {
    var array = int32[5] {10, 20, 30, 40, 50};
    const p: int32* = &array[0];

    const full: int32[] = @slice(p, 5);
    printf("full=%zu:%d,%d ", @len(full), full[0], full[4]);

    const sub: int32[] = @slice(&array[1], 3);
    printf("sub=%zu:%d,%d ", @len(sub), sub[0], sub[2]);

    const empty: int32[] = @slice(p, 0);
    printf("empty=%zu ", @len(empty));

    const round: int32[] = @slice(@ptr(sub), @len(sub));
    printf("round=%zu:%d,%d", @len(round), round[0], round[1]);
}
