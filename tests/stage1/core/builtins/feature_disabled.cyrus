// @stdout: false false false

import std::libc{printf};

const HAS_SIMD: bool = @feature("simd");

pub fn main() {
    const a = @feature("simd");
    const b = @feature("logging");
    printf("%s %s %s", bool_str(HAS_SIMD), bool_str(a), bool_str(b));
}

fn bool_str(v: bool) const uint8* {
    if (v) {
        return "true";
    }
    return "false";
}
