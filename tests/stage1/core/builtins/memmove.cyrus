// @stdout: 11234 12344

import std::libc{printf};

pub fn main() {
    var bytes = uint8[5] {1, 2, 3, 4, 5};
    const base = @ptr(bytes);
    const next = @ptr_offset(base, 1);
    @memmove(next, base, 4);
    printf("%d%d%d%d%d ", bytes[0], bytes[1], bytes[2], bytes[3], bytes[4]);
    @memmove(base, next, 4);
    printf("%d%d%d%d%d", bytes[0], bytes[1], bytes[2], bytes[3], bytes[4]);
}
