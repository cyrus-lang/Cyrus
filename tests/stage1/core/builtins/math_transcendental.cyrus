// @stdout: 0.4794 0.8776 0.5463 0.5236 1.0472 0.7854 2.3562 0.5211 1.1276 0.4621 0.4812 1.3170 0.5493 2.7183 8.0000 1e-06 0.6931 3.0000 2.0000 1e-06 0.5205 0.4795 24.0

import std::libc{printf};

pub fn main() {
    printf("%.4f %.4f %.4f ", @sin(0.5), @cos(0.5), @tan(0.5));
    printf("%.4f %.4f %.4f ", @asin(0.5), @acos(0.5), @atan(1.0));
    printf("%.4f ", @atan2(1.0, -1.0));
    printf("%.4f %.4f %.4f ", @sinh(0.5), @cosh(0.5), @tanh(0.5));
    printf("%.4f %.4f %.4f ", @asinh(0.5), @acosh(2.0), @atanh(0.5));
    printf("%.4f %.4f %.6g ", @exp(1.0), @exp2(3.0), @expm1(0.000001));
    printf("%.4f %.4f %.4f %.6g ", @log(2.0), @log2(8.0), @log10(100.0), @log1p(0.000001));
    printf("%.4f %.4f %.1f", @erf(0.5), @erfc(0.5), @gamma(5.0));
}
