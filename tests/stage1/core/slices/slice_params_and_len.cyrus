// @stdout: len=5 sum=150

import std::libc{printf};

fn sum_slice(s: int32[]) int32 {
    var total: int32 = 0;

    for (var i: usize = 0; i < @len(s); i += 1) {
        total += s[i];
    }

    return total;
}

pub fn main() {
    var arr = int32[5] {10, 20, 30, 40, 50};
    const s: int32[] = arr[..];

    printf("len=%zu sum=%d\n", @len(s), sum_slice(s));
}
