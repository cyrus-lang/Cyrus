// @stdout: sub=2:[20,30] sub_p=2:[10,20] sub_s=2:[40,50] empty=0

import std::libc{printf};

fn print_slice(label: const uint8*, slice: const int32[]) {
    printf("%s=%zu", label, @len(slice));

    if (@len(slice) > 0) {
        printf(":[");

        for (var i: usize = 0; i < @len(slice); i += 1) {
            if (i > 0) {
                printf(",");
            }

            printf("%d", slice[i]);
        }

        printf("]");
    }

    printf(" ");
}

pub fn main() {
    const array = int32[5] {10, 20, 30, 40, 50};
    const full: const int32[] = array[..];

    print_slice("sub", full[1..3]);
    print_slice("sub_p", full[..2]);
    print_slice("sub_s", full[3..]);
    print_slice("empty", full[2..2]);
}
