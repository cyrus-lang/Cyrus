// @stdout: ptr=3:[20,30,40]

import std::libc{printf};

fn print_slice(label: const uint8*, slice: int32[]) {
    printf("%s=%zu", label, @len(slice));

    if (@len(slice) > 0) {
        printf(":[");

        for (var i: usize = 0; i < @len(slice); i += 1) {
            if (i > 0) {
                printf(",");
            }

            printf("%d", slice[i]);
        }

        printf("]");
    }
}

pub fn main() {
    var array = int32[5] {10, 20, 30, 40, 50};
    var ptr: int32* = &array[0];

    const ptr_slice = ptr[1..4];
    print_slice("ptr", ptr_slice);
}
