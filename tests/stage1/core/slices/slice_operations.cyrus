// @stdout: full=5:[10,20,30,40,50] arr1=200 r1=3:[200,30,40] r2=3:[10,200,30] r3=3:[30,40,50] sub=2:[200,30] sub_p=2:[10,200] ptr=3:[200,30,40] empty=0 sum=330

import std::libc{printf};

fn print_slice(label: const uint8*, s: int32[]) {
    printf("%s=%zu", label, @len(s));

    if (@len(s) > 0) {
        printf(":[");

        for (var i: usize = 0; i < @len(s); i += 1) {
            if (i > 0) {
                printf(",");
            }

            printf("%d", s[i]);
        }

        printf("]");
    }

    printf(" ");
}

fn sum_slice(s: int32[]) int32 {
    var total: int32 = 0;

    for (var i: usize = 0; i < @len(s); i += 1) {
        total += s[i];
    }

    return total;
}

pub fn main() {
    var arr = int32[5] {10, 20, 30, 40, 50};

    var full: int32[] = arr[..];
    print_slice("full", full);

    full[1] = 200;
    printf("arr1=%d ", arr[1]);

    const r1 = arr[1..4];
    print_slice("r1", r1);

    const r2 = arr[..3];
    print_slice("r2", r2);

    const r3 = arr[2..];
    print_slice("r3", r3);

    const sub = full[1..3];
    print_slice("sub", sub);

    const sub_prefix = full[..2];
    print_slice("sub_p", sub_prefix);

    var ptr: int32* = &arr[0];
    const ptr_slice = ptr[1..4];
    print_slice("ptr", ptr_slice);

    const empty = arr[2..2];
    print_slice("empty", empty);

    printf("sum=%d\n", sum_slice(full));
}
