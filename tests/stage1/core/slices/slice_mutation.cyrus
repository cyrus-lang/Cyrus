// @stdout: arr1=200 s1=200 arr3=400

import std::libc{printf};

pub fn main() {
    var array = int32[5] {10, 20, 30, 40, 50};
    var slice: int32[] = array[..];

    slice[1] = 200;

    var sub: int32[] = slice[2..4];
    sub[1] = 400;

    printf("arr1=%d s1=%d arr3=%d", array[1], slice[1], array[3]);
}
