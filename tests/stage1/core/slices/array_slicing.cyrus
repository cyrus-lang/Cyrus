// @stdout: full=5:[10,20,30,40,50] r1=3:[20,30,40] r2=3:[10,20,30] r3=3:[30,40,50] empty=0

import std::libc{printf};

fn print_slice(label: const uint8*, slice: int32[]) {
    printf("%s=%zu", label, @len(slice));

    if (@len(slice) > 0) {
        printf(":[");

        for (var i: usize = 0; i < @len(slice); i += 1) {
            if (i > 0) {
                printf(",");
            }

            printf("%d", slice[i]);
        }

        printf("]");
    }

    printf(" ");
}

pub fn main() {
    var array = int32[5] {10, 20, 30, 40, 50};

    print_slice("full", array[..]);
    print_slice("r1", array[1..4]);
    print_slice("r2", array[..3]);
    print_slice("r3", array[2..]);
    print_slice("empty", array[2..2]);
}
