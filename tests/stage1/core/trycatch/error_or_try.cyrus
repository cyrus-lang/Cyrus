// @stdout: ok=42 err=divide by zero defer=1 chain=100

import std::errors{ErrorOr};
import std::libc{printf};

fn safe_div(a: int32, b: int32) ErrorOr<int32, const uint8*> {
    if (b == 0) {
        return .Error("divide by zero");
    }
    return .Value(a / b);
}

fn compute(a: int32, b: int32, deferred: int32*) 
    ErrorOr<int32, const uint8*> 
{
    defer *deferred += 1;
    const q = try safe_div(a, b);
    return .Value(q + 2);
}

fn chain_step(x: int32) ErrorOr<int32, const uint8*> {
    const a = try safe_div(x, 2);
    const b = try safe_div(a, 1);
    return .Value(b * 2);
}

pub fn main() {
    var x: int32 = 0;
    switch (compute(80, 2, &x)) {
        case .Value(v) => printf("ok=%d ", v);
        case .Error(e) => printf("unexpected=%s ", e);
    }

    var y: int32 = 0;
    switch (compute(10, 0, &y)) {
        case .Value(v) => printf("unexpected=%d ", v);
        case .Error(e) => printf("err=%s defer=%d ", e, y);
    }

    switch (chain_step(100)) {
        case .Value(v) => printf("chain=%d", v);
        case .Error(e) => printf("unexpected=%s", e);
    }
}
