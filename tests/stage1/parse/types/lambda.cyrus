// @parse

type Callback = fn(int32) int32;

type MultiArg = fn(int32, uint8) void;

type NoArgs = fn() void;

type Variadic = fn(int32, ...) void;

type TypedVariadic = fn(...uint8) void;

type PointerArg = fn(int32*, const uint8*) bool;

fn higher_order(f: fn(int32) int32, x: int32) int32 {
    return f(x);
}

fn pointers() {
    var op: fn(int32, int32) int32 = undefined;
}

