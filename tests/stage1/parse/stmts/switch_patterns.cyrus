// @parse

fn patterns(msg: Msg) {
    switch (msg) {
        case .Quit => quit();
        case .Move { x, y } => move(x, y);
        case .Pair(a, b) => pair(a, b);
        case .Rec { var first, second: alias, .. } => rec(first, alias);
        case name => use(name);
        case var mutable => use(mutable);
        case _ => fallback();
    }
}

