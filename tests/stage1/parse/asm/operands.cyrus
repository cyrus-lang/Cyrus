// @parse

pub fn main() {
    var x: int32 = 0;
    var a: int32 = 1;
    var b: int32 = 2;

    @asm(
        "movl %1, %0; addl %2, %0"
        : "=r"(x)
        : "r"(a), "r"(b)
        :
    );

    @asm volatile("movq %%rsp, %0" : "=r"(x) : : );
}

