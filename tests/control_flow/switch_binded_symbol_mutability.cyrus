enum Value {
    A(int64),
    B(bool),
    C {
        a: int32,
        b: int32,
    }
}

pub fn main() {
    const value1 = Value.A(5);

    switch (value1) {
        case .A(var x) => {
			x = 10;
        }
        case .B(y) => {
            y = false; //~ ERROR Cannot assign to immutable lvalue
        }
        case .C { a, var b } => {
            a = 1; //~ ERROR Cannot assign to immutable lvalue
            b = 2;
        }
    }
}