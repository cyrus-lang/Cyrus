// @stdout: 10 20 30 none

import std::mem::libc{LibcAllocator};
import std::collections{Vec};
import std::mem{Allocator};
import std::libc{printf};

pub fn main() {
    var allocator: Allocator = dynamic LibcAllocator.new();
    
    const vec: Vec<int32> = Vec.new(allocator);
    defer vec.free();

    vec.push(10);
    vec.push(20);
    vec.push(30);

    const iter = vec.iter();

    printf("%d ", *iter.next().unwrap());
    printf("%d ", *iter.next().unwrap());
    printf("%d ", *iter.next().unwrap());

    switch (iter.next()) {
        case .None => printf("none\n");
    }
}