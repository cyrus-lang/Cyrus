// @stdout: env ok

import std::os::env;
import std::mem::libc{LibcAllocator};
import std::mem{Allocator};
import std::libc{printf};

pub fn main() {
    const allocator: Allocator = dynamic LibcAllocator.new();

    env::set("CYRUS_TEST_VAR", "hello_cyrus");

    const has_it = env::has("CYRUS_TEST_VAR");
    const raw_val = env::get("CYRUS_TEST_VAR");

    var val_str = env::get_string(allocator, "CYRUS_TEST_VAR").unwrap();
    defer val_str.free();

    env::remove("CYRUS_TEST_VAR");
    const still_has = env::has("CYRUS_TEST_VAR");

    if (((has_it && raw_val.is_some()) && val_str.len() == 11) && !still_has) {
        printf("env ok\n");
    } else {
        printf("env fail\n");
    }
}