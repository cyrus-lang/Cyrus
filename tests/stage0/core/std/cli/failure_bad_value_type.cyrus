// @stderr: Option `-i` wants a value of type `integer`\nPlease use command `help` to see usage.

import std::mem::libc{LibcAllocator};
import std::mem{Allocator};
import std::libc{printf};
import _app;

pub fn main() {
    const allocator: Allocator = dynamic LibcAllocator.new();

    const inst = _app::inst(allocator, 4, {_app::PROGRAM_NAME, "build", "-i", "abc"});
    defer allocator.free(inst);
}
