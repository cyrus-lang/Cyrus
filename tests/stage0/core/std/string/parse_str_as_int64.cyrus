// @stdout: 123, 1234567, ok

import std::string{parse_str_as_int64};
import std::libc{printf};

pub fn main() {
    const num = parse_str_as_int64("123").unwrap();
    printf("%ld, ", num);
    
    const num2 = parse_str_as_int64("1234567").unwrap();
    printf("%ld, ", num2);
    
    switch (parse_str_as_int64("meow")) {
        case .Some => {}
        case .None => printf("ok\n");
    }
}