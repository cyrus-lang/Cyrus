import std::libc{printf};

enum Color {
    Red,
    Green,
    Blue
}

fn display_color(color: Color) const uint8* {
    switch (color) { //~ ERROR ensure that all variants are covered in switch statement
        case .Red => {
            return "Red\n";
        }
    }
}

pub fn main() {
    printf("%s", display_color(Color.Green));
}
