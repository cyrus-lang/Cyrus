// @stdout: 2450

import std::libc{printf};

pub fn main() {
    var data: int32[100] = undefined;
    var i: int32 = 0;
    while (i < 100) {
        data[i] = i;
        i = i + 1;
    }

    var sum: int32 = 0;
    i = 0;
    while (i < 100) {
        if (data[i] % 2 == 0) {
            sum = sum + data[i];
        }
        i = i + 1;
    }

    printf("%d\n", sum);
}
