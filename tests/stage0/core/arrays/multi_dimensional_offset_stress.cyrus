// @stdout: 2025

import std::libc{printf};

pub fn main() {
    var matrix: int32[100] = undefined;
    var i: int32 = 0;
    while (i < 10) {
        var j: int32 = 0;
        while (j < 10) {
            matrix[i * 10 + j] = i * j;
            j = j + 1;
        }
        i = i + 1;
    }

    var sum: int32 = 0;
    i = 0;
    while (i < 10) {
        var j: int32 = 0;
        while (j < 10) {
            sum = sum + matrix[i * 10 + j];
            j = j + 1;
        }
        i = i + 1;
    }

    printf("%d\n", sum);
}
