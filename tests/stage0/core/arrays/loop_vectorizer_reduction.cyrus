// @stdout: 49500

import std::libc{printf};

pub fn main() {
    var data: int32[100] = undefined;
    var i: int32 = 0;
    while (i < 100) {
        data[i] = i * 10;
        i = i + 1;
    }

    var total: int32 = 0;
    i = 0;
    while (i < 100) {
        total = total + data[i];
        i = i + 1;
    }

    printf("%d\n", total);
}
