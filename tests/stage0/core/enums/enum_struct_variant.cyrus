// @stdout: id: 2, custom error message

import std::libc{printf};

enum Error {
    NotFound = struct { id: 1uint32, mesg: "not found" },

    Custom {
        id: uint32,
        mesg: const uint8*
    }
}

pub fn main() {
    const err = Error.Custom { id: 2, mesg: "custom error message" };

    switch (err) {
        case .NotFound => {
            printf("not found\n");
        }
        case .Custom { id, mesg } => {
            printf("id: %d, %s\n", id, mesg);
        }
    }
}