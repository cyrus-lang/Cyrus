// @stdout: 8 8 0 0 0

import std::libc{printf};

struct Box<T> {
  value: T
}

struct KV<K, V> {
  key: K,
  val: V
}

pub fn main() {
    printf("%d ", @size_of(Box<uint64>));
    printf("%d ", @size_of(KV<int32, uint8>));
    printf("%d ", @size_of(Box<()>));
    printf("%d ", @size_of(KV<(), ()>));
    printf("%d\n", @size_of(KV<(), void>));
}
