import (
    std::libc::types{c_int, c_char},
    std::libc{
        fprintf, printf, strlen,
        strcmp, strtod, strtol,
        errno, isalpha, isalnum,
        stderr, ERANGE
    },
    std::io{Writer, StdoutWriter},
    std::mem{Allocator, alloc_init},
    std::collections{Vec},
    std::errors{ErrorOr},
    std::option{Option},
    std::string{String},
);

const HELP_WS_LEN: usize = 16;

pub type ProgramArgs = struct {
    argv: const c_char**,
    argc: c_int
};

pub type ActionFn = fn(ActionCtx) void;

pub struct ActionCtx {
    pub opts: Opts*
}

pub enum ParseError {
    InvalidCommandOption { cmd: const uint8*, opt: const uint8* },
    BadValueType { opt: const uint8*, ty: const uint8* },
    DuplicateOption { opt: const uint8* },
    InvalidOption { opt: const uint8* },
    UnknownOption { opt: const uint8* },
    UnknownCommand { cmd: const uint8* },
    MissingOption { opt: const uint8* },
    MissingValue { opt: const uint8* },
    InvalidValue { opt: const uint8* },
}

pub enum Value {
    Str(String),
    Int(int64),
    Float(float64),
    Bool(bool)
}

pub struct Cli {
    allocator: Allocator,
    cmds: Cmds,
    opts: Opts*,
    program_name: uint8*,

    pub fn new(allocator: Allocator, opts: Opts*, program_name: uint8*) Self {
        const cmds = Cmds.new(allocator);

        return Self {
            allocator,
            cmds,
            opts,
            program_name
        };
    }

    pub fn add_command(self: Self*, cmd: Cmd) {
        const help_opt = self->opts->get_help_opt();
        var heap = self->cmds.add(cmd);
        heap->add_option(help_opt);
    }
    
    pub fn parse_args(self: Self*, pargs: ProgramArgs) ErrorOr<Self*, ()> {
        if (pargs.argc < 2) {
            self->display_general_help();
            return .Value(self);
        }

        if (pargs.argv[1] == "help") {
            self->display_general_help();
            return .Value(self);
        }
        
        var cmd: Cmd*;

        switch (self->parse_command(pargs)) {
            case .Value(detail) => {
                cmd = detail.cmd;

                switch (self->parse_remaining_args(cmd, pargs, detail.rem_args)) {
                    case .Error(err) => {
                        self->display_parse_error(err);
                        return .Error(());
                    }
                }
            }
            case .Error(err) => {
                self->display_parse_error(err);
                return .Error(());
            }
        }

        // If help option is enabled, only show options
        // and DO NOT trigger action.
        if (self->opts->enabled("help")) {
            cmd->display_help();
            return .Value(self);
        }

        (cmd->action)(ActionCtx {
            opts: self->opts
        });

        return .Value(self);
    }

    fn parse_remaining_args(self: Self*, cmd: const Cmd*, pargs: ProgramArgs, rem_args: usize) ErrorOr<(), ParseError> {
        if (rem_args == 0) {
            return .Value(());
        }

        const argc = @cast(usize, pargs.argc);

        for (var i: usize = argc - rem_args; i < argc; i += 1) {
            switch (self->parse_option(cmd, &i, pargs)) {
                case .Error(err) => return .Error(err);
            }
        }
        
        return .Value(());
    }

    fn parse_command(self: Self*, pargs: ProgramArgs) ErrorOr<struct {
        cmd: Cmd*,
        rem_args: usize
    }, ParseError> {
        const argc = @cast(usize, pargs.argc);
        
        var i: usize = 1;
        var arg = pargs.argv[i];

        // Consume first command
        switch (self->cmds.find(arg)) case .Some(var cmd) else {
            return .Error(.UnknownCommand { cmd: arg });
        }
        i += 1;

        // Handle sub commands
        for (; i < argc; i += 1) {
            arg = pargs.argv[i];
            
            // We expect arg to be cmd until first 
            // option consumed, and after that we do not 
            // consider any identifier to be a cmd, 
            // but a value given to an option.
            if (is_arg_an_opt(arg)) {
                break;
            }

            const (is_assign, _) = is_opt_assign(arg);

            if (is_assign) {
                break;
            }

            switch (cmd->sub_cmds->find(arg)) {
                case .Some(_cmd) => cmd = _cmd;
                case .None => return .Error(.UnknownCommand { cmd: arg });
            }
        }
        
        return .Value(struct { cmd, rem_args: argc - i });
    }

    fn parse_option(
        self: const Self*,
        cmd: const Cmd*,
        i: usize*,
        pargs: ProgramArgs
    ) ErrorOr<(), ParseError> {
        var arg = pargs.argv[*i];
        
        var next_arg: const uint8*;

        if (*i <= @cast(usize, pargs.argc)) {
            next_arg = pargs.argv[*i + 1];
        }

        const len = strlen(arg);

        const (single_dash, double_dash) = is_opt_dashed(arg);

        if (!(single_dash || double_dash)) {
            return .Error(.InvalidOption { opt: arg });
        }

        var name: const uint8* = undefined;

        // Skip dashes
        if (double_dash) { name = arg + 2; } // Double dash
        else { name = arg + 1; } // Single dash
    
        // Check option name to be present
        if (strcmp(name, "\0") == 0) {
            return .Error(.InvalidOption { opt: arg });
        }

        const (is_assign, var assign_index) = is_opt_assign(name);

        // REVIEW: We might need to replace fixed-size buffers
        // with a dynamically growable one.
        if (is_assign) {
            const name_len = strlen(name);

            var opt_name: uint8[256];
            var opt_val: uint8[256];
            
            @memcpy(&opt_name[0], name, assign_index + 1);
            opt_name[assign_index] = '\0';

            @assert(name[assign_index] == '=', "assign index is wrong");
            assign_index += 1; // Skip it

            @memcpy(&opt_val[0], name + assign_index, assign_index);
            opt_val[name_len] = '\0';
            
            name = &opt_name[0];
            next_arg = &opt_val[0];
        }

        var value: Value;

        switch (cmd->find_option(name)) case .Some(opt) else {
            return .Error(.UnknownOption { opt: name });
        }

        // Flag enabled, no matter
        // what it's value is
        opt->enabled = true;

        const ty = opt->arg_type.unwrap_or(.Bool);

        if (ty.is_bool() && (!next_arg || is_arg_an_opt(next_arg))) {
            // Option used as flag
            value = .Bool(true);
            goto register_value;
        }
        
        // For non-boolean options, or boolean with explicit value
        if (!next_arg) {
            return .Error(.MissingValue { opt: name });
        }

        if (is_arg_an_opt(next_arg)) {
            // Next arg is an option, but we need a value
            return .Error(.MissingValue { opt: name });
        }

        // Consume the value
        *i += 1;

        // Parse the value
        value = self->parse_value(next_arg);
    
    register_value:
        opt->add_value(value);

        // Validate parsed value type
        // with expected type
        if (!is_value_valid(ty, value)) {
            return .Error(.BadValueType {
                opt: arg,
                ty: ty.to_str()
            });
        }

        // Option policy check
        switch (opt->check()) {
            case .Error(err) => return .Error(err);
        }

        return .Value(());
    }

    fn parse_value(self: Self*, arg: const uint8*) Value {
        var ok = false;

        const bool_value = parse_bool(&ok, arg);
        if (ok) {
            return .Bool(bool_value);
        }
        
        const int_value = parse_int(&ok, arg);
        if (ok) {
            return .Int(int_value);
        }

        const float_value = parse_float(&ok, arg);
        if (ok) {
            return .Float(float_value);
        }

        return .Str(String.from_str(self->allocator, arg));
    }

    fn display_general_help(self: const Self*) {
        var writer: Writer = dynamic StdoutWriter.new();

        writer.write("Usage: ");
        writer.write(self->program_name);
        writer.writeln(" [COMMAND] [REQUIRED_OPTIONS] [OPTIONS]");

        writer.write("\n");
        self->cmds.display_all(writer);
    }

    fn display_parse_error(self: const Self*, err: ParseError) {
        switch (err) {
            case .DuplicateOption { opt } => {
                fprintf(
                    stderr,
                    "Duplcate option: %s (not allowed)\n",
                    opt
                );
            }
            case .InvalidOption { opt } => {
                fprintf(
                    stderr,
                    "Invalid option: %s\n",
                    opt
                );
            }
            case .UnknownOption { opt } => {
                fprintf(
                    stderr,
                    "Uknown option: %s\n",
                    opt
                );
            }
            case .MissingOption { opt } => {
                fprintf(
                    stderr,
                    "Missing option: %s (required)\n",
                    opt
                );
            }
            case .MissingValue { opt } => {
                fprintf(
                    stderr,
                    "Option `%s` requires a value\n",
                    opt
                );
            }
            case .InvalidValue { opt } => {
                fprintf(
                    stderr,
                    "Option `%s` does not accept a value (flag only)\n",
                    opt
                );
            }
            case .BadValueType { opt, ty } => {
                fprintf(
                    stderr,
                    "Option `%s` wants a value of type `%s`\n",
                    opt,
                    ty
                );
            }
            case .UnknownCommand { cmd } => {
                fprintf(
                    stderr,
                    "Unknown cmd: %s\n",
                    cmd
                );
            }
            case .InvalidCommandOption { cmd, opt } => {
                fprintf(
                    stderr,
                    "Invalid option `%s` for cmd `%s`",
                    cmd,
                    opt
                );
            }
        }
        
        fprintf(stderr, "Please use command `help` to see usage.\n");
    }

    pub fn free(self: Self*) {
        self->cmds.free();
        self->opts->free();
    }
}

pub struct Cmds {
    allocator: Allocator,
    inner: Vec<Cmd*>,

    pub fn new(allocator: Allocator) Self {
        return Self {
            allocator,
            inner: Vec.new(allocator)
        };
    }

    pub fn add(self: Self*, cmd: Cmd) Cmd* {
        var heap = alloc_init(self->allocator, cmd);
        self->inner.push(heap);
        return heap;
    }

    pub fn find(self: Self*, name: const uint8*) Option<Cmd*> {
        for (var i: usize = 0; i < self->inner.len(); i += 1) {
            const cmd = self->inner.get_owned(i).unwrap();

            if (strcmp(cmd->name, name) == 0) {
               return .Some(cmd);
            }
        }

        return .None;
    }

    pub fn display_all(self: const Self*, writer: Writer) {
        writer.writeln("Commands:");

        for (var i: usize = 0; i < self->inner.len(); i += 1) {
            const cmd = self->inner.get_owned(i).unwrap();
            const len = strlen(cmd->name);

            writer.write("  ");
            writer.write(cmd->name);

            switch (cmd->help) {
                case .Some(text) => {
                    write_spaces(writer, HELP_WS_LEN - len);
                    writer.write(text);
                }
            }
            
            writer.write("\n");
        }

        writer.write("  ");
        writer.write("help");
        write_spaces(writer, HELP_WS_LEN - 4);
        writer.write("Shows commands");
        writer.write("\n");
    }
    
    pub fn len(self: const Self*) usize {
        return self->inner.len();
    }

    pub fn free(self: Self*) {
        for (var i: usize = 0; i < self->inner.len(); i += 1) {
            var cmd = self->inner.get_owned(i).unwrap();
            cmd->free();
            self->allocator.free(cmd);
        }

        self->inner.free();
    }
}

pub struct Cmd {
    allocator: Allocator,
    opts: Vec<Opt*>,
    pub name: const uint8*,
    pub sub_cmds: Cmds*,
    pub action: ActionFn,
    pub help: Option<uint8*>,

    pub fn new(allocator: Allocator, name: const uint8*, action: ActionFn) Self {
        const sub_cmds: Cmds* = alloc_init(allocator, Cmds.new(allocator));
        @assert(sub_cmds, "allocation failed for sub_cmds");
        
        const opts: Vec<Opt*> = Vec.new(allocator);

        return Self {
            allocator,
            name,
            opts,
            sub_cmds,
            action,
            help: .None
        };
    }

    pub fn add_option(self: Self*, opt: Opt*) Self* {
        self->opts.push(opt);
        return self;
    }

    pub fn find_option(self: Self*, name: const uint8*) Option<Opt*> {
        for (var i: usize = 0; i < self->opts.len(); i += 1) {
            const opt = self->opts.get_owned(i).unwrap();

            // Check with short name
            switch (opt->short_name) {
                case .Some(char) => {
                    // Convert uint8 to uint8* 
                    // to be able to compare them
                    const temp: uint8[2] = { char, '\0' };

                    if (strcmp(temp, name) == 0) {
                        return .Some(opt);
                    }
                }
            }

            // Check with long name
            if (strcmp(opt->long_name, name) == 0) {
               return .Some(opt);
            }
        }

        return .None;
    }

    pub fn add_sub_command(self: Self*, cmd: Cmd) Self* {
        self->sub_cmds->add(cmd);
        return self;
    }

    pub fn help(self: Self*, mesg: uint8*) Self* {
        self->help = .Some(mesg);
        return self;
    }

    pub fn display_help(self: const Self*) {
        var writer: Writer = dynamic StdoutWriter.new();

        writer.write("Options ");
        writer.write("[");
        writer.write(self->name);
        writer.writeln("]");

        for (var i: usize = 0; i < self->opts.len(); i += 1) {
            const opt = self->opts.get_owned(i).unwrap();

            const space_len: usize = 2;
            const dash_len: usize = 2;
            const name_len = strlen(opt->long_name);
            const len = space_len + dash_len + name_len;

            writer.write("  --");
            writer.write(opt->long_name);

            switch (opt->help) {
                case .Some(text) => {
                    write_spaces(
                        writer,
                        HELP_WS_LEN - len
                    );
                    writer.write(text);
                }
            }

            writer.write("\n");
        }
    }

    pub fn free(self: Self*) {
        for (var i: usize = 0; i < self->opts.len(); i += 1) {
            const opt = self->opts.get_owned(i).unwrap();
            opt->free();
        }

        self->opts.free();

        self->sub_cmds->free();
        self->allocator.free(self->sub_cmds);
    }
}

pub struct Opts {
    allocator: Allocator,
    inner: Vec<Opt*>,

    pub fn new(allocator: Allocator) Self {
        var self = Self { allocator, inner: Vec.new(allocator) };

        // Handle help option internally
        self.add(*Opt.new(allocator, "help").short('h')->help("Show help"));

        return self;
    }

    [[inline]]
    pub fn get_help_opt(self: const Self*) Opt* {
        return self->inner.get_owned(0).unwrap();
    }

    pub fn add(self: Self*, opt: Opt) Opt* {
        const opt = alloc_init(self->allocator, opt);
        self->inner.push(opt);
        return opt;
    }

    pub fn find(self: Self*, name: const uint8*) Option<Opt*> {
        for (var i: usize = 0; i < self->inner.len(); i += 1) {
            const opt = self->inner.get_owned(i).unwrap();

            // Check with short name
            switch (opt->short_name) {
                case .Some(char) => {
                    // Convert uint8 to uint8* 
                    // to be able to compare them
                    const temp: uint8[2] = { char, '\0' };

                    if (strcmp(temp, name) == 0) {
                        return .Some(opt);
                    }
                }
            }

            // Check with long name
            if (strcmp(opt->long_name, name) == 0) {
               return .Some(opt);
            }
        }

        return .None;
    }

    pub fn enabled(self: const Self*, name: const uint8*) bool {
        switch (self->find(name)) {
            case .Some(opt) => if (opt->enabled) { return true; }
        }
        return false;
    }

    pub fn display_all(self: const Self*, writer: Writer) {
        writer.writeln("Options:");
        for (var i: usize = 0; i < self->inner.len(); i += 1) {
            const option = self->inner.get_owned(i).unwrap();

            writer.write("  ");
            
            switch (option->short_name) {
                case .Some(char) => {
                    writer.write("-");
                    writer.write_char(char);
                }
            }
            
            writer.write(", ");
            writer.write("--");
            writer.write(option->long_name);
        }
        writer.write("\n");
    }

    pub fn len(self: const Self*) usize {
        return self->inner.len();
    }

    pub fn free(self: Self*) {
        for (var i: usize = 0; i < self->inner.len(); i += 1) {
            var opt = self->inner.get_owned(i).unwrap();
            opt->free();
            self->allocator.free(opt);
        }

        self->inner.free();
    }
}

pub struct Opt {
    allocator: Allocator,
    pub short_name: Option<uint8>,
    pub long_name: uint8*,
    pub values: Vec<Value*>,
    pub arg_type: Option<ArgType>,
    pub enabled: bool,
    pub required: bool,
    pub policy: DupPolicy,
    pub help: Option<uint8*>,

    pub fn new(allocator: Allocator, long_name: uint8*) Self {
        const values: Vec<Value*> = Vec.new(allocator);

        return Self {
            allocator,
            short_name: .None,
            long_name,
            values,
            arg_type: .None,
            enabled: false,
            required: false,
            policy: .Error,
            help: .None
        };
    }

    pub fn add_value(self: Self*, value: Value) {
        self->values.push(alloc_init(self->allocator, value));
    }

    pub fn check(self: const Self*) ErrorOr<(), ParseError> {
        if (self->policy == .Error && self->values.len() > 1) {
           return .Error(.DuplicateOption { opt: self->long_name });
        }

        return .Value(());
    }

    pub fn short(self: Self*, char: uint8) Self* {
        self->short_name = .Some(char);
        return self;
    }

    pub fn required(self: Self*) Self* {
        self->required = true;
        return self;
    }

    pub fn arg(self: Self*, ty: ArgType) Self* {
        self->arg_type = .Some(ty);
        return self;
    }

    pub fn policy(self: Self*, new_dp: DupPolicy) Self* {
        self->policy = new_dp;
        return self;
    }

    pub fn help(self: Self*, mesg: uint8*) Self* {
        self->help = .Some(mesg);
        return self;
    }

    pub fn free(self: Self*) {
        for (var i: usize = 0; i < self->values.len(); i += 1) {
            const value = self->values.get_owned(i).unwrap();

            switch (*value) {
                case .Str(str) => str.free();
            }

            self->allocator.free(value);    
        }

        self->values.free();
    }
}

pub enum ArgType {
    Str,
    Int,
    Float,
    Bool,

    [[inline]]
    pub fn to_str(self: Self) uint8* {
        switch (self) {
            case .Str => return "string";
            case .Int => return "integer";
            case .Float => return "float";
            case .Bool => return "bool";
        }
    }

    [[inline]]
    pub fn is_bool(self: Self) bool {
        switch (self) {
            case .Bool => return true;
            else => return false;
        }
    }
}

pub enum DupPolicy {
    Error,
    Last
}

[[inline]]
fn is_value_valid(ty: ArgType, value: Value) bool {
    switch (value) {
        case .Float(_) => if (ty == .Float) { return true; }
        case .Bool(_) => if (ty == .Bool) { return true; }
        case .Str(_) => if (ty == .Str) { return true; }
        case .Int(_) => if (ty == .Int) { return true; }
    }
    return false;
}

[[inline]]
fn parse_bool(ok: bool*, arg: const uint8*) bool {
    if (((strcmp(arg, "true") == 0 || strcmp(arg, "yes") == 0) ||
        (strcmp(arg, "on") == 0)) || strcmp(arg, "enabled") == 0)
    {
        *ok = true;
        return true;
    }

    if (((strcmp(arg, "false") == 0 || strcmp(arg, "no") == 0) ||
        (strcmp(arg, "off") == 0)) || strcmp(arg, "disabled") == 0)
    {
        *ok = true;
        return false;
    }

    return false;
}

[[inline]]
fn parse_int(ok: bool*, arg: const uint8*) int64 {
    var endptr: c_char*;

    errno = 0;
    const result = strtol(arg, &endptr, 10);

    if ((errno == ERANGE || endptr == arg) || *endptr != '\0') {
        *ok = false;
        return 0;
    }

    *ok = true;
    return @cast(int64, result);
}

[[inline]]
fn parse_float(ok: bool*, arg: const uint8*) float64 {
    var endptr: c_char*;
    
    errno = 0;
    const result = strtod(arg, &endptr);

    if ((errno == ERANGE || endptr == arg) || *endptr != '\0') {
        *ok = false;
        return 0.0;
    }

    *ok = true;
    return @cast(float64, result);
}

[[inline]]
fn is_opt_assign(arg: const uint8*) (bool, usize) {
    const len = @cast(usize, strlen(arg));
    for (var i: usize = 0; i < len; i += 1) {
        if (arg[i] == '=') {
            return (true, i);
        }
    }
    return (false, 0);
}

[[inline]]
fn is_opt_dashed(arg: const uint8*) (bool, bool) {
    const single_dash = arg[0] == '-';
    const double_dash = arg[0] == '-' && arg[1] == '-';
    return (single_dash, double_dash);
}

[[inline]]
fn is_arg_an_opt(arg: const uint8*) bool {
    if (!arg) {
        return false;
    }
    
    if (arg[0] == '-' && arg[1] == '-') {
        return true;
    }

    if (arg[0] == '-') {
        const next_arg = arg + 1;

        if (is_ident(next_arg)) {
            return true;
        }
    }

    return false;
}

[[inline]]
fn is_ident(str: const uint8*) bool {
    @assert(str, "str cannot be null");
    
    if (*str == '\0') {
        return false;
    }
    
    // First character must be a letter
    const char = @cast(c_int, @cast(uint8, *str));
    if (isalpha(char) == 0) {
        return false;
    }
    
    // Check remaining characters 
    // Allow letters, digits, underscore, and dash
    for (var i: usize = 1; str[i] != '\0'; i += 1) {
        var char = @cast(c_int, @cast(uint8, str[i]));
        if (isalnum(char) == 0 && (str[i] != '_' && str[i] != '-')) {
            return false;
        }
    }
    
    return true;
}

[[inline]]
fn write_spaces(writer: Writer, n: usize) {
    for (var i: usize = 0; i < n; i += 1) {
        writer.write(" ");
    }
}
