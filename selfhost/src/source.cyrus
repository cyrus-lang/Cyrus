import std::collections{Vec, Map};
import std::errors{ErrorOr};
import std::string{String};
import std::mem{Allocator};
import std::option{Option};
import std::slices{Slice};
import std::path{Path};
import std::os{File};

pub type SourceId = usize;

pub struct SourceContext {
    // TODO: Use HashMap instead
    map: Map<SourceId, Source>,
    next_id: SourceId,

    [[inline]]
    pub fn new(allocator: Allocator) Self {
        const map: Map<SourceId, Source> = Map.new(allocator);

        return Self { map, next_id: 0 };
    }

    [[inline]]
    pub fn get(self: const Self*, id: SourceId) Source {
        return self->map.get(id).unwrap();
    }

    pub fn add(self: Self*, source: Source) SourceId {
        const id = self->next_id;

        if (!self->map.set(id, source)) {
            @panic("duplicate key when inserting source in SourceContext");
        }

        self->next_id += 1;
        return id;
    }

    [[inline]]
    pub fn free(self: Self*) {
        self->map.free();
    }
}

pub struct Source {
    pub id: SourceId,      // Auto Increment ID
    pub content: String,   // Content
    pub path: Path,        // Path
    pub loffs: Vec<usize>, // Byte offsets where each line start.

    pub fn new(allocator: Allocator, id: SourceId, path: Path, content: String) Self {
        const loffs: Vec<usize> = Vec.new(allocator);
        var source = Self { id, content, path, loffs };
        source.compute_line_offsets();
        return source;
    }

    [[inline]]
    fn compute_line_offsets(self: const Self*) {
        // First line starts at byte offset zero
        self->loffs.push(0);

        for (var i: usize = 0; i < self->content.len(); i += 1) {
            const char = self->content.get(i).unwrap();

            if (is_newline(char)) {
                // Next line starts right after the newline
                self->loffs.push(i + 1); 
            }
        }
    }

    [[inline]]
    pub fn line_offset_to_column(self: const Self*, line: usize, offset: usize) usize {
        @assert(line > 0, "line number must be a 1-based index");

        const line_start = self->loffs.get_owned(line - 1).unwrap();
        return offset - line_start + 1;
    }

    [[inline]]
    pub fn is_line_offset(self: const Self*, offset: usize) bool {
        return self->loffs.contains(offset);
    }

    [[inline]]
    pub fn offset_to_line(self: const Self*, line: usize) usize {
        return self->loffs.get_owned(line).unwrap();
    }

    pub fn nearest_line(self: const Self*, offset: usize) Option<usize> {
        if (self->loffs.len() == 0) {
            return .None;
        }

        var lo: usize = 0;
        var hi: usize = self->loffs.len();
        
        while (lo < hi) {
            const mid = lo + (hi - lo) / 2;

            if (self->loffs.get_owned(mid).unwrap() <= offset) {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }

        if (lo == 0) {
            // Offset is before the first line start
            return .None; 
        }

        return .Some(lo); // 1-based line number
    }

    pub fn get_line(self: const Self*, line: usize) Option<(const uint8*, usize)> {
        @assert(line > 0, "line number must be a 1-based index");

        switch (self->loffs.get_owned(line - 1)) case .Some(start_offset) else {
            return .None;
        }

        const end_offset =
            self->loffs.get_owned(line).unwrap_or(self->content.len());

        const offset = end_offset - start_offset;
        const content = self->content.as_str_const();

        return .Some((&content[start_offset], offset - 1));
    }

    [[inline]]
    pub fn free(self: Self*) {
        self->loffs.free();
    }
}

/// Checks if a character is a newline character (single byte).
[[inline]]
fn is_newline(char: uint8) bool {
    switch (char) {
        case '\n' | '\r' | '\v' | '\f' => return true;
        else => return false;
    }
}