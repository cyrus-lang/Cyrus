import (
    std::mem{Allocator},
    std::path{Path},
    std::os{File},
);

import (
    tokens{SourceTokens},
    lexer{Lexer}
);

// Driver handler responsible for tokenizing source content.
// Will terminate the compiler if any error raised.
pub fn tokenize_source(
    allocator: Allocator,
    path: const Path*
) SourceTokens {
    switch (File.open(path, .Read)) case .Value(file) else {
        @panic("could not open file");
    }
    defer file.close();

    switch (file.read(allocator)) case .Value(source) else {
        @panic("could not read file");
    }
    defer source.free();

    var lexer = Lexer.new(allocator, &source);
    
    return SourceTokens.new(lexer.tokenize());
}