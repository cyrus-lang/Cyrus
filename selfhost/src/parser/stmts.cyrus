        case .LeftBrace => @todo();
    }
}

pub fn parse_global_var(state: ParserState*) bool {
    var is_static = false;
    var is_const = false;

    if (state->is(.Static)) {
        state->next();
        is_static = true;
    }

    if (state->is(.Const)) {
        state->next();
        is_const = true;
    } else {
        if (!state->expect(.Var)) {
            return false;
        }
    }

    switch (state->expect_ident()) case .Some(ident) else {
        return false;
    }

    if (!state->expect_semicolon()) {
        return false;
    }

    return true; 
}