import tokens{SourceTokens, Token, dump_token};
import .::state{ParserState};
import diags{DiagContext};

import std::libc{printf};

pub struct ParserStmts {
    source_tokens: const SourceTokens*,
    state: ParserState*,

    [[inline]]
    pub fn new(
        source_tokens: const SourceTokens*,
        state: ParserState*
    ) Self {
        return Self { source_tokens, state };
    }

    pub fn parse_toplevels(self: Self*) {
        const tokens = &self->source_tokens->tokens;

        for (var i: usize = 0; i < tokens->len(); i += 1) {
            parse_toplevel(self->state);            
        }
    }
}

pub fn parse_toplevel(state: ParserState*) bool {
    // TODO Detect & Parse Attributes
    // TODO Detect & Parse Builtins

    const token = state->current();

    var ok = false;

    switch (*token->kind) {
        case .Static | .Var | .Const => ok = parse_global_var(state);
        case .Import => @todo();
        case .Function => @todo();
        case .Module => @todo();
        case .Struct => @todo();
        case .Enum => @todo();
        case .Union => @todo();
        case .Typedef => @todo();
        case .Interface => @todo();
        else => {
            // TODO Emit diagnostic: invalid statement
        }
    }

    // TODO Drain Attributes
    // No matter is okay or not, always drain attrs if parsed something.

    return ok;
}

pub fn parse_stmt(state: ParserState*) {
    // TODO Detect & Parse Builtins
    // TODO Detect & Parse Inline Assembly

    const token = state->current();

    switch (*token->kind) {
        case .Var | .Const => @todo();
        case .Defer => @todo();
        case .If => @todo();
        case .Return => @todo();
        case .For => @todo();
        case .While => @todo();
        case .Break => @todo();
        case .Continue => @todo();
        case .Switch => @todo();
