pub enum Prec {
    Lowest,
    Assign,
    Or,
    And,
    Equals,
    LessGreater
    Sum,
    Product,
    Bitwise,
    Prefix,
    Call,
    Index,
    Field
}

/// Returns true if a <= b.
fn prec_less_eq(a: Prec, b: Prec) bool {
    return @cast(usize, a) <= @cast(usize, b);
}

/// Returns the next-higher precedence for right-associative parsing.
fn next_prec(p: Prec) Prec {
    return @cast(Prec, @cast(usize, p) + 1);
}
