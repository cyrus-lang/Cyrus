import std::mem::libc{LibcAllocator};
import std::mem{Allocator};
import std::string{String};
import std::os{File};
import std::path{Path};

import diags{exit_with_compile_error};

// FIXME: This function is not very efficient, as it reads the entire file into memory.
// It would be better to read the file in chunks and append to a String,
// but for now this is good enough.
//
// Also it exits program if something went wrong.
// Which I'm looking for to replace it with a more resilient helper method
// in the future.
pub fn read_file_to_string_or_exit(const file_name: const uint8*) String {
    const allocator: Allocator = dynamic LibcAllocator.new();

    var path = Path.new(allocator, file_name);
    defer path.free();

    var file: File = undefined;
    switch (File.open(&path, .Read)) {
        case .Value(_file) => file = _file;
        case .Error(_) => {
            exit_with_compile_error("failed to open source file");
            @unreachable();
        }
    }
    defer file.close();

    const result = file.read(allocator);

    switch (result) {
        case .Value(content) => return content;
        case .Error(_) => {
            exit_with_compile_error("failed to read source file");
            @unreachable();
        }
    }
}
