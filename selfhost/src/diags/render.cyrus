import std::color{colorize_fg, colorize, reset};
import std::io{Writer, StringWriter};
import std::mem::libc{LibcAllocator};
import std::format{format_usize};
import std::math{saturating_sub};
import std::collections{Vec};
import std::string{String};
import std::option{Option};
import std::mem{Allocator};
import std::os::tty;

import diags{DiagContext, SubDiag, Diag};
import source{Source, SourceContext};
import tokens{Loc, Span};

// FIXME Remove
import std::libc{printf};

const MIN_PANEL_SPACE: uint32 = 5;

pub struct CompilerDiagRender {
    dctx: const DiagContext*,
    sctx: const SourceContext*,
    writer: Writer,
    colorize: bool,

    [[inline]]
    pub fn new(
        dctx: const DiagContext*,
        sctx: const SourceContext*,
        writer: Writer,
    ) Self {
        const colorize = tty::is_color_supported(.Stderr);
        return Self { dctx, sctx, writer, colorize };
    }

    pub fn render(self: Self*) {
        const diags = self->dctx->diags();

        for (var i: usize = 0; i < diags->len(); i += 1) {
            const diag = diags->get_const(i).unwrap();
            const space = self->panel_space(diag);
            self->render_diag(diag, space);

            if (i < diags->len() - 1) {
                self->writer.write("\n");
            }
        }
    }

    pub fn panel_space(self: const Self*, diag: const Diag*) uint32 {
        const source = self->sctx->get(diag->span.source_id);
        const start_line = source->nearest_line(diag->span.loc.start).unwrap_or(1);
        const end_line = source->nearest_line(saturating_sub(diag->span.loc.end, 1)).unwrap_or(start_line);
        const end_space = line_space(end_line);

        var max_space: uint32 = line_space(start_line);
        
        if (end_space > max_space) {
            max_space = end_space;
        }
        if (max_space < MIN_PANEL_SPACE) {
            max_space = MIN_PANEL_SPACE;
        }

        return max_space + 2;
    }
    
    fn render_diag(self: Self*, diag: const Diag*, space: uint32) {
        const mesg = diag->mesg.as_str();
        const span = diag->span;
        const source = self->sctx->get(span.source_id);
        const line = source->nearest_line(span.loc.start).unwrap_or(1);
        const column = source->line_offset_to_column(line, span.loc.start);
        const file_path = source->path.as_string().as_str();

        self->render_header(file_path, mesg, line, column);
        self->render_panel(diag->under, span, source, space);

        self->render_helps(&diag->helps, space);
        self->render_notes(&diag->notes, space);

        self->render_pipe(space);
        self->writer.write_char('\n');
    }

    [[inline]]
    fn render_header(
        self: Self*,
        file_path: const uint8*,
        mesg: const uint8*,
        line: usize,
        column: usize
    ) {
        self->writer.write(file_path);
        self->writer.write(":");
        format_usize(self->writer, line);
        self->writer.write(":");
        format_usize(self->writer, column);
        self->writer.write(": ");
        self->writer.writeln(mesg);
    }

    fn render_panel(
        self: Self*,
        under: Option<String>,
        span: Span,
        source: const Source*,
        space: uint32
    ) {
        self->render_pipe(space);
        self->writer.write_char('\n');

        const line = source->nearest_line(span.loc.start).unwrap_or(1);
        const line_number_offset = (space - line_digits(line)) - 2;
        
        const prev_line = saturating_sub(line, 1);
        const is_panel_expanded = prev_line > 0 && prev_line < line;

        // Display previous line if expanded
        if (is_panel_expanded) {
            self->render_line_number(prev_line, line_number_offset);
            self->render_line(source, prev_line);
        }

        // Display current line
        self->render_line_number(line, line_number_offset);
        self->render_line(source, line);

        self->render_pipe(space);
        const line_start = source->line_to_offset(line - 1);
        const column_offset = span.loc.start - line_start;
        self->render_space(column_offset);

        var mark_len: usize = span.loc.end - span.loc.start;
        if (mark_len == 0) {
            mark_len = 1;
        }
        self->render_mark(mark_len);

        switch (under) {
            case .Some(str) => {
                self->render_under(
                    str.as_str_const(), 
                    column_offset, 
                    space
                );  
            }
        }
        
        self->writer.write_char('\n');
    }

    fn render_line_number(self: Self*, line: usize, offset: usize) {
        self->render_space(offset);
        format_usize(self->writer, line);

        if (self->colorize) {
            colorize_fg(self->writer, .Yellow, " ~ ");
        } else {
            self->writer.write(" ~ ");
        }
    }

    [[inline]]
    fn render_under(self: Self*, mesg: const uint8*, offset: usize, space: usize) {
        self->writer.write_char('\n');
        self->render_pipe(space);

        self->render_space(offset);
        self->writer.write_char(' '); // BECAUSE OF TILDE SPACE
        self->writer.write("╰ ");

        if (self->colorize) {
            colorize_fg(self->writer, .Cyan, mesg);
        } else {
            self->writer.write(mesg);
        }
    }

    [[inline]]
    fn render_mark(self: Self*, n: usize) {
        self->writer.write_char(' '); // BECAUSE OF TILDE SPACE

        if (self->colorize) {
            colorize(self->writer, .Red);
        }
        for (var i: usize = 0; i < n; i += 1) {
            self->writer.write("^");
        }
        if (self->colorize) {
            reset(self->writer);
        }
    }

    [[inline]]
    fn render_pipe(self: Self*, n: usize) {
        for (var i: usize; i < n - 1; i += 1) {
            self->writer.write(" ");
        }
        self->writer.write("|");
    }

    [[inline]]
    fn render_assign(self: Self*, n: usize) {
        for (var i: usize; i < n - 1; i += 1) {
            self->writer.write(" ");
        }

        if (self->colorize) {
            colorize_fg(self->writer, .Yellow, "=");
        } else {
            self->writer.write("=");
        }
    }

    [[inline]]
    fn render_space(self: Self*, n: usize) {
        for (var i: usize = 0; i < n; i += 1) {
            self->writer.write(" ");
        }
    }

    fn render_line(self: Self*, source: const Source*, n: usize) {
        const (ptr, len) = source->get_line(n).unwrap();

        for (var i: usize = 0; i < len; i += 1) {    
            self->writer.write_char(ptr[i]);
        }

        self->writer.write_char('\n');
    }

    fn render_helps(self: Self*, helps: const (Vec<String>)*, space: usize) {
        if (helps->len() > 0) {
            self->render_pipe(space);
            self->writer.write_char('\n');
        }

        for (var i: usize = 0; i < helps->len(); i += 1) {
            const help = helps->get_owned(i).unwrap();
            const mesg = help.as_str_const();

            self->render_assign(space);
            if (self->colorize) {
                colorize_fg(self->writer, .Blue, " help: ");
            } else {
                self->writer.write(" help: ");
            }
            self->writer.write(mesg);
            self->writer.write_char('\n');

            if (i != helps->len() - 1) {
                self->render_pipe(space);
                self->writer.write_char('\n');
            }
        }
    }

    fn render_notes(self: Self*, notes: const (Vec<String>)*, space: usize) {
        if (notes->len() > 0) {
            self->render_pipe(space);
            self->writer.write_char('\n');
        }

        for (var i: usize = 0; i < notes->len(); i += 1) {
            const note = notes->get_owned(i).unwrap();
            const mesg = note.as_str_const();

            self->render_assign(space);
            if (self->colorize) {
                colorize_fg(self->writer, .Green, " note: ");
            } else {
                self->writer.write(" note: ");
            }
            self->writer.write(mesg);
            self->writer.write_char('\n');

            if (i != notes->len() - 1) {
                self->render_pipe(space);
                self->writer.write_char('\n');
            }
        }
    }
}

[[inline]]
fn line_space(line: usize) uint32 {
    const i = line_digits(line);

    if (i < MIN_PANEL_SPACE) {
        return MIN_PANEL_SPACE;
    } else {
        return i + 1;
    }
}

[[inline]]
fn line_digits(var line: usize) uint32 {
    var i: uint32 = 0;
    while (line > 0) {
        line /= 10;
        i += 1;
    }
    return i;
}

[[inline]]
fn is_ws(char: uint8) bool {
    switch (char) {
        case ' ' | '\t' | '\r' | '\v' | '\f' => {
            return true;
        }
        else => return false;
    }
}
