import diags{DiagContext, SubDiag, Diag};
import std::io{Writer, StringWriter};
import std::mem::libc{LibcAllocator};
import std::format{format_usize};
import std::math{saturating_sub};
import std::string{String};
import std::mem{Allocator};
import source{Source};
import tokens{Loc};

// FIXME Remove
import std::libc{printf};

const MIN_PANEL_SPACE: uint32 = 5;

pub struct CompilerDiagRender {
    dctx: DiagContext,
    writer: Writer,
    source: Source,

    [[inline]]
    pub fn new(
        dctx: DiagContext,
        writer: Writer,
        source: Source
    ) Self {
        return Self { dctx, writer, source };
    }

    pub fn render(self: Self*) {
        const diags = self->dctx.diags();

        for (var i: usize = 0; i < diags->len(); i += 1) {
            const diag = diags->get(i).unwrap();
            const space = self->panel_space(diag);
            self->render_diag(diag, space);

            if (i < diags->len() - 1) {
                self->writer.write("\n\n");
            }
        }
    }

    /// Per diag.
    pub fn panel_space(self: const Self*, diag: const Diag*) uint32 {
        // TODO: Extract involved code lines in diag panel. (Multi Line Support)
        // FIXME
        return MIN_PANEL_SPACE;

        // var max_space: uint32 = MIN_PANEL_SPACE;

        // // max space of diags
        // for (var i: usize = 0; i < diags->len(); i += 1) {
        //     const diag = diags->get_ref(i).unwrap();
        //     const space = line_space(diag->loc.line);

        //     if (space > max_space) {
        //         max_space = space;
        //     }

        //     // max space of sub diags
        //     for (var j: usize = 0; j < diag->subs.len(); j += 1) {
        //         const diag = diag->subs.get_ref(j).unwrap();
        //         const space = line_space(diag->loc.line);

        //         if (space > max_space) {
        //             max_space = space;
        //         }
        //     }
        // }

        // // plus two for reserving whitespace 
        // // for the pipe and the space before it
        // return max_space + 2;
    }
    
    fn render_diag(self: Self*, diag: Diag*, space: uint32) {
        const mesg = diag->mesg.as_str();
        const line = diag->loc.line;
        const column = self->source.get_column(line, diag->loc.start);
        const file_path =
            self->source.path.as_string().as_str();

        self->render_header(file_path, mesg, line, column);
        self->render_code(diag->loc, space);

        switch (diag->under) {
            case .Some(str) => {
                self->render_under(str.as_str_const(), diag->loc, space);  
            }
        }

        self->render_subs(diag, space);
        self->render_pipe(space);
        self->writer.write("\n");
    }

    fn render_sub(self: Self*, sub: SubDiag*, space: uint32) {
        // FIXME: Mock data
        // self->render_code("var x: int32 = 0; // FAKE CODE", sub->loc, space);

        // switch (sub->under) {
        //     case .Some(str) => {
        //         self->render_under(str.as_str_const(), sub->loc, space);  
        //     }
        // }
        @todo();
    }

    [[inline]]
    fn render_header(
        self: Self*,
        file_path: const uint8*,
        mesg: const uint8*,
        line: usize,
        column: usize
    ) {
        self->writer.write(file_path);
        self->writer.write(":");
        format_usize(self->writer, line);
        self->writer.write(":");
        format_usize(self->writer, column);
        self->writer.write(": ");
        self->writer.writeln(mesg);
    }

    // TODO Colorize
    fn render_code(
        self: Self*,
        loc: Loc,
        space: uint32
    ) {
        self->render_pipe(space);
        self->writer.write("\n");

        const offset = (space - line_digits(loc.line)) - 2;

        self->render_space(offset);
        format_usize(self->writer, loc.line);

        self->writer.write(" ~ ");

        const content = self->source.content.as_str_const();
        const current_line = self->source.get_line(loc.start).unwrap();
        const prev_line = saturating_sub(current_line, 1);
        const current_line_start = self->source.get_line_offset(prev_line);
        const is_panel_expanded = prev_line != current_line && prev_line > 0;

        // Display previous line
        if (is_panel_expanded) {
            self->render_line(prev_line);
        }

        // Display current line
        for (var i: usize = current_line_start; i <= loc.end; i += 1) {
            if (self->source.is_line_offset(i)) {
                self->render_space(space + 1);
            }

            self->writer.write_char(content[i]);
        }

        self->render_space(space + 1);
        self->render_space(loc.start - current_line_start);
        self->render_mark(loc.end - loc.start);
        self->writer.write("\n");
    }

    // FIXME
    fn render_under(self: Self*, mesg: const uint8*, loc: Loc, space: uint32) {
        // self->render_space(space);
        // self->render_space(loc.start);
        // self->writer.write("! ");
        // self->writer.write(mesg);
        // self->writer.write("\n");
    }

    fn render_subs(self: Self*, diag: Diag*, space: uint32) {
        for (var i: usize; i < diag->subs.len(); i += 1) {
            const sub = diag->subs.get(i).unwrap();
            self->render_sub(sub, space);
        }
    }

    [[inline]]
    fn render_mark(self: Self*, n: usize) {
        for (var i: usize; i < n; i += 1) {
            self->writer.write("^");
        }
    }

    [[inline]]
    fn render_pipe(self: Self*, n: usize) {
        for (var i: usize; i < n - 1; i += 1) {
            self->writer.write(" ");
        }
        self->writer.write("|");
    }

    [[inline]]
    fn render_space(self: Self*, n: usize) {
        for (var i: usize; i < n; i += 1) {
            self->writer.write(" ");
        }
    }

    fn render_line(self: Self*, n: usize) {
        const content = self->source.content.as_str_const();
        const (ptr, len) = self->source.get_line_content(n).unwrap();

        for (var i: usize = 0; i < len; i += 1) {    
            self->writer.write_char(content[i]);
        }

        self->writer.write_char('\n');
    }
}

[[inline]]
fn line_space(line: usize) uint32 {
    const i = line_digits(line);

    if (i < MIN_PANEL_SPACE) {
        return MIN_PANEL_SPACE;
    } else {
        return i + 1;
    }
}

[[inline]]
fn line_digits(var line: usize) uint32 {
    var i: uint32 = 0;
    while (line > 0) {
        line /= 10;
        i += 1;
    }
    return i;
}

[[inline]]
fn is_ws(char: uint8) bool {
    switch (char) {
        case ' ' | '\t' | '\r' | '\v' | '\f' => {
            return true;
        }
        else => return false;
    }
}