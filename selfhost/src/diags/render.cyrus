import (
    std::mem::libc{LibcAllocator},
    std::io{Writer, StringWriter},
    std::format{format_usize},
    std::string{String},
    std::mem{Allocator},
);

import std::libc{printf};

import (
    diags{
        DiagContext,
        SubDiag,
        Diag,
    },
    tokens{Loc}
);

const MIN_PANEL_SPACE: uint32 = 5;

pub struct CompilerDiagRender {
    dctx: DiagContext,
    // sctx: SourceContext,

    pub fn new(dctx: DiagContext) Self {
        return Self { dctx };
    }

    pub fn render(self: Self*) String {
        const diags = self->dctx.diags();

        const space = self->panel_space();

        const allocator: Allocator = dynamic LibcAllocator.new();
        var out = String.new(allocator);

        var writer: Writer = dynamic StringWriter.new(&out);

        for (var i: usize = 0; i < diags->len(); i += 1) {
            const diag = diags->get_ref(i).unwrap();

            render_diag(writer, diag, space);

            if (i < diags->len() - 1) {
                writer.write("\n\n");
            }
        }

        return out;
    }

    pub fn panel_space(self: const Self*) uint32 {
        const diags = self->dctx.diags();

        var max_space: uint32 = MIN_PANEL_SPACE;

        // max space of diags
        for (var i: usize = 0; i < diags->len(); i += 1) {
            const diag = diags->get_ref(i).unwrap();
            const space = line_space(diag->loc.line);

            if (space > max_space) {
                max_space = space;
            }

            // max space of sub diags
            for (var j: usize = 0; j < diag->subs.len(); j += 1) {
                const diag = diag->subs.get_ref(j).unwrap();
                const space = line_space(diag->loc.line);

                if (space > max_space) {
                    max_space = space;
                }
            }
        }

        // plus two for reserving whitespace 
        // for the pipe and the space before it
        return max_space + 2;
    }
}

fn render_diag(writer: Writer, diag: Diag*, space: uint32) {
    // FIXME: Mock data
    render_header(writer, "./selfhost/src/main.cyrus", "something went wrong", diag->loc);
    render_code(writer, "var x: int32 = 0; // FAKE CODE", diag->loc, space);

    switch (diag->under) {
        case .Some(str) => {
            render_under(writer, str.as_str_const(), diag->loc, space);  
        }
    }

    // FIXME: Mock data
    render_subs(writer, diag);
    render_pipe(writer, space);
}

fn render_sub(writer: Writer, sub: SubDiag*) {
    const space = MIN_PANEL_SPACE;

    render_code(writer, "var x: int32 = 0; // FAKE CODE", sub->loc, space);

    switch (sub->under) {
        case .Some(str) => {
            render_under(writer, str.as_str_const(), sub->loc, space);  
        }
    }
}

fn render_header(
    var writer: Writer,
    file_path: const uint8*,
    mesg: const uint8*,
    loc: Loc
) {
    // TODO: writer.write(self->loc.file_id);
    writer.write(file_path);
    writer.write(":");
    format_usize(writer, loc.line);
    writer.write(":");
    format_usize(writer, loc.col);
    writer.write(": ");
    writer.writeln(mesg);
}

fn render_code(
    var writer: Writer,
    code: const uint8*,
    loc: Loc,
    space: uint32
) {
    render_pipe(writer, space);
    writer.write("\n");

    const offset = (space - line_digits(loc.line)) - 2;

    render_space(writer, offset);
    format_usize(writer, loc.line);

    writer.write(" ~ ");
    writer.writeln(code);

    render_space(writer, space);
    render_space(writer, loc.start);
    render_mark(writer, loc.end - loc.start);
    writer.write("\n");
}

fn render_under(writer: Writer, mesg: const uint8*, loc: Loc, space: uint32) {
    render_space(writer, space);
    render_space(writer, loc.start);
    writer.write("! ");
    writer.write(mesg);
    writer.write("\n");
}

fn render_subs(writer: Writer, diag: Diag*) {
    for (var i: usize; i < diag->subs.len(); i += 1) {
        const sub = diag->subs.get_ref(i).unwrap();

        render_sub(writer, sub);
    }
}

inline fn render_mark<T>(writer: Writer, n: T) {
    for (var i: usize; i < n; i += 1) {
        writer.write("^");
    }
}

inline fn render_pipe<T>(writer: Writer, n: T) {
    for (var i: usize; i < n - 1; i += 1) {
        writer.write(" ");
    }
    writer.write("|");
}

inline fn render_space<T>(writer: Writer, n: T) {
    for (var i: usize; i < n; i += 1) {
        writer.write(" ");
    }
}

inline fn line_space(var line: usize) uint32 {
    const i = line_digits(line);

    if (i < MIN_PANEL_SPACE) {
        return MIN_PANEL_SPACE;
    } else {
        return i + 1;
    }
}

inline fn line_digits(var line: usize) uint32 {
    var i: uint32 = 0;
    while (line > 0) {
        line /= 10;
        i += 1;
    }
    return i;
}