import std::color{colorize_fg, colorize, reset};
import std::io{Writer, StringWriter};
import std::mem::libc{LibcAllocator};
import std::format{format_usize};
import std::math{saturating_sub};
import std::collections{Vec};
import std::string{String};
import std::option{Option};
import std::mem{Allocator};
import std::os::tty;

import diags{DiagContext, SubDiag, Diag};
import source{Source};
import tokens{Loc};

// FIXME Remove
import std::libc{printf};

const MIN_PANEL_SPACE: uint32 = 5;

pub struct CompilerDiagRender {
    dctx: DiagContext,
    writer: Writer,
    source: Source,
    colorize: bool,

    [[inline]]
    pub fn new(
        dctx: DiagContext,
        writer: Writer,
        source: Source
    ) Self {
        const colorize = tty::is_color_supported(.Stderr);
        return Self { dctx, writer, source, colorize };
    }

    pub fn render(self: Self*) {
        const diags = self->dctx.diags();

        for (var i: usize = 0; i < diags->len(); i += 1) {
            const diag = diags->get_const(i).unwrap();
            const space = self->panel_space(diag);
            self->render_diag(diag, space);

            if (i < diags->len() - 1) {
                self->writer.write("\n\n");
            }
        }
    }

    pub fn panel_space(self: const Self*, diag: const Diag*) uint32 {
        const diags = self->dctx.diags();

        var max_space: uint32 = MIN_PANEL_SPACE;

        // Max space of diags
        for (var i: usize = 0; i < diags->len(); i += 1) {
            const diag = diags->get_const(i).unwrap();
            const space = line_space(diag->loc.line);

            if (space > max_space) {
                max_space = space;
            }
        }

        // Plus two for reserving whitespace 
        // for the pipe and the space before it
        return max_space + 2;
    }
    
    fn render_diag(self: Self*, diag: const Diag*, space: uint32) {
        const mesg = diag->mesg.as_str();
        const line = diag->loc.line;
        const column = self->source.get_column(line, diag->loc.start);
        const file_path =
            self->source.path.as_string().as_str();

        self->render_header(file_path, mesg, line, column);
        self->render_panel(diag->under, diag->loc, space);

        self->render_helps(&diag->helps, space);
        self->render_notes(&diag->helps, space);

        self->render_pipe(space);
        self->writer.write_char('\n');
    }

    [[inline]]
    fn render_header(
        self: Self*,
        file_path: const uint8*,
        mesg: const uint8*,
        line: usize,
        column: usize
    ) {
        self->writer.write(file_path);
        self->writer.write(":");
        format_usize(self->writer, line);
        self->writer.write(":");
        format_usize(self->writer, column);
        self->writer.write(": ");
        self->writer.writeln(mesg);
    }

    fn render_panel(
        self: Self*,
        under: Option<String>,
        loc: Loc,
        space: uint32
    ) {
        self->render_pipe(space);
        self->writer.write_char('\n');

        const line_number_offset = (space - line_digits(loc.line)) - 2;
        self->render_line_number(loc.line - 1, line_number_offset);
        
        const content = self->source.content.as_str_const();
        const current_line = self->source.get_line(loc.start).unwrap();
        const prev_line = saturating_sub(current_line, 1);
        const current_line_start = self->source.get_line_offset(prev_line);
        const is_panel_expanded = prev_line != current_line && prev_line > 0;

        // Display previous line
        if (is_panel_expanded) {
            self->render_line(prev_line);
            self->render_line_number(loc.line, line_number_offset);
        }

        // Display current line
        for (var i: usize = current_line_start; i <= loc.end; i += 1) {
            if (self->source.is_line_offset(i) && i != current_line_start) {
                self->render_pipe(space);
            }

            self->writer.write_char(content[i]);
        }

        self->render_pipe(space);
        self->render_space(loc.start - current_line_start);
        self->render_mark(loc.end - loc.start);

        switch (under) {
            case .Some(str) => {
                self->render_under(
                    str.as_str_const(), 
                    loc.start - current_line_start, 
                    space
                );  
            }
        }
        
        self->writer.write_char('\n');
    }

    fn render_line_number(self: Self*, line: usize, offset: usize) {
        self->render_space(offset);
        format_usize(self->writer, line);

        if (self->colorize) {
            colorize_fg(self->writer, .Yellow, " ~ ");
        } else {
            self->writer.write(" ~ ");
        }
    }

    [[inline]]
    fn render_under(self: Self*, mesg: const uint8*, offset: usize, space: usize) {
        self->writer.write_char('\n');
        self->render_pipe(space);

        self->render_space(offset);
        self->writer.write_char(' '); // BECAUSE OF TILDE SPACE
        self->writer.write("|");

        self->writer.write_char('\n');
        self->render_pipe(space);
        self->render_space(offset);

        if (self->colorize) {
            self->writer.write_char(' '); // BECAUSE OF TILDE SPACE
            colorize_fg(self->writer, .Cyan, mesg);
        } else {
            self->writer.write_char(' '); // BECAUSE OF TILDE SPACE
            self->writer.write(mesg);
        }
    }

    [[inline]]
    fn render_mark(self: Self*, n: usize) {
        self->writer.write_char(' '); // BECAUSE OF TILDE SPACE

        if (self->colorize) {
            colorize(self->writer, .Red);
        }
        for (var i: usize = 0; i < n; i += 1) {
            self->writer.write("^");
        }
        if (self->colorize) {
            reset(self->writer);
        }
    }

    [[inline]]
    fn render_pipe(self: Self*, n: usize) {
        for (var i: usize; i < n - 1; i += 1) {
            self->writer.write(" ");
        }
        self->writer.write("|");
    }

    [[inline]]
    fn render_assign(self: Self*, n: usize) {
        for (var i: usize; i < n - 1; i += 1) {
            self->writer.write(" ");
        }

        if (self->colorize) {
            colorize_fg(self->writer, .Yellow, "=");
        } else {
            self->writer.write("=");
        }
    }

    [[inline]]
    fn render_space(self: Self*, n: usize) {
        for (var i: usize; i < n; i += 1) {
            self->writer.write(" ");
        }
    }

    fn render_line(self: Self*, n: usize) {
        const content = self->source.content.as_str_const();
        const (ptr, len) = self->source.get_line_content(n).unwrap();

        for (var i: usize = 0; i < len; i += 1) {    
            self->writer.write_char(content[i]);
        }

        self->writer.write_char('\n');
    }

    fn render_helps(self: Self*, helps: const (Vec<String>)*, space: usize) {
        if (helps->len() > 0) {
            self->render_pipe(space);
            self->writer.write_char('\n');
        }

        for (var i: usize = 0; i < helps->len(); i += 1) {
            const help = helps->get_owned(i).unwrap();
            const mesg = help.as_str_const();

            self->render_assign(space);
            if (self->colorize) {
                colorize_fg(self->writer, .Blue, " help: ");
            } else {
                self->writer.write(" help: ");
            }
            self->writer.write(mesg);
            self->writer.write_char('\n');

            if (i != helps->len() - 1) {
                self->render_pipe(space);
                self->writer.write_char('\n');
            }
        }
    }

    fn render_notes(self: Self*, notes: const (Vec<String>)*, space: usize) {
        if (notes->len() > 0) {
            self->render_pipe(space);
            self->writer.write_char('\n');
        }

        for (var i: usize = 0; i < notes->len(); i += 1) {
            const help = notes->get_owned(i).unwrap();
            const mesg = help.as_str_const();

            self->render_assign(space);
            if (self->colorize) {
                colorize_fg(self->writer, .Green, " note: ");
            } else {
                self->writer.write(" help: ");
            }
            self->writer.write(mesg);
            self->writer.write_char('\n');

            if (i != notes->len() - 1) {
                self->render_pipe(space);
                self->writer.write_char('\n');
            }
        }
    }
}

[[inline]]
fn line_space(line: usize) uint32 {
    const i = line_digits(line);

    if (i < MIN_PANEL_SPACE) {
        return MIN_PANEL_SPACE;
    } else {
        return i + 1;
    }
}

[[inline]]
fn line_digits(var line: usize) uint32 {
    var i: uint32 = 0;
    while (line > 0) {
        line /= 10;
        i += 1;
    }
    return i;
}

[[inline]]
fn is_ws(char: uint8) bool {
    switch (char) {
        case ' ' | '\t' | '\r' | '\v' | '\f' => {
            return true;
        }
        else => return false;
    }
}