import std::io{Writer, StringWriter};
import std::mem::libc{LibcAllocator};
import std::libc{stderr, fprintf};
import std::format{format_usize};
import std::collections{Vec};
import std::option{Option};
import std::mem{Allocator};
import std::string{String};
import std::os{exit};
import tokens{Loc};

pub struct DiagContext {
    diags: Vec<Diag>,

    pub fn new(allocator: Allocator) Self {
        return Self { diags: Vec.new(allocator) };
    }

    [[inline]]
    pub fn report(self: Self*, diag: Diag) {
        self->diags.push(diag);
    }

    [[inline]]
    pub fn diags(self: const Self*) const (Vec<Diag>)* {
        return &self->diags;
    }

    pub fn free(self: Self*) {
        for (var i: usize; i < self->diags.len(); i += 1) {
            var diag = self->diags.get_owned(i).unwrap();
            diag.free();
        }

        self->diags.free();
    }
}

pub struct Diag {
    allocator: Allocator,
    pub mesg: String,
    pub under: Option<String>,
    pub helps: Vec<String>,
    pub notes: Vec<String>,
    pub loc: Loc,

    pub fn new(
        allocator: Allocator,
        mesg: const uint8*,
        loc: Loc
    ) Self {
        return Self {
            allocator,
            mesg: String.from_str(allocator, mesg), 
            helps: Vec.new(allocator), 
            notes: Vec.new(allocator),
            under: .None,
            loc
        };
    }
    
    [[inline]]
    pub fn help(self: Self*, mesg: const uint8*) Self* {
        const mesg = String.from_str(self->allocator, mesg);
        self->helps.push(mesg);
        return self;
    }

    [[inline]]
    pub fn note(self: Self*, mesg: const uint8*) Self* {
        const mesg = String.from_str(self->allocator, mesg);
        self->notes.push(mesg);
        return self;
    }

    pub fn under(self: Self*, mesg: const uint8*) Self* {
        const str = String.from_str(self->allocator, mesg);
        self->under = .Some(str);
        return self;
    }

    pub fn free(self: Self*) {
        self->mesg.free();

        switch (self->under) {
            case .Some(str) => str.free();
        }
        
        for (var i: usize; i < self->helps.len(); i += 1) {
            var str = self->helps.get_owned(i).unwrap();
            str.free();
        }
        
        for (var i: usize; i < self->notes.len(); i += 1) {
            var str = self->notes.get_owned(i).unwrap();
            str.free();
        }

        self->helps.free();
        self->notes.free();
    }
}

pub enum SubDiagKind {
    Hint,
    Info
}

pub struct SubDiag {
    pub kind: SubDiagKind,
    pub mesg: String,
    pub under: Option<String>,
    pub loc: Loc,

    pub fn new(
        kind: SubDiagKind,
        mesg: String,
        under: Option<String>,
        loc: Loc
    ) Self {
        return Self { kind, mesg, under, loc };
    }
    
    pub fn free(self: Self*) {
        self->mesg.free();

        switch (self->under) {
            case .Some(str) => str.free();
        }
    }
}

pub fn exit_with_compile_error(mesg: const uint8*) {
    fprintf(stderr, "error: %s\n", mesg);
    exit(.Failure);
}