import std::io{Writer, StringWriter};
import std::mem::libc{LibcAllocator};
import std::libc{stderr, fprintf};
import std::format{format_usize};
import std::collections{Vec};
import std::option{Option};
import std::mem{Allocator};
import std::string{String};
import std::os{exit};
import tokens{Loc};

pub struct DiagContext {
    diags: Vec<Diag>,

    [[inline]]
    pub fn new(allocator: Allocator) Self {
        const diags: Vec<Diag> = Vec.new(allocator);
        
        return Self { diags };
    }

    [[inline]]
    pub fn report(self: Self*, diag: Diag) {
        self->diags.push(diag);
    }

    [[inline]]
    pub fn diags(self: const Self*) const (Vec<Diag>)* {
        return &self->diags;
    }

    pub fn free(self: Self*) {
        for (var i: usize; i < self->diags.len(); i += 1) {
            var diag = self->diags.get_owned(i).unwrap();
            diag.free();
        }

        self->diags.free();
    }
}

pub struct Diag {
    allocator: Allocator,
    pub mesg: String,
    pub under: Option<String>,
    pub subs: Vec<SubDiag>,
    pub loc: Loc,

    [[inline]]
    pub fn new(
        allocator: Allocator,
        mesg: const uint8*,
        loc: Loc
    ) Self {
        const str = String.from_str(allocator, mesg);
        var subs: Vec<SubDiag> = Vec.new(allocator);

        return Self {
            allocator,
            mesg: str, 
            under: .None,
            subs, 
            loc
        };
    }

    pub fn under(self: Self*, mesg: const uint8*) Self* {
        const str = String.from_str(self->allocator, mesg);
        self->under = .Some(str);
        return self;
    }

    [[inline]]
    pub fn add_sub(self: Self*, sub: SubDiag) {
        self->subs.push(sub);
    }

    pub fn free(self: Self*) {
        self->mesg.free();

        switch (self->under) {
            case .Some(str) => str.free();
        }
        
        for (var i: usize; i < self->subs.len(); i += 1) {
            var sub = self->subs.get_owned(i).unwrap();
            sub.free();
        }

        self->subs.free();
    }
}

pub enum SubDiagKind {
    Hint,
    Info
}

pub struct SubDiag {
    pub kind: SubDiagKind,
    pub mesg: String,
    pub under: Option<String>,
    pub loc: Loc,

    pub fn new(
        kind: SubDiagKind,
        mesg: String,
        under: Option<String>,
        loc: Loc
    ) Self {
        return Self { kind, mesg, under, loc };
    }
    
    pub fn free(self: Self*) {
        self->mesg.free();

        switch (self->under) {
            case .Some(str) => str.free();
        }
    }
}

pub fn exit_with_compile_error(mesg: const uint8*) {
    fprintf(stderr, "error: %s\n", mesg);
    exit(.Failure);
}