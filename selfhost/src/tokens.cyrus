import std::mem::arena{ArenaAllocator};
import std::mem::libc{LibcAllocator};
import std::collections{Vec};
import std::io{StringWriter};
import std::string{String};
import std::mem{Allocator};
import std::option{Option};
import std::libc{printf};
import std::io{Writer};
import std::format{
    Format,
    format_int128,
    format_uint128,
    format_float64,
    format_bool
};

pub struct SourceTokens {
    // pub source_id: SourceId,
    pub tokens: Vec<Token>,
    pub arena: ArenaAllocator,

    [[inline]]
    pub fn new(tokens: Vec<Token>, arena: ArenaAllocator) Self {
        return Self { tokens, arena };
    }

    pub fn free(self: Self*) {
        for (var i: usize = 0; i < self->tokens.len(); i += 1) {
            const token = self->tokens.get_owned(i).unwrap();
            token.free();
        }

        self->tokens.free();
        self->arena.destroy();
    }
}

pub struct Token : Format {
    pub kind: TokenKind*,
    pub loc: Loc,

    [[inline]]
    pub fn new(kind: TokenKind*, loc: Loc) Self {
        return Self { kind, loc }; 
    }

    [[inline]]
    pub fn format(self: const Self*, writer: Writer) bool {
        return self->kind->format(writer);
    }

    [[inline]]
    pub fn free(self: Self*) {
        // switch (*self->kind) {
        //     case .Ident(ident) => ident.free();
        //     case .Literal(lit) => switch (lit) {
        //         case .String { value, .. } => value.free();
        //     }
        // }
    }
}

pub enum TokenKind : Format {
    Ident(String),
    Literal(Literal),

    // Operators
    Plus,
    Minus,
    Slash,
    Asterisk,
    Percent,
    Increment,
    Decrement,

    // Symbols
    ShiftRight,
    ShiftLeft,
    Caret,
    AmpTilde,
    Tilde,
    Assign,
    Equal,
    NotEqual,
    Bang,
    LeftParen,
    RightParen,
    LeftBrace,
    RightBrace,
    LeftBracket,
    RightBracket,
    Comma,
    ThinArrow,
    FatArrow,
    Dot,
    DoubleDot,
    TripleDot,
    DoubleQuote,
    SingleQuote,
    Pipe,
    Ampersand,
    Semicolon,
    Colon,
    DoubleColon,
    LessThan,
    GreaterThan,
    LessEqual,
    GreaterEqual,
    And,
    Or,
    At,
    Underscore,

    // Keywords
    Module,
    Var,
    Dynamic,
    Goto,
    Defer,
    Union,
    Interface,
    Function,
    Typedef,
    Switch,
    Case,
    Default,
    If,
    Else,
    Return,
    For,
    While,
    Foreach,
    Break,
    Continue,
    Struct,
    Import,
    In,
    Enum,
    True,
    False,
    Null,
    As,

    // Types
    UIntPtr,
    IntPtr,
    ISize,
    USize,
    Int8,
    Int16,
    Int32,
    Int64,
    Int128,
    UInt8,
    UInt16,
    UInt32,
    UInt64,
    UInt128,
    Float16,
    Float32,
    Float64,
    Float128,
    Void,
    Bool,
    Const,

    // Modifiers
    Extern,
    Public,

    // LEXER INTERNALL
    EOF,
    INVALID,

    [[inline]]
    pub fn is_eof(self: const Self*) bool {
        switch (*self) {
            case .EOF => return true;
            else => return false;
        }
    }

    pub fn as_integer_suffix(self: const Self*) Option<IntegerSuffix> {
        switch (*self) {
            case .ISize => return .Some(.ISize);
            case .USize => return .Some(.USize);
            case .Int8 => return .Some(.Int8);
            case .Int16 => return .Some(.Int16);
            case .Int32 => return .Some(.Int32);
            case .Int64 => return .Some(.Int64);
            case .Int128 => return .Some(.Int128);
            case .UInt8 => return .Some(.UInt8);
            case .UInt16 => return .Some(.UInt16);
            case .UInt32 => return .Some(.UInt32);
            case .UInt64 => return .Some(.UInt64);
            case .UInt128 =>return .Some(.UInt128);
            else => return .None;
        }
    }

    pub fn as_float_suffix(self: const Self*) Option<FloatSuffix> {
        switch (*self) {
            case .Float16 => return .Some(.Float16);
            case .Float32 => return .Some(.Float32);
            case .Float64 => return .Some(.Float64);
            case .Float128 => return .Some(.Float128);
            else => return .None;
        }
    }

    pub fn is_signed_integer(self: const Self*) bool {
        switch (*self) {
            case .ISize | .Int8 | .Int16 | .Int32 | .Int64 | .Int128 => return true;
            else => return false;
        }
    }

    pub fn is_unsigned_integer(self: const Self*) bool {
        switch (*self) {
            case .USize | .UInt8 | .UInt16 | .UInt32 | .UInt64 | .UInt128 => return true;
            else => return false;
        }
    }

    pub fn lookup_keyword(str: const uint8*) Option<Self> {
        switch (str) {
            case "dynamic" => return .Some(.Dynamic);
            case "var" => return .Some(.Var);
            case "mod" => return .Some(.Module);
            case "interface" => return .Some(.Interface);
            case "type" => return .Some(.Typedef);
            case "fn" => return .Some(.Function);
            case "switch" => return .Some(.Switch);
            case "case" => return .Some(.Case);
            case "default" => return .Some(.Default);
            case "struct" => return .Some(.Struct);
            case "import" => return .Some(.Import);
            case "if" => return .Some(.If);
            case "else" => return .Some(.Else);
            case "return" => return .Some(.Return);
            case "for" => return .Some(.For);
            case "foreach" => return .Some(.Foreach);
            case "break" => return .Some(.Break);
            case "continue" => return .Some(.Continue);
            case "true" => return .Some(.True);
            case "false" => return .Some(.False);
            case "null" => return .Some(.Null);
            case "uintptr" => return .Some(.UIntPtr);
            case "intptr" => return .Some(.IntPtr);
            case "isize" => return .Some(.ISize);
            case "usize" => return .Some(.USize);
            case "int8" => return .Some(.Int8);
            case "int16" => return .Some(.Int16);
            case "int32" => return .Some(.Int32);
            case "int64" => return .Some(.Int64);
            case "int128" => return .Some(.Int128);
            case "uint8" => return .Some(.UInt8);
            case "uint16" => return .Some(.UInt16);
            case "uint32" => return .Some(.UInt32);
            case "uint64" => return .Some(.UInt64);
            case "uint128" => return .Some(.UInt128);
            case "float16" => return .Some(.Float16);
            case "float32" => return .Some(.Float32);
            case "float64" => return .Some(.Float64);
            case "float128" => return .Some(.Float128);
            case "bool" => return .Some(.Bool);
            case "void" => return .Some(.Void);
            case "enum" => return .Some(.Enum);
            case "extern" => return .Some(.Extern);
            case "pub" => return .Some(.Public);
            case "const" => return .Some(.Const);
            case "goto" => return .Some(.Goto);
            case "defer" => return .Some(.Defer);
            case "union" => return .Some(.Union);
            case "while" => return .Some(.While);
        }

        return .None;
    }

    pub fn format(self: const Self*, writer: Writer) bool {
        switch (*self) {
            case .Ident(ident) => writer.write(ident.as_str_const());
            case .Literal(lit) => lit.format(writer);

            case .Underscore => writer.write("_");
            case .Plus => writer.write("+");
            case .Minus => writer.write("-");
            case .Asterisk => writer.write("*");
            case .Slash => writer.write("/");
            case .Percent => writer.write("%");
            case .Assign => writer.write("=");
            case .Equal => writer.write("==");
            case .LeftParen => writer.write("(");
            case .RightParen => writer.write(")");
            case .LeftBrace => writer.write("{");
            case .RightBrace => writer.write("}");
            case .LeftBracket => writer.write("[");
            case .RightBracket => writer.write("]");
            case .At => writer.write("@");
            case .Comma => writer.write(",");
            case .DoubleDot => writer.write("..");
            case .TripleDot => writer.write("...");
            case .Dot => writer.write(".");
            case .DoubleQuote => writer.write("\"");
            case .SingleQuote => writer.write("'");
            case .Pipe => writer.write("|");
            case .Ampersand => writer.write("&");
            case .LessThan => writer.write("<");
            case .GreaterThan => writer.write(">");
            case .LessEqual => writer.write("<=");
            case .GreaterEqual => writer.write(">=");
            case .And => writer.write("&&");
            case .Or => writer.write("||");
            case .Semicolon => writer.write(";");
            case .Colon => writer.write(":");
            case .ThinArrow => writer.write("->");
            case .FatArrow => writer.write("=>");
            case .Increment => writer.write("++");
            case .Decrement => writer.write("--");
            case .ShiftRight => writer.write(">>");
            case .ShiftLeft => writer.write("<<");
            case .Caret => writer.write("^");
            case .AmpTilde => writer.write("&~");
            case .Tilde => writer.write("~");
            case .NotEqual => writer.write("!=");
            case .Bang => writer.write("!");
            case .DoubleColon => writer.write("::");

            case .Dynamic => writer.write("dynamic");
            case .Var => writer.write("var");
            case .Module => writer.write("mod");
            case .Interface => writer.write("interface");
            case .Typedef => writer.write("type");
            case .Function => writer.write("fn");
            case .Switch => writer.write("switch");
            case .Case => writer.write("case");
            case .Struct => writer.write("struct");
            case .Import => writer.write("import");
            case .If => writer.write("if");
            case .Else => writer.write("else");
            case .Return => writer.write("return");
            case .For => writer.write("for");
            case .Break => writer.write("break");
            case .Continue => writer.write("continue");
            case .True => writer.write("true");
            case .False => writer.write("false");
            case .Null => writer.write("null");
            case .UIntPtr => writer.write("uintptr");
            case .IntPtr => writer.write("intptr");
            case .ISize => writer.write("isize");
            case .USize => writer.write("usize");
            case .Int8 => writer.write("int8");
            case .Int16 => writer.write("int16");
            case .Int32 => writer.write("int32");
            case .Int64 => writer.write("int64");
            case .Int128 => writer.write("int128");
            case .UInt8 => writer.write("uint8");
            case .UInt16 => writer.write("uint16");
            case .UInt32 => writer.write("uint32");
            case .UInt64 => writer.write("uint64");
            case .UInt128 => writer.write("uint128");
            case .Float16 => writer.write("float16");
            case .Float32 => writer.write("float32");
            case .Float64 => writer.write("float64");
            case .Float128 => writer.write("float128");
            case .Bool => writer.write("bool");
            case .Void => writer.write("void");
            case .Enum => writer.write("enum");
            case .Public => writer.write("pub");
            case .Const => writer.write("const");
            case .Goto => writer.write("goto");
            case .Defer => writer.write("defer");
            case .Union => writer.write("union");
            case .While => writer.write("while");
            case .Extern => writer.write("extern");

            case .EOF => writer.write("EOF");
            case .INVALID => writer.write("INVALID");
        }
        return true;
    }
}

pub enum Literal : Format {
    Integer {
        value: enum {
            Signed(int128),
            Unsigned(uint128)
        },
        suffix: Option<IntegerSuffix>
    },
    Float {
        value: float64,
        suffix: Option<FloatSuffix>
    },
    String {
        value: String,
        suffix: Option<StringPrefix>
    },
    Char(uint8),
    Bool(bool),
    Null,

    pub fn format(self: const Self*, writer: Writer) bool {
        switch (*self) {
            case .Integer { value, suffix } => {
                switch (value) {
                    case .Signed(x) => format_int128(writer, x);
                    case .Unsigned(x) => format_uint128(writer, x);
                }
                switch (suffix) {
                    case .Some(s) => writer.write(s.to_str());
                }
            }
            case .Float { value, suffix } => {
                format_float64(writer, value);
                switch (suffix) {
                    case .Some(s) => writer.write(s.to_str());
                }
            }
            case .String { value, suffix } => {
                switch (suffix) {
                    case .Some(s) => writer.write(s.to_str());
                }
                writer.write("\"");
                writer.write(value.as_str_const());
                writer.write("\"");
            }
            case .Char(var char) => {
                const escaped = char_to_escape_sequence(char);
                writer.write_char('\'');
                if (is_escaped_char(char)) {
                    writer.write_char('\\');
                }
                writer.write_char(escaped);
                writer.write_char('\'');
            }
            case .Bool(char) => format_bool(writer, char);
            case .Null => writer.write("null");
        }
        return true;
    }
}

pub enum IntegerSuffix {
    ISize,
    USize,
    Int8,
    Int16,
    Int32,
    Int64,
    Int128,
    UInt8,
    UInt16,
    UInt32,
    UInt64,
    UInt128,

    pub fn from_str(str: const uint8*) Option<Self> {
        switch (str) {
            case "isize" => return .Some(.ISize);
            case "usize" => return .Some(.USize);
            case "int8" => return .Some(.Int8);
            case "int16" => return .Some(.Int16);
            case "int32" => return .Some(.Int32);
            case "int64" => return .Some(.Int64);
            case "int128" => return .Some(.Int128);
            case "uint8" => return .Some(.UInt8);
            case "uint16" => return .Some(.UInt16);
            case "uint32" => return .Some(.UInt32);
            case "uint64" => return .Some(.UInt64);
            case "uint128" => return .Some(.UInt128);
            else => return .None;
        }
    }

    pub fn to_str(self: Self) const uint8* {
        switch (self) {
            case .ISize => return "isize";
            case .USize => return "usize";
            case .Int8 => return "int8";
            case .Int16 => return "int16";
            case .Int32 => return "int32";
            case .Int64 => return "int64";
            case .Int128 => return "int128";
            case .UInt8 => return "uint8";
            case .UInt16 => return "uint16";
            case .UInt32 => return "uint32";
            case .UInt64 => return "uint64";
            case .UInt128 => return "uint128";
        }
    }
}

pub enum FloatSuffix {
    Float16,
    Float32,
    Float64,
    Float128,

    pub fn from_str(str: const uint8*) Option<Self> {
        switch (str) {
            case "float16" => return .Some(.Float16);
            case "float32" => return .Some(.Float32);
            case "float64" => return .Some(.Float64);
            case "float128" => return .Some(.Float128);
            else => return .None;
        }
    }

    pub fn to_str(self: Self) const uint8* {
        switch (self) {
            case .Float16 => return "float16";
            case .Float32 => return "float32";
            case .Float64 => return "float64";
            case .Float128 => return "float128";
        }
    }
}

pub enum StringPrefix {
    Byte,

    pub fn from_str(str: const uint8*) Option<Self> {
        switch (str) {
            case "b" => return .Some(.Byte);
            else => return .None;
        }
    }

    pub fn to_str(self: Self) const uint8* {
        switch (self) {
            case .Byte => return "b";
        }
    }
}

pub struct Loc {
    pub line: usize, // 1-indexed
    pub start: usize,
    pub end: usize,

    pub fn merge(self: Self, other: Self) Self {
        var merge = self;
        
        // Start line
        if (other.line < merge.line) {
            merge.line = other.line;
        }
        
        // Byte offsets
        if (other.start < merge.start) {
            merge.start = other.start;
        }
        if (other.end > merge.end) {
            merge.end = other.end;
        }
        
        return merge;
    }
}

/// Formats and writes a collection of tokens to stdout.
pub fn dump_tokens(tokens: const Vec<Token>*) {
    for (var i: usize = 0; i < tokens->len(); i += 1) {
        const token = tokens->get(i).unwrap();

        dump_token(*token);
    }
}

/// Formats and writes a tokens to stdout.
/// This is primarily used for debugging and emitting lexer result.
pub fn dump_token(token: Token) {
    // REVIEW: Refactor, use `format` helper method from stdlib.

    var allocator: Allocator = dynamic LibcAllocator.new();

    var fmt = String.new(allocator);
    defer fmt.free();  

    var writer: Writer = dynamic StringWriter.new(&fmt);

    token.format(writer);
        
    printf(
        "Token `%s`, Line: %lu, Start: %lu, End: %lu\n",
        fmt.as_str_const(),
        token.loc.line,
        token.loc.start,
        token.loc.end
    );
}

[[inline]]
pub fn escape_sequence_to_char(seq: uint8) uint8 {
    switch (seq) {
        case '0' => return '\0';
        case 'n' => return '\n';
        case 't' => return '\t';
        case 'r' => return '\r';
        case 'b' => return '\b';
        case 'a' => return '\a';
        case 'v' => return '\v';
        case 'f' => return '\f';
        case '\\' => return '\\';
        case '\'' => return '\'';
        case '"' => return '"';
    }
    return seq;
}

[[inline]]
pub fn char_to_escape_sequence(char: uint8) uint8 {
    switch (char) {
        case '\0' => return '0';
        case '\n' => return 'n';
        case '\t' => return 't';
        case '\r' => return 'r';
        case '\b' => return 'b';
        case '\a' => return 'a';
        case '\v' => return 'v';
        case '\f' => return 'f';
        case '\\' => return '\\';
        case '\'' => return '\'';
        case '"' => return '"';
    }
    return char;
}

[[inline]]
pub fn is_valid_escape(char: uint8) bool {
    if (char == '0' || char == 'n' || char == 't' ||
        char == 'r' || char == 'b' || char == 'a' ||
        char == 'v' || char == 'f' || char == '"' ||
        char == '\\' || char ==  '\'')
    {
        return true;
    } else {
        return false;
    }
}

[[inline]]
pub fn is_escaped_char(char: uint8) bool {
    if (char == '\0' || char == '\n' || char == '\t' ||
        char == '\r' || char == '\b' || char == '\a' ||
        char == '\v' || char == '\f' || char == '\"' ||
        char == '\\' || char ==  '\'')
    {
        return true;
    } else {
        return false;
    }
}