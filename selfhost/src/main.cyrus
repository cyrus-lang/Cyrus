import std::libc{printf};
import std::path{Path};
import std::cli;
import version;

import diags::render{CompilerDiagRender};
import std::io{Writer, StderrWriter};
import source{Source, SourceContext};
import diags{DiagContext, Diag};
import std::string{String};

fn command_new(ctx: cli::ActionContext) {
    @todo();
}

fn command_build(ctx: cli::ActionContext) {
    printf("Build command triggered.\n");

    if (ctx.opts->enabled("jobs")) {
        printf("Jobs option enabled.\n");
    }
}

