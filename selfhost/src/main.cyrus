    const path = Path.new(allocator, "/home/tahad/Code/Cyrus/Cyrus/tmp/foo.cyrus");
    
    switch (Source.open(allocator, 1, path)) {
        case .Value(source) => {
            defer source.free();

            printf("%s\n", source.text.as_str_const());
            
        }
        case .Error(_) => @panic("constructing source failed");
    }
