pub type ErrorStr = const uint8*;

pub enum ControlFlow<V, E> {
    Continue(V),
    Break(E)
}

pub interface Try<V, E> {
    fn branch(self: Self) ControlFlow<V, E>;
    fn from_error(error: E) Self;
}

pub enum ErrorOr<V, E = ErrorStr> : Try<V, E> {
    Value(V),
    Error(E)

    [[inline]]
    pub fn branch(self: Self) ControlFlow<V, E> {
        switch (self) {
            case .Value(value) => return .Continue(value);
            case .Error(err) => return .Break(err);
        }
    }

    [[inline]]
    pub fn from_error(error: E) Self {
        return .Error(error);
    }

    [[inline]]
    pub fn unwrap(self: const Self*) V {
        switch (*self) {
            case .Value(value) => return value;
            case .Error(_) => @panic("called `ErrorOr.unwrap()` on an `Error` value");
        }
    }

    // Returns the contained value or a caller-provided default fallback value
    [[inline]]
    pub fn unwrap_or(self: const Self*, other: V) V {
        switch (*self) {
            case .Value(value) => return value;
            case .Error(_) => return other;
        }
    }

    [[inline]]
    pub fn is_error(self: const Self*) bool {
        switch (*self) {
            case .Value(_) => return false;
            case .Error(_) => return true;
        }
    }
    
    [[inline]]
    pub fn is_value(self: const Self*) bool {
        switch (*self) {
            case .Value(_) => return true;
            case .Error(_) => return false;
        }
    }
}