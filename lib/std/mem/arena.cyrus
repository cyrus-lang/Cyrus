import std::collections::linked_list{SinglyLinkedList, SinglyNode};
import std::mem{Allocator, alloc_init, align_up, is_power_of_two};
import std::libc{memmove};

struct ArenaNode {
    pub ptr: uint8*,
    pub capacity: usize,
    pub used: usize,
}

pub struct ArenaMark {
    pub node: SinglyNode<ArenaNode>*,
    pub used: usize,
}

pub struct ArenaAllocator : Allocator {
    child_allocator: Allocator,
    nodes: SinglyLinkedList<ArenaNode>*,
    default_capacity: usize,
    last_alloc_ptr: void*,
    last_alloc_size: usize,

    pub fn new(child_allocator: Allocator, capacity: usize) Self {
        const linked_list: SinglyLinkedList<ArenaNode> = SinglyLinkedList.new();

        var nodes = alloc_init(child_allocator, linked_list);

        var arena = Self { 
            child_allocator, 
            nodes,
            default_capacity: capacity,
            last_alloc_ptr: null,
            last_alloc_size: 0,
        };
        
        arena.create_node(capacity);
        return arena;
    }

    pub fn mark(self: Self*) ArenaMark {
        switch (self->nodes->peek_first()) {
            case .Some(node) => {
                return ArenaMark {
                    node,
                    used: node->value.used,
                };
            }
            case .None => {
                return ArenaMark {
                    node: null,
                    used: 0,
                };
            }
        }
    }
    
    // FIXME: Rename to rollback.
    pub fn restore(self: Self*, mark: ArenaMark) {
        if (mark.node == null) {
            self->reset();
            return;
        }

        while (self->nodes->head != null && self->nodes->head != mark.node) {
            switch (self->nodes->pop_first()) {
                case .Some(node) => {
                    self->child_allocator.free(node->value.ptr);
                    self->child_allocator.free(node);
                }
                case .None => {
                    break;
                }
            }
        }

        if (self->nodes->head != null) {
            self->nodes->head->value.used = mark.used;
        }

        self->last_alloc_ptr = null;
        self->last_alloc_size = 0;
    }

    pub fn alloc(self: Self*, size: usize) void* {
        return self->alloc_aligned(size, 8);
    }

    pub fn alloc_aligned(self: Self*, size: usize, align: usize) void* {
        @assert(is_power_of_two(align), "alignment must be a power of two");

        if (size == 0) {
            return null;
        }

        var effective_align = align;

        if (effective_align < @sizeof(usize)) {
            effective_align = @sizeof(usize);
        }

        switch (self->nodes->peek_first()) case .Some(node) else {
            return null;
        }

        var arena = &node->value;

        const base_addr = @cast(uintptr, arena->ptr) + arena->used;
        const aligned_addr = align_up(base_addr + @sizeof(usize), effective_align);
        const total_needed = (aligned_addr - base_addr) + size;

        if (arena->used + total_needed <= arena->capacity) {
            arena->used += total_needed;
            const ptr = @cast(void*, aligned_addr);
            *(@cast(usize*, aligned_addr) - 1) = size;
            self->last_alloc_ptr = ptr;
            self->last_alloc_size = size;
            return ptr;
        }

        const needed = total_needed + effective_align;

        var next_cap = self->default_capacity;

        if (needed > next_cap) {
            next_cap = needed;
        }

        self->create_node(next_cap);

        switch (self->nodes->peek_first()) case .Some(new_node) else {
            return null;
        }

        var new_arena = &new_node->value;

        const new_base = @cast(uintptr, new_arena->ptr);
        const new_aligned = align_up(new_base + @sizeof(usize), effective_align);
        const new_total = (new_aligned - new_base) + size;

        new_arena->used += new_total;

        const ptr = @cast(void*, new_aligned);
        *(@cast(usize*, new_aligned) - 1) = size;
        self->last_alloc_ptr = ptr;
        self->last_alloc_size = size;
        
        return ptr;
    }

    pub fn alloc_zeroed(self: Self*, size: usize) void* {
        const ptr = self->alloc(size);
        
        if (ptr != null) {
            @memset(ptr, 0, size);
        }
        
        return ptr;
    }

    pub fn realloc(self: Self*, ptr: void*, size: usize) void* {
        if (ptr == null) {
            return self->alloc(size);
        }

        if (size == 0) {
            return null;
        }

        const old_size = *(@cast(usize*, ptr) - 1);

        if (ptr == self->last_alloc_ptr) {
            switch (self->nodes->peek_first()) {
                case .Some(node) => {
                    var arena = &node->value;
                    if (size <= old_size) {
                        arena->used -= (old_size - size);
                        *(@cast(usize*, ptr) - 1) = size;
                        self->last_alloc_size = size;
                        return ptr;
                    } else {
                        const diff = size - old_size;
                        if (arena->used + diff <= arena->capacity) {
                            arena->used += diff;
                            *(@cast(usize*, ptr) - 1) = size;
                            self->last_alloc_size = size;
                            return ptr;
                        }
                    }
                }
                case .None => {}
            }
        }

        const new_ptr = self->alloc(size);
        
        if (new_ptr == null) {
            return null;
        }

        var copy_size = old_size;
        if (copy_size > size) {
            copy_size = size;
        }

        memmove(new_ptr, ptr, copy_size);
        return new_ptr;
    }

    pub fn free(self: Self*, ptr: void*) void {
    }

    pub fn reset(self: Self*) {
        while (self->nodes->size > 1) {
            switch (self->nodes->pop_first()) {
                case .Some(node) => {
                    self->child_allocator.free(node->value.ptr);
                    self->child_allocator.free(node);
                }
                case .None => {
                    break;
                }
            }
        }

        if (self->nodes->head != null) {
            self->nodes->head->value.used = 0;
        }

        self->last_alloc_ptr = null;
        self->last_alloc_size = 0;
    }

    pub fn destroy(self: Self*) {
        while (self->nodes->head != null) {
            switch (self->nodes->pop_first()) case .Some(node) else {
                break;
            }

            self->child_allocator.free(node->value.ptr);
            self->child_allocator.free(node);
        }

        self->child_allocator.free(self->nodes);
        self->last_alloc_ptr = null;
        self->last_alloc_size = 0;
    }

    fn create_node(self: Self*, capacity: usize) {
        const ptr: uint8* = self->child_allocator.alloc(capacity);
        
        var node: SinglyNode<ArenaNode>* = 
            self->child_allocator.alloc(@sizeof(SinglyNode<ArenaNode>));
        
        *node = SinglyNode {
            value: ArenaNode {
                ptr,
                capacity,
                used: 0
            },
            next: self->nodes->head
        };

        self->nodes->head = node;
        self->nodes->size += 1;
    }
}
