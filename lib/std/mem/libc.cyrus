import std::mem{Allocator, is_power_of_two};
import std::libc{
	malloc,
	calloc,
	realloc,
	posix_memalign,
	free
};

pub struct LibcAllocator : Allocator {
	pub fn new() Self {
		return Self {};
	}
	
	pub fn alloc(self: Self*, size: usize) void* {
		return malloc(size);
	}

	pub fn alloc_aligned(self: Self*, size: usize, align: usize) void* {
		@assert(is_power_of_two(align), "alignment must be power of two");
		@assert(align >= @sizeof(void*), "alignment must be >= sizeof(void*)");

		var ptr: void* = null;

		const result = posix_memalign(&ptr, align, size);

		if (result != 0) {
			return null;
		}

		return ptr;
	}

	pub fn alloc_zeroed(self: Self*, size: usize) void* {
		return calloc(1, size);
	}

	pub fn realloc(self: Self*, ptr: void*, size: usize) void* {
		return realloc(ptr, size);
	}

	pub fn free(self: Self*, ptr: void*) {
		free(ptr);
	}
}
