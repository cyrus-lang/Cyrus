import std::libc::types{c_int};
import std::libc{
    clock_gettime,
    timespec_get, 
    CTimeSpec, 
    time, 
    usleep
};

const TIME_UTC: c_int = 1;
const CLOCK_MONOTONIC: c_int = 1;

fn monotonic_now_nanos() uint64 {
    var ts: CTimeSpec = CTimeSpec {
        tv_sec: 0,
        tv_nsec: 0
    };

    if (clock_gettime(CLOCK_MONOTONIC, &ts) == 0) {
        return (@cast(uint64, ts.tv_sec) * 1000000000) + @cast(uint64, ts.tv_nsec);
    }

    if (timespec_get(&ts, TIME_UTC) != 0) {
        return (@cast(uint64, ts.tv_sec) * 1000000000) + @cast(uint64, ts.tv_nsec);
    }

    return @cast(uint64, time(null)) * 1000000000;
}

pub struct Duration {
    nanos: uint64,

    [[inline]]
    pub fn from_nanos(nanos: uint64) Self {
        return Self { nanos };
    }

    [[inline]]
    pub fn from_micros(micros: uint64) Self {
        return Self { nanos: micros * 1000 };
    }

    [[inline]]
    pub fn from_millis(millis: uint64) Self {
        return Self { nanos: millis * 1000000 };
    }

    [[inline]]
    pub fn from_secs(secs: uint64) Self {
        return Self { nanos: secs * 1000000000 };
    }

    [[inline]]
    pub fn as_nanos(self: const Self*) uint64 {
        return self->nanos;
    }

    [[inline]]
    pub fn as_micros(self: const Self*) uint64 {
        return self->nanos / 1000;
    }

    [[inline]]
    pub fn as_millis(self: const Self*) uint64 {
        return self->nanos / 1000000;
    }

    [[inline]]
    pub fn as_secs(self: const Self*) uint64 {
        return self->nanos / 1000000000;
    }

    [[inline]]
    pub fn as_secs_float(self: const Self*) float64 {
        return @cast(float64, self->nanos) / 1000000000.0;
    }

    [[inline]]
    pub fn add(self: const Self*, other: const Self*) Self {
        return Self { nanos: self->nanos + other->nanos };
    }

    [[inline]]
    pub fn sub(self: const Self*, other: const Self*) Self {
        if (other->nanos > self->nanos) {
            return Self { nanos: 0 };
        }
        return Self { nanos: self->nanos - other->nanos };
    }
}

pub struct Instant {
    nanos: uint64,

    pub fn now() Self {
        var ts: CTimeSpec = CTimeSpec {
            tv_sec: 0,
            tv_nsec: 0
        };

        const res = timespec_get(&ts, TIME_UTC);
        if (res != 0) {
            const total = (@cast(uint64, ts.tv_sec) * 1000000000) + @cast(uint64, ts.tv_nsec);
            return Self { nanos: total };
        }

        return Self { nanos: @cast(uint64, time(null)) * 1000000000 };
    }

    [[inline]]
    pub fn elapsed(self: const Self*) Duration {
        return Instant.now().duration_since(self);
    }

    [[inline]]
    pub fn duration_since(self: const Self*, earlier: const Self*) Duration {
        if (earlier->nanos > self->nanos) {
            return Duration.from_nanos(0);
        }

        return Duration.from_nanos(self->nanos - earlier->nanos);
    }
}

pub struct Timer {
    start_nanos: uint64,
    accumulated_nanos: uint64,
    running: bool,

    pub fn new() Self {
        return Self {
            start_nanos: 0,
            accumulated_nanos: 0,
            running: false,
        };
    }

    pub fn start(self: Self*) {
        if (!self->running) {
            self->start_nanos = monotonic_now_nanos();
            self->running = true;
        }
    }

    pub fn stop(self: Self*) {
        if (self->running) {
            const now = monotonic_now_nanos();
            if (now >= self->start_nanos) {
                self->accumulated_nanos += now - self->start_nanos;
            }
            self->running = false;
        }
    }

    pub fn reset(self: Self*) {
        self->start_nanos = 0;
        self->accumulated_nanos = 0;
        self->running = false;
    }

    [[inline]]
    pub fn is_running(self: const Self*) bool {
        return self->running;
    }

    pub fn elapsed_nanoseconds(self: const Self*) uint64 {
        if (self->running) {
            const now = monotonic_now_nanos();

            if (now >= self->start_nanos) {
                return self->accumulated_nanos + (now - self->start_nanos);
            }
        }
        
        return self->accumulated_nanos;
    }

    [[inline]]
    pub fn elapsed_micros(self: const Self*) uint64 {
        return self->elapsed_nanoseconds() / 1000;
    }

    [[inline]]
    pub fn elapsed_ms(self: const Self*) uint64 {
        return self->elapsed_nanoseconds() / 1000000;
    }

    [[inline]]
    pub fn elapsed(self: const Self*) Duration {
        return Duration.from_nanos(self->elapsed_nanoseconds());
    }
}

pub type Stopwatch = Timer;

[[inline]]
pub fn sleep_us(micros: uint32) {
    usleep(micros);
}

[[inline]]
pub fn sleep_ms(millis: uint32) {
    usleep(millis * 1000);
}

[[inline]]
pub fn sleep(duration: Duration) {
    const micros = @cast(uint32, duration.as_micros());
    usleep(micros);
}