import std::option{Option};
import std::string{String};
import std::mem{Allocator};
import std::libc{
    closedir, fopen, fclose,
    mkdir, rmdir, chdir,
    getcwd, opendir, 
};

const DEFAULT_DIR_MODE: uint32 = 493; // 0755 in octal

pub fn is_dir(path: const uint8*) bool {
    @assert(path != null, "path cannot be null");

    const file = opendir(path);
    
    if (file == null) {
        return false;
    }
    
    closedir(file);
    return true;
}

pub fn is_file(path: const uint8*) bool {
    @assert(path != null, "path cannot be null");

    const file = fopen(path, "r");
    
    if (file == null) {
        return false;
    }
    
    fclose(file);
    return !is_dir(path);
}

pub fn create_dir(path: const uint8*) bool {
    @assert(path != null, "path cannot be null");
    return mkdir(path, DEFAULT_DIR_MODE) == 0;
}

pub fn remove_dir(path: const uint8*) bool {
    @assert(path != null, "path cannot be null");
    return rmdir(path) == 0;
}

pub fn set_current_dir(path: const uint8*) bool {
    @assert(path != null, "path cannot be null");
    return chdir(path) == 0;
}

pub fn get_current_dir(allocator: Allocator) Option<String> {
    var buffer: uint8[1024];
    const res = getcwd(&buffer[0], 1024);
    if (res == null) {
        return .None;
    }
    return .Some(String.from_str(allocator, &buffer[0]));
}

/// Current working directory, falling back to `.` when unavailable.
pub fn cwd(allocator: Allocator) String {
    switch (get_current_dir(allocator)) case .Some(cwd) else {
        return String.from_str(allocator, ".");
    }
    return cwd;
}