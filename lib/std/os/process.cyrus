import std::libc{system, exit, popen, pclose, fread};
import std::errors{ErrorOr, ErrorStr};
import std::mem{Allocator};
import std::string{String};

[[inline]]
pub fn exec(command: const uint8*) int32 {
    return system(command);
}

pub struct Command {
    allocator: Allocator,
    line: String,

    pub fn new(allocator: Allocator, program: const uint8*) Self {
        const line = String.from_str(allocator, program);

        return Self {
            allocator,
            line
        };
    }

    [[inline]]
    pub fn arg(self: Self*, argument: const uint8*) {
        self->line.push(' ');
        self->line.push_str(argument);
    }

    [[inline]]
    pub fn exec(self: const Self*) int32 {
        return system(self->line.as_str_const());
    }

    pub fn output(self: const Self*, allocator: Allocator) ErrorOr<String, ErrorStr> {
        const full_cmd = self->line.as_str_const();
        const pipe = popen(full_cmd, "r");
        
        if (pipe == null) {
            return .Error("failed to spawn process pipe");
        }

        var result = String.new(allocator);
        var buffer: uint8[256];

        while (true) {
            const read = fread(&buffer[0], 1, 256, pipe);
            
            if (read == 0) {
                break;
            }
            
            for (var i: usize = 0; i < read; i += 1) {
                result.push(buffer[i]);
            }
        }

        pclose(pipe);
        return .Value(result);
    }

    pub fn free(self: Self*) {
        self->line.free();
    }
}