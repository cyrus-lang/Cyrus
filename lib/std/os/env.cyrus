import std::option{Option};
import std::string{String};
import std::mem{Allocator};
import std::libc{
    getenv, 
    setenv, 
    unsetenv
};

pub fn get(name: const uint8*) Option<const uint8*> {
    const value = getenv(name);

    if (value == null) {
        return .None;
    }
    
    return .Some(value);
}

pub fn get_string(allocator: Allocator, name: const uint8*) Option<String> {
    const value = getenv(name);
    
    if (value == null) {
        return .None;
    }
    
    return .Some(String.from_str(allocator, value));
}

pub fn has(name: const uint8*) bool {
    return getenv(name) != null;
}

pub fn set(name: const uint8*, value: const uint8*) bool {
    return setenv(name, value, 1) == 0;
}

pub fn remove(name: const uint8*) bool {
    return unsetenv(name) == 0;
}