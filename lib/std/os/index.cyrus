import std::errors{ErrorOr, ErrorStr};
import std::libc::types{c_file};
import std::mem{Allocator};
import std::string{String};
import std::path{Path};
import std::libc;

pub struct File {
    path: const Path*,
    file: c_file*,
    mode: OpeningModes,
    
    pub fn open(path: const Path*, mode: OpeningModes) ErrorOr<Self, ErrorStr> {
        const path_str = path->as_string().as_str_const();
        const mode_str = mode.as_str();

    	const file = libc::fopen(path_str, mode_str);

        if (!file) {
            return .Error("could not open the file");
        }

    	return .Value(Self {
            path,
            mode,
            file,
        });
    }

    pub fn flush(self: const Self*) ErrorOr<(), ()> {
        const result = libc::fflush(self->file);
        
        if (result != 0) {
            return .Error(());
        }

        return .Value(());
    }

    pub fn remove(self: const Self*) bool {
        const path_str = self->path->as_string().as_str_const();
        const result = libc::remove(path_str);
        return result == 0;
    }

    pub fn read(self: const Self*, allocator: Allocator) ErrorOr<String, ErrorStr> {
        libc::fseek(self->file, 0, FileSeek.End.as_num());
        const size = @cast(usize, libc::ftell(self->file));
        libc::rewind(self->file);

        if (size < 0) {
            return .Error("failed to get file size");
        }

        var buffer: uint8* = allocator.alloc(size + 1);

        const read = libc::fread(buffer, 1, size, self->file);
        
        if (read != size) {
            return .Error("failed to read file");
        }

        buffer[size] = '\0';

        const content = String.from_str(allocator, buffer);
        allocator.free(buffer);

        return .Value(content);
    }

    pub fn write(self: Self*, content: const uint8*) ErrorOr<usize, ()> {
        const content_len = libc::strlen(content);

        const bytes = libc::fwrite(content, 1, content_len, self->file);
        
        if (bytes == 0) {
            return .Error(());
        } 

        return .Value(bytes);
    }

    pub fn append(self: Self*, content: const uint8*) ErrorOr<usize, ErrorStr> {
        // REVIEW: Use switch guard
        switch (self->mode) {
            case .Append | .AppendBinary | .AppendRead | .AppendReadBinary => {
                // okay
            }
            else => return .Error("file not opened in append mode");
        }

        const result = libc::fseek(self->file, 0, FileSeek.End.as_num());
        
        if (result != 0) {
            return .Error("failed to seek to end of file for append");
        }
        
        const content_len = libc::strlen(content);

        const bytes = libc::fwrite(content, 1, content_len, self->file);
        
        if (bytes == 0) {
            return .Error("failed to append to file");
        }
        
        return .Value(bytes);
    }

    pub fn exists(path: const Path*) bool {
        return path_exists(path->as_string().as_str_const());
    }

    pub fn rename(old_path: const Path*, new_path: const Path*) ErrorOr<(), ()> {
        const old_path_str = old_path->as_string().as_str_const();
        const new_path_str = new_path->as_string().as_str_const();

        const result = libc::rename(old_path_str, new_path_str);
        
        if (result != 0) {
            return .Error(());
        }

        return .Value(());
    }

    pub fn seek(self: Self*, offset: int64, whence: FileSeek) ErrorOr<usize, ErrorStr> {
        const result = libc::fseek(self->file, @cast(int32, offset), whence.as_num());
        
        if (result != 0) {
            return .Error("failed to seek in file");
        }
        
        const pos = libc::ftell(self->file);
        
        if (pos < 0) {
            return .Error("failed to get file position after seek");
        }

        return .Value(@cast(usize, pos));
    }

    [[inline]]
    pub fn eof(self: const Self*) bool {
        return libc::feof(self->file) != 0;
    }

    [[inline]]
    pub fn close(self: Self*) {
        libc::fclose(self->file);
    }

    pub fn free(self: Self*) {
        self->close();
    }
}

pub enum OpeningModes {
    Read,
    ReadBinary,
    Write,
    WriteBinary,
    Append,
    AppendBinary,
    ReadWrite,
    ReadWriteBinary,
    WriteRead,
    WriteReadBinary,
    AppendRead,
    AppendReadBinary,
    
    [[inline]]
    pub fn as_str(self: Self) const uint8* {
        switch (self) {
            case .AppendReadBinary => return "ab+";
            case .WriteReadBinary => return "wb+";
            case .ReadWriteBinary => return "rb+";
            case .AppendBinary => return "ab";
            case .WriteBinary => return "wb";
            case .AppendRead => return "a+";
            case .ReadBinary => return "rb";
            case .ReadWrite => return "r+";
            case .WriteRead => return "w+";
            case .Append => return "a";
            case .Write => return "w";
            case .Read => return "r";
        }
    }
}

pub enum FileSeek {
    Set = 0,
    Cur = 1,
    End = 2,

    [[inline]]
    pub fn as_num(self: Self) int32 {
        return @cast(int32, self);
    }
}

pub enum ExitStatusCode {
    Success = 0,
    Failure = 1,
    InvalidArgument = 2,
    FileNotFound = 3,
    PermissionDenied = 4,
    AllocationError = 5,
    FileOperationError = 6,
    
    [[inline]]
    pub fn as_num(self: Self) int32 {
        return @cast(int32, self);
    }
}

pub enum Fd {
    Stdin = 0,
    Stdout = 1,
    Stderr = 2,

    [[inline]]
    pub fn as_num(self: Self) int32 {
        return @cast(int32, self);
    }
}

[[inline]]
pub fn exit(status: ExitStatusCode) {
    libc::exit(status.as_num());
}

/// True when `path` exists (file or directory).
pub fn path_exists(path: const uint8*) bool {
    @assert(path != null, "path cannot be null");

    const file = libc::fopen(path, OpeningModes.Read.as_str());

    if (file == null) {
        return false;
    }

    libc::fclose(file);
    return true;
}
