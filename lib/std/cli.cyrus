import std::string{String, free_strings};
import std::mem{Allocator, alloc_init};
import std::mem::arena{ArenaAllocator};
import std::libc::types{c_int, c_char};
import std::io{Writer, StdoutWriter};
import std::collections{Vec};
import std::errors{ErrorOr};
import std::option{Option};
import std::libc{
    fprintf, printf, strlen,
    isalpha, isalnum, stderr,
    strtod, strtol, errno,
    ERANGE
};

const CLI_ARENA_INITIAL_SIZE: usize = 4096;
const HELP_WS_LEN: usize = 16;

pub type ProgramArgs = struct {
    argv: const c_char**,
    argc: c_int
};

pub type ActionFn = fn(ActionContext) void;

pub struct ActionContext {
    pub allocator: Allocator,
    pub opts: Opts*,
    pub args: const Args*,
    pub extra_args: const Vec<String>*,
    pub cmd: const Cmd*,

    pub fn print_help(self: const Self*) {
        var writer: Writer = dynamic StdoutWriter.new();
        self->cmd->display_panel(writer);
    }
}

pub enum Error {
    InvalidCommandOption { cmd: const uint8*, opt: const uint8* },
    BadValueType { opt: const uint8*, ty: const uint8* },
    DuplicateOption { opt: const uint8* },
    InvalidOption { opt: const uint8* },
    UnknownOption { opt: const uint8* },
    UnknownCommand { cmd: const uint8* },
    MissingOption { opt: const uint8* },
    MissingValue { opt: const uint8* },
    InvalidValue { opt: const uint8* },
}

pub enum Value {
    Int(int64),
    Bool(bool),
    Str(String),
    Float(float64),

    pub fn free(self: Self*) {
        switch (*self) {
            case .Str(str) => str.free();
            else => {}
        }
    }
}

pub struct App {
    allocator: Allocator,
    arena: ArenaAllocator,
    cmds: Cmds,
    opts: Opts*,
    args: Vec<Value>,
    extra_args: Vec<String>,
    program_name: uint8*,

    pub fn new(allocator: Allocator, opts: Opts*, program_name: uint8*) Self {
        const arena = ArenaAllocator.new(allocator, 4096);
        const args: Vec<Value> = Vec.new(allocator);
        const extra_args: Vec<String> = Vec.new(allocator);
        const cmds = Cmds.new(allocator);

        return Self {
            allocator,
            arena,
            cmds,
            opts,
            args,
            extra_args,
            program_name
        };
    }

    pub fn run(self: Self*, pargs: ProgramArgs) ErrorOr<Self*, ()> {
        if (pargs.argc < 2) {
            self->display_general_help();
            return .Value(self);
        }

        // Handle command help internally
        if (pargs.argv[1] == "help") {
            self->display_general_help();
            return .Value(self);
        }

        switch (self->parse_command_and_args(pargs)) {
            case .Value(cmd) => {
                // If help option is enabled,
                // only show options and 
                // DO NOT trigger action
                if (self->opts->enabled("help")) {
                    cmd->display_help();
                    return .Value(self);
                }

                const args = Args.new(&self->args);

                if (!validate(&args, cmd)) {
                    self->cleanup_after_error();
                    return .Error(());
                }

                // Trigger action
                (cmd->action)(ActionContext {
                    allocator: self->allocator,
                    opts: self->opts,
                    args: &args,
                    extra_args: &self->extra_args,
                    cmd: cmd,
                });

                return .Value(self);
            }
            case .Error(err) => {
                self->display_parse_error(err);
                self->cleanup_after_error();
                return .Error(());
            }
        }
    }

    /// Adds the command into the registry.
    pub fn register(self: Self*, cmd: Cmd) {
        var heap = self->cmds.add(cmd);
    }

    fn cleanup_after_error(self: Self*) void {
        for (var i: usize = 0; i < self->args.len(); i += 1) {
            const value = self->args.get(i).unwrap();
            value->free();
        }

        self->cmds.free();
        self->cmds = Cmds.new(self->allocator);
        self->args.free();
        self->args = Vec.new(self->allocator);
        free_strings(&self->extra_args);
        self->arena.reset();
    }

    pub fn free(self: Self*) {
        for (var i: usize = 0; i < self->args.len(); i += 1) {
            const value = self->args.get(i).unwrap();    
            value->free();
        }

        self->cmds.free();
        self->args.free();
        free_strings(&self->extra_args);
        self->arena.destroy();
    }

    fn parse_command_and_args(self: Self*, pargs: ProgramArgs) ErrorOr<Cmd*, Error> {
        const argc = @cast(usize, pargs.argc);
        
        var i: usize = 1;
        
        const first_arg = pargs.argv[i];

        switch (self->cmds.find(first_arg)) case .Some(var cmd) else {
            return .Error(.UnknownCommand { cmd: first_arg });
        }

        i += 1;

        while (i < argc) {
            const arg = pargs.argv[i];

            if (!arg) {
                i += 1;
                continue;
            }

            if (arg == "--") {
                i += 1;
                
                while (i < argc) {
                    if (pargs.argv[i]) {
                        self->extra_args.push(
                            String.from_str(self->allocator, pargs.argv[i])
                        );
                    }
                    i += 1;
                }

                break;
            }

            if (is_arg_an_opt(arg)) {
                switch (self->parse_option(cmd, &i, pargs)) {
                    case .Error(err) => return .Error(err);
                    else => {}
                }

                i += 1;
                continue;
            }

            if (self->args.len() == 0) {
                const sub = cmd->sub_cmds->find(arg);
                if (sub.is_some()) {
                    cmd = sub.unwrap();
                    i += 1;
                    continue;
                }
            }

            self->args.push(self->parse_value(arg));
            i += 1;
        }

        return .Value(cmd);
    }

    fn parse_option(
        self: Self*,
        cmd: const Cmd*,
        i: usize*,
        pargs: ProgramArgs
    ) ErrorOr<(), Error> {
        const arg = pargs.argv[*i];

        var next_arg: const uint8*;

        if (*i + 1 < @cast(usize, pargs.argc)) {
            next_arg = pargs.argv[*i + 1];
        }

        const (single_dash, double_dash) = is_opt_dashed(arg);

        if (!(single_dash || double_dash)) {
            return .Error(.InvalidOption { opt: arg });
        }

        var name: const uint8* = undefined;
        if (double_dash) { name = arg + 2; }
        else { name = arg + 1; }

        if (*name == '\0') {
            return .Error(.InvalidOption { opt: arg });
        }

        const (is_assign, assign_index) = is_opt_assign(name);

        if (is_assign) {
            const allocator: Allocator = dynamic self->arena;
            
            var name_buf: uint8* = allocator.alloc(assign_index + 1);
            
            @memcpy(name_buf, name, assign_index);
            name_buf[assign_index] = '\0';

            @assert(name[assign_index] == '=', "assign index is wrong");
            next_arg = name + assign_index + 1;
            name = name_buf;
        }

        var value: Value;

        switch (cmd->find_option(name)) case .Some(opt) else {
            return .Error(.UnknownOption { opt: name });
        }

        opt->enabled = true;

        const ty = opt->arg_type.unwrap_or(.Bool);

        if (ty.is_bool() && (!next_arg || is_arg_an_opt(next_arg))) {
            value = .Bool(true);
            goto register_value;
        }

        if (!next_arg || is_arg_an_opt(next_arg)) {
            return .Error(.MissingValue { opt: name });
        }

        if (!is_assign) {
            *i += 1;
        }

        value = self->parse_value(next_arg);

    register_value:
        opt->add_value(value);

        if (!is_value_valid(ty, value)) {
            return .Error(.BadValueType {
                opt: arg,
                ty: ty.to_str()
            });
        }

        switch (opt->check()) {
            case .Error(err) => return .Error(err);
            else => {}
        }

        return .Value(());
    }

    fn parse_value(self: Self*, arg: const uint8*) Value {
        @assert(arg, "arg cannot be null");

        var ok = false;

        const bool_value = parse_bool(&ok, arg);
        if (ok) {
            return .Bool(bool_value);
        }
        
        const int_value = parse_int(&ok, arg);
        if (ok) {
            return .Int(int_value);
        }

        const float_value = parse_float(&ok, arg);
        if (ok) {
            return .Float(float_value);
        }
        
        return .Str(String.from_str(self->allocator, arg));
    }

    fn display_general_help(self: const Self*) {
        var writer: Writer = dynamic StdoutWriter.new();

        writer.write("Usage: ");
        writer.write(self->program_name);
        writer.writeln(" [COMMAND] [OPTIONS]");

        writer.write("\n");
        self->cmds.display_all(writer);
    }

    fn display_parse_error(self: const Self*, err: Error) {
        switch (err) {
            case .DuplicateOption { opt } => {
                fprintf(
                    stderr,
                    "Duplcate option: %s (not allowed)\n",
                    opt
                );
            }
            case .InvalidOption { opt } => {
                fprintf(
                    stderr,
                    "Invalid option: %s\n",
                    opt
                );
            }
            case .UnknownOption { opt } => {
                fprintf(
                    stderr,
                    "Uknown option: %s\n",
                    opt
                );
            }
            case .MissingOption { opt } => {
                fprintf(
                    stderr,
                    "Missing option: %s (required)\n",
                    opt
                );
            }
            case .MissingValue { opt } => {
                fprintf(
                    stderr,
                    "Option `%s` requires a value\n",
                    opt
                );
            }
            case .InvalidValue { opt } => {
                fprintf(
                    stderr,
                    "Option `%s` does not accept a value (flag only)\n",
                    opt
                );
            }
            case .BadValueType { opt, ty } => {
                fprintf(
                    stderr,
                    "Option `%s` wants a value of type `%s`\n",
                    opt,
                    ty
                );
            }
            case .UnknownCommand { cmd } => {
                fprintf(
                    stderr,
                    "Unknown cmd: %s\n",
                    cmd
                );
            }
            case .InvalidCommandOption { cmd, opt } => {
                fprintf(
                    stderr,
                    "Invalid option `%s` for cmd `%s`",
                    cmd,
                    opt
                );
            }
        }
        
        fprintf(stderr, "Please use command `help` to see usage\n");
    }
}

pub struct Args {
    values: const Vec<Value>*,

    [[inline]]
    pub fn new(values: const Vec<Value>*) Self {
        return Self { values };
    }

    [[inline]]
    pub fn values(self: const Self*) const Vec<Value>* {
        return self->values;
    }

    [[inline]]
    pub fn has(self: const Self*, idx: usize) bool {
        return idx < self->values->len();
    }

    [[inline]]
    pub fn get(self: const Self*, idx: usize) Option<const Value*> {
        return self->values->get_const(idx);
    }

    [[inline]]
    pub fn get_str(self: const Self*, idx: usize) Option<const uint8*> {
        switch (self->get(idx)) {
            case .Some(val) => {
                switch (*val) {
                    case .Str(s) => return .Some(s.as_str_const());
                    else => return .None;
                }
            }
            case .None => return .None;
        }
    }

    [[inline]]
    pub fn get_int(self: const Self*, idx: usize) Option<int64> {
        switch (self->get(idx)) {
            case .Some(val) => {
                switch (*val) {
                    case .Int(n) => return .Some(n);
                    else => return .None;
                }
            }
            case .None => return .None;
        }
    }

    [[inline]]
    pub fn get_float(self: const Self*, idx: usize) Option<float64> {
        switch (self->get(idx)) {
            case .Some(val) => {
                switch (*val) {
                    case .Float(f) => return .Some(f);
                    else => return .None;
                }
            }
            case .None => return .None;
        }
    }

    [[inline]]
    pub fn get_bool(self: const Self*, idx: usize) Option<bool> {
        switch (self->get(idx)) {
            case .Some(val) => {
                switch (*val) {
                    case .Bool(b) => return .Some(b);
                    else => return .None;
                }
            }
            case .None => return .None;
        }
    }
}

pub struct Cmds {
    allocator: Allocator,
    inner: Vec<Cmd*>,

    pub fn new(allocator: Allocator) Self {
        return Self {
            allocator,
            inner: Vec.new(allocator)
        };
    }

    pub fn add(self: Self*, cmd: Cmd) Cmd* {
        var heap = alloc_init(self->allocator, cmd);
        self->inner.push(heap);
        return heap;
    }

    pub fn find(self: Self*, name: const uint8*) Option<Cmd*> {
        for (var i: usize = 0; i < self->inner.len(); i += 1) {
            const cmd = self->inner.get_owned(i).unwrap();

            if (cmd->name == name) {
               return .Some(cmd);
            }
        }

        return .None;
    }

    pub fn display_all(self: const Self*, writer: Writer) {
        writer.writeln("Commands:");

        for (var i: usize = 0; i < self->inner.len(); i += 1) {
            const cmd = self->inner.get_owned(i).unwrap();
            const len = strlen(cmd->name);

            writer.write("  ");
            writer.write(cmd->name);

            switch (cmd->help) {
                case .Some(text) => {
                    write_spaces(writer, HELP_WS_LEN - len);
                    writer.write(text);
                }
                else => {}
            }
            
            writer.write("\n");
        }

        writer.write("  ");
        writer.write("help");
        write_spaces(writer, HELP_WS_LEN - 4);
        writer.write("Shows commands");
        writer.write("\n");
    }
    
    pub fn len(self: const Self*) usize {
        return self->inner.len();
    }

    pub fn get(self: const Self*, index: usize) Option<Cmd*> {
        return self->inner.get_owned(index);
    }

    pub fn free(self: Self*) {
        for (var i: usize = 0; i < self->inner.len(); i += 1) {
            var cmd = self->inner.get_owned(i).unwrap();
            cmd->free();
            self->allocator.free(cmd);
        }

        self->inner.free();
    }
}

pub struct Cmd {
    allocator: Allocator,
    opts: Vec<Opt*>,
    pub name: const uint8*,
    pub sub_cmds: Cmds*,
    pub action: ActionFn,
    pub help: Option<uint8*>,
    pub expected_args: Vec<ArgSpec>,

    pub fn new(allocator: Allocator, name: const uint8*, action: ActionFn) Self {
        const sub_cmds: Cmds* = alloc_init(allocator, Cmds.new(allocator));
        @assert(sub_cmds, "allocation failed for sub_cmds");
        
        const expected_args: Vec<ArgSpec> = Vec.new(allocator);
        const opts: Vec<Opt*> = Vec.new(allocator);

        return Self {
            allocator,
            name,
            opts,
            sub_cmds,
            expected_args,
            action,
            help: .None
        };
    }

    pub fn add_option(self: Self*, opt: Opt*) Self* {
        self->opts.push(opt);
        return self;
    }

    pub fn find_option(self: Self*, name: const uint8*) Option<Opt*> {
        for (var i: usize = 0; i < self->opts.len(); i += 1) {
            const opt = self->opts.get_owned(i).unwrap();

            // Check with short name
            switch (opt->short_name) {
                case .Some(short_char) => {
                    if (name[0] == short_char && name[1] == '\0') {
                        return .Some(opt);
                    }
                }
                else => {}
            }

            // Check with long name
            if (opt->long_name == name) {
               return .Some(opt);
            }
        }

        return .None;
    }

    pub fn add_sub_command(self: Self*, cmd: Cmd) Self* {
        self->sub_cmds->add(cmd);
        return self;
    }

    pub fn argument(self: Self*, ty: ValueType) Self* {
        self->expected_args.push(ArgSpec { ty, required: true });
        return self;
    }

    pub fn optional_argument(self: Self*, ty: ValueType) Self* {
        self->expected_args.push(ArgSpec { ty, required: false });
        return self;
    }

    pub fn help(self: Self*, mesg: uint8*) Self* {
        self->help = .Some(mesg);
        return self;
    }

    pub fn display_help(self: const Self*) {
        var writer: Writer = dynamic StdoutWriter.new();

        writer.write("Options ");
        writer.write("[");
        writer.write(self->name);
        writer.writeln("]");

        for (var i: usize = 0; i < self->opts.len(); i += 1) {
            const opt = self->opts.get_owned(i).unwrap();

            const space_len: usize = 2;
            const dash_len: usize = 2;
            const name_len = strlen(opt->long_name);
            const len = space_len + dash_len + name_len;

            writer.write("  --");
            writer.write(opt->long_name);

            switch (opt->help) {
                case .Some(text) => {
                    write_spaces(
                        writer,
                        HELP_WS_LEN - len
                    );
                    writer.write(text);
                }
                else => {}
            }

            writer.write("\n");
        }
    }

    pub fn display_panel(self: const Self*, writer: Writer) {
        writer.write("Usage: ");
        writer.write(self->name);

        if (self->sub_cmds->len() > 0) {
            writer.write(" <subcommand>");
        }

        if (self->expected_args.len() > 0) {
            writer.write(" <args>");
        }

        writer.write(" [OPTIONS]\n");

        switch (self->help) {
            case .Some(text) => {
                writer.write("\n");
                writer.write(text);
                writer.write("\n");
            }
            else => {}
        }

        if (self->sub_cmds->len() > 0) {
            writer.write("\n");
            writer.writeln("Commands:");

            for (var i: usize = 0; i < self->sub_cmds->len(); i += 1) {
                const sub = self->sub_cmds->get(i).unwrap();
                const len = strlen(sub->name);

                writer.write("  ");
                writer.write(sub->name);

                switch (sub->help) {
                    case .Some(text) => {
                        write_spaces(writer, HELP_WS_LEN - len);
                        writer.write(text);
                    }
                    else => {}
                }

                writer.write("\n");
            }
        }

        if (self->opts.len() > 0) {
            writer.write("\n");
            writer.writeln("Options:");

            for (var i: usize = 0; i < self->opts.len(); i += 1) {
                const opt = self->opts.get_owned(i).unwrap();

                const space_len: usize = 2;
                const dash_len: usize = 2;
                const name_len = strlen(opt->long_name);
                const len = space_len + dash_len + name_len;

                writer.write("  --");
                writer.write(opt->long_name);

                switch (opt->help) {
                    case .Some(text) => {
                        write_spaces(writer, HELP_WS_LEN - len);
                        writer.write(text);
                    }
                    else => {}
                }

                writer.write("\n");
            }
        }
    }

    pub fn free(self: Self*) {
        self->opts.free();
        self->sub_cmds->free();
        self->expected_args.free();
        self->allocator.free(self->sub_cmds);
    }
}

pub struct Opts {
    allocator: Allocator,
    inner: Vec<Opt*>,

    pub fn new(allocator: Allocator) Self {
        var self = Self { allocator, inner: Vec.new(allocator) };

        // Handle help option internally
        self.add(*Opt.new(allocator, "help").short('h')->help("Show help"));

        return self;
    }

    [[inline]]
    pub fn get_help_opt(self: const Self*) Opt* {
        return self->inner.get_owned(0).unwrap();
    }

    pub fn add(self: Self*, opt: Opt) Opt* {
        const opt = alloc_init(self->allocator, opt);
        self->inner.push(opt);
        return opt;
    }

    pub fn find(self: Self*, name: const uint8*) Option<Opt*> {
        for (var i: usize = 0; i < self->inner.len(); i += 1) {
            const opt = self->inner.get_owned(i).unwrap();

            // Check with short name
            switch (opt->short_name) {
                case .Some(short_char) => {
                    if (name[0] == short_char && name[1] == '\0') {
                        return .Some(opt);
                    }
                }
                else => {}
            }

            // Check with long name
            if (opt->long_name == name) {
               return .Some(opt);
            }
        }

        return .None;
    }

    pub fn enabled(self: const Self*, name: const uint8*) bool {
        switch (self->find(name)) {
            case .Some(opt) => {
                if (opt->enabled) {
                    return true;
                }
            }
            else => {}
        }

        return false;
    }

    pub fn display_all(self: const Self*, writer: Writer) {
        writer.writeln("Options:");

        for (var i: usize = 0; i < self->inner.len(); i += 1) {
            const option = self->inner.get_owned(i).unwrap();

            writer.write("  ");
            
            switch (option->short_name) {
                case .Some(char) => {
                    writer.write("-");
                    writer.write_char(char);
                }
                else => {}
            }
            
            writer.write(", ");
            writer.write("--");
            writer.write(option->long_name);
        }

        writer.write("\n");
    }

    pub fn len(self: const Self*) usize {
        return self->inner.len();
    }

    pub fn free(self: Self*) {
        for (var i: usize = 0; i < self->inner.len(); i += 1) {
            var opt = self->inner.get_owned(i).unwrap();
            opt->free();
            self->allocator.free(opt);
        }

        self->inner.free();
    }
}

pub struct Opt {
    allocator: Allocator,
    pub short_name: Option<uint8>,
    pub long_name: uint8*,
    pub values: Vec<Value>,
    pub arg_type: Option<ValueType>,
    pub enabled: bool,
    pub required: bool,
    pub policy: DupPolicy,
    pub help: Option<uint8*>,

    pub fn new(allocator: Allocator, long_name: uint8*) Self {
        const values: Vec<Value> = Vec.new(allocator);

        return Self {
            allocator,
            short_name: .None,
            long_name,
            values,
            arg_type: .None,
            enabled: false,
            required: false,
            policy: .Error,
            help: .None
        };
    }

    pub fn add_value(self: Self*, value: Value) {
        self->values.push(value);
    }

    pub fn check(self: const Self*) ErrorOr<(), Error> {
        if (self->policy == .Error && self->values.len() > 1) {
           return .Error(.DuplicateOption { opt: self->long_name });
        }

        return .Value(());
    }

    pub fn short(self: Self*, char: uint8) Self* {
        self->short_name = .Some(char);
        return self;
    }

    pub fn required(self: Self*) Self* {
        self->required = true;
        return self;
    }

    pub fn arg(self: Self*, ty: ValueType) Self* {
        self->arg_type = .Some(ty);
        return self;
    }

    pub fn policy(self: Self*, new_dp: DupPolicy) Self* {
        self->policy = new_dp;
        return self;
    }

    pub fn help(self: Self*, mesg: uint8*) Self* {
        self->help = .Some(mesg);
        return self;
    }

    pub fn free(self: Self*) {
        for (var i: usize = 0; i < self->values.len(); i += 1) {
            const value = self->values.get(i).unwrap();
            value->free();   
        }

        self->values.free();
    }
}

pub struct ArgSpec {
    pub ty: ValueType,
    pub required: bool
}

pub enum ValueType {
    Str,
    Int,
    Float,
    Bool,

    [[inline]]
    pub fn to_str(self: Self) uint8* {
        switch (self) {
            case .Str => return "string";
            case .Int => return "integer";
            case .Float => return "float";
            case .Bool => return "bool";
        }
    }

    [[inline]]
    pub fn is_bool(self: Self) bool {
        switch (self) {
            case .Bool => return true;
            else => return false;
        }
    }
}

pub enum DupPolicy {
    Error,
    Last
}

pub fn validate(args: const Args*, cmd: const Cmd*) bool {
    const expected_args = &cmd->expected_args;
    const max_args = expected_args->len();
    const values = args->values();

    var min_args: usize = 0;

    for (var i: usize = 0; i < max_args; i += 1) {
        const spec = expected_args->get_const(i).unwrap();
        
        if (spec->required) {
            min_args += 1;
        }
    }

    const got_len = values->len();

    const help = fn() {
        fprintf(stderr, "Please use `--help` to see how it works\n");
    };

    const argument_type_error = fn(idx: usize, got: const uint8*, expected: const uint8*) {
        fprintf(
            stderr,
            "Argument at index %lu got type %s but expected to be %s\n",
            idx, 
            got, 
            expected
        );
    };
    
    if (got_len < min_args) {
        if (min_args == max_args) {
            fprintf(
                stderr,
                "Command `%s` expects %lu arguments but got %lu\n",
                cmd->name,
                min_args,
                got_len
            );
        } else {
            fprintf(
                stderr,
                "Command `%s` expects at least %lu arguments but got %lu\n",
                cmd->name,
                min_args,
                got_len
            );
        }

        help();
        return false;
    }

    if (got_len > max_args) {
        if (min_args == max_args) {
            fprintf(
                stderr,
                "Command `%s` expects %lu arguments but got %lu\n",
                cmd->name,
                max_args,
                got_len
            );
        } else {
            fprintf(
                stderr,
                "Command `%s` expects at most %lu arguments but got %lu\n",
                cmd->name,
                max_args,
                got_len
            );
        }

        help();
        return false;
    }

    for (var i: usize = 0; i < got_len; i += 1) {
        const value = values->get_owned(i).unwrap();
        const spec = expected_args->get_const(i).unwrap();
        const ty = spec->ty;

        switch (value) {
            case .Str(_) => if (ty != .Str) { 
                argument_type_error(i, "string", ty.to_str());
                help();
                return false;
            }
            case .Int(_) => if (ty != .Int) { 
                argument_type_error(i, "integer", ty.to_str());
                help();
                return false;
            }
            case .Float(_) => if (ty != .Float) { 
                argument_type_error(i, "float", ty.to_str());
                help();
                return false;
            }
            case .Bool(_) => if (ty != .Bool) { 
                argument_type_error(i, "bool", ty.to_str());
                help();
                return false;
            }
        }
    }

    return true;
}

[[inline]]
fn is_value_valid(ty: ValueType, value: Value) bool {
    switch (value) {
        case .Float(_) => if (ty == .Float) { return true; }
        case .Bool(_) => if (ty == .Bool) { return true; }
        case .Str(_) => if (ty == .Str) { return true; }
        case .Int(_) => if (ty == .Int) { return true; }
    }
    return false;
}

[[inline]]
fn parse_bool(ok: bool*, arg: const uint8*) bool {
    if (arg == "true" || 
        arg == "yes" || 
        arg == "on" || 
        arg == "enabled") 
    {
        *ok = true;
        return true;
    }

    if (arg == "false" || 
        arg == "no" || 
        arg == "off" || 
        arg == "disabled") 
    {
        *ok = true;
        return false;
    }

    return false;
}

[[inline]]
fn parse_int(ok: bool*, arg: const uint8*) int64 {
    var endptr: c_char*;

    errno = 0;
    const result = strtol(arg, &endptr, 10);

    if ((errno == ERANGE || endptr == arg) || *endptr != '\0') {
        *ok = false;
        return 0;
    }

    *ok = true;
    return @cast(int64, result);
}

[[inline]]
fn parse_float(ok: bool*, arg: const uint8*) float64 {
    var endptr: c_char*;
    
    errno = 0;
    const result = strtod(arg, &endptr);

    if ((errno == ERANGE || endptr == arg) || *endptr != '\0') {
        *ok = false;
        return 0.0;
    }

    *ok = true;
    return @cast(float64, result);
}

[[inline]]
fn is_opt_assign(arg: const uint8*) (bool, usize) {
    const len = @cast(usize, strlen(arg));
    
    for (var i: usize = 0; i < len; i += 1) {
        if (arg[i] == '=') {
            return (true, i);
        }
    }
    
    return (false, 0);
}

[[inline]]
fn is_opt_dashed(arg: const uint8*) (bool, bool) {
    const single_dash = arg[0] == '-';
    const double_dash = arg[0] == '-' && arg[1] == '-';
    return (single_dash, double_dash);
}

[[inline]]
fn is_arg_an_opt(arg: const uint8*) bool {
    if (!arg) {
        return false;
    }
    
    if (arg[0] == '-' && arg[1] == '-') {
        return true;
    }

    if (arg[0] == '-') {
        const next_arg = arg + 1;

        if (is_ident(next_arg)) {
            return true;
        }
    }

    return false;
}

[[inline]]
fn is_ident(str: const uint8*) bool {
    @assert(str, "str cannot be null");
    
    if (*str == '\0') {
        return false;
    }
    
    // First character must be a letter
    const char = @cast(c_int, @cast(uint8, *str));
    
    if (isalpha(char) == 0) {
        return false;
    }
    
    // Check remaining characters 
    // Allow letters, digits, underscore, and dash (stop at '=')
    for (var i: usize = 1; str[i] != '\0' && str[i] != '='; i += 1) {
        var char = @cast(c_int, @cast(uint8, str[i]));
        
        if (isalnum(char) == 0 && (str[i] != '_' && str[i] != '-')) {
            return false;
        }
    }
    
    return true;
}

[[inline]]
fn write_spaces(writer: Writer, n: usize) {
    for (var i: usize = 0; i < n; i += 1) {
        writer.write(" ");
    }
}
