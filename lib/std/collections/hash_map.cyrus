import std::math::checked{checked_mul};
import std::iterator{IterOwned};
import std::collections{Vec};
import std::mem{Allocator};
import std::option{Option};

pub enum EntryState {
    Empty,
    Occupied,
    Deleted
}

pub struct HashEntry<K> {
    pub state: EntryState,
    pub hash: uint64,
    pub key: Option<K>
}

pub struct HashMap<K, V> {
    allocator: Allocator,
    entries: Vec<HashEntry<K>>,
    values: Vec<V>,
    len: usize,
    tombstones: usize,
    cap: usize,
    hash_fn: fn(K) uint64,
    eq_fn: fn(K, K) bool,

    pub fn with_hasher(
        allocator: Allocator,
        initial_cap: usize,
        hash_fn: fn(K) uint64,
        eq_fn: fn(K, K) bool
    ) Self {
        var cap: usize = 16;

        while (cap < initial_cap) {
            cap = checked_mul(cap, 2).unwrap();
        }

        var entries: Vec<HashEntry<K>> = Vec.with_capacity(allocator, cap);
        var values: Vec<V> = Vec.with_capacity(allocator, cap);
        
        for (var i: usize = 0; i < cap; i += 1) {
            entries.push(HashEntry<K> {
                state: .Empty,
                hash: 0,
                key: .None,
            });
        }

        return Self {
            allocator,
            entries,
            values,
            len: 0,
            tombstones: 0,
            cap,
            hash_fn,
            eq_fn
        };
    }

    pub fn reserve(self: Self*, extra: usize) {
        const required = self->len + self->tombstones + extra;
        const threshold = (self->cap >> 1) + (self->cap >> 2);
        
        if (required > threshold) {
            var new_cap = self->cap;
            
            while (new_cap <= required || (new_cap >> 1) + (new_cap >> 2) < required) {
                new_cap = checked_mul(new_cap, 2).unwrap();
            }
            
            self->grow(new_cap);
        }
    }

    fn grow(self: Self*, new_cap: usize) {
        const old_entries = self->entries;
        const old_values = self->values;
        const old_cap = self->cap;

        var new_entries: Vec<HashEntry<K>> = Vec.with_capacity(self->allocator, new_cap);
        var new_values: Vec<V> = Vec.with_capacity(self->allocator, new_cap);
        
        for (var i: usize = 0; i < new_cap; i += 1) {
            new_entries.push(HashEntry<K> {
                state: .Empty,
                hash: 0,
                key: .None,
            });
        }

        const new_mask = new_cap - 1;
        const old_entries_data = old_entries.data_const();
        const old_values_data = old_values.data_const();
        var new_entries_data = new_entries.data();
        var new_values_data = new_values.data();

        for (var i: usize = 0; i < old_cap; i += 1) {
            const entry = &old_entries_data[i];
            if (entry->state == .Occupied) {
                var idx = @cast(usize, entry->hash) & new_mask;
                
                while (new_entries_data[idx].state != .Empty) {
                    idx = (idx + 1) & new_mask;
                }
                
                new_entries_data[idx] = HashEntry<K> {
                    state: .Occupied,
                    hash: entry->hash,
                    key: entry->key,
                };
                new_values_data[idx] = old_values_data[i];
            }
        }

        var mutable_old_entries = old_entries;
        mutable_old_entries.free();

        var mutable_old_values = old_values;
        mutable_old_values.free();

        self->entries = new_entries;
        self->values = new_values;
        self->cap = new_cap;
        self->tombstones = 0;
    }

    fn find_slot(self: const Self*, key: K, hash: uint64) Option<usize> {
        const mask = self->cap - 1;
        const data = self->entries.data_const();
        
        var idx = @cast(usize, hash) & mask;

        for (var i: usize = 0; i < self->cap; i += 1) {
            const entry = &data[idx];
            
            if (entry->state == .Empty) {
                return .None;
            }
            
            if (entry->state == .Occupied && entry->hash == hash) {
                switch (entry->key) {
                    case .Some(entry_key) => if ((self->eq_fn)(key, entry_key)) {
                        return .Some(idx);
                    }
                }
            }
            
            idx = (idx + 1) & mask;
        }
        
        return .None;
    }

    pub fn insert(self: Self*, key: K, value: V) bool {
        const hash = (self->hash_fn)(key);
        const slot_opt = self->find_slot(key, hash);

        if (slot_opt.is_some()) {
            const idx = slot_opt.unwrap();
            var values_data = self->values.data();
            values_data[idx] = value;
            return false;
        }

        self->reserve(1);

        const mask = self->cap - 1;
        var idx = @cast(usize, hash) & mask;
        var first_tombstone: Option<usize> = .None;
        const entries_data_const = self->entries.data_const();

        for (var i: usize = 0; i < self->cap; i += 1) {
            const entry = &entries_data_const[idx];
            
            if (entry->state == .Empty) {
                if (first_tombstone.is_none()) {
                    var entries_data = self->entries.data();
                    var values_data = self->values.data();
                    
                    entries_data[idx] = HashEntry<K> {
                        state: .Occupied,
                        hash,
                        key: .Some(key),
                    };
                    values_data[idx] = value;
                    
                    self->len += 1;
                    return true;
                }
                break;
            }
            
            if (entry->state == .Deleted) {
                if (first_tombstone.is_none()) {
                    first_tombstone = .Some(idx);
                }
            }
            
            idx = (idx + 1) & mask;
        }

        if (first_tombstone.is_some()) {
            const insert_idx = first_tombstone.unwrap();
            var entries_data = self->entries.data();
            var values_data = self->values.data();
            
            entries_data[insert_idx] = HashEntry<K> {
                state: .Occupied,
                hash,
                key: .Some(key),
            };
            values_data[insert_idx] = value;
            
            self->len += 1;
            self->tombstones -= 1;
        }

        return true;
    }

    pub fn get(self: Self*, key: K) Option<V*> {
        const hash = (self->hash_fn)(key);
        const slot_opt = self->find_slot(key, hash);
        if (slot_opt.is_none()) {
            return .None;
        }
        const idx = slot_opt.unwrap();
        return .Some(self->values.data() + idx);
    }

    pub fn get_const(self: const Self*, key: K) Option<const V*> {
        const hash = (self->hash_fn)(key);
        const slot_opt = self->find_slot(key, hash);
        if (slot_opt.is_none()) {
            return .None;
        }
        const idx = slot_opt.unwrap();
        return .Some(self->values.data_const() + idx);
    }

    pub fn get_owned(self: const Self*, key: K) Option<V> {
        const hash = (self->hash_fn)(key);
        const slot_opt = self->find_slot(key, hash);
        if (slot_opt.is_none()) {
            return .None;
        }
        const idx = slot_opt.unwrap();
        const values_data = self->values.data_const();
        return .Some(values_data[idx]);
    }

    [[inline]]
    pub fn contains_key(self: const Self*, key: K) bool {
        const hash = (self->hash_fn)(key);
        return self->find_slot(key, hash).is_some();
    }

    pub fn remove(self: Self*, key: K) Option<V> {
        const hash = (self->hash_fn)(key);
        const slot_opt = self->find_slot(key, hash);
        if (slot_opt.is_none()) {
            return .None;
        }
        const idx = slot_opt.unwrap();

        var entries_data = self->entries.data();
        var values_data = self->values.data();
        const old_val = values_data[idx];

        entries_data[idx].state = .Deleted;
        entries_data[idx].key = .None;
        self->len -= 1;
        self->tombstones += 1;

        return .Some(old_val);
    }

    [[inline]]
    pub fn iter_owned(self: Self*) HashMapIterOwned<K, V> {
        return HashMapIterOwned<K, V> { map: self, idx: 0 };
    }

    [[inline]]
    pub fn len(self: const Self*) usize {
        return self->len;
    }

    [[inline]]
    pub fn cap(self: const Self*) usize {
        return self->cap;
    }

    [[inline]]
    pub fn entries_data(self: Self*) HashEntry<K>* {
        return self->entries.data();
    }

    [[inline]]
    pub fn values_data(self: Self*) V* {
        return self->values.data();
    }

    [[inline]]
    pub fn is_empty(self: const Self*) bool {
        return self->len == 0;
    }

    pub fn clear(self: Self*) {
        var entries_data = self->entries.data();
        
        for (var i: usize = 0; i < self->cap; i += 1) {
            entries_data[i].state = .Empty;
            entries_data[i].key = .None;
        }
        
        self->len = 0;
        self->tombstones = 0;
    }

    pub fn free(self: Self*) {
        self->entries.free();
        self->values.free();
        self->len = 0;
        self->tombstones = 0;
        self->cap = 0;
    }
}

pub struct HashMapIterOwned<K, V> : IterOwned<(K, V)> {
    map: HashMap<K, V>*,
    idx: usize,

    pub fn next(self: Self*) Option<(K, V)> {
        const cap = self->map->cap();
        const entries_data = self->map->entries_data();
        const values_data = self->map->values_data();

        while (self->idx < cap) {
            const entry = &entries_data[self->idx];
            const val_idx = self->idx;
            self->idx += 1;
            
            if (entry->state == .Occupied) {
                switch (entry->key) {
                    case .Some(key) => {
                        return .Some((key, values_data[val_idx]));
                    }
                }
            }
        }
        
        return .None;
    }
}
