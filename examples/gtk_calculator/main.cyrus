import gtk{
    gtk_init,
    gtk_window_new,
    gtk_window_set_title,
    gtk_window_set_default_size,
    gtk_window_set_resizable,
    gtk_container_add,
    gtk_container_set_border_width,
    gtk_widget_show_all,
    gtk_widget_set_size_request,
    gtk_main,
    gtk_button_new_with_label,
    gtk_entry_new,
    gtk_box_new,
    gtk_grid_new,
    gtk_grid_attach,
    gtk_grid_set_row_homogeneous,
    gtk_grid_set_column_homogeneous,
    gtk_grid_set_row_spacing,
    gtk_grid_set_column_spacing,
    gtk_entry_set_text,
    g_signal_connect_data,
    GTK_WINDOW_TOPLEVEL,
    GTK_ORIENTATION_VERTICAL
};

import std::libc{printf, sprintf};

static var current_input: int32;
static var stored_input: int32;
static var current_op: int32;
static var expect_new: bool;
static var entry_widget: void*;

fn update_display(val: int32) {
    var buf: uint8[32];
    sprintf(&buf[0], "%d", val);
    gtk_entry_set_text(entry_widget, &buf[0]);
}

fn append_digit(d: int32) {
    if (expect_new) {
        current_input = d;
        expect_new = false;
    } else {
        current_input = current_input * 10 + d;
    }
    update_display(current_input);
}

fn on_digit_0(btn: void*, data: void*) { append_digit(0); }
fn on_digit_1(btn: void*, data: void*) { append_digit(1); }
fn on_digit_2(btn: void*, data: void*) { append_digit(2); }
fn on_digit_3(btn: void*, data: void*) { append_digit(3); }
fn on_digit_4(btn: void*, data: void*) { append_digit(4); }
fn on_digit_5(btn: void*, data: void*) { append_digit(5); }
fn on_digit_6(btn: void*, data: void*) { append_digit(6); }
fn on_digit_7(btn: void*, data: void*) { append_digit(7); }
fn on_digit_8(btn: void*, data: void*) { append_digit(8); }
fn on_digit_9(btn: void*, data: void*) { append_digit(9); }

fn set_operator(op: int32) {
    stored_input = current_input;
    current_op = op;
    expect_new = true;
}

fn on_op_add(btn: void*, data: void*) { set_operator(1); }
fn on_op_sub(btn: void*, data: void*) { set_operator(2); }
fn on_op_mul(btn: void*, data: void*) { set_operator(3); }
fn on_op_div(btn: void*, data: void*) { set_operator(4); }

fn on_clear(btn: void*, data: void*) {
    current_input = 0;
    stored_input = 0;
    current_op = 0;
    expect_new = false;
    update_display(0);
}

fn on_equals(btn: void*, data: void*) {
    if (current_op == 1) {
        stored_input = stored_input + current_input;
    } else if (current_op == 2) {
        stored_input = stored_input - current_input;
    } else if (current_op == 3) {
        stored_input = stored_input * current_input;
    } else if (current_op == 4) {
        if (current_input != 0) {
            stored_input = stored_input / current_input;
        } else {
            gtk_entry_set_text(entry_widget, "Error");
            current_input = 0;
            stored_input = 0;
            current_op = 0;
            expect_new = true;
            return;
        }
    }
    current_input = stored_input;
    update_display(current_input);
    current_op = 0;
    expect_new = true;
}

fn style_button(btn: void*) {
    gtk_widget_set_size_request(btn, 70, 70);
}

pub fn main() {
    var argc: int32 = 0;
    var argv: uint8** = null;

    gtk_init(&argc, &argv);

    const window = gtk_window_new(GTK_WINDOW_TOPLEVEL);
    gtk_window_set_title(window, "GTK Calculator");
    gtk_window_set_default_size(window, 340, 380);
    gtk_window_set_resizable(window, false);
    gtk_container_set_border_width(window, 15);

    const vbox = gtk_box_new(GTK_ORIENTATION_VERTICAL, 10);
    gtk_container_add(window, vbox);

    entry_widget = gtk_entry_new();
    gtk_container_add(vbox, entry_widget);
    gtk_entry_set_text(entry_widget, "0");

    const grid = gtk_grid_new();
    gtk_container_add(vbox, grid);
    gtk_grid_set_row_homogeneous(grid, true);
    gtk_grid_set_column_homogeneous(grid, true);
    gtk_grid_set_row_spacing(grid, 8);
    gtk_grid_set_column_spacing(grid, 8);

    const btn_7 = gtk_button_new_with_label("7");
    const btn_8 = gtk_button_new_with_label("8");
    const btn_9 = gtk_button_new_with_label("9");
    const btn_div = gtk_button_new_with_label("/");

    style_button(btn_7);
    style_button(btn_8);
    style_button(btn_9);
    style_button(btn_div);

    g_signal_connect_data(btn_7, "clicked", on_digit_7, null, null, 0);
    g_signal_connect_data(btn_8, "clicked", on_digit_8, null, null, 0);
    g_signal_connect_data(btn_9, "clicked", on_digit_9, null, null, 0);
    g_signal_connect_data(btn_div, "clicked", on_op_div, null, null, 0);

    gtk_grid_attach(grid, btn_7, 0, 0, 1, 1);
    gtk_grid_attach(grid, btn_8, 1, 0, 1, 1);
    gtk_grid_attach(grid, btn_9, 2, 0, 1, 1);
    gtk_grid_attach(grid, btn_div, 3, 0, 1, 1);

    const btn_4 = gtk_button_new_with_label("4");
    const btn_5 = gtk_button_new_with_label("5");
    const btn_6 = gtk_button_new_with_label("6");
    const btn_mul = gtk_button_new_with_label("*");

    style_button(btn_4);
    style_button(btn_5);
    style_button(btn_6);
    style_button(btn_mul);

    g_signal_connect_data(btn_4, "clicked", on_digit_4, null, null, 0);
    g_signal_connect_data(btn_5, "clicked", on_digit_5, null, null, 0);
    g_signal_connect_data(btn_6, "clicked", on_digit_6, null, null, 0);
    g_signal_connect_data(btn_mul, "clicked", on_op_mul, null, null, 0);

    gtk_grid_attach(grid, btn_4, 0, 1, 1, 1);
    gtk_grid_attach(grid, btn_5, 1, 1, 1, 1);
    gtk_grid_attach(grid, btn_6, 2, 1, 1, 1);
    gtk_grid_attach(grid, btn_mul, 3, 1, 1, 1);

    const btn_1 = gtk_button_new_with_label("1");
    const btn_2 = gtk_button_new_with_label("2");
    const btn_3 = gtk_button_new_with_label("3");
    const btn_sub = gtk_button_new_with_label("-");

    style_button(btn_1);
    style_button(btn_2);
    style_button(btn_3);
    style_button(btn_sub);

    g_signal_connect_data(btn_1, "clicked", on_digit_1, null, null, 0);
    g_signal_connect_data(btn_2, "clicked", on_digit_2, null, null, 0);
    g_signal_connect_data(btn_3, "clicked", on_digit_3, null, null, 0);
    g_signal_connect_data(btn_sub, "clicked", on_op_sub, null, null, 0);

    gtk_grid_attach(grid, btn_1, 0, 2, 1, 1);
    gtk_grid_attach(grid, btn_2, 1, 2, 1, 1);
    gtk_grid_attach(grid, btn_3, 2, 2, 1, 1);
    gtk_grid_attach(grid, btn_sub, 3, 2, 1, 1);

    const btn_0 = gtk_button_new_with_label("0");
    const btn_clr = gtk_button_new_with_label("C");
    const btn_eq = gtk_button_new_with_label("=");
    const btn_add = gtk_button_new_with_label("+");

    style_button(btn_0);
    style_button(btn_clr);
    style_button(btn_eq);
    style_button(btn_add);

    g_signal_connect_data(btn_0, "clicked", on_digit_0, null, null, 0);
    g_signal_connect_data(btn_clr, "clicked", on_clear, null, null, 0);
    g_signal_connect_data(btn_eq, "clicked", on_equals, null, null, 0);
    g_signal_connect_data(btn_add, "clicked", on_op_add, null, null, 0);

    gtk_grid_attach(grid, btn_0, 0, 3, 1, 1);
    gtk_grid_attach(grid, btn_clr, 1, 3, 1, 1);
    gtk_grid_attach(grid, btn_eq, 2, 3, 1, 1);
    gtk_grid_attach(grid, btn_add, 3, 3, 1, 1);

    gtk_widget_show_all(window);

    gtk_main();
}
