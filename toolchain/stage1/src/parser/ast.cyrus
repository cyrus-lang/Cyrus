import std::mem{Allocator};
import tokens{Span, Token};

/* ************* Nodes ************* */

pub type NodeId = usize;

pub struct ASTNodeList {
    pub start: usize,
    pub len: usize,
}

pub struct ASTProgram {
    pub nodes: Vec<ASTNode>,
    pub children: Vec<NodeId>,
    pub statements: Option<ASTNodeList>,

    pub fn new(allocator: Allocator) Self {
        return Self {
            nodes: Vec.new(allocator),
            children: Vec.new(allocator),
            statements: .None,
        };
    }

    pub fn create_node(self: Self*, node: ASTNode) NodeId {
        const id = self->nodes.len();
        self->nodes.push(node);
        return id;
    }

    /// Commits pending children into the global children pool.
    pub fn commit_pending(self: Self*, pending: Vec<NodeId>*, mark: usize) ASTNodeList {
        @assert(pending->len() >= mark, "mark cannot be bigger than pending nodes length");

        const len = pending->len() - mark;
        const start = self->children.len() + 1;
        
        // Push pending nodes into children
        for (var i: usize = mark; i < pending->len(); i += 1) {
            self->children.push(pending->get_owned(i).unwrap());
        }
        
        // Truncate back to mark
        for (var i: usize = 0; i < len; i += 1) {
            pending->pop();
        }

        return ASTNodeList { start, len };
    }

    pub fn free(self: Self*) {
        self->nodes.free();
        self->children.free();
    }
}

pub enum ASTNode {
    TypeAlias(ASTTypeAlias),
    Type(ASTType),
    Expr(ASTExpr),
    DestructTuple(ASTDestructTuple),
    SwitchGuard(ASTSwitchGuard),
    InlineAsm(ASTInlineAsm),
    Var(ASTVar),
    FuncDecl(ASTFuncDecl),
    GlobalVar(ASTGlobalVar),
    Enum(ASTEnum),
    ModuleDecl(ASTModuleDecl),
    FuncDef(ASTFuncDef),
    Builtin(ASTBuiltin),
    While(ASTWhile),
    Label(ASTLabel),
    Goto(ASTGoto),
    Interface(ASTInterface),
    Struct(ASTStruct),
    Import(ASTImport),
    Union(ASTUnion),
    Return(ASTReturn),
    Defer(ASTDefer),
    Continue(ASTContinue),
    Break(ASTBreak),
    Switch(ASTSwitch),
    Block(ASTBlock),
    For(ASTFor),
    If(ASTIf),
}

