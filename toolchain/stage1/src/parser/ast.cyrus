    Deref(ASTDerefExpr),
    StructInit(ASTStructInit),
    FuncCall(ASTFuncCall),
    FieldAccess(ASTFieldAccess),
    MethodCall(ASTMethodCall),
    Lambda(ASTLambda),
    Tuple(ASTTupleValue),
    TupleAccess(ASTTupleAccess),
    Dynamic(ASTDynamic),
    EnumStructVariantInit(ASTEnumStructVariantInit),
    UnnamedStructValue(ASTUnnamedStructValue),
    UnnamedUnionValue(ASTUnnamedUnionValue),
    UnnamedEnumValue(ASTUnnamedEnumValue),
    InlineAsm(ASTInlineAsm),
}

