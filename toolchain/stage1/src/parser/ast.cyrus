    EnumUnit(ASTIdent),
    EnumTupleVariant {
        variant: ASTIdent,
        items: Vec<ASTSwitchCasePattern>,
    },
    EnumStructVariant {
        variant: ASTIdent,
        items: Vec<ASTSwitchCaseEnumStructPatternField>,
        has_rest: bool,
    },
    Binding { ident: ASTIdent, constness: ASTConstness },
}

