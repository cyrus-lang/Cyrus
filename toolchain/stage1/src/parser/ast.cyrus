/* ************* Declarations ************* */

pub struct ASTInterface {
    pub ident: ASTIdent,
    pub methods: Vec<NodeId>,
    pub generic_params: ASTGenericParams,
    pub vis: ASTVisibility,
    pub span: Span,
}

pub struct ASTStructField {
    pub name: ASTIdent,
    pub vis: ASTVisibility,
    pub ty: NodeId,
    pub span: Span,
}

pub struct ASTImplementInterface {
    pub ty: NodeId,
    pub span: Span,
}

pub struct ASTStruct {
    pub ident: ASTIdent,
    pub generic_params: ASTGenericParams,
    pub impls: Vec<ASTImplementInterface>,
    pub fields: Vec<ASTStructField>,
    pub methods: Vec<NodeId>,
    pub modifiers: ASTStructModifiers,
    pub align: Option<usize>,
    pub is_packed: bool,
    pub span: Span,
}

pub struct ASTEnum {
    pub ident: ASTIdent,
    pub variants: Vec<ASTEnumVariant>,
    pub generic_params: ASTGenericParams,
    pub methods: Vec<NodeId>,
    pub impls: Vec<ASTImplementInterface>,
    pub modifiers: ASTEnumModifiers,
    pub tag_type: Option<NodeId>,
    pub align: Option<usize>,
    pub span: Span,
}

pub struct ASTUnionField {
    pub name: ASTIdent,
    pub ty: NodeId,
    pub span: Span,
}

pub struct ASTUnion {
    pub ident: ASTIdent,
    pub fields: Vec<ASTUnionField>,
    pub generic_params: ASTGenericParams,
    pub methods: Vec<NodeId>,
    pub impls: Vec<ASTImplementInterface>,
    pub modifiers: ASTUnionModifiers,
    pub align: Option<usize>,
    pub span: Span,
}

pub struct ASTTypeAlias {
    pub ident: ASTIdent,
    pub ty: NodeId,
    pub generic_params: ASTGenericParams,
    pub vis: ASTVisibility,
    pub span: Span,
}

pub struct ASTGlobalVar {
    pub ident: ASTIdent,
    pub ty: Option<ASTType>,
    pub expr: Option<NodeId>,
    pub is_const: bool,
    pub is_undef: bool,
    pub is_static: bool,
    pub modifiers: ASTGlobalVarModifiers,
    pub span: Span,
}

pub struct ASTModuleDecl {
    pub ident: ASTIdent,
    pub stmts: ASTNodeList,
    pub vis: ASTVisibility,
    pub span: Span,
}

/* ************* Attributes ************* */

pub enum ASTAttrKind {
    Link(ASTLinkAttr),
    LinkName(String),
    Inline(ASTInlining),
    Callconv(ASTCallconv),
    NoSanitize(String),
    Section(String),
    Repr(ASTReprAttr),
    Opt(ASTOptAttr),
    ThreadLocal,
    Naked,
    Cold,
    Hot,
}

pub struct ASTAttr {
    pub kind: ASTAttrKind,
    pub span: Span,
}

pub enum ASTReprKind {
    C,
    Cyrus,
    Transparent,

    [[inline]]
    pub fn to_str(self: Self) const uint8* {
        switch (self) {
            case .C => return "c";
            case .Cyrus => return "cyrus";
            case .Transparent => return "transparent";
        }
    }
}

pub enum ASTReprAttrKind {
    Kind(ASTReprKind),
    Packed,
}

pub struct ASTReprItem {
    pub kind: ASTReprAttrKind,
    pub span: Span,
}

pub struct ASTReprAttr {
    pub items: Vec<ASTReprItem>,
}

pub enum ASTLinkAttr {
    Weak,
    LinkOnce,
}

pub enum ASTInlining {
    Hint,
    Never,
    Always,

    [[inline]]
    pub fn to_str(self: Self) const uint8* {
        switch (self) {
            case .Hint => return "hint";
            case .Never => return "never";
            case .Always => return "always";
        }
    }
}

pub enum ASTPrologue {
    Naked,
}

pub enum ASTOptAttr {
    None,
    Size,
}

/* ************* Modifiers ************* */

pub struct ASTFuncModifiers {
    pub vis: ASTVisibility,
    pub link_name: Option<String>,
    pub extrn: Option<ASTExtern>,
    pub inline: Option<ASTInlining>,
    pub prologue: Option<ASTPrologue>,
    pub callconv: Option<ASTCallconv>,
    pub optional_flags: Vec<ASTOptionalFlag>,
    pub section: Option<String>,
    pub link_once: bool,
    pub weak: bool,
}

pub struct ASTStructModifiers {
    pub vis: ASTVisibility,
    pub repr_attr: Option<ASTReprAttr>,
}

pub struct ASTEnumModifiers {
    pub vis: ASTVisibility,
    pub repr_attr: Option<ASTReprAttr>,
}

pub struct ASTUnionModifiers {
    pub vis: ASTVisibility,
    pub repr_attr: Option<ASTReprAttr>,
}

pub struct ASTGlobalVarModifiers {
    pub vis: ASTVisibility,
    pub link_name: Option<String>,
    pub extrn: Option<ASTExtern>,
    pub section: Option<String>,
    pub thread_local: bool,
    pub link_once: bool,
    pub weak: bool,
}

pub enum ASTCallconv {
    C,
    Naked,
    Interrupt,
    Fast,
    Cold,
    Aapcs,
    Stdcall,
    Fastcall,
    Thiscall,
    Vectorcall,
    SysV64,
    Win64,
    System,

    [[inline]]
    pub fn to_str(self: Self) const uint8* {
        switch (self) {
            case .C => return "c";
            case .Naked => return "naked";
            case .Interrupt => return "interrupt";
            case .Fast => return "fast";
            case .Cold => return "cold";
            case .Aapcs => return "aapcs";
            case .Stdcall => return "stdcall";
            case .Fastcall => return "fastcall";
            case .Thiscall => return "thiscall";
            case .Vectorcall => return "vectorcall";
            case .SysV64 => return "sysv64";
            case .Win64 => return "win64";
            case .System => return "system";
        }
    }
}

pub enum ASTExtern {
    C,
    Cyrus,

    [[inline]]
    pub fn to_str(self: Self) const uint8* {
        switch (self) {
            case .C => return "c";
            case .Cyrus => return "cyrus";
        }
    }
}

pub enum ASTOptionalFlag {
    NoReturn,
    NoUnwind,
    Cold,
    Hot,
    OptSize,
    OptNone,
    NoSanitize(String),
}

/* ************* Types ************* */

pub struct ASTTypeArgs {
    pub list: Vec<ASTTypeArg>,
}

pub enum ASTTypeArg {
    Type(NodeId),
    Infer,
}

pub struct ASTGenericInst {
    pub base: NodeId,
    pub type_args: ASTTypeArgs,
    pub span: Span,
}

pub struct ASTTupleType {
    pub type_list: Vec<NodeId>,
    pub span: Span,
}

pub struct ASTArrayType {
    pub size: ASTArrayCapacity,
    pub element_type: NodeId,
    pub span: Span,
}

pub enum ASTArrayCapacity {
    Fixed(NodeId),
    Dynamic,
}

pub struct ASTFuncTypeParams {
    pub list: Vec<NodeId>,
    pub variadic: Option<ASTFuncTypeVariadicParams>,
}

pub enum ASTFuncTypeVariadicParams {
    UntypedCStyle,
    Typed(NodeId),
}

pub struct ASTFuncType {
    pub params: ASTFuncTypeParams,
    pub ret_type: NodeId,
    pub vis_opt: Option<ASTVisibility>,
    pub span: Span,
}

pub struct ASTUnnamedStructType {
    pub fields: Vec<ASTUnnamedStructTypeField>,
    pub repr_attr: Option<ASTReprAttr>,
    pub align: Option<usize>,
    pub span: Span,
}

pub struct ASTUnnamedStructTypeField {
    pub name: ASTIdent,
    pub ty: NodeId,
    pub span: Span,
}

pub struct ASTUnnamedUnionTypeField {
    pub ident: ASTIdent,
    pub field_type: NodeId,
    pub span: Span,
}

pub struct ASTUnnamedUnionType {
    pub fields: Vec<ASTUnnamedUnionTypeField>,
    pub repr_attr: Option<ASTReprAttr>,
    pub align: Option<usize>,
    pub span: Span,
}

pub enum ASTEnumVariant {
    Unit(ASTIdent),
    Valued {
        ident: ASTIdent,
        value: NodeId,
    },
    Tuple {
        ident: ASTIdent,
        fields: Vec<ASTEnumVariantTupleField>,
    },
    Struct {
        ident: ASTIdent,
        fields: Vec<ASTEnumVariantStructField>,
    },
}

pub struct ASTEnumVariantTupleField {
    pub ty: NodeId,
    pub span: Span,
}

pub struct ASTEnumVariantStructField {
    pub name: ASTIdent,
    pub ty: NodeId,
    pub span: Span,
}

pub struct ASTUnnamedEnumType {
    pub variants: Vec<ASTEnumVariant>,
    pub tag_type: Option<NodeId>,
    pub repr_attr: Option<ASTReprAttr>,
    pub align: Option<usize>,
    pub span: Span,
}

pub struct ASTSelfType {
    pub span: Span,
}

pub enum ASTType {
    UnnamedStruct(ASTUnnamedStructType),
    UnnamedUnion(ASTUnnamedUnionType),
    UnnamedEnum(ASTUnnamedEnumType),
    ModuleImport(ASTModuleImport),
    Primitive(ASTPrimitiveType),
    SelfType(ASTSelfType),
    Builtin(ASTBuiltin),
    Tuple(ASTTupleType),
    Array(ASTArrayType),
    GenericInst(ASTGenericInst),
    FuncType(NodeId),
    Ident(ASTIdent),
    Pointer(NodeId),
    Const(NodeId),
}

pub enum ASTPrimitiveType {
    Int8,
    Int16,
    Int32,
    Int64,
    Int128,
    IntPtr,
    ISize,
    UInt8,
    UInt16,
    UInt32,
    UInt64,
    UInt128,
    UIntPtr,
    USize,
    Float16,
    Float32,
    Float64,
    Float128,
    Bool,
    Void
}

/* ************* Operators ************* */

pub enum ASTInfixOperator {
    Add,
    Sub,
    Mul,
    Div,
    Rem,
    LessThan,
    LessEqual,
    GreaterThan,
    GreaterEqual,
    Equal,
    NotEqual,
    Or,
    NullCoalesce,
    And,
    BitwiseAnd,
    BitwiseOr,
    BitwiseXor,
    BitwiseAndNot,
    ShiftRight,
    ShiftLeft,

    pub fn to_str(self: Self) const uint8* {
        switch (self) {
            case .Add => return "+";
            case .Sub => return "-";
            case .Mul => return "*";
            case .Div => return "/";
            case .Rem => return "%";
            case .LessThan => return "<";
            case .LessEqual => return "<=";
            case .GreaterThan => return ">";
            case .GreaterEqual => return ">=";
            case .Equal => return "==";
            case .NotEqual => return "!=";
            case .Or => return "||";
            case .NullCoalesce => return "??";
            case .And => return "&&";
            case .BitwiseAnd => return "&";
            case .BitwiseOr => return "|";
            case .BitwiseXor => return "^";
            case .BitwiseAndNot => return "&~";
            case .ShiftRight => return ">>";
            case .ShiftLeft => return "<<";
        }
    }
}

pub enum ASTPrefixOperator {
    Bang,
    Minus,
    BitwiseNot,

    pub fn to_str(self: Self) const uint8* {
        switch (self) {
            case .Bang => return "!";
            case .Minus => return "-";
            case .BitwiseNot => return "~";
        }
    }
}

/* ************* ETC ************* */

pub enum ASTConstness {
    Const,
    Var,

    pub fn to_str(self: Self) const uint8* {
        switch (self) {
            case .Const => return "const";
            case .Var => return "var";
        }
    }
}

pub enum ASTVisibility {
    Public,
    Private,
}