import std::collections{Vec};
import std::errors{ErrorOr};
import std::mem{Allocator};

import .::ast{NodeId, ASTProgram, ASTNodeList};
import .::stmts{ParserStmts};
import .::state{ParserState};
import tokens{SourceTokens};
import diags{DiagContext};

pub struct Parser {
    pub fn parse(
        allocator: Allocator,
        var source_tokens: SourceTokens,
        dctx: DiagContext*
    ) ErrorOr<ASTProgram, ()> {
        var pending: Vec<NodeId> = Vec.new(allocator);
        defer pending.free();

        var program = ASTProgram.new(allocator);
        var state = ParserState.new(allocator, dctx, &source_tokens, &pending);
        var stmts = ParserStmts.new(&program, &state);
        stmts.parse_toplevels();

        // Mark, Parse, Commit, Truncate: drain pending into program.statements
        if (pending.len() > 0) {
            program.statements = .Some(program.commit_pending(&pending, 0));
        }

        return .Value(program);
    }
}
