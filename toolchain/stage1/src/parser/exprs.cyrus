import std::collections{Vec};
import std::option{Option};
import std::string{String};

import .::diags{
    report_error, 
    report_expected_ident, 
    report_unexpected_token,
    report_invalid_operator
};
import tokens{
    Token, 
    TokenKind, 
    SourceTokens, 
    Span, 
    Literal
};
import .::state{ParserState};
import .::ast;

pub struct ParserExprs {
    program: ast::ASTProgram*,
    state: ParserState*,

    [[inline]]
    pub fn new(program: ast::ASTProgram*, state: ParserState*) Self {
        return Self { program, state };
    }

    /* ************* Expressions ************* */

    pub fn parse_expr(self: Self*) Option<ast::NodeId> {
        return self->parse_expr_with_precedence(.Lowest);
    }

    pub fn parse_expr_with_precedence(self: Self*, minimum_precedence: Prec) Option<ast::NodeId> {
        switch (self->parse_prefix()) case .Some(first) else {
            return .None;
        }

        var lhs = first;

        while (true) {
            // The prefix parser consumed the operand, so the current token
            // is the operator that may continue this expression.
            const operator_token = self->state->current();

            var operator_precedence: Prec = undefined;
            var has_precedence = false;

            switch (self->precedence_of_operator(operator_token)) {
                case .Some(prec) => {
                    operator_precedence = prec;
                    has_precedence = true;
                }
            }

            if (!has_precedence) {
                break;
            }

            if (precedence_less_eq(operator_precedence, minimum_precedence)) {
                break;
            }

            switch (self->parse_infix(lhs, operator_token, operator_precedence)) 
            case .Some(next) else {
                return .None;
            }

            lhs = next;
        }

        return .Some(lhs);
    }

    /// Precedence of a token that follows an operand, if any.
    fn precedence_of_operator(self: Self*, operator: const Token*) Option<Prec> {
        switch (*operator->kind) {
            case .GreaterThan => {
                // `>>` is lexed as two `>` tokens, in expression context
                // a doubled `>` is a shift-right operator.
                if (self->state->is_peek_n(1, .GreaterThan)) {
                    return .Some(.Bitwise);
                }

                return .Some(.LessGreater);
            }
            else => return precedence_of_token_kind(*operator->kind);
        }
    }

    /// Parses the leading operand of an expression.
    fn parse_prefix(self: Self*) Option<ast::NodeId> {
        const start = self->state->current_span();

        switch (*self->state->current()->kind) {
            case .Literal(_) | .True | .False | .Null => {
                const token = *self->state->current();
                self->state->next();
                return .Some(self->create_expr(.Literal(token)));
            }

            case .Ident(str) => {
                const ident = ast::ASTIdent { str, span: start };
                self->state->next();

                if (self->state->is(.DoubleColon)) {
                    return self->parse_module_import(ident);
                }

                return .Some(self->create_expr(.Ident(ident)));
            }

            case .Minus | .Bang | .Tilde => {
                switch (map_prefix_operator(*self->state->current()->kind)) 
                case .Some(operator) else {
                    return .None;
                }

                self->state->next();

                switch (self->parse_expr_with_precedence(.Prefix)) 
                case .Some(operand) else {
                    return .None;
                }

                const node = ast::ASTPrefixExpr {
                    operand,
                    operator,
                    span: start.merge(self->state->current_span()),
                };
                return .Some(self->create_expr(.Prefix(node)));
            }

            case .Ampersand => {
                self->state->next();

                switch (self->parse_expr_with_precedence(.Prefix)) 
                case .Some(expr) else {
                    return .None;
                }

                const node = ast::ASTAddrOfExpr {
                    expr,
                    span: start.merge(self->state->current_span()),
                };
                return .Some(self->create_expr(.AddrOf(node)));
            }

            case .Asterisk => {
                self->state->next();

                switch (self->parse_expr_with_precedence(.Prefix)) 
                case .Some(expr) else {
                    return .None;
                }

                const node = ast::ASTDerefExpr {
                    expr,
                    span: start.merge(self->state->current_span()),
                };
                return .Some(self->create_expr(.Deref(node)));
            }

            case .LeftParen => {
                self->state->next();

                switch (self->parse_tuple_or_group(start)) case .Some(id) else {
                    return .None;
                }
                return .Some(id);
            }

            case .LeftBrace => {
                self->state->next();

                switch (self->parse_expr_list(.RightBrace)) case .Some(elements) else {
                    return .None;
                }

                const node = ast::ASTUntypedArrayExpr {
                    elements,
                    span: start.merge(self->state->current_span()),
                };
                return .Some(self->create_expr(.UntypedArray(node)));
            }

            case .At => return self->parse_builtin_or_inline_asm();

            else => {
                report_error(self->state->allocator, self->state->dctx, start, "expected expression");
                return .None;
            }
        }
    }

    /// Grammar: (asm ... | IDENT ( Expr, ... ))
    fn parse_builtin_or_inline_asm(self: Self*) Option<ast::NodeId> {
        if (self->state->is_peek_ident_str("asm")) {
            return self->parse_inline_asm();
        }

        return self->parse_builtin_expr();
    }

    /// Grammar: @ IDENT ( Expr, ... )
    fn parse_builtin_expr(self: Self*) Option<ast::NodeId> {
        const start = self->state->current_span();
        self->state->next(); // consume `@`

        switch (self->state->expect_ident()) case .Some(name) else {
            return .None;
        }

        if (!self->state->expect(.LeftParen)) {
            return .None;
        }

        var args: Vec<ast::NodeId>;

        switch (self->parse_expr_list(.RightParen)) case .Some(parsed_args) else {
            return .None;
        }

        args = parsed_args;

        const node = ast::ASTBuiltinFunc {
            name,
            args,
            span: start.merge(self->state->current_span()),
        };
        return .Some(self->create_expr(.Builtin(ast::ASTBuiltin.BuiltinFunc(node))));
    }

    /// Grammar: @ asm volatile? ( String, ... (: Operand, ... )? (: Operand, ... )? (: Clobber, ... )? )
    fn parse_inline_asm(self: Self*) Option<ast::NodeId> {
        const start = self->state->current_span();
        self->state->next(); // consume `@`

        if (!self->state->is_ident_str("asm")) {
            report_unexpected_token(
                self->state->allocator,
                self->state->dctx,
                self->state->current_span(),
                *self->state->current()->kind
            );
            return .None;
        }

        self->state->next();

        var is_volatile = false;

        if (self->state->is_ident_str("volatile")) {
            self->state->next();
            is_volatile = true;
        }

        if (!self->state->expect(.LeftParen)) {
            return .None;
        }

        // Template is constructed from a collection of string literals
        var template: Vec<String> = Vec.new(self->state->allocator);

        while (self->at_literal()) {
            switch (self->parse_asm_string()) case .Some(part) else {
                ast::free_asm_template(&template);
                return .None;
            }

            template.push(part);
        }

        // Outputs
        var outputs: Vec<ast::ASTAsmOperand> = Vec.new(self->state->allocator);

        if (self->state->is(.Colon)) {
            self->state->next();

            switch (self->parse_asm_operands()) case .Some(parsed) else {
                ast::free_asm_template(&template);
                outputs.free();
                return .None;
            }

            outputs.free();
            outputs = parsed;
        }

        // Inputs
        var inputs: Vec<ast::ASTAsmOperand> = Vec.new(self->state->allocator);

        if (self->state->is(.Colon)) {
            self->state->next();

            switch (self->parse_asm_operands()) case .Some(parsed) else {
                ast::free_asm_template(&template);
                outputs.free();
                inputs.free();
                return .None;
            }

            inputs.free();
            inputs = parsed;
        }

        // Clobbers
        var clobbers: Vec<ast::ASTAsmClobber> = Vec.new(self->state->allocator);

        if (self->state->is(.Colon)) {
            self->state->next();

            switch (self->parse_asm_clobbers()) case .Some(parsed) else {
                ast::free_asm_template(&template);
                ast::free_asm_operands(&outputs);
                ast::free_asm_operands(&inputs);
                clobbers.free();
                return .None;
            }

            clobbers.free();
            clobbers = parsed;
        }

        if (!self->state->expect(.RightParen)) {
            ast::free_asm_template(&template);
            ast::free_asm_operands(&outputs);
            ast::free_asm_operands(&inputs);
            ast::free_asm_clobbers(&clobbers);
            return .None;
        }

        const node = ast::ASTInlineAsm {
            template,
            outputs,
            inputs,
            clobbers,
            is_volatile,
            span: start.merge(self->state->current_span()),
        };
        return .Some(self->create_expr(.InlineAsm(node)));
    }

    fn at_literal(self: Self*) bool {
        switch (*self->state->current()->kind) {
            case .Literal(_) => return true;
        }

        return false;
    }

    /// Copies the current string literal token and consumes it.
    fn parse_asm_string(self: Self*) Option<String> {
        var copy: Option<String> = .None;

        switch (*self->state->current()->kind) {
            case .Literal(lit) => switch (lit) {
                case .String { value, .. } => {
                    copy = .Some(value.clone(self->state->allocator));
                    self->state->next();
                }
            }
        }

        switch (copy) case .Some(part) else {
            report_error(
                self->state->allocator,
                self->state->dctx,
                self->state->current_span(),
                "expected assembly string literal"
            );
            return .None;
        }

        return copy;
    }

    /// Grammar: String ( Expr ) (, String ( Expr ))*
    fn parse_asm_operands(self: Self*) Option<Vec<ast::ASTAsmOperand>> {
        var operands: Vec<ast::ASTAsmOperand> = Vec.new(self->state->allocator);

        while (true) {
            if (self->state->is(.Colon)
                || self->state->is(.RightParen)
                || self->state->is(.Semicolon)
                || self->state->is(.EOF)
            ) {
                break;
            }

            const span = self->state->current_span();

            switch (self->parse_asm_string()) case .Some(constraint) else {
                ast::free_asm_operands(&operands);
                return .None;
            }

            if (!self->state->expect(.LeftParen)) {
                ast::free_asm_operands(&operands);
                return .None;
            }

            switch (self->parse_expr()) case .Some(expr) else {
                ast::free_asm_operands(&operands);
                return .None;
            }

            if (!self->state->expect(.RightParen)) {
                ast::free_asm_operands(&operands);
                return .None;
            }

            const operand = ast::ASTAsmOperand { constraint, expr, span };
            operands.push(operand);

            if (self->state->is(.Comma)) {
                self->state->next();
                continue;
            }

            break;
        }

        return .Some(operands);
    }

    /// Grammar: String (, String)*
    fn parse_asm_clobbers(self: Self*) Option<Vec<ast::ASTAsmClobber>> {
        var clobbers: Vec<ast::ASTAsmClobber> = Vec.new(self->state->allocator);

        while (true) {
            if (self->state->is(.Colon)
                || self->state->is(.RightParen)
                || self->state->is(.Semicolon)
                || self->state->is(.EOF)
            ) {
                break;
            }

            const span = self->state->current_span();

            switch (self->parse_asm_string()) case .Some(name) else {
                ast::free_asm_clobbers(&clobbers);
                return .None;
            }

            const clobber = ast::ASTAsmClobber { name, span };
            clobbers.push(clobber);

            if (self->state->is(.Comma)) {
                self->state->next();
                continue;
            }

            break;
        }

        return .Some(clobbers);
    }

    fn parse_tuple_or_group(self: Self*, start: Span) Option<ast::NodeId> {
        if (self->state->is(.RightParen)) {
            self->state->next();

            const node = ast::ASTTupleValue {
                elements: Vec.new(self->state->allocator),
                span: start.merge(self->state->current_span()),
            };
            return .Some(self->create_expr(.Tuple(node)));
        }

        switch (self->parse_expr()) case .Some(first) else {
            return .None;
        }

        // Expression grouping
        if (!self->state->is(.Comma)) {
            if (!self->state->expect(.RightParen)) {
                return .None;
            }

            return .Some(first);
        }

        var elements: Vec<ast::NodeId> = Vec.new(self->state->allocator);
        elements.push(first);

        while (self->state->is(.Comma)) {
            self->state->next();

            // Trailing comma
            if (self->state->is(.RightParen)) {
                break;
            }

            switch (self->parse_expr()) case .Some(elem) else {
                elements.free();
                return .None;
            }

            elements.push(elem);
        }

        if (!self->state->expect(.RightParen)) {
            elements.free();
            return .None;
        }

        const node = ast::ASTTupleValue {
            elements,
            span: start.merge(self->state->current_span()),
        };
        return .Some(self->create_expr(.Tuple(node)));
    }

    /// Parses a comma separated expression list closed by `close`.
    /// The opening token must already be consumed.
    pub fn parse_expr_list(self: Self*, close: TokenKind) Option<Vec<ast::NodeId>> {
        var elements: Vec<ast::NodeId> = Vec.new(self->state->allocator);

        if (self->state->is(close)) {
            self->state->next();
            return .Some(elements);
        }

        while (true) {
            switch (self->parse_expr()) case .Some(elem) else {
                elements.free();
                return .None;
            }

            elements.push(elem);

            if (self->state->is(.Comma)) {
                self->state->next();

                // Trailing comma
                if (self->state->is(close)) {
                    break;
                }

                continue;
            }

            break;
        }

        if (!self->state->expect(close)) {
            elements.free();
            return .None;
        }

        return .Some(elements);
    }

    fn parse_module_import(self: Self*, first: ast::ASTIdent) Option<ast::NodeId> {
        switch (self->parse_module_import_value(first)) case .Some(node) else {
            return .None;
        }

        return .Some(self->create_expr(.ModuleImport(node)));
    }

    fn parse_module_import_value(self: Self*, first: ast::ASTIdent) Option<ast::ASTModuleImport> {
        var segments: Vec<ast::ASTModuleSegment> = Vec.new(self->state->allocator);
        segments.push(.SubModule(first));

        var span = first.span;

        while (self->state->is(.DoubleColon)) {
            self->state->next();

            const next_ident = self->state->expect_ident();
            var valid = false;

            switch (next_ident) {
                case .Some(ident) => {
                    span = span.merge(ident.span);
                    segments.push(.SubModule(ident));
                    valid = true;
                }
            }

            if (!valid) {
                segments.free();
                return .None;
            }
        }

        return .Some(ast::ASTModuleImport {
            segments,
            relative_level: 0,
            span,
        });
    }

    fn parse_infix(
        self: Self*,
        lhs: ast::NodeId,
        operator: const Token*,
        op_prec: Prec
    ) Option<ast::NodeId> {
        const start = self->state->current_span();

        switch (*operator->kind) {
            case .LeftParen => {
                self->state->next();

                switch (self->parse_expr_list(.RightParen)) case .Some(args) else {
                    return .None;
                }

                const node = ast::ASTFuncCall {
                    operand: lhs,
                    args,
                    type_args: ast::ASTTypeArgs {
                        list: Vec.new(self->state->allocator)
                    },
                    span: start.merge(self->state->current_span()),
                };
                return .Some(self->create_expr(.FuncCall(node)));
            }

            case .LeftBracket => {
                self->state->next();

                switch (self->parse_expr()) case .Some(index) else {
                    return .None;
                }

                if (!self->state->expect(.RightBracket)) {
                    return .None;
                }

                const node = ast::ASTArrayIndexExpr {
                    operand: lhs,
                    index,
                    span: start.merge(self->state->current_span()),
                };
                return .Some(self->create_expr(.ArrayIndex(node)));
            }

            case .Dot | .ThinArrow => {
                var is_thin_arrow = false;

                switch (*operator->kind) {
                    case .ThinArrow => is_thin_arrow = true;
                }

                return self->parse_field_access(lhs, is_thin_arrow);
            }
        }

        var operator_kind = *operator->kind;
        var joined_shift = false;

        switch (operator_kind) {
            case .GreaterThan => {
                if (self->state->is_peek_n(1, .GreaterThan)) {
                    operator_kind = .ShiftRight;
                    joined_shift = true;
                }
            }
        }

        switch (operator_kind) {
            case .Assign => {
                self->state->next();

                switch (self->parse_expr_with_precedence(.Lowest)) case .Some(rhs) else {
                    return .None;
                }

                const node = ast::ASTAssignExpr {
                    lhs,
                    rhs,
                    kind: .Default,
                    span: start.merge(self->state->current_span()),
                };
                return .Some(self->create_expr(.Assign(node)));
            }
        }

        self->state->next();

        if (joined_shift) {
            self->state->next();
        }

        if (self->state->is(.Assign)) {
            switch (map_assign_kind(operator_kind)) case .Some(kind) else {
                report_invalid_operator(
                    self->state->allocator,
                    self->state->dctx,
                    start,
                    "compound assignment operator",
                    operator_kind
                );
                return .None;
            }

            self->state->next();

            switch (self->parse_expr_with_precedence(.Lowest)) case .Some(rhs) else {
                return .None;
            }

            const node = ast::ASTAssignExpr {
                lhs,
                rhs,
                kind,
                span: start.merge(self->state->current_span()),
            };
            return .Some(self->create_expr(.Assign(node)));
        }

        switch (map_infix_operator(operator_kind)) case .Some(operator) else {
            report_invalid_operator(
                self->state->allocator,
                self->state->dctx,
                start,
                "infix operator",
                operator_kind
            );
            return .None;
        }

        switch (self->parse_expr_with_precedence(op_prec)) case .Some(rhs) else {
            return .None;
        }

        const node = ast::ASTInfixExpr {
            operator,
            lhs,
            rhs,
            span: start.merge(self->state->current_span()),
        };
        return .Some(self->create_expr(.Infix(node)));
    }

    fn parse_field_access(
        self: Self*,
        lhs: ast::NodeId,
        is_thin_arrow: bool
    ) Option<ast::NodeId> {
        const start = self->state->current_span();
        self->state->next();

        var peeked: const Token*;
        var has_peek = false;

        switch (self->state->peek_n(0)) {
            case .Some(token) => {
                peeked = token;
                has_peek = true;
            }
        }

        if (!has_peek) {
            report_error(
                self->state->allocator, 
                self->state->dctx, 
                start,
                "expected field name after `.`"
            );
            return .None;
        }

        var tuple_index: usize = 0;
        var is_tuple_index = false;

        switch (*peeked->kind) {
            case .Literal(lit) => switch (lit) {
                case .Integer { value, .. } => switch (value) {
                    case .Unsigned(raw) => {
                        tuple_index = @cast(usize, raw);
                        is_tuple_index = true;
                    }
                    case .Signed(raw) => {
                        tuple_index = @cast(usize, raw);
                        is_tuple_index = true;
                    }
                }
            }
        }

        if (is_tuple_index) {
            self->state->next();

            const node = ast::ASTTupleAccess {
                operand: lhs,
                index: tuple_index,
                span: start.merge(self->state->current_span()),
            };
            return .Some(self->create_expr(.TupleAccess(node)));
        }

        switch (self->state->expect_ident()) case .Some(name) else {
            return .None;
        }

        // Method call
        if (self->state->is(.LeftParen)) {
            self->state->next();

            switch (self->parse_expr_list(.RightParen)) case .Some(args) else {
                return .None;
            }

            const node = ast::ASTMethodCall {
                operand: lhs,
                method_name: name,
                args,
                type_args: ast::ASTTypeArgs {
                    list: Vec.new(self->state->allocator)
                },
                is_thin_arrow,
                span: start.merge(self->state->current_span()),
            };
            return .Some(self->create_expr(.MethodCall(node)));
        }

        const node = ast::ASTFieldAccess {
            is_thin_arrow,
            operand: lhs,
            field_name: name,
            span: start.merge(name.span),
        };
        return .Some(self->create_expr(.FieldAccess(node)));
    }

    [[inline]]
    fn create_expr(self: Self*, expr: ast::ASTExpr) ast::NodeId {
        return self->program->create_node(.Expr(expr));
    }

    /* ************* Types ************* */

    pub fn parse_unsuffixed_integer_value(self: Self*) Option<usize> {
        const token = self->state->current();

        switch (*token->kind) {
            case .Literal(lit) => switch (lit) {
                case .Integer { value, suffix } => {
                    if (suffix.is_some()) {
                        return .None;
                    }

                    switch (value) {
                        case .Unsigned(raw) => {
                            self->state->next();
                            return .Some(@cast(usize, raw));
                        }
                        case .Signed(raw) => {
                            if (raw < 0) {
                                return .None;
                            }

                            self->state->next();
                            return .Some(@cast(usize, raw));
                        }
                    }
                }
            }
        }

        return .None;
    }

    pub fn parse_enum_variant(self: Self*) Option<ast::ASTEnumVariant> {
        switch (self->state->expect_ident()) case .Some(name) else {
            return .None;
        }

        if (self->state->is(.Comma) || self->state->is(.RightBrace)) {
            return .Some(.Unit(name));
        }

        if (self->state->is(.Assign)) {
            self->state->next();

            switch (self->parse_expr()) case .Some(value) else {
                return .None;
            }

            return .Some(.Valued { ident: name, value: value });
        }

        if (self->state->is(.LeftParen)) {
            switch (self->parse_enum_tuple_variant()) case .Some(var fields) else {
                return .None;
            }

            return .Some(.Tuple { ident: name, fields: fields });
        }

        if (self->state->is(.LeftBrace)) {
            switch (self->parse_enum_struct_variant()) case .Some(var fields) else {
                return .None;
            }

            return .Some(.Struct { ident: name, fields: fields });
        }

        return .Some(.Unit(name));
    }

    /// Grammar: ( Type , )* Type
    /// No trailing comma, empty list would be rejected.
    fn parse_enum_tuple_variant(self: Self*) Option<Vec<ast::ASTEnumVariantTupleField>> {
        if (!self->state->expect(.LeftParen)) {
            return .None;
        }

        var fields: Vec<ast::ASTEnumVariantTupleField> = Vec.new(self->state->allocator);

        while (true) {
            if (self->state->is(.RightParen)) {
                report_error(
                    self->state->allocator, 
                    self->state->dctx, 
                    self->state->current_span(), 
                    "consider adding a field to enum tuple variant or removing the parentheses"
                );

                // Consume the empty parentheses and recover with an
                // empty field list so the rest of the enum parses.
                self->state->next();
                return .Some(fields);
            }

            const span = self->state->current_span();

            switch (self->parse_type()) case .Some(ty) else {
                fields.free();
                self->state->sync();
                return .None;
            }

            fields.push(ast::ASTEnumVariantTupleField {
                ty: self->program->create_node(.Type(ty)),
                span: span.merge(self->state->current_span()),
            });

            if (self->state->is(.RightParen)) {
                self->state->next();
                break;
            }

            if (!self->state->expect(.Comma)) {
                fields.free();
                self->state->sync();
                return .None;
            }
        }

        return .Some(fields);
    }

    /// Grammar: ( IDENT : Type , )* IDENT : Type
    fn parse_enum_struct_variant(self: Self*) Option<Vec<ast::ASTEnumVariantStructField>> {
        if (!self->state->expect(.LeftBrace)) {
            return .None;
        }

        var fields: Vec<ast::ASTEnumVariantStructField> = Vec.new(self->state->allocator);

        while (true) {
            const start = self->state->current_span();

            switch (self->state->expect_ident()) case .Some(name) else {
                fields.free();
                self->state->sync();
                return .None;
            }

            if (!self->state->expect(.Colon)) {
                fields.free();
                self->state->sync();
                return .None;
            }

            switch (self->parse_type()) case .Some(ty) else {
                fields.free();
                self->state->sync();
                return .None;
            }

            fields.push(ast::ASTEnumVariantStructField {
                name,
                ty: self->program->create_node(.Type(ty)),
                span: start.merge(self->state->current_span()),
            });

            if (self->state->is(.RightBrace)) {
                self->state->next();
                break;
            }

            if (self->state->is(.Comma) && self->state->is_peek(.RightBrace)) {
                self->state->next();
                self->state->next();
                break;
            }

            if (!self->state->expect(.Comma)) {
                fields.free();
                self->state->sync();
                return .None;
            }
        }

        return .Some(fields);
    }

    fn parse_unnamed_struct_type(self: Self*) Option<ast::ASTType> {
        const start = self->state->current_span();
        self->state->next();

        var align: Option<usize> = .None;

        // TODO (stage2): This syntax should be removed and 
        // replaced with attribute.
        if (self->state->is_ident_str("align")) {
            self->state->next();

            if (!self->state->expect(.LeftParen)) {
                self->state->sync();
                return .None;
            }

            switch (self->parse_unsuffixed_integer_value()) {
                case .Some(value) => align = .Some(value);
                else => {
                    report_error(
                        self->state->allocator, 
                        self->state->dctx, 
                        self->state->current_span(), 
                        "integer literals cannot have suffixes in this context"
                    );
                    self->state->sync();
                    return .None;
                }
            }

            if (!self->state->expect(.RightParen)) {
                self->state->sync();
                return .None;
            }
        }

        if (!self->state->expect(.LeftBrace)) {
            self->state->sync();
            return .None;
        }

        var fields: Vec<ast::ASTUnnamedStructTypeField> = Vec.new(self->state->allocator);

        while (true) {
            if (self->state->is(.RightBrace)) {
                break;
            }

            if (self->state->is(.EOF)) {
                report_error(self->state->allocator, self->state->dctx, self->state->current_span(), "missing closing brace `}`");
                fields.free();
                self->state->sync();
                return .None;
            }

            if (!self->state->is_ident()) {
                report_expected_ident(
                    self->state->allocator,
                    self->state->dctx,
                    self->state->current_span(),
                    *self->state->current()->kind
                );
                fields.free();
                self->state->sync();
                return .None;
            }

            const field_start = self->state->current_span();

            switch (self->state->expect_ident()) case .Some(name) else {
                fields.free();
                self->state->sync();
                return .None;
            }

            if (!self->state->expect(.Colon)) {
                fields.free();
                self->state->sync();
                return .None;
            }

            switch (self->parse_type()) case .Some(ty) else {
                fields.free();
                self->state->sync();
                return .None;
            }

            fields.push(ast::ASTUnnamedStructTypeField {
                name,
                ty: self->program->create_node(.Type(ty)),
                span: field_start.merge(self->state->current_span()),
            });

            if (self->state->is(.RightBrace)) {
                break;
            }

            if (!self->state->expect(.Comma)) {
                fields.free();
                self->state->sync();
                return .None;
            }
        }

        const span = start.merge(self->state->current_span());

        if (!self->state->expect(.RightBrace)) {
            fields.free();
            return .None;
        }

        return .Some(.UnnamedStruct(ast::ASTUnnamedStructType {
            fields,
            repr_attr: .None,
            align,
            span,
        }));
    }

    fn parse_unnamed_union_type(self: Self*) Option<ast::ASTType> {
        const start = self->state->current_span();
        self->state->next();

        var align: Option<usize> = .None;

        // TODO (stage2): This syntax should be removed and 
        // replaced with attribute.
        if (self->state->is_ident_str("align")) {
            self->state->next();

            if (!self->state->expect(.LeftParen)) {
                self->state->sync();
                return .None;
            }

            switch (self->parse_unsuffixed_integer_value()) {
                case .Some(value) => align = .Some(value);
                else => {
                    report_error(
                        self->state->allocator, 
                        self->state->dctx, 
                        self->state->current_span(), 
                        "integer literals cannot have suffixes in this context"
                    );
                    self->state->sync();
                    return .None;
                }
            }

            if (!self->state->expect(.RightParen)) {
                self->state->sync();
                return .None;
            }
        }

        if (!self->state->expect(.LeftBrace)) {
            self->state->sync();
            return .None;
        }

        var fields: Vec<ast::ASTUnnamedUnionTypeField> = Vec.new(self->state->allocator);

        while (true) {
            if (self->state->is(.RightBrace)) {
                break;
            }

            if (self->state->is(.EOF)) {
                report_error(
                    self->state->allocator, 
                    self->state->dctx, 
                    self->state->current_span(), 
                    "missing closing brace `}`"
                );
                fields.free();
                self->state->sync();
                return .None;
            }

            if (!self->state->is_ident()) {
                report_expected_ident(
                    self->state->allocator,
                    self->state->dctx,
                    self->state->current_span(),
                    *self->state->current()->kind
                );
                fields.free();
                self->state->sync();
                return .None;
            }

            const field_start = self->state->current_span();

            switch (self->state->expect_ident()) case .Some(name) else {
                fields.free();
                self->state->sync();
                return .None;
            }

            if (!self->state->expect(.Colon)) {
                fields.free();
                self->state->sync();
                return .None;
            }

            switch (self->parse_type()) case .Some(ty) else {
                fields.free();
                self->state->sync();
                return .None;
            }

            fields.push(ast::ASTUnnamedUnionTypeField {
                ident: name,
                field_type: self->program->create_node(.Type(ty)),
                span: field_start.merge(self->state->current_span()),
            });

            if (self->state->is(.RightBrace)) {
                break;
            }

            if (!self->state->expect(.Comma)) {
                fields.free();
                self->state->sync();
                return .None;
            }
        }

        const span = start.merge(self->state->current_span());

        if (!self->state->expect(.RightBrace)) {
            fields.free();
            return .None;
        }

        return .Some(.UnnamedUnion(ast::ASTUnnamedUnionType {
            fields,
            repr_attr: .None,
            align,
            span,
        }));
    }

    fn parse_unnamed_enum_type(self: Self*) Option<ast::ASTType> {
        const start = self->state->current_span();
        self->state->next();

        var tag_type: Option<ast::NodeId> = .None;

        if (self->state->is(.LeftParen)) {
            self->state->next();

            switch (self->parse_type()) case .Some(ty) else {
                self->state->sync();
                return .None;
            }

            tag_type = .Some(self->program->create_node(.Type(ty)));

            if (!self->state->expect(.RightParen)) {
                self->state->sync();
                return .None;
            }
        }

        var align: Option<usize> = .None;

        // TODO (stage2): This syntax should be removed and 
        // replaced with attribute.
        if (self->state->is_ident_str("align")) {
            self->state->next();

            if (!self->state->expect(.LeftParen)) {
                self->state->sync();
                return .None;
            }

            switch (self->parse_unsuffixed_integer_value()) {
                case .Some(value) => align = .Some(value);
                else => {
                    report_error(
                        self->state->allocator, 
                        self->state->dctx, 
                        self->state->current_span(), 
                        "integer literals cannot have suffixes in this context"
                    );
                    self->state->sync();
                    return .None;
                }
            }

            if (!self->state->expect(.RightParen)) {
                self->state->sync();
                return .None;
            }
        }

        if (!self->state->expect(.LeftBrace)) {
            self->state->sync();
            return .None;
        }

        var variants: Vec<ast::ASTEnumVariant> = Vec.new(self->state->allocator);

        if (self->state->is(.RightBrace)) {
            const span = start.merge(self->state->current_span());

            if (!self->state->expect(.RightBrace)) {
                variants.free();
                return .None;
            }

            return .Some(.UnnamedEnum(ast::ASTUnnamedEnumType {
                variants,
                tag_type,
                repr_attr: .None,
                align,
                span,
            }));
        }

        switch (self->parse_enum_variant()) case .Some(variant) else {
            variants.free();
            self->state->sync();
            return .None;
        }

        variants.push(variant);

        while (self->state->is(.Comma)) {
            self->state->next();

            if (self->state->is(.RightBrace)) {
                break;
            }

            switch (self->parse_enum_variant()) case .Some(variant) else {
                variants.free();
                self->state->sync();
                return .None;
            }

            variants.push(variant);

            if (self->state->is_peek(.RightBrace)) {
                break;
            }
        }

        if (self->state->is(.Comma)) {
            self->state->next();
        }

        const span = start.merge(self->state->current_span());

        if (!self->state->expect(.RightBrace)) {
            variants.free();
            return .None;
        }

        return .Some(.UnnamedEnum(ast::ASTUnnamedEnumType {
            variants,
            tag_type,
            repr_attr: .None,
            align,
            span,
        }));
    }

    /// Grammar: @ IDENT ( Expr,* ) 
    fn parse_builtin_type(self: Self*) Option<ast::ASTType> {
        const start = self->state->current_span();
        self->state->next();

        switch (self->state->expect_ident()) case .Some(name) else {
            self->state->sync();
            return .None;
        }

        if (!self->state->expect(.LeftParen)) {
            self->state->sync();
            return .None;
        }

        var args: Vec<ast::NodeId> = Vec.new(self->state->allocator);

        if (self->state->is(.RightParen)) {
            self->state->next();
        } else {
            while (true) {
                switch (self->parse_expr()) case .Some(arg) else {
                    args.free();
                    self->state->sync();
                    return .None;
                }

                args.push(arg);

                if (self->state->is(.Comma)) {
                    self->state->next();
                    continue;
                }

                break;
            }

            if (!self->state->expect(.RightParen)) {
                args.free();
                self->state->sync();
                return .None;
            }
        }

        const span = start.merge(self->state->current_span());

        return .Some(.Builtin(.BuiltinFunc(ast::ASTBuiltinFunc {
            name,
            args,
            span,
        })));
    }

    // Grammar: fn ( Type,* [Variadic] ) Type
    fn parse_func_type(self: Self*) Option<ast::ASTType> {
        const start = self->state->current_span();
        self->state->next();

        if (!self->state->expect(.LeftParen)) {
            self->state->sync();
            return .None;
        }

        var list: Vec<ast::NodeId> = Vec.new(self->state->allocator);
        var variadic: Option<ast::ASTFuncTypeVariadicParams> = .None;

        while (!self->state->is(.RightParen)) {
            if (self->state->is(.TripleDot)) {
                self->state->next();

                if (self->state->is(.RightParen)) {
                    variadic = .Some(.UntypedCStyle);
                    break;
                }

                switch (self->parse_type()) case .Some(ty) else {
                    list.free();
                    self->state->sync();
                    return .None;
                }

                variadic = .Some(.Typed(self->program->create_node(.Type(ty))));
                break;
            }

            switch (self->parse_type()) case .Some(ty) else {
                list.free();
                self->state->sync();
                return .None;
            }

            list.push(self->program->create_node(.Type(ty)));

            if (self->state->is(.Comma)) {
                self->state->next();
                continue;
            }

            if (!self->state->is(.RightParen)) {
                report_error(
                    self->state->allocator, 
                    self->state->dctx, 
                    self->state->current_span(), 
                    "expected `,` or `)` in function type parameters"
                );
                list.free();
                self->state->sync();
                return .None;
            }
        }

        if (!self->state->expect(.RightParen)) {
            list.free();
            self->state->sync();
            return .None;
        }

        switch (self->parse_type()) case .Some(ret) else {
            list.free();
            self->state->sync();
            return .None;
        }

        const ret_type = self->program->create_node(.Type(ret));
        const span = start.merge(self->state->current_span());

        const id = self->program->create_node(.FuncType(ast::ASTFuncType {
            params: ast::ASTFuncTypeParams { list, variadic },
            ret_type,
            vis_opt: .None,
            span,
        }));

        return .Some(.FuncType(id));
    }

    pub fn parse_type(self: Self*) Option<ast::ASTType> {
        return self->parse_type_with_options(true, true);
    }

    fn parse_type_with_options(
        self: Self*, 
        allow_pointers: bool, 
        allow_arrays: bool
    ) Option<ast::ASTType> {
        const start = self->state->current_span();

        var base_type: ast::ASTType = undefined;

        if (self->state->is(.Const)) {
            self->state->next();

            switch (self->parse_type_with_options(false, false)) case .Some(inner) else {
                return .None;
            }

            const node_id = self->program->create_node(.Type(inner));
            base_type = .Const(node_id);
        } else {
            switch (self->parse_base_type()) case .Some(base) else {
                return .None;
            }

            base_type = base;
        }

        while (true) {
            // Pointer Type
            if (allow_pointers && self->state->is(.Asterisk)) {
                self->state->next();

                const node_id = self->program->create_node(.Type(base_type));
                base_type = .Pointer(node_id);
            } 
            // Array Type
            else if (allow_arrays && self->state->is(.LeftBracket)) {
                switch (self->parse_array_suffix(base_type, start)) case .Some(array_type) else {
                    return .None;
                }

                base_type = array_type;
            } 
            // Generic Type
            else if (self->state->is(.LessThan)) {
                switch (self->parse_generic_suffix(base_type, start)) case .Some(generic_type) else {
                    return .None;
                }

                base_type = generic_type;
            } 
            else {
                break;
            }
        }

        return .Some(base_type);
    }

    fn parse_base_type(self: Self*) Option<ast::ASTType> {
        const start = self->state->current_span();
        const token = self->state->current();

        switch (*token->kind) {
            case .Int8 => {
                self->state->next();
                return .Some(.Primitive(.Int8));
            }
            case .Int16 => {
                self->state->next();
                return .Some(.Primitive(.Int16));
            }
            case .Int32 => {
                self->state->next();
                return .Some(.Primitive(.Int32));
            }
            case .Int64 => {
                self->state->next();
                return .Some(.Primitive(.Int64));
            }
            case .Int128 => {
                self->state->next();
                return .Some(.Primitive(.Int128));
            }
            case .IntPtr => {
                self->state->next();
                return .Some(.Primitive(.IntPtr));
            }
            case .ISize => {
                self->state->next();
                return .Some(.Primitive(.ISize));
            }
            case .UInt8 => {
                self->state->next();
                return .Some(.Primitive(.UInt8));
            }
            case .UInt16 => {
                self->state->next();
                return .Some(.Primitive(.UInt16));
            }
            case .UInt32 => {
                self->state->next();
                return .Some(.Primitive(.UInt32));
            }
            case .UInt64 => {
                self->state->next();
                return .Some(.Primitive(.UInt64));
            }
            case .UInt128 => {
                self->state->next();
                return .Some(.Primitive(.UInt128));
            }
            case .UIntPtr => {
                self->state->next();
                return .Some(.Primitive(.UIntPtr));
            }
            case .USize => {
                self->state->next();
                return .Some(.Primitive(.USize));
            }
            case .Float16 => {
                self->state->next();
                return .Some(.Primitive(.Float16));
            }
            case .Float32 => {
                self->state->next();
                return .Some(.Primitive(.Float32));
            }
            case .Float64 => {
                self->state->next();
                return .Some(.Primitive(.Float64));
            }
            case .Float128 => {
                self->state->next();
                return .Some(.Primitive(.Float128));
            }
            case .Bool => {
                self->state->next();
                return .Some(.Primitive(.Bool));
            }
            case .Void => {
                self->state->next();
                return .Some(.Primitive(.Void));
            }
            
            case .Ident(str) => {
                if (self->state->is_ident_str("Self")) {
                    self->state->next();
                    return .Some(.SelfType(ast::ASTSelfType { span: start }));
                }

                const ident = ast::ASTIdent { str, span: start };
                self->state->next();

                if (self->state->is(.DoubleColon)) {
                    switch (self->parse_module_import_value(ident)) case .Some(path) else {
                        return .None;
                    }

                    return .Some(.ModuleImport(path));
                }

                return .Some(.Ident(ident));
            }

            case .LeftParen => {
                return self->parse_tuple_type();
            }

            case .At => return self->parse_builtin_type();
            case .Struct => return self->parse_unnamed_struct_type();
            case .Enum => return self->parse_unnamed_enum_type();
            case .Union => return self->parse_unnamed_union_type();
            case .Function => return self->parse_func_type();

            else => {
                report_error(
                    self->state->allocator, 
                    self->state->dctx, start, 
                    "expected type"
                );
                return .None;
            }
        }
    }

    fn parse_array_suffix(
        self: Self*,
        base_type: ast::ASTType,
        start: Span
    ) Option<ast::ASTType> {
        var dims: Vec<ast::ASTArrayCapacity> = Vec.new(self->state->allocator);
        defer dims.free();

        while (true) {
            self->state->next();

            var capacity: ast::ASTArrayCapacity = .Dynamic;

            if (!self->state->is(.RightBracket)) {
                switch (self->parse_expr()) case .Some(size_id) else {
                    return .None;
                }

                capacity = .Fixed(size_id);
            }

            dims.push(capacity);

            if (!self->state->expect(.RightBracket)) {
                return .None;
            }

            if (self->state->is(.LeftBracket)) {
                continue;
            }

            break;
        }

        var ty = base_type;

        // Build the nested array type from the inside out, so the first
        // dimension stays the outermost one. 
        // 
        // `T[2][3]` is Array(2, Array(3, T)).
        //
        for (var i: usize = dims.len(); i > 0; i -= 1) {
            const element = self->program->create_node(.Type(ty));
            const size = dims.get_owned(i - 1).unwrap();

            ty = .Array(ast::ASTArrayType {
                size,
                element_type: element,
                span: start.merge(self->state->current_span()),
            });
        }

        return .Some(ty);
    }

    fn parse_generic_suffix(
        self: Self*,
        base_type: ast::ASTType,
        start: Span
    ) Option<ast::ASTType> {
        switch (self->parse_type_args()) case .Some(type_args) else {
            return .None;
        }

        const base = self->program->create_node(.Type(base_type));

        var ty: ast::ASTType = .GenericInst(ast::ASTGenericInst {
            base,
            type_args,
            span: start.merge(self->state->current_span()),
        });
        return .Some(ty);
    }

    fn parse_type_args(self: Self*) Option<ast::ASTTypeArgs> {
        if (!self->state->expect(.LessThan)) {
            return .None;
        }

        var list: Vec<ast::ASTTypeArg> = Vec.new(self->state->allocator);

        while (true) {
            if (self->state->is(.Underscore)) {
                self->state->next();
                list.push(.Infer);
            } else {
                switch (self->parse_type()) case .Some(ty) else {
                    list.free();
                    return .None;
                }

                const node_id = self->program->create_node(.Type(ty));
                list.push(.Type(node_id));
            }

            if (self->state->is(.Comma)) {
                self->state->next();
                continue;
            }

            break;
        }

        if (!self->state->expect(.GreaterThan)) {
            list.free();
            return .None;
        }

        return .Some(ast::ASTTypeArgs { list });
    }

    fn parse_tuple_type(self: Self*) Option<ast::ASTType> {
        const start = self->state->current_span();
        self->state->next();

        // Empty tuple `()`
        if (self->state->is(.RightParen)) {
            self->state->next();

            return .Some(.Tuple(ast::ASTTupleType {
                type_list: Vec.new(self->state->allocator),
                span: start.merge(self->state->current_span()),
            }));
        }

        switch (self->parse_type()) case .Some(first_ty) else {
            return .None;
        }

        // `(T)` is a grouping, not a one-element tuple.
        if (self->state->is(.RightParen)) {
            self->state->next();
            return .Some(first_ty);
        }

        var type_list: Vec<ast::NodeId> = Vec.new(self->state->allocator);
        type_list.push(self->program->create_node(.Type(first_ty)));

        while (!self->state->is(.RightParen)) {
            if (!self->state->expect(.Comma)) {
                type_list.free();
                return .None;
            }

            // Trailing comma before the closer
            if (self->state->is(.RightParen)) {
                break;
            }

            switch (self->parse_type()) case .Some(ty) else {
                type_list.free();
                return .None;
            }

            type_list.push(self->program->create_node(.Type(ty)));
        }

        if (!self->state->expect(.RightParen)) {
            type_list.free();
            return .None;
        }

        return .Some(.Tuple(ast::ASTTupleType {
            type_list,
            span: start.merge(self->state->current_span()),
        }));
    }
}

pub enum Prec {
    Lowest,
    Assign,
    Or,
    And,
    Equals,
    LessGreater,
    Sum,
    Product,
    Bitwise,
    Prefix,
    Call,
    Index,
    Field
}

/// Returns true if a <= b.
fn precedence_less_eq(a: Prec, b: Prec) bool {
    return @cast(usize, a) <= @cast(usize, b);
}

/// Returns the next-higher precedence for right-associative parsing.
fn next_precedence(p: Prec) Prec {
    return @cast(Prec, @cast(usize, p) + 1);
}

/// Precedence of a token when it appears between two operands.
fn precedence_of_token_kind(kind: TokenKind) Option<Prec> {
    switch (kind) {
        case .Asterisk | .Slash | .Percent => return .Some(.Product);
        case .Equal | .NotEqual => return .Some(.Equals);
        case .Dot | .ThinArrow => return .Some(.Field);
        case .LeftBracket => return .Some(.Index);
        case .Plus | .Minus => return .Some(.Sum);
        case .LeftParen => return .Some(.Call);
        case .Assign => return .Some(.Assign);
        case .And => return .Some(.And);
        case .Or => return .Some(.Or);
        
        case .LessThan 
        | .LessEqual 
        | .GreaterThan 
        | .GreaterEqual => return .Some(.LessGreater);
        
        case .Ampersand
        | .Pipe
        | .Tilde
        | .AmpTilde
        | .Caret
        | .ShiftLeft
        | .ShiftRight => return .Some(.Bitwise);
        
        else => return .None;
    }
}

fn map_prefix_operator(kind: TokenKind) Option<ast::ASTPrefixOperator> {
    switch (kind) {
        case .Minus => return .Some(.Minus);
        case .Bang => return .Some(.Bang);
        case .Tilde => return .Some(.BitwiseNot);
        else => return .None;
    }
}

fn map_infix_operator(kind: TokenKind) Option<ast::ASTInfixOperator> {
    switch (kind) {
        case .Plus => return .Some(.Add);
        case .Minus => return .Some(.Sub);
        case .Asterisk => return .Some(.Mul);
        case .Slash => return .Some(.Div);
        case .Percent => return .Some(.Rem);
        case .LessThan => return .Some(.LessThan);
        case .LessEqual => return .Some(.LessEqual);
        case .GreaterThan => return .Some(.GreaterThan);
        case .GreaterEqual => return .Some(.GreaterEqual);
        case .Equal => return .Some(.Equal);
        case .NotEqual => return .Some(.NotEqual);
        case .Or => return .Some(.Or);
        case .And => return .Some(.And);
        case .Ampersand => return .Some(.BitwiseAnd);
        case .Pipe => return .Some(.BitwiseOr);
        case .Caret => return .Some(.BitwiseXor);
        case .AmpTilde => return .Some(.BitwiseAndNot);
        case .ShiftLeft => return .Some(.ShiftLeft);
        case .ShiftRight => return .Some(.ShiftRight);
        else => return .None;
    }
}

fn map_assign_kind(kind: TokenKind) Option<ast::ASTAssignKind> {
    switch (kind) {
        case .Plus => return .Some(.AddAssign);
        case .Minus => return .Some(.SubAssign);
        case .Asterisk => return .Some(.MulAssign);
        case .Slash => return .Some(.DivAssign);
        case .Percent => return .Some(.ModAssign);
        case .Ampersand => return .Some(.BitwiseAndAssign);
        case .Tilde => return .Some(.BitwiseXorAssign);
        case .AmpTilde => return .Some(.BitwiseAndNotAssign);
        case .ShiftLeft => return .Some(.LeftShiftAssign);
        case .ShiftRight => return .Some(.RightShiftAssign);
        else => return .None;
    }
}
