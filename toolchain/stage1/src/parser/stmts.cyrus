import diags{Diag, DiagContext};
import std::collections{Vec};
import .::state{ParserState};
import .::exprs{ParserExprs};
import std::option{Option};
import std::mem{Allocator};
import .::ast;
import tokens{
    Token, 
    TokenKind, 
    SourceTokens, 
    Span
};

// FIXME Remove
import std::libc{printf};


pub struct ParserStmts {
    allocator: Allocator,
    program: ast::ASTProgram*,
    state: ParserState*,

    [[inline]]
    pub fn new(
        allocator: Allocator, 
        program: ast::ASTProgram*, 
        state: ParserState*
    ) Self {
        return Self { allocator, program, state };
    }

    [[inline]]
    pub fn parse_expr(self: Self*) Option<ast::NodeId> {
        var exprs = ParserExprs.new(self->program, self->state);
        return exprs.parse_expr();
    }

    [[inline]]
    pub fn parse_type(self: Self*) Option<ast::ASTType> {
        var exprs = ParserExprs.new(self->program, self->state);
        return exprs.parse_type();
    }

    [[inline]]
    pub fn parse_toplevels(self: Self*) {
        while (!self->state->is(.EOF)) {
            const before = self->state->pos();
            
            self->parse_toplevel();

            // Error recovery must always advance, 
            // otherwise we spin forever!
            if (self->state->pos() == before) {
                self->state->next();
            }
        }
    }

    pub fn parse_toplevel(self: Self*) bool {
        var is_pub = false;
        if (self->state->is(.Public)) {
            self->state->next();
            is_pub = true;
        }

        var is_extern = false;
        if (self->state->is(.Extern)) {
            self->state->next();
            is_extern = true;
        }

        const token = self->state->current();

        switch (*token->kind) {
            case .Static | .Var | .Const => return self->parse_global_var(is_pub, is_extern);
            case .Function => return self->parse_func(is_pub, is_extern);
            case .Interface => return self->parse_interface(is_pub);
            case .Module => return self->parse_module_decl(is_pub);
            case .Type => return self->parse_type_alias(is_pub);
            case .Struct => return self->parse_struct(is_pub);
            case .Union => return self->parse_union(is_pub);
            case .Enum => return self->parse_enum(is_pub);
            case .Import => return self->parse_import();
            else => {
                self->state->sync();
                return false;
            }
        }
    }

    pub fn parse_stmt(self: Self*) {
        const token = self->state->current();

        switch (*token->kind) {
            case .Function => self->parse_func(false, false);
            case .Continue => self->parse_continue();
            case .Var | .Const => self->parse_var();
            case .LeftBrace => self->parse_block();
            case .Return => self->parse_return();
            case .While => self->parse_while();
            case .Break => self->parse_break();
            case .Defer => self->parse_defer();
            case .For => self->parse_for();
            case .If => self->parse_if();
            else => self->parse_expr_stmt();
        }
    }

    /// Grammar: Expr ;
    fn parse_expr_stmt(self: Self*) {
        switch (self->parse_expr()) case .Some(expr) else {
            self->state->sync();
            return;
        }

        if (!self->state->expect_semicolon()) {
            self->state->sync();
            return;
        }

        self->state->pending->push(expr);
    }

    /// Grammar: static? (const | var) IDENT (: Type)? (= Expr)? ;
    pub fn parse_global_var(self: Self*, is_pub: bool, is_extern: bool) bool {
        const start_span = self->state->current_span();

        var is_static = false;
        var is_const = false;
        
        if (self->state->is(.Static)) {
            self->state->next();
            is_static = true;
        }

        if (self->state->is(.Const)) {
            self->state->next();
            is_const = true;
        } else {
            if (!self->state->expect(.Var)) {
                self->state->sync();
                return false;
            }
        }

        switch (self->state->expect_ident()) case .Some(ident) else {
            self->state->sync();
            return false;
        }

        // Optional type annotation
        var ty: Option<ast::ASTType> = .None;

        if (self->state->is(.Colon)) {
            self->state->next();

            switch (self->parse_type()) case .Some(explicit_type) else {
                return false;
            }

            ty = .Some(explicit_type);
        }

        // Optional initializer
        var expr: Option<ast::NodeId> = .None;
        var is_undef = false;
        
        if (self->state->is(.Assign)) {
            self->state->next();

            if (self->state->is_ident_str("undefined")) {
                self->state->next();
                is_undef = true;
            } else {
                switch (self->parse_expr()) {
                    case .Some(id) => expr = .Some(id);
                }
            }
        }

        if (!self->state->expect_semicolon()) {
            self->state->sync();
            return false;
        }

        const end = self->state->current_span();
        const span = start_span.merge(end);

        if (expr.is_none() && ty.is_none() && !is_undef) {
            self->state->dctx->report(Diag.new(
                self->allocator, 
                .Error, 
                "expected initializer or undefined, or an explicit type specifier", 
                span
            ));
            return false;
        }

        if (expr.is_none() && is_const) {
            self->state->dctx->report(Diag.new(
                self->allocator, 
                .Error, 
                "constant global variable must be initialized", 
                ident.span
            ));
            return false;
        }

        if (!is_static && !is_const) {
            self->state->dctx->report(Diag.new(
                self->allocator, 
                .Error, 
                "non-static global variable must be constant", 
                ident.span
            ));
            return false;
        }

        if (ty.is_none() && is_undef) {
            self->state->dctx->report(Diag.new(
                self->allocator, 
                .Error, 
                "expected explicit type specifier", 
                ident.span
            ));
            return false;
        }

        const node = ast::ASTGlobalVar {
            ident,
            ty,
            expr,
            is_const,
            is_undef,
            is_static,
            span,
        };
        const node_id = self->program->create_node(.GlobalVar(node));
        self->state->pending->push(node_id);
        return true;
    }

    /// Grammar: (const | var) IDENT (: Type)? (= Expr | undefined)? ;
    pub fn parse_var(self: Self*) {
        const start = self->state->current_span();

        var is_const = false;

        if (self->state->is(.Const)) {
            self->state->next();
            is_const = true;
        } else {
            if (!self->state->expect(.Var)) {
                self->state->sync();
                return;
            }
        }

        switch (self->state->expect_ident()) case .Some(ident) else {
            self->state->sync();
            return;
        }

        // Optional type annotation
        var ty: Option<ast::ASTType> = .None;

        if (self->state->is(.Colon)) {
            self->state->next();

            switch (self->parse_type()) case .Some(explicit_type) else {
                self->state->sync();
                return;
            }

            ty = .Some(explicit_type);
        }

        // Optional initializer
        var rhs: Option<ast::NodeId> = .None;
        var is_undef = false;

        if (self->state->is(.Assign)) {
            self->state->next();

            if (self->state->is_ident_str("undefined")) {
                self->state->next();
                is_undef = true;
            } else {
                switch (self->parse_expr()) case .Some(value) else {
                    self->state->sync();
                    return;
                }

                rhs = .Some(value);
            }
        }

        if (!self->state->expect_semicolon()) {
            self->state->sync();
            return;
        }

        if (rhs.is_none() && ty.is_none() && !is_undef) {
            self->state->dctx->report(Diag.new(
                self->allocator,
                .Error,
                "expected initializer or undefined, or an explicit type specifier",
                start.merge(self->state->current_span())
            ));
            self->state->sync();
            return;
        }

        const node = ast::ASTVar {
            ident,
            ty,
            rhs,
            is_const,
            is_undef,
            span: start.merge(self->state->current_span()),
        };
        self->state->pending->push(self->program->create_node(.Var(node)));
    }

    // Grammar: fn IDENT <GenericParams>? FuncParams (Type)? (Block | ;)
    pub fn parse_func(self: Self*, is_pub: bool, is_extern: bool) bool {
        const start_span = self->state->current_span();
        self->state->next(); // consume `fn`

        switch (self->state->expect_ident()) case .Some(ident) else {
            self->state->sync();
            return false;
        }

        if (self->state->is(.LessThan)) {
            @todo();
        }

        switch (self->parse_func_params()) case .Some(var params) else {
            self->state->sync();
            return false;
        }

        var ret_type: Option<ast::NodeId> = .None;

        if (!self->state->is(.LeftBrace) && !self->state->is(.Semicolon)) {
            switch (self->parse_type()) case .Some(ty) else {
                ast::free_func_params(&params);
                self->state->sync();
                return false;
            }

            ret_type = .Some(self->program->create_node(.Type(ty)));
        }

        var modifiers = make_func_modifiers(self->allocator, is_pub, is_extern);

        // Function declaration
        if (self->state->is(.Semicolon)) {
            const end_span = self->state->current_span();
            self->state->next();

            const node = ast::ASTFuncDecl {
                ident,
                generic_params: Vec.new(self->state->allocator),
                params,
                ret_type,
                modifiers,
                span: start_span.merge(end_span),
            };
            self->state->pending->push(self->program->create_node(.FuncDecl(node)));
            return true;
        }

        switch (self->parse_block_node()) case .Some(body) else {
            ast::free_func_params(&params);
            ast::free_modifiers(&modifiers);
            self->state->sync();
            return false;
        }

        const node = ast::ASTFuncDef {
            ident,
            params,
            body,
            ret_type,
            modifiers,
            generic_params: Vec.new(self->state->allocator),
            span: start_span.merge(self->state->current_span()),
        };
        self->state->pending->push(self->program->create_node(.FuncDef(node)));
        return true;
    }

    // Grammar: ( (var | const)? IDENT (: Type)? (, ...)* ...? )
    pub fn parse_func_params(self: Self*) Option<ast::ASTFuncParams> {
        if (!self->state->expect(.LeftParen)) {
            return .None;
        }

        var list: Vec<ast::ASTFuncParamKind> = Vec.new(self->state->allocator);
        var variadic: Option<ast::ASTFuncVariadicParam> = .None;

        while (!self->state->is(.RightParen)) {
            // C style varargs
            if (self->state->is(.TripleDot)) {
                self->state->next();
                variadic = .Some(.UntypedCStyle);
                break;
            }

            const param_span = self->state->current_span();

            var constness = ast::ASTConstness.Var;

            if (self->state->is(.Var)) {
                self->state->next();
            } else if (self->state->is(.Const)) {
                self->state->next();
                constness = .Const;
            }

            switch (self->state->expect_ident()) case .Some(ident) else {
                ast::free_param_list(&list);
                return .None;
            }

            var ty: Option<ast::ASTType> = .None;

            if (self->state->is(.Colon)) {
                self->state->next();

                // Typed varargs
                if (self->state->is(.TripleDot)) {
                    self->state->next();

                    switch (self->parse_type()) case .Some(variadic_type) else {
                        ast::free_param_list(&list);
                        return .None;
                    }

                    const type_id = self->program->create_node(.Type(variadic_type));
                    variadic = .Some(.Typed(ident, type_id));
                    break;
                }

                switch (self->parse_type()) case .Some(param_type) else {
                    ast::free_param_list(&list);
                    return .None;
                }

                ty = .Some(param_type);
            }

            const span = param_span.merge(self->state->current_span());

            if (ident.str.as_str_const() == "self") {
                switch (ty) {
                    case .Some(self_type) => {
                        const type_id = self->program->create_node(.Type(self_type));
                        list.push(.SelfModifier(ast::ASTSelfModifier {
                            ty: type_id,
                            constness,
                            span,
                        }));
                    }
                    case .None => {
                        self->state->dctx->report(Diag.new(
                            self->allocator,
                            .Error,
                            "self parameter must have an explicit type",
                            span
                        ));
                        ast::free_param_list(&list);
                        return .None;
                    }
                }
            } else {
                list.push(.FuncParam(ast::ASTFuncParam {
                    ident,
                    ty,
                    constness,
                    span,
                }));
            }

            if (self->state->is(.Comma)) {
                self->state->next();
                continue;
            }

            break;
        }

        if (!self->state->expect(.RightParen)) {
            ast::free_param_list(&list);
            return .None;
        }

        return .Some(ast::ASTFuncParams { list, variadic });
    }

    [[inline]]
    pub fn parse_block(self: Self*) {
        switch (self->parse_block_node()) case .Some(block) else {
            self->state->sync();
            return;
        }

        self->state->pending->push(block);
    }

    pub fn parse_block_node(self: Self*) Option<ast::NodeId> {
        const start = self->state->current_span();

        if (!self->state->expect(.LeftBrace)) {
            return .None;
        }

        const mark = self->state->pending->len();

        while (!self->state->is(.RightBrace) && !self->state->is(.EOF)) {
            const before = self->state->pos();

            self->parse_stmt();

            // Error recovery must always advance, 
            // otherwise we spin forever.
            if (self->state->pos() == before) {
                self->state->next();
            }
        }

        if (!self->state->expect(.RightBrace)) {
            return .None;
        }

        const stmts = self->program->commit_pending(self->state->pending, mark);
        const node = ast::ASTBlock {
            stmts,
            span: start.merge(self->state->current_span()),
        };
        return .Some(self->program->create_node(.Block(node)));
    }

    // Grammar: if (Expr) Block (else if (Expr) Block)* (else Block)?
    pub fn parse_if(self: Self*) {
        @todo();
    }

    // Grammar: return Expr? ;
    pub fn parse_return(self: Self*) {
        const start = self->state->current_span();
        self->state->next();

        var argument: Option<ast::NodeId> = .None;

        if (!self->state->is(.Semicolon)) {
            switch (self->parse_expr()) case .Some(value) else {
                self->state->sync();
                return;
            }

            argument = .Some(value);
        }

        if (!self->state->expect_semicolon()) {
            self->state->sync();
            return;
        }

        const node = ast::ASTReturn {
            argument,
            span: start.merge(self->state->current_span()),
        };
        self->state->pending->push(self->program->create_node(.Return(node)));
    }

    pub fn parse_while(self: Self*) {
        @todo();
    }

    //  Grammar: for (Init? ; Cond? ; Incr?) Block
    pub fn parse_for(self: Self*) {
        @todo();
    }

    /// Grammar: break
    pub fn parse_break(self: Self*) {
        const start = self->state->current_span();
        self->state->next();

        if (!self->state->expect_semicolon()) {
            self->state->sync();
            return;
        }

        const node = ast::ASTBreak { span: start.merge(self->state->current_span()) };
        self->state->pending->push(self->program->create_node(.Break(node)));
    }

    /// Grammar: continue
    pub fn parse_continue(self: Self*) {
        const start = self->state->current_span();
        self->state->next();

        if (!self->state->expect_semicolon()) {
            self->state->sync();
            return;
        }

        const node = ast::ASTContinue { span: start.merge(self->state->current_span()) };
        self->state->pending->push(self->program->create_node(.Continue(node)));
    }

    /// Grammar: defer STMT ;
    pub fn parse_defer(self: Self*) {
        @todo();
    }

    /// Grammar: import PATH (:: PATH)* ;
    pub fn parse_import(self: Self*) bool {
        @todo();
    }

    ///  Grammar:  struct IDENT <GenericParams>? (: Impl)? { FieldOrMethod* }
    pub fn parse_struct(self: Self*, is_pub: bool) bool {
        @todo();
    }

    fn parse_struct_field(self: Self*) Option<ast::ASTStructField> {
        @todo();
    }

    ///  Grammar:  enum IDENT (TagType)? <GenericParams>? { Variant* }
    pub fn parse_enum(self: Self*, is_pub: bool) bool {
        @todo();
    }

    fn parse_enum_variant(self: Self*) Option<ast::ASTEnumVariant> {
        @todo();
    }

    // Grammar: union IDENT <GenericParams>? { (Field | Method)* }
    pub fn parse_union(self: Self*, is_pub: bool) bool {
        @todo();
    }

    fn parse_union_field(self: Self*) Option<ast::ASTUnionField> {
        @todo();
    }

    /// Grammar: type IDENT <GenericParams>? = Type ;
    pub fn parse_type_alias(self: Self*, is_pub: bool) bool {
        @todo();
    }

    /// Grammar: interface IDENT <GenericParams>? { FuncDecl* }
    pub fn parse_interface(self: Self*, is_pub: bool) bool {
        @todo();
    }

    /// Grammar: mod IDENT { Toplevel* }
    pub fn parse_module_decl(self: Self*, is_pub: bool) bool {
        @todo();
    }

    ///  Grammar: <IDENT (: Bound)? (= Type)? (, ...)* >
    pub fn parse_generic_params(self: Self*) ast::ASTGenericParams {
        @todo();
    }
}

/// Builds the default set of function modifiers for a parsed function.
fn make_func_modifiers(allocator: Allocator, is_pub: bool, is_extern: bool) ast::ASTFuncModifiers {
    var vis = ast::ASTVisibility.Private;
    if (is_pub) {
        vis = .Public;
    }

    var extrn: Option<ast::ASTExtern> = .None;
    if (is_extern) {
        extrn = .Some(.C);
    }

    return ast::ASTFuncModifiers {
        vis,
        link_name: .None,
        extrn,
        inline: .None,
        prologue: .None,
        callconv: .None,
        optional_flags: Vec.new(allocator),
        section: .None,
        link_once: false,
        weak: false,
    };
}
