import std::io{Writer, StringWriter};
import std::collections{Vec};
import std::option{Option};
import std::string{String};
import std::mem{Allocator};

import .::ast{NodeId, ASTNode, ASTIdent};
import diags{DiagContext};
import source{SourceId};
import tokens{
    Token, 
    TokenKind, 
    SourceTokens, 
    Span,
    dump_token
};
import .::diags{
    report_expected_ident, 
    report_expected_token
};

pub struct ParserState {
    pub allocator: Allocator,
    pub dctx: DiagContext*,
    pub pending: Vec<NodeId>*,
    pub source_tokens: SourceTokens*,
    pos: usize,

    [[inline]]
    pub fn new(
        allocator: Allocator,
        dctx: DiagContext*, 
        source_tokens: SourceTokens*, 
        pending: Vec<NodeId>*
    ) Self {
        return Self { 
            allocator,
            dctx, 
            source_tokens, 
            pending,
            pos: 0
        };
    }

    [[inline]]
    pub fn source_id(self: const Self*) SourceId {
        return self->source_tokens->source_id;
    }

    [[inline]]
    pub fn pos(self: const Self*) usize {
        return self->pos;
    }

    pub fn get(self: const Self*, idx: usize) Option<const Token*> {
        return self->source_tokens
            ->tokens
            .get_const(idx);
    }

    pub fn current(self: const Self*) const Token* {
        return self->source_tokens
            ->tokens
            .get_const(self->pos)
            .unwrap();
    }

    pub fn peek(self: const Self*) const Token* {
        return self->source_tokens
            ->tokens
            .get_const(self->pos + 1)
            .unwrap();
    }

    pub fn peek_n(self: const Self*, n: usize) Option<const Token*> {
        return self->source_tokens
            ->tokens
            .get_const(self->pos + n);
    }

    /// Span of the last consumed token.
    [[inline]]
    pub fn last_parsed_span(self: const Self*) Span {
        if (self->pos > 0) {
            switch (self->get(self->pos - 1)) {
                case .Some(prev) => return Span.new(self->source_id(), prev->loc);
            }
        }

        return self->current_span();
    }

    [[inline]]
    pub fn current_span(self: const Self*) Span {
        const token = self->current();

        // At EOF there is no real token to point at. Use the last
        // parsed token instead so the renderer get a source line to show.
        if (*token->kind == .EOF) {
            return self->last_parsed_span();
        }

        return Span.new(self->source_id(), token->loc);
    }

    [[inline]]
    pub fn peek_span(self: const Self*) Span {
        const token = self->peek();

        if (*token->kind == .EOF) {
            return Span.new(self->source_id(), self->current()->loc);
        }

        return Span.new(self->source_id(), token->loc);
    }

    pub fn next(self: Self*) Option<const Token*> {
        switch (self->get(self->pos)) {
            case .Some(token) => {
                self->pos += 1;
                return .Some(token);
            }
            case .None => {
                return .None;
            }
        }
    }

    pub fn expect(self: Self*, kind: TokenKind) bool {
        if (self->is(kind)) {
            self->next();
            return true;
        }

        const got = self->current();
        
        report_expected_token(
            self->allocator, 
            self->dctx, 
            self->current_span(), 
            kind, 
            *got->kind
        );
        return false;
    }

    pub fn expect_peek(self: Self*, kind: TokenKind) bool {
        if (self->is_peek(kind)) {
            self->next();
            return true;
        }

        const got = self->peek();
        
        report_expected_token(
            self->allocator, 
            self->dctx, 
            self->peek_span(), 
            kind, 
            *got->kind
        );
        
        return false;
    }

    [[inline]]
    pub fn expect_left_paren(self: Self*) bool {
        return self->expect(.LeftParen);
    }

    [[inline]]
    pub fn expect_right_paren(self: Self*) bool {
        return self->expect(.RightParen);
    }

    [[inline]]
    pub fn expect_peek_left_paren(self: Self*) bool {
        return self->expect_peek(.LeftParen);
    }

    [[inline]]
    pub fn expect_peek_right_paren(self: Self*) bool {
        return self->expect_peek(.RightParen);
    }

    /// Missing `;` is reported on the last parsed token.
    pub fn expect_semicolon(self: Self*) bool {
        if (self->is(.Semicolon)) {
            self->next();
            return true;
        }

        const got = self->current();
        report_expected_token(
            self->allocator,
            self->dctx,
            self->last_parsed_span(),
            .Semicolon,
            *got->kind
        );
        return false;
    }

    [[inline]]
    pub fn expect_peek_semicolon(self: Self*) bool {
        return self->expect_peek(.Semicolon);
    }

    pub fn expect_ident(self: Self*) Option<ASTIdent> {
        const token = self->current();
        const span = Span { source_id: self->source_id(), loc: token->loc };

        switch (*token->kind) {
            case .Ident(str) => {
                self->next();
                return .Some(ASTIdent { str, span });
            }
            else => {
                report_expected_ident(self->allocator, self->dctx, span, *token->kind);
                return .None;
            }
        }
    }

    pub fn is(self: const Self*, kind: TokenKind) bool {
        switch (self->get(self->pos)) {
            case .Some(token) => if (*token->kind == kind) {
                return true;
            }
        }

        return false;
    }

    pub fn is_literal(self: const Self*, kind: TokenKind) bool {
        switch (self->get(self->pos)) {
            case .Some(token) => switch (*token->kind) {
                case .Literal(_) => return true;
            }
        }

        return false;
    }

    pub fn is_ident(self: const Self*) bool {
        switch (self->get(self->pos)) {
            case .Some(token) => switch (*token->kind) {
                case .Ident(_) => return true;
            }
        }

        return false;
    }

    pub fn is_ident_str(self: const Self*, value: const uint8*) bool {
        switch (self->get(self->pos)) {
            case .Some(token) => switch (*token->kind) {
                case .Ident(str) => return str.as_str_const() == value;
            }
        }

        return false;
    }

    pub fn is_peek_ident_str(self: const Self*, value: const uint8*) bool {
        switch (self->get(self->pos + 1)) {
            case .Some(token) => switch (*token->kind) {
                case .Ident(str) => return str.as_str_const() == value;
            }
        }

        return false;
    }

    pub fn is_peek(self: const Self*, kind: TokenKind) bool {
        switch (self->get(self->pos + 1)) {
            case .Some(token) => if (*token->kind == kind) {
                return true;
            }
        }

        return false;
    }

    /// Returns true if the token `n` positions ahead of the cursor has `kind`.
    pub fn is_peek_n(self: const Self*, n: usize, kind: TokenKind) bool {
        switch (self->get(self->pos + n)) {
            case .Some(token) => if (*token->kind == kind) {
                return true;
            }
        }

        return false;
    }

    pub fn is_peek_literal(self: const Self*, kind: TokenKind) bool {
        switch (self->get(self->pos + 1)) {
            case .Some(token) => switch (*token->kind) {
                case .Literal(_) => return true;
            }
        }

        return false;
    }

    pub fn is_peek_ident(self: const Self*, kind: TokenKind) bool {
        switch (self->get(self->pos + 1)) {
            case .Some(token) => switch (*token->kind) {
                case .Ident(_) => return true;
            }
        }

        return false;
    }

    /// Skips tokens until a recovery point is reached.
    /// Consumes a balanced `{ ... }` group starting at the current `{`.
    pub fn skip_braced(self: Self*) {
        var depth: usize = 0;

        while (!self->is(.EOF)) {
            if (self->is(.LeftBrace)) {
                depth += 1;
            } else if (self->is(.RightBrace)) {
                depth -= 1;
            }

            self->next();

            if (depth == 0) {
                return;
            }
        }
    }

    pub fn sync(self: Self*) {
        while (true) {
            if (self->is(.EOF)) {
                return;
            }

            switch (*self->current()->kind) {
                case .RightBrace 
                | .RightParen 
                | .RightBracket => return;
                
                case .Semicolon => {
                    self->next();
                    return;
                }
            }

            self->next();
        }
    }

    [[inline]]
    pub fn expect_peek_right_brace(self: Self*) bool {
        return self->expect_peek(.RightBrace);
    }

    [[inline]]
    pub fn expect_right_brace(self: Self*) bool {
        return self->expect(.RightBrace);
    }

    [[inline]]
    pub fn expect_left_brace(self: Self*) bool {
        return self->expect(.LeftBrace);
    }

    [[inline]]
    pub fn expect_peek_left_brace(self: Self*) bool {
        return self->expect_peek(.LeftBrace);
    }

    [[inline]]
    pub fn expect_right_bracket(self: Self*) bool {
        return self->expect(.RightBracket);
    }

    [[inline]]
    pub fn expect_peek_right_bracket(self: Self*) bool {
        return self->expect_peek(.RightBracket);
    }

    [[inline]]
    pub fn expect_comma(self: Self*) bool {
        return self->expect(.Comma);
    }

    [[inline]]
    pub fn expect_peek_comma(self: Self*) bool {
        return self->expect_peek(.Comma);
    }

    [[inline]]
    pub fn expect_colon(self: Self*) bool {
        return self->expect(.Colon);
    }

    [[inline]]
    pub fn expect_peek_colon(self: Self*) bool {
        return self->expect_peek(.Colon);
    }

    /// Dumps current token only for debugging purposes.
    pub fn dump_current(self: const Self*) {
        dump_token(*self->current());
    }

    /// Dumps peek token only for debugging purposes.
    pub fn dump_peek(self: const Self*) {
        dump_token(*self->peek());
    }
}