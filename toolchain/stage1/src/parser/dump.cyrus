import std::format{format_usize, format_int64};
import std::io{Writer, StdoutWriter};
import std::collections{Vec};
import std::option{Option};
import tokens{Token};
import .::ast;

pub struct ASTDump {
    program: ast::ASTProgram,
    writer: Writer,
    indent: usize,

    pub fn new(program: ast::ASTProgram, writer: Writer) Self {
        return Self {
            program,
            writer,
            indent: 0,
        };
    }

    pub fn dump(self: Self*) {
        self->write_indent();
        self->writer.writeln("ASTProgram");
        self->indent += 1;

        switch (self->program.statements) {
            case .Some(statements) => {
                for (var i: usize = 0; i < statements.len; i += 1) {
                    const node_id = self->program.children.get_owned(statements.start + i).unwrap();
                    const node = self->program.nodes.get_const(node_id).unwrap();

                    self->write_indent();
                    self->writer.write("Node[");
                    format_usize(self->writer, i);
                    self->writer.writeln("]:");
                    self->indent += 1;
                    self->dump_node(node);
                    self->indent -= 1;
                }
            }
            else => {}
        }

        self->indent -= 1;
    }

    fn write_indent(self: Self*) {
        for (var i: usize = 0; i < self->indent; i += 1) {
            self->writer.write("    ");
        }
    }

    fn dump_ident(
        self: Self*, 
        name: const uint8*, 
        ident: const ast::ASTIdent*
    ) {
        self->write_indent();
        self->writer.write(name);
        self->writer.write(": ");
        self->writer.writeln(ident->str.as_str_const());
    }

    fn dump_bool(self: Self*, name: const uint8*, value: bool) {
        self->write_indent();
        self->writer.write(name);
        self->writer.write(": ");
        if (value) {
            self->writer.writeln("true");
        } else {
            self->writer.writeln("false");
        }
    }

    fn dump_usize(self: Self*, name: const uint8*, value: usize) {
        self->write_indent();
        self->writer.write(name);
        self->writer.write(": ");
        format_usize(self->writer, value);
        self->writer.write_char('\n');
    }

    fn dump_node_id(self: Self*, name: const uint8*, id: ast::NodeId) {
        self->dump_usize(name, id);
    }

    fn dump_subtree(self: Self*, name: const uint8*, id: ast::NodeId) {
        self->write_indent();
        self->writer.write(name);
        self->writer.writeln(":");
        self->indent += 1;
        const node = self->program.nodes.get_const(id).unwrap();
        self->dump_node(node);
        self->indent -= 1;
    }

    fn dump_subtree_indexed(
        self: Self*, 
        name: const uint8*, 
        index: usize, 
        id: ast::NodeId
    ) {
        self->write_indent();
        self->writer.write(name);
        self->writer.write("[");
        format_usize(self->writer, index);
        self->writer.writeln("]:");
        self->indent += 1;
        const node = self->program.nodes.get_const(id).unwrap();
        self->dump_node(node);
        self->indent -= 1;
    }

    fn dump_node_list(
        self: Self*, 
        name: const uint8*, 
        list: const Vec<ast::NodeId>*
    ) {
        for (var i: usize = 0; i < list->len(); i += 1) {
            const id = list->get_const(i).unwrap();
            self->dump_subtree_indexed(name, i, *id);
        }
    }

    fn dump_node(self: Self*, node: const ast::ASTNode*) {
        switch (*node) {
            case .DestructTuple(var node) => self->dump_destruct_tuple(&node);
            case .SwitchGuard(var node) => self->dump_switch_guard(&node);
            case .ModuleDecl(var node) => self->dump_module_decl(&node);
            case .InlineAsm(var node) => self->dump_inline_asm(&node);
            case .Expr(var expr) => self->dump_expr_node(&expr);
            case .TypeAlias(var node) => self->dump_type_alias(&node);
            case .Interface(var node) => self->dump_interface(&node);
            case .GlobalVar(var node) => self->dump_global_var(&node);
            case .FuncDecl(var node) => self->dump_func_decl(&node);
            case .Type(var ty) => self->dump_type("Type", ty);
            case .Continue(var node) => self->dump_continue(&node);
            case .FuncDef(var node) => self->dump_func_def(&node);
            case .Builtin(var node) => self->dump_builtin(&node);
            case .Struct(var node) => self->dump_struct(&node);
            case .Switch(var node) => self->dump_switch(&node);
            case .Return(var node) => self->dump_return(&node);
            case .Import(var node) => self->dump_import(&node);
            case .Defer(var node) => self->dump_defer(&node);
            case .Break(var node) => self->dump_break(&node);
            case .Label(var node) => self->dump_label(&node);
            case .Block(var node) => self->dump_block(&node);
            case .While(var node) => self->dump_while(&node);
            case .Union(var node) => self->dump_union(&node);
            case .Enum(var node) => self->dump_enum(&node);
            case .Goto(var node) => self->dump_goto(&node);
            case .Var(var node) => self->dump_var(&node);
            case .For(var node) => self->dump_for(&node);
            case .If(var node) => self->dump_if(&node);
            else => {}
        }
    }

    fn dump_type_alias(self: Self*, node: const ast::ASTTypeAlias*) {
        self->write_indent();
        self->writer.writeln("ASTTypeAlias");
        self->indent += 1;
        self->dump_ident("ident", &node->ident);

        switch (node->vis) {
            case .Public => self->dump_str("visibility", "public");
            else => {}
        }

        self->dump_generic_params(&node->generic_params);
        self->dump_type_node("ty", node->ty);
        self->indent -= 1;
    }

    fn dump_var(self: Self*, node: const ast::ASTVar*) {
        self->write_indent();
        self->writer.writeln("ASTVar");
        self->indent += 1;
        self->dump_ident("ident", &node->ident);
        self->dump_bool("is_const", node->is_const);
        self->dump_bool("is_undef", node->is_undef);

        switch (node->ty) {
            case .Some(ty) => self->dump_type("ty", ty);
            else => {}
        }
        switch (node->rhs) {
            case .Some(rhs_id) => self->dump_subtree("rhs", rhs_id);
            else => {}
        }

        self->indent -= 1;
    }

    fn dump_global_var(self: Self*, node: const ast::ASTGlobalVar*) {
        self->write_indent();
        self->writer.writeln("ASTGlobalVar");
        self->indent += 1;
        self->dump_ident("ident", &node->ident);
        self->dump_global_var_modifiers(&node->modifiers);
        self->dump_bool("is_const", node->is_const);
        self->dump_bool("is_undef", node->is_undef);
        self->dump_bool("is_static", node->is_static);

        switch (node->ty) {
            case .Some(ty) => self->dump_type("ty", ty);
            else => {}
        }
        switch (node->expr) {
            case .Some(expr_id) => self->dump_subtree("expr", expr_id);
            else => {}
        }

        self->indent -= 1;
    }

    fn dump_func_def(self: Self*, node: const ast::ASTFuncDef*) {
        self->write_indent();
        self->writer.writeln("ASTFuncDef");
        self->indent += 1;
        self->dump_ident("ident", &node->ident);
        self->dump_func_modifiers(&node->modifiers);
        self->dump_func_params(&node->params);
        
        switch (node->ret_type) {
            case .Some(ty) => self->dump_type_node("ret_type", ty);
            else => {}
        }

        self->dump_subtree("body", node->body);
        self->indent -= 1;
    }

    fn dump_func_decl(self: Self*, node: const ast::ASTFuncDecl*) {
        self->write_indent();
        self->writer.writeln("ASTFuncDecl");
        self->indent += 1;
        self->dump_ident("ident", &node->ident);
        self->dump_func_modifiers(&node->modifiers);
        self->dump_func_params(&node->params);
        switch (node->ret_type) {
            case .Some(ty) => self->dump_type_node("ret_type", ty);
            else => {}
        }
        self->indent -= 1;
    }

    fn dump_func_modifiers(self: Self*, m: const ast::ASTFuncModifiers*) {
        switch (m->vis) {
            case .Public => self->dump_str("visibility", "public");            
            else => {}
        }

        switch (m->extern_) {
            case .Some(abi) => self->dump_str("extern", abi.to_str());
            else => {}
        }

        switch (m->inline) {
            case .Some(value) => self->dump_str("inline", value.to_str());
            else => {}
        }

        switch (m->callconv) {
            case .Some(value) => self->dump_str("callconv", value.to_str());
            else => {}
        }

        switch (m->prologue) {
            case .Some(_) => self->dump_str("prologue", "naked");
            else => {}
        }

        for (var i: usize = 0; i < m->optional_flags.len(); i += 1) {
            switch (m->optional_flags.get_const(i)) {
                case .Some(flag) => {
                    switch (*flag) {
                        case .NoReturn => self->dump_str("optional_flag", "noreturn");
                        case .NoUnwind => self->dump_str("optional_flag", "nounwind");
                        case .OptSize => self->dump_str("optional_flag", "opt_size");
                        case .OptNone => self->dump_str("optional_flag", "opt_none");
                        case .Cold => self->dump_str("optional_flag", "cold");
                        case .Hot => self->dump_str("optional_flag", "hot");
                        case .NoSanitize(name) => {
                            self->dump_str("optional_flag", name.as_str_const());
                        }
                    }
                }
                else => {}
            }
        }

        switch (m->section) {
            case .Some(value) => self->dump_str("section", value.as_str_const());
            else => {}
        }

        switch (m->link_name) {
            case .Some(value) => self->dump_str("link_name", value.as_str_const());
            else => {}
        }

        if (m->link_once) {
            self->dump_bool("link_once", true);
        }

        if (m->weak) {
            self->dump_bool("weak", true);
        }
    }

    fn dump_global_var_modifiers(self: Self*, m: const ast::ASTGlobalVarModifiers*) {
        switch (m->vis) {
            case .Public => self->dump_str("visibility", "public");
            else => {}
        }

        switch (m->extern_) {
            case .Some(abi) => self->dump_str("extern", abi.to_str());
            else => {}
        }

        if (m->thread_local) {
            self->dump_bool("thread_local", true);
        }

        switch (m->section) {
            case .Some(value) => self->dump_str("section", value.as_str_const());
            else => {}
        }

        switch (m->link_name) {
            case .Some(value) => self->dump_str("link_name", value.as_str_const());
            else => {}
        }

        if (m->link_once) {
            self->dump_bool("link_once", true);
        }

        if (m->weak) {
            self->dump_bool("weak", true);
        }
    }

    fn dump_repr_attr(self: Self*, repr: const Option<ast::ASTReprAttr>*) {
        switch (*repr) case .Some(value) else {
            return;
        }

        for (var i: usize = 0; i < value.items.len(); i += 1) {
            switch (value.items.get_const(i)) {
                case .Some(item) => {
                    self->write_indent();
                    self->writer.write("repr[");
                    format_usize(self->writer, i);
                    self->writer.write("]: ");

                    switch (item->kind) {
                        case .Packed => self->writer.writeln("packed");
                        case .Kind(kind) => self->writer.writeln(kind.to_str());
                    }
                }
                else => {}
            }
        }
    }

    fn dump_func_params(self: Self*, params: const ast::ASTFuncParams*) {
        self->write_indent();
        self->writer.writeln("params:");
        self->indent += 1;

        for (var i: usize = 0; i < params->list.len(); i += 1) {
            const kind = params->list.get_const(i).unwrap();

            self->write_indent();
            self->writer.write("param[");
            format_usize(self->writer, i);
            self->writer.writeln("]:");
            self->indent += 1;

            switch (*kind) {
                case .FuncParam(var param) => {
                    self->dump_ident("ident", &param.ident);
                    self->dump_str("constness", param.constness.to_str());

                    switch (param.ty) {
                        case .Some(ty) => self->dump_type("ty", ty);
                        else => {}
                    }
                }
                case .SelfModifier(var m) => {
                    self->write_indent();
                    self->writer.writeln("self");
                    self->dump_str("constness", m.constness.to_str());
                    self->dump_type_node("ty", m.ty);
                }
            }

            self->indent -= 1;
        }

        switch (params->variadic) {
            case .Some(.UntypedCStyle) => {
                self->dump_str("variadic", "c_style");
            }
            case .Some(.Typed(name, ty)) => {
                self->dump_ident("variadic", &name);
                self->dump_type_node("type", ty);
            }
            else => {}
        }

        self->indent -= 1;
    }

    fn dump_struct(self: Self*, node: const ast::ASTStruct*) {
        self->write_indent();
        self->writer.writeln("ASTStruct");
        self->indent += 1;
        self->dump_ident("ident", &node->ident);
        self->dump_bool("is_packed", node->is_packed);

        switch (node->modifiers.vis) {
            case .Public => self->dump_str("visibility", "public");
            
            else => {}
        }

        self->dump_repr_attr(&node->modifiers.repr_attr);

        switch (node->align) {
            case .Some(value) => self->dump_usize("align", value);
            else => {}
        }

        self->dump_generic_params(&node->generic_params);

        self->dump_usize("impls_count", node->impls.len());

        for (var i: usize = 0; i < node->impls.len(); i += 1) {
            const imp = node->impls.get_const(i).unwrap();

            self->write_indent();
            self->writer.write("impl[");
            format_usize(self->writer, i);
            self->writer.writeln("]:");
            self->indent += 1;
            self->dump_type_node("ty", imp->ty);
            self->indent -= 1;
        }

        self->dump_usize("fields_count", node->fields.len());

        for (var i: usize = 0; i < node->fields.len(); i += 1) {
            const field = node->fields.get_const(i).unwrap();

            self->write_indent();
            self->writer.write("field[");
            format_usize(self->writer, i);
            self->writer.writeln("]:");
            self->indent += 1;
            self->dump_ident("name", &field->name);

            switch (field->vis) {
                case .Public => self->dump_str("visibility", "public");
                else => {}
            }

            self->dump_type_node("ty", field->ty);
            self->indent -= 1;
        }

        self->dump_usize("methods_count", node->methods.len());
        self->dump_node_list("method", &node->methods);
        self->indent -= 1;
    }

    fn dump_generic_params(self: Self*, params: const ast::ASTGenericParams*) {
        self->dump_usize("generic_params_count", params->len());

        for (var i: usize = 0; i < params->len(); i += 1) {
            const param = params->get_const(i).unwrap();

            self->write_indent();
            self->writer.write("generic_param[");
            format_usize(self->writer, i);
            self->writer.writeln("]:");
            self->indent += 1;
            self->dump_ident("name", &param->name);

            switch (param->bounds) {
                case .Some(bounds) => {
                    self->dump_usize("bounds_count", bounds.len());

                    for (var j: usize = 0; j < bounds.len(); j += 1) {
                        const bound = bounds.get_const(j).unwrap();

                        self->write_indent();
                        self->writer.write("bound[");
                        format_usize(self->writer, j);
                        self->writer.writeln("]:");
                        self->indent += 1;
                        self->dump_type_node("ty", bound->ty);
                        self->indent -= 1;
                    }
                }
                else => {}
            }

            switch (param->default) {
                case .Some(ty) => self->dump_type_node("default", ty);
                else => {}
            }

            self->indent -= 1;
        }
    }

    fn dump_enum(self: Self*, node: const ast::ASTEnum*) {
        self->write_indent();
        self->writer.writeln("ASTEnum");
        self->indent += 1;
        self->dump_ident("ident", &node->ident);

        switch (node->modifiers.vis) {
            case .Public => self->dump_str("visibility", "public");
            
            else => {}
        }

        self->dump_repr_attr(&node->modifiers.repr_attr);

        switch (node->align) {
            case .Some(value) => self->dump_usize("align", value);
            else => {}
        }

        switch (node->tag_type) {
            case .Some(ty) => self->dump_type_node("tag_type", ty);
            else => {}
        }

        self->dump_generic_params(&node->generic_params);

        self->dump_usize("impls_count", node->impls.len());

        for (var i: usize = 0; i < node->impls.len(); i += 1) {
            const imp = node->impls.get_const(i).unwrap();

            self->write_indent();
            self->writer.write("impl[");
            format_usize(self->writer, i);
            self->writer.writeln("]:");
            self->indent += 1;
            self->dump_type_node("ty", imp->ty);
            self->indent -= 1;
        }

        self->dump_usize("variants_count", node->variants.len());

        for (var i: usize = 0; i < node->variants.len(); i += 1) {
            const variant = node->variants.get_const(i).unwrap();

            self->write_indent();
            self->writer.write("variant[");
            format_usize(self->writer, i);
            self->writer.writeln("]:");
            self->indent += 1;

            switch (*variant) {
                case .Unit(var name) => {
                    self->write_indent();
                    self->writer.writeln("ASTEnumVariant::Unit");
                    self->indent += 1;
                    self->dump_ident("ident", &name);
                    self->indent -= 1;
                }
                case .Valued { ident, value } => {
                    self->write_indent();
                    self->writer.writeln("ASTEnumVariant::Valued");
                    self->indent += 1;
                    self->dump_ident("ident", &ident);
                    self->dump_subtree("value", value);
                    self->indent -= 1;
                }
                case .Tuple { ident, fields } => {
                    self->write_indent();
                    self->writer.writeln("ASTEnumVariant::Tuple");
                    self->indent += 1;
                    self->dump_ident("ident", &ident);
                    self->dump_usize("fields_count", fields.len());

                    for (var j: usize = 0; j < fields.len(); j += 1) {
                        const field = fields.get_const(j).unwrap();

                        self->write_indent();
                        self->writer.write("field[");
                        format_usize(self->writer, j);
                        self->writer.writeln("]:");
                        self->indent += 1;
                        self->dump_type_node("ty", field->ty);
                        self->indent -= 1;
                    }

                    self->indent -= 1;
                }
                case .Struct { ident, fields } => {
                    self->write_indent();
                    self->writer.writeln("ASTEnumVariant::Struct");
                    self->indent += 1;
                    self->dump_ident("ident", &ident);
                    self->dump_usize("fields_count", fields.len());

                    for (var j: usize = 0; j < fields.len(); j += 1) {
                        const field = fields.get_const(j).unwrap();

                        self->write_indent();
                        self->writer.write("field[");
                        format_usize(self->writer, j);
                        self->writer.writeln("]:");
                        self->indent += 1;
                        self->dump_ident("name", &field->name);
                        self->dump_type_node("ty", field->ty);
                        self->indent -= 1;
                    }

                    self->indent -= 1;
                }
            }

            self->indent -= 1;
        }

        self->dump_usize("methods_count", node->methods.len());
        self->dump_node_list("method", &node->methods);
        self->indent -= 1;
    }

    fn dump_union(self: Self*, node: const ast::ASTUnion*) {
        self->write_indent();
        self->writer.writeln("ASTUnion");
        self->indent += 1;
        self->dump_ident("ident", &node->ident);

        switch (node->modifiers.vis) {
            case .Public => self->dump_str("visibility", "public");
            else => {}
        }

        self->dump_repr_attr(&node->modifiers.repr_attr);

        switch (node->align) {
            case .Some(value) => self->dump_usize("align", value);
            else => {}
        }

        self->dump_generic_params(&node->generic_params);

        self->dump_usize("impls_count", node->impls.len());

        for (var i: usize = 0; i < node->impls.len(); i += 1) {
            const impl = node->impls.get_const(i).unwrap();

            self->write_indent();
            self->writer.write("impl[");
            format_usize(self->writer, i);
            self->writer.writeln("]:");
            self->indent += 1;
            self->dump_type_node("ty", impl->ty);
            self->indent -= 1;
        }

        self->dump_usize("fields_count", node->fields.len());

        for (var i: usize = 0; i < node->fields.len(); i += 1) {
            const field = node->fields.get_const(i).unwrap();

            self->write_indent();
            self->writer.write("field[");
            format_usize(self->writer, i);
            self->writer.writeln("]:");
            self->indent += 1;
            self->dump_ident("name", &field->name);
            self->dump_type_node("ty", field->ty);
            self->indent -= 1;
        }

        self->dump_usize("methods_count", node->methods.len());
        self->dump_node_list("method", &node->methods);
        self->indent -= 1;
    }

    fn dump_func_type(self: Self*, node: const ast::ASTFuncType*) {
        self->writer.writeln("ASTFuncType");
        self->indent += 1;
        self->dump_usize("params_count", node->params.list.len());

        for (var i: usize = 0; i < node->params.list.len(); i += 1) {
            const id = *node->params.list.get_const(i).unwrap();

            self->write_indent();
            self->writer.write("param[");
            format_usize(self->writer, i);
            self->writer.writeln("]:");
            self->indent += 1;
            self->dump_type_node("ty", id);
            self->indent -= 1;
        }

        switch (node->params.variadic) {
            case .Some(.UntypedCStyle) => self->dump_str("variadic", "cstyle");
            case .Some(.Typed(ty)) => self->dump_type_node("variadic_type", ty);
            else => {}
        }

        self->dump_type_node("ret_type", node->ret_type);
        self->indent -= 1;
    }

    fn dump_interface(self: Self*, node: const ast::ASTInterface*) {
        self->write_indent();
        self->writer.writeln("ASTInterface");
        self->indent += 1;
        self->dump_ident("ident", &node->ident);

        switch (node->vis) {
            case .Public => self->dump_str("visibility", "public");
            else => {}
        }

        self->dump_generic_params(&node->generic_params);
        self->dump_usize("methods_count", node->methods.len());
        self->dump_node_list("method", &node->methods);
        self->indent -= 1;
    }

    fn dump_block(self: Self*, node: const ast::ASTBlock*) {
        self->write_indent();
        self->writer.writeln("ASTBlock");
        self->indent += 1;

        for (var i: usize = 0; i < node->stmts.len; i += 1) {
            const node_id = self->program.children.get_owned(node->stmts.start + i).unwrap();
            self->dump_subtree_indexed("stmt", i, node_id);
        }

        self->indent -= 1;
    }

    fn dump_if(self: Self*, node: const ast::ASTIf*) {
        self->write_indent();
        self->writer.writeln("ASTIf");
        self->indent += 1;
        self->dump_subtree("condition", node->condition);
        self->dump_subtree("then_block", node->then_block);
        self->dump_node_list("branch", &node->branches);
        switch (node->else_block) {
            case .Some(block) => self->dump_subtree("else_block", block);
            else => {}
        }
        self->indent -= 1;
    }

    fn dump_while(self: Self*, node: const ast::ASTWhile*) {
        self->write_indent();
        self->writer.writeln("ASTWhile");
        self->indent += 1;
        self->dump_subtree("condition", node->condition);
        self->dump_subtree("body", node->body);
        self->indent -= 1;
    }

    fn dump_for(self: Self*, node: const ast::ASTFor*) {
        self->write_indent();
        self->writer.writeln("ASTFor");
        self->indent += 1;
        switch (node->initializer) {
            case .Some(init) => self->dump_subtree("initializer", init);
            else => {}
        }
        switch (node->condition) {
            case .Some(cond) => self->dump_subtree("condition", cond);
            else => {}
        }
        switch (node->increment) {
            case .Some(step) => self->dump_subtree("increment", step);
            else => {}
        }
        self->dump_subtree("body", node->body);
        self->indent -= 1;
    }

    fn dump_switch(self: Self*, node: const ast::ASTSwitch*) {
        self->write_indent();
        self->writer.writeln("ASTSwitch");
        self->indent += 1;
        self->dump_subtree("operand", node->operand);
        self->dump_switch_cases(&node->cases);
        switch (node->else_case) {
            case .Some(body) => self->dump_subtree("else_case", body);
            else => {}
        }
        self->indent -= 1;
    }

    fn dump_switch_guard(self: Self*, node: const ast::ASTSwitchGuard*) {
        self->write_indent();
        self->writer.writeln("ASTSwitchGuard");
        self->indent += 1;
        self->dump_subtree("operand", node->operand);

        self->write_indent();
        self->writer.writeln("case:");
        self->indent += 1;
        self->dump_switch_patterns(&node->case_item.patterns);
        self->indent -= 1;

        switch (node->else_case) {
            case .Some(body) => self->dump_subtree("else_case", body);
            else => {}
        }
        self->indent -= 1;
    }

    fn dump_switch_cases(self: Self*, cases: const Vec<ast::ASTSwitchCase>*) {
        for (var i: usize = 0; i < cases->len(); i += 1) {
            const item = cases->get_const(i).unwrap();

            self->write_indent();
            self->writer.write("case[");
            format_usize(self->writer, i);
            self->writer.writeln("]:");
            self->indent += 1;
            self->dump_switch_patterns(&item->patterns);
            self->dump_subtree("body", item->body);
            self->indent -= 1;
        }
    }

    fn dump_switch_patterns(self: Self*, patterns: const Vec<ast::ASTSwitchCasePattern>*) {
        for (var i: usize = 0; i < patterns->len(); i += 1) {
            const pattern = patterns->get_const(i).unwrap();

            self->write_indent();
            self->writer.write("pattern[");
            format_usize(self->writer, i);
            self->writer.writeln("]:");
            self->indent += 1;
            self->dump_switch_pattern_kind(&pattern->kind);
            self->indent -= 1;
        }
    }

    fn dump_switch_pattern_kind(self: Self*, kind: const ast::ASTSwitchCasePatternKind*) {
        switch (*kind) {
            case .Wildcard => {
                self->write_indent();
                self->writer.writeln("Wildcard");
            }
            case .Expr(var id) => {
                self->write_indent();
                self->writer.writeln("Expr");
                self->indent += 1;
                self->dump_subtree("expr", id);
                self->indent -= 1;
            }
            case .Range(var r) => {
                self->write_indent();
                self->writer.writeln("Range");
                self->indent += 1;
                self->dump_subtree("lower", r.lower);
                self->dump_subtree("upper", r.upper);
                self->dump_bool("inclusive_upper", r.inclusive_upper);
                self->indent -= 1;
            }
            case .EnumUnit(var name) => {
                self->write_indent();
                self->writer.writeln("EnumUnit");
                self->indent += 1;
                self->dump_ident("ident", &name);
                self->indent -= 1;
            }
            case .EnumTupleVariant { variant, items } => {
                self->write_indent();
                self->writer.writeln("EnumTupleVariant");
                self->indent += 1;
                self->dump_ident("variant", &variant);

                for (var i: usize = 0; i < items.len(); i += 1) {
                    const item = items.get_const(i).unwrap();

                    self->write_indent();
                    self->writer.write("item[");
                    format_usize(self->writer, i);
                    self->writer.writeln("]:");
                    self->indent += 1;
                    self->dump_switch_pattern_kind(&item->kind);
                    self->indent -= 1;
                }

                self->indent -= 1;
            }
            case .EnumStructVariant { variant, items, ignore } => {
                self->write_indent();
                self->writer.writeln("EnumStructVariant");
                self->indent += 1;
                self->dump_ident("variant", &variant);
                self->dump_bool("ignore", ignore);

                for (var i: usize = 0; i < items.len(); i += 1) {
                    const field = items.get_const(i).unwrap();

                    self->write_indent();
                    self->writer.write("field[");
                    format_usize(self->writer, i);
                    self->writer.writeln("]:");
                    self->indent += 1;
                    self->dump_ident("name", &field->name);

                    self->write_indent();
                    self->writer.writeln("pattern:");
                    self->indent += 1;
                    self->dump_switch_pattern_kind(&field->pattern.kind);
                    self->indent -= 1;

                    self->indent -= 1;
                }

                self->indent -= 1;
            }
            case .Binding { ident, constness } => {
                self->write_indent();
                self->writer.writeln("Binding");
                self->indent += 1;
                self->dump_ident("ident", &ident);
                self->dump_str("constness", constness.to_str());
                self->indent -= 1;
            }
        }
    }

    fn dump_return(self: Self*, node: const ast::ASTReturn*) {
        self->write_indent();
        self->writer.writeln("ASTReturn");
        self->indent += 1;
        switch (node->argument) {
            case .Some(arg) => self->dump_subtree("argument", arg);
            else => {}
        }
        self->indent -= 1;
    }

    fn dump_import(self: Self*, node: const ast::ASTImport*) {
        self->write_indent();
        self->writer.writeln("ASTImport");
        self->indent += 1;

        self->write_indent();
        self->writer.write("relative_level: ");
        format_int64(self->writer, @cast(int64, node->relative_level));
        self->writer.write_char('\n');

        switch (node->alias) {
            case .Some(alias) => self->dump_str("alias", alias.as_str_const());
            else => {}
        }

        self->dump_usize("segments_count", node->segments.len());

        for (var i: usize = 0; i < node->segments.len(); i += 1) {
            const segment = node->segments.get_const(i).unwrap();

            switch (*segment) {
                case .Single(list) => self->dump_module_segment_single(&list);
                case .SubModule(ident) => self->dump_ident("submodule", &ident);
            }
        }

        self->indent -= 1;
    }

    fn dump_module_decl(self: Self*, node: const ast::ASTModuleDecl*) {
        self->write_indent();
        self->writer.writeln("ASTModuleDecl");
        self->indent += 1;
        self->dump_ident("ident", &node->ident);

        switch (node->vis) {
            case .Public => self->dump_str("visibility", "public");
            else => {}
        }

        for (var i: usize = 0; i < node->stmts.len; i += 1) {
            const node_id = self->program.children.get_owned(node->stmts.start + i).unwrap();
            self->dump_subtree_indexed("stmt", i, node_id);
        }

        self->indent -= 1;
    }

    fn dump_defer(self: Self*, node: const ast::ASTDefer*) {
        self->write_indent();
        self->writer.writeln("ASTDefer");
        self->indent += 1;
        self->dump_subtree("operand", node->operand);
        self->indent -= 1;
    }

    fn dump_break(self: Self*, node: const ast::ASTBreak*) {
        self->write_indent();
        self->writer.writeln("ASTBreak");
    }

    fn dump_continue(self: Self*, node: const ast::ASTContinue*) {
        self->write_indent();
        self->writer.writeln("ASTContinue");
    }

    fn dump_label(self: Self*, node: const ast::ASTLabel*) {
        self->write_indent();
        self->writer.writeln("ASTLabel");
        self->indent += 1;
        self->dump_ident("name", &node->name);
        self->indent -= 1;
    }

    fn dump_goto(self: Self*, node: const ast::ASTGoto*) {
        self->write_indent();
        self->writer.writeln("ASTGoto");
        self->indent += 1;
        self->dump_ident("name", &node->name);
        self->indent -= 1;
    }

    fn dump_destruct_tuple(self: Self*, node: const ast::ASTDestructTuple*) {
        self->write_indent();
        self->writer.writeln("ASTDestructTuple");
        self->indent += 1;
        self->dump_str("bind", node->bind.to_str());
        self->dump_destruct_pattern("pattern", &node->pat);

        switch (node->rhs) {
            case .Some(rhs) => self->dump_subtree("rhs", rhs);
            else => {}
        }

        self->indent -= 1;
    }

    fn dump_destruct_pattern(self: Self*, name: const uint8*, p: const ast::ASTDestructTuplePattern*) {
        self->write_indent();
        self->writer.write(name);
        self->writer.writeln(":");
        self->indent += 1;

        switch (p->kind) {
            case .Tuple(var patterns) => {
                self->write_indent();
                self->writer.writeln("Tuple");

                for (var i: usize = 0; i < patterns.len(); i += 1) {
                    const inner = patterns.get_const(i).unwrap();
                    self->dump_destruct_pattern("item", inner);
                }
            }
            case .Ident(var ident) => self->dump_ident("ident", &ident);
            case .Ignore => {
                self->write_indent();
                self->writer.writeln("ignore");
            }
        }

        switch (p->ty) {
            case .Some(ty) => self->dump_type("ty", ty);
            else => {}
        }

        self->indent -= 1;
    }

    fn dump_builtin(self: Self*, node: const ast::ASTBuiltin*) {
        self->write_indent();
        self->writer.writeln("ASTBuiltin");
        self->indent += 1;
        self->dump_builtin_fields(node);
        self->indent -= 1;
    }

    fn dump_builtin_fields(self: Self*, node: const ast::ASTBuiltin*) {
        switch (*node) {
            case .BuiltinFunc(var f) => {
                self->dump_ident("name", &f.name);
                self->dump_node_list("arg", &f.args);
            }
            case .BuiltinBlock(var b) => {
                self->dump_ident("name", &b.name);
                self->dump_node_list("arg", &b.args);
                self->dump_bool("is_toplevel", b.is_toplevel);
                self->dump_subtree("block", b.block);
            }
        }
    }

    fn dump_inline_asm(self: Self*, node: const ast::ASTInlineAsm*) {
        self->write_indent();
        self->writer.writeln("ASTInlineAsm");
        self->indent += 1;
        self->dump_asm_fields(node);
        self->indent -= 1;
    }

    fn dump_asm_fields(self: Self*, node: const ast::ASTInlineAsm*) {
        self->dump_bool("is_volatile", node->is_volatile);

        for (var i: usize = 0; i < node->template.len(); i += 1) {
            const part = node->template.get_const(i).unwrap();
            self->write_indent();
            self->writer.write("template[");
            format_usize(self->writer, i);
            self->writer.writeln("]:");
            self->indent += 1;
            self->dump_str("value", part->as_str_const());
            self->indent -= 1;
        }

        self->dump_asm_operands("output", &node->outputs);
        self->dump_asm_operands("input", &node->inputs);

        for (var i: usize = 0; i < node->clobbers.len(); i += 1) {
            const clobber = node->clobbers.get_const(i).unwrap();
            self->write_indent();
            self->writer.write("clobber[");
            format_usize(self->writer, i);
            self->writer.writeln("]:");
            self->indent += 1;
            self->dump_str("name", clobber->name.as_str_const());
            self->indent -= 1;
        }
    }

    fn dump_asm_operands(self: Self*, name: const uint8*, operands: const Vec<ast::ASTAsmOperand>*) {
        for (var i: usize = 0; i < operands->len(); i += 1) {
            const operand = operands->get_const(i).unwrap();

            self->write_indent();
            self->writer.write(name);
            self->writer.write("[");
            format_usize(self->writer, i);
            self->writer.writeln("]:");
            self->indent += 1;
            self->dump_str("constraint", operand->constraint.as_str_const());
            self->dump_subtree("expr", operand->expr);
            self->indent -= 1;
        }
    }

    fn dump_expr_node(self: Self*, expr: const ast::ASTExpr*) {
        switch (*expr) {
            case .EnumStructVariantInit(var node) => self->dump_expr_enum_struct_variant_init(&node);
            case .UnnamedStructValue(var node) => self->dump_expr_unnamed_struct_value(&node);
            case .UnnamedUnionValue(var node) => self->dump_expr_unnamed_union_value(&node);
            case .UnnamedEnumValue(var node) => self->dump_expr_unnamed_enum_value(&node);
            case .UntypedArray(var node) => self->dump_expr_untyped_array(&node);
            case .ModuleImport(var node) => self->dump_expr_module_import(&node);
            case .TupleAccess(var node) => self->dump_expr_tuple_access(&node);
            case .FieldAccess(var node) => self->dump_expr_field_access(&node);
            case .MethodCall(var node) => self->dump_expr_method_call(&node);
            case .StructInit(var node) => self->dump_expr_struct_init(&node);
            case .ArrayIndex(var node) => self->dump_expr_array_index(&node);
            case .Slice(var node) => self->dump_expr_slice(&node);
            case .InlineAsm(var node) => self->dump_expr_inline_asm(&node);
            case .FuncCall(var node) => self->dump_expr_func_call(&node);
            case .Literal(var node) => self->dump_expr_literal(&node);
            case .Dynamic(var node) => self->dump_expr_dynamic(&node);
            case .Builtin(var node) => self->dump_expr_builtin(&node);
            case .Prefix(var node) => self->dump_expr_prefix(&node);
            case .AddrOf(var node) => self->dump_expr_addr_of(&node);
            case .Assign(var node) => self->dump_expr_assign(&node);
            case .Lambda(var node) => self->dump_expr_lambda(&node);
            case .Deref(var node) => self->dump_expr_deref(&node);
            case .Tuple(var node) => self->dump_expr_tuple(&node);
            case .Ident(var node) => self->dump_expr_ident(&node);
            case .Infix(var node) => self->dump_expr_infix(&node);
            case .Array(var node) => self->dump_expr_array(&node);
            case .Type(var node) => self->dump_type("Type", node);
        }
    }

    fn dump_expr_ident(self: Self*, node: const ast::ASTIdent*) {
        self->write_indent();
        self->writer.writeln("ASTExpr::Ident");
        self->indent += 1;
        self->dump_ident("ident", node);
        self->indent -= 1;
    }

    fn dump_expr_literal(self: Self*, token: const Token*) {
        self->write_indent();
        self->writer.writeln("ASTExpr::Literal");
        self->indent += 1;
        self->write_indent();
        self->writer.write("value: ");
        token->format(self->writer);
        self->writer.write_char('\n');
        self->indent -= 1;
    }

    fn dump_expr_infix(self: Self*, node: const ast::ASTInfixExpr*) {
        self->write_indent();
        self->writer.writeln("ASTExpr::Infix");
        self->indent += 1;
        self->dump_str("operator", node->operator.to_str());
        self->dump_subtree("lhs", node->lhs);
        self->dump_subtree("rhs", node->rhs);
        self->indent -= 1;
    }

    fn dump_expr_prefix(self: Self*, node: const ast::ASTPrefixExpr*) {
        self->write_indent();
        self->writer.writeln("ASTExpr::Prefix");
        self->indent += 1;
        self->dump_str("operator", node->operator.to_str());
        self->dump_subtree("operand", node->operand);
        self->indent -= 1;
    }

    fn dump_expr_assign(self: Self*, node: const ast::ASTAssignExpr*) {
        self->write_indent();
        self->writer.writeln("ASTExpr::Assign");
        self->indent += 1;
        self->dump_str("kind", node->kind.to_str());
        self->dump_subtree("lhs", node->lhs);
        self->dump_subtree("rhs", node->rhs);
        self->indent -= 1;
    }

    fn dump_expr_func_call(self: Self*, node: const ast::ASTFuncCall*) {
        self->write_indent();
        self->writer.writeln("ASTExpr::FuncCall");
        self->indent += 1;
        self->dump_subtree("operand", node->operand);
        self->dump_node_list("arg", &node->args);
        self->indent -= 1;
    }

    fn dump_expr_field_access(self: Self*, node: const ast::ASTFieldAccess*) {
        self->write_indent();
        self->writer.writeln("ASTExpr::FieldAccess");
        self->indent += 1;
        self->dump_subtree("operand", node->operand);
        self->dump_ident("field_name", &node->field_name);
        self->dump_bool("is_thin_arrow", node->is_thin_arrow);
        self->indent -= 1;
    }

    fn dump_expr_method_call(self: Self*, node: const ast::ASTMethodCall*) {
        self->write_indent();
        self->writer.writeln("ASTExpr::MethodCall");
        self->indent += 1;
        self->dump_subtree("operand", node->operand);
        self->dump_ident("method_name", &node->method_name);
        self->dump_node_list("arg", &node->args);
        self->dump_bool("is_thin_arrow", node->is_thin_arrow);
        self->indent -= 1;
    }

    fn dump_expr_struct_init(self: Self*, node: const ast::ASTStructInit*) {
        self->write_indent();
        self->writer.writeln("ASTExpr::StructInit");
        self->indent += 1;
        self->dump_subtree("operand", node->operand);
        self->dump_usize("field_inits_count", node->field_inits.len());
        self->indent -= 1;
    }

    fn dump_expr_array(self: Self*, node: const ast::ASTArrayExpr*) {
        self->write_indent();
        self->writer.writeln("ASTExpr::Array");
        self->indent += 1;

        switch (node->capacity) {
            case .Fixed(capacity) => self->dump_subtree("size", capacity);
            case .Dynamic => self->dump_str("size", "dynamic");
            case .TerminatedSlice => self->dump_str("size", "terminated_slice");
        }

        self->dump_subtree("element_type", node->element_type);
        self->dump_node_list("element", &node->elements);
        self->indent -= 1;
    }

    fn dump_expr_untyped_array(self: Self*, node: const ast::ASTUntypedArrayExpr*) {
        self->write_indent();
        self->writer.writeln("ASTExpr::UntypedArray");
        self->indent += 1;
        self->dump_node_list("element", &node->elements);
        self->indent -= 1;
    }

    fn dump_expr_array_index(self: Self*, node: const ast::ASTArrayIndexExpr*) {
        self->write_indent();
        self->writer.writeln("ASTExpr::ArrayIndex");
        self->indent += 1;
        self->dump_subtree("operand", node->operand);
        self->dump_subtree("index", node->index);
        self->indent -= 1;
    }

    fn dump_expr_slice(self: Self*, node: const ast::ASTSliceExpr*) {
        self->write_indent();
        self->writer.writeln("ASTExpr::Slice");
        self->indent += 1;
        self->dump_subtree("operand", node->operand);
        switch (node->start) {
            case .Some(s) => self->dump_subtree("start", s);
            case .None => {}
        }
        switch (node->end) {
            case .Some(e) => self->dump_subtree("end", e);
            case .None => {}
        }
        self->indent -= 1;
    }

    fn dump_expr_addr_of(self: Self*, node: const ast::ASTAddrOfExpr*) {
        self->write_indent();
        self->writer.writeln("ASTExpr::AddrOf");
        self->indent += 1;
        self->dump_subtree("expr", node->expr);
        self->indent -= 1;
    }

    fn dump_expr_deref(self: Self*, node: const ast::ASTDerefExpr*) {
        self->write_indent();
        self->writer.writeln("ASTExpr::Deref");
        self->indent += 1;
        self->dump_subtree("expr", node->expr);
        self->indent -= 1;
    }

    fn dump_expr_tuple(self: Self*, node: const ast::ASTTupleValue*) {
        self->write_indent();
        self->writer.writeln("ASTExpr::Tuple");
        self->indent += 1;
        self->dump_node_list("element", &node->elements);
        self->indent -= 1;
    }

    fn dump_expr_tuple_access(self: Self*, node: const ast::ASTTupleAccess*) {
        self->write_indent();
        self->writer.writeln("ASTExpr::TupleAccess");
        self->indent += 1;
        self->dump_subtree("operand", node->operand);
        self->dump_usize("index", node->index);
        self->indent -= 1;
    }

    fn dump_expr_dynamic(self: Self*, node: const ast::ASTDynamic*) {
        self->write_indent();
        self->writer.writeln("ASTExpr::Dynamic");
        self->indent += 1;
        self->dump_subtree("operand", node->operand);
        self->indent -= 1;
    }

    fn dump_expr_lambda(self: Self*, node: const ast::ASTLambda*) {
        self->write_indent();
        self->writer.writeln("ASTExpr::Lambda");
        self->indent += 1;
        self->dump_subtree("body", node->body);
        self->dump_subtree("ret_type", node->ret_type);
        self->indent -= 1;
    }

    fn dump_type(self: Self*, name: const uint8*, node: ast::ASTType) {
        self->write_indent();
        self->writer.write(name);
        self->writer.write(": ");
        self->write_type(&node);
    }

    fn write_type(self: Self*, node: const ast::ASTType*) {
        switch (*node) {
            case .FuncType(id) => self->dump_type_ref("ASTType::FuncType", "func", id);
            case .UnnamedStruct(strct) => self->dump_unnamed_struct_type(&strct);
            case .ModuleImport(module) => self->dump_module_import_type(&module);
            case .UnnamedUnion(un) => self->dump_unnamed_union_type(&un);
            case .Builtin(builtin) => self->dump_builtin_type(&builtin);
            case .UnnamedEnum(en) => self->dump_unnamed_enum_type(&en);
            case .SelfType(self_type) => self->writer.writeln("Self");
            case .GenericInst(inst) => self->dump_generic_inst(&inst);
            case .Ident(ident) => self->write_ident_line(&ident);
            case .Pointer(elem) => self->dump_type_pointer(elem);
            case .Tuple(tuple) => self->dump_tuple_type(&tuple);
            case .Array(array) => self->dump_array_type(&array);
            case .Const(elem) => self->dump_type_const(elem);
            case .Primitive(primitive) => {
                self->dump_primitive_type(primitive);
                self->writer.write_char('\n');
            }
        }
    }

    fn write_type_node(self: Self*, id: ast::NodeId) {
        const node = self->program.nodes.get_const(id).unwrap();

        switch (*node) {
            case .Type(ty) => self->write_type(&ty);
            case .FuncType(ty) => self->dump_func_type(&ty);
            else => @unreachable();
        }
    }

    fn dump_type_node(self: Self*, name: const uint8*, id: ast::NodeId) {
        self->write_indent();
        self->writer.write(name);
        self->writer.write(": ");
        self->write_type_node(id);
    }

    fn dump_type_ref(self: Self*, header: const uint8*, name: const uint8*, id: ast::NodeId) {
        self->writer.writeln(header);
        self->indent += 1;
        self->dump_type_node(name, id);
        self->indent -= 1;
    }

    fn dump_generic_inst(self: Self*, node: const ast::ASTGenericInst*) {
        self->writer.writeln("ASTType::GenericInst");
        self->indent += 1;
        self->dump_type_node("base", node->base);

        for (var i: usize = 0; i < node->type_args.list.len(); i += 1) {
            const arg = node->type_args.list.get_const(i).unwrap();

            self->write_indent();
            self->writer.write("type_arg[");
            format_usize(self->writer, i);
            self->writer.write("]: ");

            switch (*arg) {
                case .Type(id) => self->write_type_node(id);
                case .Infer => self->writer.writeln("_");
            }
        }

        self->indent -= 1;
    }

    fn dump_type_pointer(self: Self*, elem: ast::NodeId) {
        self->writer.write("*");
        self->write_type_node(elem);
    }

    fn dump_type_const(self: Self*, elem: ast::NodeId) {
        self->writer.write("const ");
        self->write_type_node(elem);
    }

    fn dump_tuple_type(self: Self*, node: const ast::ASTTupleType*) {
        self->writer.writeln("ASTType::Tuple");
        self->indent += 1;
        self->dump_usize("elements_count", node->type_list.len());

        for (var i: usize = 0; i < node->type_list.len(); i += 1) {
            const id = node->type_list.get_const(i).unwrap();
            self->dump_type_element("element", i, *id);
        }

        self->indent -= 1;
    }

    fn dump_type_element(self: Self*, name: const uint8*, index: usize, id: ast::NodeId) {
        self->write_indent();
        self->writer.write(name);
        self->writer.write("[");
        format_usize(self->writer, index);
        self->writer.write("]: ");
        self->write_type_node(id);
    }

    fn dump_array_type(self: Self*, node: const ast::ASTArrayType*) {
        self->writer.writeln("ASTType::Array");
        self->indent += 1;

        switch (node->size) {
            case .Fixed(capacity) => self->dump_subtree("size", capacity);
            case .Dynamic => self->dump_str("size", "dynamic");
            case .TerminatedSlice => self->dump_str("size", "terminated_slice");
        }

        self->dump_type_node("element_type", node->element_type);
        self->indent -= 1;
    }

    fn dump_unnamed_struct_type(self: Self*, node: const ast::ASTUnnamedStructType*) {
        self->writer.writeln("ASTType::UnnamedStruct");
        self->indent += 1;
        self->dump_usize("fields_count", node->fields.len());

        for (var i: usize = 0; i < node->fields.len(); i += 1) {
            const field = node->fields.get_const(i).unwrap();
            self->write_indent();
            self->writer.write("field[");
            format_usize(self->writer, i);
            self->writer.write("]: ");
            self->write_ident(&field->name);
            self->writer.write(": ");
            self->write_type_node(field->ty);
        }

        self->indent -= 1;
    }

    fn dump_unnamed_union_type(self: Self*, node: const ast::ASTUnnamedUnionType*) {
        self->writer.writeln("ASTType::UnnamedUnion");
        self->indent += 1;
        self->dump_usize("fields_count", node->fields.len());

        for (var i: usize = 0; i < node->fields.len(); i += 1) {
            const field = node->fields.get_const(i).unwrap();
            self->write_indent();
            self->writer.write("field[");
            format_usize(self->writer, i);
            self->writer.write("]: ");
            self->write_ident(&field->ident);
            self->writer.write(": ");
            self->write_type_node(field->field_type);
        }

        self->indent -= 1;
    }

    fn dump_unnamed_enum_type(self: Self*, node: const ast::ASTUnnamedEnumType*) {
        self->writer.writeln("ASTType::UnnamedEnum");
        self->indent += 1;
        self->dump_usize("variants_count", node->variants.len());

        switch (node->tag_type) {
            case .Some(tag) => self->dump_type_node("tag_type", tag);
            else => {}
        }

        self->indent -= 1;
    }

    fn dump_module_import_type(self: Self*, node: const ast::ASTModuleImport*) {
        self->writer.writeln("ASTType::ModuleImport");
        self->indent += 1;
        self->dump_usize("segments_count", node->segments.len());

        for (var i: usize = 0; i < node->segments.len(); i += 1) {
            const segment = node->segments.get_const(i).unwrap();

            switch (*segment) {
                case .Single(list) => self->dump_module_segment_single(&list);
                case .SubModule(ident) => self->dump_ident("submodule", &ident);
            }
        }

        self->indent -= 1;
    }

    fn dump_module_segment_single(self: Self*, list: const Vec<ast::ASTModuleSegmentSingle>*) {
        for (var i: usize = 0; i < list->len(); i += 1) {
            const single = list->get_const(i).unwrap();

            self->write_indent();
            self->writer.write("import: ");
            self->write_ident(&single->ident);

            switch (single->renamed) {
                case .Some(alias) => self->write_ident_alias(&alias);
                case .None => self->writer.write_char('\n');
            }
        }
    }

    fn dump_builtin_type(self: Self*, node: const ast::ASTBuiltin*) {
        switch (*node) {
            case .BuiltinFunc(func) => self->dump_builtin_func_type(&func);
            case .BuiltinBlock(block) => self->dump_builtin_block_type(&block);
        }
    }

    fn dump_builtin_func_type(self: Self*, node: const ast::ASTBuiltinFunc*) {
        self->writer.writeln("ASTType::BuiltinFunc");
        self->indent += 1;
        self->dump_ident("name", &node->name);
        self->dump_usize("args_count", node->args.len());
        self->indent -= 1;
    }

    fn dump_builtin_block_type(self: Self*, node: const ast::ASTBuiltinBlock*) {
        self->writer.writeln("ASTType::BuiltinBlock");
        self->indent += 1;
        self->dump_ident("name", &node->name);
        self->dump_usize("args_count", node->args.len());
        self->dump_node_id("block", node->block);
        self->dump_bool("is_toplevel", node->is_toplevel);
        self->indent -= 1;
    }

    fn write_ident(self: Self*, ident: const ast::ASTIdent*) {
        self->writer.write(ident->str.as_str_const());
    }

    fn write_ident_line(self: Self*, ident: const ast::ASTIdent*) {
        self->writer.writeln(ident->str.as_str_const());
    }

    fn write_ident_alias(self: Self*, alias: const ast::ASTIdent*) {
        self->writer.write(" as ");
        self->writer.writeln(alias->str.as_str_const());
    }

    fn dump_str(self: Self*, name: const uint8*, value: const uint8*) {
        self->write_indent();
        self->writer.write(name);
        self->writer.write(": ");
        self->writer.writeln(value);
    }

    fn dump_primitive_type(self: Self*, node: ast::ASTPrimitiveType) {
        switch (node) {
            case .Int8 => self->writer.write("int8");
            case .Int16 => self->writer.write("int16");
            case .Int32 => self->writer.write("int32");
            case .Int64 => self->writer.write("int64");
            case .Int128 => self->writer.write("int128");
            case .IntPtr => self->writer.write("intptr");
            case .ISize => self->writer.write("isize");
            case .UInt8 => self->writer.write("uint8");
            case .UInt16 => self->writer.write("uint16");
            case .UInt32 => self->writer.write("uint32");
            case .UInt64 => self->writer.write("uint64");
            case .UInt128 => self->writer.write("uint128");
            case .UIntPtr => self->writer.write("uintptr");
            case .USize => self->writer.write("usize");
            case .Float16 => self->writer.write("float16");
            case .Float32 => self->writer.write("float32");
            case .Float64 => self->writer.write("float64");
            case .Float128 => self->writer.write("float128");
            case .Bool => self->writer.write("bool");
            case .Void => self->writer.write("void");
        }
    }

    fn dump_expr_module_import(self: Self*, node: const ast::ASTModuleImport*) {
        self->write_indent();
        self->writer.writeln("ASTExpr::ModuleImport");
    }

    fn dump_expr_builtin(self: Self*, node: const ast::ASTBuiltin*) {
        self->write_indent();
        self->writer.writeln("ASTExpr::Builtin");
        self->indent += 1;
        self->dump_builtin_fields(node);
        self->indent -= 1;
    }

    fn dump_expr_enum_struct_variant_init(self: Self*, node: const ast::ASTEnumStructVariantInit*) {
        self->write_indent();
        self->writer.writeln("ASTExpr::EnumStructVariantInit");
        self->indent += 1;
        self->dump_node_id("operand", node->operand);
        self->dump_ident("ident", &node->ident);
        self->indent -= 1;
    }

    fn dump_expr_unnamed_struct_value(self: Self*, node: const ast::ASTUnnamedStructValue*) {
        self->write_indent();
        self->writer.writeln("ASTExpr::UnnamedStructValue");
        self->indent += 1;
        self->dump_usize("fields_count", node->fields.len());
        self->indent -= 1;
    }

    fn dump_expr_unnamed_union_value(self: Self*, node: const ast::ASTUnnamedUnionValue*) {
        self->write_indent();
        self->writer.writeln("ASTExpr::UnnamedUnionValue");
        self->indent += 1;
        self->dump_usize("fields_count", node->fields.len());
        self->indent -= 1;
    }

    fn dump_expr_unnamed_enum_value(self: Self*, node: const ast::ASTUnnamedEnumValue*) {
        self->write_indent();
        self->writer.writeln("ASTExpr::UnnamedEnumValue");
        self->indent += 1;
        self->dump_ident("ident", &node->ident);
        self->indent -= 1;
    }

    fn dump_expr_inline_asm(self: Self*, node: const ast::ASTInlineAsm*) {
        self->write_indent();
        self->writer.writeln("ASTExpr::InlineAsm");
        self->indent += 1;
        self->dump_asm_fields(node);
        self->indent -= 1;
    }
}
