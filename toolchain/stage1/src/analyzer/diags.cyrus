pub fn report_asm_operand_index_out_of_bounds(
    dctx: DiagContext*,
    allocator: Allocator,
    span: Span,
    index: usize,
    max: usize,
    outputs: usize,
    inputs: usize,
) {
    var msg = String.new(allocator);
    msg.push_str("template operand index %");
    append_usize(&msg, index);
    msg.push_str(" is out of range. Valid range is 0..");
    append_usize(&msg, max);

    const diag = Diag.new(allocator, .Error, msg.as_str_const(), span);

    var hint = String.new(allocator);
    hint.push_str("You have ");
    append_usize(&hint, outputs);
    hint.push_str(" output(s) and ");
    append_usize(&hint, inputs);
    hint.push_str(" input(s), so valid indices are 0..");
    append_usize(&hint, max);
    hint.push_str("");
    diag->help(hint.as_str_const());

    dctx->report(diag);

    hint.free();
    msg.free();
}

pub fn report_asm_constraint_type_mismatch(
    dctx: DiagContext*,
    allocator: Allocator,
    span: Span,
    constraint: const uint8*,
    found: const uint8*,
    hint: const uint8*,
) {
    var msg = String.new(allocator);
    msg.push_str("operand type `");
    msg.push_str(found);
    msg.push_str("` is not compatible with constraint `");
    msg.push_str(constraint);
    msg.push_str("`");

    const diag = Diag.new(allocator, .Error, msg.as_str_const(), span);
    if (hint[0] != 0) {
        diag->help(hint);
    }
    dctx->report(diag);

    msg.free();
}

