pub fn report_assignment_type_mismatch(
    dctx: DiagContext*,
    allocator: Allocator,
    span: Span,
    lhs_type: const uint8*,
    rhs_type: const uint8*,
) {
    var msg = String.new(allocator);
    msg.push_str("cannot assign rvalue of type `");
    msg.push_str(rhs_type);
    msg.push_str("` to lvalue of type `");
    msg.push_str(lhs_type);
    msg.push_str("`");

    const diag = Diag.new(allocator, .Error, msg.as_str_const(), span);
    dctx->report(diag);

    msg.free();
}

pub fn report_invalid_infix(
    dctx: DiagContext*,
    allocator: Allocator,
    span: Span,
    lhs_type: const uint8*,
    rhs_type: const uint8*,
    with_cast_hint: bool,
) {
    var msg = String.new(allocator);
    msg.push_str("cannot apply infix operator between values of type `");
    msg.push_str(lhs_type);
    msg.push_str("` and `");
    msg.push_str(rhs_type);
    msg.push_str("`");

    const diag = Diag.new(allocator, .Error, msg.as_str_const(), span);
    if (with_cast_hint) {
        diag->help(
            "consider adding an explicit cast to either the lhs or rhs operand to make their types compatible"
        );
    }
    dctx->report(diag);

    msg.free();
}

pub fn report_infix_invalid(
    dctx: DiagContext*,
    allocator: Allocator,
    decl_tables: const DeclTables*,
    lhs_type: cir::SemaType,
    rhs_type: cir::SemaType,
    loc: Span,
    with_cast_hint: bool,
) {
    var lhs_str = format::format_sema_type(allocator, decl_tables, &lhs_type);
    var rhs_str = format::format_sema_type(allocator, decl_tables, &rhs_type);

    report_invalid_infix(
        dctx,
        allocator,
        loc,
        lhs_str.as_str_const(),
        rhs_str.as_str_const(),
        with_cast_hint
    );

    lhs_str.free();
    rhs_str.free();
}

