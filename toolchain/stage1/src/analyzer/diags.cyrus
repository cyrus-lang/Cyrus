pub fn report_cyclic_type_definition(
    dctx: DiagContext*,
    allocator: Allocator,
    span: Span,
    cycle: const Vec<String>*,
) {
    var msg = String.new(allocator);

    if (cycle->len() == 0) {
        msg.push_str("cyclic type definition found");
    } else {
        const first = cycle->get_const(0).unwrap();
        msg.push_str("cyclic type definition found for type `");
        msg.push_str(first->as_str_const());
        msg.push_str("`");
    }

    const diag = Diag.new(allocator, .Error, msg.as_str_const(), span);
    diag->help("cycles in type definitions are not allowed as they result in infinite recursion");

    for (var i: usize = 1; i < cycle->len(); i += 1) {
        const name = cycle->get_const(i).unwrap();
        diag->info(name->as_str_const());
    }

    dctx->report(diag);

    msg.free();
}

