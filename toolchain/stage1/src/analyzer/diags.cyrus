pub fn report_wrong_number_of_type_args(
    dctx: DiagContext*,
    allocator: Allocator,
    span: Span,
    type_name: const uint8*,
    expected: usize,
    provided: usize,
) {
    var msg = String.new(allocator);
    msg.push_str("type `");
    msg.push_str(type_name);
    msg.push_str("` expects ");
    append_usize(&msg, expected);
    msg.push_str(" type arguments but ");
    append_usize(&msg, provided);
    msg.push_str(" were provided");

    const diag = Diag.new(allocator, .Error, msg.as_str_const(), span);
    dctx->report(diag);

    msg.free();
}

