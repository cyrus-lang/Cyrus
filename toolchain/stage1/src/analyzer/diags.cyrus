    var msg = String.new(allocator);
    msg.push_str("output constraint `");
    msg.push_str(constraint);
    msg.push_str("` is invalid; must begin with `=` or `+`");

    const diag = Diag.new(allocator, .Error, msg.as_str_const(), span);
    diag->help("output constraints must start with `=` (write-only) or `+` (read-write)");
    dctx->report(diag);

    msg.free();
}

pub fn report_asm_invalid_input_constraint(
