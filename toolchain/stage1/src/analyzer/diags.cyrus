    allocator: Allocator,
    span: Span,
) {
    var msg = String.from_str(
        allocator,
        "`repr(c)` enum cannot contain non-integer variants, because their layout cannot be represented in the C ABI"
    );

    const diag = Diag.new(allocator, .Error, msg.as_str_const(), span);
    dctx->report(diag);

    msg.free();
}

pub fn report_invalid_nested_export_tuple(
    dctx: DiagContext*,
    allocator: Allocator,
    span: Span,
    mutability: const uint8*,
) {
    var msg = String.new(allocator);
    msg.push_str("invalid variable declaration in tuple destructuring: nested `");
    msg.push_str(mutability);
    msg.push_str("` is not allowed");

    const diag = Diag.new(allocator, .Error, msg.as_str_const(), span);
    dctx->report(diag);

    msg.free();
}

pub fn report_valued_enum_variant_can_only_export_one_field(
    dctx: DiagContext*,
    allocator: Allocator,
    span: Span,
    variant_name: const uint8*,
) {
    var msg = String.new(allocator);
    msg.push_str("valued variant `");
    msg.push_str(variant_name);
    msg.push_str("` can export only one field, because it contains exactly one value");

    const diag = Diag.new(allocator, .Error, msg.as_str_const(), span);
    dctx->report(diag);

    msg.free();
}

pub fn append_usize(out: String*, value: usize) {
    var writer: Writer = dynamic StringWriter.new(out);
    format_usize(writer, value);
}

pub fn append_u32(out: String*, value: uint32) {
    var writer: Writer = dynamic StringWriter.new(out);
    format_uint32(writer, value);
}

pub fn report_if_duplicate_param_names(dctx: DiagContext*, allocator: Allocator, decl_tables: DeclTables*, params: const cir::TypedFuncParams*, loc: Span) {
    for (var i: usize = 0; i < params->list.len(); i += 1) {
        const param = params->list.get_const(i).unwrap();

        switch (*param) {
            case .FuncParam(typed_func_param) => {
                var is_duplicate = false;

                for (var j: usize = 0; j < i; j += 1) {
                    const earlier = params->list.get_const(j).unwrap();

                    switch (*earlier) {
                        case .FuncParam(earlier_param) => {
                            if (typed_func_param.ident.str.as_str_const() == earlier_param.ident.str.as_str_const()) {
                                is_duplicate = true;
                            }
                        }
                        case .SelfModifier => {
                            if (typed_func_param.ident.str.as_str_const() == "self") {
                                is_duplicate = true;
                            }
                        }
                    }
                }

                if (is_duplicate) {
                    report_duplicate_func_parameter(
                        dctx,
                        allocator,
                        loc,
                        typed_func_param.ident.str.as_str_const(),
                        i
                    );
                }
            }
            case .SelfModifier => {}
        }
    }

    switch (params->variadic) {
        case .Some(.Typed { var_decl_id, .. }) => {
            const var_decl = decl_tables->vars.get_const(var_decl_id).unwrap();

            var is_duplicate = false;

            for (var j: usize = 0; j < params->list.len(); j += 1) {
                const param = params->list.get_const(j).unwrap();
                
                if (param->name_str() == var_decl->name.as_str_const()) {
                    is_duplicate = true;
                }
            }

            if (is_duplicate) {
                report_duplicate_func_variadic_parameter(
                    dctx,
                    allocator,
                    loc,
                    var_decl->name.as_str_const()
                );
            }
        }
        case .Some(.UntypedCStyle) => {}
        case .None => {}
    }
}
