pub fn report_func_call_args_count_mismatch(
    dctx: DiagContext*,
    allocator: Allocator,
    span: Span,
    func_name: const uint8*,
    expected: uint32,
    provided: uint32,
) {
    var msg = String.new(allocator);
    msg.push_str("function `");
    msg.push_str(func_name);
    msg.push_str("` expects ");
    append_u32(&msg, expected);
    msg.push_str(" arguments, but ");
    append_u32(&msg, provided);
    msg.push_str(" was provided");

    const diag = Diag.new(allocator, .Error, msg.as_str_const(), span);
    dctx->report(diag);

    msg.free();
}

pub fn report_func_call_param_type_mismatch(
    dctx: DiagContext*,
    allocator: Allocator,
    span: Span,
    argument_idx: uint32,
    argument_type: const uint8*,
    param_type: const uint8*,
) {
    var msg = String.new(allocator);
    msg.push_str("argument at index ");
    append_u32(&msg, argument_idx);
    msg.push_str(" has type `");
    msg.push_str(argument_type);
    msg.push_str("`, but the expected parameter type is `");
