pub fn report_unknown_symbol(
    dctx: DiagContext*,
    allocator: Allocator,
    span: Span,
    symbol_name: const uint8*,
) {
    var msg = String.new(allocator);
    msg.push_str("unknown symbol `");
    msg.push_str(symbol_name);
    msg.push_str("`");

    const diag = Diag.new(allocator, .Error, msg.as_str_const(), span);
    dctx->report(diag);

    msg.free();
}

