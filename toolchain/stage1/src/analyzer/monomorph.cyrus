import std::collections::hash_map{HashMap};
import std::hash{hash_usize, eq_usize};
import std::collections{Vec};
import std::mem{Allocator};
import std::option{Option};
import std::string{String};

import cir{type_args_eq};
import tokens{Span};
import cir::clone;
import cir;

pub struct MonomorphInstance {
    pub template_id: MonomorphTemplateId,
    pub type_args: cir::TypeArgs,
    pub params: cir::FuncParams,
    pub ret_type: cir::SemaType,
    pub body: Option<cir::BodyId>,
    pub analyzed: bool,
}

pub enum MonomorphTemplateId {
    Func(cir::FuncDeclId),
    Method(cir::MethodDeclId),
}

pub struct MonomorphRegistry {
    pub allocator: Allocator,
    pub instances: Vec<MonomorphInstance>,

    pub fn new(allocator: Allocator) Self {
        return Self {
            allocator,
            instances: Vec.new(allocator),
        };
    }

    pub fn get_or_create(
        self: Self*,
        arena: Allocator,
        template_id: MonomorphTemplateId,
        type_args: const cir::TypeArgs*,
        params: cir::FuncParams,
        ret_type: cir::SemaType
    ) cir::MonomorphId {
        for (var i: usize = 0; i < self->instances.len(); i += 1) {
            const inst = self->instances.get_const(i).unwrap();

            if (inst->template_id == template_id 
                && type_args_eq(&inst->type_args, type_args)) {
                return i;
            }
        }

        self->instances.push(MonomorphInstance {
            template_id,
            type_args: clone::clone_typed_type_args(arena, type_args),
            params,
            ret_type,
            body: .None,
            analyzed: false,
        });

        return self->instances.len() - 1;
    }

    pub fn mark_analyzed(self: Self*, monomorph_id: cir::MonomorphId) {
        switch (self->instances.get(monomorph_id)) case .Some(var entry) else {
            return;
        }

        entry->analyzed = true;
    }

    pub fn get(self: Self*, monomorph_id: cir::MonomorphId) const MonomorphInstance* {
        switch (self->instances.get_const(monomorph_id)) case .Some(entry) else {
            return null;
        }

        return entry;
    }

    pub fn is_analyzed(self: Self*, monomorph_id: cir::MonomorphId) bool {
        switch (self->instances.get_const(monomorph_id)) case .Some(entry) else {
            return false;
        }

        return entry->analyzed;
    }

    pub fn set_body_and_params(
        self: Self*,
        monomorph_id: cir::MonomorphId,
        body: cir::BodyId,
        params: cir::FuncParams
    ) {
        switch (self->instances.get(monomorph_id)) case .Some(var entry) else {
            return;
        }

        entry->body = .Some(body);
        entry->params = params;
    }

    pub fn free(self: Self*) {
        for (var i: usize = 0; i < self->instances.len(); i += 1) {
            const inst = self->instances.get(i).unwrap();
            inst->type_args.free();
        }
        
        self->instances.free();
    }
}

/// Records a generic instantiation key 
/// together with its use-site span.
pub struct InstanceSite {
    pub key: String,
    pub span: Span,
}