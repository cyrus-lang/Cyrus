import std::collections::hash_map{HashMap};
import std::hash{hash_usize, eq_usize};
import std::mem{Allocator, alloc_init};
import std::mem::arena{ArenaAllocator};
import std::collections{Vec};
import std::string{String};
import std::option{Option};

import .::monomorph{MonomorphRegistry, InstanceSite};
import resolver::symbols{GlobalSymbolRegistry};
import analyzer::infer{InferContext};
import .::vtables{VTableRegistry};
import diags{DiagContext};
import tokens{Span};
import cir::tables;
import .::flow;
import .::env;
import cir;

const ANALYZER_ARENA_SIZE: usize = 65536;

pub struct AnalyzerContext {
    pub allocator: Allocator,
    pub arena: ArenaAllocator,
    pub dctx: DiagContext*,
    pub registry: GlobalSymbolRegistry*,
    pub decl_tables: tables::DeclTables*,
    pub trees: Vec<cir::TypedProgramTree>,
    pub func_env: env::FuncEnv,
    pub type_cache: TypeCache,
    pub typedef_stack: Vec<usize>,
    pub generic_env_stack: Vec<env::GenericEnv*>,
    pub reported_typedef_cycles: Vec<String>,
    pub control_region_stack: Vec<flow::ControlRegion>,
    pub instantiations: Vec<InstanceSite>,
    pub monomorph_registry: MonomorphRegistry,
    pub vtable_registry: VTableRegistry,

    pub fn new(
        allocator: Allocator,
        dctx: DiagContext*,
        registry: GlobalSymbolRegistry*,
        decl_tables: tables::DeclTables*,
        trees: Vec<cir::TypedProgramTree>
    ) Self {
        const control_region_stack: Vec<flow::ControlRegion> = Vec.new(allocator);
        const generic_env_stack: Vec<env::GenericEnv*> = Vec.new(allocator);
        const arena = ArenaAllocator.new(allocator, ANALYZER_ARENA_SIZE);
        const reported_typedef_cycles: Vec<String> = Vec.new(allocator);
        const instantiations: Vec<InstanceSite> = Vec.new(allocator);
        const monomorph_registry = MonomorphRegistry.new(allocator);
        const vtable_registry = VTableRegistry.new(allocator);
        const typedef_stack: Vec<usize> = Vec.new(allocator);
        const func_env = env::FuncEnv.new(allocator);
        const type_cache = TypeCache.new(allocator);

        return Self {
            allocator,
            arena,
            dctx,
            registry,
            decl_tables,
            trees,
            func_env,
            typedef_stack,
            instantiations,
            type_cache,
            generic_env_stack,
            control_region_stack,
            reported_typedef_cycles,
            vtable_registry,
            monomorph_registry,
        };
    }

    pub fn free(self: Self*) {
        for (var i: usize = 0; i < self->generic_env_stack.len(); i += 1) {
            const env = *self->generic_env_stack.get(i).unwrap();
            env->free();
        }

        self->generic_env_stack.free();

        for (var i: usize = 0; i < self->instantiations.len(); i += 1) {
            const record = self->instantiations.get(i).unwrap();
            record->key.free();
        }

        self->instantiations.free();

        for (var i: usize = 0; i < self->reported_typedef_cycles.len(); i += 1) {
            var key = self->reported_typedef_cycles.get(i).unwrap();
            key->free();
        }

        self->reported_typedef_cycles.free();
        self->typedef_stack.free();
        self->control_region_stack.free();
        self->type_cache.free();
        self->monomorph_registry.free();
        self->vtable_registry.free();
        self->func_env.free();
        self->arena.destroy();
    }
}

pub enum TypeCacheState {
    Resolving,
    Resolved(cir::SemaType),
}

pub struct TypeCacheFrame {
    pub key: usize,
    pub indirection: uint8,
}

pub enum TypeCacheEnterResult {
    Entered,
    AlreadyResolving(uint8),
}

/// Caches type resolutions and detects cyclic type definitions.
/// (Any indirection makes the cycle legal)
pub struct TypeCache {
    allocator: Allocator,
    states: HashMap<usize, TypeCacheState>,
    stack: Vec<TypeCacheFrame>,

    pub fn new(allocator: Allocator) Self {
        var states: HashMap<usize, TypeCacheState> = HashMap.with_hasher(
            allocator,
            64,
            hash_usize,
            eq_usize
        );

        return Self {
            allocator,
            states,
            stack: Vec.new(allocator),
        };
    }

    pub fn get(self: const Self*, key: usize) Option<cir::SemaType> {
        const state = self->states.get_const(key);

        switch (state) {
            case .Some(entry) => {
                switch (*entry) {
                    case .Resolved(ty) => return .Some(ty);
                    else => {}
                }
            }
            else => {}
        }

        return .None;
    }

    pub fn enter(self: Self*, key: usize, indirection: uint8) TypeCacheEnterResult {
        for (var i: usize = 0; i < self->stack.len(); i += 1) {
            const frame = self->stack.get_const(i).unwrap();

            if (frame->key == key) {
                return .AlreadyResolving(frame->indirection);
            }
        }

        self->states.insert(key, .Resolving);
        self->stack.push(TypeCacheFrame { key, indirection });
        return .Entered;
    }

    pub fn leave(self: Self*, key: usize, ty: cir::SemaType) {
        self->stack.pop();
        self->states.insert(key, .Resolved(ty));
    }

    pub fn free(self: Self*) {
        self->states.free();
        self->stack.free();
    }
}
