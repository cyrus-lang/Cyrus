/* ************* Expressions ************* */

fn analyze_expr(
    context: AnalyzerContext*,
    expr: cir::TypedExpr*,
    expected_type: Option<cir::SemaType>
) Option<cir::SemaType> {
    switch (expr->kind) {
        case .Symbol(var symbol_expr) => {
            const decl_id_opt = analyze_symbol_expr(context->registry, &symbol_expr);
            expr->kind = .Symbol(symbol_expr);

            switch (decl_id_opt) {
                case .Some(decl_id) => {
                    if (!decl_id.is_var_or_global_var() && !decl_id.is_func()) {
                        var name = format::format_decl_name(
                            context->allocator, 
                            context->decl_tables, 
                            &decl_id
                        );

                        diags::report_unknown_symbol(
                            context->dctx, 
                            context->allocator,
                            symbol_expr.span(), 
                            name.as_str_const()
                        );

                        name.free();
                        return .None;
                    }
                }
                else => {}
            }
        }
        case .SemaType { span, .. } => {
            diags::report_type_cannot_be_used_in_context(
                context->dctx, 
                context->allocator, 
                span
            );
            return .None;
        }
        else => {}
    }

    return analyze_expr_non_terminal(context, expr, expected_type);
}

fn analyze_expr_non_terminal(
    context: AnalyzerContext*,
    expr: cir::TypedExpr*,
    var expected_type: Option<cir::SemaType>
) Option<cir::SemaType> {
    switch (expected_type) {
        case .Some(ty) => {
            switch (normalize_sema_type(context, ty, expr->span, 0)) {
                case .Some(normalized_type) => {
                    expected_type = .Some(expand_sema_type(context, normalized_type, expr->span));
                }
                else => {}
            }
        }
        else => {}
    }

    if (expr->analyzed) {
        return expr->ty;
    }

    expr->analyzed = true;

    lower_expr_pre_analysis(context, expr, expected_type);

    var expr_type: Option<cir::SemaType> = .None;

    switch (expr->kind) {
        case .Symbol(var symbol) => {
            const decl_id_opt = analyze_symbol_expr(context->registry, &symbol);
            expr->kind = .Symbol(symbol);

            switch (decl_id_opt) {
                case .Some(decl_id) => {
                    expr_type = type_of_decl(context, decl_id, symbol.span(), 0);
                }
                case .None => {
                    switch (symbol.as_symbol_id()) {
                        case .Some(symbol_id) => {
                            switch (context->registry->symbol_name(symbol_id)) {
                                case .Some(var name) => {
                                    diags::report_unknown_symbol(
                                        context->dctx, 
                                        context->allocator, 
                                        expr->span,
                                        name.as_str_const()
                                    );
                                    name.free();
                                }
                                case .None => {
                                    diags::report_unknown_symbol(
                                        context->dctx, 
                                        context->allocator, 
                                        expr->span,
                                        "UNKNOWN"
                                    );
                                }
                            }
                        }
                        case .None => {
                            diags::report_unknown_symbol(
                                context->dctx, 
                                context->allocator, 
                                expr->span,
                                "UNKNOWN"
                            );
                        }
                    }
                }
            }
        }
        
        case .Builtin(.BuiltinFunc(var bf)) => {
            expr_type = analyze_builtin_expr(context, &bf);
            expr->kind = .Builtin(.BuiltinFunc(bf));
        }
        
        case .Builtin(.BuiltinBlock(builtin_block)) => {
            diags::report_invalid_statement(context->dctx, context->allocator, builtin_block.span);
            return .None;
        }
        
        case .Literal(var literal) => {
            expr_type = analyze_literal(context, &literal, expected_type);
            expr->kind = .Literal(literal);
        }
        
        case .Prefix(var prefix) => {
            expr_type = analyze_prefix(context, &prefix, expected_type);
            expr->kind = .Prefix(prefix);
        }
        
        case .Infix(var infix) => {
            expr_type = analyze_infix(context, &infix, expected_type);
            expr->kind = .Infix(infix);
        }
        
        case .AddrOf(var addr) => {
            expr_type = analyze_addr_of(context, &addr);
            expr->kind = .AddrOf(addr);
        }
        
        case .Deref(var deref) => {
            expr_type = analyze_deref(context, &deref);
            expr->kind = .Deref(deref);
        }
        
        case .Array(var array) => {
            expr_type = analyze_array(context, &array, expected_type);
            expr->kind = .Array(array);
        }
        
        case .Dynamic(var dyn) => {
            expr_type = analyze_dynamic(context, &dyn, expected_type);
            expr->kind = .Dynamic(dyn);
        }
        
        case .MethodCall(var method_call) => {
            expr_type = analyze_method_call(context, &method_call, expected_type);
            expr->kind = .MethodCall(method_call);
        }
        
        case .FuncCall(var func_call) => {
            expr_type = analyze_func_call(context, &func_call);
            expr->kind = .FuncCall(func_call);
        }
        
        case .Lambda(var lambda) => {
            expr_type = analyze_lambda(context, &lambda);
            expr->kind = .Lambda(lambda);
        }
        
        case .Tuple(var tuple) => {
            expr_type = analyze_tuple_value(context, &tuple, expected_type);
            expr->kind = .Tuple(tuple);
        }
        
        case .EnumInit(var enum_init) => {
            expr_type = analyze_enum_init(context, &enum_init, expected_type);
            expr->kind = .EnumInit(enum_init);
        }
        
        case .StructInit(var struct_init) => {
            expr_type = analyze_struct_init(context, &struct_init, expected_type);
            expr->kind = .StructInit(struct_init);
        }
        
        case .UnionInit(var union_init) => {
            expr_type = analyze_union_init(context, &union_init, expected_type);
            expr->kind = .UnionInit(union_init);
        }
        
        case .UnnamedStructValue(var struct_valueue) => {
            expr_type = analyze_unnamed_struct_value(context, &struct_valueue, expected_type);
            expr->kind = .UnnamedStructValue(struct_valueue);
        }
        
        case .UnnamedUnionValue(var union_valueue) => {
            expr_type = analyze_unnamed_union_value(context, &union_valueue, expected_type);
            expr->kind = .UnnamedUnionValue(union_valueue);
        }
        
        case .UnnamedEnumValue(var enum_value) => {
            expr_type = analyze_unnamed_enum_value(context, &enum_value, expected_type);
            expr->kind = .UnnamedEnumValue(enum_value);
        }
        
        case .EnumStructVariantInit(var struct_variant_init) => {
            expr_type = analyze_enum_struct_variant_init(context, &struct_variant_init);
            expr->kind = .EnumStructVariantInit(struct_variant_init);
        }
        
        case .Assign(var assign) => {
            analyze_assign(context, &assign);
            expr_type = assign.rhs->ty;
            expr->kind = .Assign(assign);
        }
        
        case .ArrayIndex(var array_index) => {
            expr_type = analyze_array_index(context, &array_index);
            expr->kind = .ArrayIndex(array_index);
        }
        
        case .FieldAccess(var field_access) => {
            expr_type = analyze_field_access(context, &field_access);
            expr->kind = .FieldAccess(field_access);
        }
        
        case .TupleAccess(var tuple_access) => {
            expr_type = analyze_tuple_access(context, &tuple_access, expected_type);
            expr->kind = .TupleAccess(tuple_access);
        }
        
        case .InlineAsm(var inline_asm) => {
            expr_type = analyze_inline_asm_expr(context, &inline_asm);
            expr->kind = .InlineAsm(inline_asm);
        }
        
        case .SemaType { ty, .. } => {
            const normalized_type = normalize_sema_type(context, ty, expr->span, 0);
            expr->ty = normalized_type;
            return normalized_type;
        }
        
        case .Poisoned => {
            const err_ty: cir::SemaType = .Err(expr->span);
            expr->ty = .Some(err_ty);
            return .Some(err_ty);
        }
    }

    switch (expr_type) {
        case .Some(et) => {
            if (et.contains_error()) {
                expr->ty = .Some(et);
                return .Some(et);
            }

            switch (normalize_and_check_type_formation(context, et, expr->span, 0)) {
                case .Some(normalized_type) => {
                    expr->ty = .Some(normalized_type);

                    switch (context->func_env.infer) {
                        case .Some(infer_ctx) => {
                            expr->ty = .Some(infer_ctx->resolve(&normalized_type));
                        }
                        else => {}
                    }

                    ciri::fold_const_expr(context->decl_tables, context->registry, expr);
                    lower_expr_post_analysis(context, expr);
                    expr->value_category = value_category_of_expr(context, expr);

                    return .Some(normalized_type);
                }
                case .None => {
                    if (context->dctx->has_errors()) {
                        const err_ty: cir::SemaType = .Err(expr->span);
                        expr->ty = .Some(err_ty);
                        return .Some(err_ty);
                    }
                }
            }
        }
        case .None => {
            if (context->dctx->has_errors()) {
                const err_ty: cir::SemaType = .Err(expr->span);
                expr->ty = .Some(err_ty);
                return .Some(err_ty);
            }
        }
    }

    return .None;
}

fn analyze_symbol_expr(
    registry: const GlobalSymbolRegistry*,
    symbol_expr: cir::TypedSymbolExpr*
) Option<cir::DeclId> {
    switch (symbol_expr->as_decl_id()) {
        case .Some(decl_id) => return .Some(decl_id);
        else => {}
    }

    const symbol_id = symbol_expr->as_symbol_id();

    switch (symbol_id) {
        case .Some(id) => {
            const decl_id = registry->lookup_symbol_as_decl_id(id);

            switch (decl_id) {
                case .Some(resolved) => {
                    symbol_expr->to_resolved_decl_id(resolved);
                    return .Some(resolved);
                }
                else => {}
            }
        }
        else => {}
    }

    return .None;
}

fn analyze_cond_expr(
    context: AnalyzerContext*,
    cond: cir::TypedExpr*
) {
    switch (analyze_expr(context, cond, .Some(.Plain(.Bool)))) {
        case .Some(ty) => {
            var expand = expand_sema_type(context, ty, cond->span);

            if (expand.contains_error()) {
                return;
            }

            if (!(expand.is_bool() || expand.is_integer() || expand.is_pointer())) {
                diags::report_condition_must_be_bool(context->dctx, context->allocator, cond->span);
            }

            if (expand.is_pointer()) {
                switch (lower::lower_cond_pointer_as_null_check(context->allocator, cond)) {
                    case .Some(lowered) => *cond = lowered;
                    else => {}
                }
            } else {
                cond->ty = .Some(expand);
            }
        }
        else => {}
    }
}

fn analyze_field_assign(
    context: AnalyzerContext*,
    field_expr: cir::TypedExpr*,
    var expected_type: cir::SemaType,
    span: Span
) {
    switch (normalize_sema_type(context, expected_type, span, 0)) {
        case .Some(ty) => expected_type = ty;
        case .None => return;
    }

    expected_type = generics::substitute_type(context, &expected_type);

    switch (analyze_expr(context, field_expr, .Some(expected_type))) {
        case .Some(value_type) => {
            var ty = generics::substitute_type(context, &value_type);

            switch (context->func_env.infer) {
                case .Some(infer) => {
                    infer->unify(&expected_type, &ty);
                    expected_type = infer->resolve(&expected_type);
                    ty = infer->resolve(&ty);
                }
                else => {}
            }
            expected_type = generics::substitute_type(context, &expected_type);

            if (!is_assignable_to(context, ty, expected_type, span)) {
                var lhs_str = format::format_sema_type(context->allocator, context->decl_tables, &expected_type);
                var rhs_str = format::format_sema_type(context->allocator, context->decl_tables, &ty);

                diags::report_assignment_type_mismatch(
                    context->dctx, 
                    context->allocator, 
                    span, 
                    lhs_str.as_str_const(), 
                    rhs_str.as_str_const()
                );

                lhs_str.free();
                rhs_str.free();
            }
        }
        else => {}
    }
}

fn analyze_literal(
    context: AnalyzerContext*,
    literal: cir::TypedLiteralExpr*,
    expected_type: Option<cir::SemaType>
) Option<cir::SemaType> {
    const span = literal->span;

    var type_opt: Option<cir::SemaType> = .None;
    var kind = literal->kind;

    switch (kind) {
        case .Integer { suffix, .. } => {
            switch (suffix) {
                case .Some(sfx) => {
                    switch (integer_suffix_to_sema_type(sfx)) {
                        case .Some(ty) => {
                            type_opt = .Some(ty);
                        }
                        case .None => {
                            diags::report_invalid_integer_literal_suffix(
                                context->dctx,
                                context->allocator,
                                span,
                                sfx.to_str()
                            );
                        }
                    }
                }
                case .None => {
                    switch (expected_type) {
                        case .Some(ty) => {
                            if (ty.is_integer()) {
                                type_opt = .Some(ty);
                            } else {
                                type_opt = .Some(.Plain(.Int32));
                            }
                        }
                        case .None => {
                            type_opt = .Some(.Plain(.Int32));
                        }
                    }
                }
            }
        }

        case .Float { suffix, .. } => {
            switch (suffix) {
                case .Some(sfx) => {
                    switch (float_suffix_to_sema_type(sfx)) {
                        case .Some(ty) => {
                            type_opt = .Some(ty);
                        }
                        case .None => {
                            diags::report_invalid_float_literal_suffix(
                                context->dctx,
                                context->allocator,
                                span,
                                sfx.to_str()
                            );
                        }
                    }
                }
                case .None => {
                    switch (expected_type) {
                        case .Some(ty) => {
                            if (ty.is_float()) {
                                type_opt = .Some(ty);
                            } else {
                                type_opt = .Some(.Plain(.Float64));
                            }
                        }
                        case .None => type_opt = .Some(.Plain(.Float64));
                    }
                }
            }
        }

        case .String { value, suffix } => {
            const uint8_type: cir::SemaType = cir::SemaType.Plain(.UInt8);
            const const_uint8_type: cir::SemaType = .Const(alloc_init(context->allocator, uint8_type));

            switch (suffix) {
                case .Some(prefix) => {
                    switch (prefix) {
                        case .Byte => {
                            const capacity_expr = cir::const_untyped_integer_expr(
                                @cast(uint128, value.len()),
                                span
                            );

                            type_opt = .Some(.Array(cir::TypedArrayType {
                                element_type: alloc_init(context->allocator, const_uint8_type),
                                capacity: .Fixed(alloc_init(context->allocator, capacity_expr)),
                                span,
                            }));
                        }
                    }
                }
                case .None => {
                    type_opt = .Some(.Pointer(alloc_init(context->allocator, uint8_type)));
                }
            }
        }

        case .Char => type_opt = .Some(.Plain(.UInt8));
        case .Bool => type_opt = .Some(.Plain(.Bool));
        case .Null => type_opt = .Some(.Plain(.Null));
    }

    literal->kind = kind;

    switch (type_opt) {
        case .Some(ty) => literal->ty = .Some(ty);
        else => {}
    }

    return type_opt;
}

fn analyze_tuple_value(
    context: AnalyzerContext*,
    tuple_value: cir::TypedTupleExpr*,
    expected_type: Option<cir::SemaType>
) Option<cir::SemaType> {
    var elements: Vec<cir::TypedTupleElement> = Vec.new(context->allocator);
    var tuple_type_opt: Option<cir::TypedTupleType> = .None;

    switch (expected_type) {
        case .Some(ty) => tuple_type_opt = ty.as_tuple_type();
        else => {}
    }

    for (var i: usize = 0; i < tuple_value->elements.len(); i += 1) {
        const element = tuple_value->elements.get(i).unwrap();

        var expect: Option<cir::SemaType> = .None;

        switch (tuple_type_opt) {
            case .Some(tt) => {
                if (i < tt.elements.len()) {
                    expect = .Some(tt.elements.get_const(i).unwrap()->ty);
                }
            }
            else => {}
        }

        switch (analyze_expr(context, element, expect)) {
            case .Some(ty) => {
                elements.push(cir::TypedTupleElement {
                    ty,
                    span: element->span,
                });
            }
            else => {}
        }
    }

    return .Some(.Tuple(cir::TypedTupleType {
        elements,
        span: tuple_value->span,
    }));
}

fn analyze_tuple_access(
    context: AnalyzerContext*,
    member_access: cir::TypedTupleAccessExpr*,
    expected_type: Option<cir::SemaType>
) Option<cir::SemaType> {
    var operand_type: cir::SemaType = .Placeholder;

    switch (analyze_expr(context, member_access->operand, expected_type)) {
        case .Some(ty) => operand_type = ty;
        case .None => return .None;
    }

    operand_type = expand_sema_type(context, operand_type, member_access->span);

    if (operand_type.contains_error()) {
        return .Some(.Err(member_access->span));
    }

    if (operand_type.const_inner()->as_tuple_type().is_none()) {
        diags::report_tuple_member_access_on_non_tuple_operand(
            context->dctx,
            context->allocator,
            member_access->span
        );
        return .None;
    }

    const tuple_type = operand_type.as_tuple_type().unwrap();

    if (tuple_type.elements.len() == 0) {
        diags::report_member_access_on_empty_tuple(
            context->dctx,
            context->allocator,
            member_access->span
        );
        return .None;
    }

    if (member_access->index > (tuple_type.elements.len() - 1)) {
        diags::report_tuple_index_out_of_range(
            context->dctx,
            context->allocator,
            member_access->span,
            member_access->index,
            tuple_type.elements.len()
        );
        return .None;
    }

    return .Some(tuple_type.elements.get_const(member_access->index).unwrap()->ty);
}

fn analyze_assign(
    context: AnalyzerContext*, 
    assign: cir::TypedAssignExpr*
) {
    switch (analyze_expr(context, assign->lhs, .None)) {
        case .Some(lhs_type) => {
            switch (analyze_expr(context, assign->rhs, .Some(lhs_type))) {
                case .Some(rhs_type) => {
                    const lhs_is_poisoned = lhs_type.contains_error();

                    if (is_const_qualified_lvalue(context, assign->lhs)) {
                        diags::report_cannot_assign_to_const_lvalue(
                            context->dctx,
                            context->allocator,
                            assign->span
                        );
                    }

                    if (!is_assignable_to(context, rhs_type, lhs_type, assign->span)) {
                        var lhs_str = format::format_sema_type(
                            context->allocator,
                            context->decl_tables,
                            &lhs_type
                        );
                        var rhs_str = format::format_sema_type(
                            context->allocator,
                            context->decl_tables,
                            &rhs_type
                        );

                        diags::report_assignment_type_mismatch(
                            context->dctx,
                            context->allocator,
                            assign->span,
                            lhs_str.as_str_const(),
                            rhs_str.as_str_const()
                        );

                        lhs_str.free();
                        rhs_str.free();
                    }

                    if (!assign->lhs->is_lvalue() && !lhs_is_poisoned) {
                        diags::report_cannot_assign_to_non_value(
                            context->dctx,
                            context->allocator,
                            assign->span
                        );
                    }
                }
                else => {}
            }
        }
        else => {}
    }
}

fn analyze_addr_of(
    context: AnalyzerContext*,
    addr: cir::TypedAddrOfExpr*
) Option<cir::SemaType> {
    const expected_type = addr->operand->ty;

    var operand_type: cir::SemaType = .Placeholder;

    switch (analyze_expr(context, addr->operand, expected_type)) {
        case .Some(ty) => operand_type = *ty.const_inner();
        case .None => return .None;
    }

    if (operand_type.contains_error()) {
        return .Some(.Err(addr->span));
    }

    if (!addr->operand->is_lvalue()) {
        diags::report_address_of_rvalue(context->dctx, context->allocator, addr->span);
        return .None;
    }

    if (addr->operand->value_category.is_const_lvalue()) {
        switch (operand_type) {
            case .Pointer(pointee) => {
                var inner: cir::SemaType = *pointee;

                if (!inner.is_const()) {
                    inner = .Const(alloc_init(context->allocator, inner));
                }

                operand_type = .Pointer(alloc_init(context->allocator, inner));
            }
            else => {
                if (!operand_type.is_const()) {
                    operand_type = .Const(alloc_init(context->allocator, operand_type));
                }
            }
        }
    }

    return .Some(.Pointer(alloc_init(context->allocator, operand_type)));
}

fn analyze_deref(
    context: AnalyzerContext*,
    deref: cir::TypedDerefExpr*
) Option<cir::SemaType> {
    const expected_type = deref->operand->ty;

    var operand_type: cir::SemaType = .Placeholder;

    switch (analyze_expr(context, deref->operand, expected_type)) {
        case .Some(ty) => operand_type = *ty.const_inner();
        case .None => return .None;
    }

    deref->operand->ty = .Some(operand_type);

    if (operand_type.contains_error()) {
        return .Some(.Err(deref->span));
    }

    if ((!deref->operand->is_lvalue() 
        || operand_type.as_func_type().is_some())
        && !operand_type.is_pointer())
    {
        var operand_str = format::format_sema_type(
            context->allocator,
            context->decl_tables,
            &operand_type
        );

        diags::report_deref_non_pointer_value(
            context->dctx,
            context->allocator,
            deref->span,
            operand_str.as_str_const()
        );

        operand_str.free();
        return .None;
    }

    switch (operand_type) {
        case .Pointer(inner) => {
            if (inner->is_void()) {
                diags::report_deref_void_pointer_value(context->dctx, context->allocator, deref->span);
                return .None;
            }
            return .Some(*inner);
        }
        else => {
            var operand_str = format::format_sema_type(
                context->allocator, 
                context->decl_tables, 
                &operand_type
            );
            diags::report_deref_non_pointer_value(
                context->dctx,
                context->allocator,
                deref->span, operand_str.as_str_const()
            );
            operand_str.free();
            return .None;
        }
    }
}

fn analyze_prefix(
    context: AnalyzerContext*,
    prefix: cir::TypedPrefixExpr*,
    expected_type: Option<cir::SemaType>
) Option<cir::SemaType> {
    var operand_type: cir::SemaType = .Placeholder;

    switch (analyze_expr(context, prefix->operand, expected_type)) {
        case .Some(ty) => operand_type = *ty.const_inner();
        case .None => return .Some(.Err(prefix->span));
    }

    if (operand_type.contains_error()) {
        return .Some(.Err(prefix->span));
    }

    operand_type = expand_sema_type(context, operand_type, prefix->span);

    switch (prefix->op) {
        case .BitwiseNot => {
            switch (operand_type) {
                case .Plain(pt) => {
                    if (pt.is_integer()) {
                        return .Some(.Plain(pt));
                    }
                }
                else => {}
            }

            var type_str = format::format_sema_type(
                context->allocator,
                context->decl_tables,
                &operand_type
            );
            defer type_str.free();
            diags::report_prefix_minus_on_non_integer(
                context->dctx,
                context->allocator,
                prefix->span,
                type_str.as_str_const()
            );
            return .None;
        }

        case .Bang => {
            switch (operand_type) {
                case .Plain(plain) => {
                    if (plain.is_integer_or_bool()) {
                        return .Some(.Plain(plain));
                    }
                }
                else => {}
            }

            var type_str = format::format_sema_type(
                context->allocator,
                context->decl_tables,
                &operand_type
            );
            defer type_str.free();
            diags::report_prefix_bang_on_non_bool(
                context->dctx,
                context->allocator,
                prefix->span,
                type_str.as_str_const()
            );
            return .None;
        }

        case .Minus => {
            switch (operand_type) {
                case .Plain(pt) => {
                    if (pt.is_integer()) {
                        if (!pt.is_signed()) {
                            diags::report_unary_minus_on_unsigned_integer(
                                context->dctx,
                                context->allocator,
                                prefix->span
                            );
                            return .None;
                        }
                        return .Some(.Plain(pt));
                    } else if (pt.is_float()) {
                        return .Some(.Plain(pt));
                    }
                }
                else => {}
            }

            var type_str = format::format_sema_type(
                context->allocator,
                context->decl_tables,
                &operand_type
            );
            defer type_str.free();
            diags::report_prefix_minus_on_non_integer(
                context->dctx,
                context->allocator,
                prefix->span,
                type_str.as_str_const()
            );
            return .None;
        }
    }
}

fn analyze_arithmetic_expr(
    context: AnalyzerContext*,
    lhs_type: cir::SemaType,
    rhs_type: cir::SemaType,
    span: Span
) Option<cir::SemaType> {
    const lhs = *lhs_type.const_inner();
    const rhs = *rhs_type.const_inner();

    if (!is_type_comparable(context, rhs, lhs, span)) {
        diags::report_infix_invalid(
            context->dctx,
            context->allocator, 
            context->decl_tables, 
            lhs, 
            rhs, 
            span, 
            true
        );
        return .None;
    }

    if ((lhs.is_integer() && rhs.is_integer()) || (lhs.is_float() && rhs.is_float())) {
        switch (lhs.as_plain_type()) {
            case .Some(p1) => {
                switch (rhs.as_plain_type()) {
                    case .Some(p2) => {
                        switch (cir::PlainType.widen_type(p1, p2)) {
                            case .Some(widen) => return .Some(.Plain(widen));
                            else => {}
                        }
                    }
                    else => {}
                }
            }
            else => {}
        }
    }

    diags::report_infix_invalid(
        context->dctx,
        context->allocator, 
        context->decl_tables, 
        lhs, 
        rhs, 
        span, 
        false
    );
    return .None;
}

fn analyze_compare_expr(
    context: AnalyzerContext*,
    lhs_type: cir::SemaType,
    rhs_type: cir::SemaType,
    cmp_eq: bool,
    span: Span
) Option<cir::SemaType> {
    const lhs = *lhs_type.const_inner();
    const rhs = *rhs_type.const_inner();

    if (lhs.is_enum() && rhs.is_enum()) {
        return .Some(.Plain(.Bool));
    }

    if (!is_type_comparable(context, rhs, lhs, span)) {
        diags::report_infix_invalid(context->dctx, context->allocator, context->decl_tables, lhs, rhs, span, false);
        return .None;
    }

    if ((lhs.is_integer() && rhs.is_integer()) || (lhs.is_float() && rhs.is_float())) {
        return .Some(.Plain(.Bool));
    }

    if (cmp_eq) {
        if (lhs.is_pointer() && rhs.is_pointer()) {
            return .Some(.Plain(.Bool));
        }
        if (lhs.is_pointer() && rhs.is_plain_null()) {
            return .Some(.Plain(.Bool));
        }
        if (lhs.is_bool() && rhs.is_bool()) {
            return .Some(.Plain(.Bool));
        }
        if (lhs.as_plain_type().is_some() && rhs.as_plain_type().is_some()) {
            return .Some(.Plain(.Bool));
        }
    }

    diags::report_infix_invalid(context->dctx, context->allocator, context->decl_tables, lhs, rhs, span, false);
    return .None;
}

fn analyze_or_expr(
    context: AnalyzerContext*,
    lhs_type: cir::SemaType,
    rhs_type: cir::SemaType,
    span: Span
) Option<cir::SemaType> {
    const lhs = *lhs_type.const_inner();
    const rhs = *rhs_type.const_inner();

    if (!is_type_comparable(context, rhs, lhs, span)) {
        diags::report_infix_invalid(context->dctx, context->allocator, context->decl_tables, lhs, rhs, span, true);
        return .None;
    }

    if (lhs.is_bool() && rhs.is_bool()) {
        return .Some(.Plain(.Bool));
    }

    diags::report_infix_invalid(context->dctx, context->allocator, context->decl_tables, lhs, rhs, span, false);
    return .None;
}

fn analyze_and_expr(
    context: AnalyzerContext*,
    lhs_type: cir::SemaType,
    rhs_type: cir::SemaType,
    span: Span
) Option<cir::SemaType> {
    const lhs = *lhs_type.const_inner();
    const rhs = *rhs_type.const_inner();

    if (!is_type_comparable(context, rhs, lhs, span)) {
        diags::report_infix_invalid(context->dctx, context->allocator, context->decl_tables, lhs, rhs, span, true);
        return .None;
    }

    if (lhs.is_bool() && rhs.is_bool()) {
        return .Some(.Plain(.Bool));
    }

    diags::report_infix_invalid(context->dctx, context->allocator, context->decl_tables, lhs, rhs, span, false);
    return .None;
}

fn analyze_bitwise_expr(
    context: AnalyzerContext*,
    lhs_type: cir::SemaType,
    rhs_type: cir::SemaType,
    span: Span
) Option<cir::SemaType> {
    const lhs = *lhs_type.const_inner();
    const rhs = *rhs_type.const_inner();

    if (!is_type_comparable(context, rhs, lhs, span)) {
        diags::report_infix_invalid(context->dctx, context->allocator, context->decl_tables, lhs, rhs, span, true);
        return .None;
    }

    switch (lhs.as_plain_type()) {
        case .Some(p1) => {
            switch (rhs.as_plain_type()) {
                case .Some(p2) => {
                    if (p1.is_integer() && p2.is_integer()) {
                        switch (cir::PlainType.widen_type(p1, p2)) {
                            case .Some(widen) => return .Some(.Plain(widen));
                            else => {}
                        }
                    }
                }
                else => {}
            }
        }
        else => {}
    }

    diags::report_infix_invalid(context->dctx, context->allocator, context->decl_tables, lhs, rhs, span, false);
    return .None;
}

fn analyze_right_shift_expr(
    context: AnalyzerContext*,
    lhs_type: cir::SemaType,
    rhs_type: cir::SemaType,
    span: Span
) Option<cir::SemaType> {
    const lhs = *lhs_type.const_inner();
    const rhs = *rhs_type.const_inner();

    if (!is_type_comparable(context, rhs, lhs, span)) {
        diags::report_infix_invalid(context->dctx, context->allocator, context->decl_tables, lhs, rhs, span, true);
        return .None;
    }

    switch (lhs.as_plain_type()) {
        case .Some(p1) => {
            switch (rhs.as_plain_type()) {
                case .Some(p2) => {
                    if (p2.is_signed()) {
                        diags::report_rhs_of_shift_must_be_unsigned_integer(
                            context->dctx,
                            context->allocator,
                            span
                        );
                        return .None;
                    } else if (p1.is_integer() && p2.is_integer()) {
                        switch (cir::PlainType.widen_type(p1, p2)) {
                            case .Some(widen) => return .Some(.Plain(widen));
                            else => {}
                        }
                    }
                }
                else => {}
            }
        }
        else => {}
    }

    diags::report_infix_invalid(context->dctx, context->allocator, context->decl_tables, lhs, rhs, span, false);
    return .None;
}

fn analyze_infix(
    context: AnalyzerContext*,
    infix: cir::TypedInfixExpr*,
    expected_type: Option<cir::SemaType>
) Option<cir::SemaType> {
    var lhs_type: cir::SemaType = .Placeholder;
    var rhs_type: cir::SemaType = .Placeholder;

    switch (analyze_expr(context, infix->lhs, expected_type)) {
        case .Some(ty) => lhs_type = *ty.const_inner();
        case .None => return .Some(.Err(infix->span));
    }

    switch (analyze_expr(context, infix->rhs, .Some(lhs_type))) {
        case .Some(ty) => rhs_type = *ty.const_inner();
        case .None => return .Some(.Err(infix->span));
    }

    if (lhs_type.contains_error() || rhs_type.contains_error()) {
        return .Some(.Err(infix->span));
    }

    lhs_type = expand_sema_type(context, lhs_type, infix->span);
    rhs_type = expand_sema_type(context, rhs_type, infix->span);

    switch (infix->op) {
        case .Mul | .Div | .Rem => {
            return analyze_arithmetic_expr(context, lhs_type, rhs_type, infix->span);
        }

        case .Add => {
            switch (infer_pointer_arithmetic_type(&lhs_type, &rhs_type, true)) {
                case .Some(ty) => return .Some(ty);
                else => {}
            }
            return analyze_arithmetic_expr(context, lhs_type, rhs_type, infix->span);
        }
        
        case .Sub => {
            switch (infer_pointer_arithmetic_type(&lhs_type, &rhs_type, false)) {
                case .Some(ty) => return .Some(ty);
                else => {}
            }
            return analyze_arithmetic_expr(context, lhs_type, rhs_type, infix->span);
        }
        
        case .Equal | .NotEqual => {
            return analyze_compare_expr(context, lhs_type, rhs_type, true, infix->span);
        }
        
        case .BitwiseAnd | .BitwiseOr | .BitwiseXor | .BitwiseAndNot => {
            return analyze_bitwise_expr(context, lhs_type, rhs_type, infix->span);
        }
        
        case .ShiftLeft => {
            return analyze_bitwise_expr(context, lhs_type, rhs_type, infix->span);
        }
        
        case .ShiftRight => {
            return analyze_right_shift_expr(context, lhs_type, rhs_type, infix->span);
        }

        case .LessThan 
        | .LessEqual 
        | .GreaterThan 
        | .GreaterEqual => {
            return analyze_compare_expr(context, lhs_type, rhs_type, false, infix->span);
        }

        case .Or => return analyze_or_expr(context, lhs_type, rhs_type, infix->span);
        
        case .And => return analyze_and_expr(context, lhs_type, rhs_type, infix->span);
        
        case .NullCoalesce => return infer_null_coalesce_type(lhs_type, rhs_type);
    }
}

fn analyze_lambda(
    context: AnalyzerContext*, 
    lambda: cir::TypedLambdaExpr*
) Option<cir::SemaType> {
    normalize_func_params(context, &lambda->params, true, 0);

    const params = cir::func_params_as_type_params(context->allocator, &lambda->params);

    switch (normalize_and_check_type_formation(context, lambda->ret_type, lambda->span, 0)) {
        case .Some(ret_type) => lambda->ret_type = ret_type;
        case .None => return .None;
    }

    var func_type = cir::TypedFuncType {
        params,
        ret_type: alloc_init(context->allocator, lambda->ret_type),
        vis: .Public,
        callconv: .C,
        span: lambda->span,
    };

    const expand = expand_sema_type(context, .FuncType(func_type), lambda->span);

    switch (expand.as_func_type()) {
        case .Some(ft) => func_type = ft;
        case .None => return .None;
    }

    return .Some(.FuncType(func_type));
}

fn analyze_array(
    context: AnalyzerContext*,
    array: cir::TypedArrayExpr*,
    expected_type: Option<cir::SemaType>
) Option<cir::SemaType> {
    var analyzed_first_element = false;

    var expected_element_type: Option<cir::SemaType> = .None;

    switch (expected_type) {
        case .Some(ty) => {
            switch (ty.as_array_type()) {
                case .Some(array_type) => {
                    expected_element_type = .Some(*array_type.element_type);
                }
                else => {}
            }
        }
        else => {}
    }

    const elements_count = array->elements.len();

    // Try to infer from first element
    if (array->ty.is_none()) {
        if (array->elements.len() > 0) {
            const first_elem = array->elements.get(0).unwrap();

            switch (analyze_expr(context, first_elem, expected_element_type)) {
                case .Some(ty) => {
                    const elements_count_expr = cir::const_untyped_integer_expr(
                        @cast(uint128, elements_count),
                        first_elem->span
                    );

                    array->ty = .Some(.Array(cir::TypedArrayType {
                        element_type: alloc_init(context->allocator, ty),
                        capacity: .Fixed(alloc_init(context->allocator, elements_count_expr)),
                        span: array->span,
                    }));
                }
                case .None => {}
            }

            analyzed_first_element = true;
        }
    }

    // Try to infer from expect type
    if (array->ty.is_none()) {
        switch (expected_element_type) {
            case .Some(sema_type) => {
                const elements_count_expr = cir::const_untyped_integer_expr(
                    @cast(uint128, elements_count),
                    array->span
                );
                array->ty = .Some(.Array(cir::TypedArrayType {
                    element_type: alloc_init(context->allocator, sema_type),
                    capacity: .Fixed(alloc_init(context->allocator, elements_count_expr)),
                    span: array->span,
                }));
            }
            case .None => {}
        }
    }

    if (array->ty.is_none()) {
        diags::report_untyped_array_cannot_be_inferred(
            context->dctx,
            context->allocator,
            array->span
        );
    }

    var initial_type: cir::SemaType = .Placeholder;

    switch (array->ty) {
        case .Some(ty) => initial_type = ty;
        case .None => return .None;
    }

    switch (normalize_and_check_type_formation(
        context, 
        initial_type, 
        array->span, 
        0
    )) {
        case .Some(ty) => array->ty = .Some(ty);
        case .None => return .None;
    }

    // expand array type
    switch (array->ty) {
        case .Some(ty) => {
            array->ty = .Some(expand_sema_type(context, ty, array->span));
        }
        case .None => {
            return .None;
        }
    }

    const array_type = array->ty.unwrap().as_array_type().unwrap();

    for (var i: usize = 0; i < array->elements.len(); i += 1) {
        const element = array->elements.get(i).unwrap();

        var expr_type: cir::SemaType = .Placeholder;

        if (analyzed_first_element && element->ty.is_some()) {
            switch (normalize_and_check_type_formation(
                context, 
                element->ty.unwrap(), 
                element->span,
                0
            )) {
                case .Some(ty) => expr_type = ty;
                case .None => continue;
            }
        } else {
            switch (analyze_expr(
                context, 
                element, 
                .Some(*array_type.element_type)
            )) {
                case .Some(ty) => expr_type = ty;
                case .None => continue;
            }
        }

        if (!is_assignable_to(
            context, 
            expr_type, 
            *array_type.element_type, 
            element->span
        )) {
            var found_str = format::format_sema_type(
                context->allocator,
                context->decl_tables,
                &expr_type
            );
            var expected_str = format::format_sema_type(
                context->allocator,
                context->decl_tables,
                array_type.element_type
            );

            diags::report_array_element_type_mismatch(
                context->dctx,
                context->allocator,
                array->span,
                @cast(uint32, i),
                found_str.as_str_const(),
                expected_str.as_str_const()
            );

            found_str.free();
            expected_str.free();
        }
    }

    var array_capacity: usize = 0;

    switch (array_type.capacity) {
        case .Fixed(capacity_expr) => {
            if (analyze_expr(context, capacity_expr, .None).is_none()) {
                return .None;
            }

            switch (ciri::fold_const_expr_int(
                context->decl_tables, 
                context->registry, 
                capacity_expr
            )) {
                case .Some(.Unsigned(x)) => {
                    array_capacity = @cast(usize, x);
                }
                case .Some(.Signed(x)) => {
                    array_capacity = @cast(usize, x);
                }
                case .None => {
                    diags::report_expr_not_comptime_valid(
                        context->dctx,
                        context->allocator,
                        array_type.span
                    );
                    return .None;
                }
            }
        }
        case .Slice => {
            diags::report_unimplemented_feature_slice(
                context->dctx,
                context->allocator,
                array_type.span
            );
            return .None;
        }
    }

    if (array->elements.len() != array_capacity) {
        diags::report_array_elements_count_mismatch(
            context->dctx,
            context->allocator,
            array->span,
            @cast(uint32, array->elements.len()),
            @cast(uint32, array_capacity)
        );
        return .None;
    }

    return .Some(.Array(array_type));
}

fn analyze_array_index(
    context: AnalyzerContext*,
    array_index: cir::TypedArrayIndexExpr*
) Option<cir::SemaType> {
    var operand_type: cir::SemaType = .Placeholder;
    switch (analyze_expr(context, array_index->operand, .None)) {
        case .Some(ty) => operand_type = ty;
        case .None => return .None;
    }

    // Prevent cascading failures
    if (operand_type.contains_error()) {
        return .Some(.Err(array_index->span));
    }

    const is_operand_array = operand_type.const_inner()->is_array();

    if (!operand_type.is_pointer() && !is_operand_array) {
        var operand_str = format::format_sema_type(
            context->allocator,
            context->decl_tables, 
            &operand_type
        );

        diags::report_array_index_on_non_array_operand(
            context->dctx,
            context->allocator,
            operand_str.as_str_const(),
            array_index->span
        );

        operand_str.free();
        return .None;
    }

    const expected_index_type = array_index->index->ty;

    var index_concrete_type: cir::SemaType = .Placeholder;
    switch (analyze_expr(context, array_index->index, expected_index_type)) {
        case .Some(ty) => index_concrete_type = ty;
        case .None => return .None;
    }

    var index_is_plain = false;
    
    if (index_concrete_type.const_inner()->as_plain_type().is_some()) {
        index_is_plain = true;
    }

    if (!index_concrete_type.contains_error() && !index_is_plain) {
        var found_str = format::format_sema_type(
            context->allocator,
            context->decl_tables,
            &index_concrete_type
        );

        diags::report_array_non_integer_index(
            context->dctx,
            context->allocator,
            array_index->span,
            found_str.as_str_const()
        );

        found_str.free();
        return .None;
    }

    const sema_type = array_index->operand->ty.unwrap();

    var element_type: cir::SemaType = .Placeholder;

    if (is_operand_array) {
        const array_type = sema_type.as_array_type().unwrap();
        element_type = *array_type.element_type;
    } else {
        // array index on pointer operand
        element_type = *sema_type.pointer_inner();

        if (element_type.is_void()) {
            diags::report_deref_void_pointer_value(
                context->dctx,
                context->allocator,
                array_index->span
            );
            return .None;
        }
    }

    return .Some(element_type);
}

fn analyze_field_access(
    context: AnalyzerContext*,
    field_access: cir::TypedFieldAccess*
) Option<cir::SemaType> {
    var operand_type: cir::SemaType = .Placeholder;

    switch (analyze_expr(context, field_access->operand, .None)) {
        case .Some(ty) => operand_type = ty;
        case .None => return .None;
    }

    operand_type = expand_sema_type(context, operand_type, field_access->span);

    // Prevent cascading failures
    if (operand_type.contains_error()) {
        const err_ty: cir::SemaType = .Err(field_access->span);
        field_access->ty = .Some(err_ty);
        return .Some(err_ty);
    }

    const pure_operand_type = *operand_type.const_inner()->pointer_inner();
    const named_type_opt = pure_operand_type.as_named_type();

    var type_args = cir::TypedTypeArgs.new(context->allocator);

    switch (named_type_opt) {
        case .Some(named_type) => {
            type_args = named_type.type_args;
        }
        case .None => {
            var op_str = format::format_sema_type(
                context->allocator,
                context->decl_tables,
                &operand_type
            );

            diags::report_object_not_supports_fields(
                context->dctx,
                context->allocator,
                field_access->span,
                op_str.as_str_const()
            );

            op_str.free();
            return .None;
        }
    }

    if (pure_operand_type.as_struct().is_some()) {
        const struct_decl_id = pure_operand_type.as_struct().unwrap();
        const struct_decl = context->decl_tables->structs.get_const(struct_decl_id).unwrap();

        const struct_name = format::format_struct_decl(
            context->allocator,
            context->decl_tables,
            struct_decl
        );
        defer struct_name.free();

        switch (struct_decl->lookup_field(field_access->name.as_str_const())) case .Some(field) else {
            diags::report_object_has_no_field_named(
                context->dctx,
                context->allocator,
                field_access->span,
                struct_name.as_str_const(),
                field_access->name.as_str_const()
            );
            return .None;
        }

        check_field_access(context,
            &operand_type,
            field_access->name.as_str_const(),
            struct_name.as_str_const(),
            field->vis,
            &struct_decl->methods,
            field_access->is_thin_arrow,
            field_access->span
        );

        const field_type = cir::substitute_sema_type_with_type_args(
            context->allocator,
            &field->ty,
            &struct_decl->generic_params,
            &type_args
        );

        switch (normalize_sema_type(context, field_type, field_access->span, 0)) {
            case .Some(field_type) => {
                var field_index: usize = 0;
                for (var i: usize = 0; i < struct_decl->fields.len(); i += 1) {
                    if (struct_decl->fields.get_const(i).unwrap() == field) {
                        field_index = i;
                        break;
                    }
                }

                field_access->ty = .Some(field_type);
                field_access->dispatch = .Struct {
                    struct_decl_id,
                    index: field_index,
                };

                return .Some(field_type);
            }
            case .None => return .None;
        }
    } else if (pure_operand_type.as_union().is_some()) {
        const union_decl_id = pure_operand_type.as_union().unwrap();
        const union_decl = context->decl_tables->unions.get_const(union_decl_id).unwrap();

        const union_name = format::format_union_decl(
            context->allocator,
            context->decl_tables,
            union_decl
        );
        defer union_name.free();

        switch (union_decl->lookup_field(field_access->name.as_str_const())) case .Some(field) else {
            diags::report_object_has_no_field_named(
                context->dctx,
                context->allocator,
                field_access->span,
                union_name.as_str_const(),
                field_access->name.as_str_const()
            );
            return .None;
        }
        

        // Unions are never involved with 
        // visibility violations
        check_field_access(context,
            &operand_type,
            field_access->name.as_str_const(),
            union_name.as_str_const(),
            .Public,
            &union_decl->methods,
            field_access->is_thin_arrow,
            field_access->span
        );

        const field_type = cir::substitute_sema_type_with_type_args(
            context->allocator,
            &field->ty,
            &union_decl->generic_params,
            &type_args
        );

        switch (normalize_sema_type(context, field_type, field_access->span, 0)) {
            case .None => return .None;
            case .Some(field_type) => {
                field_access->ty = .Some(field_type);
                field_access->dispatch = .Union { union_decl_id };

                return .Some(field_type);
            }
        }
    } else {
        const operand_type = field_access->operand->ty.unwrap();

        var type_name = format::format_sema_type(
            context->allocator,
            context->decl_tables,
            &operand_type
        );

        diags::report_object_not_supports_fields(
            context->dctx,
            context->allocator,
            field_access->span,
            type_name.as_str_const()
        );
        
        type_name.free();
        return .None;
    }
}

/* ************* Struct Init ************* */

fn analyze_struct_init(
    context: AnalyzerContext*,
    struct_init: cir::TypedStructInitExpr*,
    expected_type: Option<cir::SemaType>
) Option<cir::SemaType> {
    var operand: cir::SemaType = .Placeholder;
    switch (normalize_and_check_type_formation(context, struct_init->operand, struct_init->span, 0)) {
        case .Some(ty) => operand = ty;
        case .None => return .None;
    }

    operand = expand_sema_type(context, operand, struct_init->span);

    switch (operand.as_named_type()) case .Some(named_type) else {
        var type_name = format::format_sema_type(context->allocator, context->decl_tables, &operand);

        diags::report_non_struct_symbol(
            context->dctx,
            context->allocator,
            struct_init->span,
            type_name.as_str_const()
        );

        type_name.free();
        return .None;
    }

    switch (named_type.type_decl_id.as_struct()) case .Some(struct_decl_id) else {
        var type_name = format::format_sema_type(
            context->allocator,
            context->decl_tables,
            &operand
        );

        diags::report_non_struct_symbol(
            context->dctx,
            context->allocator,
            struct_init->span,
            type_name.as_str_const()
        );

        type_name.free();
        return .None;
    }
    const struct_decl = context->decl_tables->structs.get_const(struct_decl_id).unwrap();

    var struct_name = format::format_struct_decl(context->allocator, context->decl_tables, struct_decl);
    defer struct_name.free();

    const generic_env_opt = create_inference_generic_env(context,
        struct_name.as_str_const(),
        struct_decl->generic_params,
        &named_type.type_args,
        struct_init->span
    );

    switch (generic_env_opt) case .Some(generic_env) else {
        return .None;
    }

    generics::push_generic_env(context, generic_env);
    const result = analyze_struct_init_inner(context,
        struct_init,
        expected_type,
        struct_decl,
        struct_decl_id
    );
    generics::pop_generic_env(context);
    return result;
}

fn analyze_struct_init_inner(
    context: AnalyzerContext*,
    struct_init: cir::TypedStructInitExpr*,
    expected_type: Option<cir::SemaType>,
    struct_decl: const cir::StructDecl*,
    struct_decl_id: cir::StructDeclId
) Option<cir::SemaType> {
    for (var i: usize = 0; i < struct_init->fields.len(); i += 1) {
        const field = struct_init->fields.get(i).unwrap();
        const struct_field = struct_decl->lookup_field(field->name.as_str_const());

        switch (struct_field) {
            case .Some(decl_field) => {
                switch (normalize_sema_type(context, decl_field->ty, field->span, 0)) {
                    case .None => {}
                    case .Some(normalized_type) => {
                        const expected_field_type = generics::substitute_type(context, &normalized_type);
                        analyze_field_assign(context, &field->value, expected_field_type, field->span);
                    }
                }
            }
            case .None => {
                // Unknown field will be reported later
            } 
        }
    }

    check_duplicate_struct_field_init(context, &struct_init->fields);
    check_missing_struct_fields(context, struct_decl, &struct_init->fields, struct_init->span);
    check_invalid_struct_fields(context, struct_decl, &struct_init->fields);

    const inferred_type_args = instantiated_type_args(context, struct_decl->generic_params);

    unify_with_expected_type(context,
        .Named(cir::NamedType {
            type_decl_id: .Struct(struct_decl_id),
            type_args: inferred_type_args,
        }),
        expected_type
    );

    apply_generic_defaults(context, struct_decl->generic_params);

    const final_type_args = instantiated_type_args(context, struct_decl->generic_params);
    const final_type: cir::SemaType = .Named(cir::NamedType {
        type_decl_id: .Struct(struct_decl_id),
        type_args: final_type_args,
    });

    struct_init->operand = final_type;
    return .Some(final_type);
}

fn analyze_unnamed_struct_value(
    context: AnalyzerContext*,
    struct_valueue: cir::TypedUnnamedStructValue*,
    expected_type: Option<cir::SemaType>
) Option<cir::SemaType> {
    // Case 1: If expect type is a struct, 
    // then use its declaration and analyze 
    // fields with expect type.
    var struct_decl_id_opt: Option<cir::StructDeclId> = .None;
    var type_args: cir::TypedTypeArgs = cir::TypedTypeArgs.new(context->allocator);

    switch (expected_type) {
        case .Some(ty) => {
            switch (ty.as_named_type()) {
                case .Some(named_type) => {
                    switch (named_type.type_decl_id.as_struct()) {
                        case .Some(struct_decl_id) => {
                            struct_decl_id_opt = .Some(struct_decl_id);
                            type_args = named_type.type_args;
                        }
                        case .None => {}
                    }
                }
                case .None => {}
            }
        }
        case .None => {}
    }

    switch (struct_decl_id_opt) {
        case .Some(struct_decl_id) => {
            const struct_decl = context->decl_tables->structs.get_const(struct_decl_id).unwrap();

            var struct_name = format::format_struct_decl(context->allocator, context->decl_tables, struct_decl);
            defer struct_name.free();

            const generic_env_opt = create_inference_generic_env(context,
                struct_name.as_str_const(),
                struct_decl->generic_params,
                &type_args,
                struct_valueue->span
            );

            switch (generic_env_opt) case .Some(generic_env) else {
                return .None;
            }

            generics::push_generic_env(context, generic_env);
            const result = analyze_unnamed_struct_value_inner(context,
                struct_valueue,
                expected_type,
                struct_decl,
                struct_decl_id
            );
            generics::pop_generic_env(context);
            return result;
        }
        case .None => {}
    }

    // Case 2: No expect type (Create a new struct decl)
    var struct_decl = create_struct_decl_from_unnamed_struct_value(context, struct_valueue);
    const struct_decl_id = context->decl_tables->insert_struct(struct_decl);

    for (var i: usize = 0; i < struct_valueue->fields.len(); i += 1) {
        const struct_valueue_field = struct_valueue->fields.get(i).unwrap();

        analyze_expr(context, struct_valueue_field->value, .None);

        switch (struct_valueue_field->value->ty) {
            case .Some(rhs_type) => {
                for (var j: usize = 0; j < struct_decl.fields.len(); j += 1) {
                    const struct_field = struct_decl.fields.get(j).unwrap();
                    
                    if (struct_field->name.as_str_const() == struct_valueue_field->name.as_str_const()) {
                        struct_field->ty = rhs_type;
                        break;
                    }
                }
            }
            case .None => {}
        }
    }

    check_duplicate_fields_for_unnamed_struct_value(context, struct_valueue);

    // Write back field types in struct decl
    const struct_decl_ref = context->decl_tables->structs.get(struct_decl_id).unwrap();
    *struct_decl_ref = struct_decl;

    struct_valueue->struct_decl_id = .Some(struct_decl_id);

    return .Some(.Named(cir::NamedType {
        type_decl_id: .Struct(struct_decl_id),
        type_args: cir::TypedTypeArgs.new(context->allocator),
    }));
}

fn analyze_unnamed_struct_value_inner(
    context: AnalyzerContext*,
    struct_valueue: cir::TypedUnnamedStructValue*,
    expected_type: Option<cir::SemaType>,
    struct_decl: const cir::StructDecl*,
    struct_decl_id: cir::StructDeclId
) Option<cir::SemaType> {
    for (var i: usize = 0; i < struct_valueue->fields.len(); i += 1) {
        const struct_valueue_field = struct_valueue->fields.get(i).unwrap();
        const struct_field = struct_decl->lookup_field(struct_valueue_field->name.as_str_const());

        switch (struct_field) {
            case .Some(decl_field) => {
                const expected_field_type = generics::substitute_type(context, &decl_field->ty);

                analyze_field_assign(context,
                    struct_valueue_field->value,
                    expected_field_type,
                    struct_valueue_field->span
                );
            }
            case .None => {
                // Unknown field will be reported later
            }
        }
    }

    check_invalid_struct_fields_for_unnamed_struct_value(context, struct_decl, struct_valueue);
    check_missing_struct_fields_for_unnamed_struct_value(context, struct_decl, struct_valueue);
    check_duplicate_fields_for_unnamed_struct_value(context, struct_valueue);

    struct_valueue->struct_decl_id = .Some(struct_decl_id);

    switch (expected_type) {
        case .Some(ty) => return .Some(ty);
        case .None => return .None;
    }
}

fn create_struct_decl_from_unnamed_struct_value(
    context: AnalyzerContext*,
    struct_valueue: const cir::TypedUnnamedStructValue*
) cir::StructDecl {
    var fields: Vec<cir::TypedStructField> = Vec.new(context->allocator);

    for (var i: usize = 0; i < struct_valueue->fields.len(); i += 1) {
        const field = struct_valueue->fields.get_const(i).unwrap();
        
        fields.push(cir::TypedStructField {
            name: String.from_str(context->allocator, field->name.as_str_const()),
            ty: .Placeholder,
            vis: .Public,
            span: field->span,
        });
    }

    return cir::StructDecl {
        name: .None,
        fields,
        impls: Vec.new(context->allocator),
        methods: cir::MethodDecls.new(context->allocator),
        generic_params: cir::TypedGenericParams.new(context->allocator),
        modifiers: ast::ASTStructModifiers {
            vis: .Public,
            repr_attr: struct_valueue->repr_attr,
        },
        align: struct_valueue->align,
        is_normalized: false,
        span: struct_valueue->span,
    };
}

/* ************* Union Init ************* */

fn analyze_union_init(
    context: AnalyzerContext*,
    union_init: cir::TypedUnionInitExpr*,
    expected_type: Option<cir::SemaType>
) Option<cir::SemaType> {
    var operand: cir::SemaType = .Placeholder;

    switch (normalize_and_check_type_formation(context, union_init->operand, union_init->span, 0)) {
        case .Some(ty) => operand = ty;
        case .None => return .None;
    }

    operand = expand_sema_type(context, operand, union_init->span);

    switch (operand.as_named_type()) case .Some(named_type) else {
        var type_name = format::format_sema_type(
            context->allocator,
            context->decl_tables,
            &operand
        );

        diags::report_non_union_symbol(
            context->dctx,
            context->allocator,
            union_init->span,
            type_name.as_str_const()
        );

        type_name.free();
        return .None;
    }

    switch (named_type.type_decl_id.as_union()) case .Some(union_decl_id) else {
        var type_name = format::format_sema_type(
            context->allocator,
            context->decl_tables,
            &operand
        );

        diags::report_non_union_symbol(
            context->dctx,
            context->allocator,
            union_init->span,
            type_name.as_str_const()
        );

        type_name.free();
        return .None;
    }
    const union_decl = context->decl_tables->unions.get_const(union_decl_id).unwrap();

    var union_name = format::format_union_decl(context->allocator, context->decl_tables, union_decl);
    defer union_name.free();

    const generic_env_opt = create_inference_generic_env(context,
        union_name.as_str_const(),
        union_decl->generic_params,
        &named_type.type_args,
        union_init->span
    );

    switch (generic_env_opt) case .Some(generic_env) else {
        return .None;
    }

    generics::push_generic_env(context, generic_env);
    const result = analyze_union_init_inner(context,
        union_init,
        expected_type,
        union_decl,
        union_decl_id,
        union_name.as_str_const()
    );
    generics::pop_generic_env(context);
    return result;
}

fn analyze_union_init_inner(
    context: AnalyzerContext*,
    union_init: cir::TypedUnionInitExpr*,
    expected_type: Option<cir::SemaType>,
    union_decl: const cir::UnionDecl*,
    union_decl_id: cir::UnionDeclId,
    union_name: const uint8*
) Option<cir::SemaType> {
    const field_opt = union_decl->lookup_field(union_init->field->name.as_str_const());

    switch (field_opt) case .Some(field) else {
        diags::report_object_has_no_field_named(
            context->dctx,
            context->allocator,
            union_init->field->span,
            union_name,
            union_init->field->name.as_str_const()
        );
        return .None;
    }

    const expected_field_type = generics::substitute_type(context, &field->ty);
    analyze_field_assign(context, &union_init->field->value, expected_field_type, union_init->field->span);

    const inferred_type_args = instantiated_type_args(context, union_decl->generic_params);

    unify_with_expected_type(context,
        .Named(cir::NamedType {
            type_decl_id: .Union(union_decl_id),
            type_args: inferred_type_args,
        }),
        expected_type
    );

    apply_generic_defaults(context, union_decl->generic_params);

    const final_type_args = instantiated_type_args(context, union_decl->generic_params);
    const final_type: cir::SemaType = .Named(cir::NamedType {
        type_decl_id: .Union(union_decl_id),
        type_args: final_type_args,
    });

    union_init->operand = final_type;
    return .Some(final_type);
}

fn analyze_unnamed_union_value(
    context: AnalyzerContext*,
    union_valueue: cir::TypedUnnamedUnionValue*,
    expected_type: Option<cir::SemaType>
) Option<cir::SemaType> {
    if (union_valueue->fields.len() != 1) {
        diags::report_union_init_must_contain_exactly_one_field(
            context->dctx,
            context->allocator,
            union_valueue->span
        );
        return .None;
    }

    const field_value = union_valueue->fields.get(0).unwrap();

    var union_decl_id_opt: Option<cir::UnionDeclId> = .None;
    var type_args: cir::TypedTypeArgs = cir::TypedTypeArgs.new(context->allocator);

    switch (expected_type) {
        case .Some(ty) => {
            switch (ty.as_named_type()) {
                case .Some(named_type) => {
                    switch (named_type.type_decl_id.as_union()) {
                        case .Some(union_decl_id) => {
                            union_decl_id_opt = .Some(union_decl_id);
                            type_args = named_type.type_args;
                        }
                        case .None => {}
                    }
                }
                case .None => {}
            }
        }
        case .None => {}
    }

    switch (union_decl_id_opt) {
        case .Some(union_decl_id) => {
            const union_decl = context->decl_tables->unions.get_const(union_decl_id).unwrap();

            var union_name = format::format_union_decl(context->allocator, context->decl_tables, union_decl);
            defer union_name.free();

            const generic_env_opt = create_inference_generic_env(context,
                union_name.as_str_const(),
                union_decl->generic_params,
                &type_args,
                union_valueue->span
            );

            switch (generic_env_opt) case .Some(generic_env) else {
                return .None;
            }

            generics::push_generic_env(context, generic_env);
            const result = analyze_unnamed_union_value_inner(context,
                union_valueue,
                expected_type,
                union_decl,
                union_decl_id,
                field_value
            );
            generics::pop_generic_env(context);
            return result;
        }
        case .None => {}
    }

    // No expect type (Create a new union decl from the field)
    var union_decl = create_union_decl_from_unnamed_union_value(context, field_value);
    const union_decl_id = context->decl_tables->insert_union(union_decl);

    analyze_expr(context, field_value->value, .None);

    switch (field_value->value->ty) {
        case .Some(rhs_type) => {
            for (var j: usize = 0; j < union_decl.fields.len(); j += 1) {
                const field = union_decl.fields.get(j).unwrap();
                
                if (field->name.as_str_const() == field_value->name.as_str_const()) {
                    field->ty = rhs_type;
                    break;
                }
            }
        }
        case .None => {}
    }

    // Write back field types in union decl
    const union_decl_ref = context->decl_tables->unions.get(union_decl_id).unwrap();
    *union_decl_ref = union_decl;

    union_valueue->union_decl_id = .Some(union_decl_id);

    return .Some(.Named(cir::NamedType {
        type_decl_id: .Union(union_decl_id),
        type_args: cir::TypedTypeArgs.new(context->allocator),
    }));
}

fn analyze_unnamed_union_value_inner(
    context: AnalyzerContext*,
    union_valueue: cir::TypedUnnamedUnionValue*,
    expected_type: Option<cir::SemaType>,
    union_decl: const cir::UnionDecl*,
    union_decl_id: cir::UnionDeclId,
    union_field_value: cir::TypedUnnamedUnionValueField*
) Option<cir::SemaType> {
    const union_field = union_decl->lookup_field(union_field_value->name.as_str_const());
    switch (union_field) {
        case .Some(uf) => {
            const expected_field_type = generics::substitute_type(context, &uf->ty);
            analyze_field_assign(context, union_field_value->value, expected_field_type, union_valueue->span);
        }
        case .None => {
            var type_name = format::format_union_decl(
                context->allocator, 
                context->decl_tables, 
                union_decl
            );

            diags::report_object_has_no_field_named(
                context->dctx,
                context->allocator,
                union_valueue->span,
                type_name.as_str_const(),
                union_field_value->name.as_str_const()
            );

            type_name.free();
            analyze_expr(context, union_field_value->value, .None);
        }
    }

    union_valueue->union_decl_id = .Some(union_decl_id);

    switch (expected_type) {
        case .Some(ty) => return .Some(ty);
        case .None => return .None;
    }
}

fn create_union_decl_from_unnamed_union_value(
    context: AnalyzerContext*,
    union_field_value: const cir::TypedUnnamedUnionValueField*
) cir::UnionDecl {
    var fields: Vec<cir::TypedUnionField> = Vec.new(context->allocator);
    
    fields.push(cir::TypedUnionField {
        name: String.from_str(context->allocator, union_field_value->name.as_str_const()),
        ty: .Placeholder,
        span: union_field_value->span,
    });

    return cir::UnionDecl {
        name: .None,
        fields,
        impls: Vec.new(context->allocator),
        methods: cir::MethodDecls.new(context->allocator),
        generic_params: cir::TypedGenericParams.new(context->allocator),
        modifiers: ast::ASTUnionModifiers {
            vis: .Public,
            repr_attr: .None,
        },
        align: .None,
        is_normalized: false,
        span: union_field_value->span,
    };
}

/* ************* Builtins ************* */

fn analyze_builtin_expr(
    context: AnalyzerContext*,
    builtin_func: cir::TypedBuiltinFunc*
) Option<cir::SemaType> {
    switch (cir::lookup_builtin(builtin_func->name.str.as_str_const())) case .Some(builtin_kind) else {
        diags::report_builtin_not_defined(
            context->dctx,
            context->allocator,
            builtin_func->span,
            builtin_func->name.str.as_str_const()
        );
        return .None;
    }

    const builtin_spec = cir::builtin_spec_of(builtin_kind);

    if (!check_builtin_form(context, builtin_spec, .Expr, builtin_func->span)) {
        return .None;
    }

    if (!check_builtin_arg_count(context, builtin_spec, builtin_func->args.len(), builtin_func->span)) {
        return .None;
    }

    return analyze_builtin_func_semantics(context, builtin_kind, builtin_func);
}

fn analyze_builtin_block(
    context: AnalyzerContext*,
    builtin_block: cir::TypedBuiltinBlock*,
    is_toplevel: bool
) flow::FlowState {
    switch (cir::lookup_builtin(
        builtin_block->name.str.as_str_const()
    )) case .Some(builtin_kind) else {
        diags::report_builtin_not_defined(
            context->dctx,
            context->allocator,
            builtin_block->span,
            builtin_block->name.str.as_str_const()
        );
        return .Reachable;
    }

    const builtin_spec = cir::builtin_spec_of(builtin_kind);

    if (!check_builtin_form(context, builtin_spec, .Stmt, builtin_block->span)) {
        return .Reachable;
    }

    builtin_block->is_toplevel = .Some(is_toplevel);

    if (is_toplevel) {
        analyze_toplevel_stmts(context, &builtin_block->block->stmts);
        return .Reachable;
    } else {
        return analyze_block_stmt(context, builtin_block->block);
    }
}

fn analyze_builtin_func_semantics(
    context: AnalyzerContext*,
    builtin_kind: cir::TypedBuiltinKind,
    builtin_func: cir::TypedBuiltinFunc*
) Option<cir::SemaType> {
    switch (builtin_kind) {
        case .FuncName | .MethodName | .ModuleName | .FileName => {
            return analyze_builtin_name_ret(context, builtin_func);
        }
        case .Line | .Column => {
            return analyze_builtin_usize_ret(context, builtin_func);
        }
        case .Panic | .Todo | .Unimplemented | .Unreachable => {
            return analyze_builtin_const_msg_arg(context, builtin_func);
        }
        case .Memcpy => return analyze_builtin_copy_memset(context, builtin_func, true);
        case .Memset => return analyze_builtin_copy_memset(context, builtin_func, false);
        case .OffsetOf => return analyze_builtin_offsetof(context, builtin_func);
        case .AlignOf => return analyze_builtin_alignof(context, builtin_func);
        case .SizeOf => return analyze_builtin_sizeof(context, builtin_func);
        case .TypeOf => return analyze_builtin_typeof(context, builtin_func);
        case .Assert => return analyze_builtin_assert(context, builtin_func);
        case .Cast => return analyze_builtin_cast(context, builtin_func);
        
        else => return .None;
    }
}

fn analyze_builtin_name_ret(
    context: AnalyzerContext*,
    builtin_func: cir::TypedBuiltinFunc*
) Option<cir::SemaType> {
    const uint8_type: cir::SemaType = .Plain(.UInt8);
    const ret_type: cir::SemaType = .Pointer(alloc_init(context->allocator, uint8_type));
    builtin_func->ret_type = .Some(ret_type);
    return .Some(ret_type);
}

fn analyze_builtin_usize_ret(
    context: AnalyzerContext*,
    builtin_func: cir::TypedBuiltinFunc*
) Option<cir::SemaType> {
    const ret_type: cir::SemaType = .Plain(.USize);
    builtin_func->ret_type = .Some(ret_type);
    return .Some(ret_type);
}

fn analyze_builtin_sizeof(
    context: AnalyzerContext*,
    builtin_func: cir::TypedBuiltinFunc*
) Option<cir::SemaType> {
    const operand = builtin_func->args.get(0).unwrap();

    if (analyze_expr_non_terminal(context, operand, .None).is_none()) {
        return .None;
    }

    switch (operand->ty) {
        case .Some(ty) => {
            var ty = expand_sema_type(context, ty, builtin_func->span);
            ty = generics::substitute_type(context, &ty);

            if (!check_type_arity(context, ty, builtin_func->span)) {
                return .None;
            }

            operand->ty = .Some(ty);
        }
        case .None => {}
    }

    const ret_type: cir::SemaType = .Plain(.USize);
    builtin_func->ret_type = .Some(ret_type);
    return .Some(ret_type);
}

fn analyze_builtin_alignof(
    context: AnalyzerContext*,
    builtin_func: cir::TypedBuiltinFunc*
) Option<cir::SemaType> {
    const operand = builtin_func->args.get(0).unwrap();

    analyze_expr_non_terminal(context, operand, .None);

    switch (operand->ty) {
        case .Some(ty) => {
            var ty_ = expand_sema_type(context, ty, builtin_func->span);
            ty_ = generics::substitute_type(context, &ty_);
            operand->ty = .Some(ty_);
        }
        case .None => {}
    }

    const ret_type: cir::SemaType = .Plain(.USize);
    builtin_func->ret_type = .Some(ret_type);
    return .Some(ret_type);
}

fn analyze_builtin_typeof(
    context: AnalyzerContext*,
    builtin_func: cir::TypedBuiltinFunc*
) Option<cir::SemaType> {
    const operand = builtin_func->args.get(0).unwrap();

    analyze_expr_non_terminal(context, operand, .None);

    switch (operand->ty) {
        case .Some(ty) => {
            if (!check_type_arity(context, ty, builtin_func->span)) {
                return .None;
            }

            return .Some(ty);
        }
        case .None => return .None;
    }
}

fn analyze_builtin_offsetof(
    context: AnalyzerContext*,
    builtin_func: cir::TypedBuiltinFunc*
) Option<cir::SemaType> {
    for (var i: usize = 0; i < builtin_func->args.len(); i += 1) {
        const arg = builtin_func->args.get(i).unwrap();
        analyze_expr_non_terminal(context, arg, .None);
    }

    const type_expr = builtin_func->args.get(0).unwrap();
    const field_name_expr = builtin_func->args.get(1).unwrap();

    var ty: cir::SemaType = .Placeholder;

    switch (type_expr->ty) {
        case .Some(ty_) => ty = ty_;
        case .None => return .None;
    }

    ty = expand_sema_type(context, ty, builtin_func->span);
    ty = generics::substitute_type(context, &ty);

    if (!ty.is_struct()) {
        var type_name = format::format_sema_type(context->allocator, context->decl_tables, &ty);

        diags::report_invalid_offset_of_operand(
            context->dctx,
            context->allocator,
            builtin_func->span,
            type_name.as_str_const()
        );

        type_name.free();
        return .None;
    }

    switch (field_name_expr->literal_const_string_value()) case .Some(field_name) else {
        diags::report_offset_of_field_must_be_string(
            context->dctx,
            context->allocator,
            builtin_func->span
        );
        return .None;
    }

    switch (ty.as_struct()) case .Some(struct_decl_id) else {
        return .None;
    }

    const struct_decl = context->decl_tables->structs.get_const(struct_decl_id).unwrap();
    
    var struct_name = format::format_struct_decl(
        context->allocator, 
        context->decl_tables, 
        struct_decl
    );
    defer struct_name.free();

    var field_exists = false;

    for (var j: usize = 0; j < struct_decl->fields.len(); j += 1) {
        const field = struct_decl->fields.get_const(j).unwrap();

        if (field->name.as_str_const() == field_name) {
            field_exists = true;
            break;
        }
    }

    if (!field_exists) {
        diags::report_object_has_no_field_named(
            context->dctx,
            context->allocator,
            builtin_func->span,
            struct_name.as_str_const(),
            field_name
        );
        return .None;
    }

    const ret_type: cir::SemaType = .Plain(.USize);
    builtin_func->ret_type = .Some(ret_type);
    return .Some(ret_type);
}

fn analyze_builtin_cast(
    context: AnalyzerContext*,
    builtin_func: cir::TypedBuiltinFunc*
) Option<cir::SemaType> {
    const type_arg = builtin_func->args.get(0).unwrap();
    const value_arg = builtin_func->args.get(1).unwrap();

    analyze_expr_non_terminal(context, type_arg, .None);
    analyze_expr(context, value_arg, .None);

    switch (type_arg->kind.as_type_expr(context->allocator)) case .Some(var target_type) else {
        diags::report_builtin_cast_requires_type_argument(
            context->dctx,
            context->allocator,
            builtin_func->span
        );
        return .None;
    }

    switch (type_arg->kind) {
        case .SemaType { .. } => {
            switch (type_arg->ty) {
                case .Some(ty) => {
                    target_type = ty;
                }
                case .None => {}
            }
        }
        else => {}
    }

    target_type = expand_sema_type(context, target_type, builtin_func->span);
    target_type = generics::substitute_type(context, &target_type);

    var value_type: cir::SemaType = .Placeholder;

    switch (value_arg->ty) {
        case .Some(ty) => value_type = ty;
        case .None => return .None;
    }

    value_type = expand_sema_type(context, value_type, builtin_func->span);

    if (!is_explicit_cast_allowed(context, value_type, target_type, builtin_func->span)) {
        var value_type_str = format::format_sema_type(context->allocator, context->decl_tables, &value_type);
        var target_type_str = format::format_sema_type(context->allocator, context->decl_tables, &target_type);

        diags::report_cannot_cast(
            context->dctx,
            context->allocator,
            builtin_func->span,
            value_type_str.as_str_const(),
            target_type_str.as_str_const()
        );

        value_type_str.free();
        target_type_str.free();
        return .None;
    }

    // Update analyzed type argument
    type_arg->kind = .SemaType {
        ty: target_type,
        span: builtin_func->span,
    };
    type_arg->ty = .Some(target_type);
    builtin_func->ret_type = .Some(target_type);
    return .Some(target_type);
}

fn analyze_builtin_copy_memset(
    context: AnalyzerContext*,
    builtin_func: cir::TypedBuiltinFunc*,
    is_memcpy: bool
) Option<cir::SemaType> {
    for (var i: usize = 0; i < builtin_func->args.len(); i += 1) {
        const expect = builtin_copy_memset_param_type(context, is_memcpy, i);
        const arg = builtin_func->args.get(i).unwrap();
        
        analyze_expr_non_terminal(context, arg, .Some(expect));
    }

    for (var i: usize = 0; i < builtin_func->args.len(); i += 1) {
        const expect = builtin_copy_memset_param_type(context, is_memcpy, i);
        const arg = builtin_func->args.get(i).unwrap();
        
        switch (arg->ty) {
            case .Some(arg_type) => {
                if (!is_assignable_to(context, arg_type, expect, builtin_func->span)) {
                    diags::report_builtin_param_mismatch(
                        context->dctx, 
                        context->allocator, 
                        context->decl_tables,
                        builtin_func, 
                        i, 
                        &arg_type, 
                        &expect
                    );
                    return .None;
                }
            }
            case .None => return .None;
        }
    }

    const ret_type: cir::SemaType = .Plain(.Void);
    builtin_func->ret_type = .Some(ret_type);
    return .Some(ret_type);
}

fn analyze_builtin_const_msg_arg(
    context: AnalyzerContext*,
    builtin_func: cir::TypedBuiltinFunc*
) Option<cir::SemaType> {
    const expect = builtin_const_mesg_param_type(context);

    for (var i: usize = 0; i < builtin_func->args.len(); i += 1) {
        const arg = builtin_func->args.get(i).unwrap();
        analyze_expr_non_terminal(context, arg, .Some(expect));
    }

    for (var i: usize = 0; i < builtin_func->args.len(); i += 1) {
        const arg = builtin_func->args.get(i).unwrap();

        switch (arg->ty) {
            case .Some(arg_type) => {
                if (!is_assignable_to(context, arg_type, expect, builtin_func->span)) {
                    diags::report_builtin_param_mismatch(
                        context->dctx, 
                        context->allocator, 
                        context->decl_tables, 
                        builtin_func, 
                        i,
                        &arg_type, 
                        &expect
                    );
                    return .None;
                }
            }
            case .None => return .None;
        }
    }

    const ret_type: cir::SemaType = .Plain(.Void);
    builtin_func->ret_type = .Some(ret_type);
    return .Some(ret_type);
}

fn analyze_builtin_assert(
    context: AnalyzerContext*,
    builtin_func: cir::TypedBuiltinFunc*
) Option<cir::SemaType> {
    if (builtin_func->args.len() > 0) {
        const cond = builtin_func->args.get(0).unwrap();
        analyze_cond_expr(context, cond);
    }

    if (builtin_func->args.len() > 1) {
        const msg = builtin_func->args.get(1).unwrap();
        const expect = builtin_const_mesg_param_type(context);

        analyze_expr_non_terminal(context, msg, .Some(expect));

        switch (msg->ty) {
            case .Some(arg_type) => {
                if (!is_assignable_to(context, arg_type, expect, builtin_func->span)) {
                    diags::report_builtin_param_mismatch(
                        context->dctx, 
                        context->allocator, 
                        context->decl_tables, 
                        builtin_func, 
                        1, 
                        &arg_type, 
                        &expect
                    );
                    return .None;
                }
            }
            case .None => return .None;
        }

        if (msg->literal_const_string_value().is_none()) {
            diags::report_assert_message_must_be_const_string_literal(
                context->dctx,
                context->allocator,
                builtin_func->span
            );
            return .None;
        }
    }

    const ret_type: cir::SemaType = .Plain(.Void);
    builtin_func->ret_type = .Some(ret_type);
    return .Some(ret_type);
}

/* ************* Inline ASM ************* */

fn analyze_inline_asm_expr(
    context: AnalyzerContext*,
    asm: cir::TypedInlineAsm*
) Option<cir::SemaType> {
    check_asm_template(context, asm);
    check_asm_outputs(context, asm);
    check_asm_inputs(context, asm);
    check_asm_clobbers(context, asm);
    check_asm_template_indices(context, asm);
    check_asm_constraint_types(context, asm);

    switch (asm->outputs.len()) {
        case 0 => {
            return .Some(cir::SemaType.Plain(.Void));
        }
        case 1 => {
            const operand = asm->outputs.get(0).unwrap();

            switch (operand->expr->ty) {
                case .Some(ty) => return .Some(ty);
                case .None => return .None;
            }
        }
        else => {
            var elements: Vec<cir::TypedTupleElement> = Vec.new(context->allocator);

            for (var i: usize = 0; i < asm->outputs.len(); i += 1) {
                const operand = asm->outputs.get_const(i).unwrap();

                switch (operand->expr->ty) {
                    case .Some(ty) => {
                        elements.push(cir::TypedTupleElement {
                            ty,
                            span: operand->span,
                        });
                    }
                    case .None => {
                        return .None;
                    }
                }
            }

            const ret_type: cir::SemaType = .Tuple(cir::TypedTupleType {
                elements,
                span: asm->span,
            });
            return .Some(ret_type);
        }
    }
}

fn analyze_inline_asm_stmt(
    context: AnalyzerContext*,
    asm: cir::TypedInlineAsm*
) {
    check_asm_template(context, asm);
    check_asm_outputs(context, asm);
    check_asm_inputs(context, asm);
    check_asm_clobbers(context, asm);
    check_asm_template_indices(context, asm);
    check_asm_constraint_types(context, asm);
}

/* ************* Calls ************* */

fn analyze_func_call(
    context: AnalyzerContext*,
    func_call: cir::TypedFuncCall*
) Option<cir::SemaType> {
    var func_decl_id_opt: Option<cir::FuncDeclId> = .None;

    switch (func_call->operand->kind.as_unresolved_symbol_id()) {
        case .Some(symbol_id) => {
            switch (context->registry->lookup_symbol_as_decl_id(symbol_id)) {
                case .Some(decl_id) => func_decl_id_opt = decl_id.as_func();
                case .None => {}
            }
        }
        case .None => {}
    }

    if (func_decl_id_opt.is_none()) {
        switch (func_call->operand->kind.as_resolved_decl_id()) {
            case .Some(decl_id) => {
                func_decl_id_opt = decl_id.as_func();
            }
            case .None => {}
        }
    }

    var operand_type: cir::SemaType = .Placeholder;

    switch (analyze_expr_non_terminal(context, func_call->operand, .None)) {
        case .Some(ty) => operand_type = ty;
        case .None => return .None;
    }

    operand_type = expand_sema_type(context, operand_type, func_call->span);

    // Prevent cascading failures
    if (operand_type.contains_error()) {
        return .Some(.Err(func_call->span));
    }

    normalize_type_args(context, &func_call->type_args, 0);

    switch (operand_type.as_func_type()) case .Some(var func_type) else {
        var type_name = format::format_sema_type(context->allocator, context->decl_tables, &operand_type);
        
        diags::report_non_function_symbol(
            context->dctx, 
            context->allocator, 
            func_call->span, 
            type_name.as_str_const()
        );
        
        type_name.free();
        return .None;
    }

    switch (func_decl_id_opt) {
        // Named function call
        case .Some(func_decl_id) => {
            var func_decl = context->decl_tables->funcs.get_owned(func_decl_id).unwrap();
            
            func_decl.params = clone::clone_func_params(context->allocator, &func_decl.params);
            
            var original_params = clone::clone_func_params(context->allocator, &func_decl.params);

            if (func_decl.is_generic()) {
                const decl_id: cir::DeclId = .Func(func_decl_id);
                
                var type_name = format::format_decl_name(
                    context->allocator, 
                    context->decl_tables, 
                    &decl_id
                );
                defer type_name.free();
                
                const generic_env_opt = create_inference_generic_env(context,
                    type_name.as_str_const(),
                    func_decl.generic_params,
                    &func_call->type_args,
                    func_call->span
                );

                switch (generic_env_opt) {
                    case .Some(env) => {
                        generics::push_generic_env(context, env);
                        const result = analyze_func_call_generic(context,
                            &operand_type,
                            func_call,
                            func_decl_id,
                            &func_decl,
                            &original_params
                        );
                        generics::pop_generic_env(context);
                        return result;
                    }
                    case .None => return .None;
                }
            } else {
                normalize_func_params(context, &func_decl.params, false, 0);

                if (!analyze_call(
                    context, 
                    &original_params, 
                    &func_decl, 
                    &func_call->args,
                    func_call->span,
                    false
                )) {
                    return .None;
                }

                func_call->dispatch = .Normal { func_decl_id };
                return .Some(func_decl.ret_type);
            }
        }
        // Lambda call
        case .None => {
            if (!func_call->type_args.is_empty()) {
                var type_name = format::format_sema_type(
                    context->allocator,
                    context->decl_tables,
                    &operand_type
                );
                
                diags::report_unexpected_type_args(
                    context->dctx, 
                    context->allocator, 
                    func_call->span, 
                    type_name.as_str_const()
                );

                type_name.free();
            }

            normalize_func_type_params(context, &func_type.params, func_call->span, 0);

            switch (normalize_and_check_type_formation(
                context, 
                *func_type.ret_type, 
                func_call->span, 
                0
            )) {
                case .Some(ty) => {
                    func_type.ret_type = alloc_init(context->allocator, ty);
                }
                case .None => {
                    return .None;
                }
            }

            switch (check_func_type_call(
                context, 
                &func_type, 
                &func_call->args, 
                func_call->span
            )) {
                case .Some(ty) => {
                    func_call->dispatch = .FunctionPointer { func_type };
                    return .Some(ty);
                }
                case .None => {
                    return .None;
                }
            }
        }
    }
}

fn analyze_func_call_generic(
    context: AnalyzerContext*,
    operand_type: const cir::SemaType*,
    func_call: cir::TypedFuncCall*,
    func_decl_id: cir::FuncDeclId,
    func_decl: cir::FuncDecl*,
    original_params: const cir::TypedFuncParams*
) Option<cir::SemaType> {
    normalize_func_params(context, &func_decl->params, false, 0);

    if (!analyze_call(
        context, 
        original_params, 
        func_decl, 
        &func_call->args,
         func_call->span, false)) {
        return .None;
    }

    const final_type_args = instantiated_type_args(
        context,
        func_decl->generic_params
    );

    const func_type = cir::func_decl_as_func_type(
        context->allocator,
        func_decl
    );

    var new_env = create_func_def_env(
        context, 
        func_decl->name.as_str_const(), 
        func_type, 
        context->func_env.infer
    );
    var old_env = context->func_env;
    context->func_env = new_env;

    // FIXME
    // NOTE: swapping func_env by value; new_env's heap infer/name leak
    // (shared infer pointer would double-free if FuncEnv.free were called).
    const ret_type = monomorphize_generic_func_call(
        context,
        operand_type,
        func_call,
        func_decl_id,
        func_decl,
        &final_type_args
    );

    context->func_env = old_env;
    return ret_type;
}

fn analyze_method_call(
    context: AnalyzerContext*,
    method_call: cir::TypedMethodCall*,
    expected_type: Option<cir::SemaType>
) Option<cir::SemaType> {
    if (analyze_expr_non_terminal(context, method_call->operand, .None).is_none()) {
        return .None;
    }

    normalize_type_args(context, &method_call->type_args, 0);

    // Operand type is only present when
    // the operand is a generic enum decl.
    // Extract the `decl_id` manually when
    // the operand kind is a `TypedSymbolExpr`.

    var is_operand_instance = true;
    var operand_type_opt: Option<cir::SemaType> = .None;

    switch (method_call->operand->kind.as_resolved_decl_id()) {
        case .Some(decl_id) => {
            switch (decl_id.as_type_decl_id()) {
                // Operand of a static method call
                case .Some(type_decl_id) => {
                    is_operand_instance = false;

                    operand_type_opt = .Some(.Named(cir::NamedType {
                        type_decl_id,
                        type_args: cir::TypedTypeArgs.new(context->allocator),
                    }));
                }
                case .None => {
                    is_operand_instance = true;

                    if (decl_id.is_var_or_global_var()) {
                        // Extract variable type and use it as operand type
                        // for instance method calls
                        switch (type_of_decl(context, decl_id, method_call->span, 0)) {
                            case .Some(ty) => operand_type_opt = .Some(ty);
                            case .None => return .None;
                        }
                    }
                }
            }
        }
        case .None => {
            switch (method_call->operand->kind.as_type_expr(context->allocator)) {
                case .Some(sema_type) => {
                    is_operand_instance = false;
                    operand_type_opt = .Some(sema_type);
                }
                case .None => {
                    switch (method_call->operand->ty) {
                        case .Some(ty) => operand_type_opt = .Some(ty);
                        case .None => {}
                    }
                }
            }
        }
    }

    var operand_type: cir::SemaType = .Placeholder;

    switch (operand_type_opt) {
        case .Some(ty) => {
            operand_type = ty;
        }
        case .None => {
            switch (method_call->operand->ty) {
                case .Some(ty) => {
                    var type_name = format::format_sema_type(
                        context->allocator, 
                        context->decl_tables, 
                        &ty
                    );
                    
                    diags::report_object_not_supports_methods(
                        context->dctx,
                        context->allocator,
                        method_call->span,
                        type_name.as_str_const()
                    );

                    type_name.free();
                    return .None;
                }
                case .None => return .None;
            }
        }
    }

    switch (normalize_sema_type(context, operand_type, method_call->span, 0)) {
        case .Some(normalized_type) => operand_type = normalized_type;
        case .None => return .None;
    }

    operand_type = expand_sema_type(context, operand_type, method_call->span);

    // Prevent cascading failures
    if (operand_type.contains_error()) {
        return .Some(.Err(method_call->span));
    }

    const is_operand_interface = 
        operand_type.as_interface_object().is_some() ||
        operand_type.is_interface();

    if (is_operand_instance) {
        return analyze_instance_method_call(context, method_call, &operand_type, expected_type);
    } else if (is_operand_interface) {
        return analyze_interface_method_call(context, method_call, &operand_type, expected_type);
    } else {
        return analyze_static_method_call(context, method_call, &operand_type, expected_type);
    }
}

fn analyze_instance_method_call(
    context: AnalyzerContext*,
    method_call: cir::TypedMethodCall*,
    operand_type: const cir::SemaType*,
    expected_type: Option<cir::SemaType>
) Option<cir::SemaType> {
    const pure_operand_type = *operand_type->const_inner()->pointer_inner();

    const is_interface = 
        pure_operand_type.is_interface_object() ||
        pure_operand_type.as_named_interface().is_some();

    if (is_interface) {
        return analyze_interface_method_call(context, method_call, operand_type, expected_type);
    }

    var type_decl_id_opt: Option<cir::TypeDeclId> = .None;
    var method_decls_opt: Option<const cir::MethodDecls*> = .None;
    
    switch (pure_operand_type.as_named_type()) {
        case .Some(named_type) => {
            switch (method_decls_of_named_type(context->decl_tables, &named_type)) {
                case .Some(method_decls) => {
                    type_decl_id_opt = .Some(named_type.type_decl_id);
                    method_decls_opt = .Some(method_decls);
                }
                case .None => {}
            }
        }
        case .None => {}
    }

    if (type_decl_id_opt.is_none()) {
        switch (method_call->operand->ty) {
            case .Some(ty) => {
                var type_name = format::format_sema_type(context->allocator, context->decl_tables, &ty);
                
                diags::report_object_not_supports_methods(
                    context->dctx,
                    context->allocator,
                    method_call->span,
                    type_name.as_str_const()
                );

                type_name.free();
            }
            case .None => {}
        }
        return .None;
    }

    analyze_expr(context, method_call->operand, .None);

    const is_operand_const_qualified =
        is_const_qualified_lvalue(context, method_call->operand);

    return analyze_method_call_internal(context,
        method_call,
        method_decls_opt.unwrap(),
        type_decl_id_opt.unwrap(),
        *operand_type,
        true,
        false,
        is_operand_const_qualified,
        expected_type
    );
}

fn analyze_static_method_call(
    context: AnalyzerContext*,
    method_call: cir::TypedMethodCall*,
    operand_type: const cir::SemaType*,
    expected_type: Option<cir::SemaType>
) Option<cir::SemaType> {
    const pure_operand_type = *operand_type->const_inner()->pointer_inner();

    var type_decl_id_opt: Option<cir::TypeDeclId> = .None;
    var method_decls_opt: Option<const cir::MethodDecls*> = .None;
    
    switch (pure_operand_type.as_named_type()) {
        case .Some(named_type) => {
            switch (method_decls_of_named_type(context->decl_tables, &named_type)) {
                case .Some(method_decls) => {
                    type_decl_id_opt = .Some(named_type.type_decl_id);
                    method_decls_opt = .Some(method_decls);
                }
                case .None => {}
            }
        }
        case .None => {}
    }

    if (type_decl_id_opt.is_none()) {
        switch (method_call->operand->ty) {
            case .Some(ty) => {
                var operand_str = format::format_sema_type(
                    context->allocator,
                    context->decl_tables,
                    &ty
                );
                
                diags::report_object_not_supports_methods(
                    context->dctx,
                    context->allocator,
                    method_call->span,
                    operand_str.as_str_const()
                );

                operand_str.free();
            }
            case .None => {}
        }
        return .None;
    }

    return analyze_method_call_internal(context,
        method_call,
        method_decls_opt.unwrap(),
        type_decl_id_opt.unwrap(),
        *operand_type,
        false,
        false,
        false,
        expected_type
    );
}

fn analyze_method_call_internal(
    context: AnalyzerContext*,
    method_call: cir::TypedMethodCall*,
    method_decls: const cir::MethodDecls*,
    type_decl_id: cir::TypeDeclId,
    var operand_type: cir::SemaType,
    is_instance_method_call: bool,
    is_interface_method_call: bool,
    is_operand_const_qualified: bool,
    expected_type: Option<cir::SemaType>
) Option<cir::SemaType> {
    var pure_operand_type: cir::SemaType = *operand_type.const_inner()->pointer_inner();

    var object_name = format::format_type_decl_name(context->allocator, context->decl_tables, type_decl_id);
    defer object_name.free();
    
    switch (method_decls->get(method_call->name.as_str_const())) case .Some(method_decl_id) else {
        diags::report_object_method_not_defined(
            context->dctx,
            context->allocator,
            method_call->span,
            object_name.as_str_const(),
            method_call->name.as_str_const()
        );
        return .None;
    }

    var operand_generic_params: cir::TypedGenericParams = cir::TypedGenericParams.new(context->allocator);
    var operand_type_args: cir::TypedTypeArgs = cir::TypedTypeArgs.new(context->allocator);

    switch (pure_operand_type.as_named_type()) {
        case .Some(named_type) => {
            operand_generic_params = *tables::type_decl_generic_params(
                context->decl_tables, 
                named_type.type_decl_id
            );
            operand_type_args = named_type.type_args;
        }
        case .None => {}
    }

    var type_name = format::format_sema_type(context->allocator, context->decl_tables, &operand_type);
    
    const operand_generic_env_opt = create_inference_generic_env(context,
        type_name.as_str_const(),
        operand_generic_params,
        &operand_type_args,
        method_call->span
    );

    type_name.free();

    switch (operand_generic_env_opt) case .Some(operand_generic_env) else {
        return .None;
    }

    var method_decl = context->decl_tables->methods.get_owned(method_decl_id).unwrap();

    method_decl.func_decl.params = clone::clone_func_params(
        context->allocator, 
        &method_decl.func_decl.params
    );

    var original_params = clone::clone_func_params(
        context->allocator,
        &method_decl.func_decl.params
    );

    if (method_decl.is_instance_method() && !is_instance_method_call) {
        diags::report_instance_method_call_on_type(
            context->dctx,
            context->allocator,
            method_call->span,
            method_decl.func_decl.name.as_str_const()
        );
        return .None;
    }

    if (!method_decl.is_instance_method() && is_instance_method_call) {
        diags::report_static_method_call_on_instance(
            context->dctx,
            context->allocator,
            method_call->span,
            method_decl.func_decl.name.as_str_const()
        );
        return .None;
    }

    const method_generic_params = method_decl.func_decl.generic_params;

    const method_generic_env_opt = create_inference_generic_env(context,
        method_call->name.as_str_const(),
        method_generic_params,
        &method_call->type_args,
        method_call->span
    );

    switch (method_generic_env_opt) case .Some(method_generic_env) else {
        return .None;   
    }

    var generic_env = operand_generic_env.merge(&method_generic_env);
    
    const is_generic_method_call = !generic_env.params.is_empty();

    generics::push_generic_env(context, generic_env);
    const result = analyze_method_call_with_env(context,
        method_call,
        method_decl_id,
        &method_decl,
        &original_params,
        method_decls,
        &operand_type,
        &pure_operand_type,
        operand_generic_params,
        method_generic_params,
        object_name.as_str_const(),
        type_decl_id,
        is_instance_method_call,
        is_interface_method_call,
        is_operand_const_qualified,
        is_generic_method_call,
        expected_type
    );
    generics::pop_generic_env(context);
    return result;
}

fn analyze_method_call_with_env(
    context: AnalyzerContext*,
    method_call: cir::TypedMethodCall*,
    method_decl_id: cir::MethodDeclId,
    method_decl: cir::MethodDecl*,
    original_params: const cir::TypedFuncParams*,
    method_decls: const cir::MethodDecls*,
    operand_type: cir::SemaType*,
    pure_operand_type: cir::SemaType*,
    operand_generic_params: cir::TypedGenericParams,
    method_generic_params: cir::TypedGenericParams,
    object_name: const uint8*,
    type_decl_id: cir::TypeDeclId,
    is_instance_method_call: bool,
    is_interface_method_call: bool,
    is_operand_const_qualified: bool,
    is_generic_method_call: bool,
    expected_type: Option<cir::SemaType>
) Option<cir::SemaType> {
    var object = context->func_env.current_object;
    context->func_env.current_object = .None;
    normalize_func_params(context, &method_decl->func_decl.params, true, 0);
    context->func_env.current_object = object;

    if (!analyze_call(context,
        original_params,
        &method_decl->func_decl,
        &method_call->args,
        method_call->span,
        is_instance_method_call
    )) {
        return .None;
    }

    check_method_call(context,
        operand_type,
        method_decl,
        method_decls,
        object_name,
        method_call->is_thin_arrow,
        is_interface_method_call,
        is_operand_const_qualified,
        method_call->span
    );

    const inferred_type_args = instantiated_type_args(context, operand_generic_params);

    unify_with_expected_type(context,
        .Named(cir::NamedType { type_decl_id, type_args: inferred_type_args }),
        expected_type
    );

    // Apply defaults for generics
    apply_generic_defaults(context, method_generic_params);
    apply_generic_defaults(context, operand_generic_params);

    // Instantiate operand type with collected type args
    *operand_type = generics::substitute_type(context, operand_type);

    if (set_operand_named_type_args(context, operand_type, operand_generic_params)) {
        *pure_operand_type = *operand_type->const_inner()->pointer_inner();
    }

    const final_generics_params = cir::extend_generic_params(
        context->allocator,
        &method_generic_params,
        &operand_generic_params
    );

    const final_type_args = instantiated_type_args(context, final_generics_params);

    method_call->type_args = final_type_args;

    if (is_generic_method_call) {
        const func_type = cir::func_decl_as_func_type(context->allocator, &method_decl->func_decl);

        var new_env = create_method_env(context, method_decl_id, func_type, context->func_env.infer);
        var old_env = context->func_env;
        context->func_env = new_env;

        // Substitute Self inside the context modifier
        switch (method_decl->func_decl.params.list.first()) {
            case .Some(first_kind) => {
                switch (*first_kind) {
                    case .SelfModifier(var self_modifier) => {
                        self_modifier.ty = generics::substitute_self_type(
                            context, 
                            &self_modifier.ty, 
                            pure_operand_type
                        );

                        // Write back the updated context modifier
                        *first_kind = .SelfModifier(self_modifier);
                    }
                    else => {}
                }
            }
            case .None => {}
        }

        var old_object = context->func_env.current_object;
        
        context->func_env.current_object = .Some(*pure_operand_type);

        const result = finalize_generic_method_call(context,
            method_call,
            method_decl,
            method_decl_id,
            operand_type,
            pure_operand_type,
            &final_type_args,
            is_instance_method_call,
            method_call->span
        );

        context->func_env.current_object = old_object;
        context->func_env = old_env;
        return result;
    }

    method_call->operand->ty = .Some(*operand_type);
    method_call->dispatch = .Normal { method_decl_id };

    var old_object = context->func_env.current_object;
    context->func_env.current_object = .Some(*pure_operand_type);
    const ret_type = generics::substitute_type(context, &method_decl->func_decl.ret_type);
    context->func_env.current_object = old_object;
    return .Some(ret_type);
}

fn analyze_dynamic_dispatch_interface_method_call(
    context: AnalyzerContext*,
    method_call: cir::TypedMethodCall*,
    pure_operand_type: const cir::SemaType*,
    is_operand_const_qualified: bool
) Option<cir::SemaType> {
    switch (pure_operand_type->as_named_interface()) case .Some(interface_decl_id) else {
        return .None;    
    }

    switch (context->decl_tables->interfaces.get_const(
        interface_decl_id
    )) case .Some(interface_decl) else {
        return .None;   
    }

    switch (pure_operand_type->as_named_type()) case .Some(named_type) else {
        return .None;
    }

    const interface_type_args = named_type.type_args;

    switch (interface_decl->methods.get(
        method_call->name.as_str_const()
    )) case .Some(interface_method_decl_id) else {
        diags::report_object_method_not_defined(
            context->dctx,
            context->allocator,
            method_call->span,
            interface_decl->name.as_str_const(),
            method_call->name.as_str_const()
        );
        return .None;
    }

    var interface_method_decl = context
        ->decl_tables
        ->methods
        .get_owned(interface_method_decl_id).unwrap();
    
    interface_method_decl.func_decl.params = clone::clone_func_params(
        context->allocator, 
        &interface_method_decl.func_decl.params
    );

    var original_func_params = clone::clone_func_params(
        context->allocator, 
        &interface_method_decl.func_decl.params
    );

    const final_generics_params = cir::extend_generic_params(
        context->allocator,
        &interface_method_decl.func_decl.generic_params,
        &interface_decl->generic_params
    );

    const generic_env_opt = create_inference_generic_env(context,
        interface_decl->name.as_str_const(),
        final_generics_params,
        &interface_type_args,
        method_call->span
    );

    switch (generic_env_opt) case .Some(generic_env) else {
        return .None;
    }

    generics::push_generic_env(context, generic_env);
    const result = analyze_dynamic_dispatch_inner(context,
        method_call,
        &interface_method_decl,
        &original_func_params,
        interface_decl,
        interface_decl_id,
        is_operand_const_qualified
    );
    generics::pop_generic_env(context);
    return result;
}

fn analyze_dynamic_dispatch_inner(
    context: AnalyzerContext*,
    method_call: cir::TypedMethodCall*,
    interface_method_decl: cir::MethodDecl*,
    original_func_params: const cir::TypedFuncParams*,
    interface_decl: const cir::InterfaceDecl*,
    interface_decl_id: cir::InterfaceDeclId,
    is_operand_const_qualified: bool
) Option<cir::SemaType> {
    normalize_func_params(context, &interface_method_decl->func_decl.params, true, 0);
    generics::substitute_func_params(context, &interface_method_decl->func_decl.params);
    interface_method_decl->func_decl.ret_type = generics::substitute_type(context,
        &interface_method_decl->func_decl.ret_type
    );

    if (!analyze_call(context,
        original_func_params,
        &interface_method_decl->func_decl,
        &method_call->args,
        method_call->span,
        true
    )) {
        return .None;
    }

    const object_name = interface_decl->name.as_str_const();

    switch (method_call->operand->ty) case .Some(operand_type) else {
        return .None;
    }

    check_method_call(context,
        &operand_type,
        interface_method_decl,
        &interface_decl->methods,
        object_name,
        method_call->is_thin_arrow,
        true,
        is_operand_const_qualified,
        method_call->span
    );

    const ret_type_opt = normalize_sema_type(context,
        interface_method_decl->func_decl.ret_type, 
        method_call->span, 
        0
    );

    switch (ret_type_opt) case .Some(var ret_type) else {
        return .None;
    }

    ret_type = generics::substitute_type(context, &ret_type);

    switch (interface_decl->method_index(method_call->name.as_str_const())) 
    case .Some(method_index) else {
        return .None;
    }

    method_call->type_args = instantiated_type_args(context, interface_decl->generic_params);
    method_call->dispatch = .Interface {
        interface_decl_id,
        index: method_index,
        dispatch: .Dynamic,
    };

    return .Some(ret_type);
}

fn analyze_static_dispatch_interface_method_call(
    context: AnalyzerContext*,
    method_call: cir::TypedMethodCall*,
    interface_object: const cir::InterfaceObjectType*,
    is_operand_const_qualified: bool,
    expected_type: Option<cir::SemaType>
) Option<cir::SemaType> {
    switch (interface_object->interface_type.type_decl_id.as_interface()) case .Some(interface_decl_id) else {
        return .None;
    }

    switch (context->decl_tables->interfaces.get_const(interface_decl_id)) case .Some(decl) else {
        return .None;
    }

    switch (interface_object->concrete_type->as_named_type()) case .Some(concrete_named) else {
        return .None;
    }

    switch (method_decls_of_named_type(context->decl_tables, &concrete_named)) case .Some(concrete_methods) else {
        return .None;
    }

    switch (decl->method_index(method_call->name.as_str_const())) case .Some(method_index) else {
        return .None;
    }

    // monomorphize the concrete object's method, not the interface's
    const ret_type = analyze_method_call_internal(context,
        method_call,
        concrete_methods,
        concrete_named.type_decl_id,
        *interface_object->concrete_type,
        true,
        false,
        is_operand_const_qualified,
        expected_type
    );

    var dispatch = false;
    var interface_call_dispatch: cir::TypedInterfaceCallDispatch = .Dynamic;

    switch (method_call->dispatch) {
        case .Monomorph { monomorph_id, .. } => {
            // Update the vtable slot for this method
            context->vtable_registry.set_monomorphized_method(
                interface_object->vtable_id, 
                method_index, 
                monomorph_id
            );
            interface_call_dispatch = .StaticMonomorphized { monomorph_id };
            dispatch = true;
        }
        case .Normal { method_decl_id } => {
            interface_call_dispatch = .StaticNormal { method_decl_id };
            dispatch = true;
        }
        case .Unresolved | .Interface => {}
    }

    if (dispatch) {
        method_call->dispatch = .Interface {
            interface_decl_id,
            index: method_index,
            dispatch: interface_call_dispatch,
        };
    }

    return ret_type;
}

fn analyze_interface_method_call(
    context: AnalyzerContext*,
    method_call: cir::TypedMethodCall*,
    operand_type: const cir::SemaType*,
    expected_type: Option<cir::SemaType>
) Option<cir::SemaType> {
    const is_operand_const_qualified = is_const_qualified_lvalue(context, method_call->operand);
    const pure_operand_type = *operand_type->const_inner()->pointer_inner();

    // Try static dispatch when an interface-object is present
    switch (pure_operand_type.as_interface_object()) {
        case .Some(interface_object) => {
            return analyze_static_dispatch_interface_method_call(context,
                method_call,
                &interface_object,
                is_operand_const_qualified,
                expected_type
            );
        }
        case .None => {
            return analyze_dynamic_dispatch_interface_method_call(context,
                method_call,
                &pure_operand_type,
                is_operand_const_qualified
            );
        }
    }
}

fn analyze_argument(
    context: AnalyzerContext*,
    arg: cir::TypedExpr*,
    expected_type: cir::SemaType,
    span: Span
) Option<cir::SemaType> {
    var expect = generics::substitute_type(context, &expected_type);

    var arg_type: cir::SemaType = .Placeholder;
    switch (analyze_expr(context, arg, .Some(expect))) {
        case .Some(ty) => arg_type = ty;
        case .None => {
            arg->ty = .Some(.Err(arg->span));
            return .Some(.Err(arg->span));
        }
    }

    if (arg_type.contains_error() || expect.contains_error()) {
        return .Some(expect);
    }

    arg_type = generics::substitute_type(context, &arg_type);

    switch (context->func_env.infer) {
        case .Some(infer_ctx) => {
            infer_ctx->unify(&expect, &arg_type);
            expect = infer_ctx->resolve(&expect);
            arg_type = infer_ctx->resolve(&arg_type);
        }
        case .None => {}
    }

    if (!is_assignable_to(context, arg_type, expect, span)) {
        var param_type_str = format::format_sema_type(
            context->allocator, 
            context->decl_tables, 
            &expect
        );
        var argument_type_str = format::format_sema_type(
            context->allocator, 
            context->decl_tables, 
            &arg_type
        );

        diags::report_func_call_param_type_mismatch(
            context->dctx,
            context->allocator,
            arg->span,
            @cast(uint32, 0),
            argument_type_str.as_str_const(),
            param_type_str.as_str_const()
        );

        param_type_str.free();
        argument_type_str.free();
    }

    return .Some(expect);
}

/// Validates function calls against their signature.
fn analyze_call(
    context: AnalyzerContext*,
    original_params: const cir::TypedFuncParams*,
    func_decl: const cir::FuncDecl*,
    args: Vec<cir::TypedExpr>*,
    span: Span,
    instance_method_call: bool
) bool {
    const is_variadic = func_decl->params.variadic.is_some();
    
    var expected_args_len = func_decl->params.list.len();

    // if this is an instance method call, the context modifier is not passed
    if (instance_method_call && func_decl->params.list.len() > 0) {
        expected_args_len -= 1;
    }

    if ((!is_variadic && args->len() != expected_args_len) 
        || (is_variadic && args->len() < expected_args_len))
    {
        diags::report_func_call_args_count_mismatch(
            context->dctx,
            context->allocator,
            span,
            func_decl->name.as_str_const(),
            @cast(uint32, expected_args_len),
            @cast(uint32, args->len())
        );
        return false;
    }

    if (is_variadic) {
        check_func_variadic_arguments(context, func_decl, args, span);
    }

    var start_index: usize = 0;
    
    if (instance_method_call) {
        start_index = 1;
    }

    // zip params[start_index..] with args[0..]
    const param_list = &func_decl->params.list;
    var param_i: usize = start_index;
    var arg_i: usize = 0;
    var zip_index: usize = 0;
    var error = false;

    while (param_i < param_list->len() && arg_i < args->len()) {
        const param_kind = param_list->get_const(param_i).unwrap();

        switch (normalize_and_check_type_formation(
            context, 
            param_kind->ty(), 
            param_kind->span(), 
            0
        )) {
            case .Some(param_type) => {
                const arg = args->get(arg_i).unwrap();

                switch (analyze_argument(
                    context, 
                    arg, 
                    param_type, 
                    arg->span
                )) {
                    case .Some(arg_type) => {
                        if (check_argument_satisfies_generic_param_bounds(
                            context,
                            original_params,
                            param_kind->name_str(),
                            &arg_type,
                            arg->span,
                            zip_index
                        )) {
                            error = true;
                        }
                    }
                    case .None => {
                        error = true;
                    }
                }
            }
            case .None => {
                error = true;
            }
        }

        param_i += 1;
        arg_i += 1;
        zip_index += 1;
    }

    return !error;
}

/* ************* Dynamic ************* */

fn analyze_dynamic(
    context: AnalyzerContext*,
    dynamic_expr: cir::TypedDynamicExpr*,
    expected_type: Option<cir::SemaType>
) Option<cir::SemaType> {
    switch (analyze_expr(context, 
        dynamic_expr->operand, 
        .None
    )) case .Some(var operand_type) else {
        return .None;
    }

    operand_type = expand_sema_type(context, operand_type, dynamic_expr->span);

    // Prevent cascading failures
    if (operand_type.contains_error()) {
        return .Some(.Err(dynamic_expr->span));
    }

    if (dynamic_expr->operand->kind.is_dynamic()) {
        diags::report_invalid_multiple_dynamic_type(
            context->dctx, 
            context->allocator, 
            dynamic_expr->span
        );
        return .None;
    }

    switch (operand_type.as_named_type()) case .Some(named_type) else {
        const type_name = format::format_sema_type(
            context->allocator,
            context->decl_tables,
            &operand_type
        );
        
        diags::report_invalid_dynamic_type(
            context->dctx,
            context->allocator,
            dynamic_expr->span,
            type_name.as_str_const()
        );

        type_name.free();
        return .None;
    }

    var interface_decl_id_opt: Option<cir::InterfaceDeclId> = .None;
    var interface_type_args = cir::TypedTypeArgs.new(context->allocator);

    switch (expected_type) {
        case .Some(expect) => {
            interface_decl_id_opt = expect.as_named_interface();

            switch (expect.as_named_type()) {
                case .Some(expected_named) => {
                    interface_type_args = clone::clone_typed_type_args(
                        dynamic context->arena,
                        &expected_named.type_args
                    );
                }
                case .None => @unreachable();
            }
        }
        case .None => {}
    }
    
    switch (interface_decl_id_opt) case .Some(interface_decl_id) else {
        diags::report_cannot_infer_dynamic_interface_type(
            context->dctx, 
            context->allocator, 
            dynamic_expr->span
        );
        return .None;
    }

    const interface_decl = context->decl_tables->interfaces.get_const(interface_decl_id).unwrap();

    if (!interface_decl->is_interface_dynamically_dispatchable) {
        diags::report_not_dynamic_compatible_interface(
            context->dctx,
            context->allocator,
            dynamic_expr->span,
            interface_decl->name.as_str_const()
        );
        return .None;
    }

    switch (implement_interfaces_of_named_type(
        context->decl_tables, 
        &named_type
    )) case .Some(object_impls) else {
        return .None;
    }

    switch (method_decls_of_named_type(
        context->decl_tables, 
        &named_type
    )) case .Some(method_decls) else {
        return .None;
    }

    var object_impls_interface = false;

    for (var i: usize = 0; i < object_impls->len() && !object_impls_interface; i += 1) {
        const implement_interface = object_impls->get_const(i).unwrap();

        switch (normalize_sema_type(context, implement_interface->ty, implement_interface->span, 0)) {
            case .Some(normalized_type) => {
                const ty = expand_sema_type(context, normalized_type, implement_interface->span);

                switch (ty.as_named_interface()) {
                    case .Some(id) => {
                        if (id == interface_decl_id) {
                            object_impls_interface = true;
                        }
                    }
                    case .None => {}
                }
            }
            case .None => {}
        }
    }

    if (!object_impls_interface) {
        const type_name = format::format_sema_type(
            context->allocator, 
            context->decl_tables, 
            &operand_type
        );

        diags::report_dynamic_conversion_missing_interface(
            context->dctx,
            context->allocator,
            dynamic_expr->span,
            interface_decl->name.as_str_const(),
            type_name.as_str_const()
        );

        type_name.free();
        return .None;
    }

    const object_generic_params = *tables::type_decl_generic_params(
        context->decl_tables, 
        named_type.type_decl_id
    );

    var object_name = format::format_type_decl_name(
        context->allocator,
        context->decl_tables, 
        named_type.type_decl_id
    );
    defer object_name.free();

    const object_generic_env_opt = create_inference_generic_env(context,
        object_name.as_str_const(),
        object_generic_params,
        &named_type.type_args,
        dynamic_expr->span
    );
    switch (object_generic_env_opt) {
        case .None => {
            return .None;
        }
        case .Some(env) => {
            generics::push_generic_env(context, env);
            analyze_object_implements_monomorphized_interfaces(context,
                interface_decl,
                &interface_type_args,
                object_name.as_str_const(),
                &operand_type,
                object_impls,
                method_decls,
                dynamic_expr->span
            );
            generics::pop_generic_env(context);
        }
    }

    var interface_methods = cir::MethodDecls.new(context->allocator);
    defer interface_methods.free();

    for (var i: usize = 0; i < interface_decl->methods.entries.len(); i += 1) {
        const entry = interface_decl->methods.entries.get_const(i).unwrap();

        switch (method_decls->get(entry->name.as_str_const())) {
            case .Some(object_method_decl_id) => {
                interface_methods.entries.push(cir::MethodDeclEntry {
                    name: entry->name.clone(context->allocator),
                    id: object_method_decl_id,
                });
            }
            case .None => {}
        }
    }

    const is_interface_generic = interface_decl->is_generic();

    const vtable_id = context->vtable_registry.get_or_create_vtable(
        dynamic context->arena,
        &operand_type,
        interface_decl_id,
        &interface_type_args,
        &interface_methods,
        is_interface_generic,
        dynamic_expr->span
    );

    monomorphize_interface_object_methods(context,
        vtable_id,
        &interface_methods,
        is_interface_generic,
        &operand_type,
        dynamic_expr->span
    );

    var interface_named_type = cir::NamedType {
        type_decl_id: .Interface(interface_decl_id),
        type_args: interface_type_args,
    };

    var interface_object_type = cir::InterfaceObjectType {
        interface_type: interface_named_type,
        concrete_type: alloc_init(context->allocator, operand_type),
        vtable_id,
        span: dynamic_expr->span,
    };

    dynamic_expr->concrete_type = .Some(operand_type);
    dynamic_expr->interface_object_type = .Some(interface_object_type);

    return .Some(.InterfaceObject(interface_object_type));
}

fn analyze_object_implements_monomorphized_interfaces(
    context: AnalyzerContext*,
    interface_decl: const cir::InterfaceDecl*,
    interface_type_args: const cir::TypedTypeArgs*,
    object_name: const uint8*,
    object_type: const cir::SemaType*,
    object_impls: const Vec<cir::TypedImplementInterface>*,
    method_decls: const cir::MethodDecls*,
    span: Span
) {
    const generic_env_opt = create_inference_generic_env(context,
        interface_decl->name.as_str_const(),
        interface_decl->generic_params,
        interface_type_args,
        span
    );

    switch (generic_env_opt) case .Some(env) else {
        return;   
    }

    generics::push_generic_env(context, env);

    for (var i: usize = 0; i < object_impls->len(); i += 1) {
        const implement_interface = object_impls->get_const(i).unwrap();

        const normalized_opt = normalize_sema_type(context,
            implement_interface->ty,
            implement_interface->span,
            0
        );

        switch (normalized_opt) case .Some(normalized_type) else {
            continue;
        }

        const ty = expand_sema_type(context, normalized_type, implement_interface->span);

        switch (ty.as_named_interface()) case .Some(inner_interface_id) else {
            const symbol_name = format::format_sema_type(
                context->allocator, 
                context->decl_tables, 
                &ty
            );
        
            diags::report_non_interface_symbol(
                context->dctx,
                context->allocator,
                implement_interface->span,
                symbol_name.as_str_const()
            );
            
            symbol_name.free();
            continue;
        }

        const inner_interface_decl = context->decl_tables->interfaces.get_const(inner_interface_id).unwrap();

        for (var j: usize = 0; j < inner_interface_decl->methods.entries.len(); j += 1) {
            const ientry = inner_interface_decl->methods.entries.get_const(j).unwrap();
            const table_interface_method = context->decl_tables->methods.get(ientry->id).unwrap();

            // Interface method
            var interface_func = table_interface_method->func_decl;
            
            interface_func.params = clone::clone_func_params(
                context->allocator, 
                &table_interface_method->func_decl.params
            );

            switch (interface_func.params.list.first()) {
                case .Some(first_kind) => {
                    switch (*first_kind) {
                        case .SelfModifier(var self_modifier) => {
                            self_modifier.ty = generics::substitute_self_type(
                                context, 
                                &self_modifier.ty, 
                                object_type
                            );
                            *first_kind = .SelfModifier(self_modifier);
                        }
                        else => {}
                    }
                }
                case .None => {}
            }

            generics::substitute_func_params(context, &interface_func.params);
            interface_func.ret_type = generics::substitute_type(context, &interface_func.ret_type);

            // Object method
            switch (method_decls->get(
                interface_func.name.as_str_const()
            )) case .Some(object_method_id) else {
                continue;
            }

            const table_object_method = context->decl_tables->methods.get(object_method_id).unwrap();

            if (!table_object_method->func_decl.is_generic()) {
                // Skip comparison for generic methods
                // because they will be validated during 
                // monomorphization
                var object_func = table_object_method->func_decl;
                
                object_func.params = clone::clone_func_params(
                    context->allocator, 
                    &table_object_method->func_decl.params
                );

                switch (object_func.params.list.first()) {
                    case .Some(first_kind) => {
                        switch (*first_kind) {
                            case .SelfModifier(var self_modifier) => {
                                self_modifier.ty = generics::substitute_self_type(
                                    context, 
                                    &self_modifier.ty, 
                                    object_type
                                );
                                *first_kind = .SelfModifier(self_modifier);
                            }
                            else => {}
                        }
                    }
                    case .None => {}
                }

                generics::substitute_func_params(context, &object_func.params);
                object_func.ret_type = generics::substitute_type(context, &object_func.ret_type);

                // Check method declaration mismatch
                if (!cir::func_decl_eq(&object_func, &interface_func)) {
                    diags::report_interface_method_type_mismatch(
                        context->dctx,
                        context->allocator,
                        interface_func.span,
                        object_name,
                        interface_func.name.as_str_const(),
                        inner_interface_decl->name.as_str_const()
                    );
                }
            }
        }

        if (!check_type_correctness(context, ty, implement_interface->span)) {
            continue;
        }
    }

    generics::pop_generic_env(context);
}

/* ************* Statements ************* */

pub fn analyze_toplevel_stmts(
    context: AnalyzerContext*, 
    typed_stmts: Vec<cir::TypedStmt>*
) {
    for (var i: usize = 0; i < typed_stmts->len(); i += 1) {
        var stmt = typed_stmts->get(i).unwrap();

        switch (stmt->kind) {
            case .Typedef(var typedef) => {
                analyze_typedef(context, &typedef);
                stmt->kind = .Typedef(typedef);
            }
            else => {}
        }
    }

    for (var i: usize = 0; i < typed_stmts->len(); i += 1) {
        var stmt = typed_stmts->get(i).unwrap();

        switch (stmt->kind) {
            case .GlobalVar(var global_var) => {
                analyze_global_var(context, &global_var);
                stmt->kind = .GlobalVar(global_var);
            }
            else => {}
        }
    }

    for (var i: usize = 0; i < typed_stmts->len(); i += 1) {
        var stmt = typed_stmts->get(i).unwrap();
        analyze_toplevel_stmt(context, stmt);
    }
}

fn analyze_toplevel_stmt(
    context: AnalyzerContext*, 
    stmt: cir::TypedStmt*
) {
    switch (stmt->kind) {
        case .FuncDef(var func_def) => {
            analyze_func_def(context, &func_def);
            stmt->kind = .FuncDef(func_def);
        }
        case .FuncDecl(var func_decl) => {
            analyze_func_decl_stmt(context, &func_decl);
            stmt->kind = .FuncDecl(func_decl);
        }
        case .Interface(var interace_) => {
            analyze_interface(context, &interace_);
            stmt->kind = .Interface(interace_);
        }
        case .Struct(var struct_) => {
            analyze_struct_stmt(context, &struct_);
            stmt->kind = .Struct(struct_);
        }
        case .Enum(var enum_) => {
            analyze_enum_stmt(context, &enum_);
            stmt->kind = .Enum(enum_);
        }
        case .Union(var union_) => {
            analyze_union_stmt(context, &union_);
            stmt->kind = .Union(union_);
        }
        case .Builtin => {
            analyze_builtin(context, stmt, true);
        }

        // Skipped
        case .Typedef | .GlobalVar => {}
        
        else => {
            diags::report_invalid_statement(
                context->dctx,
                context->allocator,
                stmt->kind.span()
            );
        }
    }
}

fn analyze_stmt(
    context: AnalyzerContext*, 
    stmt: cir::TypedStmt*
) flow::FlowState {
    switch (stmt->kind) {
        case .Builtin => {
            return analyze_builtin_func_used_as_stmt(context, stmt);
        }
        else => {}
    }

    switch (stmt->kind) {
        case .Defer(defer_stmt) => {
            analyze_defer_stmt(context, defer_stmt.operand);
            return .Reachable;
        }

        case .BlockStmt(var block) => {
            const flow = analyze_block_stmt(context, &block);
            stmt->kind = .BlockStmt(block);
            return flow;
        }

        case .Expr(var expr) => {
            const expect = expr.ty;
            analyze_expr(context, &expr, expect);
            stmt->kind = .Expr(expr);
            return .Reachable;
        }

        case .Variable(var var_) => {
            analyze_var(context, &var_);
            stmt->kind = .Variable(var_);
            return .Reachable;
        }

        case .InlineAsm(var inline_asm) => {
            analyze_inline_asm_stmt(context, &inline_asm);
            stmt->kind = .InlineAsm(inline_asm);
            return .Reachable;
        }

        case .TupleExport(var tuple_export) => {
            analyze_export_tuple_values(context, &tuple_export);
            stmt->kind = .TupleExport(tuple_export);
            return .Reachable;
        }

        case .If(var if_) => {
            const flow = analyze_if_stmt(context, &if_);
            stmt->kind = .If(if_);
            return flow;
        }

        case .For(var for_) => {
            const flow = analyze_for_loop(context, &for_);
            stmt->kind = .For(for_);
            return flow;
        }

        case .While(var while_) => {
            const flow = analyze_while_loop(context, &while_);
            stmt->kind = .While(while_);
            return flow;
        }

        case .Break(break_) => {
            return analyze_break(context, &break_);
        }

        case .Continue(continue_stmt) => {
            return analyze_continue(context, &continue_stmt);
        }

        case .Return(var return_) => {
            const flow = analyze_return(context, &return_);
            stmt->kind = .Return(return_);
            return flow;
        }

        case .Switch(var switch_) => {
            const flow = analyze_switch(context, &switch_);
            stmt->kind = .Switch(switch_);
            return flow;
        }

        case .Label => return .Reachable;
        
        case .Goto => return .Reachable;

        else => {
            diags::report_invalid_statement(
                context->dctx, 
                context->allocator, 
                stmt->kind.span()
            );
            return .Reachable;
        }
    }
}

fn analyze_defer_stmt(
    context: AnalyzerContext*, 
    operand: cir::TypedStmt*
) {
    analyze_stmt(context, operand);
}

fn analyze_block_stmt(
    context: AnalyzerContext*, 
    block: cir::TypedBlockStmt*
) flow::FlowState {
    const total = block->stmts.len();

    var flow_state: flow::FlowState = .Reachable;
    var terminated = false;

    var final_stmts: Vec<cir::TypedStmt> = Vec.new(context->allocator);
    var block_defers: Vec<cir::TypedDeferStmt> = Vec.new(context->allocator);

    for (var i: usize = 0; i < total; i += 1) {
        var stmt = block->stmts.get(i).unwrap();

        const stmt_state = analyze_stmt(context, stmt);

        switch (stmt->kind) {
            case .Defer(var defer_copy) => {
                defer_copy.operand->is_dead = terminated;
                block_defers.push(defer_copy);
            }
            else => {}
        }

        if (terminated) {
            stmt->is_dead = true;

            if (!context->dctx->has_errors()) {
                diags::report_unreachable_code(
                    context->dctx,
                    context->allocator,
                    stmt->kind.span()
                );
            }

            continue;
        }

        switch (stmt_state) {
            case .Reachable => {
                final_stmts.push(*stmt);
            }
            case .Unreachable => {
                final_stmts.push(*stmt);
                flow_state = .Unreachable;
                terminated = true;
            }
            case .Returns => {
                final_stmts.push(*stmt);
                flow_state = .Returns;
                terminated = true;
            }
        }
    }

    block->stmts.free();
    block->stmts = final_stmts;
    block->defers.free();
    block->defers = block_defers;

    return flow_state;
}

fn analyze_generic_bounds(
    context: AnalyzerContext*, 
    generic_params: const cir::TypedGenericParams*
) {
    for (var i: usize = 0; i < generic_params->ids.len(); i += 1) {
        const generic_param_id = *generic_params->ids.get_const(i).unwrap();

        var generic_param = context->decl_tables->generic_params.get(generic_param_id).unwrap();

        switch (generic_param->default) {
            case .Some(default_type) => {
                switch (normalize_sema_type(context, *default_type, generic_param->name.span, 0)) {
                    case .Some(ty) => {
                        *default_type = ty;
                    }
                    case .None => {}
                }
            }
            case .None => {}
        }

        for (var j: usize = 0; j < generic_param->bounds.len(); j += 1) {
            const bound = generic_param->bounds.get_const(j).unwrap();

            switch (normalize_sema_type(context, bound->ty, generic_param->name.span, 0)) {
                case .Some(ty) => {
                    if (!ty.is_interface()) {
                        var found = format::format_sema_type(context->allocator, context->decl_tables, &ty);
                        defer found.free();
                        diags::report_expected_interface_in_bound(
                            context->dctx,
                            context->allocator,
                            bound->span,
                            found.as_str_const()
                        );
                    }

                    check_type_correctness(context, ty, bound->span);

                    var bound = generic_param->bounds.get(j).unwrap();
                    bound->ty = ty;
                }
                case .None => {}
            }
        }
    }
}

fn analyze_typedef(
    context: AnalyzerContext*, 
    typedef: cir::TypedTypedefStmt*
) {
    const normalized_type = normalize_and_check_type_formation(context, typedef->ty, typedef->span, 0);

    switch (normalized_type) {
        case .Some(ty) => {
            typedef->ty = ty;
        }
        case .None => {
            typedef->ty = cir::SemaType.Err(typedef->span);
            var typedef_decl = context->decl_tables->typedefs.get(typedef->typedef_decl_id).unwrap();
            *typedef_decl->ty = cir::SemaType.Err(typedef->span);
            return;
        }
    }

    analyze_generic_bounds(context, &typedef->generic_params);

    var typedef_decl2 = context->decl_tables->typedefs.get(typedef->typedef_decl_id).unwrap();
    *typedef_decl2->ty = typedef->ty;
}

fn analyze_global_var(
    context: AnalyzerContext*, 
    global_var: cir::TypedGlobalVarStmt*
) {
    switch (global_var->rhs) {
        case .Some(var expr) => {
            if (analyze_expr(context, &expr, global_var->ty).is_none()) {
                global_var->rhs = .Some(expr);

                if (global_var->ty.is_none()) {
                    const err_ty = cir::SemaType.Err(global_var->span);
                    global_var->ty = .Some(err_ty);
                }

                write_back_global_var(context, global_var);
                return;
            }

            if (!global_var->is_static && !ciri::is_expr_const_evaluable(&expr.kind)) {
                diags::report_not_const_evaluable_global_variable_expr(
                    context->dctx,
                    context->allocator,
                    global_var->span
                );

                global_var->rhs = .Some(expr);
                
                if (global_var->ty.is_none()) {
                    const err_ty = cir::SemaType.Err(global_var->span);
                    global_var->ty = .Some(err_ty);
                }
                
                write_back_global_var(context, global_var);
                return;
            }

            if (global_var->is_static && !expr.is_comptime_expr()) {
                diags::report_not_comptime_static_global_variable_expr(
                    context->dctx,
                    context->allocator,
                    global_var->span
                );

                global_var->rhs = .Some(expr);
                
                if (global_var->ty.is_none()) {
                    const err_ty = cir::SemaType.Err(global_var->span);
                    global_var->ty = .Some(err_ty);
                }
                
                write_back_global_var(context, global_var);
                return;
            }

            global_var->rhs = .Some(expr);
        }
        case .None => {}
    }

    switch (global_var->ty) {
        case .Some(ty) => {
            const normalized_type = normalize_and_check_type_formation(context, ty, global_var->span, 0);

            switch (normalized_type) {
                case .Some(inner) => global_var->ty = .Some(inner);
                case .None => global_var->ty = .None;
            }
        }
        case .None => {
            switch (global_var->rhs) {
                case .Some(expr) => {
                    switch (expr.ty) {
                        case .Some(expr_ty) => {
                            global_var->ty = .Some(expr_ty);
                        }
                        case .None => {
                            global_var->ty = .Some(cir::SemaType.Err(global_var->span));

                            diags::report_global_var_requires_type_annotation(
                                context->dctx,
                                context->allocator,
                                global_var->span
                            );

                            write_back_global_var(context, global_var);
                            return;
                        }
                    }
                }
                case .None => {
                    global_var->ty = .Some(cir::SemaType.Err(global_var->span));

                    diags::report_global_var_requires_type_annotation(
                        context->dctx,
                        context->allocator,
                        global_var->span
                    );
                    write_back_global_var(context, global_var);
                    return;
                }
            }
        }
    }

    switch (global_var->ty) {
        case .Some(ty) => {
            const is_init = global_var->rhs.is_some() || global_var->is_undef;
            
            if (!check_variable_type(context, &ty, is_init, global_var->span)) {
                global_var->ty = .Some(cir::SemaType.Err(global_var->span));
                write_back_global_var(context, global_var);
                return;
            }

            const expand = expand_sema_type(context, ty, global_var->span);
            global_var->ty = .Some(expand);
        }
        else => {}
    }

    switch (global_var->rhs) {
        case .Some(expr) => {
            switch (global_var->ty) {
                case .Some(target_type) => {
                    switch (expr.ty) {
                        case .Some(expr_ty) => {
                            if (!cir::cir_types_eq(expr_ty.const_inner(), target_type.const_inner())) {
                                var lhs_name = format::format_sema_type(
                                    context->allocator,
                                    context->decl_tables,
                                    &target_type
                                );
                                defer lhs_name.free();
                                var rhs_name = format::format_sema_type(
                                    context->allocator,
                                    context->decl_tables,
                                    &expr_ty
                                );
                                defer rhs_name.free();
                                diags::report_assignment_type_mismatch(
                                    context->dctx,
                                    context->allocator,
                                    global_var->span,
                                    lhs_name.as_str_const(),
                                    rhs_name.as_str_const()
                                );
                            }
                        }
                        case .None => {}
                    }
                }
                case .None => {}
            }
        }
        case .None => {}
    }

    if (global_var->ty.is_none() && global_var->is_undef) {
        diags::report_undefined_without_type_annotation(
            context->dctx, 
            context->allocator, 
            global_var->span
        );
    }

    if (global_var->is_const && global_var->is_undef) {
        diags::report_undefined_const_variable(
            context->dctx, 
            context->allocator, 
            global_var->span
        );
    }

    if (global_var->is_const && global_var->rhs.is_none()) {
        diags::report_const_variable_must_be_initialized(
            context->dctx, 
            context->allocator, 
            global_var->span
        );
    }

    if (!global_var->is_static) {
        check_non_static_global_var_modifiers(context, global_var);
    }

    write_back_global_var(context, global_var);
}

fn analyze_var(
    context: AnalyzerContext*, 
    var_: cir::TypedVarStmt*) {
    switch (var_->ty) {
        case .Some(ty) => {
            const normalized_type = normalize_and_check_type_formation(context, ty, var_->span, 0);
            var_->ty = normalized_type;
        }
        case .None => {}
    }

    switch (var_->rhs) {
        case .Some(var expr) => {
            const inferred_type_opt = analyze_expr(context, &expr, var_->ty);

            var_->rhs = .Some(expr);

            switch (inferred_type_opt) {
                case .None => {
                    if (var_->ty.is_none()) {
                        var_->ty = .Some(cir::SemaType.Err(var_->span));
                    }
                    write_back_var(context, var_);
                    return;
                }
                case .Some(inferred_type) => {
                    if (var_->ty.is_none()) {
                        var_->ty = .Some(inferred_type);
                    }
                }
            }

            var ty = var_->ty.unwrap();
            var rhs = var_->rhs.unwrap();

            const coerce = coerce_interface_as_interface_object_if_possible(context,
                &ty,
                &rhs,
                var_->span
            );

            var_->ty = .Some(coerce);
        }
        case .None => {}
    }

    switch (var_->ty) {
        case .Some(ty) => {
            if (ty.contains_error()) {
                write_back_var(context, var_);
                return;
            }

            const is_init = var_->rhs.is_some() || var_->is_undef;

            if (!check_variable_type(context, &ty, is_init, var_->span)) {
                var_->ty = .Some(cir::SemaType.Err(var_->span));
                write_back_var(context, var_);
                return;
            }

            const expand = expand_sema_type(context, ty, var_->span);
            var_->ty = .Some(expand);
        }
        case .None => {}
    }

    switch (var_->rhs) {
        case .Some(expr) => {
            switch (var_->ty) {
                case .Some(target_type) => {
                    var skip_mismatch = target_type.contains_error();

                    switch (expr.ty) {
                        case .Some(expr_ty) => {
                            if (expr_ty.contains_error()) {
                                skip_mismatch = true;
                            }
                        }
                        case .None => skip_mismatch = true;
                    }

                    if (!skip_mismatch) {
                        switch (expr.ty) {
                            case .Some(expr_ty) => {
                                if (!is_assignable_to(context, expr_ty, target_type, var_->span)) {
                                    var lhs_name = format::format_sema_type(
                                        context->allocator,
                                        context->decl_tables,
                                        &target_type
                                    );
                                    defer lhs_name.free();
                                    var rhs_name = format::format_sema_type(
                                        context->allocator,
                                        context->decl_tables,
                                        &expr_ty
                                    );
                                    defer rhs_name.free();
                                    diags::report_assignment_type_mismatch(
                                        context->dctx,
                                        context->allocator,
                                        var_->span,
                                        lhs_name.as_str_const(),
                                        rhs_name.as_str_const()
                                    );
                                }
                            }
                            case .None => {}
                        }
                    }
                }
                case .None => {}
            }
        }
        case .None => {}
    }

    if (var_->ty.is_none()) {
        const err = cir::SemaType.Err(var_->span);
        var_->ty = .Some(err);
    }

    if (var_->ty.is_none() && var_->is_undef) {
        diags::report_undefined_without_type_annotation(context->dctx, context->allocator, var_->span);
    }

    write_back_var(context, var_);
}

fn analyze_func_def(
    context: AnalyzerContext*, 
    func_def: cir::TypedFuncDefStmt*) {
    const is_generic_func = func_def->is_generic();

    analyze_entry_func(context, func_def);

    const func_decl_id = func_def->func_decl_id.unwrap();

    var func_decl = *context->decl_tables->funcs.get(func_decl_id).unwrap();

    analyze_func_decl(context, &func_decl);

    func_def->params = func_decl.params;
    func_def->ret_type = func_decl.ret_type;

    var decl = context->decl_tables->funcs.get(func_decl_id).unwrap();
    decl->params = func_decl.params;
    decl->ret_type = func_decl.ret_type;

    if (!is_generic_func) {
        const func_type = cir::func_decl_as_func_type(context->allocator, &func_decl);
        
        var func_env = create_func_def_env(context, func_decl.name.as_str_const(), func_type, .None);
        var saved_func_env = context->func_env;
        context->func_env = func_env;
        analyze_func_body(context, func_def->body, &func_def->ret_type);
        context->func_env = saved_func_env;
    }
}

fn analyze_func_decl_stmt(
    context: AnalyzerContext*, 
    func_decl_stmt: cir::TypedFuncDeclStmt*
) {
    if (func_decl_stmt->is_generic()) {
        diags::report_generic_function_declaration(context->dctx, context->allocator, func_decl_stmt->span);
    }

    var func_decl = *context->decl_tables->funcs.get(func_decl_stmt->func_decl_id).unwrap();

    analyze_func_decl(context, &func_decl);

    func_decl_stmt->params = func_decl.params;
    func_decl_stmt->ret_type = func_decl.ret_type;

    var decl_slot = context->decl_tables->funcs.get(func_decl_stmt->func_decl_id).unwrap();
    decl_slot->params = func_decl.params;
    decl_slot->ret_type = func_decl.ret_type;
}

fn analyze_func_decl(
    context: AnalyzerContext*, 
    func_decl: cir::FuncDecl*
) {
    const is_not_generic_func = !func_decl->is_generic();

    diags::report_if_duplicate_param_names(
        context->dctx, 
        context->allocator, 
        context->decl_tables, 
        &func_decl->params,
        func_decl->span
    );

    switch (normalize_sema_type(context, func_decl->ret_type, func_decl->span, 0)) {
        case .Some(ty) => {
            func_decl->ret_type = ty;
        }
        case .None => {
            return;
        }
    }

    if (is_not_generic_func) {
        check_type_formation(context, func_decl->ret_type, func_decl->span);
    }

    normalize_func_params(context, &func_decl->params, is_not_generic_func, 0);

    analyze_generic_bounds(context, &func_decl->generic_params);
}

fn analyze_func_body(
    context: AnalyzerContext*, 
    body: cir::TypedBlockStmt*, 
    ret_type: const cir::SemaType*
) {
    const flow_state = analyze_block_stmt(context, body);

    if (!ret_type->is_void() 
        && !flow_state.is_returns() 
        && !flow_state.is_unreachable() 
        && !context->dctx->has_errors()) {
        diags::report_missing_return(context->dctx, context->allocator, body->span);
    }
}

fn analyze_entry_func(
    context: AnalyzerContext*, 
    func_def: const cir::TypedFuncDefStmt*
) {
    var is_public = false;
    var is_extern = false;

    switch (func_def->modifiers.vis) {
        case .Public => { is_public = true; }
        case .Private => {}
    }

    switch (func_def->modifiers.extern_) {
        case .Some => { is_extern = true; }
        case .None => {}
    }

    if (func_def->name.as_str_const() == "main") {
        if (!is_public && !is_extern) {
            diags::report_private_entry_point(context->dctx, context->allocator, func_def->span);
        }
    }
}

fn analyze_builtin_func_used_as_stmt(
    context: AnalyzerContext*,
    stmt: cir::TypedStmt*
) flow::FlowState {
    switch (stmt->kind) {
        case .Builtin(.BuiltinFunc(builtin_func)) => {
            const span = builtin_func.span;
            const name = builtin_func.name.str.as_str_const();

            var builtin_expr = cir::TypedExpr.new(.Builtin(.BuiltinFunc(builtin_func)), span);
            builtin_expr.value_category = .RValue;

            if (analyze_expr(context, &builtin_expr, .None).is_none()) {
                return .Reachable;
            }

            stmt->kind = .Expr(builtin_expr);

            if (cir::is_builtin_unreachable(name)) {
                return .Unreachable;
            }

            return .Reachable;
        }
        case .Builtin(.BuiltinBlock) => {
            return analyze_builtin(context, stmt, false);
        }
        else => {
            return .Reachable;
        }
    }
}

fn analyze_builtin(
    context: AnalyzerContext*,
    stmt: cir::TypedStmt*, 
    is_toplevel: bool
) flow::FlowState {
    switch (stmt->kind) {
        case .Builtin(.BuiltinFunc(var builtin_func)) => {
            const result = analyze_builtin_expr(context, &builtin_func);
            
            stmt->kind = .Builtin(.BuiltinFunc(builtin_func));

            if (result.is_none()) {
                return .Reachable;
            }

            if (cir::is_builtin_unreachable(builtin_func.name.str.as_str_const())) {
                return .Unreachable;
            }

            return .Reachable;
        }
        case .Builtin(.BuiltinBlock(var builtin_block)) => {
            const flow = analyze_builtin_block(context, &builtin_block, is_toplevel);
            stmt->kind = .Builtin(.BuiltinBlock(builtin_block));
            return flow;
        }
        else => {
            return .Reachable;
        }
    }
}

fn analyze_struct_stmt(
    context: AnalyzerContext*,
    struct_stmt: cir::TypedStructStmt*
) {
    var struct_decl = *context->decl_tables->structs.get(struct_stmt->struct_decl_id).unwrap();

    if (!struct_stmt->is_generic()) {
        var object_type = cir::SemaType.Named(cir::NamedType {
            type_decl_id: .Struct(struct_stmt->struct_decl_id),
            type_args: cir::TypedTypeArgs.new(context->allocator),
        });
        var old_object = context->func_env.current_object;
        context->func_env.current_object = .Some(object_type);
        analyze_struct_decl(context, struct_stmt->struct_decl_id, &struct_decl);
        context->func_env.current_object = old_object;
    } else {
        analyze_struct_decl(context, struct_stmt->struct_decl_id, &struct_decl);
    }

    struct_stmt->fields = struct_decl.fields;

    write_struct_back(context, struct_stmt->struct_decl_id, struct_decl);
}

fn analyze_struct_decl(
    context: AnalyzerContext*, 
    struct_decl_id: cir::StructDeclId,
    struct_decl: cir::StructDecl*
) {
    check_align(context, &struct_decl->align, struct_decl->span);
    check_struct_repr_attr(context, &struct_decl->modifiers.repr_attr, struct_decl->fields.len(), struct_decl->span);

    var object_name = format::format_struct_decl(context->allocator, context->decl_tables, struct_decl);
    defer object_name.free();
    
    check_duplicate_struct_field(context, object_name.as_str_const(), &struct_decl->fields);

    for (var i: usize = 0; i < struct_decl->fields.len(); i += 1) {
        const field = struct_decl->fields.get(i).unwrap();

        switch (normalize_and_check_type_formation(context, field->ty, field->span, 0)) {
            case .Some(ty) => field->ty = ty;
            case .None => field->ty = .Err(field->span);
        }

        if (!field->ty.contains_generic_param()) {
            check_struct_field_type(context, struct_decl_id, &field->ty, field->span);
        }
    }

    analyze_generic_bounds(context, &struct_decl->generic_params);

    if (!struct_decl->is_generic()) {
        analyze_object_methods(context, .Struct(struct_decl_id), &struct_decl->methods);
    }

    analyze_object_implements_interfaces(context,
        object_name.as_str_const(),
        struct_decl->span,
        struct_decl->is_generic(),
        &struct_decl->impls,
        &struct_decl->methods
    );

}

fn analyze_union_stmt(
    context: AnalyzerContext*, 
    union_: cir::TypedUnionStmt*
) {
    var union_decl = *context->decl_tables->unions.get(union_->union_decl_id).unwrap();

    if (!union_->is_generic()) {
        var object_type = cir::SemaType.Named(cir::NamedType {
            type_decl_id: .Union(union_->union_decl_id),
            type_args: cir::TypedTypeArgs.new(context->allocator),
        });
        var old_object = context->func_env.current_object;
        context->func_env.current_object = .Some(object_type);
        analyze_union_decl(context, union_->union_decl_id, &union_decl);
        context->func_env.current_object = old_object;
    } else {
        analyze_union_decl(context, union_->union_decl_id, &union_decl);
    }

    union_->fields = union_decl.fields;

    write_union_back(context, union_->union_decl_id, union_decl);
}

fn analyze_union_decl(
    context: AnalyzerContext*,
    union_decl_id: cir::UnionDeclId,
    union_decl: cir::UnionDecl*
) {
    check_align(context, &union_decl->align, union_decl->span);
    check_union_repr_attr(context,
        &union_decl->modifiers.repr_attr, 
        union_decl->fields.len(), 
        union_decl->span
    );

    var object_name = format::format_union_decl(
        context->allocator, 
        context->decl_tables, 
        union_decl
    );
    defer object_name.free();

    check_duplicate_union_field(context, object_name.as_str_const(), &union_decl->fields);

    for (var i: usize = 0; i < union_decl->fields.len(); i += 1) {
        const field = union_decl->fields.get(i).unwrap();

        switch (normalize_and_check_type_formation(context, field->ty, field->span, 0)) {
            case .Some(ty) => field->ty = ty;
            case .None => field->ty = .Err(field->span);
        }

        if (!field->ty.contains_generic_param()) {
            check_union_field_type(context, union_decl_id, &field->ty, field->span);
        }
    }

    analyze_generic_bounds(context, &union_decl->generic_params);

    if (!union_decl->is_generic()) {
        analyze_object_methods(context, .Union(union_decl_id), &union_decl->methods);
    }

    analyze_object_implements_interfaces(context,
        object_name.as_str_const(),
        union_decl->span,
        union_decl->is_generic(),
        &union_decl->impls,
        &union_decl->methods
    );

}

fn analyze_enum_stmt(
    context: AnalyzerContext*,
    enum_: cir::TypedEnumStmt*
) {
    var enum_decl = *context->decl_tables->enums.get(enum_->enum_decl_id).unwrap();

    if (!enum_->is_generic()) {
        var object_type = cir::SemaType.Named(cir::NamedType {
            type_decl_id: .Enum(enum_->enum_decl_id),
            type_args: cir::TypedTypeArgs.new(context->allocator),
        });
        var old_object = context->func_env.current_object;
        context->func_env.current_object = .Some(object_type);
        analyze_enum_decl(context, enum_->enum_decl_id, &enum_decl);
        context->func_env.current_object = old_object;
    } else {
        analyze_enum_decl(context, enum_->enum_decl_id, &enum_decl);
    }

    enum_->variants = enum_decl.variants;
    enum_->tag_type = enum_decl.tag_type;

    write_enum_back(context, enum_->enum_decl_id, enum_decl);
}

fn analyze_enum_decl(
    context: AnalyzerContext*,
    enum_decl_id: cir::EnumDeclId,
    enum_decl: cir::EnumDecl*
) {
    const is_repr_c = enum_decl->is_repr_c();

    check_align(context, &enum_decl->align, enum_decl->span);
    check_enum_repr_attr(context, &enum_decl->modifiers.repr_attr, enum_decl->align.is_some(), enum_decl->span);
    check_enum_tag_type(context, &enum_decl->tag_type, enum_decl->span);

    var object_name = format::format_enum_decl(context->allocator, context->registry, context->decl_tables, enum_decl);
    defer object_name.free();
    
    check_duplicate_enum_variants(context, object_name.as_str_const(), &enum_decl->variants);

    for (var i: usize = 0; i < enum_decl->variants.len(); i += 1) {
        const variant = enum_decl->variants.get(i).unwrap();
        analyze_enum_variant(context, enum_decl_id, variant, &enum_decl->tag_type, is_repr_c);
    }

    analyze_generic_bounds(context, &enum_decl->generic_params);

    if (!enum_decl->is_generic()) {
        analyze_object_methods(context, .Enum(enum_decl_id), &enum_decl->methods);
    }

    analyze_object_implements_interfaces(context,
        object_name.as_str_const(),
        enum_decl->span,
        enum_decl->is_generic(),
        &enum_decl->impls,
        &enum_decl->methods
    );

}

fn analyze_enum_variant(
    context: AnalyzerContext*,
    enum_decl_id: cir::EnumDeclId,
    variant: cir::TypedEnumVariant*,
    tag_type_opt: const Option<cir::SemaType>*,
    is_repr_c: bool
) {
    switch (*variant) {
        case .Unit => return;

        case .Valued { ident, value } => {
            analyze_expr(context, value, *tag_type_opt);

            switch (value->ty) {
                case .Some(value_type) => {
                    if (is_repr_c && !value_type.is_integer()) {
                        diags::report_repr_c_enum_with_non_integer_variant(
                            context->dctx,
                            context->allocator,
                            ident.span
                        );
                    }

                    switch (*tag_type_opt) {
                        case .Some(tag_type) => {
                            if (!is_assignable_to(context, value_type, tag_type, value->span)) {
                                var got = format::format_sema_type(context->allocator, context->decl_tables, &value_type);
                                defer got.free();
                                var expected_str = format::format_sema_type(
                                    context->allocator,
                                    context->decl_tables,
                                    &tag_type
                                );
                                defer expected_str.free();
                                diags::report_invalid_enum_variant_value_type(
                                    context->dctx,
                                    context->allocator,
                                    value->span,
                                    got.as_str_const(),
                                    expected_str.as_str_const()
                                );
                            }
                        }
                        case .None => return;
                    }
                }
                case .None => return;
            }
        }

        case .Tuple { ident, var fields } => {
            if (is_repr_c) {
                diags::report_repr_c_enum_with_non_integer_variant(
                    context->dctx, 
                    context->allocator, 
                    ident.span
                );
            }

            for (var i: usize = 0; i < fields.len(); i += 1) {
                const field = fields.get(i).unwrap();

                switch (normalize_and_check_type_formation(context, field->ty, field->span, 0)) {
                    case .Some(ty) => field->ty = ty;
                    case .None => field->ty = .Err(field->span);
                }

                if (!field->ty.contains_generic_param()) {
                    check_enum_variant_field_type(context, enum_decl_id, &field->ty, field->span);
                }
            }
        }

        case .Struct { ident, var fields } => {
            if (is_repr_c) {
                diags::report_repr_c_enum_with_non_integer_variant(
                    context->dctx, 
                    context->allocator, 
                    ident.span
                );
            }

            for (var i: usize = 0; i < fields.len(); i += 1) {
                const field = fields.get(i).unwrap();

                switch (normalize_and_check_type_formation(context, field->ty, field->span, 0)) {
                    case .Some(ty) => field->ty = ty;
                    case .None => field->ty = .Err(field->span);
                }

                if (!field->ty.contains_generic_param()) {
                    check_enum_variant_field_type(context, enum_decl_id, &field->ty, field->span);
                }
            }
        }
    }
}

fn analyze_interface(
    context: AnalyzerContext*, 
    interface_: cir::TypedInterfaceStmt*
) {
    const interface_name = interface_->name.as_str_const();
    
    var is_interface_dynamically_dispatchable = true;

    for (var i: usize = 0; i < interface_->methods.entries.len(); i += 1) {
        const entry = interface_->methods.entries.get_const(i).unwrap();

        var method_decl = *context->decl_tables->methods.get(entry->id).unwrap();
        analyze_method_decl(context, .Interface(interface_->interface_decl_id), &method_decl);

        write_method_back(context, entry->id, method_decl);

        const func_decl = &method_decl.func_decl;

        var params_start: usize = 0;

        switch (func_decl->params.get_self_modifier()) {
            case .Some(self_modifier) => {
                if (!self_modifier.ty.is_pointer()) {
                    diags::report_interface_methods_must_use_referenced_self(
                        context->dctx,
                        context->allocator,
                        self_modifier.span
                    );
                }
                params_start = 1;
            }
            case .None => {
                diags::report_interface_methods_must_have_self_modifier(
                    context->dctx,
                    context->allocator,
                    func_decl->span
                );
            }
        }

        for (var j: usize = params_start; j < func_decl->params.list.len(); j += 1) {
            const param = func_decl->params.list.get_const(j).unwrap();
            const ty = param->ty();

            if (ty.contains_self_type()) {
                diags::report_interface_method_param_contains_self(
                    context->dctx,
                    context->allocator,
                    param->span(),
                    interface_name,
                    func_decl->name.as_str_const()
                );
            }
        }

        if (func_decl->is_generic()) {
            is_interface_dynamically_dispatchable = false;
        }

        if (func_decl->ret_type.contains_self_type()) {
            is_interface_dynamically_dispatchable = false;
        }

        var is_duplicate = false;

        for (var j: usize = 0; j < i; j += 1) {
            const entry = interface_->methods.entries.get_const(j).unwrap();

            if (entry->name.as_str_const() == func_decl->name.as_str_const()) {
                is_duplicate = true;
                break;
            }
        }

        if (is_duplicate) {
            diags::report_interface_duplicate_method(
                context->dctx,
                context->allocator,
                func_decl->span,
                interface_name,
                func_decl->name.as_str_const()
            );
            continue;
        }
    }

    var decl = context->decl_tables->interfaces.get(interface_->interface_decl_id).unwrap();
    decl->is_interface_dynamically_dispatchable = is_interface_dynamically_dispatchable;
}

fn analyze_object_implements_interfaces(
    context: AnalyzerContext*,
    object_name: const uint8*,
    object_span: Span,
    is_object_generic: bool,
    impls: const Vec<cir::TypedImplementInterface>*,
    method_decls: const cir::MethodDecls*
) {
    for (var i: usize = 0; i < impls->len(); i += 1) {
        const implement_interface = impls->get_const(i).unwrap();
        
        switch (normalize_and_check_type_formation(context,
            implement_interface->ty,
            implement_interface->span,
            0
        )) case .Some(normalized_type) else {
            continue;
        }

        const ty = expand_sema_type(context, normalized_type, implement_interface->span);

        switch (ty.as_named_interface()) case .Some(interface_id) else {
            var symbol = format::format_sema_type(context->allocator, context->decl_tables, &ty);
            
            diags::report_non_interface_symbol(
                context->dctx,
                context->allocator,
                implement_interface->span,
                symbol.as_str_const()
            );

            symbol.free();
            continue;
        }

        const named = ty.as_named_type().unwrap();

        const interface_decl = context->decl_tables->interfaces.get(interface_id).unwrap();

        for (var j: usize = 0; j < interface_decl->methods.entries.len(); j += 1) {
            const mentry = interface_decl->methods.entries.get_const(j).unwrap();

            var method = *context->decl_tables->methods.get(mentry->id).unwrap();
            
            const inst = cir::instantiate_method_decl(
                context->allocator,
                &method,
                &interface_decl->generic_params,
                &named.type_args
            );
            const inst_func = &inst.func_decl;

            if (!method_decls->contains(inst_func->name.as_str_const())) {
                diags::report_missing_interface_method_impl(
                    context->dctx,
                    context->allocator,
                    object_span,
                    object_name,
                    inst_func->name.as_str_const(),
                    interface_decl->name.as_str_const()
                );
                continue;
            }

            const method_id = method_decls->get(inst_func->name.as_str_const()).unwrap();
            
            var object_method = *context->decl_tables->methods.get(method_id).unwrap();

            if (!is_object_generic && !object_method.func_decl.is_generic()) {
                if (!cir::func_decl_eq(&object_method.func_decl, inst_func)) {
                    diags::report_interface_method_type_mismatch(
                        context->dctx,
                        context->allocator,
                        object_method.func_decl.span,
                        object_name,
                        inst_func->name.as_str_const(),
                        interface_decl->name.as_str_const()
                    );
                }
            }
        }

        if (!is_object_generic) {
            check_type_correctness(context, ty, implement_interface->span);
        }
    }
}

fn analyze_object_methods(
    context: AnalyzerContext*, 
    object_type_decl_id: cir::TypeDeclId, 
    method_decls: const cir::MethodDecls*
) {
    for (var i: usize = 0; i < method_decls->entries.len(); i += 1) {
        const entry = method_decls->entries.get_const(i).unwrap();

        var method_decl = *context->decl_tables->methods.get(entry->id).unwrap();
        analyze_method_decl(context, object_type_decl_id, &method_decl);

        switch (context->decl_tables->methods.get(entry->id)) case .Some(var slot) else {
            continue;
        }
        *slot = method_decl;
    }

    var object_type = cir::SemaType.Named(cir::NamedType {
        type_decl_id: object_type_decl_id,
        type_args: cir::TypedTypeArgs.new(context->allocator),
    });

    for (var i: usize = 0; i < method_decls->entries.len(); i += 1) {
        const entry = method_decls->entries.get_const(i).unwrap();

        if (context->decl_tables->methods.get(entry->id).is_none()) {
            continue;
        }

        var method_decl = *context->decl_tables->methods.get(entry->id).unwrap();

        if (!method_decl.func_decl.is_generic()) {
            analyze_method_body(context, &object_type, entry->id, &method_decl);
        }
    }
}

fn analyze_method_decl(
    context: AnalyzerContext*, 
    object_type_decl_id: cir::TypeDeclId, 
    method_decl: cir::MethodDecl*
) {
    if (!method_decl->func_decl.is_generic() && !object_type_decl_id.is_interface()) {
        var concrete_self_type = cir::SemaType.Named(cir::NamedType {
            type_decl_id: object_type_decl_id,
            type_args: cir::TypedTypeArgs.new(context->allocator),
        });
        apply_self_type_in_method_decl_and_variable(context, method_decl, &concrete_self_type);
    }

    analyze_func_decl(context, &method_decl->func_decl);
}

fn analyze_method_body(
    context: AnalyzerContext*,
    object_type: const cir::SemaType*,
    method_decl_id: cir::MethodDeclId,
    method_decl: const cir::MethodDecl*
) {
    const func_type = cir::func_decl_as_func_type(context->allocator, &method_decl->func_decl);
    
    var method_env = create_method_env(context, method_decl_id, func_type, .None);
    method_env.current_object = .Some(*object_type);

    if (method_decl->body.is_none()) {
        return;
    }

    const body_id = method_decl->body.unwrap();

    var saved_env = context->func_env;
    context->func_env = method_env;

    var body = *context->decl_tables->bodies.get(body_id).unwrap();
    analyze_func_body(context, &body, &method_decl->func_decl.ret_type);
    
    switch (context->decl_tables->bodies.get(body_id)) case .Some(var slot) else {
        context->func_env = saved_env;
        return;
    }
    *slot = body;

    context->func_env = saved_env;
}

fn analyze_if_stmt(
    context: AnalyzerContext*, 
    if_: cir::TypedIfStmt*
) flow::FlowState {
    analyze_cond_expr(context, &if_->cond);

    const then_state = analyze_block_stmt(context, if_->then_block);

    var else_state: flow::FlowState = .Reachable;

    switch (if_->else_block) {
        case .Some(block) => else_state = analyze_block_stmt(context, block);
        case .None => {}
    }

    for (var i: usize = 0; i < if_->branches.len(); i += 1) {
        const branch = if_->branches.get(i).unwrap();
        analyze_if_stmt(context, branch);
    }

    return then_state.merge(else_state);
}

fn analyze_while_loop(
    context: AnalyzerContext*, 
    while_: cir::TypedWhileStmt*
) flow::FlowState {
    analyze_cond_expr(context, &while_->cond);

    context->control_region_stack.push(.Loop);
    analyze_block_stmt(context, while_->body);
    context->control_region_stack.pop();

    return .Reachable;
}

fn analyze_for_loop(
    context: AnalyzerContext*, 
    for_: cir::TypedForStmt*
) flow::FlowState {
    switch (for_->initializer) {
        case .Some(var var_) => {
            analyze_var(context, &var_);
            for_->initializer = .Some(var_);
        }
        case .None => {}
    }

    switch (for_->cond) {
        case .Some(var expr) => {
            analyze_cond_expr(context, &expr);
            for_->cond = .Some(expr);
        }
        case .None => {}
    }

    switch (for_->increment) {
        case .Some(var expr) => {
            analyze_expr(context, &expr, .None);
            for_->increment = .Some(expr);
        }
        case .None => {}
    }

    context->control_region_stack.push(.Loop);
    analyze_block_stmt(context, for_->body);
    context->control_region_stack.pop();

    return .Reachable;
}

fn analyze_return(
    context: AnalyzerContext*, 
    return_: cir::TypedReturnStmt*
) flow::FlowState {
    switch (context->func_env.current_func) case .Some(func_type) else {
        return .Reachable;
    }
    const ret_type = func_type.ret_type;

    switch (return_->arg) {
        case .Some(var expr) => {
            const arg_span = expr.span;
            const arg_type_opt = analyze_expr(context, &expr, .Some(*ret_type));
            return_->arg = .Some(expr);

            switch (arg_type_opt) {
                case .Some(arg_type) => {
                    const expand = expand_sema_type(context, arg_type, return_->span);

                    if (expand.is_void()) {
                        diags::report_void_function_returns_value(context->dctx, context->allocator, return_->span);
                    } else if (!is_assignable_to(context, arg_type, *ret_type, arg_span)) {
                        var expect = format::format_sema_type(
                            context->allocator,
                            context->decl_tables,
                            ret_type->const_inner()
                        );
                        defer expect.free();
                        var got = format::format_sema_type(
                            context->allocator,
                            context->decl_tables,
                            arg_type.const_inner()
                        );
                        defer got.free();
                        diags::report_return_statement_type_mismatch(
                            context->dctx,
                            context->allocator,
                            return_->span,
                            expect.as_str_const(),
                            got.as_str_const()
                        );
                    }
                }
                case .None => return .Reachable;
            }
        }
        case .None => {
            const expand = expand_sema_type(context, *ret_type, return_->span);

            if (!expand.is_void()) {
                var arg_str = format::format_sema_type(context->allocator, context->decl_tables, ret_type);
                defer arg_str.free();
                diags::report_return_statement_needs_an_argument(
                    context->dctx,
                    context->allocator,
                    return_->span,
                    arg_str.as_str_const()
                );
            }
        }
    }

    return .Returns;
}

fn analyze_break(
    context: AnalyzerContext*, 
    break_: const cir::TypedBreakStmt*
) flow::FlowState {
    var valid = false;

    for (var i: usize = 0; i < context->control_region_stack.len(); i += 1) {
        const region = context->control_region_stack.get_const(i).unwrap();

        if (region->allows_break()) {
            valid = true;
            break;
        }
    }

    if (!valid) {
        diags::report_invalid_break_statement(
            context->dctx, 
            context->allocator, 
            break_->span
        );
        return .Reachable;
    }

    return .Unreachable;
}

fn analyze_continue(
    context: AnalyzerContext*, 
    continue_: const cir::TypedContinueStmt*
) flow::FlowState {
    var valid = false;

    for (var i: usize = 0; i < context->control_region_stack.len(); i += 1) {
        const region = context->control_region_stack.get_const(i).unwrap();

        if (region->allows_continue()) {
            valid = true;
            break;
        }
    }

    if (!valid) {
        diags::report_invalid_continue_statement(context->dctx, context->allocator, continue_->span);
        return .Reachable;
    }

    return .Unreachable;
}

fn analyze_switch(
    context: AnalyzerContext*,
    switch_: cir::TypedSwitchStmt*
) flow::FlowState {
    if (analyze_expr(context, &switch_->operand, .None).is_none()) {
        return .Reachable;
    }

    switch (switch_->operand.ty) {
        case .Some(ty) => {
            var expand = expand_sema_type(context, ty, switch_->span);
            switch_->operand.ty = .Some(expand);
        }
        case .None => return .Reachable;
    }

    const operand_type = switch_->operand.ty.unwrap();

    context->control_region_stack.push(.Switch);
    const flow = analyze_switch_dispatch(context, switch_, &operand_type);
    context->control_region_stack.pop();

    return flow;
}

fn analyze_switch_dispatch(
    context: AnalyzerContext*,
    switch_: cir::TypedSwitchStmt*,
    operand_type: const cir::SemaType*
) flow::FlowState {
    if (switch_->cases.is_empty()) {
        diags::report_empty_case_switch(context->dctx, context->allocator, switch_->span);
        return .Reachable;
    }

    if (operand_type->is_enum()) {
        return analyze_switch_on_enum(context, switch_, operand_type);
    }

    if (operand_type->is_plain_type() || operand_type->is_uint8_pointer()) {
        return analyze_switch_on_value(context, switch_, operand_type);
    }

    if (operand_type->contains_error()) {
        // Prevent cascading failures
        return analyze_switch_on_poisoned_operand(context, switch_);
    }

    var expr_type = format::format_sema_type(context->allocator, context->decl_tables, operand_type);
    defer expr_type.free();
    diags::report_switch_operand_not_enum(
        context->dctx,
        context->allocator,
        switch_->span,
        expr_type.as_str_const()
    );
    return .Reachable;
}

fn analyze_switch_on_poisoned_operand(
    context: AnalyzerContext*,
    switch_: cir::TypedSwitchStmt*
) flow::FlowState {
    for (var i: usize = 0; i < switch_->cases.len(); i += 1) {
        const case_ = switch_->cases.get(i).unwrap();
        analyze_block_stmt(context, case_->body);
    }
    
    switch (switch_->else_case) {
        case .Some(var block) => {
            analyze_block_stmt(context, &block);
            switch_->else_case = .Some(block);
        }
        case .None => {}
    }

    switch_->all_cases_covered = .Some(true);

    return .Reachable;
}

fn analyze_switch_on_value(
    context: AnalyzerContext*,
    switch_: cir::TypedSwitchStmt*,
    operand_type: const cir::SemaType*
) flow::FlowState {
    var flow_states: Vec<flow::FlowState> = Vec.new(context->allocator);
    defer flow_states.free();

    for (var i: usize = 0; i < switch_->cases.len(); i += 1) {
        const case_ = switch_->cases.get(i).unwrap();

        analyze_switch_on_value_case_patterns(context, &case_->patterns, operand_type, case_->span);

        const body_flow = analyze_block_stmt(context, case_->body);
        flow_states.push(body_flow);
    }

    switch_->all_cases_covered = .Some(false);

    switch (switch_->else_case) {
        case .Some(var block) => {
            const default_flow = analyze_block_stmt(context, &block);
            switch_->else_case = .Some(block);

            flow_states.push(default_flow);
            switch_->all_cases_covered = .Some(true);
        }
        case .None => flow_states.push(.Reachable);
    }

    var result: flow::FlowState = .Reachable;

    if (flow::all_flow_states_terminate(&flow_states)) {
        result = .Returns;
    } else if (flow::all_flow_states_are_unreachable(&flow_states)) {
        result = .Unreachable;
    }

    return result;
}

fn analyze_switch_on_value_case_patterns(
    context: AnalyzerContext*,
    patterns: cir::Vec<cir::TypedSwitchCasePattern>*,
    operand_type: const cir::SemaType*,
    case_span: Span
) {
    var table: Vec<usize> = Vec.new(context->allocator);
    defer table.free();

    for (var i: usize = 0; i < patterns->len(); i += 1) {
        const pattern = patterns->get(i).unwrap();

        var pattern_ranges_opt = analyze_switch_value_pattern(context, pattern, operand_type);

        switch (pattern_ranges_opt) case .Some(var pattern_ranges) else {
            continue;
        }

        if (is_switch_range_valid(&table, &pattern_ranges)) {
            for (var j: usize = 0; j < pattern_ranges.len(); j += 1) {
                table.push(*pattern_ranges.get_const(j).unwrap());
            }
        } else {
            diags::report_overlapping_switch_case_range(context->dctx, context->allocator, case_span);
            pattern_ranges.free();
            return;
        }

        pattern_ranges.free();
    }

}

fn analyze_switch_value_pattern(
    context: AnalyzerContext*,
    pattern: cir::TypedSwitchCasePattern*,
    operand_type: const cir::SemaType*
) Option<Vec<usize>> {
    var kind = pattern->kind;

    switch (kind) {
        case .EnumUnit 
        | .EnumStructVariant 
        | .EnumTupleVariant 
        | .Binding 
        | .Wildcard => {
            var operand_str = format::format_sema_type(
                context->allocator, 
                context->decl_tables, 
                operand_type
            );

            diags::report_invalid_switch_case_pattern(
                context->dctx, 
                context->allocator, 
                pattern->span, 
                operand_str.as_str_const()
            );
            
            operand_str.free();
            return .Some(Vec.new(context->allocator));
        }

        case .Range(var range) => {
            analyze_expr(context, &range.lower, .Some(*operand_type));
            analyze_expr(context, &range.upper, .Some(*operand_type));
            pattern->kind = .Range(range);

            switch (ciri::fold_const_expr_int(context->decl_tables, context->registry, &range.lower)) case .Some(lower_lit) else {
                return .None;
            }

            switch (ciri::fold_const_expr_int(context->decl_tables, context->registry, &range.upper)) case .Some(upper_lit) else {
                return .None;
            }

            const lower = cir::integer_literal_as_usize(lower_lit);
            const upper = cir::integer_literal_as_usize(upper_lit);

            if (lower >= upper) {
                diags::report_invalid_range(context->dctx, context->allocator, range.span);
                return .None;
            }

            var ranges: Vec<usize> = Vec.new(context->allocator);
            ranges.push(lower);
            ranges.push(upper);
            return .Some(ranges);
        }

        case .Expr(var expr) => {
            const expr_type_opt = analyze_expr(context, &expr, .Some(*operand_type));
            pattern->kind = .Expr(expr);

            switch (expr_type_opt) case .Some(expr_type) else {
                return .None;
            }

            if (!is_assignable_to(context, expr_type, *operand_type, expr.span)) {
                var pattern_str = format::format_sema_type(
                    context->allocator,
                    context->decl_tables,
                    &expr_type
                );
                defer pattern_str.free();
                var operand_str = format::format_sema_type(
                    context->allocator,
                    context->decl_tables,
                    operand_type
                );
                defer operand_str.free();
                diags::report_incompatible_switch_pattern_type(
                    context->dctx,
                    context->allocator,
                    expr.span,
                    pattern_str.as_str_const(),
                    operand_str.as_str_const()
                );
            }

            return .Some(Vec.new(context->allocator));
        }
    }
}

fn analyze_switch_on_enum(
    context: AnalyzerContext*, 
    switch_: cir::TypedSwitchStmt*, 
    operand_type: const cir::SemaType*
) flow::FlowState {
    switch (operand_type->as_named_type()) case .Some(named) else {
        return .Unreachable;
    }

    switch (named.type_decl_id.as_enum()) case .Some(enum_decl_id) else {
        return .Unreachable;
    }

    const enum_decl = context->decl_tables->enums.get(enum_decl_id).unwrap();
    var inst_enum_decl = instantiate_enum_decl_with_type_args(context->allocator, enum_decl, &named.type_args);

    const all_variants_count = inst_enum_decl.variants.len();

    var all_covered_variants: Vec<String> = Vec.new(context->allocator);
    defer all_covered_variants.free();

    var flow_states: Vec<flow::FlowState> = Vec.new(context->allocator);
    defer flow_states.free();

    for (var i: usize = 0; i < switch_->cases.len(); i += 1) {
        const case_ = switch_->cases.get(i).unwrap();

        var covered = analyze_switch_on_enum_case_patterns(context, &case_->patterns, &inst_enum_decl, case_->span);

        const body_flow = analyze_block_stmt(context, case_->body);
        flow_states.push(body_flow);

        for (var j: usize = 0; j < covered.len(); j += 1) {
            const name = *covered.get_const(j).unwrap();
            str_set_insert(&all_covered_variants, name);
        }

        covered.free();
    }

    switch_->all_cases_covered = .Some(false);

    switch (switch_->else_case) {
        case .Some(var block) => {
            const default_flow = analyze_block_stmt(context, &block);
            switch_->else_case = .Some(block);

            flow_states.push(default_flow);
            switch_->all_cases_covered = .Some(true);
        }
        case .None => {
            if (all_covered_variants.len() == all_variants_count) {
                switch_->all_cases_covered = .Some(true);
            } else {
                var missing = String.new(context->allocator);
                defer missing.free();

                for (var k: usize = 0; k < inst_enum_decl.variants.len(); k += 1) {
                    const variant = inst_enum_decl.variants.get_const(k).unwrap();
                    const variant_name = variant->name();

                    if (!str_set_contains(&all_covered_variants, variant_name)) {
                        if (missing.len() > 0) {
                            missing.push_str(", ");
                        }

                        missing.push_str(variant_name);
                    }
                }

                diags::report_non_exhaustive_switch(
                    context->dctx,
                    context->allocator,
                    switch_->span,
                    missing.as_str_const()
                );

                switch_->all_cases_covered = .Some(false);
                flow_states.push(.Reachable);
            }
        }
    }

    var result: flow::FlowState = .Reachable;

    if (flow::all_flow_states_terminate(&flow_states)) {
        if (flow::all_flow_states_are_unreachable(&flow_states)) {
            result = .Unreachable;
        } else {
            result = .Returns;
        }
    }

    return result;
}

fn analyze_switch_on_enum_case_patterns(
    context: AnalyzerContext*,
    patterns: const cir::Vec<cir::TypedSwitchCasePattern>*,
    inst_enum_decl: cir::EnumDecl*,
    span: Span
) Vec<String> {
    var enum_name = format::format_enum_decl(context->allocator, context->registry, context->decl_tables, inst_enum_decl);
    defer enum_name.free();

    var exporting_pattern_count: usize = 0;
    var covered_variants: Vec<String> = Vec.new(context->allocator);

    for (var i: usize = 0; i < patterns->len(); i += 1) {
        const pattern = patterns->get_const(i).unwrap();

        analyze_enum_switch_pattern(context,
            pattern,
            inst_enum_decl,
            enum_name.as_str_const(),
            &exporting_pattern_count,
            &covered_variants
        );
    }

    if (exporting_pattern_count > 1) {
        diags::report_multiple_exporting_patterns_in_switch_case(
            context->dctx,
            context->allocator,
            span
        );
    }

    return covered_variants;
}

fn analyze_enum_switch_pattern(
    context: AnalyzerContext*,
    pattern: const cir::TypedSwitchCasePattern*,
    inst_enum_decl: cir::EnumDecl*,
    enum_name: const uint8*,
    exporting_pattern_count: usize*,
    covered_variants: Vec<String>*
) {
    switch (pattern->kind) {
        case .Wildcard => {
            diags::report_only_variant_pattern_is_allowed_in_switch(
                context->dctx,
                context->allocator,
                pattern->span
            );
            return;
        }

        case .Binding => {
            diags::report_only_variant_pattern_is_allowed_in_switch(
                context->dctx,
                context->allocator,
                pattern->span
            );
            return;
        }

        case .EnumUnit(ident) => {
            const name = ident.str.as_str_const();

            if (inst_enum_decl->lookup_variant(name).is_none()) {
                diags::report_no_such_enum_variant(
                    context->dctx,
                    context->allocator,
                    pattern->span,
                    enum_name,
                    name
                );
            }

            if (!str_set_insert(covered_variants, ident.str)) {
                diags::report_duplicate_enum_variant_in_switch_patterns(
                    context->dctx,
                    context->allocator,
                    pattern->span,
                    name
                );
            }
        }

        case .EnumTupleVariant { ident, items } => {
            const name = ident.str.as_str_const();

            switch (inst_enum_decl->lookup_variant(name)) case .Some(var variant) else {
                diags::report_no_such_enum_variant(
                    context->dctx,
                    context->allocator,
                    pattern->span,
                    enum_name,
                    name
                );
                return;
            }

            if (!str_set_insert(covered_variants, ident.str)) {
                diags::report_duplicate_enum_variant_in_switch_patterns(
                    context->dctx,
                    context->allocator,
                    pattern->span,
                    name
                );
            }

            switch (*variant) {
                case .Tuple { fields, .. } => {
                    if (fields.len() != items.len()) {
                        diags::report_enum_variant_arg_count_mismatch(
                            context->dctx,
                            context->allocator,
                            pattern->span,
                            name,
                            @cast(uint32, fields.len()),
                            @cast(uint32, items.len())
                        );
                        return;
                    }

                    *exporting_pattern_count = *exporting_pattern_count + 1;

                    for (var i: usize = 0; i < items.len(); i += 1) {
                        const item = items.get_const(i).unwrap();
                        const field = fields.get_const(i).unwrap();
                        analyze_pattern_recursively(context, item, &field->ty);
                    }
                }

                case .Valued { value, .. } => {
                    *exporting_pattern_count = *exporting_pattern_count + 1;

                    if (items.len() != 1) {
                        diags::report_valued_enum_variant_can_only_export_one_field(
                            context->dctx,
                            context->allocator,
                            pattern->span,
                            name
                        );
                        return;
                    }

                    const item = items.get_const(0).unwrap();

                    switch (analyze_expr(context, value, .None)) {
                        case .Some(expr_type) => analyze_pattern_recursively(context, item, &expr_type);
                        case .None => {}
                    }
                }

                else => {
                    diags::report_enum_variant_kind_mismatch_in_switch_pattern(
                        context->dctx,
                        context->allocator,
                        pattern->span
                    );
                }
            }
        }

        case .EnumStructVariant { ident, items, ignore } => {
            const name = ident.str.as_str_const();
            
            switch (inst_enum_decl->lookup_variant(name)) case .Some(var variant) else {
                diags::report_no_such_enum_variant(
                    context->dctx,
                    context->allocator,
                    pattern->span,
                    enum_name,
                    name
                );
                return;
            }

            *exporting_pattern_count = *exporting_pattern_count + 1;

            if (!str_set_insert(covered_variants, ident.str)) {
                diags::report_duplicate_enum_variant_in_switch_patterns(
                    context->dctx,
                    context->allocator,
                    pattern->span,
                    name
                );
            }

            switch (*variant) {
                case .Struct { fields, .. } => {
                    var error = false;

                    if (!ignore && fields.len() != items.len()) {
                        diags::report_enum_variant_arg_count_mismatch(
                            context->dctx,
                            context->allocator,
                            pattern->span,
                            name,
                            @cast(uint32, fields.len()),
                            @cast(uint32, items.len())
                        );
                        return;
                    }

                    for (var i: usize = 0; i < items.len(); i += 1) {
                        const item = items.get_const(i).unwrap();
                        
                        var exists = false;

                        for (var j: usize = 0; j < fields.len(); j += 1) {
                            const field = fields.get_const(j).unwrap();

                            if (field->name.str.as_str_const() == item->name.str.as_str_const()) {
                                exists = true;
                                break;
                            }
                        }

                        if (!exists) {
                            diags::report_unknown_field_in_enum_struct_pattern(
                                context->dctx,
                                context->allocator,
                                pattern->span,
                                item->name.str.as_str_const()
                            );
                            error = true;
                        }
                    }

                    if (!error) {
                        for (var i: usize = 0; i < items.len(); i += 1) {
                            const item = items.get_const(i).unwrap();
                            var found_field = false;

                            for (var j: usize = 0; j < fields.len(); j += 1) {
                                const field = fields.get_const(j).unwrap();

                                if (field->name.str.as_str_const() == item->name.str.as_str_const()) {
                                    analyze_pattern_recursively(context, &item->pattern, &field->ty);
                                    found_field = true;
                                    break;
                                }
                            }

                            if (!found_field) {
                                diags::report_unknown_field_in_enum_struct_pattern(
                                    context->dctx,
                                    context->allocator,
                                    item->name.span,
                                    item->name.str.as_str_const()
                                );
                            }
                        }
                    }
                }

                else => {
                    diags::report_enum_variant_kind_mismatch_in_switch_pattern(
                        context->dctx,
                        context->allocator,
                        pattern->span
                    );
                }
            }
        }

        else => {
            diags::report_only_variant_pattern_is_allowed_in_switch(
                context->dctx,
                context->allocator,
                pattern->span
            );
        }
    }
}

fn analyze_pattern_recursively(
    context: AnalyzerContext*,
    pattern: const cir::TypedSwitchCasePattern*,
    ty: const cir::SemaType*
) {
    switch (pattern->kind) {
        case .Wildcard => {}

        case .Binding { var_decl_id, .. } => {
            switch (context->decl_tables->vars.get(var_decl_id)) case .Some(entry) else {
                return;
            }
            entry->ty = .Some(*ty);
        }

        case .EnumUnit(ident) => {
            analyze_nested_enum_pattern(context, pattern, ty, ident);
        }

        case .EnumTupleVariant { ident, .. } => {
            analyze_nested_enum_pattern(context, pattern, ty, ident);
        }

        case .EnumStructVariant { ident, .. } => {
            analyze_nested_enum_pattern(context, pattern, ty, ident);
        }

        else => {
            diags::report_only_variant_pattern_is_allowed_in_switch(
                context->dctx,
                context->allocator,
                pattern->span
            );
        }
    }
}

fn analyze_nested_enum_pattern(
    context: AnalyzerContext*,
    pattern: const cir::TypedSwitchCasePattern*,
    ty: const cir::SemaType*,
    ident: ast::ASTIdent
) {
    const expanded = expand_sema_type(context, *ty, pattern->span);

    switch (expanded.as_named_type()) case .Some(named) else {
        diags::report_only_variant_pattern_is_allowed_in_switch(
            context->dctx,
            context->allocator,
            pattern->span
        );
        return;
    }

    switch (named.type_decl_id.as_enum()) case .Some(enum_decl_id) else {
        diags::report_only_variant_pattern_is_allowed_in_switch(
            context->dctx,
            context->allocator,
            pattern->span
        );
        return;
    }

    const enum_decl = context->decl_tables->enums.get(enum_decl_id).unwrap();
    var inst_enum_decl = instantiate_enum_decl_with_type_args(context->allocator, enum_decl, &named.type_args);
    var enum_name = format::format_enum_decl(context->allocator, context->registry, context->decl_tables, &inst_enum_decl);
    defer enum_name.free();

    const name = ident.str.as_str_const();

    switch (inst_enum_decl.lookup_variant(name)) case .Some(var variant) else {
        diags::report_no_such_enum_variant(
            context->dctx,
            context->allocator,
            pattern->span,
            enum_name.as_str_const(),
            name
        );
        return;
    }

    switch (pattern->kind) {
        case .EnumUnit(_) => {}

        case .EnumTupleVariant { items, .. } => {
            switch (*variant) {
                case .Tuple { fields, .. } => {
                    if (fields.len() != items.len()) {
                        diags::report_enum_variant_arg_count_mismatch(
                            context->dctx,
                            context->allocator,
                            pattern->span,
                            name,
                            @cast(uint32, fields.len()),
                            @cast(uint32, items.len())
                        );
                        return;
                    }

                    for (var i: usize = 0; i < items.len(); i += 1) {
                        const item = items.get_const(i).unwrap();
                        const field = fields.get_const(i).unwrap();
                        analyze_pattern_recursively(context, item, &field->ty);
                    }
                }

                case .Valued { value, .. } => {
                    if (items.len() != 1) {
                        diags::report_valued_enum_variant_can_only_export_one_field(
                            context->dctx,
                            context->allocator,
                            pattern->span,
                            name
                        );
                        return;
                    }

                    const item = items.get_const(0).unwrap();

                    switch (analyze_expr(context, value, .None)) {
                        case .Some(expr_type) => analyze_pattern_recursively(context, item, &expr_type);
                        case .None => {}
                    }
                }

                else => {
                    diags::report_enum_variant_kind_mismatch_in_switch_pattern(
                        context->dctx,
                        context->allocator,
                        pattern->span
                    );
                }
            }
        }

        case .EnumStructVariant { items, ignore, .. } => {
            switch (*variant) {
                case .Struct { fields, .. } => {
                    if (!ignore && fields.len() != items.len()) {
                        diags::report_enum_variant_arg_count_mismatch(
                            context->dctx,
                            context->allocator,
                            pattern->span,
                            name,
                            @cast(uint32, fields.len()),
                            @cast(uint32, items.len())
                        );
                        return;
                    }

                    var error = false;

                    for (var i: usize = 0; i < items.len(); i += 1) {
                        const item = items.get_const(i).unwrap();
                        var exists = false;

                        for (var j: usize = 0; j < fields.len(); j += 1) {
                            const field = fields.get_const(j).unwrap();

                            if (field->name.str.as_str_const() == item->name.str.as_str_const()) {
                                exists = true;
                                break;
                            }
                        }

                        if (!exists) {
                            diags::report_unknown_field_in_enum_struct_pattern(
                                context->dctx,
                                context->allocator,
                                pattern->span,
                                item->name.str.as_str_const()
                            );
                            error = true;
                        }
                    }

                    if (!error) {
                        for (var i: usize = 0; i < items.len(); i += 1) {
                            const item = items.get_const(i).unwrap();

                            for (var j: usize = 0; j < fields.len(); j += 1) {
                                const field = fields.get_const(j).unwrap();

                                if (field->name.str.as_str_const() == item->name.str.as_str_const()) {
                                    analyze_pattern_recursively(context, &item->pattern, &field->ty);
                                    break;
                                }
                            }
                        }
                    }
                }

                else => {
                    diags::report_enum_variant_kind_mismatch_in_switch_pattern(
                        context->dctx,
                        context->allocator,
                        pattern->span
                    );
                }
            }
        }

        else => {
            diags::report_only_variant_pattern_is_allowed_in_switch(
                context->dctx,
                context->allocator,
                pattern->span
            );
        }
    }

}

fn analyze_export_tuple_values(
    context: AnalyzerContext*,
    export_tuple: cir::TypedTupleExportStmt*
) {
    switch (export_tuple->rhs) case .Some(rhs_val) else {
        diags::report_tuple_destruction_with_no_rhs(context->dctx, context->allocator, export_tuple->span);
        return;
    }

    const expected_type = tuple_type_from_pattern(context, &export_tuple->pattern);

    var rhs = rhs_val;
    const rhs_type_opt = analyze_expr(context, &rhs, expected_type);
    export_tuple->rhs = .Some(rhs);

    if (rhs_type_opt.is_none()) {
        return;
    }

    switch (rhs.ty) {
        case .None => return;
        case .Some(ty_val) => {
            var tuple_type_opt = ty_val.as_tuple_type();

            switch (tuple_type_opt) case .Some(tuple_type) else {
                diags::report_tuple_member_access_on_non_tuple_operand(
                    context->dctx,
                    context->allocator,
                    export_tuple->span
                );
                return;
            }

            switch (export_tuple->pattern.kind) {
                case .Tuple(patterns) => {
                    if (patterns.len() != tuple_type.elements.len()) {
                        diags::report_tuple_exported_values_and_tuple_elements_count_mismatch(
                            context->dctx,
                            context->allocator,
                            export_tuple->span,
                            tuple_type.elements.len(),
                            patterns.len()
                        );
                        return;
                    }

                    var path: Vec<usize> = Vec.new(context->allocator);
                    defer path.free();

                    for (var i: usize = 0; i < patterns.len(); i += 1) {
                        const sub_pattern = patterns.get_const(i).unwrap();
                        const element = tuple_type.elements.get_const(i).unwrap();

                        path.push(i);
                        analyze_tuple_pattern(context,
                            sub_pattern,
                            &element->ty,
                            &rhs,
                            export_tuple->is_const,
                            export_tuple->span,
                            &path
                        );
                        path.pop();
                    }

                }
                else => {}
            }
        }
    }
}

fn analyze_tuple_ident_pattern(
    context: AnalyzerContext*,
    var_decl_id: cir::VarDeclId,
    sema_type: const cir::SemaType*,
    rhs: const cir::TypedExpr*,
    is_const: bool
) {
    const var_decl = context->decl_tables->vars.get(var_decl_id);

    switch (var_decl) {
        case .Some(entry) => {
            entry->ty = .Some(*sema_type);
            entry->rhs = .Some(*rhs);
            entry->is_const = is_const;
        }
        case .None => {}
    }
}

fn analyze_tuple_pattern(
    context: AnalyzerContext*,
    pattern: const cir::TypedTupleExportPattern*,
    sema_type: const cir::SemaType*,
    root_expr: const cir::TypedExpr*,
    stmt_is_const: bool,
    span: Span,
    path: Vec<usize>*
) {
    switch (pattern->ty) {
        case .Some(explicit_type) => {
            if (!is_assignable_to(context, *sema_type, explicit_type, span)) {
                var lhs_str = format::format_sema_type(context->allocator, context->decl_tables, &explicit_type);
                var rhs_str = format::format_sema_type(context->allocator, context->decl_tables, sema_type);

                diags::report_assignment_type_mismatch(
                    context->dctx,
                    context->allocator,
                    span,
                    lhs_str.as_str_const(),
                    rhs_str.as_str_const()
                );

                lhs_str.free();
                rhs_str.free();
                return;
            }
        }
        case .None => {}
    }

    switch (pattern->kind) {
        case .Ident(var_decl_id) => {
            const access_expr = tuple_access_expr(context->allocator, root_expr, path, span);

            var is_const_opt: Option<bool> = .None;
            switch (pattern->constness) {
                case .Some(.Const) => is_const_opt = .Some(true);
                case .Some(.Var) => is_const_opt = .Some(false);
                case .None => {}
            }

            if (is_const_opt.is_some()) {
                const is_const = is_const_opt.unwrap();

                if (is_const == stmt_is_const) {
                    var constness_str = "var";

                    if (is_const) {
                        constness_str = "const";
                    }
                    
                    diags::report_invalid_nested_export_tuple(
                        context->dctx,
                        context->allocator,
                        span,
                        constness_str
                    );
                }
            }

            const final_is_const = is_const_opt.unwrap_or(stmt_is_const);
            analyze_tuple_ident_pattern(context, var_decl_id, sema_type, &access_expr, final_is_const);
        }

        case .Tuple(patterns) => {
            var tuple_type_opt = sema_type->as_tuple_type();

            switch (tuple_type_opt) case .Some(tuple_type) else {
                diags::report_tuple_member_access_on_non_tuple_operand(
                    context->dctx,
                    context->allocator,
                    span
                );
                return;
            }

            if (patterns.len() != tuple_type.elements.len()) {
                diags::report_tuple_exported_values_and_tuple_elements_count_mismatch(
                    context->dctx,
                    context->allocator,
                    span,
                    tuple_type.elements.len(),
                    patterns.len()
                );
                return;
            }

            for (var i: usize = 0; i < patterns.len(); i += 1) {
                const sub_pattern = patterns.get_const(i).unwrap();
                const element = tuple_type.elements.get_const(i).unwrap();

                path->push(i);
                analyze_tuple_pattern(context, sub_pattern, &element->ty, root_expr, stmt_is_const, span, path);
                path->pop();
            }
        }

        case .Ignore => {}
    }
}

/* ************* Normalization ************* */

fn normalize_and_check_type_formation(
    context: AnalyzerContext*,
    ty: cir::SemaType,
    span: Span,
    indirection: uint8
) Option<cir::SemaType> {
    switch (normalize_sema_type(context, ty, span, indirection)) {
        case .Some(ty) => {
            return check_type_formation(context, ty, span);
        }
        case .None => {
            return .None;
        }
    }
}

fn normalize_sema_type(
    context: AnalyzerContext*,
    ty: cir::SemaType,
    span: Span,
    indirection: uint8
) Option<cir::SemaType> {
    switch (ty) {
        case .Unresolved(unresolved) => return normalize_unresolved_type(context, unresolved, span, indirection);
        case .GenericParam(generic_param_id) => return normalize_generic_param(context, generic_param_id);
        case .Named(named_type) => return normalize_named_type(context, &named_type, indirection);
        case .Array(array_type) => return normalize_array(context, array_type, span, indirection);
        case .FuncType(func_type) => return normalize_func_type(context, func_type, indirection);
        case .Tuple(tuple_type) => return normalize_tuple(context, tuple_type, indirection);
        case .Pointer(inner) => return normalize_pointer(context, inner, span, indirection);
        case .Const(inner) => return normalize_const(context, inner, span, indirection);
        case .SelfType(self_type) => return normalize_self_type(context, self_type);
        case .InterfaceObject => return .Some(ty);
        case .Placeholder => return .Some(ty);
        case .InferVar => return .Some(ty);
        case .Plain => return .Some(ty);
        case .Err => return .Some(ty);
    }
}

fn normalize_named_type(
    context: AnalyzerContext*,
    named_type: const cir::NamedType*,
    indirection: uint8
) Option<cir::SemaType> {
    var type_args = cir::TypedTypeArgs.new(context->allocator);
    
    for (var i: usize = 0; i < named_type->type_args.len(); i += 1) {
        const arg = named_type->type_args.get(i).unwrap();
        type_args.push(*arg);
    }

    normalize_type_args(context, &type_args, indirection);

    switch (named_type->type_decl_id) {
        case .Struct(struct_decl_id) => return normalize_struct_decl(context, struct_decl_id, type_args, indirection);
        case .Union(union_decl_id) => return normalize_union_decl(context, union_decl_id, type_args, indirection);
        case .Enum(enum_decl_id) => return normalize_enum_decl(context, enum_decl_id, type_args, indirection);
        else => return .Some(.Named(cir::NamedType {
            type_decl_id: named_type->type_decl_id,
            type_args,
        }));
    }
}

fn normalize_struct_decl(
    context: AnalyzerContext*,
    struct_decl_id: cir::StructDeclId,
    type_args: cir::TypedTypeArgs,
    indirection: uint8
) Option<cir::SemaType> {
    const struct_type: cir::SemaType = .Named(cir::NamedType {
        type_decl_id: .Struct(struct_decl_id),
        type_args,
    });

    const decl = context->decl_tables->structs.get(struct_decl_id).unwrap();

    if (decl->is_normalized) {
        return .Some(struct_type);
    }

    decl->is_normalized = true;

    for (var i: usize = 0; i < decl->fields.len(); i += 1) {
        const field = decl->fields.get(i).unwrap();
        const span = field->span;

        switch (normalize_sema_type(context, field->ty, span, indirection + 1)) {
            case .Some(ty) => field->ty = ty;
            case .None => field->ty = .Err(span);
        }
    }

    return .Some(struct_type);
}

fn normalize_union_decl(
    context: AnalyzerContext*,
    union_decl_id: cir::UnionDeclId,
    type_args: cir::TypedTypeArgs,
    indirection: uint8
) Option<cir::SemaType> {
    const union_type: cir::SemaType = .Named(cir::NamedType {
        type_decl_id: .Union(union_decl_id),
        type_args,
    });

    const decl = context->decl_tables->unions.get(union_decl_id).unwrap();

    if (decl->is_normalized) {
        return .Some(union_type);
    }

    decl->is_normalized = true;

    for (var i: usize = 0; i < decl->fields.len(); i += 1) {
        const field = decl->fields.get(i).unwrap();
        const span = field->span;

        switch (normalize_sema_type(context, field->ty, span, indirection + 1)) {
            case .Some(ty) => field->ty = ty;
            case .None => field->ty = .Err(span);
        }
    }

    return .Some(union_type);
}

fn normalize_enum_decl(
    context: AnalyzerContext*,
    enum_decl_id: cir::EnumDeclId,
    type_args: cir::TypedTypeArgs,
    indirection: uint8
) Option<cir::SemaType> {
    const enum_type: cir::SemaType = .Named(cir::NamedType {
        type_decl_id: .Enum(enum_decl_id),
        type_args,
    });

    const decl = context->decl_tables->enums.get(enum_decl_id).unwrap();

    if (decl->is_normalized) {
        return .Some(enum_type);
    }

    decl->is_normalized = true;

    for (var i: usize = 0; i < decl->variants.len(); i += 1) {
        const variant = decl->variants.get(i).unwrap();

        switch (*variant) {
            case .Valued { value, .. } => {
                analyze_expr(context, value, decl->tag_type);
            }

            case .Tuple { var fields, .. } => {
                for (var j: usize = 0; j < fields.len(); j += 1) {
                    const field = fields.get(j).unwrap();
                    const span = field->span;

                    switch (normalize_sema_type(context,
                        field->ty, 
                        span, 
                        indirection + 1
                    )) {
                        case .Some(ty) => field->ty = ty;
                        case .None => field->ty = .Err(span);
                    }
                }
            }

            case .Struct { var fields, .. } => {
                for (var j: usize = 0; j < fields.len(); j += 1) {
                    const field = fields.get(j).unwrap();
                    const span = field->span;

                    switch (normalize_sema_type(context, field->ty, span, indirection + 1)) {
                        case .Some(ty) => field->ty = ty;
                        case .None => field->ty = .Err(span);
                    }
                }
            }
            else => {}
        }
    }

    return .Some(enum_type);
}

fn normalize_unresolved_type(
    context: AnalyzerContext*,
    unresolved: cir::UnresolvedType,
    span: Span,
    indirection: uint8
) Option<cir::SemaType> {
    switch (unresolved) {
        case .Decl(symbol_id) => {
            const decl_id_opt = context->registry->lookup_symbol_as_decl_id(symbol_id);

            switch (decl_id_opt) {
                case .Some(decl_id) => {
                    switch (cir::decl_id_as_type_decl_id(decl_id)) {
                        case .Some => {
                            return type_of_decl(context, decl_id, span, indirection);
                        }
                        case .None => {
                            var symbol_name = format::format_decl_name(
                                context->allocator,
                                context->decl_tables,
                                &decl_id
                            );

                            diags::report_non_type_symbol(
                                context->dctx,
                                context->allocator,
                                span,
                                symbol_name.as_str_const()
                            );

                            symbol_name.free();
                            return .None;
                        }
                    }
                }
                case .None => return .None;
            }
        }

        case .GenericInst { base_symbol_id, var type_args } => {
            const decl_id = context->registry->lookup_symbol_as_decl_id(base_symbol_id);

            switch (decl_id) {
                case .Some(id) => {
                    switch (cir::decl_id_as_type_decl_id(id)) {
                        case .Some(type_decl_id) => {
                            var args = cir::TypedTypeArgs.new(context->allocator);
                            
                            for (var i: usize = 0; i < type_args.len(); i += 1) {
                                const arg = type_args.get(i).unwrap();
                                args.push(*arg);
                            }

                            normalize_type_args(context, &args, indirection);

                            var named_type = cir::NamedType { type_decl_id, type_args: args };
                            return normalize_named_type(context, &named_type, indirection);
                        }
                        case .None => return .None;
                    }
                }
                case .None => return .None;
            }
        }

        // REVIEW: Refactor this and make a helper for handling
        // builtins in normalization.
        case .BuiltinFunc(builtin_func) => {
            for (var i: usize = 0; i < builtin_func->args.len(); i += 1) {
                const arg = builtin_func->args.get(i).unwrap();
                analyze_expr(context, arg, .None);
            }

            if (builtin_func->name.str.as_str_const() == "typeof") {
                switch (builtin_func->args.first_const()) {
                    case .Some(arg) => {
                        switch (arg->ty) {
                            case .Some(arg_type) => {
                                return .Some(expand_sema_type(context, arg_type, builtin_func->span));
                            }
                            else => {}
                        }
                    }
                    else => {}
                }
            }

            diags::report_builtin_does_not_produce_type(
                context->dctx,
                context->allocator,
                builtin_func->span,
                builtin_func->name.str.as_str_const()
            );
            return .Some(.Err(builtin_func->span));
        }
    }
}

fn normalize_func_type(
    context: AnalyzerContext*,
    func_type: cir::TypedFuncType,
    indirection: uint8
) Option<cir::SemaType> {
    const params_len = func_type.params.list.len();

    var params = cir::TypedFuncTypeParams {
        list: Vec.with_capacity(context->allocator, params_len),
        variadic: .None,
    };

    var failed = false;

    for (var i: usize = 0; i < params_len && !failed; i += 1) {
        const param = func_type.params.list.get_const(i).unwrap();
        
        switch (normalize_sema_type(context, *param, func_type.span, indirection)) {
            case .Some(ty) => params.list.push(ty);
            case .None => failed = true;
        }
    }
    
    if (failed) {
        params.list.free();
        return .None;
    }

    switch (func_type.params.variadic) {
        case .Some(variadic) => {
            switch (*variadic) {
                case .UntypedCStyle => {
                    params.variadic = .Some(alloc_init(
                        context->allocator,
                        cir::TypedFuncTypeVariadicParam.UntypedCStyle
                    ));
                }
                case .Typed(ty) => {
                    switch (normalize_sema_type(context, ty, func_type.span, indirection)) {
                        case .Some(normalized_type) => {
                            params.variadic = .Some(alloc_init(
                                context->allocator,
                                cir::TypedFuncTypeVariadicParam.Typed(normalized_type)
                            ));
                        }
                        case .None => {
                            params.list.free();
                            return .None;
                        }
                    }
                }
            }
        }
        else => {}
    }

    switch (normalize_sema_type(context,
        *func_type.ret_type, 
        func_type.span, 
        indirection
    )) {
        case .Some(ret_type) => {
            return .Some(.FuncType(cir::TypedFuncType {
                params,
                ret_type: alloc_init(context->allocator, ret_type),
                vis: func_type.vis,
                callconv: func_type.callconv,
                span: func_type.span,
            }));
        }
        case .None => {
            params.list.free();
            return .None;
        }
    }
}

fn normalize_tuple(
    context: AnalyzerContext*,
    tuple_type: cir::TypedTupleType,
    indirection: uint8
) Option<cir::SemaType> {
    const elements_len = tuple_type.elements.len();

    var elements: Vec<cir::TypedTupleElement> = Vec.with_capacity(context->allocator, elements_len);

    var failed = false;

    for (var i: usize = 0; i < elements_len && !failed; i += 1) {
        const element = tuple_type.elements.get_const(i).unwrap();

        switch (normalize_sema_type(context, element->ty, element->span, indirection)) {
            case .Some(ty) => {
                elements.push(cir::TypedTupleElement {
                    ty,
                    span: element->span,
                });
            }
            case .None => {
                failed = true;
            }
        }
    }

    if (failed) {
        elements.free();
        return .None;
    }

    return .Some(.Tuple(cir::TypedTupleType {
        elements,
        span: tuple_type.span,
    }));
}

fn normalize_array(
    context: AnalyzerContext*,
    var array_type: cir::TypedArrayType,
    span: Span,
    indirection: uint8
) Option<cir::SemaType> {
    switch (array_type.capacity) {
        case .Fixed(expr) => {
            analyze_expr(context, expr, .None);

            if (expr->literal_const_int_value().is_none()) {
                diags::report_array_capacity_not_const(
                    context->dctx, 
                    context->allocator, 
                    span
                );
                return .None;
            }
        }
        case .Slice => {
            diags::report_unimplemented_feature_slice(
                context->dctx, 
                context->allocator, 
                span
            );
            return .None;
        }
    }

    switch (normalize_sema_type(context, *array_type.element_type, span, indirection)) {
        case .Some(ty) => array_type.element_type = alloc_init(context->allocator, ty);
        case .None => return .None;
    }

    return .Some(.Array(array_type));
}

fn normalize_const(
    context: AnalyzerContext*,
    inner: cir::SemaType*,
    span: Span,
    indirection: uint8
) Option<cir::SemaType> {
    switch (normalize_sema_type(context, *inner, span, indirection)) {
        case .Some(ty) => {
            if (ty.is_const()) {
                return .Some(ty);
            }

            return .Some(.Const(alloc_init(context->allocator, ty)));
        }
        case .None => return .None;
    }
}

fn normalize_pointer(
    context: AnalyzerContext*,
    inner: cir::SemaType*,
    span: Span,
    indirection: uint8
) Option<cir::SemaType> {
    switch (normalize_sema_type(context, *inner, span, indirection + 1)) {
        case .Some(ty) => return .Some(.Pointer(alloc_init(context->allocator, ty)));
        case .None => return .None;
    }
}

fn normalize_generic_param(
    context: AnalyzerContext*,
    generic_param_id: cir::GenericParamId
) Option<cir::SemaType> {
    const bound = generics::lookup_generic_binding(context, generic_param_id);

    switch (bound) {
        case .Some(ty) => {
            switch (context->func_env.infer) {
                case .Some(infer_ctx) => {
                    return .Some(infer_ctx->resolve(&ty));
                }
                case .None => {
                    return .Some(ty);
                }
            }
        }
        case .None => {
            return .Some(.GenericParam(generic_param_id));
        }
    }
}

fn normalize_self_type(
    context: AnalyzerContext*, 
    self_type: cir::TypedSelfType
) Option<cir::SemaType> {
    switch (context->func_env.current_object) {
        case .Some(object_type) => return .Some(object_type);
        case .None => return .Some(.SelfType(self_type));
    }
}

fn normalize_type_args(
    context: AnalyzerContext*, 
    type_args: cir::TypedTypeArgs*, 
    indirection: uint8
) {
    for (var i: usize = 0; i < type_args->len(); i += 1) {
        var arg = type_args->get(i).unwrap();

        switch (*arg) {
            case .Type(inner, span) => {
                switch (normalize_sema_type(context,
                    inner, 
                    span, 
                    indirection
                )) {
                    case .Some(ty) => {
                        *arg = .Type(ty, span);
                    }
                    case .None => {
                        *arg = .Type(.Err(span), span);
                    }
                }
            }
            case .Infer => {}
        }
    }
}

fn normalize_func_params(
    context: AnalyzerContext*,
    params: cir::TypedFuncParams*,
    validate: bool,
    indirection: uint8
) {
    for (var i: usize = 0; i < params->list.len(); i += 1) {
        var kind = params->list.get(i).unwrap();

        switch (*kind) {
            case .FuncParam(var func_param) => {
                switch (normalize_sema_type(context, func_param.ty, func_param.span, indirection)) {
                    case .Some(ty) => {
                        func_param.ty = ty;

                        if (validate) {
                            validate_param_type(context, &ty, func_param.span);
                        }
                        *kind = .FuncParam(func_param);
                    }
                    else => {}
                }
            }
            case .SelfModifier(var self_modifier) => {
                switch (normalize_sema_type(context, self_modifier.ty, self_modifier.span, indirection)) {
                    case .Some(ty) => {
                        self_modifier.ty = ty;

                        if (validate) {
                            validate_param_type(context, &ty, self_modifier.span);
                        }
                        *kind = .SelfModifier(self_modifier);
                    }
                    else => {}
                }
            }
        }
    }

    switch (params->variadic) {
        case .Some(.Typed { var_decl_id, ty, span }) => {
            switch (normalize_sema_type(context, ty, span, indirection)) {
                case .Some(normalized_type) => {
                    if (validate) {
                        validate_param_type(context, &normalized_type, span);
                    }

                    params->variadic = .Some(cir::TypedFuncVariadicParam.Typed {
                            var_decl_id,
                            ty: normalized_type,
                            span,
                    });
                }
                case .None => return;
            }
        }
        else => {}
    }
}

fn normalize_func_type_params(
    context: AnalyzerContext*,
    params: cir::TypedFuncTypeParams*,
    span: Span,
    indirection: uint8
) {
    for (var i: usize = 0; i < params->list.len(); i += 1) {
        var param = params->list.get(i).unwrap();

        switch (normalize_sema_type(context, *param, span, indirection)) {
            case .Some(normalized_type) => {
                *param = normalized_type;
                validate_param_type(context, &normalized_type, span);
            }
            case .None => return;
        }
    }

    switch (params->variadic) {
        case .Some(variadic) => {
            switch (*variadic) {
                case .Typed(ty) => {
                    switch (normalize_sema_type(context, ty, span, indirection)) {
                        case .Some(normalized_type) => {
                            validate_param_type(context, &normalized_type, span);
                            *variadic = cir::TypedFuncTypeVariadicParam.Typed(normalized_type);
                        }
                        case .None => return;
                    }
                }
                else => {}
            }
        }
        else => {}
    }
}

/* ************* Enum Init ************* */

fn analyze_enum_init(
    context: AnalyzerContext*,
    enum_init: cir::TypedEnumInit*,
    expected_type: Option<cir::SemaType>
) Option<cir::SemaType> {
    var operand: cir::SemaType = .Placeholder;

    switch (normalize_and_check_type_formation(context, enum_init->operand, enum_init->span, 0)) {
        case .Some(ty) => operand = ty;
        case .None => return .None;
    }

    operand = expand_sema_type(context, operand, enum_init->span);

    switch (operand.as_named_type()) case .Some(named_type) else {
        var type_name = format::format_sema_type(context->allocator, context->decl_tables, &operand);
        diags::report_non_enum_symbol(
            context->dctx,
            context->allocator,
            enum_init->span,
            type_name.as_str_const()
        );
        type_name.free();
        return .None;
    }

    switch (named_type.type_decl_id.as_enum()) case .Some(enum_decl_id) else {
        var type_name = format::format_sema_type(context->allocator, context->decl_tables, &operand);
        diags::report_non_enum_symbol(
            context->dctx,
            context->allocator,
            enum_init->span,
            type_name.as_str_const()
        );
        type_name.free();
        return .None;
    }
    const enum_decl = context->decl_tables->enums.get_const(enum_decl_id).unwrap();

    var enum_name = format::format_enum_decl(context->allocator, context->registry, context->decl_tables, enum_decl);
    defer enum_name.free();

    switch (enum_decl->lookup_variant(enum_init->name.as_str_const())) case .Some(variant) else {
        diags::report_no_such_enum_variant(
            context->dctx,
            context->allocator,
            enum_init->span,
            enum_name.as_str_const(),
            enum_init->name.as_str_const()
        );
        return .None;   
    }

    const generic_env_opt = create_inference_generic_env(context,
        enum_name.as_str_const(),
        enum_decl->generic_params,
        &named_type.type_args,
        enum_init->span
    );

    switch (generic_env_opt) case .Some(generic_env) else {
        return .None;
    }

    generics::push_generic_env(context, generic_env);
    const result = analyze_enum_init_inner(context,
        enum_init,
        expected_type,
        variant,
        enum_decl_id,
        &enum_decl->generic_params
    );
    generics::pop_generic_env(context);
    return result;
}

fn analyze_enum_init_inner(
    context: AnalyzerContext*,
    enum_init: cir::TypedEnumInit*,
    expected_type: Option<cir::SemaType>,
    variant: const cir::TypedEnumVariant*,
    enum_decl_id: cir::EnumDeclId,
    generic_params: const cir::TypedGenericParams*
) Option<cir::SemaType> {
    var handled = false;

    switch (enum_init->arg) {
        case .Unit => {
            switch (*variant) {
                case .Unit | .Valued => handled = true;
                else => {}
            }
        }
        case .Tuple(var elements) => {
            switch (*variant) {
                case .Tuple { fields, .. } => {
                    handled = true;

                    if (elements.len() != fields.len()) {
                        diags::report_enum_variant_arg_count_mismatch(
                            context->dctx,
                            context->allocator,
                            enum_init->span,
                            enum_init->name.as_str_const(),
                            @cast(uint32, fields.len()),
                            @cast(uint32, elements.len())
                        );
                        return .None;
                    }

                    for (var i: usize = 0; i < elements.len(); i += 1) {
                        const element = elements.get(i).unwrap();
                        const field = fields.get_const(i).unwrap();
                        analyze_field_assign(context, element, field->ty, field->span);
                    }
                }
                else => {}
            }
        }
        case .Struct(field_inits) => {
            switch (*variant) {
                case .Struct { fields, .. } => {
                    handled = true;
                    analyze_enum_struct_variant_fields(context,
                        enum_init->name.as_str_const(),
                        &field_inits,
                        &fields,
                        enum_init->span
                    );
                }
                else => {}
            }
        }
    }

    if (!handled) {
        var variant_is_fielded = false;
        var variant_kind = "unit";

        switch (*variant) {
            case .Valued { .. } => {
                variant_kind = "valued";
            }
            case .Unit => {
                variant_kind = "unit";
            }
            case .Tuple { .. } => {
                variant_kind = "tuple";
                variant_is_fielded = true;
            }
            case .Struct { .. } => {
                variant_kind = "struct";
                variant_is_fielded = true;
            }
        }

        if (!variant_is_fielded) {
            diags::report_enum_variant_does_not_accept_fields(
                context->dctx,
                context->allocator,
                enum_init->span,
                enum_init->name.as_str_const()
            );
            return .None;
        }

        const kind = enum_init->arg.to_str();

        diags::report_enum_variant_kind_mismatch(
            context->dctx,
            context->allocator,
            enum_init->span,
            enum_init->name.as_str_const(),
            variant_kind,
            kind
        );
        return .None;
    }

    const inferred_type_args = instantiated_type_args(context, *generic_params);

    unify_with_expected_type(context,
        .Named(cir::NamedType {
            type_decl_id: .Enum(enum_decl_id),
            type_args: inferred_type_args,
        }),
        expected_type
    );

    apply_generic_defaults(context, *generic_params);

    const final_type_args = instantiated_type_args(context, *generic_params);
    const final_type: cir::SemaType = .Named(cir::NamedType {
        type_decl_id: .Enum(enum_decl_id),
        type_args: final_type_args,
    });

    enum_init->operand = final_type;
    return .Some(final_type);
}

fn analyze_unnamed_enum_value(
    context: AnalyzerContext*,
    enum_value: cir::TypedUnnamedEnumValue*,
    expected_type: Option<cir::SemaType>
) Option<cir::SemaType> {
    var enum_decl_id_opt: Option<cir::EnumDeclId> = .None;
    var type_args: cir::TypedTypeArgs = cir::TypedTypeArgs.new(context->allocator);

    switch (expected_type) {
        case .Some(ty) => {
            switch (ty.as_named_type()) {
                case .Some(named_type) => {
                    switch (named_type.type_decl_id.as_enum()) {
                        case .Some(enum_decl_id) => {
                            enum_decl_id_opt = .Some(enum_decl_id);
                            type_args = named_type.type_args;
                        }
                        case .None => {}
                    }
                }
                case .None => {}
            }
        }
        case .None => {}
    }

    switch (enum_decl_id_opt) case .Some(enum_decl_id) else {
        diags::report_cannot_infer_enum_for_unnamed_variant(
            context->dctx,
            context->allocator,
            enum_value->span,
            enum_value->ident.str.as_str_const()
        );
        return .None;
    }
    const enum_decl = context->decl_tables->enums.get_const(enum_decl_id).unwrap();

    var enum_name = format::format_enum_decl(context->allocator, context->registry, context->decl_tables, enum_decl);
    defer enum_name.free();

    const variant_opt = enum_decl->lookup_variant(enum_value->ident.str.as_str_const());

    switch (variant_opt) case .Some(variant) else {
        diags::report_no_such_enum_variant(
            context->dctx,
            context->allocator,
            enum_value->span,
            enum_name.as_str_const(),
            enum_value->ident.str.as_str_const()
        );
        return .None;
    }

    const generic_env_opt = create_inference_generic_env(context,
        enum_name.as_str_const(),
        enum_decl->generic_params,
        &type_args,
        enum_value->span
    );

    switch (generic_env_opt) case .Some(generic_env) else {
        return .None;
    }

    generics::push_generic_env(context, generic_env);
    const result = analyze_unnamed_enum_value_inner(context,
        enum_value,
        expected_type,
        variant,
        enum_decl_id,
        &enum_decl->generic_params
    );
    generics::pop_generic_env(context);
    return result;
}

fn analyze_unnamed_enum_value_inner(
    context: AnalyzerContext*,
    enum_value: cir::TypedUnnamedEnumValue*,
    expected_type: Option<cir::SemaType>,
    variant: const cir::TypedEnumVariant*,
    enum_decl_id: cir::EnumDeclId,
    generic_params: const cir::TypedGenericParams*
) Option<cir::SemaType> {
    var handled = false;

    switch (enum_value->kind) {
        case .Unit => {
            switch (*variant) {
                case .Unit | .Valued => handled = true;
                else => {}
            }
        }
        case .Tuple(var elements) => {
            switch (*variant) {
                case .Tuple { fields, .. } => {
                    handled = true;

                    if (elements.len() != fields.len()) {
                        diags::report_enum_variant_arg_count_mismatch(
                            context->dctx,
                            context->allocator,
                            enum_value->span,
                            enum_value->ident.str.as_str_const(),
                            @cast(uint32, fields.len()),
                            @cast(uint32, elements.len())
                        );
                        return .None;
                    }

                    for (var i: usize = 0; i < elements.len(); i += 1) {
                        const element = elements.get(i).unwrap();
                        const field = fields.get_const(i).unwrap();

                        analyze_field_assign(context, element, field->ty, field->span);
                    }
                }
                else => {}
            }
        }
        case .Struct(field_inits) => {
            switch (*variant) {
                case .Struct { fields, .. } => {
                    handled = true;

                    analyze_enum_struct_variant_fields(context,
                        enum_value->ident.str.as_str_const(),
                        &field_inits,
                        &fields,
                        enum_value->span
                    );
                }
                else => {}
            }
        }
    }

    if (!handled) {
        var variant_is_fielded = false;
        var variant_kind = "unit";

        switch (*variant) {
            case .Unit => variant_kind = "unit";
            case .Valued { .. } => variant_kind = "valued";
            case .Tuple { .. } => {
                variant_kind = "tuple";
                variant_is_fielded = true;
            }
            case .Struct { .. } => {
                variant_kind = "struct";
                variant_is_fielded = true;
            }
        }

        if (!variant_is_fielded) {
            diags::report_enum_variant_does_not_accept_fields(
                context->dctx,
                context->allocator,
                enum_value->span,
                enum_value->ident.str.as_str_const()
            );
            return .None;
        }

        const kind = enum_value->kind.to_str();

        diags::report_enum_variant_kind_mismatch(
            context->dctx,
            context->allocator,
            enum_value->span,
            enum_value->ident.str.as_str_const(),
            variant_kind,
            kind
        );
        return .None;
    }

    enum_value->enum_decl_id = .Some(enum_decl_id);

    switch (expected_type) {
        case .Some(ty) => return .Some(ty);
        case .None => return .None;
    }
}

fn analyze_enum_struct_variant_init(
    context: AnalyzerContext*,
    struct_variant_init: cir::TypedEnumStructVariantInit*
) Option<cir::SemaType> {
    var decl_id_opt: Option<cir::DeclId> = .None;
    switch (struct_variant_init->operand->kind.as_unresolved_symbol_id()) {
        case .Some(symbol_id) => {
            decl_id_opt = context->registry->lookup_symbol_as_decl_id(symbol_id);
        }
        case .None => {}
    }

    switch (decl_id_opt) case .Some(decl_id) else {
        var expr_str = format::format_typed_expr(
            context->allocator,
            context->registry,
            context->decl_tables,
            struct_variant_init->operand
        );

        diags::report_invalid_enum_constructor_target(
            context->dctx,
            context->allocator,
            struct_variant_init->span,
            expr_str.as_str_const()
        );

        expr_str.free();
        return .None;
    }

    switch (decl_id.as_enum()) case .Some(enum_decl_id) else {
        var type_name = format::format_decl_name(context->allocator, context->decl_tables, &decl_id);

        diags::report_non_enum_symbol(
            context->dctx,
            context->allocator,
            struct_variant_init->span,
            type_name.as_str_const()
        );

        type_name.free();
        return .None;
    }
    const enum_decl = context->decl_tables->enums.get_const(enum_decl_id).unwrap();

    switch (enum_decl->lookup_variant(struct_variant_init->ident.str.as_str_const())) case .Some(variant) else {
        var type_name = format::format_decl_name(context->allocator, context->decl_tables, &decl_id);

        diags::report_no_such_enum_variant(
            context->dctx,
            context->allocator,
            struct_variant_init->span,
            type_name.as_str_const(),
            struct_variant_init->ident.str.as_str_const()
        );

        type_name.free();
        return .None;
    }

    var variant_is_struct = false;
    var variant_kind = "unit";

    switch (*variant) {
        case .Valued { .. } => variant_kind = "valued";
        case .Tuple { .. } => variant_kind = "tuple";
        case .Unit => variant_kind = "unit";
        case .Struct { fields, .. } => {
            variant_is_struct = true;

            analyze_enum_struct_variant_fields(context,
                struct_variant_init->ident.str.as_str_const(),
                &struct_variant_init->field_inits,
                &fields,
                struct_variant_init->span
            );
        }
    }

    if (!variant_is_struct) {
        diags::report_enum_variant_kind_mismatch(
            context->dctx,
            context->allocator,
            struct_variant_init->span,
            struct_variant_init->ident.str.as_str_const(),
            "struct",
            variant_kind
        );
        return .None;
    }

    struct_variant_init->enum_decl_id = .Some(enum_decl_id);

    return .Some(.Named(cir::NamedType {
        type_decl_id: .Enum(enum_decl_id),
        type_args: cir::TypedTypeArgs.new(context->allocator),
    }));
}

fn analyze_enum_struct_variant_fields(
    context: AnalyzerContext*,
    variant_name: const uint8*,
    field_inits: const Vec<cir::TypedEnumStructVariantFieldInit>*,
    fields: const Vec<cir::TypedEnumVariantStructField>*,
    span: Span
) {
    for (var i: usize = 0; i < field_inits->len(); i += 1) {
        const field_init = field_inits->get_const(i).unwrap();
        const field_name = field_init->name.str.as_str_const();

        var is_duplicate = false;

        for (var j: usize = 0; j < i; j += 1) {
            const field = field_inits->get_const(j).unwrap();

            if (field->name.str.as_str_const() == field_name) {
                is_duplicate = true;
                break;
            }
        }
        if (is_duplicate) {
            diags::report_duplicate_field_initializer(
                context->dctx,
                context->allocator,
                field_init->span,
                field_name
            );
            continue;
        }

        var variant_opt: Option<const cir::TypedEnumVariantStructField*> = .None;

        for (var k: usize = 0; k < fields->len(); k += 1) {
            const field = fields->get_const(k).unwrap();

            if (field->name.str.as_str_const() == field_name) {
                variant_opt = .Some(field);
                break;
            }
        }

        switch (variant_opt) {
            case .Some(field) => {
                analyze_field_assign(context,
                    field_init->value, 
                    field->ty, 
                    field->span
                );
            }
            case .None => {
                diags::report_invalid_enum_variant_field(
                    context->dctx,
                    context->allocator,
                    field_init->span,
                    variant_name,
                    field_name
                );
            }
        }
    }

    for (var k: usize = 0; k < fields->len(); k += 1) {
        const declared_field = fields->get_const(k).unwrap();

        var found = false;

        for (var i: usize = 0; i < field_inits->len(); i += 1) {
            const field_init = field_inits->get_const(i).unwrap();
            
            if (field_init->name.str.as_str_const() == declared_field->name.str.as_str_const()) {
                found = true;
                break;
            }
        }

        if (!found) {
            diags::report_missing_enum_variant_field(
                context->dctx,
                context->allocator,
                span,
                declared_field->name.str.as_str_const(),
                variant_name
            );
        }
    }
}

/* ************* Type Arity Check ************* */

pub fn check_type_arity(
    context: AnalyzerContext*, 
    ty: cir::SemaType, 
    span: Span
) bool {
    if (ty.is_err()) {
        return true;
    }

    return check_type_arity_recursively(context, &ty, span);
}

fn check_type_arity_recursively(
    context: AnalyzerContext*, 
    ty: const cir::SemaType*, 
    span: Span
) bool {
    switch (*ty) {
        case .Named(named_type) => {
            if (check_missing_type_args(context, &named_type, span)) {
                return false;
            }
            if (check_unresolved_infer_vars(context, &named_type, span)) {
                return false;
            }

            for (var i: usize = 0; i < named_type.type_args.len(); i += 1) {
                const arg = named_type.type_args.get(i).unwrap();
                
                switch (*arg) {
                    case .Type(inner, inner_span) => {
                        if (!check_type_arity_recursively(context, &inner, inner_span)) {
                            return false;
                        }
                    }
                    case .Infer => {}
                }
            }

            switch (named_type.type_decl_id) {
                case .Interface(interface_decl_id) => {
                    const interface_decl = 
                        context->decl_tables->interfaces.get_const(interface_decl_id).unwrap();
                    
                    if (!interface_decl->is_interface_dynamically_dispatchable) {
                        diags::report_not_dynamic_compatible_interface(
                            context->dctx,
                            context->allocator,
                            span,
                            interface_decl->name.as_str_const()
                        );
                        return false;
                    }
                }
                else => {}
            }

            return true;
        }

        case .Array(array_type) => {
            return check_type_arity_recursively(context, array_type.element_type, array_type.span);
        }

        case .FuncType(func_type) => {
            for (var i: usize = 0; i < func_type.params.list.len(); i += 1) {
                const param = func_type.params.list.get_const(i).unwrap();
                
                if (!check_type_arity_recursively(context, param, func_type.span)) {
                    return false;
                }
            }
            
            return check_type_arity_recursively(context, func_type.ret_type, func_type.span);
        }

        case .Tuple(tuple_type) => {
            for (var i: usize = 0; i < tuple_type.elements.len(); i += 1) {
                const element = tuple_type.elements.get_const(i).unwrap();
                
                if (!check_type_arity_recursively(context, &element->ty, tuple_type.span)) {
                    return false;
                }
            }
            return true;
        }

        case .Pointer(inner) => return check_type_arity_recursively(context, inner, span);
        
        case .Const(inner) => return check_type_arity_recursively(context, inner, span);

        case .Plain
        | .SelfType
        | .InterfaceObject
        | .GenericParam
        | .InferVar
        | .Unresolved
        | .Err
        | .Placeholder => return true;
    }
}

/* ************* Type Formation Check ************* */

pub fn check_type_formation(
    context: AnalyzerContext*, 
    ty: cir::SemaType, 
    span: Span
) Option<cir::SemaType> {
    if (ty.is_err()) {
        return .None;
    }

    var error = false;

    check_type_formation_recuresively(context, &ty, span, &error);

    if (error) {
        return .None;
    }

    return .Some(ty);
}

fn check_type_formation_recuresively(
    context: AnalyzerContext*, 
    ty: const cir::SemaType*, 
    span: Span, 
    error: bool*
) {
    if (ty->count_const_layers() > 1) {
        diags::report_redundant_const_qualifier(
            context->dctx, 
            context->allocator, 
            span
        );
        *error = true;
    }

    switch (*ty) {
        case .Named(named_type) => {
            check_unexpected_type_args(context, &named_type, span);

            for (var i: usize = 0; i < named_type.type_args.len(); i += 1) {
                const arg = named_type.type_args.get(i).unwrap();
                
                switch (*arg) {
                    case .Type(inner, _) => {
                        check_type_formation_recuresively(context, &inner, span, error);
                    }
                    case .Infer => {}
                }
            }

            switch (named_type.type_decl_id) {
                case .Union(union_decl_id) => {
                    const union_decl = context->decl_tables->unions.get_const(union_decl_id).unwrap();
                    
                    if (union_decl->fields.is_empty()) {
                        diags::report_union_type_must_contain_at_least_one_field(
                            context->dctx,
                            context->allocator,
                            span
                        );
                        *error = true;
                    }
                }
                else => {}
            }
        }

        case .Array(array_type) => {
            if (array_type.element_type->is_void()) {
                diags::report_void_element_type_not_allowed(
                    context->dctx,
                    context->allocator,
                    array_type.span
                );
                *error = true;
            }

            check_type_formation_recuresively(context, array_type.element_type, span, error);
        }

        case .FuncType(func_type) => {
            for (var i: usize = 0; i < func_type.params.list.len(); i += 1) {
                const param = func_type.params.list.get_const(i).unwrap();
                
                if (param->is_void()) {
                    diags::report_void_parameter_type(context->dctx, context->allocator, func_type.span);
                    *error = true;
                }
                
                check_type_formation_recuresively(context, param, span, error);
            }

            check_type_formation_recuresively(context, func_type.ret_type, span, error);
        }

        case .Tuple(tuple_type) => {
            for (var i: usize = 0; i < tuple_type.elements.len(); i += 1) {
                const element = tuple_type.elements.get_const(i).unwrap();
                
                if (element->ty.is_void()) {
                    diags::report_void_tuple_element_not_allowed(
                        context->dctx,
                        context->allocator,
                        tuple_type.span
                    );
                    *error = true;
                }
                
                check_type_formation_recuresively(context, &element->ty, span, error);
            }
        }

        case .SelfType => {
            if (context->func_env.current_object.is_none()) {
                diags::report_self_type_outside_of_an_object(
                    context->dctx, 
                    context->allocator, 
                    span
                );
                *error = true;
            }
        }

        case .Const(inner) => {
            check_type_formation_recuresively(context, inner, span, error);
        }
        
        case .Pointer(inner) => {
            check_type_formation_recuresively(context, inner, span, error);
        }

        case .Plain
        | .InterfaceObject
        | .GenericParam
        | .InferVar
        | .Unresolved
        | .Err
        | .Placeholder => {}
    }
}

fn check_unexpected_type_args(
    context: AnalyzerContext*, 
    named_type: const cir::NamedType*, 
    span: Span
) bool {
    const generic_params = tables::type_decl_generic_params(
        context->decl_tables,
        named_type->type_decl_id
    );

    if (generic_params->is_empty() && !named_type->type_args.is_empty()) {
        const ty = named_type->as_sema_type();

        var type_name = format::format_sema_type(
            context->allocator,
            context->decl_tables,
            &ty
        );

        diags::report_unexpected_type_args(
            context->dctx,
            context->allocator,
            span,
            type_name.as_str_const()
        );

        type_name.free();
        return true;
    }

    return false;
}

fn check_missing_type_args(
    context: AnalyzerContext*, 
    named_type: const cir::NamedType*, 
    span: Span
) bool {
    var error = false;

    const generic_params = tables::type_decl_generic_params(context->decl_tables, named_type->type_decl_id);
    const ty = named_type->as_sema_type();

    for (var i: usize = 0; i < generic_params->len(); i += 1) {
        const param_id = generic_params->ids.get_const(i).unwrap();

        const type_arg = named_type->type_args.get(i);

        switch (type_arg) {
            case .Some(arg) => {
                const generic_param = context->decl_tables->generic_params.get_const(*param_id).unwrap();

                switch (*arg) {
                    case .Type(ty, _) => {
                        if (ty.contains_generic_param()) {
                            error = true;
                            diags::report_unresolved_generic_parameter(
                                context->dctx,
                                context->allocator,
                                span,
                                generic_param->name.str.as_str_const()
                            );
                        }
                    }
                    case .Infer => {
                        error = true;
                        diags::report_unresolved_generic_parameter(
                            context->dctx,
                            context->allocator,
                            span,
                            generic_param->name.str.as_str_const()
                        );
                    }
                }
            }
            case .None => {
                error = true;

                const param = context->decl_tables->generic_params.get_const(*param_id).unwrap();
                
                var type_name = format::format_sema_type(
                    context->allocator,
                    context->decl_tables,
                    &ty
                );

                diags::report_missing_generic_argument(
                    context->dctx,
                    context->allocator,
                    span,
                    type_name.as_str_const(),
                    param->name.str.as_str_const()
                );

                type_name.free();
            }
        }
    }

    return error;
}

fn check_unresolved_infer_vars(
    context: AnalyzerContext*, 
    named_type: const cir::NamedType*, 
    span: Span
) bool {
    var error = false;

    const generic_params = tables::type_decl_generic_params(context->decl_tables, named_type->type_decl_id);
    const ty = named_type->as_sema_type();

    for (var i: usize = 0; i < generic_params->len(); i += 1) {
        const param_id = generic_params->ids.get_const(i).unwrap();

        const type_arg = named_type->type_args.get(i);
        
        switch (type_arg) {
            case .Some(arg) => {
                const generic_param = context->decl_tables->generic_params.get_const(*param_id).unwrap();

                switch (*arg) {
                    case .Type(ty, _) => {
                        if (ty.contains_infer_var()) {
                            error = true;

                            var type_name = format::format_sema_type(
                                context->allocator,
                                context->decl_tables,
                                &ty
                            );

                            diags::report_cannot_infer_generic_argument(
                                context->dctx,
                                context->allocator,
                                span,
                                type_name.as_str_const(),
                                generic_param->name.str.as_str_const()
                            );

                            type_name.free();
                        }
                    }
                    case .Infer => {
                        error = true;

                        var type_name = format::format_sema_type(
                            context->allocator,
                            context->decl_tables,
                            &ty
                        );

                        diags::report_cannot_infer_generic_argument(
                            context->dctx,
                            context->allocator,
                            span,
                            type_name.as_str_const(),
                            generic_param->name.str.as_str_const()
                        );

                        type_name.free();
                    }
                }
            }
            else => {}
        }
    }

    return error;
}

/* ************* Type Correctness Check ************* */

pub fn check_type_correctness(
    context: AnalyzerContext*, 
    ty: cir::SemaType, 
    span: Span
) bool {
    if (ty.is_err()) {
        return true;
    }

    return check_type_correctness_recursively(context, &ty, span);
}

fn check_type_correctness_recursively(
    context: AnalyzerContext*, 
    ty: const cir::SemaType*, 
    span: Span
) bool {
    switch (*ty) {
        case .Named(named_type) => {
            if (check_missing_type_args(context, &named_type, span)) {
                return false;
            }
            if (check_unresolved_infer_vars(context, &named_type, span)) {
                return false;
            }

            for (var i: usize = 0; i < named_type.type_args.len(); i += 1) {
                const arg = named_type.type_args.get(i).unwrap();
                
                switch (*arg) {
                    case .Type(inner, inner_span) => {
                        if (!check_type_correctness_recursively(context, &inner, inner_span)) {
                            return false;
                        }
                    }
                    case .Infer => {}
                }
            }

            return true;
        }

        case .FuncType(func_type) => {
            for (var i: usize = 0; i < func_type.params.list.len(); i += 1) {
                const param = func_type.params.list.get_const(i).unwrap();
                
                if (!check_type_correctness_recursively(context, param, func_type.span)) {
                    return false;
                }
            }

            return check_type_correctness_recursively(context, func_type.ret_type, func_type.span);
        }

        case .Tuple(tuple_type) => {
            for (var i: usize = 0; i < tuple_type.elements.len(); i += 1) {
                const element = tuple_type.elements.get_const(i).unwrap();
                
                if (!check_type_correctness_recursively(context, &element->ty, tuple_type.span)) {
                    return false;
                }
            }

            return true;
        }

        case .Array(array_type) => {
            return check_type_correctness_recursively(context, 
                array_type.element_type,
                array_type.span
            );
        }

        case .Pointer(inner) => {
            return check_type_correctness_recursively(context, inner, span);
        }

        case .Const(inner) => {
            return check_type_correctness_recursively(context, inner, span);
        }

        else => return true;
    }
}

/* ************* Type Of Decl ************* */

pub fn type_of_decl(
    context: AnalyzerContext*,
    decl_id: cir::DeclId,
    span: Span,
    indirection: uint8
) Option<cir::SemaType> {
    const key = cir::decl_id_key(decl_id);

    switch (context->type_cache.get(key)) {
        case .Some(ty) => return .Some(ty);
        else => {}
    }

    switch (context->type_cache.enter(key, indirection)) {
        case .AlreadyResolving(frame_indirection) => {
            // Indirection makes recursion legal
            if (frame_indirection > 0 || indirection > 0) {
                switch (cir::decl_id_as_type_decl_id(decl_id)) {
                    case .Some(type_decl_id) => {
                        return .Some(.Named(cir::NamedType {
                            type_decl_id,
                            type_args: cir::TypedTypeArgs.new(context->allocator),
                        }));
                    }
                    case .None => return .None;
                }
            }

            var symbol_name = format::format_decl_name(
                context->allocator, 
                context->decl_tables, 
                &decl_id
            );

            var cycle: Vec<String> = Vec.new(context->allocator);
            cycle.push(symbol_name);

            diags::report_cyclic_type_definition(
                context->dctx,
                context->allocator,
                span,
                &cycle
            );

            free_strings(&cycle);
            return .None;
        }
        case .Entered => {}
    }

    const raw_type = type_of_decl_internal(context, decl_id, indirection);
    
    switch (raw_type) {
        case .Some(raw) => {
            switch (normalize_sema_type(context, raw, span, indirection)) {
                case .Some(ty) => {
                    context->type_cache.leave(key, ty);
                    return .Some(ty);
                }
                case .None => return .None;
            }
        }
        case .None => return .None;
    }
}

fn type_of_decl_internal(
    context: AnalyzerContext*,
    decl_id: cir::DeclId,
    indirection: uint8
) Option<cir::SemaType> {
    switch (decl_id) {
        case .GlobalVar(global_var_decl_id) => {
            const global_var_decl =
                context->decl_tables->global_vars.get_const(global_var_decl_id).unwrap();

            return global_var_decl->ty;
        }
        case .Var(var_decl_id) => {
            const var_decl = context->decl_tables->vars.get_const(var_decl_id).unwrap();
            return var_decl->ty;
        }
        case .Func(func_decl_id) => {
            const func_decl = context->decl_tables->funcs.get_const(func_decl_id).unwrap();
            const func_type = cir::func_decl_as_func_type(context->allocator, func_decl);
            return normalize_func_type(context, func_type, indirection);
        }
        case .Struct(struct_decl_id) => {
            return .Some(.Named(cir::NamedType {
                type_decl_id: .Struct(struct_decl_id),
                type_args: cir::TypedTypeArgs.new(context->allocator),
            }));
        }
        case .Enum(enum_decl_id) => {
            return .Some(.Named(cir::NamedType {
                type_decl_id: .Enum(enum_decl_id),
                type_args: cir::TypedTypeArgs.new(context->allocator),
            }));
        }
        case .Union(union_decl_id) => {
            return .Some(.Named(cir::NamedType {
                type_decl_id: .Union(union_decl_id),
                type_args: cir::TypedTypeArgs.new(context->allocator),
            }));
        }
        case .Typedef(typedef_decl_id) => {
            return .Some(.Named(cir::NamedType {
                type_decl_id: .Typedef(typedef_decl_id),
                type_args: cir::TypedTypeArgs.new(context->allocator),
            }));
        }
        case .Interface(interface_decl_id) => {
            return .Some(.Named(cir::NamedType {
                type_decl_id: .Interface(interface_decl_id),
                type_args: cir::TypedTypeArgs.new(context->allocator),
            }));
        }
        case .Method => {
            // Methods never appear here 
            // (guarded by as_type_decl_id)
            return .None;
        }
    }
}

/* ************* Assignability ************* */

pub fn is_assignable_to(
    context: AnalyzerContext*,
    rhs_type: cir::SemaType,
    lhs_type: cir::SemaType,
    span: Span
) bool {
    if (rhs_type.contains_error() || lhs_type.contains_error()) {
        return true;
    }

    const expanded_lhs = expand_sema_type(context, lhs_type, span);
    const expanded_rhs = expand_sema_type(context, rhs_type, span);

    // T* <-> T* (Constness matters)
    switch (expanded_rhs) {
        case .Pointer(inner1) => {
            switch (expanded_lhs) {
                case .Pointer(inner2) => {
                    const is_lhs_const = inner2->is_const();
                    const is_rhs_const = inner1->is_const();

                    if (!is_lhs_const && is_rhs_const) {
                        return false;
                    }

                    if (inner1->is_void() || inner2->is_void()) {
                        return true;
                    }

                    return is_assignable_to(context, *inner1, *inner2, span);
                }
                else => {}
            }
        }
        else => {}
    }

    const rhs_inner = expanded_rhs.const_inner();
    const lhs_inner = expanded_lhs.const_inner();

    if (rhs_inner->is_err() || lhs_inner->is_err()) {
        return true;
    }

    // null -> T*
    switch (*rhs_inner) {
        case .Plain(.Null) => {
            switch (*lhs_inner) {
                case .Pointer => return true;
                else => {}
            }
        }
        else => {}
    }

    switch (*rhs_inner) {
        case .Plain(p1) => {
            switch (*lhs_inner) {
                case .Plain(p2) => return is_plain_type_assignable_to(p1, p2);
                else => return false;
            }
        }

        case .InterfaceObject(interface_object1) => {
            switch (*lhs_inner) {
                case .InterfaceObject(interface_object2) => {
                    return is_named_type_assignable_to(context, 
                        &interface_object1.interface_type,
                        &interface_object2.interface_type,
                        span
                    );
                }
                case .Named(named_type2) => {
                    return is_named_type_assignable_to(context, 
                        &interface_object1.interface_type,
                        &named_type2,
                        span
                    );
                }
                else => return false;
            }
        }

        case .Named(named_type1) => {
            switch (*lhs_inner) {
                case .Named(named_type2) => {
                    return is_named_type_assignable_to(context, &named_type1, &named_type2, span);
                }
                else => return false;
            }
        }

        case .Array(array_type1) => {
            switch (*lhs_inner) {
                case .Array(array_type2) => {
                    if (!is_const_str_assignable_to_array(context, &array_type1, &array_type2)) {
                        return false;
                    }
                    return is_assignable_to(context, 
                        *array_type1.element_type,
                        *array_type2.element_type,
                        span
                    );
                }
                
                // Array-to-pointer decay
                case .Pointer(inner) => {
                    return is_assignable_to(context, *array_type1.element_type, *inner, span);
                }

                else => return false;
            }
        }

        case .Tuple(tuple_type1) => {
            switch (*lhs_inner) {
                case .Tuple(tuple_type2) => {
                    return cir::tuple_type_eq(&tuple_type1, &tuple_type2);
                }
                else => {
                    return false;
                }
            }
        }

        case .FuncType(func_type1) => {
            switch (*lhs_inner) {
                case .FuncType(func_type2) => {
                    return cir::func_type_eq(&func_type1, &func_type2);
                }
                else => {
                    return false;
                }
            }
        }

        else => return false;
    }
}

fn is_named_type_assignable_to(
    context: AnalyzerContext*,
    named_type1: const cir::NamedType*,
    named_type2: const cir::NamedType*,
    span: Span
) bool {
    switch (named_type1->type_decl_id) {
        case .Struct(id1) => {
            switch (named_type2->type_decl_id) {
                case .Struct(id2) => {
                    if (id1 == id2 &&
                        cir::type_args_eq(&named_type1->type_args, &named_type2->type_args)) {
                        return true;
                    }

                    const decl1 = context->decl_tables->structs.get_const(id1).unwrap();
                    const decl2 = context->decl_tables->structs.get_const(id2).unwrap();

                    var env1 = env::GenericEnv.from_type_args(
                        context->allocator,
                        decl1->generic_params,
                        &named_type1->type_args
                    );
                    defer env1.free();

                    var env2 = env::GenericEnv.from_type_args(
                        context->allocator,
                        decl2->generic_params,
                        &named_type2->type_args
                    );
                    defer env2.free();
                    
                    return is_struct_decl_assignable_to(context, decl1, decl2, &env1, &env2, span);
                }
                else => return false;
            }
        }

        case .Union(id1) => {
            switch (named_type2->type_decl_id) {
                case .Union(id2) => {
                    if (id1 == id2 &&
                        cir::type_args_eq(&named_type1->type_args, &named_type2->type_args)) {
                        return true;
                    }

                    const decl1 = context->decl_tables->unions.get_const(id1).unwrap();
                    const decl2 = context->decl_tables->unions.get_const(id2).unwrap();

                    var env1 = env::GenericEnv.from_type_args(
                        context->allocator,
                        decl1->generic_params,
                        &named_type1->type_args
                    );
                    defer env1.free();

                    var env2 = env::GenericEnv.from_type_args(
                        context->allocator,
                        decl2->generic_params,
                        &named_type2->type_args
                    );
                    defer env2.free();

                    return is_union_decl_assignable_to(context, decl1, decl2, &env1, &env2, span);
                }
                else => return false;
            }
        }

        case .Enum(id1) => {
            switch (named_type2->type_decl_id) {
                case .Enum(id2) => {
                    if (id1 == id2 && 
                        cir::type_args_eq(&named_type1->type_args, &named_type2->type_args)) {
                        return true;
                    }

                    const decl1 = context->decl_tables->enums.get_const(id1).unwrap();
                    const decl2 = context->decl_tables->enums.get_const(id2).unwrap();

                    var env1 = env::GenericEnv.from_type_args(
                        context->allocator,
                        decl1->generic_params,
                        &named_type1->type_args
                    );
                    defer env1.free();

                    var env2 = env::GenericEnv.from_type_args(
                        context->allocator,
                        decl2->generic_params,
                        &named_type2->type_args
                    );
                    defer env2.free();

                    return is_enum_decl_assignable_to(context, decl1, decl2, &env1, &env2, span);
                }
                else => return false;
            }
        }

        case .Interface(id1) => {
            switch (named_type2->type_decl_id) {
                case .Interface(id2) => {
                    return id1 == id2 && 
                        cir::type_args_eq(&named_type1->type_args, &named_type2->type_args);
                }
                else => return false;
            }
        }

        else => return false;
    }
}

fn is_struct_decl_assignable_to(
    context: AnalyzerContext*,
    struct_decl1: const cir::StructDecl*,
    struct_decl2: const cir::StructDecl*,
    env1: const env::GenericEnv*,
    env2: const env::GenericEnv*,
    span: Span
) bool {
    var ok = true;

    for (var i: usize = 0; i < struct_decl2->fields.len() && ok; i += 1) {
        const field2 = struct_decl2->fields.get_const(i).unwrap();
        const found = struct_decl1->lookup_field(field2->name.as_str_const());

        switch (found) case .Some(field1) else {
            ok = false;
            continue;
        }

        switch (normalize_sema_type(context, field1->ty, span, 0)) case .Some(var ty1) else {
            ok = false;
            continue;
        }

        switch (normalize_sema_type(context, field2->ty, span, 0)) case .Some(var ty2) else {
            ok = false;
            continue;
        }

        ty1 = env1->substitute_sema_type(&ty1);
        ty2 = env2->substitute_sema_type(&ty2);

        if (!is_assignable_to(context, ty1, ty2, span)) {
            ok = false;
        }
    }

    return ok;
}

fn is_union_decl_assignable_to(
    context: AnalyzerContext*,
    union_decl1: const cir::UnionDecl*,
    union_decl2: const cir::UnionDecl*,
    env1: const env::GenericEnv*,
    env2: const env::GenericEnv*,
    span: Span
) bool {
    var ok = true;

    for (var i: usize = 0; i < union_decl1->fields.len() && ok; i += 1) {
        const field1 = union_decl1->fields.get_const(i).unwrap();
        const found = union_decl2->lookup_field(field1->name.as_str_const());

        switch (found) {
            case .Some(field2) => {
                switch (normalize_sema_type(context, field1->ty, span, 0)) {
                    case .Some(ty1_raw) => {
                        switch (normalize_sema_type(context, field2->ty, span, 0)) {
                            case .Some(ty2_raw) => {
                                const ty1 = env1->substitute_sema_type(&ty1_raw);
                                const ty2 = env2->substitute_sema_type(&ty2_raw);

                                if (!is_assignable_to(context, ty1, ty2, span)) {
                                    ok = false;
                                }
                            }
                            case .None => ok = false;
                        }
                    }
                    case .None => ok = false;
                }
            }
            case .None => ok = false;
        }
    }

    return ok;
}

fn is_enum_decl_assignable_to(
    context: AnalyzerContext*,
    enum_decl1: const cir::EnumDecl*,
    enum_decl2: const cir::EnumDecl*,
    env1: const env::GenericEnv*,
    env2: const env::GenericEnv*,
    span: Span
) bool {
    switch (enum_decl1->tag_type) {
        case .Some(tag1) => {
            switch (enum_decl2->tag_type) {
                case .Some(tag2) => {
                    const ty1 = env1->substitute_sema_type(&tag1);
                    const ty2 = env2->substitute_sema_type(&tag2);

                    if (!is_assignable_to(context, ty1, ty2, span)) {
                        return false;
                    }
                }
                else => {}
            }
        }
        else => {}
    }

    switch (enum_decl1->align) {
        case .Some(a1) => {
            switch (enum_decl2->align) {
                case .Some(a2) => {
                    if (a1 != a2) {
                        return false;
                    }
                }
                else => {}
            }
        }
        else => {}
    }

    var ok = true;

    for (var i: usize = 0; i < enum_decl1->variants.len() && ok; i += 1) {
        const variant1 = enum_decl1->variants.get_const(i).unwrap();
        const found = enum_decl2->lookup_variant(variant1->name());

        switch (found) {
            case .None => ok = false;
            case .Some(variant2) => {
                switch (*variant1) {
                    case .Unit => {
                        switch (*variant2) {
                            case .Unit => {}
                            else => ok = false;
                        }
                    }

                    case .Valued { value: v1, .. } => {
                        switch (*variant2) case .Valued { value: v2, .. } else {
                            ok = false;
                            continue;
                        }

                        switch (v1->ty) case .Some(raw1) else {
                            ok = false;
                            continue;
                        }

                        switch (v2->ty) case .Some(raw2) else {
                            ok = false;
                            continue;
                        }

                        switch (normalize_sema_type(context, raw1, span, 0)) case .Some(var ty1) else {
                            ok = false;
                            continue;
                        }

                        switch (normalize_sema_type(context, raw2, span, 0)) case .Some(var ty2) else {
                            ok = false;
                            continue;
                        }

                        ty1 = env1->substitute_sema_type(&ty1);
                        ty2 = env2->substitute_sema_type(&ty2);

                        if (!is_assignable_to(context, ty1, ty2, span)) {
                            ok = false;
                        }
                    }

                    case .Tuple { fields: f1, .. } => {
                        switch (*variant2) {
                            case .Tuple { fields: f2, .. } => {
                                if (f1.len() == f2.len()) {
                                    for (var j: usize = 0; j < f1.len() && ok; j += 1) {
                                        const t1 = f1.get_const(j).unwrap();
                                        const t2 = f2.get_const(j).unwrap();

                                        switch (normalize_sema_type(context, t1->ty, span, 0)) case .Some(ty1_n) else {
                                            ok = false;
                                            continue;
                                        }

                                        switch (normalize_sema_type(context, t2->ty, span, 0)) case .Some(ty2_n) else {
                                            ok = false;
                                            continue;
                                        }

                                        const ty1 = env1->substitute_sema_type(&ty1_n);
                                        const ty2 = env2->substitute_sema_type(&ty2_n);

                                        if (!is_assignable_to(context, ty1, ty2, span)) {
                                            ok = false;
                                        }
                                    }
                                } else {
                                    ok = false;
                                }
                            }
                            else => ok = false;
                        }
                    }

                    case .Struct { fields: f1, .. } => {
                        switch (*variant2) {
                            case .Struct { fields: f2, .. } => {
                                for (var j: usize = 0; j < f2.len() && ok; j += 1) {
                                    const field2 = f2.get_const(j).unwrap();

                                    var found_index: usize = f1.len();
                                    var k: usize = 0;

                                    while (k < f1.len()) {
                                        const candidate = f1.get_const(k).unwrap();

                                        if (candidate->name.str.as_str_const() == field2->name.str.as_str_const()) {
                                            found_index = k;
                                            k = f1.len();
                                        } else {
                                            k += 1;
                                        }
                                    }

                                    if (found_index >= f1.len()) {
                                        ok = false;
                                    } else {
                                        const field1 = f1.get_const(found_index).unwrap();

                                        switch (normalize_sema_type(context, field1->ty, span, 0)) {
                                            case .Some(ty1) => {
                                                switch (normalize_sema_type(context, field2->ty, span, 0)) {
                                                    case .Some(ty2) => {
                                                        const ty1 = env1->substitute_sema_type(&ty1);
                                                        const ty2 = env2->substitute_sema_type(&ty2);

                                                        if (!is_assignable_to(context, ty1, ty2, span)) {
                                                            ok = false;
                                                        }
                                                    }
                                                    case .None => ok = false;
                                                }
                                            }
                                            case .None => ok = false;
                                        }
                                    }
                                }
                            }
                            else => ok = false;
                        }
                    }
                }
            }
        }
    }

    return ok;
}

fn is_type_comparable(
    context: AnalyzerContext*,
    rhs_type: cir::SemaType,
    lhs_type: cir::SemaType,
    span: Span
) bool {
    const lhs = expand_sema_type(context, lhs_type, span);
    const rhs = expand_sema_type(context, rhs_type, span);

    switch (rhs) {
        case .Pointer(inner_rhs) => {
            switch (lhs) {
                case .Pointer(inner_lhs) => {
                    if (inner_rhs->is_void() || inner_lhs->is_void()) {
                        return true;
                    }

                    return is_assignable_to(context, *inner_rhs, *inner_lhs, span);
                }
                else => {}
            }
        }
        else => {}
    }

    return is_assignable_to(context, rhs, lhs, span);
}

fn is_explicit_cast_allowed(
    context: AnalyzerContext*,
    value_type: cir::SemaType,
    target_type: cir::SemaType,
    span: Span
) bool {
    if (is_assignable_to(context, value_type, target_type, span)) {
        return true;
    }

    const value_base = value_type.const_inner();
    const target_base = target_type.const_inner();

    var allowed = false;

    switch (*value_base) {
        case .Plain(value_pt) => {
            switch (*target_base) {
                case .Plain(target_pt) => {
                    if (value_pt.is_integer() && target_pt.is_integer()) {
                        allowed = true;
                    } else if (value_pt.is_float() && target_pt.is_float()) {
                        allowed = true;
                    } else if ((value_pt.is_integer() 
                        && target_pt.is_float()) 
                        || (value_pt.is_float() 
                        && target_pt.is_integer())
                    ) {
                        allowed = true;
                    } else if (value_pt == .Bool && target_pt.is_integer()) {
                        allowed = true;
                    }
                }
                case .Pointer => {
                    allowed = value_pt == .IntPtr || value_pt == .UIntPtr;
                }
                case .Named(named_type) => {
                    allowed = is_enum_to_plain_cast_allowed(context, &named_type, value_pt);
                }
                else => {}
            }
        }
        case .Pointer => {
            switch (*target_base) {
                case .Plain(target_pt) => {
                    allowed = target_pt == .IntPtr || target_pt == .UIntPtr;
                }
                else => {}
            }
        }
        case .Named(named_type) => {
            switch (*target_base) {
                case .Plain(plain_type) => {
                    allowed = is_enum_to_plain_cast_allowed(context, &named_type, plain_type);
                }
                else => {}
            }
        }
        else => {}
    }

    return allowed;
}

fn is_enum_to_plain_cast_allowed(
    context: AnalyzerContext*,
    named_type: const cir::NamedType*,
    plain_type: cir::PlainType
) bool {
    if (named_type->type_decl_id.as_enum().is_none()) {
        return false;
    }

    const enum_decl_id = named_type->type_decl_id.as_enum().unwrap();
    const enum_decl = context->decl_tables->enums.get_const(enum_decl_id).unwrap();

    var ok = false;

    switch (enum_decl->tag_type) {
        case .Some(tag_ty) => {
            const inner = tag_ty.const_inner();

            switch (*inner) {
                case .Plain(pt) => {
                    ok = pt.is_integer_or_bool();
                }
                else => {
                    ok = false;
                }
            }
        }
        case .None => ok = true;
    }

    return ok && plain_type.is_integer_or_bool();
}

fn is_plain_type_assignable_to(
    value_type: cir::PlainType,
    target_type: cir::PlainType
) bool {
    if (value_type == target_type) {
        return true;
    }

    if (value_type.is_integer() && target_type.is_integer()) {
        const signedness = 
            (value_type.is_signed() && target_type.is_signed())
            || (!value_type.is_signed() && !target_type.is_signed());

        const rank1 = cir::PlainType.plain_type_rank(&value_type);
        const rank2 = cir::PlainType.plain_type_rank(&target_type);

        switch (rank1) {
            case .Some(r1) => {
                switch (rank2) {
                    case .Some(r2) => return r1 <= r2 && signedness;
                    case .None => return false;
                }
            }
            case .None => return false;
        }
    }

    if (value_type.is_float() && target_type.is_float()) {
        const rank1 = cir::PlainType.plain_type_rank(&value_type);
        const rank2 = cir::PlainType.plain_type_rank(&target_type);

        switch (rank1) {
            case .Some(r1) => {
                switch (rank2) {
                    case .Some(r2) => return r1 <= r2;
                    case .None => return false;
                }
            }
            case .None => return false;
        }
    }

    switch (value_type) {
        case .Bool => {
            switch (target_type) {
                case .Int8 | .UInt8 => return true;
                else => {}
            }
        }
        case .Int8 | .UInt8 => {
            switch (target_type) {
                case .Bool => return true;
                else => {}
            }
        }
        else => {}
    }

    return false;
}

fn is_const_str_assignable_to_array(
    context: AnalyzerContext*,
    value_type: const cir::TypedArrayType*,
    target_type: const cir::TypedArrayType*
) bool {
    switch (value_type->capacity) {
        case .Fixed(value_capacity) => {
            switch (target_type->capacity) {
                case .Fixed(target_capacity) => {
                    const value = ciri::fold_const_expr_int(context->decl_tables, context->registry, value_capacity);
                    const target = ciri::fold_const_expr_int(context->decl_tables, context->registry, target_capacity);

                    switch (value) {
                        case .Some(value) => {
                            switch (target) {
                                case .Some(target) => return cir::integer_literal_eq(value, target);
                                case .None => return false;
                            }
                        }
                        case .None => return false;
                    }
                }
                case .Slice => return false;
            }
        }
        case .Slice => return false;
    }
}

fn is_const_qualified_lvalue(
    context: AnalyzerContext*, 
    expr: const cir::TypedExpr*
) bool {
    if (expr->value_category.is_const_lvalue()) {
        return true;
    }

    switch (expr->ty) {
        case .Some(ty) => {
            if (ty.is_const()) {
                return true;
            }
        }
        else => {}
    }

    return false;
}

/* ************* Typedef Expansion ************* */

/// Expand typedef references recursively.
pub fn expand_sema_type(
    context: AnalyzerContext*, 
    ty: cir::SemaType,
    span: Span
) cir::SemaType {
    switch (ty) {
        case .Placeholder => return ty;
        case .InferVar => return ty;

        case .Named(named_type) => {
            switch (named_type.type_decl_id) {
                case .Typedef(typedef_decl_id) => {
                    return expand_typedef(context, typedef_decl_id, &named_type.type_args, span);
                }
                else => {
                    var type_args = cir::TypedTypeArgs.new(context->allocator);
                    
                    for (var i: usize = 0; i < named_type.type_args.len(); i += 1) {
                        const arg = named_type.type_args.get(i).unwrap();

                        switch (*arg) {
                            case .Type(inner, span) => {
                                const expand = expand_sema_type(context, inner, span);
                                type_args.push(.Type(expand, span));
                            }
                            case .Infer => type_args.push(.Infer);
                        }
                    }

                    return .Named(cir::NamedType {
                        type_decl_id: named_type.type_decl_id,
                        type_args,
                    });
                }
            }
        }

        case .Pointer(inner) => {
            const expand = expand_sema_type(context, *inner, span);
            return .Pointer(alloc_init(context->allocator, expand));
        }

        case .Const(inner) => {
            const expand = expand_sema_type(context, *inner, span);

            if (expand.is_const()) {
                return expand;
            }

            return .Const(alloc_init(context->allocator, expand));
        }

        case .Array(array) => {
            const element_type = expand_sema_type(context, *array.element_type, span);
            
            return .Array(cir::TypedArrayType {
                element_type: alloc_init(context->allocator, element_type),
                capacity: array.capacity,
                span: array.span,
            });
        }

        case .Tuple(tuple_type) => {
            var elements: Vec<cir::TypedTupleElement> =
                Vec.with_capacity(context->allocator, tuple_type.elements.len());
            
            for (var i: usize = 0; i < tuple_type.elements.len(); i += 1) {
                const element = tuple_type.elements.get_const(i).unwrap();
                const expand = expand_sema_type(context, element->ty, element->span);
                
                elements.push(cir::TypedTupleElement {
                    ty: expand,
                    span: element->span,
                });
            }

            return .Tuple(cir::TypedTupleType {
                elements,
                span: tuple_type.span,
            });
        }

        case .FuncType(func_type) => {
            var params = cir::TypedFuncTypeParams {
                list: Vec.with_capacity(context->allocator, func_type.params.list.len()),
                variadic: .None,
            };

            for (var i: usize = 0; i < func_type.params.list.len(); i += 1) {
                const param = func_type.params.list.get_const(i).unwrap();
                const expand = expand_sema_type(context, *param, span);
                params.list.push(expand);
            }

            switch (func_type.params.variadic) {
                case .Some(variadic) => {
                    switch (*variadic) {
                        case .UntypedCStyle => {
                            params.variadic = .Some(alloc_init(
                                context->allocator,
                                cir::TypedFuncTypeVariadicParam.UntypedCStyle
                            ));
                        }
                        case .Typed(ty) => {
                            const expand = expand_sema_type(context, ty, span);
                            params.variadic = .Some(alloc_init(
                                context->allocator,
                                cir::TypedFuncTypeVariadicParam.Typed(expand)
                            ));
                        }
                    }
                }
                else => {}
            }

            const ret_type = expand_sema_type(context, *func_type.ret_type, span);

            return .FuncType(cir::TypedFuncType {
                params,
                ret_type: alloc_init(context->allocator, ret_type),
                vis: func_type.vis,
                callconv: func_type.callconv,
                span: func_type.span,
            });
        }

        else => return ty;
    }
}

fn expand_typedef(
    context: AnalyzerContext*,
    typedef_decl_id: cir::TypedefDeclId,
    args: const cir::TypedTypeArgs*,
    span: Span
) cir::SemaType {
    switch (enter_typedef(context, typedef_decl_id)) {
        case .Some(var path) => {
            defer path.free();
            var key = typedef_cycle_key(context, path);
            defer key.free();

            if (!is_typedef_cycle_already_reported(context, key.as_str_const())) {
                const n = path.len() - 1;
                var min_index: usize = 0;
                var min_val: usize = *path.get_const(0).unwrap();

                for (var i: usize = 1; i < n; i += 1) {
                    const v = *path.get_const(i).unwrap();
                    if (v < min_val) {
                        min_val = v;
                        min_index = i;
                    }
                }

                var names: Vec<String> = Vec.new(context->allocator);

                for (var i: usize = 0; i < n; i += 1) {
                    const index = (min_index + i) % n;
                    const id = *path.get_const(index).unwrap();

                    names.push(format::format_type_decl_name(
                        context->allocator,
                        context->decl_tables,
                        .Typedef(id)
                    ));
                }

                // Close the cycle
                if (n > 0) {
                    const first = names.get_const(0).unwrap();
                    names.push(String.from_str(context->allocator, first->as_str_const()));
                }

                diags::report_cyclic_type_definition(
                    context->dctx,
                    context->allocator,
                    span,
                    &names
                );
                free_strings(&names);

                context->reported_typedef_cycles.push(key);
            } else {
            }

            return .Err(span);
        }
        else => {}
    }

    const typedef_decl = context->decl_tables->typedefs.get_const(typedef_decl_id).unwrap();

    if (typedef_decl->ty == null) {
        exit_typedef(context);
        return .Err(span);
    }

    const generic_params = &typedef_decl->generic_params;

    var final_args = cir::TypedTypeArgs.new(context->allocator);
    defer final_args.free();

    for (var i: usize = 0; i < generic_params->len(); i += 1) {
        if (i < args->len()) {
            const arg = args->get(i).unwrap();
            final_args.push(*arg);
        } else {
            switch (context->func_env.infer) {
                case .Some(infer_ctx) => {
                    const infer_var = infer_ctx->new_var_id();
                    final_args.push(.Type(.InferVar(infer_var), span));
                }
                case .None => {
                    final_args.push(.Infer);
                }
            }
        }
    }

    if (args->len() > final_args.len()) {
        var named = cir::NamedType {
            type_decl_id: .Typedef(typedef_decl_id),
            type_args: cir::TypedTypeArgs.new(context->allocator),
        };

        for (var i: usize = 0; i < args->len(); i += 1) {
            const arg = args->get(i).unwrap();
            named.type_args.push(*arg);
        }

        const ty: cir::SemaType = .Named(named);
        
        var type_name = format::format_sema_type(
            context->allocator,
            context->decl_tables,
            &ty
        );

        diags::report_wrong_number_of_type_args(
            context->dctx,
            context->allocator,
            span,
            type_name.as_str_const(),
            final_args.len(),
            args->len()
        );
        
        type_name.free();
        named.free(); 
    }

    var generic_env = env::GenericEnv.from_type_args(
        context->allocator,
        *generic_params,
        &final_args
    );
    defer generic_env.free();

    const typedef_type =
        normalize_and_check_type_formation(context, *typedef_decl->ty, span, 0);
    
    switch (typedef_type) {
        case .None => {
            exit_typedef(context);
            return .Err(span);
        }
        case .Some(defined_type) => {
            const subst = generic_env.substitute_sema_type(&defined_type);
            exit_typedef(context);
            return expand_sema_type(context, subst, span);
        }
    }
}

pub fn enter_typedef(
    context: AnalyzerContext*,
    id: cir::TypedefDeclId
) Option<Vec<usize>> {
    for (var i: usize = 0; i < context->typedef_stack.len(); i += 1) {
        const existing = *context->typedef_stack.get_const(i).unwrap();
        
        if (existing == id) {
            var path: Vec<usize> =
                Vec.with_capacity(context->allocator, context->typedef_stack.len() - i + 1);
            
            for (var j: usize = i; j < context->typedef_stack.len(); j += 1) {
                path.push(*context->typedef_stack.get_const(j).unwrap());
            }
            
            path.push(id);
            return .Some(path);
        }
    }

    context->typedef_stack.push(id);
    return .None;
}

[[inline]]
pub fn exit_typedef(context: AnalyzerContext*) {
    context->typedef_stack.pop();
}

pub fn typedef_cycle_key(
    context: AnalyzerContext*, 
    path: const Vec<usize>
) String {
    if (path.len() == 0) {
        return String.new(context->allocator);
    }

    const n = path.len() - 1;

    if (n == 0) {
        var key = String.new(context->allocator);
        diags::append_usize(&key, *path.get_const(0).unwrap());
        return key;
    }

    var min_index: usize = 0;
    var min_value: usize = *path.get_const(0).unwrap();
    
    for (var i: usize = 1; i < n; i += 1) {
        const v = *path.get_const(i).unwrap();
        
        if (v < min_value) {
            min_value = v;
            min_index = i;
        }
    }

    var key = String.new(context->allocator);
    
    for (var i: usize = 0; i < n; i += 1) {
        const index = (min_index + i) % n;
        
        if (i > 0) {
            key.push(',');
        }
        
        diags::append_usize(&key, *path.get_const(index).unwrap());
    }

    return key;
}

pub fn is_typedef_cycle_already_reported(
    context: AnalyzerContext*,
    key: const uint8*
) bool {
    for (var i: usize = 0; i < context->reported_typedef_cycles.len(); i += 1) {
        const existing = context->reported_typedef_cycles.get_const(i).unwrap();
        
        if (existing->as_str_const() == key) {
            return true;
        }
    }

    return false;
}

/* ************* Specialization ************* */

fn instantiate_and_specialize_func_params(
    context: AnalyzerContext*,
    params: cir::TypedFuncParams*,
    decl_map: HashMap<usize, cir::VarDeclId>*
) {
    for (var i: usize = 0; i < params->list.len(); i += 1) {
        const param_kind = params->list.get(i).unwrap();

        switch (*param_kind) {
            case .FuncParam(var func_param) => {
                switch (func_param.var_decl_id) {
                    case .Some(var_decl_id) => {
                        switch (context->decl_tables->vars.get_const(var_decl_id)) {
                            case .Some(var existing) => {
                                var template_var_decl = *existing;
                                template_var_decl.ty = .Some(func_param.ty);
                                instantiate_fresh_var_decl(context,
                                    var_decl_id, 
                                    &template_var_decl,
                                    decl_map
                                );
                            }
                            else => {}
                        }

                        switch (decl_map->get(var_decl_id)) {
                            case .Some(new_var_decl_id) => {
                                func_param.var_decl_id = .Some(*new_var_decl_id);
                            }
                            else => {}
                        }
                    }
                    else => {}
                }

                *param_kind = .FuncParam(func_param);
            }
            case .SelfModifier(var self_modifier) => {
                switch (self_modifier.var_decl_id) {
                    case .Some(var_decl_id) => {
                        switch (context->decl_tables->vars.get_const(var_decl_id)) {
                            case .Some(var existing) => {
                                var template_var_decl = *existing;
                                template_var_decl.ty = .Some(self_modifier.ty);
                                instantiate_fresh_var_decl(context,
                                    var_decl_id, 
                                    &template_var_decl, 
                                    decl_map
                                );
                            }
                            else => {}
                        }

                        switch (decl_map->get(var_decl_id)) {
                            case .Some(new_var_decl_id) => {
                                self_modifier.var_decl_id = .Some(*new_var_decl_id);
                            }
                            else => {}
                        }
                    }
                    else => {}
                }

                *param_kind = .SelfModifier(self_modifier);
            }
        }
    }
}

pub fn instantiate_enum_decl_with_type_args(
    allocator: Allocator,
    enum_decl: const cir::EnumDecl*,
    type_args: const cir::TypedTypeArgs*
) cir::EnumDecl {
    var variants: Vec<cir::TypedEnumVariant> = Vec.new(allocator);

    for (var i: usize = 0; i < enum_decl->variants.len(); i += 1) {
        const variant = enum_decl->variants.get_const(i).unwrap();

        switch (*variant) {
            case .Unit(ident) => {
                variants.push(.Unit(ident));
            }
            case .Valued { ident, value } => {
                variants.push(.Valued { ident, value });
            }
            case .Tuple { ident, fields } => {
                var new_fields: Vec<cir::TypedEnumVariantTupleField> = Vec.new(allocator);

                for (var j: usize = 0; j < fields.len(); j += 1) {
                    const field = fields.get_const(j).unwrap();

                    new_fields.push(cir::TypedEnumVariantTupleField {
                        ty: cir::substitute_sema_type_with_type_args(
                            allocator,
                            &field->ty,
                            &enum_decl->generic_params,
                            type_args
                        ),
                        span: field->span,
                    });
                }

                variants.push(.Tuple { ident, fields: new_fields });
            }
            case .Struct { ident, fields } => {
                var new_fields: Vec<cir::TypedEnumVariantStructField> = Vec.new(allocator);

                for (var j: usize = 0; j < fields.len(); j += 1) {
                    const field = fields.get_const(j).unwrap();

                    new_fields.push(cir::TypedEnumVariantStructField {
                        name: field->name,
                        ty: cir::substitute_sema_type_with_type_args(
                            allocator,
                            &field->ty,
                            &enum_decl->generic_params,
                            type_args
                        ),
                        span: field->span,
                    });
                }

                variants.push(.Struct { ident, fields: new_fields });
            }
        }
    }

    return cir::EnumDecl {
        name: enum_decl->name,
        methods: enum_decl->methods,
        variants,
        impls: enum_decl->impls,
        generic_params: enum_decl->generic_params,
        modifiers: enum_decl->modifiers,
        tag_type: enum_decl->tag_type,
        align: enum_decl->align,
        is_normalized: enum_decl->is_normalized,
        span: enum_decl->span,
    };
}

fn instantiate_fresh_var_stmt(
    context: AnalyzerContext*,
    var_stmt: const cir::TypedVarStmt*,
    decl_map: HashMap<usize, cir::VarDeclId>*
) {
    const template_var_decl = cir::VarDecl {
        name: var_stmt->name,
        ty: var_stmt->ty,
        rhs: var_stmt->rhs,
        is_const: var_stmt->is_const,
        analyzed: false,
        span: var_stmt->span,
    };

    instantiate_fresh_var_decl(context,
        var_stmt->var_decl_id, 
        &template_var_decl, 
        decl_map
    );
}

fn instantiate_fresh_var_decl(
    context: AnalyzerContext*,
    var_decl_id: cir::VarDeclId,
    template_var_decl: const cir::VarDecl*,
    decl_map: HashMap<usize, cir::VarDeclId>*
) {
    if (decl_map->get(var_decl_id).is_some()) {
        return;
    }

    var var_decl = *template_var_decl;

    switch (var_decl.ty) {
        case .Some(ty) => {
            var subst = generics::substitute_type(context, &ty);

            switch (context->func_env.infer) {
                case .Some(infer_ctx) => subst = infer_ctx->resolve(&subst);
                else => {}
            }

            var_decl.ty = .Some(subst);
        }
        else => {}
    }

    var_decl.analyzed = false;
    const new_var_decl_id = context->decl_tables->insert_var(var_decl);
    decl_map->insert(var_decl_id, new_var_decl_id);
}

fn instantiate_fresh_var_decl_from_tables(
    context: AnalyzerContext*,
    var_decl_id: cir::VarDeclId,
    decl_map: HashMap<usize, cir::VarDeclId>*
) {
    switch (context->decl_tables->vars.get_const(var_decl_id)) {
        case .Some(var_decl) => {
            instantiate_fresh_var_decl(context, var_decl_id, var_decl, decl_map);
        }
        else => {}
    }
}

fn specialize_func_body(
    context: AnalyzerContext*,
    template_body: const cir::TypedBlockStmt*,
    params: cir::TypedFuncParams*
) cir::TypedBlockStmt {
    var body = cir::clone::clone_typed_block(context->allocator, template_body);

    var decl_map: HashMap<usize, cir::VarDeclId> = HashMap.with_hasher(
        context->allocator,
        64,
        hash_usize,
        eq_usize
    );

    instantiate_and_specialize_func_params(context, params, &decl_map);

    for (var i: usize = 0; i < body.stmts.len(); i += 1) {
        const stmt = body.stmts.get_const(i).unwrap();
        collect_and_instantiate_fresh_var_decls(context, &stmt->kind, &decl_map);
    }

    for (var i: usize = 0; i < body.defers.len(); i += 1) {
        const defer_stmt = body.defers.get_const(i).unwrap();
        collect_and_instantiate_fresh_var_decls(context, &defer_stmt->operand->kind, &decl_map);
    }

    specialize_block(context, &body, &decl_map);

    return body;
}

fn specialize_block(
    context: AnalyzerContext*,
    body: cir::TypedBlockStmt*,
    decl_map: HashMap<usize, cir::VarDeclId>*
) {
    for (var i: usize = 0; i < body->stmts.len(); i += 1) {
        const stmt = body->stmts.get(i).unwrap();
        specialize_stmt(context, &stmt->kind, decl_map);
    }

    for (var i: usize = 0; i < body->defers.len(); i += 1) {
        const defer_stmt = body->defers.get(i).unwrap();
        specialize_stmt(context, &defer_stmt->operand->kind, decl_map);
    }
}

fn specialize_stmt(
    context: AnalyzerContext*,
    kind: cir::TypedStmtKind*,
    decl_map: HashMap<usize, cir::VarDeclId>*
) {
    switch (*kind) {
        case .TupleExport(var tuple_export) => {
            specialize_tuple_export_pattern(context, &tuple_export.pattern, decl_map);

            switch (tuple_export.rhs) {
                case .Some(var rhs) => {
                    specialize_expr(context, &rhs, decl_map);
                    tuple_export.rhs = .Some(rhs);
                }
                else => {}
            }

            *kind = .TupleExport(tuple_export);
        }
        case .For(var for_stmt) => {
            switch (for_stmt.initializer) {
                case .Some(var initializer) => {
                    specialize_var_stmt(context, &initializer, decl_map);
                    for_stmt.initializer = .Some(initializer);
                }
                else => {}
            }

            switch (for_stmt.cond) {
                case .Some(var cond) => {
                    specialize_expr(context, &cond, decl_map);
                    for_stmt.cond = .Some(cond);
                }
                else => {}
            }

            switch (for_stmt.increment) {
                case .Some(var increment) => {
                    specialize_expr(context, &increment, decl_map);
                    for_stmt.increment = .Some(increment);
                }
                else => {}
            }

            specialize_block(context, for_stmt.body, decl_map);
            *kind = .For(for_stmt);
        }
        case .Switch(var switch_stmt) => {
            specialize_expr(context, &switch_stmt.operand, decl_map);

            for (var i: usize = 0; i < switch_stmt.cases.len(); i += 1) {
                const case_item = switch_stmt.cases.get(i).unwrap();

                for (var j: usize = 0; j < case_item->patterns.len(); j += 1) {
                    const pattern = case_item->patterns.get(j).unwrap();
                    specialize_switch_pattern(context, pattern, decl_map);
                }

                specialize_block(context, case_item->body, decl_map);
            }

            switch (switch_stmt.else_case) {
                case .Some(var else_case) => {
                    specialize_block(context, &else_case, decl_map);
                    switch_stmt.else_case = .Some(else_case);
                }
                else => {}
            }

            *kind = .Switch(switch_stmt);
        }
        case .Return(var return_stmt) => {
            switch (return_stmt.arg) {
                case .Some(var arg) => {
                    specialize_expr(context, &arg, decl_map);
                    return_stmt.arg = .Some(arg);
                }
                else => {}
            }

            *kind = .Return(return_stmt);
        }
        case .InlineAsm(var asm) => {
            for (var i: usize = 0; i < asm.outputs.len(); i += 1) {
                const operand = asm.outputs.get(i).unwrap();
                specialize_expr(context, operand->expr, decl_map);
            }

            for (var i: usize = 0; i < asm.inputs.len(); i += 1) {
                const operand = asm.inputs.get(i).unwrap();
                specialize_expr(context, operand->expr, decl_map);
            }

            *kind = .InlineAsm(asm);
        }
        case .BlockStmt(var block) => {
            specialize_block(context, &block, decl_map);
            *kind = .BlockStmt(block);
        }
        case .If(var if_) => {
            specialize_if_stmt(context, &if_, decl_map);
            *kind = .If(if_);
        }
        case .While(var while_stmt) => {
            specialize_expr(context, &while_stmt.cond, decl_map);
            specialize_block(context, while_stmt.body, decl_map);
            *kind = .While(while_stmt);
        }
        case .Builtin(var builtin) => {
            specialize_builtin(context, &builtin, decl_map);
            *kind = .Builtin(builtin);
        }
        case .Expr(var expr) => {
            specialize_expr(context, &expr, decl_map);
            *kind = .Expr(expr);
        }
        case .Variable(var var_stmt) => {
            specialize_var_stmt(context, &var_stmt, decl_map);
            *kind = .Variable(var_stmt);
        }
        case .Defer(var defer_stmt) => {
            specialize_stmt(context, &defer_stmt.operand->kind, decl_map);
            *kind = .Defer(defer_stmt);
        }
        else => {}
    }
}

fn specialize_if_stmt(
    context: AnalyzerContext*,
    if_: cir::TypedIfStmt*,
    decl_map: HashMap<usize, cir::VarDeclId>*
) {
    specialize_expr(context, &if_->cond, decl_map);
    specialize_block(context, if_->then_block, decl_map);

    switch (if_->else_block) {
        case .Some(else_block) => {
            specialize_block(context, else_block, decl_map);
        }
        else => {}
    }

    for (var i: usize = 0; i < if_->branches.len(); i += 1) {
        const branch = if_->branches.get(i).unwrap();
        specialize_if_stmt(context, branch, decl_map);
    }
}

fn specialize_var_stmt(
    context: AnalyzerContext*,
    var_stmt: cir::TypedVarStmt*,
    decl_map: HashMap<usize, cir::VarDeclId>*
) {
    switch (remap_var_decl_id(context, decl_map, var_stmt->var_decl_id)) {
        case .Some(new_var_decl_id) => var_stmt->var_decl_id = new_var_decl_id;
        else => {}
    }

    switch (var_stmt->rhs) {
        case .Some(var rhs) => {
            specialize_expr(context, &rhs, decl_map);
            var_stmt->rhs = .Some(rhs);
        }
        else => {}
    }
}

fn specialize_builtin(
    context: AnalyzerContext*,
    builtin: cir::TypedBuiltin*,
    decl_map: HashMap<usize, cir::VarDeclId>*
) {
    switch (*builtin) {
        case .BuiltinFunc(var builtin_func) => {
            specialize_expr_vec(context, &builtin_func.args, decl_map);
        }
        case .BuiltinBlock(var builtin_block) => {
            specialize_expr_vec(context, &builtin_block.args, decl_map);
            specialize_block(context, builtin_block.block, decl_map);
        }
    }
}

fn specialize_tuple_export_pattern(
    context: AnalyzerContext*,
    pattern: cir::TypedTupleExportPattern*,
    decl_map: HashMap<usize, cir::VarDeclId>*
) {
    switch (pattern->kind) {
        case .Tuple(patterns) => {
            for (var i: usize = 0; i < patterns.len(); i += 1) {
                const inner = patterns.get(i).unwrap();
                specialize_tuple_export_pattern(context, inner, decl_map);
            }
        }
        case .Ident(var_decl_id) => {
            switch (remap_var_decl_id(context, decl_map, var_decl_id)) {
                case .Some(new_var_decl_id) => pattern->kind = .Ident(new_var_decl_id);
                else => {}
            }
        }
        case .Ignore => {}
    }
}

fn specialize_switch_pattern(
    context: AnalyzerContext*,
    pattern: cir::TypedSwitchCasePattern*,
    decl_map: HashMap<usize, cir::VarDeclId>*
) {
    switch (pattern->kind) {
        case .Wildcard | .EnumUnit => {}

        case .Binding { var name, var_decl_id, .. } => {
            switch (remap_var_decl_id(context, decl_map, var_decl_id)) {
                case .Some(new_var_decl_id) => pattern->kind = .Binding {
                    name,
                    var_decl_id: new_var_decl_id
                };
                else => {}
            }
        }
        
        case .Range(var range) => {
            specialize_expr(context, &range.lower, decl_map);
            specialize_expr(context, &range.upper, decl_map);
            pattern->kind = .Range(range);
        }
        
        case .Expr(var expr) => {
            specialize_expr(context, &expr, decl_map);
            pattern->kind = .Expr(expr);
        }
        
        case .EnumTupleVariant { ident, items, .. } => {
            for (var i: usize = 0; i < items.len(); i += 1) {
                const item = items.get(i).unwrap();
                specialize_switch_pattern(context, item, decl_map);
            }

            pattern->kind = .EnumTupleVariant { ident, items };
        }
        
        case .EnumStructVariant { ident, items, ignore } => {
            for (var i: usize = 0; i < items.len(); i += 1) {
                const item = items.get(i).unwrap();
                specialize_switch_pattern(context, &item->pattern, decl_map);
            }

            pattern->kind = .EnumStructVariant { ident, items, ignore };
        }
    }
}

fn specialize_expr(
    context: AnalyzerContext*,
    expr: cir::TypedExpr*,
    decl_map: HashMap<usize, cir::VarDeclId>*
) {
    switch (expr->kind) {
        case .Literal 
        | .SemaType 
        | .Poisoned => {}

        case .EnumInit(enum_init) => {
            switch (enum_init.arg) {
                case .Unit => {}

                case .Tuple(var elements) => {
                    specialize_expr_vec(context, &elements, decl_map);
                }
                
                case .Struct(var field_inits) => {
                    for (var i: usize = 0; i < field_inits.len(); i += 1) {
                        const field_init = field_inits.get(i).unwrap();
                        specialize_expr(context, field_init->value, decl_map);
                    }
                }
            }
        }

        case .EnumStructVariantInit(variant_init) => {
            specialize_expr(context, variant_init.operand, decl_map);

            for (var i: usize = 0; i < variant_init.field_inits.len(); i += 1) {
                const field_init = variant_init.field_inits.get(i).unwrap();
                specialize_expr(context, field_init->value, decl_map);
            }
        }

        case .UnnamedStructValue(struct_value) => {
            for (var i: usize = 0; i < struct_value.fields.len(); i += 1) {
                const field = struct_value.fields.get(i).unwrap();
                specialize_expr(context, field->value, decl_map);
            }
        }

        case .UnnamedUnionValue(union_value) => {
            for (var i: usize = 0; i < union_value.fields.len(); i += 1) {
                const field = union_value.fields.get(i).unwrap();
                specialize_expr(context, field->value, decl_map);
            }
        }

        case .UnnamedEnumValue(enum_value) => {
            switch (enum_value.kind) {
                case .Unit => {}

                case .Tuple(var elements) => {
                    specialize_expr_vec(context, &elements, decl_map);
                }
                
                case .Struct(var field_inits) => {
                    for (var i: usize = 0; i < field_inits.len(); i += 1) {
                        const field_init = field_inits.get(i).unwrap();
                        specialize_expr(context, field_init->value, decl_map);
                    }
                }
            }
        }
        
        case .InlineAsm(asm) => {
            for (var i: usize = 0; i < asm.outputs.len(); i += 1) {
                const operand = asm.outputs.get(i).unwrap();
                specialize_expr(context, operand->expr, decl_map);
            }

            for (var i: usize = 0; i < asm.inputs.len(); i += 1) {
                const operand = asm.inputs.get(i).unwrap();
                specialize_expr(context, operand->expr, decl_map);
            }
        }

        case .Symbol(var symbol_expr) => {
            switch (analyze_symbol_expr(context->registry, &symbol_expr)) {
                case .Some(decl_id) => {
                    switch (decl_id.as_var()) {
                        case .Some(var_decl_id) => {
                            switch (remap_var_decl_id(context, decl_map, var_decl_id)) {
                                case .Some(new_var_decl_id) => {
                                    symbol_expr = .Resolved {
                                        decl_id: .Var(new_var_decl_id),
                                        span: symbol_expr.span()
                                    };
                                }
                                else => {}
                            }
                        }
                        else => {}
                    }
                }
                else => {}
            }

            expr->kind = .Symbol(symbol_expr);
        }

        case .Prefix(prefix) => {
            specialize_expr(context, prefix.operand, decl_map);
        }
        
        case .Infix(infix) => {
            specialize_expr(context, infix.lhs, decl_map);
            specialize_expr(context, infix.rhs, decl_map);
        }
        
        case .Assign(assign) => {
            specialize_expr(context, assign.lhs, decl_map);
            specialize_expr(context, assign.rhs, decl_map);
        }
        
        case .AddrOf(addr_of) => {
            specialize_expr(context, addr_of.operand, decl_map);
        }
        
        case .Deref(deref) => {
            specialize_expr(context, deref.operand, decl_map);
        }
        
        case .Array(var array) => {
            specialize_expr_vec(context, &array.elements, decl_map);
        }
        
        case .Tuple(var tuple) => {
            specialize_expr_vec(context, &tuple.elements, decl_map);
        }
        
        case .ArrayIndex(array_index) => {
            specialize_expr(context, array_index.operand, decl_map);
            specialize_expr(context, array_index.index, decl_map);
        }
        
        case .TupleAccess(tuple_access) => {
            specialize_expr(context, tuple_access.operand, decl_map);
        }
        
        case .FieldAccess(field_access) => {
            specialize_expr(context, field_access.operand, decl_map);
        }
        
        case .StructInit(var struct_init) => {
            for (var i: usize = 0; i < struct_init.fields.len(); i += 1) {
                const field = struct_init.fields.get(i).unwrap();
                specialize_expr(context, &field->value, decl_map);
            }
        }
        
        case .UnionInit(union_init) => {
            specialize_expr(context, &union_init.field->value, decl_map);
        }
        
        case .FuncCall(var func_call) => {
            specialize_expr(context, func_call.operand, decl_map);
            specialize_expr_vec(context, &func_call.args, decl_map);
        }
        
        case .MethodCall(var method_call) => {
            specialize_expr(context, method_call.operand, decl_map);
            specialize_expr_vec(context, &method_call.args, decl_map);
        }
        
        case .Dynamic(dynamic_) => {
            specialize_expr(context, dynamic_.operand, decl_map);
        }
        
        case .Lambda(var lambda) => {
            specialize_func_params(context, &lambda.params, decl_map);
            specialize_block(context, lambda.body, decl_map);
        }
        
        case .Builtin(var builtin) => {
            switch (builtin) {
                case .BuiltinFunc(var builtin_func) => {
                    specialize_expr_vec(context, &builtin_func.args, decl_map);
                }
                case .BuiltinBlock(var builtin_block) => {
                    specialize_expr_vec(context, &builtin_block.args, decl_map);
                    specialize_block(context, builtin_block.block, decl_map);
                }
            }
        }
    }
}

fn specialize_expr_vec(
    context: AnalyzerContext*,
    exprs: Vec<cir::TypedExpr>*,
    decl_map: HashMap<usize, cir::VarDeclId>*
) {
    for (var i: usize = 0; i < exprs->len(); i += 1) {
        const element = exprs->get(i).unwrap();
        specialize_expr(context, element, decl_map);
    }
}

fn specialize_func_params(
    context: AnalyzerContext*,
    params: cir::TypedFuncParams*,
    decl_map: HashMap<usize, cir::VarDeclId>*
) {
    for (var i: usize = 0; i < params->list.len(); i += 1) {
        const param_kind = params->list.get(i).unwrap();

        switch (*param_kind) {
            case .FuncParam(var func_param) => {
                switch (func_param.var_decl_id) {
                    case .Some(var_decl_id) => {
                        switch (remap_var_decl_id(context, decl_map, var_decl_id)) {
                            case .Some(new_var_decl_id) => func_param.var_decl_id = .Some(new_var_decl_id);
                            else => {}
                        }
                    }
                    else => {}
                }

                *param_kind = .FuncParam(func_param);
            }
            case .SelfModifier(var self_modifier) => {
                switch (self_modifier.var_decl_id) {
                    case .Some(var_decl_id) => {
                        switch (remap_var_decl_id(context, decl_map, var_decl_id)) {
                            case .Some(new_var_decl_id) => self_modifier.var_decl_id = .Some(new_var_decl_id);
                            else => {}
                        }
                    }
                    else => {}
                }

                *param_kind = .SelfModifier(self_modifier);
            }
        }
    }

    switch (params->variadic) {
        case .Some(var variadic) => {
            switch (variadic) {
                case .UntypedCStyle => {}
                case .Typed { var ty, var span, var_decl_id } => {
                    switch (remap_var_decl_id(context, decl_map, var_decl_id)) {
                        case .Some(new_var_decl_id) => variadic = .Typed {
                            var_decl_id: new_var_decl_id,
                            ty,
                            span
                        };
                        else => {}
                    }
                }
            }

            params->variadic = .Some(variadic);
        }
        else => {}
    }
}

fn collect_and_instantiate_fresh_var_decls(
    context: AnalyzerContext*,
    stmt_kind: const cir::TypedStmtKind*,
    decl_map: HashMap<usize, cir::VarDeclId>*
) {
    switch (*stmt_kind) {
        case .Switch(switch_stmt) => {
            for (var i: usize = 0; i < switch_stmt.cases.len(); i += 1) {
                const case_item = switch_stmt.cases.get_const(i).unwrap();

                for (var j: usize = 0; j < case_item->patterns.len(); j += 1) {
                    const pattern = case_item->patterns.get_const(j).unwrap();
                    collect_fresh_var_decls_of_switch_pattern(context, pattern, decl_map);
                }

                collect_fresh_var_decls_in_block(context, case_item->body, decl_map);
            }
        }
        case .For(for_stmt) => {
            switch (for_stmt.initializer) {
                case .Some(var var_stmt) => {
                    instantiate_fresh_var_stmt(context, &var_stmt, decl_map);
                }
                else => {}
            }

            collect_fresh_var_decls_in_block(context, for_stmt.body, decl_map);
        }
        case .Expr(expr) => {
            switch (expr.kind) {
                case .Lambda(lambda) => {
                    collect_fresh_var_decls_of_func_params(context, &lambda.params, decl_map);
                    collect_fresh_var_decls_in_block(context, lambda.body, decl_map);
                }
                else => {}
            }
        }
        case .Builtin(builtin) => {
            switch (builtin) {
                case .BuiltinFunc => {}
                case .BuiltinBlock(builtin_block) => {
                    collect_fresh_var_decls_in_block(context, builtin_block.block, decl_map);
                }
            }
        }
        case .Defer(defer_stmt) => {
            collect_and_instantiate_fresh_var_decls(context, &defer_stmt.operand->kind, decl_map);
        }
        case .TupleExport(tuple_export) => {
            collect_fresh_var_decls_of_tuple_pattern(context, &tuple_export.pattern, decl_map);
        }
        case .Variable(var_stmt) => {
            instantiate_fresh_var_stmt(context, &var_stmt, decl_map);
        }
        case .BlockStmt(block) => {
            collect_fresh_var_decls_in_block(context, &block, decl_map);
        }
        case .While(while_stmt) => {
            collect_fresh_var_decls_in_block(context, while_stmt.body, decl_map);
        }
        case .If(if_) => {
            collect_fresh_var_decls_of_if(context, &if_, decl_map);
        }
        else => {}
    }
}

fn collect_fresh_var_decls_in_block(
    context: AnalyzerContext*,
    block: const cir::TypedBlockStmt*,
    decl_map: HashMap<usize, cir::VarDeclId>*
) {
    for (var i: usize = 0; i < block->stmts.len(); i += 1) {
        const stmt = block->stmts.get_const(i).unwrap();
        collect_and_instantiate_fresh_var_decls(context, &stmt->kind, decl_map);
    }

    for (var i: usize = 0; i < block->defers.len(); i += 1) {
        const defer_stmt = block->defers.get_const(i).unwrap();
        collect_and_instantiate_fresh_var_decls(context, &defer_stmt->operand->kind, decl_map);
    }
}

fn collect_fresh_var_decls_of_if(
    context: AnalyzerContext*,
    if_: const cir::TypedIfStmt*,
    decl_map: HashMap<usize, cir::VarDeclId>*
) {
    collect_fresh_var_decls_in_block(context, if_->then_block, decl_map);

    switch (if_->else_block) {
        case .Some(else_block) => {
            collect_fresh_var_decls_in_block(context, else_block, decl_map);
        }
        else => {}
    }

    for (var i: usize = 0; i < if_->branches.len(); i += 1) {
        const branch = if_->branches.get_const(i).unwrap();
        collect_fresh_var_decls_of_if(context, branch, decl_map);
    }
}

fn collect_fresh_var_decls_of_func_params(
    context: AnalyzerContext*,
    params: const cir::TypedFuncParams*,
    decl_map: HashMap<usize, cir::VarDeclId>*
) {
    for (var i: usize = 0; i < params->list.len(); i += 1) {
        const param_kind = params->list.get_const(i).unwrap();

        switch (*param_kind) {
            case .FuncParam(func_param) => {
                switch (func_param.var_decl_id) {
                    case .Some(var_decl_id) => instantiate_fresh_var_decl_from_tables(context, var_decl_id, decl_map);
                    else => {}
                }
            }
            case .SelfModifier(self_modifier) => {
                switch (self_modifier.var_decl_id) {
                    case .Some(var_decl_id) => instantiate_fresh_var_decl_from_tables(context, var_decl_id, decl_map);
                    else => {}
                }
            }
        }
    }

    switch (params->variadic) {
        case .Some(variadic) => {
            switch (variadic) {
                case .UntypedCStyle => {}
                case .Typed { var_decl_id, .. } => {
                    instantiate_fresh_var_decl_from_tables(context, var_decl_id, decl_map);
                }
            }
        }
        else => {}
    }
}

fn collect_fresh_var_decls_of_tuple_pattern(
    context: AnalyzerContext*,
    pattern: const cir::TypedTupleExportPattern*,
    decl_map: HashMap<usize, cir::VarDeclId>*
) {
    switch (pattern->kind) {
        case .Tuple(patterns) => {
            for (var i: usize = 0; i < patterns.len(); i += 1) {
                const inner = patterns.get_const(i).unwrap();
                collect_fresh_var_decls_of_tuple_pattern(context, inner, decl_map);
            }
        }
        case .Ident(var_decl_id) => {
            instantiate_fresh_var_decl_from_tables(context, var_decl_id, decl_map);
        }
        case .Ignore => {}
    }
}

fn collect_fresh_var_decls_of_switch_pattern(
    context: AnalyzerContext*,
    pattern: const cir::TypedSwitchCasePattern*,
    decl_map: HashMap<usize, cir::VarDeclId>*
) {
    switch (pattern->kind) {
        case .Wildcard 
        | .Range 
        | .Expr 
        | .EnumUnit => {}

        case .Binding { var_decl_id, .. } => {
            instantiate_fresh_var_decl_from_tables(context, var_decl_id, decl_map);
        }

        case .EnumTupleVariant { items, .. } => {
            for (var i: usize = 0; i < items.len(); i += 1) {
                const item = items.get_const(i).unwrap();
                collect_fresh_var_decls_of_switch_pattern(context, item, decl_map);
            }
        }

        case .EnumStructVariant { items, .. } => {
            for (var i: usize = 0; i < items.len(); i += 1) {
                const item = items.get_const(i).unwrap();
                collect_fresh_var_decls_of_switch_pattern(context, &item->pattern, decl_map);
            }
        }
    }
}

/* ************************** Helpers ************************* */

/* ************* Functions / Methods Helpers ************* */

fn check_func_variadic_arguments(
    context: AnalyzerContext*,
    func_decl: const cir::FuncDecl*,
    args: Vec<cir::TypedExpr>*,
    span: Span
) {
    const static_params_len = func_decl->params.list.len();

    if (static_params_len > args->len()) {
        return;
    }

    switch (func_decl->params.variadic) {
        case .Some(.Typed { ty, .. }) => {
            for (var i: usize = static_params_len; i < args->len(); i += 1) {
                const arg = args->get(i).unwrap();

                switch (analyze_expr(context, arg, arg->ty)) {
                    case .Some(arg_type) => {
                        if (!is_assignable_to(context, arg_type, ty, span)) {
                            var param_type_str = format::format_sema_type(context->allocator, context->decl_tables, &ty);
                            defer param_type_str.free();
                            var argument_type_str = format::format_sema_type(context->allocator, context->decl_tables, &arg_type);
                            defer argument_type_str.free();
                            diags::report_func_call_variadic_param_type_mismatch(
                                context->dctx,
                                context->allocator,
                                span,
                                @cast(uint32, i),
                                argument_type_str.as_str_const(),
                                param_type_str.as_str_const()
                            );
                        }
                    }
                    case .None => {}
                }
            }
        }
        case .Some(.UntypedCStyle) => {
            for (var i: usize = static_params_len; i < args->len(); i += 1) {
                const arg = args->get(i).unwrap();
                
                switch (analyze_expr(context, arg, arg->ty)) {
                    case .Some(arg_type) => {
                        if (arg_type.is_void()) {
                            diags::report_void_argument_in_variadic_param(
                                context->dctx,
                                context->allocator,
                                span
                            );
                        }
                    }
                    case .None => {}
                }
            }
        }
        case .None => {}
    }
}

fn check_func_type_call(
    context: AnalyzerContext*,
    func_type: cir::TypedFuncType*,
    args: Vec<cir::TypedExpr>*,
    span: Span
) Option<cir::SemaType> {
    const expected_args_len = func_type->params.list.len();
    const is_variadic = func_type->params.variadic.is_some();
    
    var func_name = format::format_func_type(context->allocator, context->decl_tables, func_type);
    defer func_name.free();

    if ((!is_variadic && args->len() != expected_args_len) 
        || (is_variadic && args->len() < expected_args_len)) {
        diags::report_func_call_args_count_mismatch(
            context->dctx,
            context->allocator,
            span,
            func_name.as_str_const(),
            @cast(uint32, expected_args_len),
            @cast(uint32, args->len())
        );
        return .None;
    }

    var i: usize = 0;

    while (i < expected_args_len && i < args->len()) {
        const param_type_raw = *func_type->params.list.get_const(i).unwrap();

        switch (normalize_and_check_type_formation(context, param_type_raw, span, 0)) {
            case .Some(param_type) => {
                const arg = args->get(i).unwrap();

                switch (analyze_expr(context, arg, .Some(param_type))) {
                    case .Some(arg_type) => {
                        if (!is_assignable_to(context, arg_type, param_type, arg->span)) {
                            var param_type_str = format::format_sema_type(context->allocator, context->decl_tables, &param_type);
                            defer param_type_str.free();
                            var argument_type_str = format::format_sema_type(context->allocator, context->decl_tables, &arg_type);
                            defer argument_type_str.free();
                            diags::report_func_call_param_type_mismatch(
                                context->dctx,
                                context->allocator,
                                arg->span,
                                @cast(uint32, i),
                                argument_type_str.as_str_const(),
                                param_type_str.as_str_const()
                            );
                        }
                    }
                    case .None => {}
                }
            }
            case .None => {}
        }

        i += 1;
    }

    if (is_variadic) {
        switch (func_type->params.variadic) case .Some(variadic) else {
            return .Some(*func_type->ret_type);
        }

        switch (*variadic) {
            case .Typed(ty) => {
                if (expected_args_len <= args->len()) {
                    for (var j: usize = expected_args_len; j < args->len(); j += 1) {
                        const arg = args->get(j).unwrap();

                        switch (analyze_expr(context, arg, arg->ty)) {
                            case .Some(arg_type) => {
                                if (!is_assignable_to(context, arg_type, ty, span)) {
                                    var param_type_str = format::format_sema_type(context->allocator, context->decl_tables, &ty);
                                    var argument_type_str = format::format_sema_type(context->allocator, context->decl_tables, &arg_type);
                                    
                                    diags::report_func_call_variadic_param_type_mismatch(
                                        context->dctx,
                                        context->allocator,
                                        span,
                                        @cast(uint32, j),
                                        argument_type_str.as_str_const(),
                                        param_type_str.as_str_const()
                                    );

                                    argument_type_str.free();
                                    param_type_str.free();
                                }
                            }
                            case .None => {}
                        }
                    }
                }
            }
            case .UntypedCStyle => {
                if (expected_args_len <= args->len()) {
                    for (var j: usize = expected_args_len; j < args->len(); j += 1) {
                        const arg = args->get(j).unwrap();
                        analyze_expr(context, arg, arg->ty);
                    }
                }
            }
        }
    }

    return .Some(*func_type->ret_type);
}

fn check_method_call(
    context: AnalyzerContext*,
    operand_type: const cir::SemaType*,
    method_decl: const cir::MethodDecl*,
    method_decls: const cir::MethodDecls*,
    object_name: const uint8*,
    is_thin_arrow: bool,
    is_interface_method_call: bool,
    is_operand_const_qualified: bool,
    span: Span
) {
    var access_violation = false;

    switch (context->func_env.current_method) {
        case .Some(current_method_id) => {
            if (method_decls->contains_method_id(current_method_id)) {
                access_violation = false;
            } else {
                access_violation = 
                    method_decl->func_decl.modifiers.vis != .Public 
                    && !is_interface_method_call;
            }
        }
        case .None => {
            access_violation = 
                method_decl->func_decl.modifiers.vis != .Public 
                && !is_interface_method_call;
        }
    }

    if (access_violation) {
        diags::report_internal_method_call(
            context->dctx,
            context->allocator,
            span,
            method_decl->func_decl.name.as_str_const(),
            object_name
        );
    }

    const is_base_type_pointer = operand_type->const_inner()->is_pointer();

    switch (method_decl->func_decl.params.get_self_modifier()) {
        case .Some(self_modifier) => {
            const is_self_const = self_modifier.constness == .Const;

            // Only if referenced
            if (!is_self_const && is_operand_const_qualified && self_modifier.is_indirect()) {
                var type_name = format::format_sema_type(
                    context->allocator,
                    context->decl_tables,
                    operand_type
                );
                
                diags::report_mutable_method_on_const_instance(
                    context->dctx,
                    context->allocator,
                    span,
                    method_decl->func_decl.name.as_str_const(),
                    type_name.as_str_const()
                );

                type_name.free();
            }
        }
        case .None => {}
    }

    if (is_base_type_pointer) {
        if (!is_thin_arrow) {
            diags::report_use_thin_arrow(context->dctx, context->allocator, span);
        }
    } else {
        if (is_thin_arrow) {
            diags::report_invalid_thin_arrow(context->dctx, context->allocator, span);
        }
    }
}

fn finalize_generic_method_call(
    context: AnalyzerContext*,
    method_call: cir::TypedMethodCall*,
    method_decl: cir::MethodDecl*,
    method_decl_id: cir::MethodDeclId,
    operand_type: cir::SemaType*,
    pure_operand_type: const cir::SemaType*,
    final_type_args: const cir::TypedTypeArgs*,
    is_instance_method_call: bool,
    span: Span
) Option<cir::SemaType> {
    switch (normalize_sema_type(context, method_decl->func_decl.ret_type, span, 0)) {
        case .Some(ty) => {
            method_decl->func_decl.ret_type = ty;
        }
        case .None => {
            return .None;
        }
    }

    generics::substitute_func_params(context, &method_decl->func_decl.params);
    method_decl->func_decl.ret_type = generics::substitute_type(context, &method_decl->func_decl.ret_type);

    const ret_type = method_decl->func_decl.ret_type;

    switch (monomorphize_generic_method_call(context,
        *pure_operand_type,
        method_decl_id,
        method_decl,
        final_type_args,
        false,
        span
    )) {
        case .Some(monomorph_id) => {
            method_call->operand->ty = .Some(*operand_type);
            method_call->dispatch = .Monomorph {
                monomorph_id,
                is_instance_method: is_instance_method_call,
            };
            return .Some(ret_type);
        }
        case .None => return .None;
    }
}

fn apply_self_type_in_method_decl_and_variable(
    context: AnalyzerContext*,
    method_decl: cir::MethodDecl*,
    concrete_self_type: const cir::SemaType*
) {
    for (var i: usize = 0; i < method_decl->func_decl.params.list.len(); i += 1) {
        const kind = method_decl->func_decl.params.list.get(i).unwrap();

        switch (*kind) {
            case .FuncParam(var func_param) => {
                func_param.ty = generics::substitute_self_type(context, &func_param.ty, concrete_self_type);
                *kind = .FuncParam(func_param);
            }
            case .SelfModifier(var self_modifier) => {
                self_modifier.ty = generics::substitute_self_type(context, &self_modifier.ty, concrete_self_type);

                switch (self_modifier.var_decl_id) {
                    case .Some(var_decl_id) => {
                        const var_decl = context->decl_tables->vars.get(var_decl_id);
                        
                        switch (var_decl) {
                            case .Some(entry) => entry->ty = .Some(self_modifier.ty);
                            case .None => {}
                        }
                    }
                    case .None => {}
                }

                *kind = .SelfModifier(self_modifier);
            }
        }
    }

    switch (normalize_sema_type(context, method_decl->func_decl.ret_type, method_decl->func_decl.span, 0)) {
        case .Some(ty) => method_decl->func_decl.ret_type = ty;
        case .None => {}
    }

    var subst_ret_type = generics::substitute_self_type(context, &method_decl->func_decl.ret_type, concrete_self_type);
    
    switch (context->func_env.infer) {
        case .Some(infer_ctx) => subst_ret_type = infer_ctx->resolve(&subst_ret_type);
        case .None => {}
    }

    method_decl->func_decl.ret_type = subst_ret_type;
}

fn set_operand_named_type_args(
    context: AnalyzerContext*,
    ty: cir::SemaType*,
    generic_params: cir::TypedGenericParams
) bool {
    switch (*ty) {
        case .Named(var named_type) => {
            named_type.type_args = instantiated_type_args(context, generic_params);
            *ty = .Named(named_type);
            return true;
        }
        case .Pointer(inner) => {
            return set_operand_named_type_args(context, inner, generic_params);
        }
        case .Const(inner) => {
            return set_operand_named_type_args(context, inner, generic_params);
        }
        else => {
            return false;
        }
    }
}

/* ************* Generics Helpers ************* */

fn apply_generic_defaults(context: AnalyzerContext*, generic_params: cir::TypedGenericParams) {
    for (var i: usize = 0; i < generic_params.len(); i += 1) {
        const generic_param_id = *generic_params.ids.get_const(i).unwrap();
        
        const generic_param = 
            context
            ->decl_tables
            ->generic_params.get_const(generic_param_id).unwrap();

        var binding: Option<cir::SemaType> = .None;

        switch (generics::current_generic_env(context)) {
            case .Some(env) => {
                binding = env->lookup(generic_param_id);
            }
            case .None => {}
        }

        switch (binding) {
            case .Some(bound_type) => {
                var ty: cir::SemaType = .Placeholder;

                switch (context->func_env.infer) {
                    case .Some(infer_ctx) => ty = infer_ctx->resolve(&bound_type);
                    case .None => ty = bound_type;
                }

                switch (ty) {
                    case .InferVar(var_id) => {
                        switch (generic_param->default) {
                            case .Some(default_type) => {
                                const ty = generics::substitute_type(context, default_type);

                                switch (context->func_env.infer) {
                                    case .Some(infer_ctx) => {
                                        const infer_var_ty: cir::SemaType = .InferVar(var_id);
                                        infer_ctx->unify(&infer_var_ty, &ty);
                                    }
                                    case .None => {}
                                }
                            }
                            case .None => {}
                        }
                    }
                    else => {}
                }
            }
            case .None => {
                switch (generic_param->default) {
                    case .Some(default_type) => {
                        const ty = generics::substitute_type(context, default_type);

                        switch (generics::current_generic_env(context)) {
                            case .Some(env) => env->bind(generic_param_id, ty);
                            case .None => {}
                        }
                    }
                    case .None => {}
                }
            }
        }
    }
}

fn instantiated_type_args(
    context: AnalyzerContext*,
    generic_params: cir::TypedGenericParams
) cir::TypedTypeArgs {
    var args = cir::TypedTypeArgs.new(context->allocator);

    for (var i: usize = 0; i < generic_params.len(); i += 1) {
        const generic_param_id = *generic_params.ids.get_const(i).unwrap();
        const generic_param = context->decl_tables->generic_params.get_const(generic_param_id).unwrap();

        var ty: cir::SemaType = .Placeholder;

        switch (generics::lookup_generic_binding(context, generic_param_id)) {
            case .Some(bound) => ty = bound;
            case .None => {}
        }

        switch (context->func_env.infer) {
            case .Some(infer_ctx) => ty = infer_ctx->resolve(&ty);
            case .None => {}
        }

        args.push(.Type(ty, generic_param->name.span));
    }

    return args;
}

fn check_argument_satisfies_generic_param_bounds(
    context: AnalyzerContext*,
    original_params: const cir::TypedFuncParams*,
    param_name: const uint8*,
    arg_type: const cir::SemaType*,
    arg_loc: Span,
    arg_index: usize
) bool {
    switch (original_params->lookup_param(param_name)) case .Some(original_param) else {
        return false;
    }

    var original_param_type = original_param->ty();

    switch (original_param_type.as_generic_param()) case .Some(generic_param_id) else {
        return false;
    }

    var error = false;
    
    const generic_param = context
        ->decl_tables
        ->generic_params
        .get_const(generic_param_id).unwrap();

    for (var i: usize = 0; i < generic_param->bounds.len(); i += 1) {
        const bound = generic_param->bounds.get_const(i).unwrap();

        // Prevent cascading failures
        if (!bound->ty.is_interface()) {
            continue;
        }

        var satisfies_bound = false;

        switch (arg_type->as_named_type()) {
            case .Some(named_type) => {
                switch (implement_interfaces_of_named_type(
                    context->decl_tables, 
                    &named_type
                )) {
                    case .Some(impls) => {
                        for (var j: usize = 0; j < impls->len() && !satisfies_bound; j += 1) {
                            const implement_interface = impls->get_const(j).unwrap();
                            
                            if (!is_assignable_to(
                                context, 
                                implement_interface->ty,
                                bound->ty, 
                                bound->span
                            )) {
                                satisfies_bound = true;
                            }
                        }
                    }
                    case .None => {}
                }
            }
            case .None => {}
        }

        if (!satisfies_bound) {
            error = true;

            var expected_bound = format::format_sema_type(
                context->allocator, 
                context->decl_tables, 
                &bound->ty
            );
            var found_type = format::format_sema_type(
                context->allocator, 
                context->decl_tables, 
                arg_type
            );

            diags::report_argument_does_not_satisfy_bound(
                context->dctx,
                context->allocator,
                arg_loc,
                arg_index,
                expected_bound.as_str_const(),
                found_type.as_str_const()
            );

            expected_bound.free();
            found_type.free();
        }
    }

    return error; 
}

/* ************* Monomorph Helpers ************* */

fn monomorphize_generic_func_call(
    context: AnalyzerContext*,
    operand_type: const cir::SemaType*,
    func_call: cir::TypedFuncCall*,
    func_decl_id: cir::FuncDeclId,
    func_decl: cir::FuncDecl*,
    final_type_args: const cir::TypedTypeArgs*
) Option<cir::SemaType> {
    func_call->operand->ty = .Some(generics::substitute_type(context, operand_type));
    generics::substitute_func_params(context, &func_decl->params);
    func_decl->ret_type = generics::substitute_type(context, &func_decl->ret_type);

    if (!check_type_arity(context, func_decl->ret_type, func_call->span)) {
        return .None;
    }

    switch (context->func_env.current_func) {
        case .Some(var updated) => {
            updated.params = cir::func_params_as_type_params(context->allocator, &func_decl->params);
            updated.ret_type = alloc_init(context->allocator, func_decl->ret_type);
            context->func_env.current_func = .Some(updated);
        }
        case .None => {}
    }

    const monomorph_id = context->monomorph_registry.get_or_create(
        dynamic context->arena,
        .Func(func_decl_id),
        final_type_args,
        func_decl->params,
        func_decl->ret_type
    );

    if (!context->monomorph_registry.is_analyzed(monomorph_id)) {
        context->monomorph_registry.mark_analyzed(monomorph_id);

        switch (func_decl->body) {
            case .Some(body_id) => {
                switch (context->decl_tables->bodies.get_const(body_id)) {
                    case .Some(template_body) => {
                        var body = specialize_func_body(context, template_body, &func_decl->params);
                        
                        analyze_func_body(context, &body, &func_decl->ret_type);

                        const body_id = context->decl_tables->insert_body(body);

                        context->monomorph_registry.set_body_and_params(
                            monomorph_id,
                            body_id,
                            func_decl->params
                        );
                    }
                    else => {}
                }
            }
            else => {}
        }
    }

    func_call->dispatch = .Monomorph { monomorph_id };

    return .Some(func_decl->ret_type);
}

fn monomorphize_generic_method_call(
    context: AnalyzerContext*,
    pure_operand_type: cir::SemaType,
    method_decl_id: cir::MethodDeclId,
    method_decl: cir::MethodDecl*,
    final_type_args: const cir::TypedTypeArgs*,
    is_generic_interface_method_call: bool,
    span: Span
) Option<cir::MonomorphId> {
    if (!is_generic_interface_method_call) {
        // Substitute Self inside params, ret_type, variables
        apply_self_type_in_method_decl_and_variable(context, method_decl, &pure_operand_type);
    }

    generics::substitute_func_params(context, &method_decl->func_decl.params);
    method_decl->func_decl.ret_type = generics::substitute_type(context, &method_decl->func_decl.ret_type);

    if (!check_type_arity(context, method_decl->func_decl.ret_type, span)) {
        return .None;
    }

    switch (context->func_env.current_func) {
        case .Some(var updated) => {
            updated.params = cir::func_params_as_type_params(context->allocator, &method_decl->func_decl.params);
            updated.ret_type = alloc_init(context->allocator, method_decl->func_decl.ret_type);
            context->func_env.current_func = .Some(updated);
        }
        case .None => {}
    }

    const monomorph_id = context->monomorph_registry.get_or_create(
        dynamic context->arena,
        .Method(method_decl_id),
        final_type_args,
        method_decl->func_decl.params,
        method_decl->func_decl.ret_type
    );

    if (!is_generic_interface_method_call && !context->monomorph_registry.is_analyzed(monomorph_id)) {
        context->monomorph_registry.mark_analyzed(monomorph_id);

        switch (method_decl->body) {
            case .Some(body_id) => {
                switch (context->decl_tables->bodies.get_const(body_id)) {
                    case .Some(template_body) => {
                        var specialized = specialize_func_body(context,
                            template_body,
                            &method_decl->func_decl.params
                        );
                        analyze_func_body(context, &specialized, &method_decl->func_decl.ret_type);

                        const specialized_body_id = context->decl_tables->insert_body(specialized);
                        context->monomorph_registry.set_body_and_params(
                            monomorph_id,
                            specialized_body_id,
                            method_decl->func_decl.params
                        );
                    }
                    else => {}
                }
            }
            else => {}
        }
    }

    return .Some(monomorph_id);
}

fn monomorphize_interface_object_methods(
    context: AnalyzerContext*,
    vtable_id: cir::VTableId,
    methods: const cir::MethodDecls*,
    is_interface_generic: bool,
    concrete_type: const cir::SemaType*,
    span: Span
) {
    switch (concrete_type->as_named_type()) case .Some(concrete_named) else {
        return;
    }

    const object_generic_params = *tables::type_decl_generic_params(
        context->decl_tables, 
        concrete_named.type_decl_id
    );

    const is_object_generic = !object_generic_params.is_empty();

    for (var method_index: usize = 0; method_index < methods->entries.len(); method_index += 1) {
        const entry = methods->entries.get_const(method_index).unwrap();

        if (is_interface_generic && is_object_generic) {
            // Monomorphize object method

            switch (context->decl_tables->methods.get_owned(entry->id)) case .Some(var method_decl_storage) else {
                continue;
            }

            method_decl_storage.func_decl.params = clone::clone_func_params(
                context->allocator, 
                &method_decl_storage.func_decl.params
            );

            const method_decl = &method_decl_storage;

            switch (create_inference_generic_env(context,
                entry->name.as_str_const(),
                object_generic_params,
                &concrete_named.type_args,
                span
            )) case .Some(object_method_generic_env) else {
                continue;
            }

            generics::push_generic_env(context, object_method_generic_env);

            // Substitute function params
            generics::substitute_func_params(context, &method_decl_storage.func_decl.params);

            // Substitute return type
            method_decl_storage.func_decl.ret_type = generics::substitute_type(context,
                &method_decl_storage.func_decl.ret_type
            );

            // Substitute Self inside the context modifier
            switch (method_decl->func_decl.params.list.first()) {
                case .Some(first_kind) => {
                    switch (*first_kind) {
                        case .SelfModifier(var self_modifier) => {
                            self_modifier.ty = generics::substitute_self_type(context,
                                &self_modifier.ty, 
                                concrete_type
                            );
                            *first_kind = .SelfModifier(self_modifier);
                        }
                        else => {}
                    }
                }
                case .None => {}
            }

            const func_type = cir::func_decl_as_func_type(
                context->allocator, 
                &method_decl_storage.func_decl
            );

            var func_env = create_method_env(context, entry->id, func_type, context->func_env.infer);

            const final_generics_params = cir::extend_generic_params(
                context->allocator,
                &method_decl_storage.func_decl.generic_params,
                &object_generic_params
            );

            const final_type_args = instantiated_type_args(context, final_generics_params);

            var saved_func_env = context->func_env;
            context->func_env = func_env;
            context->func_env.current_object = .Some(*concrete_type);

            const monomorph_id_opt = monomorphize_generic_method_call(context,
                *concrete_type,
                entry->id,
                method_decl,
                &final_type_args,
                true,
                span
            );
            context->func_env = saved_func_env;

            switch (monomorph_id_opt) {
                case .Some(monomorph_id) => {
                    context->vtable_registry.set_monomorphized_method(
                        vtable_id,
                        method_index,
                        monomorph_id
                    );
                }
                case .None => {}
            }

            generics::pop_generic_env(context);
        }
    }
}

/* ************* Inline ASM Helpers ************* */

/// Strips leading and trailing `{` and `}` from an asm constraint.
fn asm_trim_constraint(allocator: Allocator, constraint: const uint8*) String {
    var len: usize = 0;

    while (constraint[len] != 0) {
        len += 1;
    }

    var start: usize = 0;
    var end: usize = len;

    while (start < len && (constraint[start] == '{' || constraint[start] == '}')) {
        start += 1;
    }

    while (end > start && (constraint[end - 1] == '{' || constraint[end - 1] == '}')) {
        end -= 1;
    }

    var result = String.new(allocator);

    for (var i: usize = start; i < end; i += 1) {
        result.push(constraint[i]);
    }
    
    return result;
}

fn asm_is_integer_bool_or_pointer(ty: const cir::SemaType*) bool {
    switch (*ty) {
        case .Const(inner) => return asm_is_integer_bool_or_pointer(inner);
        case .Plain(plain) => return plain.is_integer_or_bool();
        case .Pointer => return true;
        else => return false;
    }
}

fn check_asm_template(context: AnalyzerContext*, asm: cir::TypedInlineAsm*) {
    if (asm->template.len() == 0) {
        diags::report_asm_empty_template(context->dctx, context->allocator, asm->span);
    }
}

fn check_asm_outputs(context: AnalyzerContext*, asm: cir::TypedInlineAsm*) {
    for (var i: usize = 0; i < asm->outputs.len(); i += 1) {
        const operand = asm->outputs.get(i).unwrap();

        analyze_expr_non_terminal(context, operand->expr, .None);

        var is_poisoned = false;

        switch (operand->expr->ty) {
            case .Some(ty) => is_poisoned = ty.contains_error();
            case .None => is_poisoned = false;
        }

        if (!operand->expr->is_lvalue() && !is_poisoned) {
            diags::report_asm_output_not_lvalue(context->dctx, context->allocator, operand->span);
        }

        const trimmed = asm_trim_constraint(context->allocator, operand->constraint.as_str_const());
        defer trimmed.free();
        
        const first = trimmed.as_str_const()[0];

        if (first != '=' && first != '+') {
            diags::report_asm_invalid_output_constraint(
                context->dctx,
                context->allocator,
                operand->span,
                operand->constraint.as_str_const()
            );
        }
    }
}

fn check_asm_inputs(context: AnalyzerContext*, asm: cir::TypedInlineAsm*) {
    for (var i: usize = 0; i < asm->inputs.len(); i += 1) {
        const operand = asm->inputs.get(i).unwrap();

        analyze_expr_non_terminal(context, operand->expr, .None);

        const trimmed = asm_trim_constraint(context->allocator, operand->constraint.as_str_const());
        defer trimmed.free();

        const first = trimmed.as_str_const()[0];

        if (first == '=' || first == '+') {
            diags::report_asm_invalid_input_constraint(
                context->dctx,
                context->allocator,
                operand->span,
                operand->constraint.as_str_const()
            );
        }
    }
}

fn check_asm_clobbers(context: AnalyzerContext*, asm: cir::TypedInlineAsm*) {
    var seen: Vec<String> = Vec.new(context->allocator);

    for (var i: usize = 0; i < asm->clobbers.len(); i += 1) {
        const clobber = asm->clobbers.get_const(i).unwrap();

        var name = clobber->name.clone(context->allocator);
        name.to_lower();

        var already_seen = false;

        for (var j: usize = 0; j < seen.len(); j += 1) {
            const item = seen.get_const(j).unwrap();

            if (item->as_str_const() == name.as_str_const()) {
                already_seen = true;
                break;
            }
        }

        if (already_seen) {
            diags::report_asm_duplicate_clobber(
                context->dctx,
                context->allocator,
                clobber->span,
                clobber->name.as_str_const()
            );
            name.free();
        } else {
            seen.push(name);
        }
    }

    free_strings(&seen);
}

fn check_asm_template_indices(context: AnalyzerContext*, asm: cir::TypedInlineAsm*) {
    const total_operands = asm->outputs.len() + asm->inputs.len();

    for (var li: usize = 0; li < asm->template.len(); li += 1) {
        const line = asm->template.get_const(li).unwrap();
        const chars = line->as_str_const();

        var i: usize = 0;

        while (chars[i] != 0) {
            if (chars[i] == '%') {
                i += 1;

                if (chars[i] >= '0' && chars[i] <= '9') {
                    var index: usize = 0;

                    while (chars[i] != 0 && chars[i] >= '0' && chars[i] <= '9') {
                        index = (index * 10) + @cast(usize, chars[i] - '0');
                        i += 1;
                    }

                    if (index >= total_operands) {
                        diags::report_asm_operand_index_out_of_bounds(
                            context->dctx,
                            context->allocator,
                            asm->span,
                            index,
                            total_operands,
                            asm->outputs.len(),
                            asm->inputs.len()
                        );
                    }
                }
            } else {
                i += 1;
            }
        }
    }
}

fn check_asm_constraint_types(context: AnalyzerContext*, asm: cir::TypedInlineAsm*) {
    for (var i: usize = 0; i < asm->outputs.len(); i += 1) {
        const operand = asm->outputs.get_const(i).unwrap();
        check_asm_operand_constraint_types(context, operand);
    }

    for (var i: usize = 0; i < asm->inputs.len(); i += 1) {
        const operand = asm->inputs.get_const(i).unwrap();
        check_asm_operand_constraint_types(context, operand);
    }
}

fn check_asm_operand_constraint_types(
    context: AnalyzerContext*,
    operand: const cir::TypedAsmOperand*
) {
    const raw = asm_trim_constraint(context->allocator, operand->constraint.as_str_const());
    defer raw.free();

    const raw_str = raw.as_str_const();

    var bare = String.new(context->allocator);
    defer bare.free();

    var i: usize = 0;

    while (raw_str[i] == '{' || raw_str[i] == '}') {
        i += 1;
    }
    while (raw_str[i] == '=' || raw_str[i] == '+') {
        i += 1;
    }
    while (raw_str[i] == '{' || raw_str[i] == '}') {
        i += 1;
    }
    while (raw_str[i] != 0 && raw_str[i] != '{' && raw_str[i] != '}') {
        bare.push(raw_str[i]);
        i += 1;
    }

    switch (operand->expr->ty) {
        case .Some(ty) => {
            if (ty.contains_error()) {
                return;
            }

            const bare_str = bare.as_str_const();

            var ok = true;
            var hint = "";

            if (bare_str == "r" || bare_str == "g") {
                ok = asm_is_integer_bool_or_pointer(&ty);
                hint = "constraint `r`/`g` requires an integer, bool, or pointer";
            } else if (bare_str == "m") {
                ok = ty.is_pointer();
                hint = "constraint `m` requires a pointer";
            } else if (bare_str == "i") {
                ok = asm_is_integer_bool_or_pointer(&ty);
                if (ok) {
                    ok = ciri::fold_const_expr_int(context->decl_tables, context->registry, operand->expr).is_some();
                }
                hint = "constraint `i` requires a compile-time constant integer";
            }

            if (!ok) {
                var found = format::format_sema_type(context->allocator, context->decl_tables, &ty);

                diags::report_asm_constraint_type_mismatch(
                    context->dctx,
                    context->allocator,
                    operand->span,
                    bare_str,
                    found.as_str_const(),
                    hint
                );

                found.free();
            }
        }
        case .None => {}
    }
}

/* ************* Builtins Helpers ************* */

fn check_builtin_form(
    context: AnalyzerContext*,
    builtin_spec: cir::TypedBuiltinSpec,
    actual: cir::TypedBuiltinForm,
    span: Span
) bool {
    if (builtin_spec.form != actual) {
        diags::report_invalid_builtin_form(
            context->dctx,
            context->allocator,
            span,
            builtin_spec.name
        );
        return false;
    }

    return true;
}

fn check_builtin_arg_count(
    context: AnalyzerContext*,
    spec: cir::TypedBuiltinSpec,
    count: usize,
    span: Span
) bool {
    if (count < spec.min_args) {
        diags::report_builtin_too_few_args(
            context->dctx,
            context->allocator,
            span,
            spec.name,
            spec.min_args,
            count
        );
        return false;
    }

    switch (spec.max_args) {
        case .Some(max) => {
            if (count > max) {
                diags::report_builtin_too_many_args(
                    context->dctx,
                    context->allocator,
                    span,
                    spec.name,
                    max,
                    count
                );
                return false;
            }
        }
        case .None => {}
    }

    return true;
}

fn builtin_const_mesg_param_type(this: context::AnalyzerContext*) cir::SemaType {
    const uint8_type: cir::SemaType = .Plain(.UInt8);
    const const_uint8_type: cir::SemaType = .Const(alloc_init(this->allocator, uint8_type));
    return .Pointer(alloc_init(this->allocator, const_uint8_type));
}

fn builtin_copy_memset_param_type(
    this: context::AnalyzerContext*,
    is_memcpy: bool,
    index: usize
) cir::SemaType {
    const void_type: cir::SemaType = .Plain(.Void);
    const const_void_ty: cir::SemaType = .Const(alloc_init(this->allocator, void_type));

    var param: cir::SemaType = .Plain(.USize);

    if (index == 0) {
        param = .Pointer(alloc_init(this->allocator, void_type));
    } else if (index == 1) {
        if (is_memcpy) {
            param = .Pointer(alloc_init(this->allocator, const_void_ty));
        } else {
            param = .Plain(.Int8);
        }
    }

    return param;
}

/* ************* Switch Helpers ************* */

fn is_switch_range_valid(
    existing: const Vec<usize>*,
    new_ranges: const Vec<usize>*
) bool {
    var i: usize = 0;

    while (i + 1 < new_ranges->len()) {
        const new_start = *new_ranges->get_const(i).unwrap();
        const new_end = *new_ranges->get_const(i + 1).unwrap();

        if (new_start > new_end) {
            return false;
        }

        var j: usize = 0;

        while (j + 1 < existing->len()) {
            const old_start = *existing->get_const(j).unwrap();
            const old_end = *existing->get_const(j + 1).unwrap();

            if (new_start <= old_end && old_start <= new_end) {
                return false;
            }

            j += 2;
        }

        i += 2;
    }

    return true;
}

/* ************* Unions Helpers ************* */

fn check_duplicate_union_field(
    context: AnalyzerContext*,
    object_name: const uint8*,
    fields: const Vec<cir::TypedUnionField>*
) {
    for (var i: usize = 0; i < fields->len(); i += 1) {
        const field = fields->get_const(i).unwrap();

        for (var j: usize = 0; j < i; j += 1) {
            const other = fields->get_const(j).unwrap();

            if (field->name.as_str_const() == other->name.as_str_const()) {
                diags::report_duplicate_field_name(
                    context->dctx,
                    context->allocator,
                    field->span,
                    object_name,
                    field->name.as_str_const()
                );
                break;
            }
        }
    }
}

fn check_union_repr_attr(
    context: AnalyzerContext*,
    repr_attr: const Option<ast::ASTReprAttr>*,
    fields_count: usize,
    span: Span
) {
    switch (*repr_attr) {
        case .Some(attr) => {
            if (cir::is_attr_repr_packed(&attr)) {
                diags::report_invalid_repr_attr(
                    context->dctx,
                    context->allocator,
                    span,
                    "packed layout is not supported for unions",
                "remove the `repr(packed)` attribute"
                );
                return;
            }

            switch (cir::repr_attr_kind(&attr)) {
                case .Some(.Cyrus) => return;
                case .Some(.C) => return;
                case .Some(.Transparent) => {
                    if (fields_count != 1) {
                        diags::report_invalid_repr_attr(
                            context->dctx,
                            context->allocator,
                            span,
                            "`repr(transparent)` union must have exactly one field",
                        "remove the extra fields or drop the `repr(transparent)` attribute"
                        );
                    }
                }
                case .None => return;
            }
        }
        case .None => return;
    }
}

fn check_union_field_type(
    context: AnalyzerContext*,
    union_decl_id: cir::UnionDeclId,
    field_type: const cir::SemaType*,
    span: Span
) {
    const inner = field_type->const_inner();

    if (inner->is_void()) {
        diags::report_void_field_type(
            context->dctx, 
            context->allocator, 
            span
        );
    }

    const ty = cir::NamedType {
        type_decl_id: .Union(union_decl_id),
        type_args: cir::TypedTypeArgs.new(context->allocator),
    };

    if (cir::type_contains_self_by_value(inner, &ty)) {
        var type_name = format::format_sema_type(
            context->allocator, 
            context->decl_tables, 
            inner
        );
        
        diags::report_infinite_size_recursive_type(
            context->dctx, 
            context->allocator, 
            span, 
            type_name.as_str_const()
        );

        type_name.free();
        return;
    }

    check_type_arity(context, *inner, span);
}

/* ************* Enums Helpers ************* */

fn check_duplicate_enum_variants(
    context: AnalyzerContext*,
    object_name: const uint8*,
    variants: const Vec<cir::TypedEnumVariant>*
) {
    for (var i: usize = 0; i < variants->len(); i += 1) {
        const variant = variants->get_const(i).unwrap();
        const name = variant->name();

        for (var j: usize = 0; j < i; j += 1) {
            const prev = variants->get_const(j).unwrap();

            if (prev->name() == name) {
                diags::report_duplicate_enum_variant_name(
                    context->dctx,
                    context->allocator,
                    variant->span(),
                    object_name,
                    name
                );
                break;
            }
        }
    }
}

fn check_enum_variant_field_type(
    context: AnalyzerContext*, 
    enum_decl_id: cir::EnumDeclId, 
    field_type: const cir::SemaType*, 
    span: Span
) {
    const inner = field_type->const_inner();

    const ty = cir::NamedType {
        type_decl_id: .Enum(enum_decl_id),
        type_args: cir::TypedTypeArgs.new(context->allocator),
    };

    if (cir::type_contains_self_by_value(inner, &ty)) {
        var type_name = format::format_sema_type(
            context->allocator, 
            context->decl_tables, 
            inner
        );
        
        diags::report_infinite_size_recursive_type(
            context->dctx, 
            context->allocator, 
            span, 
            type_name.as_str_const()
        );
        
        type_name.free();
        return;
    }

    check_type_arity(context, *inner, span);
}

fn check_enum_repr_attr(
    context: AnalyzerContext*, 
    repr_attr: const Option<ast::ASTReprAttr>*, 
    has_align: bool, 
    span: Span
) {
    switch (*repr_attr) {
        case .Some(attr) => {
            if (cir::is_attr_repr_packed(&attr)) {
                diags::report_invalid_repr_attr(
                    context->dctx,
                    context->allocator,
                    span,
                    "`repr(packed)` is not valid for enums",
                    "remove the `repr(packed)` attribute"
                );
                return;
            }

            switch (cir::repr_attr_kind(&attr)) {
                case .Some(.C) => {
                    if (has_align) {
                        diags::report_invalid_repr_attr(
                            context->dctx,
                            context->allocator,
                            span,
                            "cannot specify alignment with `repr(c)` or `repr(cyrus)` enum layout, alignment is determined by the target ABI",
                            "remove the alignment from the repr attribute"
                        );
                        return;
                    }
                }
                case .Some(.Cyrus) => {
                    if (has_align) {
                        diags::report_invalid_repr_attr(
                            context->dctx,
                            context->allocator,
                            span,
                            "cannot specify alignment with `repr(c)` or `repr(cyrus)` enum layout, alignment is determined by the target ABI",
                            "remove the alignment from the repr attribute"
                        );
                        return;
                    }
                }
                case .Some(.Transparent) => {
                    diags::report_invalid_repr_attr(
                        context->dctx,
                        context->allocator,
                        span,
                        "`repr(transparent)` cannot be applied to enums",
                        "enums only support `repr(c)` and `repr(cyrus)` layouts"
                    );
                    return;
                }
                case .None => return;
            }
        }
        case .None => return;
    }
}

fn check_enum_tag_type(
    context: AnalyzerContext*,
    tag_type: const Option<cir::SemaType>*,
    span: Span
) {
    switch (*tag_type) {
        case .Some(ty) => {
            const inner = ty.const_inner();
            const valid = inner->is_integer() 
                || inner->is_uint8() 
                || inner->is_bool();

            if (!valid) {
                var got = format::format_sema_type(context->allocator, context->decl_tables, inner);
                defer got.free();
                diags::report_invalid_enum_tag_type(context->dctx, context->allocator, span, got.as_str_const());
            }
        }
        case .None => return;
    }
}

/* ************* Structs Helpers ************* */

fn check_invalid_struct_fields(
    context: AnalyzerContext*,
    struct_decl: const cir::StructDecl*,
    fields: const Vec<cir::TypedFieldInit>*
) {
    var struct_name = format::format_struct_decl(context->allocator, context->decl_tables, struct_decl);
    defer struct_name.free();

    for (var i: usize = 0; i < fields->len(); i += 1) {
        const field_init = fields->get_const(i).unwrap();
        const field_name = field_init->name.as_str_const();

        var found = false;
        
        for (var j: usize = 0; j < struct_decl->fields.len(); j += 1) {
            const field = struct_decl->fields.get_const(j).unwrap();

            if (field->name.as_str_const() == field_name) {
                found = true;
                break;
            }
        }

        if (!found) {
            diags::report_object_has_no_field_named(
                context->dctx,
                context->allocator,
                field_init->span,
                struct_name.as_str_const(),
                field_name
            );
        }
    }

}


fn check_missing_struct_fields(
    context: AnalyzerContext*,
    struct_decl: const cir::StructDecl*,
    fields: const Vec<cir::TypedFieldInit>*,
    span: Span
) {
    var missing = String.new(context->allocator);
    defer missing.free();

    var has_missing = false;

    for (var i: usize = 0; i < struct_decl->fields.len(); i += 1) {
        const decl_field = struct_decl->fields.get_const(i).unwrap();

        var found = false;
        for (var j: usize = 0; j < fields->len(); j += 1) {
            const field_init = fields->get_const(j).unwrap();
            if (field_init->name.as_str_const() == decl_field->name.as_str_const()) {
                found = true;
                break;
            }
        }

        if (!found) {
            if (has_missing) {
                missing.push_str(", ");
            }
            missing.push_str("`");
            missing.push_str(decl_field->name.as_str_const());
            missing.push_str("`");
            has_missing = true;
        }
    }

    if (has_missing) {
        var type_name = format::format_struct_decl(
            context->allocator, 
            context->decl_tables, 
            struct_decl
        );
        
        diags::report_struct_missing_fields(
            context->dctx,
            context->allocator,
            span,
            type_name.as_str_const(),
            missing.as_str_const()
        );

        type_name.free();
    }

}


fn check_duplicate_struct_field_init(
    context: AnalyzerContext*,
    fields: const Vec<cir::TypedFieldInit>*
) {
    for (var i: usize = 0; i < fields->len(); i += 1) {
        const field = fields->get_const(i).unwrap();

        var is_duplicate = false;

        for (var j: usize = 0; j < i; j += 1) {
            const earlier = fields->get_const(j).unwrap();
            if (earlier->name.as_str_const() == field->name.as_str_const()) {
                is_duplicate = true;
                break;
            }
        }

        if (is_duplicate) {
            diags::report_duplicate_field_initializer(
                context->dctx,
                context->allocator,
                field->span,
                field->name.as_str_const()
            );
        }
    }
}


fn check_invalid_struct_fields_for_unnamed_struct_value(
    context: AnalyzerContext*,
    struct_decl: const cir::StructDecl*,
    struct_valueue: const cir::TypedUnnamedStructValue*
) {
    var struct_name = format::format_struct_decl(
        context->allocator, 
        context->decl_tables, 
        struct_decl
    );
    defer struct_name.free();

    for (var i: usize = 0; i < struct_valueue->fields.len(); i += 1) {
        const field = struct_valueue->fields.get_const(i).unwrap();
        const field_name = field->name.as_str_const();

        var found = false;

        for (var j: usize = 0; j < struct_decl->fields.len(); j += 1) {
            const field = struct_decl->fields.get_const(j).unwrap();
            
            if (field->name.as_str_const() == field_name) {
                found = true;
                break;
            }
        }

        if (!found) {
            diags::report_object_has_no_field_named(
                context->dctx,
                context->allocator,
                field->span,
                struct_name.as_str_const(),
                field_name
            );
        }
    }

}


fn check_missing_struct_fields_for_unnamed_struct_value(
    context: AnalyzerContext*,
    struct_decl: const cir::StructDecl*,
    struct_valueue: const cir::TypedUnnamedStructValue*
) {
    var missing = String.new(context->allocator);
    defer missing.free();

    var has_missing = false;

    for (var i: usize = 0; i < struct_decl->fields.len(); i += 1) {
        const decl_field = struct_decl->fields.get_const(i).unwrap();

        var found = false;
        for (var j: usize = 0; j < struct_valueue->fields.len(); j += 1) {
            const field = struct_valueue->fields.get_const(j).unwrap();
            if (field->name.as_str_const() == decl_field->name.as_str_const()) {
                found = true;
                break;
            }
        }

        if (!found) {
            if (has_missing) {
                missing.push_str(", ");
            }
            missing.push_str("`");
            missing.push_str(decl_field->name.as_str_const());
            missing.push_str("`");
            has_missing = true;
        }
    }

    if (has_missing) {
        var type_name = format::format_struct_decl(
            context->allocator, 
            context->decl_tables, 
            struct_decl
        );

        diags::report_struct_missing_fields(
            context->dctx,
            context->allocator,
            struct_valueue->span,
            type_name.as_str_const(),
            missing.as_str_const()
        );

        type_name.free();
    }

}


fn check_duplicate_fields_for_unnamed_struct_value(
    context: AnalyzerContext*,
    struct_valueue: const cir::TypedUnnamedStructValue*
) {
    for (var i: usize = 0; i < struct_valueue->fields.len(); i += 1) {
        const field = struct_valueue->fields.get_const(i).unwrap();

        var is_duplicate = false;

        for (var j: usize = 0; j < i; j += 1) {
            const earlier = struct_valueue->fields.get_const(j).unwrap();

            if (earlier->name.as_str_const() == field->name.as_str_const()) {
                is_duplicate = true;
                break;
            }
        }

        if (is_duplicate) {
            diags::report_duplicate_field_initializer(
                context->dctx,
                context->allocator,
                field->span,
                field->name.as_str_const()
            );
        }
    }
}

fn check_struct_repr_attr(
    context: AnalyzerContext*, 
    repr_attr: const Option<ast::ASTReprAttr>*, 
    fields_count: usize,
    span: Span
) {
    switch (*repr_attr) {
        case .Some(attr) => {
            switch (cir::repr_attr_kind(&attr)) {
                case .Some(.Transparent) => {
                    if (fields_count != 1) {
                        // FIXME: Improve diag message 
                        diags::report_invalid_repr_attr(
                            context->dctx,
                            context->allocator,
                            span,
                            "repr(transparent)` struct must have exactly one field",
                            "remove the extra fields or drop the `repr(transparent)` attribute"
                        );
                    }

                    if (cir::is_attr_repr_packed(&attr)) {
                        // FIXME: Improve diag message 
                        diags::report_invalid_repr_attr(
                            context->dctx,
                            context->allocator,
                            span,
                            "`repr(transparent)` cannot be combined with `repr(packed)`",
                            "use either `repr(transparent)` or `repr(packed)`, not both"
                        );
                    }
                }
                case .Some(.Cyrus) => {}
                case .Some(.C) => {}
                case .None => {}
            }
        }
        case .None => {}
    }
}

fn check_struct_field_type(
    context: AnalyzerContext*,
    struct_decl_id: cir::StructDeclId,
    field_type: const cir::SemaType*,
    span: Span
) {
    const inner = field_type->const_inner();

    if (inner->is_void()) {
        diags::report_void_field_type(
            context->dctx, 
            context->allocator, 
            span
        );
    }

    const ty = cir::NamedType {
        type_decl_id: .Struct(struct_decl_id),
        type_args: cir::TypedTypeArgs.new(context->allocator),
    };

    if (cir::type_contains_self_by_value(inner, &ty)) {
        var type_name = format::format_sema_type(context->allocator, context->decl_tables, inner);

        diags::report_infinite_size_recursive_type(
            context->dctx,
            context->allocator, 
            span, 
            type_name.as_str_const()
        );

        type_name.free();
        return;
    }

    check_type_arity(context, *inner, span);
}

fn check_duplicate_struct_field(
    context: AnalyzerContext*, 
    object_name: const uint8*, 
    fields: const Vec<cir::TypedStructField>*
) {
    for (var i: usize = 0; i < fields->len(); i += 1) {
        const field = fields->get_const(i).unwrap();

        for (var j: usize = 0; j < i; j += 1) {
            const prev = fields->get_const(j).unwrap();

            if (prev->name.as_str_const() == field->name.as_str_const()) {
                diags::report_duplicate_field_name(
                    context->dctx,
                    context->allocator,
                    field->span,
                    object_name,
                    field->name.as_str_const()
                );
                break;
            }
        }
    }
}

fn check_field_access(
    context: AnalyzerContext*,
    operand_type: const cir::SemaType*,
    field_name: const uint8*,
    object_name: const uint8*,
    field_vis: ast::ASTVisibility,
    method_decls: const cir::MethodDecls*,
    is_thin_arrow: bool,
    span: Span
) {
    var access_violation = false;

    switch (context->func_env.current_method) {
        case .Some(method_decl_id) => {
            if (method_decls->contains_method_id(method_decl_id)) {
                access_violation = false;
            } else {
                access_violation = field_vis != .Public;
            }
        }
        case .None => access_violation = field_vis != .Public;
    }

    if (access_violation) {
        diags::report_internal_field_access(
            context->dctx,
            context->allocator,
            span,
            field_name,
            object_name
        );
    }

    const base_type = operand_type->const_inner();

    const is_pointer = base_type->is_pointer();
    const is_object = base_type->is_struct() || base_type->is_union();

    if (is_thin_arrow) {
        if (!is_pointer) {
            diags::report_invalid_thin_arrow(context->dctx, context->allocator, span);
        }
    } else {
        if (!is_object) {
            diags::report_use_thin_arrow(context->dctx, context->allocator, span);
        }
    }
}

/* ************* Interface Helpers ************* */

pub fn coerce_interface_as_interface_object_if_possible(
    context: AnalyzerContext*,
    ty: const cir::SemaType*,
    expr: const cir::TypedExpr*,
    span: Span
) cir::SemaType {
    switch (expr->ty) {
        case .Some(expr_type) => {
            switch (expr_type.as_interface_object()) {
                case .Some(interface_object) => {
                    return coerce_interface_object_recursively(context, ty, &interface_object, span);
                }
                case .None => return *ty;
            }
        }
        case .None => return *ty;
    }
}

fn coerce_interface_object_recursively(
    context: AnalyzerContext*,
    ty: const cir::SemaType*,
    interface_object: const cir::InterfaceObjectType*,
    span: Span
) cir::SemaType {
    switch (*ty) {
        case .Named(named_type) => {
            if (is_named_type_assignable_to(context, &named_type, &interface_object->interface_type, span)) {
                return .InterfaceObject(*interface_object);
            }
            return *ty;
        }

        case .Const(inner) => {
            const coerce = coerce_interface_object_recursively(context, inner, interface_object, span);
            return .Const(alloc_init(context->allocator, coerce));
        }

        case .Pointer(inner) => {
            const coerce = coerce_interface_object_recursively(context, inner, interface_object, span);
            return .Pointer(alloc_init(context->allocator, coerce));
        }

        case .Array(array_type) => {
            const element_type = coerce_interface_object_recursively(context,
                array_type.element_type, 
                interface_object, 
                span
            );

            return .Array(cir::TypedArrayType {
                element_type: alloc_init(context->allocator, element_type),
                capacity: array_type.capacity,
                span: array_type.span,
            });
        }

        case .Tuple(tuple_type) => {
            var elements: Vec<cir::TypedTupleElement> = Vec.with_capacity(context->allocator, tuple_type.elements.len());

            for (var i: usize = 0; i < tuple_type.elements.len(); i += 1) {
                const element = tuple_type.elements.get_const(i).unwrap();
                const coerce = coerce_interface_object_recursively(context, &element->ty, interface_object, span);
                
                elements.push(cir::TypedTupleElement {
                    ty: coerce,
                    span: element->span,
                });
            }

            return .Tuple(cir::TypedTupleType {
                elements,
                span: tuple_type.span,
            });
        }

        case .FuncType(func_type) => {
            var params = cir::TypedFuncTypeParams {
                list: Vec.with_capacity(context->allocator, func_type.params.list.len()),
                variadic: .None,
            };

            for (var i: usize = 0; i < func_type.params.list.len(); i += 1) {
                const param = func_type.params.list.get_const(i).unwrap();
                const coerce = coerce_interface_object_recursively(context, param, interface_object, span);
                params.list.push(coerce);
            }

            switch (func_type.params.variadic) {
                case .Some(variadic) => {
                    switch (*variadic) {
                        case .UntypedCStyle => {
                            params.variadic = .Some(alloc_init(
                                context->allocator,
                                cir::TypedFuncTypeVariadicParam.UntypedCStyle
                            ));
                        }
                        case .Typed(ty_inner) => {
                            const coerce = coerce_interface_object_recursively(context, &ty_inner, interface_object, span);
                            
                            params.variadic = .Some(alloc_init(
                                context->allocator,
                                cir::TypedFuncTypeVariadicParam.Typed(coerce)
                            ));
                        }
                    }
                }
                else => {}
            }

            const ret_type = coerce_interface_object_recursively(context, func_type.ret_type, interface_object, span);

            return .FuncType(cir::TypedFuncType {
                params,
                ret_type: alloc_init(context->allocator, ret_type),
                vis: func_type.vis,
                callconv: func_type.callconv,
                span: func_type.span,
            });
        }

        else => return *ty;
    }
}

/* ************* Vars Helpers ************* */

fn check_variable_type(
    context: AnalyzerContext*,
    ty: const cir::SemaType*,
    is_init: bool,
    span: Span
) bool {
    if (ty->const_inner()->is_void()) {
        diags::report_void_variable_type(context->dctx, context->allocator, span);
    }

    if (ty->const_inner()->is_interface() && !is_init) {
        diags::report_interface_type_must_be_initialized(context->dctx, context->allocator, span);
    }

    if (ty->const_inner()->is_func_type() && !is_init) {
        diags::report_lambda_type_must_be_initialized(context->dctx, context->allocator, span);
    }

    return check_type_arity(context, *ty, span);
}

fn check_non_static_global_var_modifiers(
    context: AnalyzerContext*,
    global_var: const cir::TypedGlobalVarStmt*
) {
    if (global_var->modifiers.weak
        || global_var->modifiers.link_once
        || global_var->modifiers.thread_local
        || global_var->modifiers.extern_.is_some()
        || global_var->modifiers.section.is_some()
    ) {
        diags::report_invalid_modifier_for_non_static_global_var(
            context->dctx, 
            context->allocator, 
            global_var->span
        );
    }

    if (!global_var->is_const) {
        diags::report_non_static_non_const_global_var(
            context->dctx, 
            context->allocator, 
            global_var->span
        );
    }
}

/* ************* Tuples Helpers ************* */

fn tuple_access_expr(
    allocator: Allocator,
    base_expr: const cir::TypedExpr*,
    access_path: const Vec<usize>*, 
    span: Span
) cir::TypedExpr {
    var expr: cir::TypedExpr = *base_expr;
    var current_type = expr.ty;
    var done = false;
    
    for (var i: usize = 0; i < access_path->len() && !done; i += 1) {
        const index = *access_path->get_const(i).unwrap();

        var element_type: cir::SemaType;

        switch (current_type) {
            case .Some(ty) => {
                switch (ty.as_tuple_type()) {
                    case .Some(tuple_type) => {
                        if (index < tuple_type.elements.len()) {
                            const element = tuple_type.elements.get_const(index).unwrap();
                            element_type = element->ty;
                        } else {
                            done = true;
                        }
                    }
                    case .None => done = true;
                }
            }
            case .None => done = true;
        }

        if (done) {
            break;
        }

        expr = cir::TypedExpr {
            kind: .TupleAccess(cir::TypedTupleAccessExpr {
                operand: alloc_init(allocator, expr),
                index,
                span: span,
            }),
            ty: .Some(element_type),
            analyzed: false,
            value_category: expr.value_category,
            span: span,
        };

        current_type = .Some(element_type);
    }

    return expr;
}

fn tuple_type_from_pattern(
    context: AnalyzerContext*, 
    pattern: const cir::TypedTupleExportPattern*
) Option<cir::SemaType> {
    switch (pattern->kind) {
        case .Tuple(elements) => {
            var result_type: Vec<cir::TypedTupleElement> = Vec.new(context->allocator);
            defer result_type.free();

            var has_explicit_type = false;

            for (var i: usize = 0; i < elements.len(); i += 1) {
                const element = elements.get_const(i).unwrap();

                switch (element->ty) {
                    case .Some(ty) => {
                        result_type.push(cir::TypedTupleElement {
                            ty,
                            span: element->span
                        });
                        has_explicit_type = true;
                    }
                    case .None => {
                        switch (element->kind) {
                            case .Tuple => {
                                switch (tuple_type_from_pattern(context, element)) {
                                    case .Some(inner) => {
                                        result_type.push(cir::TypedTupleElement { ty: inner, span: element->span });
                                        has_explicit_type = true;
                                    }
                                    case .None => {
                                        switch (context->func_env.infer) {
                                            case .Some(infer_ctx) => {
                                                result_type.push(cir::TypedTupleElement {
                                                    ty: infer_ctx->new_var(),
                                                    span: element->span,
                                                });
                                            }
                                            case .None => {
                                                return .None;
                                            }
                                        }
                                    }
                                }
                            }
                            else => {
                                switch (context->func_env.infer) {
                                    case .Some(infer_ctx) => {
                                        result_type.push(cir::TypedTupleElement {
                                            ty: infer_ctx->new_var(),
                                            span: element->span,
                                        });
                                    }
                                    case .None => {
                                        return .None;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if (!has_explicit_type) {
                return .None;
            }

            return .Some(.Tuple(cir::TypedTupleType {
                elements: result_type,
                span: pattern->span,
            }));
        }
        else => { return .None; }
    }
}

/* ************* Inference Helpers ************* */

fn infer_pointer_arithmetic_type(
    lhs_type: const cir::SemaType*,
    rhs_type: const cir::SemaType*,
    is_addition: bool
) Option<cir::SemaType> {
    if (lhs_type->is_pointer() && rhs_type->is_integer()) {
        return .Some(*lhs_type);
    } else if (lhs_type->is_integer() && rhs_type->is_pointer()) {
        return .Some(*rhs_type);
    } else if (lhs_type->is_pointer() && rhs_type->is_pointer() && !is_addition) {
        return .Some(.Plain(.ISize));
    } else {
        return .None;
    }
}

fn infer_null_coalesce_type(
    lhs_type: cir::SemaType,
    rhs_type: cir::SemaType
) Option<cir::SemaType> {
    if (lhs_type.is_plain_null()) {
        switch (rhs_type) {
            case .Pointer(inner) => return .Some(.Pointer(inner));
            case .Plain(.Null) => return .Some(lhs_type);
            else => {}
        }
    } else if (lhs_type.is_pointer()) {
        switch (rhs_type) {
            case .Pointer(inner_rhs) => {
                switch (lhs_type) {
                    case .Pointer(inner_lhs) => {
                        if (cir::cir_types_eq(inner_lhs, inner_rhs)) {
                            return .Some(lhs_type);
                        }
                    }
                    else => {}
                }
            }
            case .Plain(.Null) => {
                return .Some(lhs_type);
            }
            else => {}
        }
    }

    return .None;
}

fn unify_with_expected_type(
    context: AnalyzerContext*,
    operand_type: cir::SemaType,
    expected_type: Option<cir::SemaType>
) {
    switch (expected_type) {
        case .Some(expect) => {
            switch (context->func_env.infer) {
                case .Some(infer_ctx) => {
                    infer_ctx->unify(&expect, &operand_type);
                }
                case .None => {}
            }
        }
        case .None => {}
    }
}

/* ************* Environment Helpers ************* */

fn create_inference_generic_env(
    context: AnalyzerContext*,
    type_name: const uint8*,
    params: cir::TypedGenericParams,
    type_args: const cir::TypedTypeArgs*,
    span: Span
) Option<env::GenericEnv> {
    if (!type_args->is_empty() && params.len() != type_args->len()) {
        diags::report_wrong_number_of_type_args(
            context->dctx,
            context->allocator,
            span,
            type_name,
            params.len(),
            type_args->len()
        );
        return .None;
    }

    var generic_env = env::GenericEnv.new(context->allocator, params);

    for (var i: usize = 0; i < params.len(); i += 1) {
        const param_id = *params.ids.get_const(i).unwrap();

        switch (context->func_env.infer) {
            case .Some(infer_ctx) => {
                var bound_type: Option<cir::SemaType> = .None;

                switch (type_args->get(i)) {
                    case .Some(type_arg) => {
                        switch (*type_arg) {
                            case .Type(sema_type, _) => bound_type = .Some(sema_type);
                            case .Infer => bound_type = .Some(infer_ctx->new_var());
                        }
                    }
                    case .None => {}
                }

                switch (bound_type) {
                    case .Some(ty) => {
                        generic_env.bind(param_id, ty);
                    }
                    case .None => {
                        generic_env.bind(param_id, infer_ctx->new_var());
                    }
                }
            }
            case .None => {}
        }
    }

    return .Some(generic_env);
}

fn create_func_def_env(
    context: AnalyzerContext*,
    name: const uint8*,
    func_type: cir::TypedFuncType,
    parent_infer: Option<infer::InferContext*>
) env::FuncEnv {
    var env = env::FuncEnv.new(context->allocator);
    env.current_func_name = .Some(String.from_str(context->allocator, name));
    env.current_func = .Some(func_type);
    env.infer = parent_infer;
    
    if (env.infer.is_none()) {
        env.infer = .Some(alloc_init(
            context->allocator,
            infer::InferContext.new(context->allocator)
        ));
    }

    return env;
}

fn create_method_env(
    context: AnalyzerContext*,
    method_decl_id: cir::MethodDeclId,
    func_type: cir::TypedFuncType,
    parent_infer: Option<infer::InferContext*>
) env::FuncEnv {
    var env = env::FuncEnv.new(context->allocator);
    env.current_func = .Some(func_type);
    env.current_method = .Some(method_decl_id);
    env.infer = parent_infer;
    
    if (env.infer.is_none()) {
        env.infer = .Some(alloc_init(
            context->allocator,
            infer::InferContext.new(context->allocator)
        ));
    }

    return env;
}

/* ************* DeclTables Helpers ************* */

fn symbol_expr_as_decl_id(
    registry: const GlobalSymbolRegistry*,
    symbol_expr: const cir::TypedSymbolExpr*
) Option<cir::DeclId> {
    switch (symbol_expr->as_symbol_id()) {
        case .Some(symbol_id) => {
            switch (registry->lookup_symbol_as_decl_id(symbol_id)) {
                case .Some(decl_id) => return .Some(decl_id);
                else => {}
            }
        }
        else => {}
    }

    return symbol_expr->as_decl_id();
}

fn enum_decl_id_of_expr_kind(
    context: AnalyzerContext*,
    expr_kind: const cir::TypedExprKind*,
    span: Span
) Option<cir::EnumTypeDecl> {
    switch (*expr_kind) {
        case .Symbol(symbol_expr) => {
            switch (symbol_expr_as_decl_id(context->registry, &symbol_expr)) case .Some(decl_id) else {
                return .None;
            }

            switch (decl_id.as_enum()) case .Some(enum_decl_id) else {
                switch (cir::decl_id_as_type_decl_id(decl_id)) case .Some(type_decl_id) else {
                    return .None;
                }

                const type_args = cir::TypedTypeArgs.new(context->allocator);

                const named: cir::SemaType = .Named(cir::NamedType {
                    type_decl_id,
                    type_args,
                });

                switch (normalize_sema_type(context, named, span, 0)) case .Some(ty) else {
                    return .None;
                }

                const expand = expand_sema_type(context, ty, span);

                switch (expand.as_enum()) case .Some(aliased_enum_id) else {
                    return .None;
                }

                return .Some(cir::EnumTypeDecl {
                    enum_decl_id: aliased_enum_id,
                    type_args: cir::TypedTypeArgs.new(context->allocator),
                });
            }

            return .Some(cir::EnumTypeDecl {
                enum_decl_id,
                type_args: cir::TypedTypeArgs.new(context->allocator),
            });
        }

        case .SemaType { ty, .. } => {
            switch (normalize_sema_type(context, ty, span, 0)) case .Some(normalized_type) else {
                return .None;
            }

            const expand = expand_sema_type(context, normalized_type, span);

            switch (expand.as_named_type()) case .Some(named_type) else {
                return .None;
            }

            switch (named_type.type_decl_id.as_enum()) case .Some(enum_decl_id) else {
                return .None;
            }

            return .Some(cir::EnumTypeDecl {
                enum_decl_id,
                type_args: named_type.type_args,
            });
        }

        else => return .None;
    }
}

fn method_decls_of_named_type(
    decl_tables: tables::DeclTables*,
    named_type: const cir::NamedType*
) Option<const cir::MethodDecls*> {
    switch (named_type->type_decl_id) {
        case .Struct(struct_decl_id) => {
            const struct_decl = decl_tables->structs.get_const(struct_decl_id).unwrap();
            return .Some(&struct_decl->methods);
        }
        case .Enum(enum_decl_id) => {
            const enum_decl = decl_tables->enums.get_const(enum_decl_id).unwrap();
            return .Some(&enum_decl->methods);
        }
        case .Union(union_decl_id) => {
            const union_decl = decl_tables->unions.get_const(union_decl_id).unwrap();
            return .Some(&union_decl->methods);
        }
        case .Interface | .Typedef => return .None;
    }
}

fn implement_interfaces_of_named_type(
    decl_tables: tables::DeclTables*,
    named_type: const cir::NamedType*
) Option<const Vec<cir::TypedImplementInterface>*> {
    switch (named_type->type_decl_id) {
        case .Struct(struct_decl_id) => {
            const struct_decl = decl_tables->structs.get_const(struct_decl_id).unwrap();
            return .Some(&struct_decl->impls);
        }
        case .Enum(enum_decl_id) => {
            const enum_decl = decl_tables->enums.get_const(enum_decl_id).unwrap();
            return .Some(&enum_decl->impls);
        }
        case .Union(union_decl_id) => {
            const union_decl = decl_tables->unions.get_const(union_decl_id).unwrap();
            return .Some(&union_decl->impls);
        }
        case .Interface | .Typedef => return .None;
    }
}

fn write_struct_back(
    context: AnalyzerContext*, 
    struct_decl_id: cir::StructDeclId, 
    struct_decl: cir::StructDecl
) {
    var decl = context->decl_tables->structs.get(struct_decl_id).unwrap();
    *decl = struct_decl;
}

fn write_union_back(
    context: AnalyzerContext*, 
    union_decl_id: cir::UnionDeclId, 
    union_decl: cir::UnionDecl
) {
    var decl = context->decl_tables->unions.get(union_decl_id).unwrap();
    *decl = union_decl;
}

fn write_enum_back(
    context: AnalyzerContext*, 
    enum_decl_id: cir::EnumDeclId, 
    enum_decl: cir::EnumDecl
) {
    var decl = context->decl_tables->enums.get(enum_decl_id).unwrap();
    *decl = enum_decl;
}

fn write_method_back(
    context: AnalyzerContext*, 
    method_decl_id: cir::MethodDeclId, 
    method_decl: cir::MethodDecl
) {
    var decl = context->decl_tables->methods.get(method_decl_id).unwrap();
    *decl = method_decl;
}

fn write_back_global_var(
    context: AnalyzerContext*,
    global_var: const cir::TypedGlobalVarStmt*
) {
    var decl = context
        ->decl_tables
        ->global_vars
        .get(global_var->global_var_decl_id).unwrap();

    decl->rhs = global_var->rhs;
    decl->ty = global_var->ty;
}

fn write_back_var(
    context: AnalyzerContext*, 
    var_: const cir::TypedVarStmt*
) {
    var decl = context->decl_tables->vars.get(var_->var_decl_id).unwrap();
    decl->rhs = var_->rhs;
    decl->ty = var_->ty;
}

/* ************* Literals Helpers ************* */

[[inline]]
fn integer_suffix_to_sema_type(suffix: IntegerSuffix) Option<cir::SemaType> {
    switch (suffix) {
        case .ISize => return .Some(.Plain(.ISize));
        case .USize => return .Some(.Plain(.USize));
        case .Int8 => return .Some(.Plain(.Int8));
        case .Int16 => return .Some(.Plain(.Int16));
        case .Int32 => return .Some(.Plain(.Int32));
        case .Int64 => return .Some(.Plain(.Int64));
        case .Int128 => return .Some(.Plain(.Int128));
        case .UInt8 => return .Some(.Plain(.UInt8));
        case .UInt16 => return .Some(.Plain(.UInt16));
        case .UInt32 => return .Some(.Plain(.UInt32));
        case .UInt64 => return .Some(.Plain(.UInt64));
        case .UInt128 => return .Some(.Plain(.UInt128));
    }
}

[[inline]]
fn float_suffix_to_sema_type(suffix: FloatSuffix) Option<cir::SemaType> {
    switch (suffix) {
        case .Float16 => return .Some(.Plain(.Float16));
        case .Float32 => return .Some(.Plain(.Float32));
        case .Float64 => return .Some(.Plain(.Float64));
        case .Float128 => return .Some(.Plain(.Float128));
    }
}

/* ************* ValueCategory Helpers ************* */

fn value_category_of_expr(
    context: const AnalyzerContext*, 
    expr: const cir::TypedExpr*
) cir::ValueCategory {
    switch (expr->kind) {
        case .Symbol(symbol_expr) => {
            switch (symbol_expr.as_decl_id()) {
                case .Some(decl_id) => {
                    const is_const = is_decl_const(context->decl_tables, decl_id);
                    
                    var constness: ast::ASTConstness = .Var;

                    if (is_const) {
                        constness = .Const;
                    }

                    if (decl_id.is_var_or_global_var()) {
                        return .LValue(constness);
                    } else {
                        return .Type;
                    }
                }
                case .None => return .Unknown;
            }
        }
        
        case .Deref(deref) => {
            var constness: ast::ASTConstness = .Var;
            
            switch (deref.operand->ty) {
                case .Some(ty) => {
                    if (ty.is_const()) {
                        constness = .Const;
                    }
                }
                else => {}
            }
            
            return .LValue(constness);
        }
        
        case .FieldAccess(field_access) => {
            if (field_access.is_thin_arrow) {
                switch (field_access.operand->ty) {
                    case .Some(ty) => {
                        if (ty.pointer_inner()->is_const()) {
                            return .LValue(.Const);
                        } else {
                            return .LValue(.Var);
                        }
                    }
                    else => {}
                }
            }

            return field_access.operand->value_category;
        }
        
        case .TupleAccess(tuple_access) => return tuple_access.operand->value_category;
        
        case .ArrayIndex(array_index) => return array_index.operand->value_category;

        case .Builtin => return .RValue;

        case .AddrOf => return .RValue;

        case .Assign
        | .Lambda
        | .Array
        | .Tuple
        | .Dynamic
        | .EnumInit
        | .StructInit
        | .UnionInit
        | .FuncCall
        | .MethodCall
        | .Literal
        | .Prefix
        | .Infix => return .RValue;
        
        case .SemaType 
        | .Poisoned
        | .InlineAsm
        | .EnumStructVariantInit
        | .UnnamedStructValue
        | .UnnamedUnionValue
        | .UnnamedEnumValue => return .Unknown;
    }
}

/* ************* Alignment Helpers ************* */

fn check_align(context: AnalyzerContext*, align: const Option<usize>*, span: Span) {
    switch (*align) {
        case .Some(value) => {
            if (value == 0 || (value & (value - 1)) != 0) {
                diags::report_invalid_align(context->dctx, context->allocator, span, value);
            }
        }
        case .None => return;
    }
}

/* ************* Lowering Helpers ************* */

fn lower_expr_pre_analysis(
    context: AnalyzerContext*, 
    typed_expr: cir::TypedExpr*,
    expected_type: Option<cir::SemaType>
) {
    switch (typed_expr->kind) {
        case .Assign(assign) => {
            if (assign.kind != .Default) {
                typed_expr->kind = lower::lower_assign_to_infix_expr(
                    context->allocator, 
                    &assign
                );
            }
        }

        case .Prefix(var prefix) => {
            switch (prefix.op) {
                case .Bang => {
                    switch (analyze_expr(context, prefix.operand, expected_type)) {
                        case .Some(operand_type) => {
                            switch (lower::lower_prefix_not_pointer(
                                context->allocator,
                                operand_type,
                                &prefix
                            )) {
                                case .Some(expr) => {
                                    *typed_expr = expr;
                                }
                                case .None => {}
                            }
                        }
                        case .None => {}
                    }
                }
                else => {}
            }
        }

        case .UnnamedStructValue(struct_value) => {
            for (var i: usize = 0; i < struct_value.fields.len(); i += 1) {
                const field = struct_value.fields.get(i).unwrap();
                analyze_expr_non_terminal(context, field->value, .None);
            }

            switch (lower::lower_unnamed_struct_value_as_unnamed_struct_type(
                context->dctx,
                context->allocator,
                context->decl_tables,
                struct_value
            )) {
                case .Some(expr) => {
                    *typed_expr = expr;
                }
                case .None => {}
            }
        }

        case .UnnamedUnionValue(union_value) => {
            for (var i: usize = 0; i < union_value.fields.len(); i += 1) {
                const field = union_value.fields.get(i).unwrap();
                analyze_expr_non_terminal(context, field->value, .None);
            }

            switch (lower::lower_unnamed_union_value_as_unnamed_union_type(
                context->dctx,
                context->allocator,
                context->decl_tables,
                union_value
            )) {
                case .Some(expr) => {
                    *typed_expr = expr;
                }
                case .None => {}
            }
        }

        else => {
            switch (typed_expr->kind) {
                case .FieldAccess(field_access) => {
                    if (!field_access.is_thin_arrow) {
                        switch (enum_decl_id_of_expr_kind(context,
                            &field_access.operand->kind,
                            typed_expr->span
                        )) {
                            case .Some(info) => {
                                lower::lower_field_access_as_enum_init(
                                    context->dctx,
                                    context->allocator,
                                    context->decl_tables,
                                    typed_expr,
                                    info
                                );
                            }
                            case .None => {}
                        }
                    }
                }

                case .MethodCall(method_call) => {
                    if (!method_call.is_thin_arrow) {
                        switch (enum_decl_id_of_expr_kind(context,
                            &method_call.operand->kind,
                            method_call.span
                        )) {
                            case .Some(info) => {
                                lower::lower_method_call_as_enum_init(
                                    context->dctx,
                                    context->allocator,
                                    context->decl_tables,
                                    typed_expr,
                                    info
                                );
                            }
                            case .None => {}
                        }
                    }
                }

                case .StructInit(struct_init) => {
                    switch (normalize_sema_type(context, struct_init.operand, struct_init.span, 0)) {
                        case .Some(normalized_type) => {
                            const expand = expand_sema_type(context, normalized_type, struct_init.span);

                            switch (expand.as_union()) {
                                case .Some => {
                                    lower::lower_struct_init_as_union_init(
                                        context->dctx,
                                        context->allocator,
                                        typed_expr,
                                        expand
                                    );
                                }
                                case .None => {}
                            }
                        }
                        case .None => {}
                    }
                }
                
                else => {}
            }
        }
    }
}

fn lower_expr_post_analysis(context: AnalyzerContext*, typed_expr: cir::TypedExpr*) {
    lower::lower_unnamed_union_value_as_union_init(context->allocator, context->dctx, typed_expr);
    lower::lower_unnamed_struct_value_as_struct_init(context->allocator, typed_expr);
    lower::lower_enum_struct_variant_init_as_enum_init(typed_expr);
    lower::lower_unnamed_enum_value_as_enum_init(typed_expr);
}

/* ************* Specialization Helpers ************* */

fn remap_var_decl_id(
    context: AnalyzerContext*,
    decl_map: HashMap<usize, cir::VarDeclId>*,
    var_decl_id: cir::VarDeclId
) Option<cir::VarDeclId> {
    switch (decl_map->get(var_decl_id)) {
        case .Some(new_var_decl_id) => {
            return .Some(*new_var_decl_id);
        }
        else => {
            return .None;
        }
    }
}

// -------------------------- FIXME ----------------------------- 

// FIXME: Replace this with a new helper function called
// `check_finalized_type_arity`
fn validate_param_type(context: AnalyzerContext*, ty: const cir::SemaType*, span: Span) {
    const inner = ty->const_inner();

    if (inner->is_void()) {
        diags::report_void_parameter_type(context->dctx, context->allocator, span);
    }

    check_type_arity(context, *inner, span);
}

// FIXME: Remove this helper method
fn str_set_contains(values: const Vec<String>*, name: const uint8*) bool {
    for (var i: usize = 0; i < values->len(); i += 1) {
        const value = values->get_const(i).unwrap();

        if (value->as_str_const() == name) {
            return true;
        }
    }

    return false;
}

// FIXME: Remove this helper method
fn str_set_insert(values: Vec<String>*, name: String) bool {
    if (str_set_contains(values, name.as_str_const())) {
        return false;
    }

    values->push(name);
    return true;
}