/* ************* Analyzer ************* */

const ANALYZER_ARENA_SIZE: usize = 65536;

pub struct Analyzer {
    pub allocator: Allocator,
    pub arena: ArenaAllocator,
    pub dctx: DiagContext*,
    pub registry: GlobalSymbolRegistry*,
    pub decl_tables: DeclTables*,
    pub trees: Vec<cir::TypedProgramTree>,
    pub func_env: FuncEnv,
    pub type_cache: TypeCache,
    pub typedef_stack: Vec<usize>,
    pub generic_env_stack: Vec<GenericEnv*>,
    pub reported_typedef_cycles: Vec<String>,
    pub control_region_stack: Vec<ControlRegion>,
    pub instantiations: Vec<InstantiationSite>,
    pub monomorph_registry: MonomorphRegistry,
    pub vtable_registry: VTableRegistry,

    pub fn new(
        allocator: Allocator,
        dctx: DiagContext*,
        registry: GlobalSymbolRegistry*,
        decl_tables: DeclTables*,
        trees: Vec<cir::TypedProgramTree>
    ) Self {
        const arena = ArenaAllocator.new(allocator, ANALYZER_ARENA_SIZE);

        return Self {
            allocator,
            arena,
            dctx,
            registry,
            decl_tables,
            trees,
            func_env: FuncEnv.new(allocator),
            typedef_stack: Vec.new(allocator),
            instantiations: Vec.new(allocator),
            type_cache: TypeCache.new(allocator),
            generic_env_stack: Vec.new(allocator),
            control_region_stack: Vec.new(allocator),
            reported_typedef_cycles: Vec.new(allocator),
            vtable_registry: VTableRegistry.new(allocator),
            monomorph_registry: MonomorphRegistry.new(allocator),
        };
    }

    pub fn free(self: Self*) {
        for (var i: usize = 0; i < self->generic_env_stack.len(); i += 1) {
            const env = *self->generic_env_stack.get(i).unwrap();
            env->free();
        }

        self->generic_env_stack.free();

        for (var i: usize = 0; i < self->instantiations.len(); i += 1) {
            const record = self->instantiations.get(i).unwrap();
            record->key.free();
        }

        self->instantiations.free();

        for (var i: usize = 0; i < self->reported_typedef_cycles.len(); i += 1) {
            var key = self->reported_typedef_cycles.get(i).unwrap();
            key->free();
        }

        self->reported_typedef_cycles.free();
        self->typedef_stack.free();
        self->control_region_stack.free();
        self->type_cache.free();
        self->monomorph_registry.free();
        self->vtable_registry.free();
        self->func_env.free();
        self->arena.destroy();
    }

    /* ************* Generics ************* */

    pub fn current_generic_env(self: Self*) Option<GenericEnv*> {
        switch (self->generic_env_stack.last()) {
            case .Some(env_ptr) => return .Some(*env_ptr);
            case .None => return .None;
        }
    }

    pub fn push_generic_env(self: Self*, env: GenericEnv) {
        const heap_env = alloc_init(dynamic self->arena, env);
        self->generic_env_stack.push(heap_env);
    }

    pub fn pop_generic_env(self: Self*) {
        const heap_env = self->generic_env_stack.pop();
        heap_env->free();
    }

    pub fn lookup_generic_binding(
        self: Self*, 
        generic_param_id: cir::GenericParamId
    ) Option<cir::SemaType> {
        for (var i: usize = self->generic_env_stack.len(); i > 0; i -= 1) {
            const env = *self->generic_env_stack.get(i - 1).unwrap();
            const bound = env->lookup(generic_param_id);
            
            switch (bound) {
                case .Some(ty) => return .Some(ty);
                else => {}
            }
        }

        return .None;
    }

    pub fn substitute_type(self: Self*, ty: const cir::SemaType*) cir::SemaType {
        var result: cir::SemaType = *ty;

        for (var i: usize = self->generic_env_stack.len(); i > 0; i -= 1) {
            const env = *self->generic_env_stack.get(i - 1).unwrap();

            switch (self->func_env.current_object) {
                case .Some(object_type) => {
                    result = self->substitute_self_type(&result, &object_type);
                }
                else => {}
            }

            result = env->substitute_sema_type(&result);
        }

        switch (self->func_env.infer) {
            case .Some(infer_ctx) => {
                result = infer_ctx->resolve(&result);
            }
            else => {}
        }

        return result;
    }

    pub fn substitute_func_params(self: Self*, params: cir::TypedFuncParams*) {
        for (var i: usize = 0; i < params->list.len(); i += 1) {
            var kind = params->list.get(i).unwrap();

            switch (*kind) {
                case .FuncParam(var param) => {
                    param.ty = self->substitute_type(&param.ty);
                    *kind = .FuncParam(param);
                }
                case .SelfModifier(var self_modifier) => {
                    self_modifier.ty = self->substitute_type(&self_modifier.ty);
                    *kind = .SelfModifier(self_modifier);
                }
            }
        }

        switch (params->variadic) {
            case .Some(.Typed { var_decl_id, ty, span }) => {
                const subst = self->substitute_type(&ty);

                params->variadic = .Some(cir::TypedFuncVariadicParam.Typed {
                    var_decl_id,
                    ty: subst,
                    span,
                });
            }
            else => {}
        }
    }

    pub fn substitute_self_type(
        self: const Self*,
        ty: const cir::SemaType*,
        self_type: const cir::SemaType*
    ) cir::SemaType {
        switch (*ty) {
            case .SelfType => return *self_type;

            case .Named(named_type) => {
                var type_args = cir::TypedTypeArgs.new(self->allocator);
                
                for (var i: usize = 0; i < named_type.type_args.len(); i += 1) {
                    const arg = named_type.type_args.get(i).unwrap();

                    switch (*arg) {
                        case .Type(inner, span) => {
                            const subst = self->substitute_self_type(&inner, self_type);
                            type_args.push(.Type(subst, span));
                        }
                        case .Infer => type_args.push(.Infer);
                    }
                }

                return .Named(cir::NamedType {
                    type_decl_id: named_type.type_decl_id,
                    type_args,
                });
            }

            case .Array(array_type) => {
                const element_type = self->substitute_self_type(array_type.element_type, self_type);
                
                return .Array(cir::TypedArrayType {
                    element_type: alloc_init(self->allocator, element_type),
                    capacity: array_type.capacity,
                    span: array_type.span,
                });
            }

            case .Const(inner) => {
                const subst = self->substitute_self_type(inner, self_type);
                return .Const(alloc_init(self->allocator, subst));
            }

            case .Pointer(inner) => {
                const subst = self->substitute_self_type(inner, self_type);
                return .Pointer(alloc_init(self->allocator, subst));
            }

            case .Tuple(tuple_type) => {
                var elements: Vec<cir::TypedTupleElement> = Vec.with_capacity(self->allocator, tuple_type.elements.len());
                
                for (var i: usize = 0; i < tuple_type.elements.len(); i += 1) {
                    const element = tuple_type.elements.get_const(i).unwrap();
                    const subst = self->substitute_self_type(&element->ty, self_type);
                    
                    elements.push(cir::TypedTupleElement {
                        ty: subst,
                        span: element->span,
                    });
                }

                return .Tuple(cir::TypedTupleType {
                    elements,
                    span: tuple_type.span,
                });
            }

            case .FuncType(func_type) => {
                var params = cir::TypedFuncTypeParams {
                    list: Vec.with_capacity(self->allocator, func_type.params.list.len()),
                    variadic: .None,
                };

                for (var i: usize = 0; i < func_type.params.list.len(); i += 1) {
                    const param = func_type.params.list.get_const(i).unwrap();
                    const subst = self->substitute_self_type(param, self_type);
                    params.list.push(subst);
                }

                switch (func_type.params.variadic) {
                    case .Some(variadic) => {
                        switch (*variadic) {
                            case .UntypedCStyle => {
                                params.variadic = .Some(alloc_init(
                                    self->allocator,
                                    cir::TypedFuncTypeVariadicParam.UntypedCStyle
                                ));
                            }
                            case .Typed(inner) => {
                                const subst = self->substitute_self_type(&inner, self_type);
                                
                                params.variadic = .Some(alloc_init(
                                    self->allocator,
                                    cir::TypedFuncTypeVariadicParam.Typed(subst)
                                ));
                            }
                        }
                    }
                    else => {}
                }

                const ret_type = self->substitute_self_type(func_type.ret_type, self_type);

                return .FuncType(cir::TypedFuncType {
                    params,
                    ret_type: alloc_init(self->allocator, ret_type),
                    vis: func_type.vis,
                    callconv: func_type.callconv,
                    span: func_type.span,
                });
            }

            case .InterfaceObject(interface_object) => {
                const concrete_type = self->substitute_self_type(interface_object.concrete_type, self_type);
                
                return .InterfaceObject(cir::InterfaceObjectType {
                    interface_type: interface_object.interface_type,
                    concrete_type: alloc_init(self->allocator, concrete_type),
                    vtable_id: interface_object.vtable_id,
                    span: interface_object.span,
                });
            }

            else => return *ty;
        }
    }

    /* ************* Typedef Expansion ************* */

    pub fn push_typedef_expansion(self: Self*, id: cir::TypedefDeclId) Option<Vec<usize>> {
        for (var i: usize = 0; i < self->typedef_stack.len(); i += 1) {
            const existing = *self->typedef_stack.get_const(i).unwrap();
            
            if (existing == id) {
                var path: Vec<usize> =
                    Vec.with_capacity(self->allocator, self->typedef_stack.len() - i + 1);
                
                for (var j: usize = i; j < self->typedef_stack.len(); j += 1) {
                    path.push(*self->typedef_stack.get_const(j).unwrap());
                }
                
                path.push(id);
                return .Some(path);
            }
        }

        self->typedef_stack.push(id);
        return .None;
    }

    [[inline]]
    pub fn pop_typedef_expansion(self: Self*) {
        self->typedef_stack.pop();
    }

    pub fn typedef_cycle_key(self: Self*, path: const Vec<usize>) String {
        if (path.len() == 0) {
            return String.new(self->allocator);
        }

        const n = path.len() - 1;

        if (n == 0) {
            var key = String.new(self->allocator);
            diags::append_usize(&key, *path.get_const(0).unwrap());
            return key;
        }

        var min_index: usize = 0;
        var min_value: usize = *path.get_const(0).unwrap();
        
        for (var i: usize = 1; i < n; i += 1) {
            const v = *path.get_const(i).unwrap();
            
            if (v < min_value) {
                min_value = v;
                min_index = i;
            }
        }

        var key = String.new(self->allocator);
        
        for (var i: usize = 0; i < n; i += 1) {
            const index = (min_index + i) % n;
            
            if (i > 0) {
                key.push(',');
            }
            
            diags::append_usize(&key, *path.get_const(index).unwrap());
        }

        return key;
    }

    pub fn cycle_already_reported(self: Self*, key: const uint8*) bool {
        for (var i: usize = 0; i < self->reported_typedef_cycles.len(); i += 1) {
            const existing = self->reported_typedef_cycles.get_const(i).unwrap();
            
            if (existing->as_str_const() == key) {
                return true;
            }
        }

        return false;
    }

    /// Fully normalize and validate a type which is mostly
    /// used when an explicit type is written.
    pub fn normalize_and_check_type_formation(
        self: Self*,
        ty: cir::SemaType,
        loc: Span,
        indirection: uint8
    ) Option<cir::SemaType> {
        switch (self->normalize_sema_type(ty, loc, indirection)) {
            case .Some(normalized) => return self->check_type_formation(normalized, loc);
            case .None => return .None;
        }
    }

    // Fully normalize a type by resolving unresolved symbols, expanding typedefs
    // and recursively normalizing children. Never returns unresolved.
    pub fn normalize_sema_type(
        self: Self*,
        ty: cir::SemaType,
        loc: Span,
        indirection: uint8
    ) Option<cir::SemaType> {
        switch (ty) {
            case .Unresolved(unresolved) => return self->normalize_unresolved_type(unresolved, loc, indirection);
            case .GenericParam(generic_param_id) => return self->normalize_generic_param(generic_param_id);
            case .Named(named_type) => return self->normalize_named_type(&named_type, indirection);
            case .Array(array_type) => return self->normalize_array(array_type, loc, indirection);
            case .FuncType(func_type) => return self->normalize_func_type(func_type, indirection);
            case .Tuple(tuple_type) => return self->normalize_tuple(tuple_type, indirection);
            case .Pointer(inner) => return self->normalize_pointer(inner, loc, indirection);
            case .Const(inner) => return self->normalize_const(inner, loc, indirection);
            case .SelfType(self_type) => return self->normalize_self_type(self_type);
            case .InterfaceObject => return .Some(ty);
            case .Placeholder => return .Some(ty);
            case .InferVar => return .Some(ty);
            case .Plain => return .Some(ty);
            case .Err => return .Some(ty);
        }
    }

    fn normalize_named_type(
        self: Self*,
        named_type: const cir::NamedType*,
        indirection: uint8
    ) Option<cir::SemaType> {
        var type_args = cir::TypedTypeArgs.new(self->allocator);
       
        for (var i: usize = 0; i < named_type->type_args.len(); i += 1) {
            const arg = named_type->type_args.get(i).unwrap();
            type_args.push(*arg);
        }

        self->normalize_type_args(&type_args, indirection);

        switch (named_type->type_decl_id) {
            case .Struct(id) => return self->normalize_struct_decl(id, type_args, indirection);
            case .Union(id) => return self->normalize_union_decl(id, type_args, indirection);
            case .Enum(id) => return self->normalize_enum_decl(id, type_args, indirection);
            else => return .Some(.Named(cir::NamedType {
                type_decl_id: named_type->type_decl_id,
                type_args,
            }));
        }
    }

    fn normalize_struct_decl(
        self: Self*,
        struct_decl_id: cir::StructDeclId,
        type_args: cir::TypedTypeArgs,
        indirection: uint8
    ) Option<cir::SemaType> {
        const struct_type: cir::SemaType = .Named(cir::NamedType {
            type_decl_id: .Struct(struct_decl_id),
            type_args,
        });

        const decl = self->decl_tables->structs.get(struct_decl_id).unwrap();

        if (decl->is_normalized) {
            return .Some(struct_type);
        }

        decl->is_normalized = true;

        for (var i: usize = 0; i < decl->fields.len(); i += 1) {
            const field = decl->fields.get(i).unwrap();
            const span = field->span;

            switch (self->normalize_sema_type(field->ty, span, indirection + 1)) {
                case .Some(ty) => field->ty = ty;
                case .None => field->ty = .Err(span);
            }
        }

        return .Some(struct_type);
    }

    fn normalize_union_decl(
        self: Self*,
        union_decl_id: cir::UnionDeclId,
        type_args: cir::TypedTypeArgs,
        indirection: uint8
    ) Option<cir::SemaType> {
        const union_type: cir::SemaType = .Named(cir::NamedType {
            type_decl_id: .Union(union_decl_id),
            type_args,
        });

        const decl = self->decl_tables->unions.get(union_decl_id).unwrap();

        if (decl->is_normalized) {
            return .Some(union_type);
        }

        decl->is_normalized = true;

        for (var i: usize = 0; i < decl->fields.len(); i += 1) {
            const field = decl->fields.get(i).unwrap();
            const span = field->span;

            switch (self->normalize_sema_type(field->ty, span, indirection + 1)) {
                case .Some(ty) => field->ty = ty;
                case .None => field->ty = .Err(span);
            }
        }

        return .Some(union_type);
    }

    fn normalize_enum_decl(
        self: Self*,
        enum_decl_id: cir::EnumDeclId,
        type_args: cir::TypedTypeArgs,
        indirection: uint8
    ) Option<cir::SemaType> {
        const enum_type: cir::SemaType = .Named(cir::NamedType {
            type_decl_id: .Enum(enum_decl_id),
            type_args,
        });

        const decl = self->decl_tables->enums.get(enum_decl_id).unwrap();

        if (decl->is_normalized) {
            return .Some(enum_type);
        }

        decl->is_normalized = true;

        for (var i: usize = 0; i < decl->variants.len(); i += 1) {
            const variant = decl->variants.get(i).unwrap();

            switch (*variant) {
                case .Valued { value, .. } => {
                    self->analyze_expr(value, decl->tag_type);
                }

                case .Tuple { var fields, .. } => {
                    for (var j: usize = 0; j < fields.len(); j += 1) {
                        const field = fields.get(j).unwrap();
                        const span = field->span;

                        switch (self->normalize_sema_type(field->ty, span, indirection + 1)) {
                            case .Some(ty) => field->ty = ty;
                            case .None => field->ty = .Err(span);
                        }
                    }
                }

                case .Struct { var fields, .. } => {
                    for (var j: usize = 0; j < fields.len(); j += 1) {
                        const field = fields.get(j).unwrap();
                        const span = field->span;

                        switch (self->normalize_sema_type(field->ty, span, indirection + 1)) {
                            case .Some(ty) => field->ty = ty;
                            case .None => field->ty = .Err(span);
                        }
                    }
                }
                else => {}
            }
        }

        return .Some(enum_type);
    }

    fn normalize_unresolved_type(
        self: Self*,
        unresolved: cir::UnresolvedType,
        loc: Span,
        indirection: uint8
    ) Option<cir::SemaType> {
        switch (unresolved) {
            case .Decl(symbol_id) => {
                const decl_id = self->registry->lookup_symbol_as_decl_id(symbol_id);

                switch (decl_id) {
                    case .Some(id) => {
                        switch (decl_id_as_type_decl_id(id)) {
                            case .Some => {
                                return self->resolve_symbol_type(id, loc, indirection);
                            }
                            case .None => {
                                var symbol_name = format::format_decl_name(self->allocator, self->decl_tables, &id);
                                defer symbol_name.free();

                                diags::report_non_type_symbol(
                                    self->dctx,
                                    self->allocator,
                                    loc,
                                    symbol_name.as_str_const()
                                );
                                return .None;
                            }
                        }
                    }
                    case .None => return .None;
                }
            }

            case .GenericInst { base_symbol_id, var type_args } => {
                const decl_id = self->registry->lookup_symbol_as_decl_id(base_symbol_id);

                switch (decl_id) {
                    case .Some(id) => {
                        switch (decl_id_as_type_decl_id(id)) {
                            case .Some(type_decl_id) => {
                                var args = cir::TypedTypeArgs.new(self->allocator);
                                
                                for (var i: usize = 0; i < type_args.len(); i += 1) {
                                    const arg = type_args.get(i).unwrap();
                                    args.push(*arg);
                                }

                                self->normalize_type_args(&args, indirection);

                                var named_type = cir::NamedType { type_decl_id, type_args: args };
                                return self->normalize_named_type(&named_type, indirection);
                            }
                            case .None => return .None;
                        }
                    }
                    case .None => return .None;
                }
            }

            // REVIEW: Refactor this and make a helper for handling
            // builtins in normalization.
            case .BuiltinFunc(builtin_func) => {
                for (var i: usize = 0; i < builtin_func->args.len(); i += 1) {
                    const arg = builtin_func->args.get(i).unwrap();
                    self->analyze_expr(arg, .None);
                }

                if (builtin_func->name.str.as_str_const() == "typeof") {
                    switch (builtin_func->args.first_const()) {
                        case .Some(arg0) => {
                            switch (arg0->ty) {
                                case .Some(arg_ty) => {
                                    return .Some(self->expand_sema_type(arg_ty, builtin_func->span));
                                }
                                else => {}
                            }
                        }
                        else => {}
                    }
                }

                diags::report_builtin_does_not_produce_type(
                    self->dctx,
                    self->allocator,
                    builtin_func->span,
                    builtin_func->name.str.as_str_const()
                );
                return .Some(.Err(builtin_func->span));
            }
        }
    }

    fn normalize_func_type(
        self: Self*,
        func_type: cir::TypedFuncType,
        indirection: uint8
    ) Option<cir::SemaType> {
        const params_len = func_type.params.list.len();

        var params = cir::TypedFuncTypeParams {
            list: Vec.with_capacity(self->allocator, params_len),
            variadic: .None,
        };

        var failed = false;

        for (var i: usize = 0; i < params_len && !failed; i += 1) {
            const param = func_type.params.list.get_const(i).unwrap();
            
            switch (self->normalize_sema_type(*param, func_type.span, indirection)) {
                case .Some(ty) => params.list.push(ty);
                case .None => failed = true;
            }
        }
        
        if (failed) {
            params.list.free();
            return .None;
        }

        switch (func_type.params.variadic) {
            case .Some(variadic) => {
                switch (*variadic) {
                    case .UntypedCStyle => {
                        params.variadic = .Some(alloc_init(
                            self->allocator,
                            cir::TypedFuncTypeVariadicParam.UntypedCStyle
                        ));
                    }
                    case .Typed(ty) => {
                        switch (self->normalize_sema_type(ty, func_type.span, indirection)) {
                            case .Some(normalized) => {
                                params.variadic = .Some(alloc_init(
                                    self->allocator,
                                    cir::TypedFuncTypeVariadicParam.Typed(normalized)
                                ));
                            }
                            case .None => {
                                params.list.free();
                                return .None;
                            }
                        }
                    }
                }
            }
            else => {}
        }

        switch (self->normalize_sema_type(*func_type.ret_type, func_type.span, indirection)) {
            case .Some(ret_type) => {
                return .Some(.FuncType(cir::TypedFuncType {
                    params,
                    ret_type: alloc_init(self->allocator, ret_type),
                    vis: func_type.vis,
                    callconv: func_type.callconv,
                    span: func_type.span,
                }));
            }
            case .None => {
                params.list.free();
                return .None;
            }
        }
    }

    fn normalize_tuple(
        self: Self*,
        tuple_type: cir::TypedTupleType,
        indirection: uint8
    ) Option<cir::SemaType> {
        const elements_len = tuple_type.elements.len();

        var elements: Vec<cir::TypedTupleElement> = Vec.with_capacity(self->allocator, elements_len);
        defer elements.free();
        var failed = false;

        for (var i: usize = 0; i < elements_len && !failed; i += 1) {
            const element = tuple_type.elements.get_const(i).unwrap();

            switch (self->normalize_sema_type(element->ty, element->span, indirection)) {
                case .Some(ty) => {
                    elements.push(cir::TypedTupleElement {
                        ty,
                        span: element->span,
                    });
                }
                case .None => {
                    failed = true;
                }
            }
        }

        if (failed) {
            return .None;
        }

        return .Some(.Tuple(cir::TypedTupleType {
            elements,
            span: tuple_type.span,
        }));
    }

    fn normalize_array(
        self: Self*,
        var array_type: cir::TypedArrayType,
        loc: Span,
        indirection: uint8
    ) Option<cir::SemaType> {
        switch (array_type.capacity) {
            case .Fixed(expr) => {
                self->analyze_expr(expr, .None);

                if (expr->literal_const_int_value().is_none()) {
                    diags::report_array_capacity_not_const(self->dctx, self->allocator, loc);
                    return .None;
                }
            }
            case .Slice => {
                diags::report_unimplemented_feature_slice(self->dctx, self->allocator, loc);
                return .None;
            }
        }

        switch (self->normalize_sema_type(*array_type.element_type, loc, indirection)) {
            case .Some(ty) => array_type.element_type = alloc_init(self->allocator, ty);
            case .None => return .None;
        }

        return .Some(.Array(array_type));
    }

    fn normalize_const(
        self: Self*,
        inner: cir::SemaType*,
        loc: Span,
        indirection: uint8
    ) Option<cir::SemaType> {
        switch (self->normalize_sema_type(*inner, loc, indirection)) {
            case .Some(ty) => return .Some(.Const(alloc_init(self->allocator, ty)));
            case .None => return .None;
        }
    }

    fn normalize_pointer(
        self: Self*,
        inner: cir::SemaType*,
        loc: Span,
        indirection: uint8
    ) Option<cir::SemaType> {
        switch (self->normalize_sema_type(*inner, loc, indirection + 1)) {
            case .Some(ty) => return .Some(.Pointer(alloc_init(self->allocator, ty)));
            case .None => return .None;
        }
    }

    fn normalize_generic_param(self: Self*, generic_param_id: cir::GenericParamId) Option<cir::SemaType> {
        const bound = self->lookup_generic_binding(generic_param_id);
        switch (bound) {
            case .Some(ty) => {
                switch (self->func_env.infer) {
                    case .Some(infer_ctx) => return .Some(infer_ctx->resolve(&ty));
                    case .None => return .Some(ty);
                }
            }
            case .None => return .Some(.GenericParam(generic_param_id));
        }
    }

    fn normalize_self_type(self: Self*, self_type: cir::TypedSelfType) Option<cir::SemaType> {
        switch (self->func_env.current_object) {
            case .Some(object_type) => return .Some(object_type);
            case .None => return .Some(.SelfType(self_type));
        }
    }

    pub fn normalize_type_args(self: Self*, type_args: cir::TypedTypeArgs*, indirection: uint8) {
        for (var i: usize = 0; i < type_args->list.len(); i += 1) {
            var arg = type_args->list.get(i).unwrap();

            switch (*arg) {
                case .Type(inner, span) => {
                    switch (self->normalize_sema_type(inner, span, indirection)) {
                        case .Some(ty) => *arg = .Type(ty, span);
                        case .None => *arg = .Type(.Err(span), span);
                    }
                }
                case .Infer => {}
            }
        }
    }

    pub fn normalize_func_params(
        self: Self*,
        params: cir::TypedFuncParams*,
        validate: bool,
        indirection: uint8
    ) {
        for (var i: usize = 0; i < params->list.len(); i += 1) {
            var kind = params->list.get(i).unwrap();

            switch (*kind) {
                case .FuncParam(var func_param) => {
                    switch (self->normalize_sema_type(func_param.ty, func_param.span, indirection)) {
                        case .Some(ty) => {
                            func_param.ty = ty;

                            if (validate) {
                                self->validate_param_type(&ty, func_param.span);
                            }
                            *kind = .FuncParam(func_param);
                        }
                        else => {}
                    }
                }
                case .SelfModifier(var self_modifier) => {
                    switch (self->normalize_sema_type(self_modifier.ty, self_modifier.span, indirection)) {
                        case .Some(ty) => {
                            self_modifier.ty = ty;

                            if (validate) {
                                self->validate_param_type(&ty, self_modifier.span);
                            }
                            *kind = .SelfModifier(self_modifier);
                        }
                        else => {}
                    }
                }
            }
        }

        switch (params->variadic) {
            case .Some(.Typed { var_decl_id, ty, span }) => {
                switch (self->normalize_sema_type(ty, span, indirection)) {
                    case .Some(normalized) => {
                        if (validate) {
                            self->validate_param_type(&normalized, span);
                        }

                        params->variadic = .Some(cir::TypedFuncVariadicParam.Typed {
                                var_decl_id,
                                ty: normalized,
                                span,
                        });
                    }
                    case .None => return;
                }
            }
            else => {}
        }
    }

    pub fn normalize_func_type_params(
        self: Self*,
        params: cir::TypedFuncTypeParams*,
        loc: Span,
        indirection: uint8
    ) {
        for (var i: usize = 0; i < params->list.len(); i += 1) {
            var param = params->list.get(i).unwrap();

            switch (self->normalize_sema_type(*param, loc, indirection)) {
                case .Some(normalized) => {
                    *param = normalized;
                    self->validate_param_type(&normalized, loc);
                }
                case .None => return;
            }
        }

        switch (params->variadic) {
            case .Some(variadic) => {
                switch (*variadic) {
                    case .Typed(ty) => {
                        switch (self->normalize_sema_type(ty, loc, indirection)) {
                            case .Some(normalized) => {
                                self->validate_param_type(&normalized, loc);
                                *variadic = cir::TypedFuncTypeVariadicParam.Typed(normalized);
                            }
                            case .None => return;
                        }
                    }
                    else => {}
                }
            }
            else => {}
        }
    }

    pub fn resolve_symbol_type(
        self: Self*,
        decl_id: cir::DeclId,
        loc: Span,
        indirection: uint8
    ) Option<cir::SemaType> {
        var key = decl_id_key(decl_id);

        const cached = self->type_cache.get(key);

        switch (cached) {
            case .Some(ty) => return .Some(ty);
            else => {}
        }

        switch (self->type_cache.enter(key, indirection)) {
            case .AlreadyResolving(frame_indirection) => {
                // Indirection makes recursion legal
                if (frame_indirection > 0 || indirection > 0) {
                    switch (decl_id_as_type_decl_id(decl_id)) {
                        case .Some(type_decl_id) => {
                            return .Some(.Named(cir::NamedType {
                                type_decl_id,
                                type_args: cir::TypedTypeArgs.new(self->allocator),
                            }));
                        }
                        case .None => return .None;
                    }
                }

                var symbol_name = format::format_decl_name(self->allocator, self->decl_tables, &decl_id);
                var cycle: Vec<String> = Vec.new(self->allocator);
                cycle.push(symbol_name);

                diags::report_cyclic_type_definition(
                    self->dctx,
                    self->allocator,
                    loc,
                    &cycle
                );
                free_strings(&cycle);
                return .None;
            }
            case .Entered => {}
        }

        const raw_ty = self->resolve_symbol_type_internal(decl_id, indirection);
        switch (raw_ty) {
            case .Some(raw) => {
                switch (self->normalize_sema_type(raw, loc, indirection)) {
                    case .Some(ty) => {
                        self->type_cache.leave(key, ty);
                        return .Some(ty);
                    }
                    case .None => return .None;
                }
            }
            case .None => return .None;
        }
    }

    fn resolve_symbol_type_internal(
        self: Self*,
        decl_id: cir::DeclId,
        indirection: uint8
    ) Option<cir::SemaType> {
        switch (decl_id) {
            case .GlobalVar(id) => {
                const decl = self->decl_tables->global_vars.get_const(id).unwrap();
                return decl->ty;
            }
            case .Var(id) => {
                const decl = self->decl_tables->vars.get_const(id).unwrap();
                return decl->ty;
            }
            case .Func(id) => {
                const decl = self->decl_tables->funcs.get_const(id).unwrap();
                const func_type = func_decl_as_func_type(self->allocator, decl);
                return self->normalize_func_type(func_type, indirection);
            }
            case .Struct(id) => {
                return .Some(.Named(cir::NamedType {
                    type_decl_id: .Struct(id),
                    type_args: cir::TypedTypeArgs.new(self->allocator),
                }));
            }
            case .Enum(id) => {
                return .Some(.Named(cir::NamedType {
                    type_decl_id: .Enum(id),
                    type_args: cir::TypedTypeArgs.new(self->allocator),
                }));
            }
            case .Union(id) => {
                return .Some(.Named(cir::NamedType {
                    type_decl_id: .Union(id),
                    type_args: cir::TypedTypeArgs.new(self->allocator),
                }));
            }
            case .Typedef(id) => {
                return .Some(.Named(cir::NamedType {
                    type_decl_id: .Typedef(id),
                    type_args: cir::TypedTypeArgs.new(self->allocator),
                }));
            }
            case .Interface(id) => {
                return .Some(.Named(cir::NamedType {
                    type_decl_id: .Interface(id),
                    type_args: cir::TypedTypeArgs.new(self->allocator),
                }));
            }
            case .Method => {
                // Methods never appear in type position; guarded by as_type_decl_id.
                return .None;
            }
        }
    }


    /* ************* Type formation & arity checks ************* */

    // Fully validates a normalized type (redundant const, args, void rules,
    // Self placement, union emptiness). Returns None when invalid.
    pub fn check_type_formation(self: Self*, ty: cir::SemaType, loc: Span) Option<cir::SemaType> {
        if (ty.is_err()) {
            return .None;
        }

        var error = false;
        self->check_type_formation_rec(&ty, loc, &error);

        if (error) {
            return .None;
        }
        return .Some(ty);
    }

    fn check_type_formation_rec(self: Self*, ty: const cir::SemaType*, loc: Span, error: bool*) {
        if (ty->count_const_layers() > 1) {
            diags::report_redundant_const_qualifier(self->dctx, self->allocator, loc);
            *error = true;
        }

        switch (*ty) {
            case .Named(named_type) => {
                self->check_unexpected_type_args(&named_type, loc);

                for (var i: usize = 0; i < named_type.type_args.len(); i += 1) {
                    const arg = named_type.type_args.get(i).unwrap();
                    switch (*arg) {
                        case .Type(inner, _) => self->check_type_formation_rec(&inner, loc, error);
                        case .Infer => {}
                    }
                }

                switch (named_type.type_decl_id) {
                    case .Union(union_decl_id) => {
                        const union_decl = self->decl_tables->unions.get_const(union_decl_id).unwrap();
                        if (union_decl->fields.is_empty()) {
                            diags::report_union_type_must_contain_at_least_one_field(
                                self->dctx,
                                self->allocator,
                                loc
                            );
                            *error = true;
                        }
                    }
                    else => {}
                }
            }

            case .Array(array_type) => {
                if (array_type.element_type->is_void()) {
                    diags::report_void_element_type_not_allowed(
                        self->dctx,
                        self->allocator,
                        array_type.span
                    );
                    *error = true;
                }
                self->check_type_formation_rec(array_type.element_type, loc, error);
            }

            case .FuncType(func_type) => {
                for (var i: usize = 0; i < func_type.params.list.len(); i += 1) {
                    const param = func_type.params.list.get_const(i).unwrap();
                    if (param->is_void()) {
                        diags::report_void_parameter_type(self->dctx, self->allocator, func_type.span);
                        *error = true;
                    }
                    self->check_type_formation_rec(param, loc, error);
                }
                self->check_type_formation_rec(func_type.ret_type, loc, error);
            }

            case .Tuple(tuple_type) => {
                for (var i: usize = 0; i < tuple_type.elements.len(); i += 1) {
                    const element = tuple_type.elements.get_const(i).unwrap();
                    if (element->ty.is_void()) {
                        diags::report_void_tuple_element_not_allowed(
                            self->dctx,
                            self->allocator,
                            tuple_type.span
                        );
                        *error = true;
                    }
                    self->check_type_formation_rec(&element->ty, loc, error);
                }
            }

            case .SelfType => {
                if (self->func_env.current_object.is_none()) {
                    diags::report_self_type_outside_of_an_object(
                        self->dctx, 
                        self->allocator, 
                        loc
                    );
                    *error = true;
                }
            }

            case .Const(inner) => self->check_type_formation_rec(inner, loc, error);
            case .Pointer(inner) => self->check_type_formation_rec(inner, loc, error);

            else => {
                // Plain/InterfaceObject/GenericParam/InferVar/Unresolved/Err/Placeholder: nothing
            }
        }
    }

    // Arity/correctness checks for an already-normalized type (after monomorph
    // the type must be fully concrete).
    pub fn check_type_arity(self: Self*, ty: cir::SemaType, loc: Span) bool {
        if (ty.is_err()) {
            return true;
        }

        return self->check_type_arity_rec(&ty, loc);
    }

    fn check_type_arity_rec(self: Self*, ty: const cir::SemaType*, loc: Span) bool {
        switch (*ty) {
            case .Named(named_type) => {
                if (self->check_missing_type_args(&named_type, loc)) {
                    return false;
                }
                if (self->check_unresolved_infer_vars(&named_type, loc)) {
                    return false;
                }

                for (var i: usize = 0; i < named_type.type_args.len(); i += 1) {
                    const arg = named_type.type_args.get(i).unwrap();
                    switch (*arg) {
                        case .Type(inner, inner_span) => {
                            if (!self->check_type_arity_rec(&inner, inner_span)) {
                                return false;
                            }
                        }
                        case .Infer => {
                            // infer allowed here, but not after monomorph
                        }
                    }
                }

                switch (named_type.type_decl_id) {
                    case .Interface(interface_decl_id) => {
                        const interface_decl = self->decl_tables->interfaces.get_const(interface_decl_id).unwrap();
                        if (!interface_decl->is_interface_dynamically_dispatchable) {
                            diags::report_not_dynamic_compatible_interface(
                                self->dctx,
                                self->allocator,
                                loc,
                                interface_decl->name.as_str_const()
                            );
                            return false;
                        }
                    }
                    else => {}
                }

                return true;
            }

            case .Const(inner) => return self->check_type_arity_rec(inner, loc);
            case .Pointer(inner) => return self->check_type_arity_rec(inner, loc);
            case .Array(array_type) => return self->check_type_arity_rec(array_type.element_type, array_type.span);
            case .FuncType(func_type) => {
                for (var i: usize = 0; i < func_type.params.list.len(); i += 1) {
                    const param = func_type.params.list.get_const(i).unwrap();
                    if (!self->check_type_arity_rec(param, func_type.span)) {
                        return false;
                    }
                }
                return self->check_type_arity_rec(func_type.ret_type, func_type.span);
            }
            case .Tuple(tuple_type) => {
                for (var i: usize = 0; i < tuple_type.elements.len(); i += 1) {
                    const element = tuple_type.elements.get_const(i).unwrap();
                    if (!self->check_type_arity_rec(&element->ty, tuple_type.span)) {
                        return false;
                    }
                }
                return true;
            }

            else => return true;
        }
    }

    pub fn check_type_correctness(self: Self*, ty: cir::SemaType, loc: Span) bool {
        if (ty.is_err()) {
            return true;
        }

        return self->check_type_correctness_recursively(&ty, loc);
    }

    fn check_type_correctness_recursively(self: Self*, ty: const cir::SemaType*, loc: Span) bool {
        switch (*ty) {
            case .Named(named_type) => {
                if (self->check_missing_type_args(&named_type, loc)) {
                    return false;
                }
                if (self->check_unresolved_infer_vars(&named_type, loc)) {
                    return false;
                }

                for (var i: usize = 0; i < named_type.type_args.len(); i += 1) {
                    const arg = named_type.type_args.get(i).unwrap();
                    switch (*arg) {
                        case .Type(inner, inner_span) => {
                            if (!self->check_type_correctness_recursively(&inner, inner_span)) {
                                return false;
                            }
                        }
                        case .Infer => {}
                    }
                }
                return true;
            }

            case .FuncType(func_type) => {
                for (var i: usize = 0; i < func_type.params.list.len(); i += 1) {
                    const param = func_type.params.list.get_const(i).unwrap();
                    if (!self->check_type_correctness_recursively(param, func_type.span)) {
                        return false;
                    }
                }
                return self->check_type_correctness_recursively(func_type.ret_type, func_type.span);
            }

            case .Tuple(tuple_type) => {
                for (var i: usize = 0; i < tuple_type.elements.len(); i += 1) {
                    const element = tuple_type.elements.get_const(i).unwrap();
                    if (!self->check_type_correctness_recursively(&element->ty, tuple_type.span)) {
                        return false;
                    }
                }
                return true;
            }

            case .Array(array_type) => {
                return self->check_type_correctness_recursively(array_type.element_type, array_type.span);
            }

            case .Pointer(inner) => return self->check_type_correctness_recursively(inner, loc);

            case .Const(inner) => return self->check_type_correctness_recursively(inner, loc);

            else => return true;
        }
    }

    pub fn validate_param_type(self: Self*, ty: const cir::SemaType*, loc: Span) {
        const inner = ty->const_inner();

        if (inner->is_void()) {
            diags::report_void_parameter_type(self->dctx, self->allocator, loc);
        }

        self->check_type_arity(*inner, loc);
    }

    fn check_unexpected_type_args(self: Self*, named_type: const cir::NamedType*, loc: Span) bool {
        const generic_params = type_decl_generic_params(self->decl_tables, named_type->type_decl_id);

        if (generic_params->is_empty() && !named_type->type_args.is_empty()) {
            const ty = named_type->as_sema_type();

            var type_name = format::format_sema_type(
                self->allocator,
                self->decl_tables,
                &ty
            );
            defer type_name.free();

            diags::report_unexpected_type_args(
                self->dctx,
                self->allocator,
                loc,
                type_name.as_str_const()
            );
            return true;
        }

        return false;
    }

    fn check_missing_type_args(self: Self*, named_type: const cir::NamedType*, loc: Span) bool {
        var error = false;

        const generic_params = type_decl_generic_params(self->decl_tables, named_type->type_decl_id);
        const ty = named_type->as_sema_type();

        for (var i: usize = 0; i < generic_params->len(); i += 1) {
            const param_id = generic_params->ids.get_const(i).unwrap();

            const type_arg = named_type->type_args.get(i);

            switch (type_arg) {
                case .None => {
                    error = true;

                    const param = self->decl_tables->generic_params.get_const(*param_id).unwrap();
                    
                    var type_name = format::format_sema_type(
                        self->allocator,
                        self->decl_tables,
                        &ty
                    );
                    defer type_name.free();

                    diags::report_missing_generic_argument(
                        self->dctx,
                        self->allocator,
                        loc,
                        type_name.as_str_const(),
                        param->name.str.as_str_const()
                    );
                }

                case .Some(arg) => {
                    const generic_param = self->decl_tables->generic_params.get_const(*param_id).unwrap();

                    switch (*arg) {
                        case .Type(sema_ty, _) => {
                            if (sema_ty.contains_generic_param()) {
                                error = true;
                                diags::report_unresolved_generic_parameter(
                                    self->dctx,
                                    self->allocator,
                                    loc,
                                    generic_param->name.str.as_str_const()
                                );
                            }
                        }
                        case .Infer => {
                            error = true;
                            diags::report_unresolved_generic_parameter(
                                self->dctx,
                                self->allocator,
                                loc,
                                generic_param->name.str.as_str_const()
                            );
                        }
                    }
                }
            }
        }

        return error;
    }

    fn check_unresolved_infer_vars(self: Self*, named_type: const cir::NamedType*, loc: Span) bool {
        var error = false;

        const generic_params = type_decl_generic_params(self->decl_tables, named_type->type_decl_id);
        const ty = named_type->as_sema_type();

        for (var i: usize = 0; i < generic_params->len(); i += 1) {
            const param_id = generic_params->ids.get_const(i).unwrap();

            const type_arg = named_type->type_args.get(i);
            
            switch (type_arg) {
                case .Some(arg) => {
                    const generic_param = self->decl_tables->generic_params.get_const(*param_id).unwrap();

                    switch (*arg) {
                        case .Type(sema_ty, _) => {
                            if (sema_ty.contains_infer_var()) {
                                error = true;

                                var type_name = format::format_sema_type(
                                    self->allocator,
                                    self->decl_tables,
                                    &ty
                                );
                                defer type_name.free();

                                diags::report_cannot_infer_generic_argument(
                                    self->dctx,
                                    self->allocator,
                                    loc,
                                    type_name.as_str_const(),
                                    generic_param->name.str.as_str_const()
                                );
                            }
                        }
                        case .Infer => {
                            error = true;

                            var type_name = format::format_sema_type(
                                self->allocator,
                                self->decl_tables,
                                &ty
                            );
                            defer type_name.free();

                            diags::report_cannot_infer_generic_argument(
                                self->dctx,
                                self->allocator,
                                loc,
                                type_name.as_str_const(),
                                generic_param->name.str.as_str_const()
                            );
                        }
                    }
                }
                else => {}
            }
        }

        return error;
    }

    /* ************* Typedef Expansion ************* */

    /// Expand typedef references recursively.
    pub fn expand_sema_type(self: Self*, ty: cir::SemaType, loc: Span) cir::SemaType {
        switch (ty) {
            case .Placeholder => return ty;
            case .InferVar => return ty;

            case .Named(named_type) => {
                switch (named_type.type_decl_id) {
                    case .Typedef(typedef_decl_id) => {
                        return self->expand_typedef(typedef_decl_id, &named_type.type_args, loc);
                    }
                    else => {
                        var type_args = cir::TypedTypeArgs.new(self->allocator);
                        
                        for (var i: usize = 0; i < named_type.type_args.len(); i += 1) {
                            const arg = named_type.type_args.get(i).unwrap();

                            switch (*arg) {
                                case .Type(inner, span) => {
                                    const expand = self->expand_sema_type(inner, span);
                                    type_args.push(.Type(expand, span));
                                }
                                case .Infer => type_args.push(.Infer);
                            }
                        }

                        return .Named(cir::NamedType {
                            type_decl_id: named_type.type_decl_id,
                            type_args,
                        });
                    }
                }
            }

            case .Pointer(inner) => {
                const expand = self->expand_sema_type(*inner, loc);
                return .Pointer(alloc_init(self->allocator, expand));
            }

            case .Const(inner) => {
                const expand = self->expand_sema_type(*inner, loc);
                return .Const(alloc_init(self->allocator, expand));
            }

            case .Array(array) => {
                const element_type = self->expand_sema_type(*array.element_type, loc);
                
                return .Array(cir::TypedArrayType {
                    element_type: alloc_init(self->allocator, element_type),
                    capacity: array.capacity,
                    span: array.span,
                });
            }

            case .Tuple(tuple_type) => {
                var elements: Vec<cir::TypedTupleElement> =
                    Vec.with_capacity(self->allocator, tuple_type.elements.len());
                
                for (var i: usize = 0; i < tuple_type.elements.len(); i += 1) {
                    const element = tuple_type.elements.get_const(i).unwrap();
                    const expand = self->expand_sema_type(element->ty, element->span);
                    
                    elements.push(cir::TypedTupleElement {
                        ty: expand,
                        span: element->span,
                    });
                }

                return .Tuple(cir::TypedTupleType {
                    elements,
                    span: tuple_type.span,
                });
            }

            case .FuncType(func_type) => {
                var params = cir::TypedFuncTypeParams {
                    list: Vec.with_capacity(self->allocator, func_type.params.list.len()),
                    variadic: .None,
                };

                for (var i: usize = 0; i < func_type.params.list.len(); i += 1) {
                    const param = func_type.params.list.get_const(i).unwrap();
                    const expand = self->expand_sema_type(*param, loc);
                    params.list.push(expand);
                }

                switch (func_type.params.variadic) {
                    case .Some(variadic) => {
                        switch (*variadic) {
                            case .UntypedCStyle => {
                                params.variadic = .Some(alloc_init(
                                    self->allocator,
                                    cir::TypedFuncTypeVariadicParam.UntypedCStyle
                                ));
                            }
                            case .Typed(ty) => {
                                const expand = self->expand_sema_type(ty, loc);
                                params.variadic = .Some(alloc_init(
                                    self->allocator,
                                    cir::TypedFuncTypeVariadicParam.Typed(expand)
                                ));
                            }
                        }
                    }
                    else => {}
                }

                const ret_type = self->expand_sema_type(*func_type.ret_type, loc);

                return .FuncType(cir::TypedFuncType {
                    params,
                    ret_type: alloc_init(self->allocator, ret_type),
                    vis: func_type.vis,
                    callconv: func_type.callconv,
                    span: func_type.span,
                });
            }

            else => return ty;
        }
    }

    fn expand_typedef(
        self: Self*,
        typedef_decl_id: cir::TypedefDeclId,
        args: const cir::TypedTypeArgs*,
        loc: Span
    ) cir::SemaType {
        switch (self->push_typedef_expansion(typedef_decl_id)) {
            case .Some(var path) => {
                defer path.free();
                var key = self->typedef_cycle_key(path);
                defer key.free();

                if (!self->cycle_already_reported(key.as_str_const())) {
                    const n = path.len() - 1;
                    var min_index: usize = 0;
                    var min_val: usize = *path.get_const(0).unwrap();

                    for (var i: usize = 1; i < n; i += 1) {
                        const v = *path.get_const(i).unwrap();
                        if (v < min_val) {
                            min_val = v;
                            min_index = i;
                        }
                    }

                    var names: Vec<String> = Vec.new(self->allocator);

                    for (var i: usize = 0; i < n; i += 1) {
                        const idx = (min_index + i) % n;
                        const id = *path.get_const(idx).unwrap();

                        names.push(format::format_type_decl_name(
                            self->allocator,
                            self->decl_tables,
                            .Typedef(id)
                        ));
                    }

                    // Close the cycle
                    if (n > 0) {
                        const first = names.get_const(0).unwrap();
                        names.push(String.from_str(self->allocator, first->as_str_const()));
                    }

                    diags::report_cyclic_type_definition(
                        self->dctx,
                        self->allocator,
                        loc,
                        &names
                    );
                    free_strings(&names);

                    self->reported_typedef_cycles.push(key);
                } else {
                }

                return .Err(loc);
            }
            else => {}
        }

        const typedef_decl = self->decl_tables->typedefs.get_const(typedef_decl_id).unwrap();

        if (typedef_decl->ty == null) {
            self->pop_typedef_expansion();
            return .Err(loc);
        }

        const generic_params = &typedef_decl->generic_params;

        var final_args = cir::TypedTypeArgs.new(self->allocator);
        defer final_args.list.free();

        for (var i: usize = 0; i < generic_params->len(); i += 1) {
            if (i < args->len()) {
                const arg = args->get(i).unwrap();
                final_args.push(*arg);
            } else {
                switch (self->func_env.infer) {
                    case .Some(infer_ctx) => {
                        const infer_var = infer_ctx->new_var_id();
                        final_args.push(.Type(.InferVar(infer_var), loc));
                    }
                    case .None => {
                        final_args.push(.Infer);
                    }
                }
            }
        }

        if (args->len() > final_args.len()) {
            var named = cir::NamedType {
                type_decl_id: .Typedef(typedef_decl_id),
                type_args: cir::TypedTypeArgs.new(self->allocator),
            };

            for (var i: usize = 0; i < args->len(); i += 1) {
                const arg = args->get(i).unwrap();
                named.type_args.push(*arg);
            }

            const ty: cir::SemaType = .Named(named);
            
            var type_name = format::format_sema_type(
                self->allocator,
                self->decl_tables,
                &ty
            );
            defer type_name.free();

            diags::report_wrong_number_of_type_args(
                self->dctx,
                self->allocator,
                loc,
                type_name.as_str_const(),
                final_args.len(),
                args->len()
            );
            named.type_args.list.free();
        }

        var generic_env = GenericEnv.from_type_args(
            self->allocator,
            *generic_params,
            &final_args
        );
        defer generic_env.free();

        const typedef_type =
            self->normalize_and_check_type_formation(*typedef_decl->ty, loc, 0);
        
        switch (typedef_type) {
            case .None => {
                self->pop_typedef_expansion();
                return .Err(loc);
            }
            case .Some(defined_type) => {
                const subst = generic_env.substitute_sema_type(&defined_type);
                self->pop_typedef_expansion();
                return self->expand_sema_type(subst, loc);
            }
        }
    }

    /* ************* Assignability ************* */

    pub fn is_assignable_to(
        self: Self*,
        rhs_type: cir::SemaType,
        lhs_type: cir::SemaType,
        loc: Span
    ) bool {
        if (rhs_type.contains_error() || lhs_type.contains_error()) {
            return true;
        }

        const expanded_lhs = self->expand_sema_type(lhs_type, loc);
        const expanded_rhs = self->expand_sema_type(rhs_type, loc);

        // T* <-> T* (Constness matters)
        switch (expanded_rhs) {
            case .Pointer(inner1) => {
                switch (expanded_lhs) {
                    case .Pointer(inner2) => {
                        const is_lhs_const = inner2->is_const();
                        const is_rhs_const = inner1->is_const();

                        if (!is_lhs_const && is_rhs_const) {
                            return false;
                        }

                        if (inner1->is_void() || inner2->is_void()) {
                            return true;
                        }

                        return self->is_assignable_to(*inner1, *inner2, loc);
                    }
                    else => {}
                }
            }
            else => {}
        }

        const rhs_inner = expanded_rhs.const_inner();
        const lhs_inner = expanded_lhs.const_inner();

        if (rhs_inner->is_err() || lhs_inner->is_err()) {
            return true;
        }

        // null -> T*
        switch (*rhs_inner) {
            case .Plain(.Null) => {
                switch (*lhs_inner) {
                    case .Pointer => return true;
                    else => {}
                }
            }
            else => {}
        }

        switch (*rhs_inner) {
            case .Plain(p1) => {
                switch (*lhs_inner) {
                    case .Plain(p2) => return is_plain_type_assignable_to(p1, p2);
                    else => return false;
                }
            }

            case .InterfaceObject(interface_object1) => {
                switch (*lhs_inner) {
                    case .InterfaceObject(interface_object2) => {
                        return self->is_named_type_assignable_to(
                            &interface_object1.interface_type,
                            &interface_object2.interface_type,
                            loc
                        );
                    }
                    case .Named(named_type2) => {
                        return self->is_named_type_assignable_to(
                            &interface_object1.interface_type,
                            &named_type2,
                            loc
                        );
                    }
                    else => return false;
                }
            }

            case .Named(named_type1) => {
                switch (*lhs_inner) {
                    case .Named(named_type2) => {
                        return self->is_named_type_assignable_to(&named_type1, &named_type2, loc);
                    }
                    else => return false;
                }
            }

            case .Array(array_type1) => {
                switch (*lhs_inner) {
                    case .Array(array_type2) => {
                        if (!self->is_const_str_assignable_to_array(&array_type1, &array_type2)) {
                            return false;
                        }
                        return self->is_assignable_to(
                            *array_type1.element_type,
                            *array_type2.element_type,
                            loc
                        );
                    }
                    case .Pointer(inner) => {
                        // Array-to-pointer decay
                        return self->is_assignable_to(*array_type1.element_type, *inner, loc);
                    }
                    else => return false;
                }
            }

            case .Tuple(tuple_type1) => {
                switch (*lhs_inner) {
                    case .Tuple(tuple_type2) => return tuple_type_eq(&tuple_type1, &tuple_type2);
                    else => return false;
                }
            }

            case .FuncType(func_type1) => {
                switch (*lhs_inner) {
                    case .FuncType(func_type2) => return func_type_eq(&func_type1, &func_type2);
                    else => return false;
                }
            }

            else => return false;
        }
    }

    fn is_named_type_assignable_to(
        self: Self*,
        named_type1: const cir::NamedType*,
        named_type2: const cir::NamedType*,
        loc: Span
    ) bool {
        switch (named_type1->type_decl_id) {
            case .Struct(id1) => {
                switch (named_type2->type_decl_id) {
                    case .Struct(id2) => {
                        if (id1 == id2 && type_args_eq(&named_type1->type_args, &named_type2->type_args)) {
                            return true;
                        }

                        const decl1 = self->decl_tables->structs.get_const(id1).unwrap();
                        const decl2 = self->decl_tables->structs.get_const(id2).unwrap();

                        var env1 = GenericEnv.from_type_args(
                            self->allocator,
                            decl1->generic_params,
                            &named_type1->type_args
                        );
                        defer env1.free();

                        var env2 = GenericEnv.from_type_args(
                            self->allocator,
                            decl2->generic_params,
                            &named_type2->type_args
                        );
                        defer env2.free();

                        const result = self->is_struct_decl_assignable_to(decl1, decl2, &env1, &env2, loc);
                        
                        return result;
                    }
                    else => return false;
                }
            }

            case .Union(id1) => {
                switch (named_type2->type_decl_id) {
                    case .Union(id2) => {
                        if (id1 == id2 && type_args_eq(&named_type1->type_args, &named_type2->type_args)) {
                            return true;
                        }

                        const decl1 = self->decl_tables->unions.get_const(id1).unwrap();
                        const decl2 = self->decl_tables->unions.get_const(id2).unwrap();

                        var env1 = GenericEnv.from_type_args(
                            self->allocator,
                            decl1->generic_params,
                            &named_type1->type_args
                        );
                        defer env1.free();

                        var env2 = GenericEnv.from_type_args(
                            self->allocator,
                            decl2->generic_params,
                            &named_type2->type_args
                        );
                        defer env2.free();

                        const result = self->is_union_decl_assignable_to(decl1, decl2, &env1, &env2, loc);
                        return result;
                    }
                    else => return false;
                }
            }

            case .Enum(id1) => {
                switch (named_type2->type_decl_id) {
                    case .Enum(id2) => {
                        if (id1 == id2 && type_args_eq(&named_type1->type_args, &named_type2->type_args)) {
                            return true;
                        }

                        const decl1 = self->decl_tables->enums.get_const(id1).unwrap();
                        const decl2 = self->decl_tables->enums.get_const(id2).unwrap();

                        var env1 = GenericEnv.from_type_args(
                            self->allocator,
                            decl1->generic_params,
                            &named_type1->type_args
                        );
                        defer env1.free();

                        var env2 = GenericEnv.from_type_args(
                            self->allocator,
                            decl2->generic_params,
                            &named_type2->type_args
                        );
                        defer env2.free();

                        const result = self->is_enum_decl_assignable_to(decl1, decl2, &env1, &env2, loc);
                        return result;
                    }
                    else => return false;
                }
            }

            case .Interface(id1) => {
                switch (named_type2->type_decl_id) {
                    case .Interface(id2) => {
                        return id1 == id2 && type_args_eq(&named_type1->type_args, &named_type2->type_args);
                    }
                    else => return false;
                }
            }

            else => return false;
        }
    }

    fn is_struct_decl_assignable_to(
        self: Self*,
        struct_decl1: const cir::StructDecl*,
        struct_decl2: const cir::StructDecl*,
        env1: const GenericEnv*,
        env2: const GenericEnv*,
        loc: Span
    ) bool {
        var ok = true;

        for (var i: usize = 0; i < struct_decl2->fields.len() && ok; i += 1) {
            const field2 = struct_decl2->fields.get_const(i).unwrap();
            const found = struct_decl1->lookup_field(field2->name.as_str_const());

            switch (found) case .Some(field1) else {
                ok = false;
                continue;
            }

            switch (self->normalize_sema_type(field1->ty, loc, 0)) case .Some(var ty1) else {
                ok = false;
                continue;
            }

            switch (self->normalize_sema_type(field2->ty, loc, 0)) case .Some(var ty2) else {
                ok = false;
                continue;
            }

            ty1 = env1->substitute_sema_type(&ty1);
            ty2 = env2->substitute_sema_type(&ty2);

            if (!self->is_assignable_to(ty1, ty2, loc)) {
                ok = false;
            }
        }

        return ok;
    }

    fn is_union_decl_assignable_to(
        self: Self*,
        union_decl1: const cir::UnionDecl*,
        union_decl2: const cir::UnionDecl*,
        env1: const GenericEnv*,
        env2: const GenericEnv*,
        loc: Span
    ) bool {
        var ok = true;

        for (var i: usize = 0; i < union_decl1->fields.len() && ok; i += 1) {
            const field1 = union_decl1->fields.get_const(i).unwrap();
            const found = union_decl2->lookup_field(field1->name.as_str_const());

            switch (found) {
                case .Some(field2) => {
                    switch (self->normalize_sema_type(field1->ty, loc, 0)) {
                        case .Some(ty1_raw) => {
                            switch (self->normalize_sema_type(field2->ty, loc, 0)) {
                                case .Some(ty2_raw) => {
                                    const ty1 = env1->substitute_sema_type(&ty1_raw);
                                    const ty2 = env2->substitute_sema_type(&ty2_raw);

                                    if (!self->is_assignable_to(ty1, ty2, loc)) {
                                        ok = false;
                                    }
                                }
                                case .None => ok = false;
                            }
                        }
                        case .None => ok = false;
                    }
                }
                case .None => ok = false;
            }
        }

        return ok;
    }

    fn is_enum_decl_assignable_to(
        self: Self*,
        enum_decl1: const cir::EnumDecl*,
        enum_decl2: const cir::EnumDecl*,
        env1: const GenericEnv*,
        env2: const GenericEnv*,
        loc: Span
    ) bool {
        switch (enum_decl1->tag_type) {
            case .Some(tag1) => {
                switch (enum_decl2->tag_type) {
                    case .Some(tag2) => {
                        const s1 = env1->substitute_sema_type(&tag1);
                        const s2 = env2->substitute_sema_type(&tag2);

                        if (!self->is_assignable_to(s1, s2, loc)) {
                            return false;
                        }
                    }
                    else => {}
                }
            }
            else => {}
        }

        switch (enum_decl1->align) {
            case .Some(a1) => {
                switch (enum_decl2->align) {
                    case .Some(a2) => {
                        if (a1 != a2) {
                            return false;
                        }
                    }
                    else => {}
                }
            }
            else => {}
        }

        var ok = true;

        for (var i: usize = 0; i < enum_decl1->variants.len() && ok; i += 1) {
            const variant1 = enum_decl1->variants.get_const(i).unwrap();
            const found = enum_decl2->lookup_variant(variant1->name());

            switch (found) {
                case .None => ok = false;
                case .Some(variant2) => {
                    switch (*variant1) {
                        case .Unit => {
                            switch (*variant2) {
                                case .Unit => {}
                                else => ok = false;
                            }
                        }

                        case .Valued { value: v1, .. } => {
                            switch (*variant2) case .Valued { value: v2, .. } else {
                                ok = false;
                                continue;
                            }

                            switch (v1->ty) case .Some(raw1) else {
                                ok = false;
                                continue;
                            }

                            switch (v2->ty) case .Some(raw2) else {
                                ok = false;
                                continue;
                            }

                            switch (self->normalize_sema_type(raw1, loc, 0)) case .Some(ty1_n) else {
                                ok = false;
                                continue;
                            }

                            switch (self->normalize_sema_type(raw2, loc, 0)) case .Some(ty2_n) else {
                                ok = false;
                                continue;
                            }

                            const ty1 = env1->substitute_sema_type(&ty1_n);
                            const ty2 = env2->substitute_sema_type(&ty2_n);

                            if (!self->is_assignable_to(ty1, ty2, loc)) {
                                ok = false;
                            }
                        }

                        case .Tuple { fields: f1, .. } => {
                            switch (*variant2) {
                                case .Tuple { fields: f2, .. } => {

                                    if (f1.len() != f2.len()) {
                                        ok = false;
                                    } else {
                                        for (var j: usize = 0; j < f1.len() && ok; j += 1) {
                                            const t1 = f1.get_const(j).unwrap();
                                            const t2 = f2.get_const(j).unwrap();

                                            switch (self->normalize_sema_type(t1->ty, loc, 0)) case .Some(ty1_n) else {
                                                ok = false;
                                                continue;
                                            }

                                            switch (self->normalize_sema_type(t2->ty, loc, 0)) case .Some(ty2_n) else {
                                                ok = false;
                                                continue;
                                            }

                                            const ty1 = env1->substitute_sema_type(&ty1_n);
                                            const ty2 = env2->substitute_sema_type(&ty2_n);

                                            if (!self->is_assignable_to(ty1, ty2, loc)) {
                                                ok = false;
                                            }
                                        }
                                    }
                                }
                                else => ok = false;
                            }
                        }

                        case .Struct { fields: f1, .. } => {
                            switch (*variant2) {
                                case .Struct { fields: f2, .. } => {

                                    for (var j: usize = 0; j < f2.len() && ok; j += 1) {
                                        const field2 = f2.get_const(j).unwrap();

                                        var found_index: usize = f1.len();
                                        var k: usize = 0;

                                        while (k < f1.len()) {
                                            const candidate = f1.get_const(k).unwrap();

                                            if (candidate->name.str.as_str_const() == field2->name.str.as_str_const()) {
                                                found_index = k;
                                                k = f1.len();
                                            } else {
                                                k += 1;
                                            }
                                        }

                                        if (found_index >= f1.len()) {
                                            ok = false;
                                        } else {
                                            const field1 = f1.get_const(found_index).unwrap();

                                            switch (self->normalize_sema_type(field1->ty, loc, 0)) {
                                                case .Some(ty1_n) => {
                                                    switch (self->normalize_sema_type(field2->ty, loc, 0)) {
                                                        case .None => ok = false;
                                                        case .Some(ty2_n) => {
                                                            const ty1 = env1->substitute_sema_type(&ty1_n);
                                                            const ty2 = env2->substitute_sema_type(&ty2_n);

                                                            if (!self->is_assignable_to(ty1, ty2, loc)) {
                                                                ok = false;
                                                            }
                                                        }
                                                    }
                                                }
                                                case .None => ok = false;
                                            }
                                        }
                                    }
                                }
                                else => ok = false;
                            }
                        }
                    }
                }
            }
        }

        return ok;
    }

    /* ************* Interface Object Coercion ************* */

    pub fn coerce_interface_as_interface_object_if_possible(
        self: Self*,
        ty: const cir::SemaType*,
        expr: const cir::TypedExpr*,
        loc: Span
    ) cir::SemaType {
        switch (expr->ty) {
            case .Some(expr_type) => {
                switch (expr_type.as_interface_object()) {
                    case .Some(interface_object) => {
                        return self->coerce_interface_object_recursively(ty, &interface_object, loc);
                    }
                    case .None => return *ty;
                }
            }
            case .None => return *ty;
        }
    }

    fn coerce_interface_object_recursively(
        self: Self*,
        ty: const cir::SemaType*,
        interface_object: const cir::InterfaceObjectType*,
        loc: Span
    ) cir::SemaType {
        switch (*ty) {
            case .Named(named_type) => {
                if (self->is_named_type_assignable_to(&named_type, &interface_object->interface_type, loc)) {
                    return .InterfaceObject(*interface_object);
                }
                return *ty;
            }

            case .Const(inner) => {
                const coerce = self->coerce_interface_object_recursively(inner, interface_object, loc);
                return .Const(alloc_init(self->allocator, coerce));
            }

            case .Pointer(inner) => {
                const coerce = self->coerce_interface_object_recursively(inner, interface_object, loc);
                return .Pointer(alloc_init(self->allocator, coerce));
            }

            case .Array(array_type) => {
                const element_type = self->coerce_interface_object_recursively(
                    array_type.element_type, 
                    interface_object, 
                    loc
                );

                return .Array(cir::TypedArrayType {
                    element_type: alloc_init(self->allocator, element_type),
                    capacity: array_type.capacity,
                    span: array_type.span,
                });
            }

            case .Tuple(tuple_type) => {
                var elements: Vec<cir::TypedTupleElement> = Vec.with_capacity(self->allocator, tuple_type.elements.len());

                for (var i: usize = 0; i < tuple_type.elements.len(); i += 1) {
                    const element = tuple_type.elements.get_const(i).unwrap();
                    const coerce = self->coerce_interface_object_recursively(&element->ty, interface_object, loc);
                    
                    elements.push(cir::TypedTupleElement {
                        ty: coerce,
                        span: element->span,
                    });
                }

                return .Tuple(cir::TypedTupleType {
                    elements,
                    span: tuple_type.span,
                });
            }

            case .FuncType(func_type) => {
                var params = cir::TypedFuncTypeParams {
                    list: Vec.with_capacity(self->allocator, func_type.params.list.len()),
                    variadic: .None,
                };

                for (var i: usize = 0; i < func_type.params.list.len(); i += 1) {
                    const param = func_type.params.list.get_const(i).unwrap();
                    const coerce = self->coerce_interface_object_recursively(param, interface_object, loc);
                    params.list.push(coerce);
                }

                switch (func_type.params.variadic) {
                    case .Some(variadic) => {
                        switch (*variadic) {
                            case .UntypedCStyle => {
                                params.variadic = .Some(alloc_init(
                                    self->allocator,
                                    cir::TypedFuncTypeVariadicParam.UntypedCStyle
                                ));
                            }
                            case .Typed(ty_inner) => {
                                const coerce = self->coerce_interface_object_recursively(&ty_inner, interface_object, loc);
                                params.variadic = .Some(alloc_init(
                                    self->allocator,
                                    cir::TypedFuncTypeVariadicParam.Typed(coerce)
                                ));
                            }
                        }
                    }
                    else => {}
                }

                const ret_type = self->coerce_interface_object_recursively(func_type.ret_type, interface_object, loc);

                return .FuncType(cir::TypedFuncType {
                    params,
                    ret_type: alloc_init(self->allocator, ret_type),
                    vis: func_type.vis,
                    callconv: func_type.callconv,
                    span: func_type.span,
                });
            }

            else => return *ty;
        }
    }

    fn is_const_str_assignable_to_array(
        self: Self*,
        value_type: const cir::TypedArrayType*,
        target_type: const cir::TypedArrayType*
    ) bool {
        switch (value_type->capacity) {
            case .Fixed(value_cap) => {
                switch (target_type->capacity) {
                    case .Fixed(target_cap) => {
                        const v = fold_const_expr_int(self->decl_tables, self->registry, value_cap);
                        const t = fold_const_expr_int(self->decl_tables, self->registry, target_cap);

                        switch (v) {
                            case .None => return false;
                            case .Some(vv) => {
                                switch (t) {
                                    case .None => return false;
                                    case .Some(tv) => return cir::integer_literal_eq(vv, tv);
                                }
                            }
                        }
                    }
                    case .Slice => return false;
                }
            }
            case .Slice => return false;
        }
    }

    /* ************* Expressions ************* */

    pub fn analyze_expr(
        self: Self*,
        expr: cir::TypedExpr*,
        expected_type: Option<cir::SemaType>
    ) Option<cir::SemaType> {
        switch (expr->kind) {
            case .Symbol(var symbol_expr) => {
                const decl_id = analyze_symbol_expr(self->registry, &symbol_expr);
                expr->kind = .Symbol(symbol_expr);

                switch (decl_id) {
                    case .Some(id) => {
                        if (!id.is_var_or_global_var() && !id.is_func()) {
                            var name = format::format_decl_name(self->allocator, self->decl_tables, &id);
                            diags::report_unknown_symbol(self->dctx, self->allocator, symbol_expr.span(), name.as_str_const());
                            name.free();
                            return .None;
                        }
                    }
                    else => {}
                }
            }
            case .SemaType { span, .. } => {
                diags::report_type_cannot_be_used_in_context(self->dctx, self->allocator, span);
                return .None;
            }
            else => {}
        }

        return self->analyze_expr_non_terminal(expr, expected_type);
    }

    pub fn analyze_expr_non_terminal(
        self: Self*,
        expr: cir::TypedExpr*,
        var expected_type: Option<cir::SemaType>
    ) Option<cir::SemaType> {
        switch (expected_type) {
            case .Some(ty) => {
                switch (self->normalize_sema_type(ty, expr->span, 0)) {
                    case .Some(normalized) => {
                        expected_type = .Some(self->expand_sema_type(normalized, expr->span));
                    }
                    else => {}
                }
            }
            else => {}
        }

        if (expr->analyzed) {
            return expr->ty;
        }

        expr->analyzed = true;

        self->lower_expr_pre_analysis(expr, expected_type);

        var expr_type: Option<cir::SemaType> = .None;

        switch (expr->kind) {
            case .Symbol(var sym) => {
                const decl_id_opt = analyze_symbol_expr(self->registry, &sym);
                expr->kind = .Symbol(sym);

                switch (decl_id_opt) {
                    case .Some(decl_id) => {
                        expr_type = self->resolve_symbol_type(decl_id, sym.span(), 0);
                    }
                    case .None => {
                        switch (sym.as_symbol_id()) {
                            case .Some(symbol_id) => {
                                switch (self->registry->symbol_name(symbol_id)) {
                                    case .Some(var name) => {
                                        diags::report_unknown_symbol(
                                            self->dctx, 
                                            self->allocator, 
                                            expr->span,
                                            name.as_str_const()
                                        );
                                        name.free();
                                    }
                                    case .None => {
                                        diags::report_unknown_symbol(
                                            self->dctx, 
                                            self->allocator, 
                                            expr->span,
                                            "UNKNOWN"
                                        );
                                    }
                                }
                            }
                            case .None => {
                                diags::report_unknown_symbol(
                                    self->dctx, 
                                    self->allocator, 
                                    expr->span,
                                    "UNKNOWN"
                                );
                            }
                        }
                    }
                }
            }
            
            case .Builtin(.BuiltinFunc(var bf)) => {
                expr_type = self->analyze_builtin_expr(&bf);
                expr->kind = .Builtin(.BuiltinFunc(bf));
            }
            
            case .Builtin(.BuiltinBlock(builtin_block)) => {
                diags::report_invalid_statement(self->dctx, self->allocator, builtin_block.span);
                return .None;
            }
            
            case .Literal(var lit) => {
                expr_type = self->analyze_literal(&lit, expected_type);
                expr->kind = .Literal(lit);
            }
            
            case .Prefix(var prefix) => {
                expr_type = self->analyze_prefix(&prefix, expected_type);
                expr->kind = .Prefix(prefix);
            }
            
            case .Infix(var infix) => {
                expr_type = self->analyze_infix(&infix, expected_type);
                expr->kind = .Infix(infix);
            }
            
            case .AddrOf(var addr_of) => {
                expr_type = self->analyze_addr_of(&addr_of);
                expr->kind = .AddrOf(addr_of);
            }
            
            case .Deref(var deref) => {
                expr_type = self->analyze_deref(&deref);
                expr->kind = .Deref(deref);
            }
            
            case .Array(var array) => {
                expr_type = self->analyze_array(&array, expected_type);
                expr->kind = .Array(array);
            }
            
            case .Dynamic(var dyn) => {
                expr_type = self->analyze_dynamic(&dyn, expected_type);
                expr->kind = .Dynamic(dyn);
            }
            
            case .MethodCall(var method_call) => {
                expr_type = self->analyze_method_call(&method_call, expected_type);
                expr->kind = .MethodCall(method_call);
            }
            
            case .FuncCall(var func_call) => {
                expr_type = self->analyze_func_call(&func_call);
                expr->kind = .FuncCall(func_call);
            }
            
            case .Lambda(var lambda) => {
                expr_type = self->analyze_lambda(&lambda);
                expr->kind = .Lambda(lambda);
            }
            
            case .Tuple(var tuple) => {
                expr_type = self->analyze_tuple_value(&tuple, expected_type);
                expr->kind = .Tuple(tuple);
            }
            
            case .EnumInit(var enum_init) => {
                expr_type = self->analyze_enum_init(&enum_init, expected_type);
                expr->kind = .EnumInit(enum_init);
            }
            
            case .StructInit(var struct_init) => {
                expr_type = self->analyze_struct_init(&struct_init, expected_type);
                expr->kind = .StructInit(struct_init);
            }
            
            case .UnionInit(var union_init) => {
                expr_type = self->analyze_union_init(&union_init, expected_type);
                expr->kind = .UnionInit(union_init);
            }
            
            case .UnnamedStructValue(var struct_value) => {
                expr_type = self->analyze_unnamed_struct_value(&struct_value, expected_type);
                expr->kind = .UnnamedStructValue(struct_value);
            }
            
            case .UnnamedUnionValue(var union_value) => {
                expr_type = self->analyze_unnamed_union_value(&union_value, expected_type);
                expr->kind = .UnnamedUnionValue(union_value);
            }
            
            case .UnnamedEnumValue(var enum_value) => {
                expr_type = self->analyze_unnamed_enum_value(&enum_value, expected_type);
                expr->kind = .UnnamedEnumValue(enum_value);
            }
            
            case .EnumStructVariantInit(var struct_variant_init) => {
                expr_type = self->analyze_enum_struct_variant_init(&struct_variant_init);
                expr->kind = .EnumStructVariantInit(struct_variant_init);
            }
            
            case .Assign(var assign) => {
                self->analyze_assign(&assign);
                expr_type = assign.rhs->ty;
                expr->kind = .Assign(assign);
            }
            
            case .ArrayIndex(var array_index) => {
                expr_type = self->analyze_array_index(&array_index);
                expr->kind = .ArrayIndex(array_index);
            }
            
            case .FieldAccess(var field_access) => {
                expr_type = self->analyze_field_access(&field_access);
                expr->kind = .FieldAccess(field_access);
            }
            
            case .TupleAccess(var tuple_access) => {
                expr_type = self->analyze_tuple_access(&tuple_access, expected_type);
                expr->kind = .TupleAccess(tuple_access);
            }
            
            case .InlineAsm(var inline_asm) => {
                expr_type = self->analyze_inline_asm_expr(&inline_asm);
                expr->kind = .InlineAsm(inline_asm);
            }
            
            case .SemaType { ty, .. } => {
                const normalized = self->normalize_sema_type(ty, expr->span, 0);
                expr->ty = normalized;
                return normalized;
            }
            
            case .Poisoned => {
                const err_ty: cir::SemaType = .Err(expr->span);
                expr->ty = .Some(err_ty);
                return .Some(err_ty);
            }
        }

        switch (expr_type) {
            case .Some(et) => {
                if (et.contains_error()) {
                    expr->ty = .Some(et);
                    return .Some(et);
                }

                switch (self->normalize_and_check_type_formation(et, expr->span, 0)) {
                    case .Some(normalized_type) => {
                        expr->ty = .Some(normalized_type);

                        switch (self->func_env.infer) {
                            case .Some(infer_ctx) => {
                                expr->ty = .Some(infer_ctx->resolve(&normalized_type));
                            }
                            else => {}
                        }

                        fold_const_expr(self->decl_tables, self->registry, expr);
                        self->lower_expr_post_analysis(expr);
                        expr->val_cat = self->value_category_of_expr(expr);

                        return .Some(normalized_type);
                    }
                    case .None => {
                        if (self->dctx->has_errors()) {
                            const err_ty: cir::SemaType = .Err(expr->span);
                            expr->ty = .Some(err_ty);
                            return .Some(err_ty);
                        }
                    }
                }
            }
            case .None => {
                if (self->dctx->has_errors()) {
                    const err_ty: cir::SemaType = .Err(expr->span);
                    expr->ty = .Some(err_ty);
                    return .Some(err_ty);
                }
            }
        }

        return .None;
    }

    pub fn value_category_of_expr(self: const Self*, expr: const cir::TypedExpr*) cir::ValueCategory {
        switch (expr->kind) {
            case .Symbol(symbol_expr) => {
                switch (symbol_expr.as_decl_id()) {
                    case .Some(decl_id) => {
                        const is_const = is_decl_const(self->decl_tables, decl_id);
                        
                        var mutability: ast::ASTConstness = .Var;

                        if (is_const) {
                            mutability = .Const;
                        }

                        if (decl_id.is_var_or_global_var()) {
                            return .LValue(mutability);
                        } else {
                            return .Type;
                        }
                    }
                    case .None => return .Unknown;
                }
            }
            
            case .Deref(deref) => {
                var mutability: ast::ASTConstness = .Var;
                
                switch (deref.operand->ty) {
                    case .Some(ty) => {
                        if (ty.is_const()) {
                            mutability = .Const;
                        }
                    }
                    else => {}
                }
                
                return .LValue(mutability);
            }
            
            case .FieldAccess(field_access) => {
                if (field_access.is_thin_arrow) {
                    switch (field_access.operand->ty) {
                        case .Some(ty) => {
                            if (ty.pointer_inner()->is_const()) {
                                return .LValue(.Const);
                            } else {
                                return .LValue(.Var);
                            }
                        }
                        else => {}
                    }
                }

                return field_access.operand->val_cat;
            }
            
            case .TupleAccess(tuple_access) => return tuple_access.operand->val_cat;
            
            case .ArrayIndex(array_index) => return array_index.operand->val_cat;

            case .Builtin => return .RValue;

            case .AddrOf => return .RValue;

            case .Assign
            | .Lambda
            | .Array
            | .Tuple
            | .Dynamic
            | .EnumInit
            | .StructInit
            | .UnionInit
            | .FuncCall
            | .MethodCall
            | .Literal
            | .Prefix
            | .Infix => return .RValue;
            
            case .SemaType 
            | .Poisoned
            | .InlineAsm
            | .EnumStructVariantInit
            | .UnnamedStructValue
            | .UnnamedUnionValue
            | .UnnamedEnumValue => return .Unknown;
        }
    }

    pub fn analyze_cond_expr(self: Self*, cond: cir::TypedExpr*) {
        switch (self->analyze_expr(cond, .Some(.Plain(.Bool)))) {
            case .Some(ty) => {
                var expand = self->expand_sema_type(ty, cond->span);

                if (expand.contains_error()) {
                    return;
                }

                if (!(expand.is_bool() || expand.is_integer() || expand.is_pointer())) {
                    diags::report_condition_must_be_bool(self->dctx, self->allocator, cond->span);
                }

                if (expand.is_pointer()) {
                    switch (lower_cond_pointer_as_null_check(self->allocator, cond)) {
                        case .Some(lowered) => *cond = lowered;
                        else => {}
                    }
                } else {
                    cond->ty = .Some(expand);
                }
            }
            else => {}
        }
    }

    pub fn analyze_field_assign(
        self: Self*,
        field_expr: cir::TypedExpr*,
        var expected_type: cir::SemaType,
        loc: Span
    ) {
        switch (self->normalize_sema_type(expected_type, loc, 0)) {
            case .Some(ty) => expected_type = ty;
            case .None => return;
        }

        expected_type = self->substitute_type(&expected_type);

        switch (self->analyze_expr(field_expr, .Some(expected_type))) {
            case .Some(value_type) => {
                var v_ty = self->substitute_type(&value_type);

                switch (self->func_env.infer) {
                    case .Some(infer) => {
                        infer->unify(&expected_type, &v_ty);
                        expected_type = infer->resolve(&expected_type);
                        v_ty = infer->resolve(&v_ty);
                    }
                    else => {}
                }
                expected_type = self->substitute_type(&expected_type);

                if (!self->is_assignable_to(v_ty, expected_type, loc)) {
                    var lhs_str = format::format_sema_type(self->allocator, self->decl_tables, &expected_type);
                    var rhs_str = format::format_sema_type(self->allocator, self->decl_tables, &v_ty);

                    diags::report_assignment_type_mismatch(
                        self->dctx, 
                        self->allocator, 
                        loc, 
                        lhs_str.as_str_const(), 
                        rhs_str.as_str_const()
                    );

                    lhs_str.free();
                    rhs_str.free();
                }
            }
            else => {}
        }
    }

    pub fn lower_expr_pre_analysis(self: Self*, typed_expr: cir::TypedExpr*, expected_type: Option<cir::SemaType>) {
        switch (typed_expr->kind) {
            case .Assign(assign) => {
                if (assign.kind != .Default) {
                    typed_expr->kind = lower_assign_to_infix_expr(self->allocator, &assign);
                }
            }
            case .Prefix(var prefix) => {
                switch (prefix.op) {
                    case .Bang => {
                        switch (self->analyze_expr(prefix.operand, expected_type)) {
                            case .Some(operand_type) => {
                                switch (lower_prefix_not_pointer(self->allocator, operand_type, &prefix)) {
                                    case .Some(lowered) => *typed_expr = lowered;
                                    case .None => {}
                                }
                            }
                            case .None => {}
                        }
                    }
                    else => {}
                }
            }
            case .UnnamedStructValue(struct_val) => {
                for (var i: usize = 0; i < struct_val.fields.len(); i += 1) {
                    const field = struct_val.fields.get(i).unwrap();
                    self->analyze_expr_non_terminal(field->value, .None);
                }

                switch (lower_unnamed_struct_value_as_unnamed_struct_type(
                    self->dctx,
                    self->allocator,
                    self->decl_tables,
                    struct_val
                )) {
                    case .Some(new_expr) => *typed_expr = new_expr;
                    case .None => {}
                }
            }
            case .UnnamedUnionValue(union_val) => {
                for (var i: usize = 0; i < union_val.fields.len(); i += 1) {
                    const field = union_val.fields.get(i).unwrap();
                    self->analyze_expr_non_terminal(field->value, .None);
                }

                switch (lower_unnamed_union_value_as_unnamed_union_type(
                    self->dctx,
                    self->allocator,
                    self->decl_tables,
                    union_val
                )) {
                    case .Some(new_expr) => *typed_expr = new_expr;
                    case .None => {}
                }
            }
            else => {
                switch (typed_expr->kind) {
                    case .FieldAccess(field_access) => {
                        if (!field_access.is_thin_arrow) {
                            switch (self->extract_enum_decl_id_of_expr_kind(
                                &field_access.operand->kind,
                                typed_expr->span
                            )) {
                                case .Some(info) => {
                                    lower_field_access_as_enum_init(
                                        self->dctx,
                                        self->allocator,
                                        self->decl_tables,
                                        typed_expr,
                                        info
                                    );
                                }
                                case .None => {}
                            }
                        }
                    }
                    case .MethodCall(method_call) => {
                        if (!method_call.is_thin_arrow) {
                            switch (self->extract_enum_decl_id_of_expr_kind(
                                &method_call.operand->kind,
                                method_call.span
                            )) {
                                case .Some(info) => {
                                    lower_method_call_as_enum_init(
                                        self->dctx,
                                        self->allocator,
                                        self->decl_tables,
                                        typed_expr,
                                        info
                                    );
                                }
                                case .None => {}
                            }
                        }
                    }
                    case .StructInit(struct_init) => {
                        switch (self->normalize_sema_type(struct_init.operand, struct_init.span, 0)) {
                            case .Some(normalized) => {
                                const expand = self->expand_sema_type(normalized, struct_init.span);

                                switch (expand.as_union()) {
                                    case .Some => {
                                        lower_struct_init_as_union_init(
                                            self->dctx,
                                            self->allocator,
                                            typed_expr,
                                            expand
                                        );
                                    }
                                    case .None => {}
                                }
                            }
                            case .None => {}
                        }
                    }
                    else => {}
                }
            }
        }
    }

    pub fn lower_expr_post_analysis(self: Self*, typed_expr: cir::TypedExpr*) {
        lower_unnamed_union_value_as_union_init(self->dctx, self->allocator, typed_expr);
        lower_unnamed_struct_value_as_struct_init(self->allocator, typed_expr);
        lower_enum_struct_variant_init_as_enum_init(typed_expr);
        lower_unnamed_enum_value_as_enum_init(typed_expr);
    }

    fn extract_enum_decl_id_of_expr_kind(
        self: Self*,
        expr_kind: const cir::TypedExprKind*,
        loc: Span
    ) Option<EnumDeclRef> {
        switch (*expr_kind) {
            case .Symbol(symbol_expr) => {
                switch (analyze_symbol_expr_readonly(self->registry, &symbol_expr)) case .Some(decl_id) else {
                    return .None;
                }

                switch (decl_id.as_enum()) case .Some(enum_decl_id) else {
                    switch (decl_id_as_type_decl_id(decl_id)) case .Some(type_decl_id) else {
                        return .None;
                    }

                    const type_args = cir::TypedTypeArgs.new(self->allocator);

                    const named: cir::SemaType = .Named(cir::NamedType {
                        type_decl_id,
                        type_args,
                    });

                    switch (self->normalize_sema_type(named, loc, 0)) case .Some(ty) else {
                        return .None;
                    }

                    const expand = self->expand_sema_type(ty, loc);

                    switch (expand.as_enum()) case .Some(aliased_enum_id) else {
                        return .None;
                    }

                    return .Some(EnumDeclRef {
                        enum_decl_id: aliased_enum_id,
                        type_args: cir::TypedTypeArgs.new(self->allocator),
                    });
                }

                return .Some(EnumDeclRef {
                    enum_decl_id,
                    type_args: cir::TypedTypeArgs.new(self->allocator),
                });
            }

            case .SemaType { ty, .. } => {
                switch (self->normalize_sema_type(ty, loc, 0)) case .Some(normalized) else {
                    return .None;
                }

                const expand = self->expand_sema_type(normalized, loc);

                switch (expand.as_named_type()) case .Some(named_type) else {
                    return .None;
                }

                switch (named_type.type_decl_id.as_enum()) case .Some(enum_decl_id) else {
                    return .None;
                }

                return .Some(EnumDeclRef {
                    enum_decl_id,
                    type_args: named_type.type_args,
                });
            }

            else => return .None;
        }
    }

    pub fn analyze_literal(
        self: Self*,
        literal: cir::TypedLiteralExpr*,
        expected_type: Option<cir::SemaType>
    ) Option<cir::SemaType> {
        const span = literal->span;

        var type_opt: Option<cir::SemaType> = .None;
        var kind = literal->kind;

        switch (kind) {
            case .Integer { suffix, .. } => {
                switch (suffix) {
                    case .Some(sfx) => {
                        switch (integer_suffix_to_sema_type(sfx)) {
                            case .Some(ty) => {
                                type_opt = .Some(ty);
                            }
                            case .None => {
                                diags::report_invalid_integer_literal_suffix(
                                    self->dctx,
                                    self->allocator,
                                    span,
                                    sfx.to_str()
                                );
                            }
                        }
                    }
                    case .None => {
                        switch (expected_type) {
                            case .Some(ty) => {
                                if (ty.is_integer()) {
                                    type_opt = .Some(ty);
                                } else {
                                    type_opt = .Some(.Plain(.Int32));
                                }
                            }
                            case .None => {
                                type_opt = .Some(.Plain(.Int32));
                            }
                        }
                    }
                }
            }

            case .Float { suffix, .. } => {
                switch (suffix) {
                    case .Some(sfx) => {
                        switch (float_suffix_to_sema_type(sfx)) {
                            case .Some(ty) => {
                                type_opt = .Some(ty);
                            }
                            case .None => {
                                diags::report_invalid_float_literal_suffix(
                                    self->dctx,
                                    self->allocator,
                                    span,
                                    sfx.to_str()
                                );
                            }
                        }
                    }
                    case .None => {
                        switch (expected_type) {
                            case .Some(ty) => {
                                if (ty.is_float()) {
                                    type_opt = .Some(ty);
                                } else {
                                    type_opt = .Some(.Plain(.Float64));
                                }
                            }
                            case .None => type_opt = .Some(.Plain(.Float64));
                        }
                    }
                }
            }

            case .String { value, suffix } => {
                const uint8_type: cir::SemaType = cir::SemaType.Plain(.UInt8);
                const const_uint8_type: cir::SemaType = .Const(alloc_init(self->allocator, uint8_type));

                switch (suffix) {
                    case .Some(prefix) => {
                        switch (prefix) {
                            case .Byte => {
                                const capacity_expr = cir::const_untyped_integer_expr(
                                    @cast(uint128, value.len()),
                                    span
                                );

                                type_opt = .Some(.Array(cir::TypedArrayType {
                                    element_type: alloc_init(self->allocator, const_uint8_type),
                                    capacity: .Fixed(alloc_init(self->allocator, capacity_expr)),
                                    span,
                                }));
                            }
                        }
                    }
                    case .None => {
                        type_opt = .Some(.Pointer(alloc_init(self->allocator, uint8_type)));
                    }
                }
            }

            case .Char => type_opt = .Some(.Plain(.UInt8));
            case .Bool => type_opt = .Some(.Plain(.Bool));
            case .Null => type_opt = .Some(.Plain(.Null));
        }

        literal->kind = kind;

        switch (type_opt) {
            case .Some(ty) => literal->ty = .Some(ty);
            else => {}
        }

        return type_opt;
    }

    pub fn analyze_tuple_value(
        self: Self*,
        tuple_value: cir::TypedTupleExpr*,
        expected_type: Option<cir::SemaType>
    ) Option<cir::SemaType> {
        var elements: Vec<cir::TypedTupleElement> = Vec.new(self->allocator);
        var tuple_type_opt: Option<cir::TypedTupleType> = .None;

        switch (expected_type) {
            case .Some(ty) => tuple_type_opt = ty.as_tuple_type();
            else => {}
        }

        for (var i: usize = 0; i < tuple_value->elements.len(); i += 1) {
            const element = tuple_value->elements.get(i).unwrap();

            var expect: Option<cir::SemaType> = .None;

            switch (tuple_type_opt) {
                case .Some(tt) => {
                    if (i < tt.elements.len()) {
                        expect = .Some(tt.elements.get_const(i).unwrap()->ty);
                    }
                }
                else => {}
            }

            switch (self->analyze_expr(element, expect)) {
                case .Some(ty) => {
                    elements.push(cir::TypedTupleElement {
                        ty,
                        span: element->span,
                    });
                }
                else => {}
            }
        }

        return .Some(.Tuple(cir::TypedTupleType {
            elements,
            span: tuple_value->span,
        }));
    }

    pub fn analyze_tuple_access(
        self: Self*,
        member_access: cir::TypedTupleAccessExpr*,
        expected_type: Option<cir::SemaType>
    ) Option<cir::SemaType> {
        var operand_type: cir::SemaType = .Placeholder;

        switch (self->analyze_expr(member_access->operand, expected_type)) {
            case .Some(ty) => operand_type = ty;
            case .None => return .None;
        }

        operand_type = self->expand_sema_type(operand_type, member_access->span);

        if (operand_type.contains_error()) {
            return .Some(.Err(member_access->span));
        }

        if (operand_type.const_inner()->as_tuple_type().is_none()) {
            diags::report_tuple_member_access_on_non_tuple_operand(
                self->dctx,
                self->allocator,
                member_access->span
            );
            return .None;
        }

        const tuple_type = operand_type.as_tuple_type().unwrap();

        if (tuple_type.elements.len() == 0) {
            diags::report_member_access_on_empty_tuple(
                self->dctx,
                self->allocator,
                member_access->span
            );
            return .None;
        }

        if (member_access->index > (tuple_type.elements.len() - 1)) {
            diags::report_tuple_index_out_of_range(
                self->dctx,
                self->allocator,
                member_access->span,
                member_access->index,
                tuple_type.elements.len()
            );
            return .None;
        }

        return .Some(tuple_type.elements.get_const(member_access->index).unwrap()->ty);
    }

    pub fn is_const_qualified_lvalue(self: Self*, expr: const cir::TypedExpr*) bool {
        if (expr->val_cat.is_const_lvalue()) {
            return true;
        }

        switch (expr->ty) {
            case .Some(ty) => {
                if (ty.is_const()) {
                    return true;
                }
            }
            else => {}
        }

        return false;
    }

    pub fn analyze_assign(self: Self*, assign: cir::TypedAssignExpr*) {
        switch (self->analyze_expr(assign->lhs, .None)) {
            case .Some(lhs_type) => {
                switch (self->analyze_expr(assign->rhs, .Some(lhs_type))) {
                    case .Some(rhs_type) => {
                        const lhs_is_poisoned = lhs_type.contains_error();

                        if (self->is_const_qualified_lvalue(assign->lhs)) {
                            diags::report_cannot_assign_to_const_lvalue(
                                self->dctx,
                                self->allocator,
                                assign->span
                            );
                        }

                        if (!self->is_assignable_to(rhs_type, lhs_type, assign->span)) {
                            var lhs_str = format::format_sema_type(
                                self->allocator,
                                self->decl_tables,
                                &lhs_type
                            );
                            var rhs_str = format::format_sema_type(
                                self->allocator,
                                self->decl_tables,
                                &rhs_type
                            );

                            diags::report_assignment_type_mismatch(
                                self->dctx,
                                self->allocator,
                                assign->span,
                                lhs_str.as_str_const(),
                                rhs_str.as_str_const()
                            );

                            lhs_str.free();
                            rhs_str.free();
                        }

                        if (!assign->lhs->is_lvalue() && !lhs_is_poisoned) {
                            diags::report_cannot_assign_to_non_value(
                                self->dctx,
                                self->allocator,
                                assign->span
                            );
                        }
                    }
                    else => {}
                }
            }
            else => {}
        }
    }

    pub fn analyze_addr_of(self: Self*, addr_of: cir::TypedAddrOfExpr*) Option<cir::SemaType> {
        const expected_type = addr_of->operand->ty;

        var operand_type: cir::SemaType = .Placeholder;

        switch (self->analyze_expr(addr_of->operand, expected_type)) {
            case .Some(ty) => operand_type = *ty.const_inner();
            case .None => return .None;
        }

        if (operand_type.contains_error()) {
            return .Some(.Err(addr_of->span));
        }

        if (!addr_of->operand->is_lvalue()) {
            diags::report_address_of_rvalue(self->dctx, self->allocator, addr_of->span);
            return .None;
        }

        if (addr_of->operand->val_cat.is_const_lvalue()) {
            switch (operand_type) {
                case .Pointer(pointee) => {
                    var inner: cir::SemaType = *pointee;

                    if (!inner.is_const()) {
                        inner = .Const(alloc_init(self->allocator, inner));
                    }

                    operand_type = .Pointer(alloc_init(self->allocator, inner));
                }
                else => {
                    if (!operand_type.is_const()) {
                        operand_type = .Const(alloc_init(self->allocator, operand_type));
                    }
                }
            }
        }

        return .Some(.Pointer(alloc_init(self->allocator, operand_type)));
    }

    pub fn analyze_deref(self: Self*, deref: cir::TypedDerefExpr*) Option<cir::SemaType> {
        const expected_type = deref->operand->ty;

        var operand_type: cir::SemaType = .Placeholder;

        switch (self->analyze_expr(deref->operand, expected_type)) {
            case .Some(ty) => operand_type = *ty.const_inner();
            case .None => return .None;
        }

        deref->operand->ty = .Some(operand_type);

        if (operand_type.contains_error()) {
            return .Some(.Err(deref->span));
        }

        if ((!deref->operand->is_lvalue() 
            || operand_type.as_func_type().is_some())
            && !operand_type.is_pointer())
        {
            diags::report_deref_non_pointer_value(self->dctx, self->allocator, deref->span);
            return .None;
        }

        switch (operand_type) {
            case .Pointer(inner) => {
                if (inner->is_void()) {
                    diags::report_deref_void_pointer_value(self->dctx, self->allocator, deref->span);
                    return .None;
                }
                return .Some(*inner);
            }
            else => {
                diags::report_deref_non_pointer_value(self->dctx, self->allocator, deref->span);
                return .None;
            }
        }
    }

    pub fn analyze_prefix(
        self: Self*,
        prefix: cir::TypedPrefixExpr*,
        expected_type: Option<cir::SemaType>
    ) Option<cir::SemaType> {
        var operand_type: cir::SemaType = .Placeholder;

        switch (self->analyze_expr(prefix->operand, expected_type)) {
            case .Some(ty) => operand_type = *ty.const_inner();
            case .None => return .Some(.Err(prefix->span));
        }

        if (operand_type.contains_error()) {
            return .Some(.Err(prefix->span));
        }

        operand_type = self->expand_sema_type(operand_type, prefix->span);

        switch (prefix->op) {
            case .BitwiseNot => {
                switch (operand_type) {
                    case .Plain(pt) => {
                        if (pt.is_integer()) {
                            return .Some(.Plain(pt));
                        }
                    }
                    else => {}
                }

                var type_str = format::format_sema_type(
                    self->allocator,
                    self->decl_tables,
                    &operand_type
                );
                defer type_str.free();
                diags::report_prefix_minus_on_non_integer(
                    self->dctx,
                    self->allocator,
                    prefix->span,
                    type_str.as_str_const()
                );
                return .None;
            }

            case .Bang => {
                switch (operand_type) {
                    case .Plain(plain) => {
                        if (plain.is_integer_or_bool()) {
                            return .Some(.Plain(plain));
                        }
                    }
                    else => {}
                }

                var type_str = format::format_sema_type(
                    self->allocator,
                    self->decl_tables,
                    &operand_type
                );
                defer type_str.free();
                diags::report_prefix_bang_on_non_bool(
                    self->dctx,
                    self->allocator,
                    prefix->span,
                    type_str.as_str_const()
                );
                return .None;
            }

            case .Minus => {
                switch (operand_type) {
                    case .Plain(pt) => {
                        if (pt.is_integer()) {
                            if (!pt.is_signed()) {
                                diags::report_unary_minus_on_unsigned_integer(
                                    self->dctx,
                                    self->allocator,
                                    prefix->span
                                );
                                return .None;
                            }
                            return .Some(.Plain(pt));
                        } else if (pt.is_float()) {
                            return .Some(.Plain(pt));
                        }
                    }
                    else => {}
                }

                var type_str = format::format_sema_type(
                    self->allocator,
                    self->decl_tables,
                    &operand_type
                );
                defer type_str.free();
                diags::report_prefix_minus_on_non_integer(
                    self->dctx,
                    self->allocator,
                    prefix->span,
                    type_str.as_str_const()
                );
                return .None;
            }
        }
    }

    fn is_type_comparable(
        self: Self*,
        rhs_type: cir::SemaType,
        lhs_type: cir::SemaType,
        loc: Span
    ) bool {
        const lhs = self->expand_sema_type(lhs_type, loc);
        const rhs = self->expand_sema_type(rhs_type, loc);

        switch (rhs) {
            case .Pointer(inner_rhs) => {
                switch (lhs) {
                    case .Pointer(inner_lhs) => {
                        if (inner_rhs->is_void() || inner_lhs->is_void()) {
                            return true;
                        }

                        return self->is_assignable_to(*inner_rhs, *inner_lhs, loc);
                    }
                    else => {}
                }
            }
            else => {}
        }

        return self->is_assignable_to(rhs, lhs, loc);
    }

    fn analyze_arithmetic_expr(
        self: Self*,
        lhs_type: cir::SemaType,
        rhs_type: cir::SemaType,
        loc: Span
    ) Option<cir::SemaType> {
        const lhs = *lhs_type.const_inner();
        const rhs = *rhs_type.const_inner();

        if (!self->is_type_comparable(rhs, lhs, loc)) {
            diags::report_infix_invalid(
                self->dctx,
                self->allocator, 
                self->decl_tables, 
                lhs, 
                rhs, 
                loc, 
                true
            );
            return .None;
        }

        if ((lhs.is_integer() && rhs.is_integer()) || (lhs.is_float() && rhs.is_float())) {
            switch (lhs.as_plain_type()) {
                case .Some(p1) => {
                    switch (rhs.as_plain_type()) {
                        case .Some(p2) => {
                            switch (cir::PlainType.widen_type(p1, p2)) {
                                case .Some(widen) => return .Some(.Plain(widen));
                                else => {}
                            }
                        }
                        else => {}
                    }
                }
                else => {}
            }
        }

        diags::report_infix_invalid(
            self->dctx,
            self->allocator, 
            self->decl_tables, 
            lhs, 
            rhs, 
            loc, 
            false
        );
        return .None;
    }

    fn analyze_compare_expr(
        self: Self*,
        lhs_type: cir::SemaType,
        rhs_type: cir::SemaType,
        cmp_eq: bool,
        loc: Span
    ) Option<cir::SemaType> {
        const lhs = *lhs_type.const_inner();
        const rhs = *rhs_type.const_inner();

        if (lhs.is_enum() && rhs.is_enum()) {
            return .Some(.Plain(.Bool));
        }

        if (!self->is_type_comparable(rhs, lhs, loc)) {
            diags::report_infix_invalid(self->dctx, self->allocator, self->decl_tables, lhs, rhs, loc, false);
            return .None;
        }

        if ((lhs.is_integer() && rhs.is_integer()) || (lhs.is_float() && rhs.is_float())) {
            return .Some(.Plain(.Bool));
        }

        if (cmp_eq) {
            if (lhs.is_pointer() && rhs.is_pointer()) {
                return .Some(.Plain(.Bool));
            }
            if (lhs.is_pointer() && rhs.is_plain_null()) {
                return .Some(.Plain(.Bool));
            }
            if (lhs.is_bool() && rhs.is_bool()) {
                return .Some(.Plain(.Bool));
            }
            if (lhs.as_plain_type().is_some() && rhs.as_plain_type().is_some()) {
                return .Some(.Plain(.Bool));
            }
        }

        diags::report_infix_invalid(self->dctx, self->allocator, self->decl_tables, lhs, rhs, loc, false);
        return .None;
    }

    fn analyze_or_expr(
        self: Self*,
        lhs_type: cir::SemaType,
        rhs_type: cir::SemaType,
        loc: Span
    ) Option<cir::SemaType> {
        const lhs = *lhs_type.const_inner();
        const rhs = *rhs_type.const_inner();

        if (!self->is_type_comparable(rhs, lhs, loc)) {
            diags::report_infix_invalid(self->dctx, self->allocator, self->decl_tables, lhs, rhs, loc, true);
            return .None;
        }

        if (lhs.is_bool() && rhs.is_bool()) {
            return .Some(.Plain(.Bool));
        }

        diags::report_infix_invalid(self->dctx, self->allocator, self->decl_tables, lhs, rhs, loc, false);
        return .None;
    }

    fn analyze_and_expr(
        self: Self*,
        lhs_type: cir::SemaType,
        rhs_type: cir::SemaType,
        loc: Span
    ) Option<cir::SemaType> {
        const lhs = *lhs_type.const_inner();
        const rhs = *rhs_type.const_inner();

        if (!self->is_type_comparable(rhs, lhs, loc)) {
            diags::report_infix_invalid(self->dctx, self->allocator, self->decl_tables, lhs, rhs, loc, true);
            return .None;
        }

        if (lhs.is_bool() && rhs.is_bool()) {
            return .Some(.Plain(.Bool));
        }

        diags::report_infix_invalid(self->dctx, self->allocator, self->decl_tables, lhs, rhs, loc, false);
        return .None;
    }

    fn analyze_bitwise_expr(
        self: Self*,
        lhs_type: cir::SemaType,
        rhs_type: cir::SemaType,
        loc: Span
    ) Option<cir::SemaType> {
        const lhs = *lhs_type.const_inner();
        const rhs = *rhs_type.const_inner();

        if (!self->is_type_comparable(rhs, lhs, loc)) {
            diags::report_infix_invalid(self->dctx, self->allocator, self->decl_tables, lhs, rhs, loc, true);
            return .None;
        }

        switch (lhs.as_plain_type()) {
            case .Some(p1) => {
                switch (rhs.as_plain_type()) {
                    case .Some(p2) => {
                        if (p1.is_integer() && p2.is_integer()) {
                            switch (cir::PlainType.widen_type(p1, p2)) {
                                case .Some(widen) => return .Some(.Plain(widen));
                                else => {}
                            }
                        }
                    }
                    else => {}
                }
            }
            else => {}
        }

        diags::report_infix_invalid(self->dctx, self->allocator, self->decl_tables, lhs, rhs, loc, false);
        return .None;
    }

    fn analyze_right_shift_expr(
        self: Self*,
        lhs_type: cir::SemaType,
        rhs_type: cir::SemaType,
        loc: Span
    ) Option<cir::SemaType> {
        const lhs = *lhs_type.const_inner();
        const rhs = *rhs_type.const_inner();

        if (!self->is_type_comparable(rhs, lhs, loc)) {
            diags::report_infix_invalid(self->dctx, self->allocator, self->decl_tables, lhs, rhs, loc, true);
            return .None;
        }

        switch (lhs.as_plain_type()) {
            case .Some(p1) => {
                switch (rhs.as_plain_type()) {
                    case .Some(p2) => {
                        if (p2.is_signed()) {
                            diags::report_rhs_of_shift_must_be_unsigned_integer(
                                self->dctx,
                                self->allocator,
                                loc
                            );
                        } else if (p1.is_integer() && p2.is_integer()) {
                            switch (cir::PlainType.widen_type(p1, p2)) {
                                case .Some(widen) => return .Some(.Plain(widen));
                                else => {}
                            }
                        }
                    }
                    else => {}
                }
            }
            else => {}
        }

        diags::report_infix_invalid(self->dctx, self->allocator, self->decl_tables, lhs, rhs, loc, false);
        return .None;
    }

    pub fn analyze_infix(
        self: Self*,
        infix: cir::TypedInfixExpr*,
        expected_type: Option<cir::SemaType>
    ) Option<cir::SemaType> {
        var lhs_type: cir::SemaType = .Placeholder;
        var rhs_type: cir::SemaType = .Placeholder;

        switch (self->analyze_expr(infix->lhs, expected_type)) {
            case .Some(ty) => lhs_type = *ty.const_inner();
            case .None => return .Some(.Err(infix->span));
        }

        switch (self->analyze_expr(infix->rhs, .Some(lhs_type))) {
            case .Some(ty) => rhs_type = *ty.const_inner();
            case .None => return .Some(.Err(infix->span));
        }

        if (lhs_type.contains_error() || rhs_type.contains_error()) {
            return .Some(.Err(infix->span));
        }

        lhs_type = self->expand_sema_type(lhs_type, infix->span);
        rhs_type = self->expand_sema_type(rhs_type, infix->span);

        switch (infix->op) {
            case .Mul | .Div | .Rem => {
                return self->analyze_arithmetic_expr(lhs_type, rhs_type, infix->span);
            }

            case .Add => {
                switch (pointer_arithmetic_type(&lhs_type, &rhs_type, true)) {
                    case .Some(ty) => return .Some(ty);
                    else => {}
                }
                return self->analyze_arithmetic_expr(lhs_type, rhs_type, infix->span);
            }
            
            case .Sub => {
                switch (pointer_arithmetic_type(&lhs_type, &rhs_type, false)) {
                    case .Some(ty) => return .Some(ty);
                    else => {}
                }
                return self->analyze_arithmetic_expr(lhs_type, rhs_type, infix->span);
            }
            
            case .Equal | .NotEqual => {
                return self->analyze_compare_expr(lhs_type, rhs_type, true, infix->span);
            }
            
            case .BitwiseAnd | .BitwiseOr | .BitwiseXor | .BitwiseAndNot => {
                return self->analyze_bitwise_expr(lhs_type, rhs_type, infix->span);
            }
            
            case .ShiftLeft => {
                return self->analyze_bitwise_expr(lhs_type, rhs_type, infix->span);
            }
            
            case .ShiftRight => {
                return self->analyze_right_shift_expr(lhs_type, rhs_type, infix->span);
            }

            case .LessThan 
            | .LessEqual 
            | .GreaterThan 
            | .GreaterEqual => {
                return self->analyze_compare_expr(lhs_type, rhs_type, false, infix->span);
            }

            case .Or => return self->analyze_or_expr(lhs_type, rhs_type, infix->span);
            
            case .And => return self->analyze_and_expr(lhs_type, rhs_type, infix->span);
            
            case .NullCoalesce => return null_coalesce_type(lhs_type, rhs_type);
        }
    }

    pub fn analyze_lambda(self: Self*, lambda: cir::TypedLambdaExpr*) Option<cir::SemaType> {
        self->normalize_func_params(&lambda->params, true, 0);

        const params = func_params_as_type_params(self->allocator, &lambda->params);

        switch (self->normalize_and_check_type_formation(lambda->ret_type, lambda->span, 0)) {
            case .Some(ret_type) => lambda->ret_type = ret_type;
            case .None => return .None;
        }

        var func_type = cir::TypedFuncType {
            params,
            ret_type: alloc_init(self->allocator, lambda->ret_type),
            vis: .Public,
            callconv: .C,
            span: lambda->span,
        };

        const expand = self->expand_sema_type(.FuncType(func_type), lambda->span);

        switch (expand.as_func_type()) {
            case .Some(ft) => func_type = ft;
            case .None => return .None;
        }

        return .Some(.FuncType(func_type));
    }

    pub fn analyze_array(
        self: Self*,
        array: cir::TypedArrayExpr*,
        expected_type: Option<cir::SemaType>
    ) Option<cir::SemaType> {
        var analyzed_first_element = false;

        var expected_element_type: Option<cir::SemaType> = .None;

        switch (expected_type) {
            case .Some(ty) => {
                switch (ty.as_array_type()) {
                    case .Some(array_type) => expected_element_type = .Some(*array_type.element_type);
                    else => {}
                }
            }
            else => {}
        }

        const elements_count = array->elements.len();

        // Try to infer from first element
        if (array->ty.is_none()) {
            if (array->elements.len() > 0) {
                const first_elem = array->elements.get(0).unwrap();
                switch (self->analyze_expr(first_elem, expected_element_type)) {
                    case .Some(sema_type) => {
                        const elements_count_expr = cir::const_untyped_integer_expr(
                            @cast(uint128, elements_count),
                            first_elem->span
                        );
                        array->ty = .Some(.Array(cir::TypedArrayType {
                            element_type: alloc_init(self->allocator, sema_type),
                            capacity: .Fixed(alloc_init(self->allocator, elements_count_expr)),
                            span: array->span,
                        }));
                    }
                    case .None => {}
                }

                analyzed_first_element = true;
            }
        }

        // Try to infer from expect type
        if (array->ty.is_none()) {
            switch (expected_element_type) {
                case .Some(sema_type) => {
                    const elements_count_expr = cir::const_untyped_integer_expr(
                        @cast(uint128, elements_count),
                        array->span
                    );
                    array->ty = .Some(.Array(cir::TypedArrayType {
                        element_type: alloc_init(self->allocator, sema_type),
                        capacity: .Fixed(alloc_init(self->allocator, elements_count_expr)),
                        span: array->span,
                    }));
                }
                case .None => {}
            }
        }

        if (array->ty.is_none()) {
            diags::report_untyped_array_cannot_be_inferred(
                self->dctx,
                self->allocator,
                array->span
            );
        }

        var initial_type: cir::SemaType = .Placeholder;

        switch (array->ty) {
            case .Some(ty) => initial_type = ty;
            case .None => return .None;
        }

        switch (self->normalize_and_check_type_formation(initial_type, array->span, 0)) {
            case .Some(ty) => array->ty = .Some(ty);
            case .None => return .None;
        }

        // expand array type
        switch (array->ty) {
            case .Some(ty) => array->ty = .Some(self->expand_sema_type(ty, array->span));
            case .None => return .None;
        }

        const at = array->ty.unwrap().as_array_type().unwrap();

        for (var i: usize = 0; i < array->elements.len(); i += 1) {
            const element = array->elements.get(i).unwrap();

            var expr_type: cir::SemaType = .Placeholder;

            if (analyzed_first_element && element->ty.is_some()) {
                switch (self->normalize_and_check_type_formation(element->ty.unwrap(), element->span, 0)) {
                    case .Some(ty) => expr_type = ty;
                    case .None => continue;
                }
            } else {
                switch (self->analyze_expr(element, .Some(*at.element_type))) {
                    case .Some(ty) => expr_type = ty;
                    case .None => continue;
                }
            }

            if (!self->is_assignable_to(expr_type, *at.element_type, element->span)) {
                var found_str = format::format_sema_type(
                    self->allocator,
                    self->decl_tables,
                    &expr_type
                );
                var expected_str = format::format_sema_type(
                    self->allocator,
                    self->decl_tables,
                    at.element_type
                );

                diags::report_array_element_type_mismatch(
                    self->dctx,
                    self->allocator,
                    array->span,
                    @cast(uint32, i),
                    found_str.as_str_const(),
                    expected_str.as_str_const()
                );

                found_str.free();
                expected_str.free();
            }
        }

        var array_type = at;

        var array_capacity: usize = 0;
        switch (array_type.capacity) {
            case .Fixed(cap_expr) => {
                if (self->analyze_expr(cap_expr, .None).is_none()) {
                    return .None;
                }

                switch (fold_const_expr_int(self->decl_tables, self->registry, cap_expr)) {
                    case .Some(.Unsigned(u)) => array_capacity = @cast(usize, u);
                    case .Some(.Signed(s)) => array_capacity = @cast(usize, s);
                    case .None => {
                        diags::report_expr_not_comptime_valid(
                            self->dctx,
                            self->allocator,
                            array_type.span
                        );
                        return .None;
                    }
                }
            }
            case .Slice => {
                diags::report_unimplemented_feature_slice(
                    self->dctx,
                    self->allocator,
                    array_type.span
                );
                return .None;
            }
        }

        if (array->elements.len() != array_capacity) {
            diags::report_array_elements_count_mismatch(
                self->dctx,
                self->allocator,
                array->span,
                @cast(uint32, array->elements.len()),
                @cast(uint32, array_capacity)
            );
            return .None;
        }

        return .Some(.Array(at));
    }

    pub fn analyze_array_index(
        self: Self*,
        array_index: cir::TypedArrayIndexExpr*
    ) Option<cir::SemaType> {
        var operand_type: cir::SemaType = .Placeholder;
        switch (self->analyze_expr(array_index->operand, .None)) {
            case .Some(ty) => operand_type = ty;
            case .None => return .None;
        }

        // Prevent cascading failures
        if (operand_type.contains_error()) {
            return .Some(.Err(array_index->span));
        }

        const is_operand_array = operand_type.const_inner()->is_array();

        if (!operand_type.is_pointer() && !is_operand_array) {
            diags::report_array_index_on_non_array_operand(
                self->dctx,
                self->allocator,
                array_index->span
            );
            return .None;
        }

        const expected_index_type = array_index->index->ty;

        var index_concrete_type: cir::SemaType = .Placeholder;
        switch (self->analyze_expr(array_index->index, expected_index_type)) {
            case .Some(ty) => index_concrete_type = ty;
            case .None => return .None;
        }

        var index_is_plain = false;
        
        if (index_concrete_type.const_inner()->as_plain_type().is_some()) {
            index_is_plain = true;
        }

        if (!index_concrete_type.contains_error() && !index_is_plain) {
            var found_str = format::format_sema_type(
                self->allocator,
                self->decl_tables,
                &index_concrete_type
            );

            diags::report_array_non_integer_index(
                self->dctx,
                self->allocator,
                array_index->span,
                found_str.as_str_const()
            );

            found_str.free();
            return .None;
        }

        const sema_type = array_index->operand->ty.unwrap();

        var element_type: cir::SemaType = .Placeholder;

        if (is_operand_array) {
            const array_type = sema_type.as_array_type().unwrap();
            element_type = *array_type.element_type;
        } else {
            // array index on pointer operand
            element_type = *sema_type.pointer_inner();

            if (element_type.is_void()) {
                diags::report_deref_void_pointer_value(
                    self->dctx,
                    self->allocator,
                    array_index->span
                );
                return .None;
            }
        }

        return .Some(element_type);
    }

    pub fn analyze_field_access(
        self: Self*,
        field_access: cir::TypedFieldAccess*
    ) Option<cir::SemaType> {
        var operand_type: cir::SemaType = .Placeholder;

        switch (self->analyze_expr(field_access->operand, .None)) {
            case .Some(ty) => operand_type = ty;
            case .None => return .None;
        }

        operand_type = self->expand_sema_type(operand_type, field_access->span);

        // Prevent cascading failures
        if (operand_type.contains_error()) {
            const err_ty: cir::SemaType = .Err(field_access->span);
            field_access->ty = .Some(err_ty);
            return .Some(err_ty);
        }

        const pure_operand_type = *operand_type.const_inner()->pointer_inner();
        const named_type_opt = pure_operand_type.as_named_type();

        var type_args = cir::TypedTypeArgs.new(self->allocator);

        switch (named_type_opt) {
            case .Some(named_type) => {
                type_args = named_type.type_args;
            }
            case .None => {
                var op_str = format::format_sema_type(
                    self->allocator,
                    self->decl_tables,
                    &operand_type
                );

                diags::report_object_not_supports_fields(
                    self->dctx,
                    self->allocator,
                    field_access->span,
                    op_str.as_str_const()
                );

                op_str.free();
                return .None;
            }
        }

        if (pure_operand_type.as_struct().is_some()) {
            const struct_decl_id = pure_operand_type.as_struct().unwrap();
            const struct_decl = self->decl_tables->structs.get_const(struct_decl_id).unwrap();

            const struct_name = format::format_struct_decl(
                self->allocator,
                self->decl_tables,
                struct_decl
            );
            defer struct_name.free();

            switch (struct_decl->lookup_field(field_access->name.as_str_const())) case .Some(field) else {
                diags::report_object_has_no_field_named(
                    self->dctx,
                    self->allocator,
                    field_access->span,
                    struct_name.as_str_const(),
                    field_access->name.as_str_const()
                );
                return .None;
            }

            self->validate_field_access(
                &operand_type,
                field_access->name.as_str_const(),
                struct_name.as_str_const(),
                field->vis,
                &struct_decl->methods,
                field_access->is_thin_arrow,
                field_access->span
            );

            const field_type = substitute_sema_type_with_type_args(
                self->allocator,
                &field->ty,
                &struct_decl->generic_params,
                &type_args
            );

            switch (self->normalize_sema_type(field_type, field_access->span, 0)) {
                case .Some(field_type) => {
                    var field_index: usize = 0;
                    for (var i: usize = 0; i < struct_decl->fields.len(); i += 1) {
                        if (struct_decl->fields.get_const(i).unwrap() == field) {
                            field_index = i;
                            break;
                        }
                    }

                    field_access->ty = .Some(field_type);
                    field_access->dispatch = .Struct {
                        struct_decl_id,
                        index: field_index,
                    };

                    return .Some(field_type);
                }
                case .None => return .None;
            }
        } else if (pure_operand_type.as_union().is_some()) {
            const union_decl_id = pure_operand_type.as_union().unwrap();
            const union_decl = self->decl_tables->unions.get_const(union_decl_id).unwrap();

            const union_name = format::format_union_decl(
                self->allocator,
                self->decl_tables,
                union_decl
            );
            defer union_name.free();

            switch (union_decl->lookup_field(field_access->name.as_str_const())) case .Some(field) else {
                diags::report_object_has_no_field_named(
                    self->dctx,
                    self->allocator,
                    field_access->span,
                    union_name.as_str_const(),
                    field_access->name.as_str_const()
                );
                return .None;
            }
           

            // Unions are never involved with 
            // visibility violations
            self->validate_field_access(
                &operand_type,
                field_access->name.as_str_const(),
                union_name.as_str_const(),
                .Public,
                &union_decl->methods,
                field_access->is_thin_arrow,
                field_access->span
            );

            const field_type = substitute_sema_type_with_type_args(
                self->allocator,
                &field->ty,
                &union_decl->generic_params,
                &type_args
            );

            switch (self->normalize_sema_type(field_type, field_access->span, 0)) {
                case .None => return .None;
                case .Some(field_type) => {
                    field_access->ty = .Some(field_type);
                    field_access->dispatch = .Union { union_decl_id };

                    return .Some(field_type);
                }
            }
        } else {
            const operand_type = field_access->operand->ty.unwrap();

            var type_name = format::format_sema_type(
                self->allocator,
                self->decl_tables,
                &operand_type
            );

            diags::report_object_not_supports_fields(
                self->dctx,
                self->allocator,
                field_access->span,
                type_name.as_str_const()
            );
            
            type_name.free();
            return .None;
        }
    }

    fn validate_field_access(
        self: Self*,
        operand_type: const cir::SemaType*,
        field_name: const uint8*,
        object_name: const uint8*,
        field_vis: ast::ASTVisibility,
        method_decls: const cir::MethodDecls*,
        is_thin_arrow: bool,
        loc: Span
    ) {
        var access_violation = false;

        switch (self->func_env.current_method) {
            case .Some(method_decl_id) => {
                if (method_decls->contains_method_id(method_decl_id)) {
                    access_violation = false;
                } else {
                    access_violation = field_vis != .Public;
                }
            }
            case .None => access_violation = field_vis != .Public;
        }

        if (access_violation) {
            diags::report_internal_field_access(
                self->dctx,
                self->allocator,
                loc,
                field_name,
                object_name
            );
        }

        const base_type = operand_type->const_inner();

        const is_pointer = base_type->is_pointer();
        const is_object = base_type->is_struct() || base_type->is_union();

        if (is_thin_arrow) {
            if (!is_pointer) {
                diags::report_invalid_thin_arrow(self->dctx, self->allocator, loc);
            }
        } else {
            if (!is_object) {
                diags::report_use_thin_arrow(self->dctx, self->allocator, loc);
            }
        }
    }

    /* ************* Generic Inference ************* */

    pub fn collect_instantiated_type_args(
        self: Self*,
        generic_params: cir::TypedGenericParams
    ) cir::TypedTypeArgs {
        var args = cir::TypedTypeArgs.new(self->allocator);

        for (var i: usize = 0; i < generic_params.len(); i += 1) {
            const generic_param_id = *generic_params.ids.get_const(i).unwrap();
            const generic_param = self->decl_tables->generic_params.get_const(generic_param_id).unwrap();

            var ty: cir::SemaType = .Placeholder;

            switch (self->lookup_generic_binding(generic_param_id)) {
                case .Some(bound) => ty = bound;
                case .None => {}
            }

            switch (self->func_env.infer) {
                case .Some(infer_ctx) => ty = infer_ctx->resolve(&ty);
                case .None => {}
            }

            args.push(.Type(ty, generic_param->name.span));
        }

        return args;
    }

    pub fn apply_generic_defaults(self: Self*, generic_params: cir::TypedGenericParams) {
        for (var i: usize = 0; i < generic_params.len(); i += 1) {
            const generic_param_id = *generic_params.ids.get_const(i).unwrap();
            const generic_param = self->decl_tables->generic_params.get_const(generic_param_id).unwrap();

            var binding: Option<cir::SemaType> = .None;

            switch (self->current_generic_env()) {
                case .Some(env) => binding = env->lookup(generic_param_id);
                case .None => {}
            }

            switch (binding) {
                case .Some(bound_type) => {
                    var ty: cir::SemaType = .Placeholder;

                    switch (self->func_env.infer) {
                        case .Some(infer_ctx) => ty = infer_ctx->resolve(&bound_type);
                        case .None => ty = bound_type;
                    }

                    switch (ty) {
                        case .InferVar(var_id) => {
                            switch (generic_param->default) {
                                case .Some(default_type) => {
                                    const ty = self->substitute_type(default_type);

                                    switch (self->func_env.infer) {
                                        case .Some(infer_ctx) => {
                                            const infer_var_ty: cir::SemaType = .InferVar(var_id);
                                            infer_ctx->unify(&infer_var_ty, &ty);
                                        }
                                        case .None => {}
                                    }
                                }
                                case .None => {}
                            }
                        }
                        else => {}
                    }
                }
                case .None => {
                    switch (generic_param->default) {
                        case .Some(default_type) => {
                            const ty = self->substitute_type(default_type);

                            switch (self->current_generic_env()) {
                                case .Some(env) => env->bind(generic_param_id, ty);
                                case .None => {}
                            }
                        }
                        case .None => {}
                    }
                }
            }
        }
    }

    pub fn unify_with_expected_type(
        self: Self*,
        operand_type: cir::SemaType,
        expected_type: Option<cir::SemaType>
    ) {
        switch (expected_type) {
            case .Some(expect) => {
                switch (self->func_env.infer) {
                    case .Some(infer_ctx) => infer_ctx->unify(&expect, &operand_type);
                    case .None => {}
                }
            }
            case .None => {}
        }
    }

    pub fn create_inference_generic_env(
        self: Self*,
        type_name: const uint8*,
        params: cir::TypedGenericParams,
        type_args: const cir::TypedTypeArgs*,
        loc: Span
    ) Option<GenericEnv> {
        if (!type_args->is_empty() && params.len() != type_args->len()) {
            diags::report_wrong_number_of_type_args(
                self->dctx,
                self->allocator,
                loc,
                type_name,
                params.len(),
                type_args->len()
            );
            return .None;
        }

        var generic_env = GenericEnv.new(self->allocator, params);

        for (var i: usize = 0; i < params.len(); i += 1) {
            const param_id = *params.ids.get_const(i).unwrap();

            switch (self->func_env.infer) {
                case .Some(infer_ctx) => {
                    var bound_type: Option<cir::SemaType> = .None;

                    switch (type_args->get(i)) {
                        case .Some(type_arg) => {
                            switch (*type_arg) {
                                case .Type(sema_type, _) => bound_type = .Some(sema_type);
                                case .Infer => bound_type = .Some(infer_ctx->new_var());
                            }
                        }
                        case .None => {}
                    }

                    switch (bound_type) {
                        case .Some(ty) => {
                            generic_env.bind(param_id, ty);
                        }
                        case .None => {
                            generic_env.bind(param_id, infer_ctx->new_var());
                        }
                    }
                }
                case .None => {}
            }
        }

        return .Some(generic_env);
    }

    /* ************* Enum Init ************* */

    pub fn analyze_enum_init(
        self: Self*,
        enum_init: cir::TypedEnumInit*,
        expected_type: Option<cir::SemaType>
    ) Option<cir::SemaType> {
        var operand: cir::SemaType = .Placeholder;

        switch (self->normalize_and_check_type_formation(enum_init->operand, enum_init->span, 0)) {
            case .Some(ty) => operand = ty;
            case .None => return .None;
        }

        operand = self->expand_sema_type(operand, enum_init->span);

        switch (operand.as_named_type()) case .Some(named_type) else {
            var type_name = format::format_sema_type(self->allocator, self->decl_tables, &operand);
            diags::report_non_enum_symbol(
                self->dctx,
                self->allocator,
                enum_init->span,
                type_name.as_str_const()
            );
            type_name.free();
            return .None;
        }

        switch (named_type.type_decl_id.as_enum()) case .Some(enum_decl_id) else {
            var type_name = format::format_sema_type(self->allocator, self->decl_tables, &operand);
            diags::report_non_enum_symbol(
                self->dctx,
                self->allocator,
                enum_init->span,
                type_name.as_str_const()
            );
            type_name.free();
            return .None;
        }
        const enum_decl = self->decl_tables->enums.get_const(enum_decl_id).unwrap();

        var enum_name = format::format_enum_decl(self->allocator, self->registry, self->decl_tables, enum_decl);
        defer enum_name.free();

        switch (enum_decl->lookup_variant(enum_init->name.as_str_const())) case .Some(variant) else {
            diags::report_no_such_enum_variant(
                self->dctx,
                self->allocator,
                enum_init->span,
                enum_name.as_str_const(),
                enum_init->name.as_str_const()
            );
            return .None;   
        }

        const generic_env_opt = self->create_inference_generic_env(
            enum_name.as_str_const(),
            enum_decl->generic_params,
            &named_type.type_args,
            enum_init->span
        );

        switch (generic_env_opt) case .Some(generic_env) else {
            return .None;
        }

        self->push_generic_env(generic_env);
        const result = self->analyze_enum_init_inner(
            enum_init,
            expected_type,
            variant,
            enum_decl_id,
            &enum_decl->generic_params
        );
        self->pop_generic_env();
        return result;
    }

    fn analyze_enum_init_inner(
        self: Self*,
        enum_init: cir::TypedEnumInit*,
        expected_type: Option<cir::SemaType>,
        variant: const cir::TypedEnumVariant*,
        enum_decl_id: cir::EnumDeclId,
        generic_params: const cir::TypedGenericParams*
    ) Option<cir::SemaType> {
        var handled = false;

        switch (enum_init->arg) {
            case .Unit => {
                switch (*variant) {
                    case .Unit | .Valued => handled = true;
                    else => {}
                }
            }
            case .Tuple(var elements) => {
                switch (*variant) {
                    case .Tuple { fields, .. } => {
                        handled = true;

                        if (elements.len() != fields.len()) {
                            diags::report_enum_variant_arg_count_mismatch(
                                self->dctx,
                                self->allocator,
                                enum_init->span,
                                enum_init->name.as_str_const(),
                                @cast(uint32, fields.len()),
                                @cast(uint32, elements.len())
                            );
                            return .None;
                        }

                        for (var i: usize = 0; i < elements.len(); i += 1) {
                            const element = elements.get(i).unwrap();
                            const field = fields.get_const(i).unwrap();
                            self->analyze_field_assign(element, field->ty, field->span);
                        }
                    }
                    else => {}
                }
            }
            case .Struct(field_inits) => {
                switch (*variant) {
                    case .Struct { fields, .. } => {
                        handled = true;
                        self->analyze_enum_struct_variant_fields(
                            enum_init->name.as_str_const(),
                            &field_inits,
                            &fields,
                            enum_init->span
                        );
                    }
                    else => {}
                }
            }
        }

        if (!handled) {
            var variant_is_fielded = false;
            var variant_kind = "unit";

            switch (*variant) {
                case .Valued { .. } => {
                    variant_kind = "valued";
                }
                case .Unit => {
                    variant_kind = "unit";
                }
                case .Tuple { .. } => {
                    variant_kind = "tuple";
                    variant_is_fielded = true;
                }
                case .Struct { .. } => {
                    variant_kind = "struct";
                    variant_is_fielded = true;
                }
            }

            if (!variant_is_fielded) {
                diags::report_enum_variant_does_not_accept_fields(
                    self->dctx,
                    self->allocator,
                    enum_init->span,
                    enum_init->name.as_str_const()
                );
                return .None;
            }

            const kind = enum_init->arg.to_str();

            diags::report_enum_variant_kind_mismatch(
                self->dctx,
                self->allocator,
                enum_init->span,
                enum_init->name.as_str_const(),
                variant_kind,
                kind
            );
            return .None;
        }

        const inferred_type_args = self->collect_instantiated_type_args(*generic_params);

        self->unify_with_expected_type(
            .Named(cir::NamedType {
                type_decl_id: .Enum(enum_decl_id),
                type_args: inferred_type_args,
            }),
            expected_type
        );

        self->apply_generic_defaults(*generic_params);

        const final_type_args = self->collect_instantiated_type_args(*generic_params);
        const final_type: cir::SemaType = .Named(cir::NamedType {
            type_decl_id: .Enum(enum_decl_id),
            type_args: final_type_args,
        });

        enum_init->operand = final_type;
        return .Some(final_type);
    }

    pub fn analyze_unnamed_enum_value(
        self: Self*,
        enum_value: cir::TypedUnnamedEnumValue*,
        expected_type: Option<cir::SemaType>
    ) Option<cir::SemaType> {
        var enum_decl_id_opt: Option<cir::EnumDeclId> = .None;
        var type_args: cir::TypedTypeArgs = cir::TypedTypeArgs.new(self->allocator);

        switch (expected_type) {
            case .Some(ty) => {
                switch (ty.as_named_type()) {
                    case .Some(named_type) => {
                        switch (named_type.type_decl_id.as_enum()) {
                            case .Some(enum_decl_id) => {
                                enum_decl_id_opt = .Some(enum_decl_id);
                                type_args = named_type.type_args;
                            }
                            case .None => {}
                        }
                    }
                    case .None => {}
                }
            }
            case .None => {}
        }

        switch (enum_decl_id_opt) case .Some(enum_decl_id) else {
            diags::report_cannot_infer_enum_for_unnamed_variant(
                self->dctx,
                self->allocator,
                enum_value->span,
                enum_value->ident.str.as_str_const()
            );
            return .None;
        }
        const enum_decl = self->decl_tables->enums.get_const(enum_decl_id).unwrap();

        var enum_name = format::format_enum_decl(self->allocator, self->registry, self->decl_tables, enum_decl);
        defer enum_name.free();

        const variant_opt = enum_decl->lookup_variant(enum_value->ident.str.as_str_const());

        switch (variant_opt) case .Some(variant) else {
            diags::report_no_such_enum_variant(
                self->dctx,
                self->allocator,
                enum_value->span,
                enum_name.as_str_const(),
                enum_value->ident.str.as_str_const()
            );
            return .None;
        }

        const generic_env_opt = self->create_inference_generic_env(
            enum_name.as_str_const(),
            enum_decl->generic_params,
            &type_args,
            enum_value->span
        );

        switch (generic_env_opt) case .Some(generic_env) else {
            return .None;
        }

        self->push_generic_env(generic_env);
        const result = self->analyze_unnamed_enum_value_inner(
            enum_value,
            expected_type,
            variant,
            enum_decl_id,
            &enum_decl->generic_params
        );
        self->pop_generic_env();
        return result;
    }

    fn analyze_unnamed_enum_value_inner(
        self: Self*,
        enum_value: cir::TypedUnnamedEnumValue*,
        expected_type: Option<cir::SemaType>,
        variant: const cir::TypedEnumVariant*,
        enum_decl_id: cir::EnumDeclId,
        generic_params: const cir::TypedGenericParams*
    ) Option<cir::SemaType> {
        var handled = false;

        switch (enum_value->kind) {
            case .Unit => {
                switch (*variant) {
                    case .Unit | .Valued => handled = true;
                    else => {}
                }
            }
            case .Tuple(var elements) => {
                switch (*variant) {
                    case .Tuple { fields, .. } => {
                        handled = true;

                        if (elements.len() != fields.len()) {
                            diags::report_enum_variant_arg_count_mismatch(
                                self->dctx,
                                self->allocator,
                                enum_value->span,
                                enum_value->ident.str.as_str_const(),
                                @cast(uint32, fields.len()),
                                @cast(uint32, elements.len())
                            );
                            return .None;
                        }

                        for (var i: usize = 0; i < elements.len(); i += 1) {
                            const element = elements.get(i).unwrap();
                            const field = fields.get_const(i).unwrap();

                            self->analyze_field_assign(element, field->ty, field->span);
                        }
                    }
                    else => {}
                }
            }
            case .Struct(field_inits) => {
                switch (*variant) {
                    case .Struct { fields, .. } => {
                        handled = true;

                        self->analyze_enum_struct_variant_fields(
                            enum_value->ident.str.as_str_const(),
                            &field_inits,
                            &fields,
                            enum_value->span
                        );
                    }
                    else => {}
                }
            }
        }

        if (!handled) {
            var variant_is_fielded = false;
            var variant_kind = "unit";

            switch (*variant) {
                case .Unit => variant_kind = "unit";
                case .Valued { .. } => variant_kind = "valued";
                case .Tuple { .. } => {
                    variant_kind = "tuple";
                    variant_is_fielded = true;
                }
                case .Struct { .. } => {
                    variant_kind = "struct";
                    variant_is_fielded = true;
                }
            }

            if (!variant_is_fielded) {
                diags::report_enum_variant_does_not_accept_fields(
                    self->dctx,
                    self->allocator,
                    enum_value->span,
                    enum_value->ident.str.as_str_const()
                );
                return .None;
            }

            const kind = enum_value->kind.to_str();

            diags::report_enum_variant_kind_mismatch(
                self->dctx,
                self->allocator,
                enum_value->span,
                enum_value->ident.str.as_str_const(),
                variant_kind,
                kind
            );
            return .None;
        }

        enum_value->enum_decl_id = .Some(enum_decl_id);

        switch (expected_type) {
            case .Some(ty) => return .Some(ty);
            case .None => return .None;
        }
    }

    pub fn analyze_enum_struct_variant_init(
        self: Self*,
        struct_variant_init: cir::TypedEnumStructVariantInit*
    ) Option<cir::SemaType> {
        var decl_id_opt: Option<cir::DeclId> = .None;
        switch (struct_variant_init->operand->kind.as_unresolved_symbol_id()) {
            case .Some(symbol_id) => {
                decl_id_opt = self->registry->lookup_symbol_as_decl_id(symbol_id);
            }
            case .None => {}
        }

        switch (decl_id_opt) case .Some(decl_id) else {
            var expr_str = format::format_typed_expr(
                self->allocator,
                self->registry,
                self->decl_tables,
                struct_variant_init->operand
            );

            diags::report_invalid_enum_constructor_target(
                self->dctx,
                self->allocator,
                struct_variant_init->span,
                expr_str.as_str_const()
            );

            expr_str.free();
            return .None;
        }

        switch (decl_id.as_enum()) case .Some(enum_decl_id) else {
            var type_name = format::format_decl_name(self->allocator, self->decl_tables, &decl_id);

            diags::report_non_enum_symbol(
                self->dctx,
                self->allocator,
                struct_variant_init->span,
                type_name.as_str_const()
            );

            type_name.free();
            return .None;
        }
        const enum_decl = self->decl_tables->enums.get_const(enum_decl_id).unwrap();

        switch (enum_decl->lookup_variant(struct_variant_init->ident.str.as_str_const())) case .Some(variant) else {
            var type_name = format::format_decl_name(self->allocator, self->decl_tables, &decl_id);

            diags::report_no_such_enum_variant(
                self->dctx,
                self->allocator,
                struct_variant_init->span,
                type_name.as_str_const(),
                struct_variant_init->ident.str.as_str_const()
            );

            type_name.free();
            return .None;
        }

        var variant_is_struct = false;
        var variant_kind = "unit";

        switch (*variant) {
            case .Valued { .. } => variant_kind = "valued";
            case .Tuple { .. } => variant_kind = "tuple";
            case .Unit => variant_kind = "unit";
            case .Struct { fields, .. } => {
                variant_is_struct = true;

                self->analyze_enum_struct_variant_fields(
                    struct_variant_init->ident.str.as_str_const(),
                    &struct_variant_init->field_inits,
                    &fields,
                    struct_variant_init->span
                );
            }
        }

        if (!variant_is_struct) {
            diags::report_enum_variant_kind_mismatch(
                self->dctx,
                self->allocator,
                struct_variant_init->span,
                struct_variant_init->ident.str.as_str_const(),
                "struct",
                variant_kind
            );
            return .None;
        }

        struct_variant_init->enum_decl_id = .Some(enum_decl_id);

        return .Some(.Named(cir::NamedType {
            type_decl_id: .Enum(enum_decl_id),
            type_args: cir::TypedTypeArgs.new(self->allocator),
        }));
    }

    fn analyze_enum_struct_variant_fields(
        self: Self*,
        variant_name: const uint8*,
        field_inits: const Vec<cir::TypedEnumStructVariantFieldInit>*,
        fields: const Vec<cir::TypedEnumVariantStructField>*,
        loc: Span
    ) {
        for (var i: usize = 0; i < field_inits->len(); i += 1) {
            const field_init = field_inits->get_const(i).unwrap();
            const field_name = field_init->name.str.as_str_const();

            var is_duplicate = false;

            for (var j: usize = 0; j < i; j += 1) {
                const field = field_inits->get_const(j).unwrap();

                if (field->name.str.as_str_const() == field_name) {
                    is_duplicate = true;
                    break;
                }
            }
            if (is_duplicate) {
                diags::report_duplicate_field_initializer(
                    self->dctx,
                    self->allocator,
                    field_init->span,
                    field_name
                );
                continue;
            }

            var variant_opt: Option<const cir::TypedEnumVariantStructField*> = .None;

            for (var k: usize = 0; k < fields->len(); k += 1) {
                const field = fields->get_const(k).unwrap();

                if (field->name.str.as_str_const() == field_name) {
                    variant_opt = .Some(field);
                    break;
                }
            }

            switch (variant_opt) {
                case .Some(field) => {
                    self->analyze_field_assign(
                        field_init->value, 
                        field->ty, 
                        field->span
                    );
                }
                case .None => {
                    diags::report_invalid_enum_variant_field(
                        self->dctx,
                        self->allocator,
                        field_init->span,
                        variant_name,
                        field_name
                    );
                }
            }
        }

        for (var k: usize = 0; k < fields->len(); k += 1) {
            const declared_field = fields->get_const(k).unwrap();

            var found = false;

            for (var i: usize = 0; i < field_inits->len(); i += 1) {
                const field_init = field_inits->get_const(i).unwrap();
                
                if (field_init->name.str.as_str_const() == declared_field->name.str.as_str_const()) {
                    found = true;
                    break;
                }
            }

            if (!found) {
                diags::report_missing_enum_variant_field(
                    self->dctx,
                    self->allocator,
                    loc,
                    declared_field->name.str.as_str_const(),
                    variant_name
                );
            }
        }
    }

    /* ************* Struct Init ************* */

    pub fn analyze_struct_init(
        self: Self*,
        struct_init: cir::TypedStructInitExpr*,
        expected_type: Option<cir::SemaType>
    ) Option<cir::SemaType> {
        var operand: cir::SemaType = .Placeholder;
        switch (self->normalize_and_check_type_formation(struct_init->operand, struct_init->span, 0)) {
            case .Some(ty) => operand = ty;
            case .None => return .None;
        }

        operand = self->expand_sema_type(operand, struct_init->span);

        switch (operand.as_named_type()) case .Some(named_type) else {
            var type_name = format::format_sema_type(self->allocator, self->decl_tables, &operand);

            diags::report_non_struct_symbol(
                self->dctx,
                self->allocator,
                struct_init->span,
                type_name.as_str_const()
            );

            type_name.free();
            return .None;
        }

        switch (named_type.type_decl_id.as_struct()) case .Some(struct_decl_id) else {
            var type_name = format::format_sema_type(
                self->allocator,
                self->decl_tables,
                &operand
            );

            diags::report_non_struct_symbol(
                self->dctx,
                self->allocator,
                struct_init->span,
                type_name.as_str_const()
            );

            type_name.free();
            return .None;
        }
        const struct_decl = self->decl_tables->structs.get_const(struct_decl_id).unwrap();

        var struct_name = format::format_struct_decl(self->allocator, self->decl_tables, struct_decl);
        defer struct_name.free();

        const generic_env_opt = self->create_inference_generic_env(
            struct_name.as_str_const(),
            struct_decl->generic_params,
            &named_type.type_args,
            struct_init->span
        );

        switch (generic_env_opt) case .Some(generic_env) else {
            return .None;
        }

        self->push_generic_env(generic_env);
        const result = self->analyze_struct_init_inner(
            struct_init,
            expected_type,
            struct_decl,
            struct_decl_id
        );
        self->pop_generic_env();
        return result;
    }

    fn analyze_struct_init_inner(
        self: Self*,
        struct_init: cir::TypedStructInitExpr*,
        expected_type: Option<cir::SemaType>,
        struct_decl: const cir::StructDecl*,
        struct_decl_id: cir::StructDeclId
    ) Option<cir::SemaType> {
        for (var i: usize = 0; i < struct_init->fields.len(); i += 1) {
            const field = struct_init->fields.get(i).unwrap();
            const struct_field = struct_decl->lookup_field(field->name.as_str_const());

            switch (struct_field) {
                case .Some(decl_field) => {
                    switch (self->normalize_sema_type(decl_field->ty, field->span, 0)) {
                        case .None => {}
                        case .Some(normalized) => {
                            const expected_field_type = self->substitute_type(&normalized);
                            self->analyze_field_assign(&field->value, expected_field_type, field->span);
                        }
                    }
                }
                case .None => {
                    // Unknown field will be reported later
                } 
            }
        }

        self->check_duplicate_struct_field_init(&struct_init->fields);
        self->check_missing_fields(struct_decl, &struct_init->fields, struct_init->span);
        self->check_invalid_fields(struct_decl, &struct_init->fields);

        const inferred_type_args = self->collect_instantiated_type_args(struct_decl->generic_params);

        self->unify_with_expected_type(
            .Named(cir::NamedType {
                type_decl_id: .Struct(struct_decl_id),
                type_args: inferred_type_args,
            }),
            expected_type
        );

        self->apply_generic_defaults(struct_decl->generic_params);

        const final_type_args = self->collect_instantiated_type_args(struct_decl->generic_params);
        const final_type: cir::SemaType = .Named(cir::NamedType {
            type_decl_id: .Struct(struct_decl_id),
            type_args: final_type_args,
        });

        struct_init->operand = final_type;
        return .Some(final_type);
    }

    pub fn analyze_unnamed_struct_value(
        self: Self*,
        struct_value: cir::TypedUnnamedStructValue*,
        expected_type: Option<cir::SemaType>
    ) Option<cir::SemaType> {
        // Case 1: If expect type is a struct, 
        // then use its declaration and analyze 
        // fields with expect type.
        var struct_decl_id_opt: Option<cir::StructDeclId> = .None;
        var type_args: cir::TypedTypeArgs = cir::TypedTypeArgs.new(self->allocator);

        switch (expected_type) {
            case .Some(ty) => {
                switch (ty.as_named_type()) {
                    case .Some(named_type) => {
                        switch (named_type.type_decl_id.as_struct()) {
                            case .Some(struct_decl_id) => {
                                struct_decl_id_opt = .Some(struct_decl_id);
                                type_args = named_type.type_args;
                            }
                            case .None => {}
                        }
                    }
                    case .None => {}
                }
            }
            case .None => {}
        }

        switch (struct_decl_id_opt) {
            case .Some(struct_decl_id) => {
                const struct_decl = self->decl_tables->structs.get_const(struct_decl_id).unwrap();

                var struct_name = format::format_struct_decl(self->allocator, self->decl_tables, struct_decl);
                defer struct_name.free();

                const generic_env_opt = self->create_inference_generic_env(
                    struct_name.as_str_const(),
                    struct_decl->generic_params,
                    &type_args,
                    struct_value->span
                );

                switch (generic_env_opt) case .Some(generic_env) else {
                    return .None;
                }

                self->push_generic_env(generic_env);
                const result = self->analyze_unnamed_struct_value_inner(
                    struct_value,
                    expected_type,
                    struct_decl,
                    struct_decl_id
                );
                self->pop_generic_env();
                return result;
            }
            case .None => {}
        }

        // Case 2: No expect type (Create a new struct decl)
        var struct_decl = self->create_struct_decl_from_unnamed_struct_value(struct_value);
        const struct_decl_id = self->decl_tables->insert_struct(struct_decl);

        for (var i: usize = 0; i < struct_value->fields.len(); i += 1) {
            const struct_value_field = struct_value->fields.get(i).unwrap();

            self->analyze_expr(struct_value_field->value, .None);

            switch (struct_value_field->value->ty) {
                case .Some(rhs_type) => {
                    for (var j: usize = 0; j < struct_decl.fields.len(); j += 1) {
                        const struct_field = struct_decl.fields.get(j).unwrap();
                        
                        if (struct_field->name.as_str_const() == struct_value_field->name.as_str_const()) {
                            struct_field->ty = rhs_type;
                            break;
                        }
                    }
                }
                case .None => {}
            }
        }

        self->check_duplicate_fields_for_unnamed_struct_value(struct_value);

        // Write back field types in struct decl
        const struct_decl_ref = self->decl_tables->structs.get(struct_decl_id).unwrap();
        *struct_decl_ref = struct_decl;

        struct_value->struct_decl_id = .Some(struct_decl_id);

        return .Some(.Named(cir::NamedType {
            type_decl_id: .Struct(struct_decl_id),
            type_args: cir::TypedTypeArgs.new(self->allocator),
        }));
    }

    fn analyze_unnamed_struct_value_inner(
        self: Self*,
        struct_value: cir::TypedUnnamedStructValue*,
        expected_type: Option<cir::SemaType>,
        struct_decl: const cir::StructDecl*,
        struct_decl_id: cir::StructDeclId
    ) Option<cir::SemaType> {
        for (var i: usize = 0; i < struct_value->fields.len(); i += 1) {
            const struct_value_field = struct_value->fields.get(i).unwrap();
            const struct_field = struct_decl->lookup_field(struct_value_field->name.as_str_const());

            switch (struct_field) {
                case .Some(decl_field) => {
                    const expected_field_type = self->substitute_type(&decl_field->ty);
                    self->analyze_field_assign(
                        struct_value_field->value,
                        expected_field_type,
                        struct_value_field->span
                    );
                }
                case .None => {
                    // Unknown field will be reported later
                }
            }
        }

        self->check_invalid_fields_for_unnamed_struct_value(struct_decl, struct_value);
        self->check_missing_fields_for_unnamed_struct_value(struct_decl, struct_value);
        self->check_duplicate_fields_for_unnamed_struct_value(struct_value);

        struct_value->struct_decl_id = .Some(struct_decl_id);

        switch (expected_type) {
            case .Some(ty) => return .Some(ty);
            case .None => return .None;
        }
    }

    fn create_struct_decl_from_unnamed_struct_value(
        self: Self*,
        struct_value: const cir::TypedUnnamedStructValue*
    ) cir::StructDecl {
        var fields: Vec<cir::TypedStructField> = Vec.new(self->allocator);

        for (var i: usize = 0; i < struct_value->fields.len(); i += 1) {
            const field = struct_value->fields.get_const(i).unwrap();
            
            fields.push(cir::TypedStructField {
                name: String.from_str(self->allocator, field->name.as_str_const()),
                ty: .Placeholder,
                vis: .Public,
                span: field->span,
            });
        }

        return cir::StructDecl {
            name: .None,
            fields,
            impls: Vec.new(self->allocator),
            methods: cir::MethodDecls.new(self->allocator),
            generic_params: cir::TypedGenericParams.new(self->allocator),
            modifiers: ast::ASTStructModifiers {
                vis: .Public,
                repr_attr: struct_value->repr_attr,
            },
            align: struct_value->align,
            is_normalized: false,
            span: struct_value->span,
        };
    }

    fn check_invalid_fields(
        self: Self*,
        struct_decl: const cir::StructDecl*,
        fields: const Vec<cir::TypedFieldInit>*
    ) {
        var struct_name = format::format_struct_decl(self->allocator, self->decl_tables, struct_decl);
        defer struct_name.free();

        for (var i: usize = 0; i < fields->len(); i += 1) {
            const field_init = fields->get_const(i).unwrap();
            const field_name = field_init->name.as_str_const();

            var found = false;
            
            for (var j: usize = 0; j < struct_decl->fields.len(); j += 1) {
                const field = struct_decl->fields.get_const(j).unwrap();

                if (field->name.as_str_const() == field_name) {
                    found = true;
                    break;
                }
            }

            if (!found) {
                diags::report_object_has_no_field_named(
                    self->dctx,
                    self->allocator,
                    field_init->span,
                    struct_name.as_str_const(),
                    field_name
                );
            }
        }

    }

    fn check_missing_fields(
        self: Self*,
        struct_decl: const cir::StructDecl*,
        fields: const Vec<cir::TypedFieldInit>*,
        loc: Span
    ) {
        var missing = String.new(self->allocator);
        defer missing.free();

        var has_missing = false;

        for (var i: usize = 0; i < struct_decl->fields.len(); i += 1) {
            const decl_field = struct_decl->fields.get_const(i).unwrap();

            var found = false;
            for (var j: usize = 0; j < fields->len(); j += 1) {
                const field_init = fields->get_const(j).unwrap();
                if (field_init->name.as_str_const() == decl_field->name.as_str_const()) {
                    found = true;
                    break;
                }
            }

            if (!found) {
                if (has_missing) {
                    missing.push_str(", ");
                }
                missing.push_str("`");
                missing.push_str(decl_field->name.as_str_const());
                missing.push_str("`");
                has_missing = true;
            }
        }

        if (has_missing) {
            var type_name = format::format_struct_decl(
                self->allocator, 
                self->decl_tables, 
                struct_decl
            );
            
            diags::report_struct_missing_fields(
                self->dctx,
                self->allocator,
                loc,
                type_name.as_str_const(),
                missing.as_str_const()
            );

            type_name.free();
        }

    }

    fn check_duplicate_struct_field_init(
        self: Self*,
        fields: const Vec<cir::TypedFieldInit>*
    ) {
        for (var i: usize = 0; i < fields->len(); i += 1) {
            const field = fields->get_const(i).unwrap();

            var is_duplicate = false;

            for (var j: usize = 0; j < i; j += 1) {
                const earlier = fields->get_const(j).unwrap();
                if (earlier->name.as_str_const() == field->name.as_str_const()) {
                    is_duplicate = true;
                    break;
                }
            }

            if (is_duplicate) {
                diags::report_duplicate_field_initializer(
                    self->dctx,
                    self->allocator,
                    field->span,
                    field->name.as_str_const()
                );
            }
        }
    }

    fn check_invalid_fields_for_unnamed_struct_value(
        self: Self*,
        struct_decl: const cir::StructDecl*,
        struct_value: const cir::TypedUnnamedStructValue*
    ) {
        var struct_name = format::format_struct_decl(
            self->allocator, 
            self->decl_tables, 
            struct_decl
        );
        defer struct_name.free();

        for (var i: usize = 0; i < struct_value->fields.len(); i += 1) {
            const field = struct_value->fields.get_const(i).unwrap();
            const field_name = field->name.as_str_const();

            var found = false;

            for (var j: usize = 0; j < struct_decl->fields.len(); j += 1) {
                const field = struct_decl->fields.get_const(j).unwrap();
                
                if (field->name.as_str_const() == field_name) {
                    found = true;
                    break;
                }
            }

            if (!found) {
                diags::report_object_has_no_field_named(
                    self->dctx,
                    self->allocator,
                    field->span,
                    struct_name.as_str_const(),
                    field_name
                );
            }
        }

    }

    fn check_missing_fields_for_unnamed_struct_value(
        self: Self*,
        struct_decl: const cir::StructDecl*,
        struct_value: const cir::TypedUnnamedStructValue*
    ) {
        var missing = String.new(self->allocator);
        defer missing.free();

        var has_missing = false;

        for (var i: usize = 0; i < struct_decl->fields.len(); i += 1) {
            const decl_field = struct_decl->fields.get_const(i).unwrap();

            var found = false;
            for (var j: usize = 0; j < struct_value->fields.len(); j += 1) {
                const field = struct_value->fields.get_const(j).unwrap();
                if (field->name.as_str_const() == decl_field->name.as_str_const()) {
                    found = true;
                    break;
                }
            }

            if (!found) {
                if (has_missing) {
                    missing.push_str(", ");
                }
                missing.push_str("`");
                missing.push_str(decl_field->name.as_str_const());
                missing.push_str("`");
                has_missing = true;
            }
        }

        if (has_missing) {
            var type_name = format::format_struct_decl(
                self->allocator, 
                self->decl_tables, 
                struct_decl
            );

            diags::report_struct_missing_fields(
                self->dctx,
                self->allocator,
                struct_value->span,
                type_name.as_str_const(),
                missing.as_str_const()
            );

            type_name.free();
        }

    }

    fn check_duplicate_fields_for_unnamed_struct_value(
        self: Self*,
        struct_value: const cir::TypedUnnamedStructValue*
    ) {
        for (var i: usize = 0; i < struct_value->fields.len(); i += 1) {
            const field = struct_value->fields.get_const(i).unwrap();

            var is_duplicate = false;

            for (var j: usize = 0; j < i; j += 1) {
                const earlier = struct_value->fields.get_const(j).unwrap();

                if (earlier->name.as_str_const() == field->name.as_str_const()) {
                    is_duplicate = true;
                    break;
                }
            }

            if (is_duplicate) {
                diags::report_duplicate_field_initializer(
                    self->dctx,
                    self->allocator,
                    field->span,
                    field->name.as_str_const()
                );
            }
        }
    }

    /* ************* Union Init ************* */

    pub fn analyze_union_init(
        self: Self*,
        union_init: cir::TypedUnionInitExpr*,
        expected_type: Option<cir::SemaType>
    ) Option<cir::SemaType> {
        var operand: cir::SemaType = .Placeholder;

        switch (self->normalize_and_check_type_formation(union_init->operand, union_init->span, 0)) {
            case .Some(ty) => operand = ty;
            case .None => return .None;
        }

        operand = self->expand_sema_type(operand, union_init->span);

        switch (operand.as_named_type()) case .Some(named_type) else {
            var type_name = format::format_sema_type(
                self->allocator,
                self->decl_tables,
                &operand
            );

            diags::report_non_union_symbol(
                self->dctx,
                self->allocator,
                union_init->span,
                type_name.as_str_const()
            );

            type_name.free();
            return .None;
        }

        switch (named_type.type_decl_id.as_union()) case .Some(union_decl_id) else {
            var type_name = format::format_sema_type(
                self->allocator,
                self->decl_tables,
                &operand
            );

            diags::report_non_union_symbol(
                self->dctx,
                self->allocator,
                union_init->span,
                type_name.as_str_const()
            );

            type_name.free();
            return .None;
        }
        const union_decl = self->decl_tables->unions.get_const(union_decl_id).unwrap();

        var union_name = format::format_union_decl(self->allocator, self->decl_tables, union_decl);
        defer union_name.free();

        const generic_env_opt = self->create_inference_generic_env(
            union_name.as_str_const(),
            union_decl->generic_params,
            &named_type.type_args,
            union_init->span
        );

        switch (generic_env_opt) case .Some(generic_env) else {
            return .None;
        }

        self->push_generic_env(generic_env);
        const result = self->analyze_union_init_inner(
            union_init,
            expected_type,
            union_decl,
            union_decl_id,
            union_name.as_str_const()
        );
        self->pop_generic_env();
        return result;
    }

    fn analyze_union_init_inner(
        self: Self*,
        union_init: cir::TypedUnionInitExpr*,
        expected_type: Option<cir::SemaType>,
        union_decl: const cir::UnionDecl*,
        union_decl_id: cir::UnionDeclId,
        union_name: const uint8*
    ) Option<cir::SemaType> {
        const field_opt = union_decl->lookup_field(union_init->field->name.as_str_const());

        switch (field_opt) case .Some(field) else {
            diags::report_object_has_no_field_named(
                self->dctx,
                self->allocator,
                union_init->field->span,
                union_name,
                union_init->field->name.as_str_const()
            );
            return .None;
        }

        const expected_field_type = self->substitute_type(&field->ty);
        self->analyze_field_assign(&union_init->field->value, expected_field_type, union_init->field->span);

        const inferred_type_args = self->collect_instantiated_type_args(union_decl->generic_params);

        self->unify_with_expected_type(
            .Named(cir::NamedType {
                type_decl_id: .Union(union_decl_id),
                type_args: inferred_type_args,
            }),
            expected_type
        );

        self->apply_generic_defaults(union_decl->generic_params);

        const final_type_args = self->collect_instantiated_type_args(union_decl->generic_params);
        const final_type: cir::SemaType = .Named(cir::NamedType {
            type_decl_id: .Union(union_decl_id),
            type_args: final_type_args,
        });

        union_init->operand = final_type;
        return .Some(final_type);
    }

    pub fn analyze_unnamed_union_value(
        self: Self*,
        union_value: cir::TypedUnnamedUnionValue*,
        expected_type: Option<cir::SemaType>
    ) Option<cir::SemaType> {
        if (union_value->fields.len() != 1) {
            diags::report_union_init_must_contain_exactly_one_field(
                self->dctx,
                self->allocator,
                union_value->span
            );
            return .None;
        }

        const field_value = union_value->fields.get(0).unwrap();

        var union_decl_id_opt: Option<cir::UnionDeclId> = .None;
        var type_args: cir::TypedTypeArgs = cir::TypedTypeArgs.new(self->allocator);

        switch (expected_type) {
            case .Some(ty) => {
                switch (ty.as_named_type()) {
                    case .Some(named_type) => {
                        switch (named_type.type_decl_id.as_union()) {
                            case .Some(union_decl_id) => {
                                union_decl_id_opt = .Some(union_decl_id);
                                type_args = named_type.type_args;
                            }
                            case .None => {}
                        }
                    }
                    case .None => {}
                }
            }
            case .None => {}
        }

        switch (union_decl_id_opt) {
            case .Some(union_decl_id) => {
                const union_decl = self->decl_tables->unions.get_const(union_decl_id).unwrap();

                var union_name = format::format_union_decl(self->allocator, self->decl_tables, union_decl);
                defer union_name.free();

                const generic_env_opt = self->create_inference_generic_env(
                    union_name.as_str_const(),
                    union_decl->generic_params,
                    &type_args,
                    union_value->span
                );

                switch (generic_env_opt) case .Some(generic_env) else {
                    return .None;
                }

                self->push_generic_env(generic_env);
                const result = self->analyze_unnamed_union_value_inner(
                    union_value,
                    expected_type,
                    union_decl,
                    union_decl_id,
                    field_value
                );
                self->pop_generic_env();
                return result;
            }
            case .None => {}
        }

        // No expect type (Create a new union decl from the field)
        var union_decl = self->create_union_decl_from_unnamed_union_value(field_value);
        const union_decl_id = self->decl_tables->insert_union(union_decl);

        self->analyze_expr(field_value->value, .None);

        switch (field_value->value->ty) {
            case .Some(rhs_type) => {
                for (var j: usize = 0; j < union_decl.fields.len(); j += 1) {
                    const field = union_decl.fields.get(j).unwrap();
                    
                    if (field->name.as_str_const() == field_value->name.as_str_const()) {
                        field->ty = rhs_type;
                        break;
                    }
                }
            }
            case .None => {}
        }

        // Write back field types in union decl
        const union_decl_ref = self->decl_tables->unions.get(union_decl_id).unwrap();
        *union_decl_ref = union_decl;

        union_value->union_decl_id = .Some(union_decl_id);

        return .Some(.Named(cir::NamedType {
            type_decl_id: .Union(union_decl_id),
            type_args: cir::TypedTypeArgs.new(self->allocator),
        }));
    }

    fn analyze_unnamed_union_value_inner(
        self: Self*,
        union_value: cir::TypedUnnamedUnionValue*,
        expected_type: Option<cir::SemaType>,
        union_decl: const cir::UnionDecl*,
        union_decl_id: cir::UnionDeclId,
        union_field_value: cir::TypedUnnamedUnionValueField*
    ) Option<cir::SemaType> {
        const union_field = union_decl->lookup_field(union_field_value->name.as_str_const());
        switch (union_field) {
            case .Some(uf) => {
                const expected_field_type = self->substitute_type(&uf->ty);
                self->analyze_field_assign(union_field_value->value, expected_field_type, union_value->span);
            }
            case .None => {
                var type_name = format::format_union_decl(
                    self->allocator, 
                    self->decl_tables, 
                    union_decl
                );

                diags::report_object_has_no_field_named(
                    self->dctx,
                    self->allocator,
                    union_value->span,
                    type_name.as_str_const(),
                    union_field_value->name.as_str_const()
                );

                type_name.free();
                self->analyze_expr(union_field_value->value, .None);
            }
        }

        union_value->union_decl_id = .Some(union_decl_id);

        switch (expected_type) {
            case .Some(ty) => return .Some(ty);
            case .None => return .None;
        }
    }

    fn create_union_decl_from_unnamed_union_value(
        self: Self*,
        union_field_value: const cir::TypedUnnamedUnionValueField*
    ) cir::UnionDecl {
        var fields: Vec<cir::TypedUnionField> = Vec.new(self->allocator);
        
        fields.push(cir::TypedUnionField {
            name: String.from_str(self->allocator, union_field_value->name.as_str_const()),
            ty: .Placeholder,
            span: union_field_value->span,
        });

        return cir::UnionDecl {
            name: .None,
            fields,
            impls: Vec.new(self->allocator),
            methods: cir::MethodDecls.new(self->allocator),
            generic_params: cir::TypedGenericParams.new(self->allocator),
            modifiers: ast::ASTUnionModifiers {
                vis: .Public,
                repr_attr: .None,
            },
            align: .None,
            is_normalized: false,
            span: union_field_value->span,
        };
    }

    /* ************* Builtins ************* */

    pub fn analyze_builtin_expr(
        self: Self*,
        builtin_func: cir::TypedBuiltinFunc*
    ) Option<cir::SemaType> {
        switch (cir::lookup_builtin(builtin_func->name.str.as_str_const())) case .Some(builtin_kind) else {
            diags::report_builtin_not_defined(
                self->dctx,
                self->allocator,
                builtin_func->span,
                builtin_func->name.str.as_str_const()
            );
            return .None;
        }

        const builtin_spec = cir::builtin_spec_of(builtin_kind);

        if (!self->validate_builtin_form(builtin_spec, .Expr, builtin_func->span)) {
            return .None;
        }

        if (!self->validate_builtin_arg_count(builtin_spec, builtin_func->args.len(), builtin_func->span)) {
            return .None;
        }

        return self->analyze_builtin_func_semantics(builtin_kind, builtin_func);
    }

    fn validate_builtin_form(
        self: Self*,
        builtin_spec: cir::TypedBuiltinSpec,
        actual: cir::TypedBuiltinForm,
        loc: Span
    ) bool {
        if (builtin_spec.form != actual) {
            diags::report_invalid_builtin_form(
                self->dctx,
                self->allocator,
                loc,
                builtin_spec.name
            );
            return false;
        }

        return true;
    }

    fn validate_builtin_arg_count(
        self: Self*,
        spec: cir::TypedBuiltinSpec,
        count: usize,
        loc: Span
    ) bool {
        if (count < spec.min_args) {
            diags::report_builtin_too_few_args(
                self->dctx,
                self->allocator,
                loc,
                spec.name,
                spec.min_args,
                count
            );
            return false;
        }

        switch (spec.max_args) {
            case .Some(max) => {
                if (count > max) {
                    diags::report_builtin_too_many_args(
                        self->dctx,
                        self->allocator,
                        loc,
                        spec.name,
                        max,
                        count
                    );
                    return false;
                }
            }
            case .None => {}
        }

        return true;
    }

    fn analyze_builtin_func_semantics(
        self: Self*,
        builtin_kind: cir::TypedBuiltinKind,
        builtin_func: cir::TypedBuiltinFunc*
    ) Option<cir::SemaType> {
        switch (builtin_kind) {
            case .FuncName | .MethodName | .ModuleName | .FileName => {
                return self->analyze_builtin_name_ret(builtin_func);
            }
            case .Line | .Column => {
                return self->analyze_builtin_usize_ret(builtin_func);
            }
            case .Panic | .Todo | .Unimplemented | .Unreachable => {
                return self->analyze_builtin_const_msg_arg(builtin_func);
            }
            case .Memcpy => return self->analyze_builtin_copy_memset(builtin_func, true);
            case .Memset => return self->analyze_builtin_copy_memset(builtin_func, false);
            case .OffsetOf => return self->analyze_builtin_offsetof(builtin_func);
            case .AlignOf => return self->analyze_builtin_alignof(builtin_func);
            case .SizeOf => return self->analyze_builtin_sizeof(builtin_func);
            case .TypeOf => return self->analyze_builtin_typeof(builtin_func);
            case .Assert => return self->analyze_builtin_assert(builtin_func);
            case .Cast => return self->analyze_builtin_cast(builtin_func);
            
            else => return .None;
        }
    }

    fn analyze_builtin_name_ret(
        self: Self*,
        builtin_func: cir::TypedBuiltinFunc*
    ) Option<cir::SemaType> {
        const uint8_type: cir::SemaType = .Plain(.UInt8);
        const ret_type: cir::SemaType = .Pointer(alloc_init(self->allocator, uint8_type));
        builtin_func->ret_type = .Some(ret_type);
        return .Some(ret_type);
    }

    fn analyze_builtin_usize_ret(
        self: Self*,
        builtin_func: cir::TypedBuiltinFunc*
    ) Option<cir::SemaType> {
        const ret_type: cir::SemaType = .Plain(.USize);
        builtin_func->ret_type = .Some(ret_type);
        return .Some(ret_type);
    }

    fn analyze_builtin_sizeof(
        self: Self*,
        builtin_func: cir::TypedBuiltinFunc*
    ) Option<cir::SemaType> {
        const operand = builtin_func->args.get(0).unwrap();

        if (self->analyze_expr_non_terminal(operand, .None).is_none()) {
            return .None;
        }

        switch (operand->ty) {
            case .Some(ty) => {
                var ty = self->expand_sema_type(ty, builtin_func->span);
                ty = self->substitute_type(&ty);

                if (!self->check_type_arity(ty, builtin_func->span)) {
                    return .None;
                }

                operand->ty = .Some(ty);
            }
            case .None => {}
        }

        const ret_type: cir::SemaType = .Plain(.USize);
        builtin_func->ret_type = .Some(ret_type);
        return .Some(ret_type);
    }

    fn analyze_builtin_alignof(
        self: Self*,
        builtin_func: cir::TypedBuiltinFunc*
    ) Option<cir::SemaType> {
        const operand = builtin_func->args.get(0).unwrap();

        self->analyze_expr_non_terminal(operand, .None);

        switch (operand->ty) {
            case .None => {}
            case .Some(ty) => {
                var t = self->expand_sema_type(ty, builtin_func->span);
                t = self->substitute_type(&t);
                operand->ty = .Some(t);
            }
        }

        const ret_type: cir::SemaType = .Plain(.USize);
        builtin_func->ret_type = .Some(ret_type);
        return .Some(ret_type);
    }

    fn analyze_builtin_typeof(
        self: Self*,
        builtin_func: cir::TypedBuiltinFunc*
    ) Option<cir::SemaType> {
        const operand = builtin_func->args.get(0).unwrap();

        self->analyze_expr_non_terminal(operand, .None);

        switch (operand->ty) {
            case .Some(ty) => {
                if (!self->check_type_arity(ty, builtin_func->span)) {
                    return .None;
                }

                return .Some(ty);
            }
            case .None => return .None;
        }
    }

    fn analyze_builtin_offsetof(
        self: Self*,
        builtin_func: cir::TypedBuiltinFunc*
    ) Option<cir::SemaType> {
        for (var i: usize = 0; i < builtin_func->args.len(); i += 1) {
            const arg = builtin_func->args.get(i).unwrap();
            self->analyze_expr_non_terminal(arg, .None);
        }

        const type_expr = builtin_func->args.get(0).unwrap();
        const field_name_expr = builtin_func->args.get(1).unwrap();

        var ty: cir::SemaType = .Placeholder;

        switch (type_expr->ty) {
            case .None => return .None;
            case .Some(t) => ty = t;
        }

        ty = self->expand_sema_type(ty, builtin_func->span);
        ty = self->substitute_type(&ty);

        if (!ty.is_struct()) {
            var type_name = format::format_sema_type(self->allocator, self->decl_tables, &ty);

            diags::report_invalid_offset_of_operand(
                self->dctx,
                self->allocator,
                builtin_func->span,
                type_name.as_str_const()
            );

            type_name.free();
            return .None;
        }

        switch (field_name_expr->literal_const_string_value()) case .Some(field_name) else {
            diags::report_offset_of_field_must_be_string(
                self->dctx,
                self->allocator,
                builtin_func->span
            );
            return .None;
        }

        switch (ty.as_struct()) case .Some(struct_decl_id) else {
            return .None;
        }

        const struct_decl = self->decl_tables->structs.get_const(struct_decl_id).unwrap();
        
        var struct_name = format::format_struct_decl(
            self->allocator, 
            self->decl_tables, 
            struct_decl
        );
        defer struct_name.free();

        var field_exists = false;

        for (var j: usize = 0; j < struct_decl->fields.len(); j += 1) {
            const field = struct_decl->fields.get_const(j).unwrap();

            if (field->name.as_str_const() == field_name) {
                field_exists = true;
                break;
            }
        }

        if (!field_exists) {
            diags::report_object_has_no_field_named(
                self->dctx,
                self->allocator,
                builtin_func->span,
                struct_name.as_str_const(),
                field_name
            );
            return .None;
        }


        const ret_type: cir::SemaType = .Plain(.USize);
        builtin_func->ret_type = .Some(ret_type);
        return .Some(ret_type);
    }

    fn analyze_builtin_cast(
        self: Self*,
        builtin_func: cir::TypedBuiltinFunc*
    ) Option<cir::SemaType> {
        const type_arg = builtin_func->args.get(0).unwrap();
        const value_arg = builtin_func->args.get(1).unwrap();

        self->analyze_expr_non_terminal(type_arg, .None);
        self->analyze_expr(value_arg, .None);

        switch (type_arg->kind.as_type_expr(self->allocator)) case .Some(var target_type) else {
            diags::report_builtin_cast_requires_type_argument(
                self->dctx,
                self->allocator,
                builtin_func->span
            );
            return .None;
        }

        switch (type_arg->kind) {
            case .SemaType { .. } => {
                switch (type_arg->ty) {
                    case .Some(ty) => {
                        target_type = ty;
                    }
                    case .None => {}
                }
            }
            else => {}
        }

        target_type = self->expand_sema_type(target_type, builtin_func->span);
        target_type = self->substitute_type(&target_type);

        var value_type: cir::SemaType = .Placeholder;

        switch (value_arg->ty) {
            case .Some(ty) => value_type = ty;
            case .None => return .None;
        }

        value_type = self->expand_sema_type(value_type, builtin_func->span);

        if (!self->is_explicit_cast_allowed(value_type, target_type, builtin_func->span)) {
            var value_type_str = format::format_sema_type(self->allocator, self->decl_tables, &value_type);
            var target_type_str = format::format_sema_type(self->allocator, self->decl_tables, &target_type);

            diags::report_cannot_cast(
                self->dctx,
                self->allocator,
                builtin_func->span,
                value_type_str.as_str_const(),
                target_type_str.as_str_const()
            );

            value_type_str.free();
            target_type_str.free();
            return .None;
        }

        // Update analyzed type argument
        type_arg->kind = .SemaType {
            ty: target_type,
            span: builtin_func->span,
        };
        type_arg->ty = .Some(target_type);
        builtin_func->ret_type = .Some(target_type);
        return .Some(target_type);
    }

    fn builtin_copy_memset_param_type(
        self: Self*,
        is_memcpy: bool,
        idx: usize
    ) cir::SemaType {
        const void_type: cir::SemaType = .Plain(.Void);
        const const_void_ty: cir::SemaType = .Const(alloc_init(self->allocator, void_type));

        var param: cir::SemaType = .Plain(.USize);

        if (idx == 0) {
            param = .Pointer(alloc_init(self->allocator, void_type));
        } else if (idx == 1) {
            if (is_memcpy) {
                param = .Pointer(alloc_init(self->allocator, const_void_ty));
            } else {
                param = .Plain(.Int8);
            }
        }

        return param;
    }

    fn builtin_const_msg_param_type(self: Self*) cir::SemaType {
        const uint8_type: cir::SemaType = .Plain(.UInt8);
        const const_uint8_type: cir::SemaType = .Const(alloc_init(self->allocator, uint8_type));
        return .Pointer(alloc_init(self->allocator, const_uint8_type));
    }

    fn report_builtin_param_mismatch(
        self: Self*,
        builtin_func: cir::TypedBuiltinFunc*,
        argument_idx: usize,
        argument_type: const cir::SemaType*,
        param_type: const cir::SemaType*
    ) {
        var argument_type_str = format::format_sema_type(self->allocator, self->decl_tables, argument_type);
        var param_type_str = format::format_sema_type(self->allocator, self->decl_tables, param_type);

        diags::report_func_call_param_type_mismatch(
            self->dctx,
            self->allocator,
            builtin_func->span,
            @cast(uint32, argument_idx),
            argument_type_str.as_str_const(),
            param_type_str.as_str_const()
        );

        argument_type_str.free();
        param_type_str.free();
    }

    fn analyze_builtin_copy_memset(
        self: Self*,
        builtin_func: cir::TypedBuiltinFunc*,
        is_memcpy: bool
    ) Option<cir::SemaType> {
        for (var i: usize = 0; i < builtin_func->args.len(); i += 1) {
            const expect = self->builtin_copy_memset_param_type(is_memcpy, i);
            const arg = builtin_func->args.get(i).unwrap();
            
            self->analyze_expr_non_terminal(arg, .Some(expect));
        }

        for (var i: usize = 0; i < builtin_func->args.len(); i += 1) {
            const expect = self->builtin_copy_memset_param_type(is_memcpy, i);
            const arg = builtin_func->args.get(i).unwrap();
            
            switch (arg->ty) {
                case .Some(arg_type) => {
                    if (!self->is_assignable_to(arg_type, expect, builtin_func->span)) {
                        self->report_builtin_param_mismatch(builtin_func, i, &arg_type, &expect);
                        return .None;
                    }
                }
                case .None => return .None;
            }
        }

        const ret_type: cir::SemaType = .Plain(.Void);
        builtin_func->ret_type = .Some(ret_type);
        return .Some(ret_type);
    }

    fn analyze_builtin_const_msg_arg(
        self: Self*,
        builtin_func: cir::TypedBuiltinFunc*
    ) Option<cir::SemaType> {
        const expect = self->builtin_const_msg_param_type();

        for (var i: usize = 0; i < builtin_func->args.len(); i += 1) {
            const arg = builtin_func->args.get(i).unwrap();
            self->analyze_expr_non_terminal(arg, .Some(expect));
        }

        for (var i: usize = 0; i < builtin_func->args.len(); i += 1) {
            const arg = builtin_func->args.get(i).unwrap();

            switch (arg->ty) {
                case .Some(arg_type) => {
                    if (!self->is_assignable_to(arg_type, expect, builtin_func->span)) {
                        self->report_builtin_param_mismatch(builtin_func, i, &arg_type, &expect);
                        return .None;
                    }
                }
                case .None => return .None;
            }
        }

        const ret_type: cir::SemaType = .Plain(.Void);
        builtin_func->ret_type = .Some(ret_type);
        return .Some(ret_type);
    }

    fn analyze_builtin_assert(
        self: Self*,
        builtin_func: cir::TypedBuiltinFunc*
    ) Option<cir::SemaType> {
        if (builtin_func->args.len() > 0) {
            const cond = builtin_func->args.get(0).unwrap();
            self->analyze_cond_expr(cond);
        }

        if (builtin_func->args.len() > 1) {
            const msg = builtin_func->args.get(1).unwrap();
            const expect = self->builtin_const_msg_param_type();

            self->analyze_expr_non_terminal(msg, .Some(expect));

            switch (msg->ty) {
                case .Some(arg_type) => {
                    if (!self->is_assignable_to(arg_type, expect, builtin_func->span)) {
                        self->report_builtin_param_mismatch(builtin_func, 1, &arg_type, &expect);
                        return .None;
                    }
                }
                case .None => return .None;
            }

            if (msg->literal_const_string_value().is_none()) {
                diags::report_assert_message_must_be_const_string_literal(
                    self->dctx,
                    self->allocator,
                    builtin_func->span
                );
                return .None;
            }
        }

        const ret_type: cir::SemaType = .Plain(.Void);
        builtin_func->ret_type = .Some(ret_type);
        return .Some(ret_type);
    }

    fn is_explicit_cast_allowed(
        self: Self*,
        value_type: cir::SemaType,
        target_type: cir::SemaType,
        loc: Span
    ) bool {
        if (self->is_assignable_to(value_type, target_type, loc)) {
            return true;
        }

        const value_base = value_type.const_inner();
        const target_base = target_type.const_inner();

        var allowed = false;

        switch (*value_base) {
            case .Plain(value_pt) => {
                switch (*target_base) {
                    case .Plain(target_pt) => {
                        if (value_pt.is_integer() && target_pt.is_integer()) {
                            allowed = true;
                        } else if (value_pt.is_float() && target_pt.is_float()) {
                            allowed = true;
                        } else if ((value_pt.is_integer() && target_pt.is_float()) || (value_pt.is_float() && target_pt.is_integer())) {
                            allowed = true;
                        } else if (value_pt == .Bool && target_pt.is_integer()) {
                            allowed = true;
                        }
                    }
                    case .Pointer => {
                        allowed = value_pt == .IntPtr || value_pt == .UIntPtr;
                    }
                    case .Named(named_type) => {
                        allowed = self->enum_plain_cast_allowed(&named_type, value_pt);
                    }
                    else => {}
                }
            }
            case .Pointer => {
                switch (*target_base) {
                    case .Plain(target_pt) => {
                        allowed = target_pt == .IntPtr || target_pt == .UIntPtr;
                    }
                    else => {}
                }
            }
            case .Named(named_type) => {
                switch (*target_base) {
                    case .Plain(plain_type) => {
                        allowed = self->enum_plain_cast_allowed(&named_type, plain_type);
                    }
                    else => {}
                }
            }
            else => {}
        }

        return allowed;
    }

    fn enum_plain_cast_allowed(
        self: Self*,
        named_type: const cir::NamedType*,
        plain_type: cir::PlainType
    ) bool {
        if (named_type->type_decl_id.as_enum().is_none()) {
            return false;
        }

        const enum_decl_id = named_type->type_decl_id.as_enum().unwrap();
        const enum_decl = self->decl_tables->enums.get_const(enum_decl_id).unwrap();

        var ok = false;

        switch (enum_decl->tag_type) {
            case .Some(tag_ty) => {
                const inner = tag_ty.const_inner();

                switch (*inner) {
                    case .Plain(pt) => {
                        ok = pt.is_integer_or_bool();
                    }
                    else => {
                        ok = false;
                    }
                }
            }
            case .None => ok = true;
        }

        return ok && plain_type.is_integer_or_bool();
    }

    /* ************* Inline ASM ************* */

    pub fn analyze_inline_asm_expr(
        self: Self*,
        asm: cir::TypedInlineAsm*
    ) Option<cir::SemaType> {
        self->validate_asm_template(asm);
        self->validate_asm_outputs(asm);
        self->validate_asm_inputs(asm);
        self->validate_asm_clobbers(asm);
        self->validate_asm_template_indices(asm);
        self->validate_asm_constraint_types(asm);

        switch (asm->outputs.len()) {
            case 0 => {
                return .Some(cir::SemaType.Plain(.Void));
            }
            case 1 => {
                const operand = asm->outputs.get(0).unwrap();

                switch (operand->expr->ty) {
                    case .Some(ty) => return .Some(ty);
                    case .None => return .None;
                }
            }
            else => {
                var elements: Vec<cir::TypedTupleElement> = Vec.new(self->allocator);

                for (var i: usize = 0; i < asm->outputs.len(); i += 1) {
                    const operand = asm->outputs.get_const(i).unwrap();

                    switch (operand->expr->ty) {
                        case .Some(ty) => {
                            elements.push(cir::TypedTupleElement {
                                ty,
                                span: operand->span,
                            });
                        }
                        case .None => {
                            return .None;
                        }
                    }
                }

                const ret_type: cir::SemaType = .Tuple(cir::TypedTupleType {
                    elements,
                    span: asm->span,
                });
                return .Some(ret_type);
            }
        }
    }

    fn validate_asm_template(self: Self*, asm: cir::TypedInlineAsm*) {
        if (asm->template.len() == 0) {
            diags::report_asm_empty_template(self->dctx, self->allocator, asm->span);
        }
    }

    fn validate_asm_outputs(self: Self*, asm: cir::TypedInlineAsm*) {
        for (var i: usize = 0; i < asm->outputs.len(); i += 1) {
            const operand = asm->outputs.get(i).unwrap();

            self->analyze_expr_non_terminal(operand->expr, .None);

            var is_poisoned = false;

            switch (operand->expr->ty) {
                case .Some(ty) => is_poisoned = ty.contains_error();
                case .None => is_poisoned = false;
            }

            if (!operand->expr->is_lvalue() && !is_poisoned) {
                diags::report_asm_output_not_lvalue(self->dctx, self->allocator, operand->span);
            }

            const trimmed = asm_trim_constraint(self->allocator, operand->constraint.as_str_const());
            defer trimmed.free();
            
            const first = trimmed.as_str_const()[0];

            if (first != '=' && first != '+') {
                diags::report_asm_invalid_output_constraint(
                    self->dctx,
                    self->allocator,
                    operand->span,
                    operand->constraint.as_str_const()
                );
            }
        }
    }

    fn validate_asm_inputs(self: Self*, asm: cir::TypedInlineAsm*) {
        for (var i: usize = 0; i < asm->inputs.len(); i += 1) {
            const operand = asm->inputs.get(i).unwrap();

            self->analyze_expr_non_terminal(operand->expr, .None);

            const trimmed = asm_trim_constraint(self->allocator, operand->constraint.as_str_const());
            defer trimmed.free();

            const first = trimmed.as_str_const()[0];

            if (first == '=' || first == '+') {
                diags::report_asm_invalid_input_constraint(
                    self->dctx,
                    self->allocator,
                    operand->span,
                    operand->constraint.as_str_const()
                );
            }
        }
    }

    fn validate_asm_clobbers(self: Self*, asm: cir::TypedInlineAsm*) {
        var seen: Vec<String> = Vec.new(self->allocator);

        for (var i: usize = 0; i < asm->clobbers.len(); i += 1) {
            const clobber = asm->clobbers.get_const(i).unwrap();

            var name = clobber->name.clone(self->allocator);
            name.to_lower();

            var already_seen = false;

            for (var j: usize = 0; j < seen.len(); j += 1) {
                const item = seen.get_const(j).unwrap();

                if (item->as_str_const() == name.as_str_const()) {
                    already_seen = true;
                    break;
                }
            }

            if (already_seen) {
                diags::report_asm_duplicate_clobber(
                    self->dctx,
                    self->allocator,
                    clobber->span,
                    clobber->name.as_str_const()
                );
                name.free();
            } else {
                seen.push(name);
            }
        }

        free_strings(&seen);
    }

    fn validate_asm_template_indices(self: Self*, asm: cir::TypedInlineAsm*) {
        const total_operands = asm->outputs.len() + asm->inputs.len();

        for (var li: usize = 0; li < asm->template.len(); li += 1) {
            const line = asm->template.get_const(li).unwrap();
            const chars = line->as_str_const();

            var i: usize = 0;

            while (chars[i] != 0) {
                if (chars[i] == '%') {
                    i += 1;

                    if (chars[i] >= '0' && chars[i] <= '9') {
                        var index: usize = 0;

                        while (chars[i] != 0 && chars[i] >= '0' && chars[i] <= '9') {
                            index = (index * 10) + @cast(usize, chars[i] - '0');
                            i += 1;
                        }

                        if (index >= total_operands) {
                            diags::report_asm_operand_index_out_of_bounds(
                                self->dctx,
                                self->allocator,
                                asm->span,
                                index,
                                total_operands,
                                asm->outputs.len(),
                                asm->inputs.len()
                            );
                        }
                    }
                } else {
                    i += 1;
                }
            }
        }
    }

    fn validate_asm_constraint_types(self: Self*, asm: cir::TypedInlineAsm*) {
        for (var i: usize = 0; i < asm->outputs.len(); i += 1) {
            const operand = asm->outputs.get_const(i).unwrap();
            self->validate_asm_operand_constraint_types(operand);
        }

        for (var i: usize = 0; i < asm->inputs.len(); i += 1) {
            const operand = asm->inputs.get_const(i).unwrap();
            self->validate_asm_operand_constraint_types(operand);
        }
    }

    fn validate_asm_operand_constraint_types(
        self: Self*,
        operand: const cir::TypedAsmOperand*
    ) {
        const raw = asm_trim_constraint(self->allocator, operand->constraint.as_str_const());
        defer raw.free();

        const raw_str = raw.as_str_const();

        var bare = String.new(self->allocator);
        defer bare.free();

        var i: usize = 0;

        while (raw_str[i] == '{' || raw_str[i] == '}') {
            i += 1;
        }
        while (raw_str[i] == '=' || raw_str[i] == '+') {
            i += 1;
        }
        while (raw_str[i] == '{' || raw_str[i] == '}') {
            i += 1;
        }
        while (raw_str[i] != 0 && raw_str[i] != '{' && raw_str[i] != '}') {
            bare.push(raw_str[i]);
            i += 1;
        }

        switch (operand->expr->ty) {
            case .Some(ty) => {
                if (ty.contains_error()) {
                    return;
                }

                const bare_str = bare.as_str_const();

                var ok = true;
                var hint = "";

                if (bare_str == "r" || bare_str == "g") {
                    ok = asm_is_integer_bool_or_pointer(&ty);
                    hint = "constraint `r`/`g` requires an integer, bool, or pointer";
                } else if (bare_str == "m") {
                    ok = ty.is_pointer();
                    hint = "constraint `m` requires a pointer";
                } else if (bare_str == "i") {
                    ok = asm_is_integer_bool_or_pointer(&ty);
                    if (ok) {
                        ok = fold_const_expr_int(self->decl_tables, self->registry, operand->expr).is_some();
                    }
                    hint = "constraint `i` requires a compile-time constant integer";
                }

                if (!ok) {
                    var found = format::format_sema_type(self->allocator, self->decl_tables, &ty);

                    diags::report_asm_constraint_type_mismatch(
                        self->dctx,
                        self->allocator,
                        operand->span,
                        bare_str,
                        found.as_str_const(),
                        hint
                    );

                    found.free();
                }
            }
            case .None => {}
        }
    }

    /* ************* Function / Method Calls ************* */

    pub fn analyze_func_call(self: Self*, func_call: cir::TypedFuncCall*) Option<cir::SemaType> {
        var func_decl_id_opt: Option<cir::FuncDeclId> = .None;

        switch (func_call->operand->kind.as_unresolved_symbol_id()) {
            case .Some(symbol_id) => {
                switch (self->registry->lookup_symbol_as_decl_id(symbol_id)) {
                    case .Some(decl_id) => func_decl_id_opt = decl_id.as_func();
                    case .None => {}
                }
            }
            case .None => {}
        }

        if (func_decl_id_opt.is_none()) {
            switch (func_call->operand->kind.as_resolved_decl_id()) {
                case .Some(decl_id) => {
                    func_decl_id_opt = decl_id.as_func();
                }
                case .None => {}
            }
        }

        var operand_type: cir::SemaType = .Placeholder;

        switch (self->analyze_expr_non_terminal(func_call->operand, .None)) {
            case .Some(ty) => operand_type = ty;
            case .None => return .None;
        }

        operand_type = self->expand_sema_type(operand_type, func_call->span);

        // Prevent cascading failures
        if (operand_type.contains_error()) {
            return .Some(.Err(func_call->span));
        }

        self->normalize_type_args(&func_call->type_args, 0);

        switch (operand_type.as_func_type()) case .Some(var func_type) else {
            var type_name = format::format_sema_type(self->allocator, self->decl_tables, &operand_type);
            
            diags::report_non_function_symbol(
                self->dctx, 
                self->allocator, 
                func_call->span, 
                type_name.as_str_const()
            );
            
            type_name.free();
            return .None;
        }

        switch (func_decl_id_opt) {
            // Named function call
            case .Some(func_decl_id) => {
                var func_decl = self->decl_tables->funcs.get_owned(func_decl_id).unwrap();
                
                func_decl.params = clone_func_params_list(self->allocator, &func_decl.params);
                
                var original_params = clone_func_params_list(self->allocator, &func_decl.params);

                if (func_decl.is_generic()) {
                    const decl_id: cir::DeclId = .Func(func_decl_id);
                    
                    var type_name = format::format_decl_name(self->allocator, self->decl_tables, &decl_id);
                    defer type_name.free();
                    
                    const generic_env_opt = self->create_inference_generic_env(
                        type_name.as_str_const(),
                        func_decl.generic_params,
                        &func_call->type_args,
                        func_call->span
                    );

                    switch (generic_env_opt) {
                        case .Some(env) => {
                            self->push_generic_env(env);
                            const result = self->analyze_func_call_generic(
                                &operand_type,
                                func_call,
                                func_decl_id,
                                &func_decl,
                                &original_params
                            );
                            self->pop_generic_env();
                            return result;
                        }
                        case .None => return .None;
                    }
                } else {
                    self->normalize_func_params(&func_decl.params, false, 0);

                    if (!self->analyze_call(&original_params, &func_decl, &func_call->args, func_call->span, false)) {
                        return .None;
                    }

                    func_call->dispatch = .Normal { func_decl_id };
                    return .Some(func_decl.ret_type);
                }
            }
            // Lambda call
            case .None => {
                if (!func_call->type_args.is_empty()) {
                    var type_name = format::format_sema_type(self->allocator, self->decl_tables, &operand_type);
                    
                    diags::report_unexpected_type_args(
                        self->dctx, 
                        self->allocator, 
                        func_call->span, 
                        type_name.as_str_const()
                    );

                    type_name.free();
                }

                self->normalize_func_type_params(&func_type.params, func_call->span, 0);

                switch (self->normalize_and_check_type_formation(*func_type.ret_type, func_call->span, 0)) {
                    case .Some(normalized_ret) => {
                        func_type.ret_type = alloc_init(self->allocator, normalized_ret);
                    }
                    case .None => {
                        return .None;
                    }
                }

                switch (self->check_func_type_call(&func_type, &func_call->args, func_call->span)) {
                    case .Some(ret_type) => {
                        func_call->dispatch = .FunctionPointer { func_type };
                        return .Some(ret_type);
                    }
                    case .None => {
                        return .None;
                    }
                }
            }
        }
    }

    fn analyze_func_call_generic(
        self: Self*,
        operand_type: const cir::SemaType*,
        func_call: cir::TypedFuncCall*,
        func_decl_id: cir::FuncDeclId,
        func_decl: cir::FuncDecl*,
        original_params: const cir::TypedFuncParams*
    ) Option<cir::SemaType> {
        self->normalize_func_params(&func_decl->params, false, 0);

        if (!self->analyze_call(original_params, func_decl, &func_call->args, func_call->span, false)) {
            return .None;
        }

        const final_type_args = self->collect_instantiated_type_args(func_decl->generic_params);
        const func_type = func_decl_as_func_type(self->allocator, func_decl);

        var new_env = self->create_func_def_env(func_decl->name.as_str_const(), func_type, self->func_env.infer);
        var old_env = self->func_env;
        self->func_env = new_env;

        // FIXME
        // NOTE: swapping func_env by value; new_env's heap infer/name leak
        // (shared infer pointer would double-free if FuncEnv.free were called).
        const ret_type = self->monomorphize_generic_func_call(
            operand_type,
            func_call,
            func_decl_id,
            func_decl,
            &final_type_args
        );

        self->func_env = old_env;
        return ret_type;
    }

    fn create_func_def_env(
        self: Self*,
        name: const uint8*,
        func_type: cir::TypedFuncType,
        parent_infer: Option<infer::InferCtx*>
    ) FuncEnv {
        var env = FuncEnv.new(self->allocator);
        env.current_func_name = .Some(String.from_str(self->allocator, name));
        env.current_func = .Some(func_type);
        env.infer = parent_infer;
        
        if (env.infer.is_none()) {
            env.infer = .Some(alloc_init(self->allocator, infer::InferCtx.new(self->allocator)));
        }

        return env;
    }

    fn create_method_env(
        self: Self*,
        method_decl_id: cir::MethodDeclId,
        func_type: cir::TypedFuncType,
        parent_infer: Option<infer::InferCtx*>
    ) FuncEnv {
        var env = FuncEnv.new(self->allocator);
        env.current_func = .Some(func_type);
        env.current_method = .Some(method_decl_id);
        env.infer = parent_infer;
        
        if (env.infer.is_none()) {
            env.infer = .Some(alloc_init(self->allocator, infer::InferCtx.new(self->allocator)));
        }

        return env;
    }

    pub fn analyze_method_call(
        self: Self*,
        method_call: cir::TypedMethodCall*,
        expected_type: Option<cir::SemaType>
    ) Option<cir::SemaType> {
        if (self->analyze_expr_non_terminal(method_call->operand, .None).is_none()) {
            return .None;
        }

        self->normalize_type_args(&method_call->type_args, 0);

        // Operand type is only present when
        // the operand is a generic enum decl.
        // Extract the `decl_id` manually when
        // the operand kind is a `TypedSymbolExpr`.

        var is_operand_instance = true;
        var operand_type_opt: Option<cir::SemaType> = .None;

        switch (method_call->operand->kind.as_resolved_decl_id()) {
            case .Some(decl_id) => {
                switch (decl_id.as_type_decl_id()) {
                    // Operand of a static method call
                    case .Some(type_decl_id) => {
                        is_operand_instance = false;

                        operand_type_opt = .Some(.Named(cir::NamedType {
                            type_decl_id,
                            type_args: cir::TypedTypeArgs.new(self->allocator),
                        }));
                    }
                    case .None => {
                        is_operand_instance = true;

                        if (decl_id.is_var_or_global_var()) {
                            // Extract variable type and use it as operand type
                            // for instance method calls
                            switch (self->resolve_symbol_type(decl_id, method_call->span, 0)) {
                                case .Some(ty) => operand_type_opt = .Some(ty);
                                case .None => return .None;
                            }
                        }
                    }
                }
            }
            case .None => {
                switch (method_call->operand->kind.as_type_expr(self->allocator)) {
                    case .Some(sema_type) => {
                        is_operand_instance = false;
                        operand_type_opt = .Some(sema_type);
                    }
                    case .None => {
                        switch (method_call->operand->ty) {
                            case .Some(ty) => operand_type_opt = .Some(ty);
                            case .None => {}
                        }
                    }
                }
            }
        }

        var operand_type: cir::SemaType = .Placeholder;

        switch (operand_type_opt) {
            case .Some(ty) => {
                operand_type = ty;
            }
            case .None => {
                switch (method_call->operand->ty) {
                    case .Some(ty) => {
                        var type_name = format::format_sema_type(self->allocator, self->decl_tables, &ty);
                        
                        diags::report_object_not_supports_methods(
                            self->dctx,
                            self->allocator,
                            method_call->span,
                            type_name.as_str_const()
                        );

                        type_name.free();
                        return .None;
                    }
                    case .None => return .None;
                }
            }
        }

        switch (self->normalize_sema_type(operand_type, method_call->span, 0)) {
            case .Some(normalized) => operand_type = normalized;
            case .None => return .None;
        }

        operand_type = self->expand_sema_type(operand_type, method_call->span);

        // Prevent cascading failures
        if (operand_type.contains_error()) {
            return .Some(.Err(method_call->span));
        }

        const is_operand_interface = operand_type.as_interface_object().is_some() || operand_type.is_interface();

        if (is_operand_instance) {
            return self->analyze_instance_method_call(method_call, &operand_type, expected_type);
        } else if (is_operand_interface) {
            return self->analyze_interface_method_call(method_call, &operand_type, expected_type);
        } else {
            return self->analyze_static_method_call(method_call, &operand_type, expected_type);
        }
    }

    fn analyze_instance_method_call(
        self: Self*,
        method_call: cir::TypedMethodCall*,
        operand_type: const cir::SemaType*,
        expected_type: Option<cir::SemaType>
    ) Option<cir::SemaType> {
        const pure_operand_type = *operand_type->const_inner()->pointer_inner();

        const is_interface = pure_operand_type.is_interface_object() || pure_operand_type.as_named_interface().is_some();

        if (is_interface) {
            return self->analyze_interface_method_call(method_call, operand_type, expected_type);
        }

        var type_decl_id_opt: Option<cir::TypeDeclId> = .None;
        var method_decls_opt: Option<const cir::MethodDecls*> = .None;
        
        switch (pure_operand_type.as_named_type()) {
            case .Some(named_type) => {
                switch (method_decls_of_named_type(self->decl_tables, &named_type)) {
                    case .Some(method_decls) => {
                        type_decl_id_opt = .Some(named_type.type_decl_id);
                        method_decls_opt = .Some(method_decls);
                    }
                    case .None => {}
                }
            }
            case .None => {}
        }

        if (type_decl_id_opt.is_none()) {
            switch (method_call->operand->ty) {
                case .Some(ty) => {
                    var type_name = format::format_sema_type(self->allocator, self->decl_tables, &ty);
                    
                    diags::report_object_not_supports_methods(
                        self->dctx,
                        self->allocator,
                        method_call->span,
                        type_name.as_str_const()
                    );

                    type_name.free();
                }
                case .None => {}
            }
            return .None;
        }

        self->analyze_expr(method_call->operand, .None);

        const is_operand_const_qualified =
            self->is_const_qualified_lvalue(method_call->operand);

        return self->analyze_method_call_internal(
            method_call,
            method_decls_opt.unwrap(),
            type_decl_id_opt.unwrap(),
            *operand_type,
            true,
            false,
            is_operand_const_qualified,
            expected_type
        );
    }

    fn analyze_static_method_call(
        self: Self*,
        method_call: cir::TypedMethodCall*,
        operand_type: const cir::SemaType*,
        expected_type: Option<cir::SemaType>
    ) Option<cir::SemaType> {
        const pure_operand_type = *operand_type->const_inner()->pointer_inner();

        var type_decl_id_opt: Option<cir::TypeDeclId> = .None;
        var method_decls_opt: Option<const cir::MethodDecls*> = .None;
        
        switch (pure_operand_type.as_named_type()) {
            case .Some(named_type) => {
                switch (method_decls_of_named_type(self->decl_tables, &named_type)) {
                    case .Some(method_decls) => {
                        type_decl_id_opt = .Some(named_type.type_decl_id);
                        method_decls_opt = .Some(method_decls);
                    }
                    case .None => {}
                }
            }
            case .None => {}
        }

        if (type_decl_id_opt.is_none()) {
            switch (method_call->operand->ty) {
                case .Some(ty) => {
                    var operand_str = format::format_sema_type(self->allocator, self->decl_tables, &ty);
                    defer operand_str.free();
                    diags::report_object_not_supports_methods(
                        self->dctx,
                        self->allocator,
                        method_call->span,
                        operand_str.as_str_const()
                    );
                }
                case .None => {}
            }
            return .None;
        }

        return self->analyze_method_call_internal(
            method_call,
            method_decls_opt.unwrap(),
            type_decl_id_opt.unwrap(),
            *operand_type,
            false,
            false,
            false,
            expected_type
        );
    }

    fn analyze_method_call_internal(
        self: Self*,
        method_call: cir::TypedMethodCall*,
        method_decls: const cir::MethodDecls*,
        type_decl_id: cir::TypeDeclId,
        var operand_type: cir::SemaType,
        is_instance_method_call: bool,
        is_interface_method_call: bool,
        is_operand_const_qualified: bool,
        expected_type: Option<cir::SemaType>
    ) Option<cir::SemaType> {
        var pure_operand_type: cir::SemaType = *operand_type.const_inner()->pointer_inner();

        var object_name = format::format_type_decl_name(self->allocator, self->decl_tables, type_decl_id);
        defer object_name.free();
        
        switch (method_decls->get(method_call->name.as_str_const())) case .Some(method_decl_id) else {
            diags::report_object_method_not_defined(
                self->dctx,
                self->allocator,
                method_call->span,
                object_name.as_str_const(),
                method_call->name.as_str_const()
            );
            return .None;
        }

        var operand_generic_params: cir::TypedGenericParams = cir::TypedGenericParams.new(self->allocator);
        var operand_type_args: cir::TypedTypeArgs = cir::TypedTypeArgs.new(self->allocator);

        switch (pure_operand_type.as_named_type()) {
            case .Some(named_type) => {
                operand_generic_params = *type_decl_generic_params(self->decl_tables, named_type.type_decl_id);
                operand_type_args = named_type.type_args;
            }
            case .None => {}
        }

        var type_name = format::format_sema_type(self->allocator, self->decl_tables, &operand_type);
        
        const operand_generic_env_opt = self->create_inference_generic_env(
            type_name.as_str_const(),
            operand_generic_params,
            &operand_type_args,
            method_call->span
        );

        type_name.free();

        switch (operand_generic_env_opt) case .Some(operand_generic_env) else {
            return .None;
        }

        var method_decl = self->decl_tables->methods.get_owned(method_decl_id).unwrap();
        
        method_decl.func_decl.params = clone_func_params_list(self->allocator, &method_decl.func_decl.params);
        
        var original_params = clone_func_params_list(self->allocator, &method_decl.func_decl.params);

        if (method_decl.is_instance_method() && !is_instance_method_call) {
            diags::report_instance_method_call_on_type(
                self->dctx,
                self->allocator,
                method_call->span,
                method_decl.func_decl.name.as_str_const()
            );
            return .None;
        }

        if (!method_decl.is_instance_method() && is_instance_method_call) {
            diags::report_static_method_call_on_instance(
                self->dctx,
                self->allocator,
                method_call->span,
                method_decl.func_decl.name.as_str_const()
            );
            return .None;
        }

        const method_generic_params = method_decl.func_decl.generic_params;

        const method_generic_env_opt = self->create_inference_generic_env(
            method_call->name.as_str_const(),
            method_generic_params,
            &method_call->type_args,
            method_call->span
        );

        switch (method_generic_env_opt) case .Some(method_generic_env) else {
            return .None;   
        }

        var generic_env = operand_generic_env.merge(&method_generic_env);
        
        const is_generic_method_call = !generic_env.params.is_empty();

        self->push_generic_env(generic_env);
        const result = self->analyze_method_call_with_env(
            method_call,
            method_decl_id,
            &method_decl,
            &original_params,
            method_decls,
            &operand_type,
            &pure_operand_type,
            operand_generic_params,
            method_generic_params,
            object_name.as_str_const(),
            type_decl_id,
            is_instance_method_call,
            is_interface_method_call,
            is_operand_const_qualified,
            is_generic_method_call,
            expected_type
        );
        self->pop_generic_env();
        return result;
    }

    fn analyze_method_call_with_env(
        self: Self*,
        method_call: cir::TypedMethodCall*,
        method_decl_id: cir::MethodDeclId,
        method_decl: cir::MethodDecl*,
        original_params: const cir::TypedFuncParams*,
        method_decls: const cir::MethodDecls*,
        operand_type: cir::SemaType*,
        pure_operand_type: cir::SemaType*,
        operand_generic_params: cir::TypedGenericParams,
        method_generic_params: cir::TypedGenericParams,
        object_name: const uint8*,
        type_decl_id: cir::TypeDeclId,
        is_instance_method_call: bool,
        is_interface_method_call: bool,
        is_operand_const_qualified: bool,
        is_generic_method_call: bool,
        expected_type: Option<cir::SemaType>
    ) Option<cir::SemaType> {
        self->normalize_func_params(&method_decl->func_decl.params, true, 0);

        if (!self->analyze_call(
            original_params,
            &method_decl->func_decl,
            &method_call->args,
            method_call->span,
            is_instance_method_call
        )) {
            return .None;
        }

        self->validate_method_call(
            operand_type,
            method_decl,
            method_decls,
            object_name,
            method_call->is_thin_arrow,
            is_interface_method_call,
            is_operand_const_qualified,
            method_call->span
        );

        const inferred_type_args = self->collect_instantiated_type_args(operand_generic_params);

        self->unify_with_expected_type(
            .Named(cir::NamedType { type_decl_id, type_args: inferred_type_args }),
            expected_type
        );

        // Apply defaults for generics
        self->apply_generic_defaults(method_generic_params);
        self->apply_generic_defaults(operand_generic_params);

        // Instantiate operand type with collected type args
        *operand_type = self->substitute_type(operand_type);

        if (self->set_operand_named_type_args(operand_type, operand_generic_params)) {
            *pure_operand_type = *operand_type->const_inner()->pointer_inner();
        }

        const final_generics_params = extend_generic_params(
            self->allocator,
            &method_generic_params,
            &operand_generic_params
        );

        const final_type_args = self->collect_instantiated_type_args(final_generics_params);

        method_call->type_args = final_type_args;

        if (is_generic_method_call) {
            const func_type = func_decl_as_func_type(self->allocator, &method_decl->func_decl);

            var new_env = self->create_method_env(method_decl_id, func_type, self->func_env.infer);
            var old_env = self->func_env;
            self->func_env = new_env;

            // Substitute Self inside the self modifier
            switch (method_decl->func_decl.params.list.first()) {
                case .Some(first_kind) => {
                    // FIXME: Make sure first_kind is a `T*` because 
                    // when doing pattern matching in Cyrus, 
                    // it's byval (copy) so we need to make sure
                    // when writing back the updated value,
                    // it really affects func_decl.params
                    switch (*first_kind) {
                        case .SelfModifier(var self_modifier) => {
                            self_modifier.ty = self->substitute_self_type(&self_modifier.ty, pure_operand_type);

                            // Write back the updated self modifier
                            *first_kind = .SelfModifier(self_modifier);
                        }
                        else => {}
                    }
                }
                case .None => {}
            }

            var old_object = self->func_env.current_object;
            
            self->func_env.current_object = .Some(*pure_operand_type);

            const result = self->finalize_generic_method_call(
                method_call,
                method_decl,
                method_decl_id,
                operand_type,
                pure_operand_type,
                &final_type_args,
                is_instance_method_call,
                method_call->span
            );

            self->func_env.current_object = old_object;
            self->func_env = old_env;
            return result;
        }

        method_call->operand->ty = .Some(*operand_type);
        method_call->dispatch = .Normal { method_decl_id };

        var old_object = self->func_env.current_object;
        self->func_env.current_object = .Some(*pure_operand_type);
        const ret_type = self->substitute_type(&method_decl->func_decl.ret_type);
        self->func_env.current_object = old_object;
        return .Some(ret_type);
    }

    fn finalize_generic_method_call(
        self: Self*,
        method_call: cir::TypedMethodCall*,
        method_decl: cir::MethodDecl*,
        method_decl_id: cir::MethodDeclId,
        operand_type: cir::SemaType*,
        pure_operand_type: const cir::SemaType*,
        final_type_args: const cir::TypedTypeArgs*,
        is_instance_method_call: bool,
        loc: Span
    ) Option<cir::SemaType> {
        switch (self->normalize_sema_type(method_decl->func_decl.ret_type, loc, 0)) {
            case .Some(ty) => {
                method_decl->func_decl.ret_type = ty;
            }
            case .None => {
                return .None;
            }
        }

        self->substitute_func_params(&method_decl->func_decl.params);
        method_decl->func_decl.ret_type = self->substitute_type(&method_decl->func_decl.ret_type);

        const ret_type = method_decl->func_decl.ret_type;

        switch (self->monomorphize_generic_method_call(
            *pure_operand_type,
            method_decl_id,
            method_decl,
            final_type_args,
            false,
            loc
        )) {
            case .Some(monomorph_id) => {
                method_call->operand->ty = .Some(*operand_type);
                method_call->dispatch = .Monomorph {
                    monomorph_id,
                    is_instance_method: is_instance_method_call,
                };
                return .Some(ret_type);
            }
            case .None => return .None;
        }
    }

    fn set_operand_named_type_args(
        self: Self*,
        ty: cir::SemaType*,
        generic_params: cir::TypedGenericParams
    ) bool {
        switch (*ty) {
            case .Named(var named_type) => {
                named_type.type_args = self->collect_instantiated_type_args(generic_params);
                *ty = .Named(named_type);
                return true;
            }
            case .Pointer(inner) => {
                return self->set_operand_named_type_args(inner, generic_params);
            }
            case .Const(inner) => {
                return self->set_operand_named_type_args(inner, generic_params);
            }
            else => return false;
        }
    }

    fn analyze_dynamic_dispatch_interface_method_call(
        self: Self*,
        method_call: cir::TypedMethodCall*,
        pure_operand_type: const cir::SemaType*,
        is_operand_const_qualified: bool
    ) Option<cir::SemaType> {
        switch (pure_operand_type->as_named_interface()) case .Some(interface_decl_id) else {
            return .None;    
        }

        switch (self->decl_tables->interfaces.get_const(interface_decl_id)) case .Some(interface_decl) else {
            return .None;   
        }

        switch (pure_operand_type->as_named_type()) case .Some(named_type) else {
            return .None;
        }

        const interface_type_args = named_type.type_args;

        switch (interface_decl->methods.get(method_call->name.as_str_const())) case .Some(interface_method_decl_id) else {
            diags::report_object_method_not_defined(
                self->dctx,
                self->allocator,
                method_call->span,
                interface_decl->name.as_str_const(),
                method_call->name.as_str_const()
            );
            return .None;
        }

        const table_method = self->decl_tables->methods.get(interface_method_decl_id).unwrap();
        var interface_method_decl = *table_method;
        interface_method_decl.func_decl.params = clone_func_params_list(self->allocator, &table_method->func_decl.params);
        var original_func_params = clone_func_params_list(self->allocator, &interface_method_decl.func_decl.params);

        const final_generics_params = extend_generic_params(
            self->allocator,
            &interface_method_decl.func_decl.generic_params,
            &interface_decl->generic_params
        );

        const generic_env_opt = self->create_inference_generic_env(
            interface_decl->name.as_str_const(),
            final_generics_params,
            &interface_type_args,
            method_call->span
        );

        switch (generic_env_opt) case .Some(generic_env) else {
            return .None;
        }

        self->push_generic_env(generic_env);
        const result = self->analyze_dynamic_dispatch_inner(
            method_call,
            &interface_method_decl,
            &original_func_params,
            interface_decl,
            interface_decl_id,
            is_operand_const_qualified
        );
        self->pop_generic_env();
        return result;
    }

    fn analyze_dynamic_dispatch_inner(
        self: Self*,
        method_call: cir::TypedMethodCall*,
        interface_method_decl: cir::MethodDecl*,
        original_func_params: const cir::TypedFuncParams*,
        interface_decl: const cir::InterfaceDecl*,
        interface_decl_id: cir::InterfaceDeclId,
        is_operand_const_qualified: bool
    ) Option<cir::SemaType> {
        self->normalize_func_params(&interface_method_decl->func_decl.params, true, 0);
        self->substitute_func_params(&interface_method_decl->func_decl.params);
        interface_method_decl->func_decl.ret_type = self->substitute_type(
            &interface_method_decl->func_decl.ret_type
        );

        if (!self->analyze_call(
            original_func_params,
            &interface_method_decl->func_decl,
            &method_call->args,
            method_call->span,
            true
        )) {
            return .None;
        }

        const object_name = interface_decl->name.as_str_const();

        switch (method_call->operand->ty) case .Some(operand_type) else {
            return .None;
        }

        self->validate_method_call(
            &operand_type,
            interface_method_decl,
            &interface_decl->methods,
            object_name,
            method_call->is_thin_arrow,
            true,
            is_operand_const_qualified,
            method_call->span
        );

        const ret_type_opt = self->normalize_sema_type(
            interface_method_decl->func_decl.ret_type, 
            method_call->span, 
            0
        );

        switch (ret_type_opt) case .Some(var ret_type) else {
            return .None;
        }

        ret_type = self->substitute_type(&ret_type);

        switch (interface_decl->method_index(method_call->name.as_str_const())) 
        case .Some(method_index) else {
            return .None;
        }

        method_call->type_args = self->collect_instantiated_type_args(interface_decl->generic_params);
        method_call->dispatch = .Interface {
            interface_decl_id,
            index: method_index,
            dispatch: .Dynamic,
        };

        return .Some(ret_type);
    }

    fn analyze_static_dispatch_interface_method_call(
        self: Self*,
        method_call: cir::TypedMethodCall*,
        interface_object: const cir::InterfaceObjectType*,
        is_operand_const_qualified: bool,
        expected_type: Option<cir::SemaType>
    ) Option<cir::SemaType> {
        switch (interface_object->interface_type.type_decl_id.as_interface()) case .Some(interface_decl_id) else {
            return .None;
        }

        switch (self->decl_tables->interfaces.get_const(interface_decl_id)) case .Some(decl) else {
            return .None;
        }

        switch (interface_object->concrete_type->as_named_type()) case .Some(concrete_named) else {
            return .None;
        }

        switch (method_decls_of_named_type(self->decl_tables, &concrete_named)) case .Some(concrete_methods) else {
            return .None;
        }

        switch (decl->method_index(method_call->name.as_str_const())) case .Some(method_index) else {
            return .None;
        }

        // monomorphize the concrete object's method, not the interface's
        const ret_type = self->analyze_method_call_internal(
            method_call,
            concrete_methods,
            concrete_named.type_decl_id,
            *interface_object->concrete_type,
            true,
            false,
            is_operand_const_qualified,
            expected_type
        );

        var dispatch = false;
        var interface_call_dispatch: cir::TypedInterfaceCallDispatch = .Dynamic;

        switch (method_call->dispatch) {
            case .Monomorph { monomorph_id, .. } => {
                // Update the vtable slot for this method
                self->vtable_registry.set_monomorphized_method(
                    interface_object->vtable_id, 
                    method_index, 
                    monomorph_id
                );
                interface_call_dispatch = .StaticMonomorphized { monomorph_id };
                dispatch = true;
            }
            case .Normal { method_decl_id } => {
                interface_call_dispatch = .StaticNormal { method_decl_id };
                dispatch = true;
            }
            case .Unresolved | .Interface => {}
        }

        if (dispatch) {
            method_call->dispatch = .Interface {
                interface_decl_id,
                index: method_index,
                dispatch: interface_call_dispatch,
            };
        }

        return ret_type;
    }

    fn analyze_interface_method_call(
        self: Self*,
        method_call: cir::TypedMethodCall*,
        operand_type: const cir::SemaType*,
        expected_type: Option<cir::SemaType>
    ) Option<cir::SemaType> {
        const is_operand_const_qualified = self->is_const_qualified_lvalue(method_call->operand);
        const pure_operand_type = *operand_type->const_inner()->pointer_inner();

        // Try static dispatch when an interface-object is present
        switch (pure_operand_type.as_interface_object()) {
            case .Some(interface_object) => {
                return self->analyze_static_dispatch_interface_method_call(
                    method_call,
                    &interface_object,
                    is_operand_const_qualified,
                    expected_type
                );
            }
            case .None => {
                return self->analyze_dynamic_dispatch_interface_method_call(
                    method_call,
                    &pure_operand_type,
                    is_operand_const_qualified
                );
            }
        }
    }

    fn validate_method_call(
        self: Self*,
        operand_type: const cir::SemaType*,
        method_decl: const cir::MethodDecl*,
        method_decls: const cir::MethodDecls*,
        object_name: const uint8*,
        is_thin_arrow: bool,
        is_interface_method_call: bool,
        is_operand_const_qualified: bool,
        loc: Span
    ) {
        var access_violation = false;

        switch (self->func_env.current_method) {
            case .Some(current_method_id) => {
                if (method_decls->contains_method_id(current_method_id)) {
                    access_violation = false;
                } else {
                    access_violation = 
                        method_decl->func_decl.modifiers.vis != .Public 
                        && !is_interface_method_call;
                }
            }
            case .None => {
                access_violation = 
                    method_decl->func_decl.modifiers.vis != .Public 
                    && !is_interface_method_call;
            }
        }

        if (access_violation) {
            diags::report_internal_method_call(
                self->dctx,
                self->allocator,
                loc,
                method_decl->func_decl.name.as_str_const(),
                object_name
            );
        }

        const is_base_type_pointer = operand_type->const_inner()->is_pointer();

        switch (method_decl->func_decl.params.get_self_modifier()) {
            case .Some(self_modifier) => {
                const is_self_const = self_modifier.mutability == .Const;

                // Only if referenced
                if (!is_self_const && is_operand_const_qualified && self_modifier.is_indirect()) {
                    var type_name = format::format_sema_type(self->allocator, self->decl_tables, operand_type);
                    diags::report_mutable_method_on_const_instance(
                        self->dctx,
                        self->allocator,
                        loc,
                        method_decl->func_decl.name.as_str_const(),
                        type_name.as_str_const()
                    );
                    type_name.free();
                }
            }
            case .None => {}
        }

        if (is_base_type_pointer) {
            if (!is_thin_arrow) {
                diags::report_use_thin_arrow(self->dctx, self->allocator, loc);
            }
        } else {
            if (is_thin_arrow) {
                diags::report_invalid_thin_arrow(self->dctx, self->allocator, loc);
            }
        }
    }

    fn analyze_argument(
        self: Self*,
        arg: cir::TypedExpr*,
        expected_type: cir::SemaType,
        loc: Span
    ) Option<cir::SemaType> {
        var expect = self->substitute_type(&expected_type);

        var arg_type: cir::SemaType = .Placeholder;
        switch (self->analyze_expr(arg, .Some(expect))) {
            case .Some(ty) => arg_type = ty;
            case .None => {
                arg->ty = .Some(.Err(arg->span));
                return .Some(.Err(arg->span));
            }
        }

        if (arg_type.contains_error() || expect.contains_error()) {
            return .Some(expect);
        }

        arg_type = self->substitute_type(&arg_type);

        switch (self->func_env.infer) {
            case .Some(infer_ctx) => {
                infer_ctx->unify(&expect, &arg_type);
                expect = infer_ctx->resolve(&expect);
                arg_type = infer_ctx->resolve(&arg_type);
            }
            case .None => {}
        }

        if (!self->is_assignable_to(arg_type, expect, loc)) {
            var param_type_str = format::format_sema_type(self->allocator, self->decl_tables, &expect);
            defer param_type_str.free();
            var argument_type_str = format::format_sema_type(self->allocator, self->decl_tables, &arg_type);
            defer argument_type_str.free();
            diags::report_func_call_param_type_mismatch(
                self->dctx,
                self->allocator,
                arg->span,
                @cast(uint32, 0),
                argument_type_str.as_str_const(),
                param_type_str.as_str_const()
            );
        }

        return .Some(expect);
    }

    /// Validates function calls against their signature.
    fn analyze_call(
        self: Self*,
        original_params: const cir::TypedFuncParams*,
        func_decl: const cir::FuncDecl*,
        args: Vec<cir::TypedExpr>*,
        loc: Span,
        instance_method_call: bool
    ) bool {
        const is_variadic = func_decl->params.variadic.is_some();
        var expected_args_len = func_decl->params.list.len();

        // if this is an instance method call, the self modifier is not passed
        if (instance_method_call && func_decl->params.list.len() > 0) {
            expected_args_len -= 1;
        }

        if ((!is_variadic && args->len() != expected_args_len) || (is_variadic && args->len() < expected_args_len)) {
            diags::report_func_call_args_count_mismatch(
                self->dctx,
                self->allocator,
                loc,
                func_decl->name.as_str_const(),
                @cast(uint32, expected_args_len),
                @cast(uint32, args->len())
            );
            return false;
        }

        if (is_variadic) {
            self->check_func_variadic_arguments(func_decl, args, loc);
        }

        var start_idx: usize = 0;
        if (instance_method_call) {
            start_idx = 1;
        }

        // zip params[start_idx..] with args[0..]
        const param_list = &func_decl->params.list;
        var param_i: usize = start_idx;
        var arg_i: usize = 0;
        var zip_idx: usize = 0;
        while (param_i < param_list->len() && arg_i < args->len()) {
            const param_kind = param_list->get_const(param_i).unwrap();

            switch (self->normalize_and_check_type_formation(param_kind->ty(), param_kind->span(), 0)) {
                case .Some(param_type) => {
                    const arg = args->get(arg_i).unwrap();
                    switch (self->analyze_argument(arg, param_type, arg->span)) {
                        case .Some(arg_type) => {
                            self->check_argument_satisfies_generic_param_bounds(
                                original_params,
                                param_kind->name_str(),
                                &arg_type,
                                arg->span,
                                zip_idx
                            );
                        }
                        case .None => {}
                    }
                }
                case .None => {}
            }

            param_i += 1;
            arg_i += 1;
            zip_idx += 1;
        }

        return true;
    }

    fn check_argument_satisfies_generic_param_bounds(
        self: Self*,
        original_params: const cir::TypedFuncParams*,
        param_name: const uint8*,
        arg_type: const cir::SemaType*,
        arg_loc: Span,
        arg_index: usize
    ) {
        switch (original_params->lookup_param(param_name)) case .Some(original_param) else {
            return;
        }

        var original_param_type = original_param->ty();

        switch (original_param_type.as_generic_param()) case .Some(generic_param_id) else {
            return;
        }
        
        const generic_param = self->decl_tables->generic_params.get_const(generic_param_id).unwrap();

        for (var i: usize = 0; i < generic_param->bounds.len(); i += 1) {
            const bound = generic_param->bounds.get_const(i).unwrap();
            
            var satisfies_bound = false;

            switch (arg_type->as_named_type()) {
                case .Some(named_type) => {
                    switch (implement_interfaces_of_named_type(self->decl_tables, &named_type)) {
                        case .Some(impls) => {
                            for (var j: usize = 0; j < impls->len() && !satisfies_bound; j += 1) {
                                const implement_interface = impls->get_const(j).unwrap();
                                
                                if (!self->is_assignable_to(implement_interface->ty, bound->ty, bound->span)) {
                                    satisfies_bound = true;
                                }
                            }
                        }
                        case .None => {}
                    }
                }
                case .None => {}
            }

            if (!satisfies_bound) {
                var expected_bound = format::format_sema_type(self->allocator, self->decl_tables, &bound->ty);
                defer expected_bound.free();
                var found_type = format::format_sema_type(self->allocator, self->decl_tables, arg_type);
                defer found_type.free();
                diags::report_argument_does_not_satisfy_bound(
                    self->dctx,
                    self->allocator,
                    arg_loc,
                    arg_index,
                    expected_bound.as_str_const(),
                    found_type.as_str_const()
                );
            }
        }
    }

    fn check_func_variadic_arguments(
        self: Self*,
        func_decl: const cir::FuncDecl*,
        args: Vec<cir::TypedExpr>*,
        loc: Span
    ) {
        const static_params_len = func_decl->params.list.len();

        if (static_params_len > args->len()) {
            return;
        }

        switch (func_decl->params.variadic) {
            case .Some(.Typed { ty, .. }) => {
                for (var i: usize = static_params_len; i < args->len(); i += 1) {
                    const arg = args->get(i).unwrap();

                    switch (self->analyze_expr(arg, arg->ty)) {
                        case .Some(arg_type) => {
                            if (!self->is_assignable_to(arg_type, ty, loc)) {
                                var param_type_str = format::format_sema_type(self->allocator, self->decl_tables, &ty);
                                defer param_type_str.free();
                                var argument_type_str = format::format_sema_type(self->allocator, self->decl_tables, &arg_type);
                                defer argument_type_str.free();
                                diags::report_func_call_variadic_param_type_mismatch(
                                    self->dctx,
                                    self->allocator,
                                    loc,
                                    @cast(uint32, i),
                                    argument_type_str.as_str_const(),
                                    param_type_str.as_str_const()
                                );
                            }
                        }
                        case .None => {}
                    }
                }
            }
            case .Some(.UntypedCStyle) => {
                for (var i: usize = static_params_len; i < args->len(); i += 1) {
                    const arg = args->get(i).unwrap();
                    
                    switch (self->analyze_expr(arg, arg->ty)) {
                        case .Some(arg_type) => {
                            if (arg_type.is_void()) {
                                diags::report_void_argument_in_variadic_param(
                                    self->dctx,
                                    self->allocator,
                                    loc
                                );
                            }
                        }
                        case .None => {}
                    }
                }
            }
            case .None => {}
        }
    }

    fn check_func_type_call(
        self: Self*,
        func_type: cir::TypedFuncType*,
        args: Vec<cir::TypedExpr>*,
        loc: Span
    ) Option<cir::SemaType> {
        const expected_args_len = func_type->params.list.len();
        const is_variadic = func_type->params.variadic.is_some();
        
        var func_name = format::format_func_type(self->allocator, self->decl_tables, func_type);
        defer func_name.free();

        if ((!is_variadic && args->len() != expected_args_len) 
            || (is_variadic && args->len() < expected_args_len)) {
            diags::report_func_call_args_count_mismatch(
                self->dctx,
                self->allocator,
                loc,
                func_name.as_str_const(),
                @cast(uint32, expected_args_len),
                @cast(uint32, args->len())
            );
            return .None;
        }

        var i: usize = 0;

        while (i < expected_args_len && i < args->len()) {
            const param_type_raw = *func_type->params.list.get_const(i).unwrap();

            switch (self->normalize_and_check_type_formation(param_type_raw, loc, 0)) {
                case .Some(param_type) => {
                    const arg = args->get(i).unwrap();

                    switch (self->analyze_expr(arg, .Some(param_type))) {
                        case .Some(arg_type) => {
                            if (!self->is_assignable_to(arg_type, param_type, arg->span)) {
                                var param_type_str = format::format_sema_type(self->allocator, self->decl_tables, &param_type);
                                defer param_type_str.free();
                                var argument_type_str = format::format_sema_type(self->allocator, self->decl_tables, &arg_type);
                                defer argument_type_str.free();
                                diags::report_func_call_param_type_mismatch(
                                    self->dctx,
                                    self->allocator,
                                    arg->span,
                                    @cast(uint32, i),
                                    argument_type_str.as_str_const(),
                                    param_type_str.as_str_const()
                                );
                            }
                        }
                        case .None => {}
                    }
                }
                case .None => {}
            }

            i += 1;
        }

        if (is_variadic) {
            switch (func_type->params.variadic) case .Some(variadic) else {
                return .Some(*func_type->ret_type);
            }

            switch (*variadic) {
                case .Typed(ty) => {
                    if (expected_args_len <= args->len()) {
                        for (var j: usize = expected_args_len; j < args->len(); j += 1) {
                            const arg = args->get(j).unwrap();

                            switch (self->analyze_expr(arg, arg->ty)) {
                                case .Some(arg_type) => {
                                    if (!self->is_assignable_to(arg_type, ty, loc)) {
                                        var param_type_str = format::format_sema_type(self->allocator, self->decl_tables, &ty);
                                        defer param_type_str.free();
                                        var argument_type_str = format::format_sema_type(self->allocator, self->decl_tables, &arg_type);
                                        defer argument_type_str.free();
                                        diags::report_func_call_variadic_param_type_mismatch(
                                            self->dctx,
                                            self->allocator,
                                            loc,
                                            @cast(uint32, j),
                                            argument_type_str.as_str_const(),
                                            param_type_str.as_str_const()
                                        );
                                    }
                                }
                                case .None => {}
                            }
                        }
                    }
                }
                case .UntypedCStyle => {
                    if (expected_args_len <= args->len()) {
                        for (var j: usize = expected_args_len; j < args->len(); j += 1) {
                            const arg = args->get(j).unwrap();
                            self->analyze_expr(arg, arg->ty);
                        }
                    }
                }
            }
        }

        return .Some(*func_type->ret_type);
    }

    fn monomorphize_generic_func_call(
        self: Self*,
        operand_type: const cir::SemaType*,
        func_call: cir::TypedFuncCall*,
        func_decl_id: cir::FuncDeclId,
        func_decl: cir::FuncDecl*,
        final_type_args: const cir::TypedTypeArgs*
    ) Option<cir::SemaType> {
        func_call->operand->ty = .Some(self->substitute_type(operand_type));
        self->substitute_func_params(&func_decl->params);
        func_decl->ret_type = self->substitute_type(&func_decl->ret_type);

        if (!self->check_type_arity(func_decl->ret_type, func_call->span)) {
            return .None;
        }

        switch (self->func_env.current_func) {
            case .Some(var updated) => {
                updated.params = func_params_as_type_params(self->allocator, &func_decl->params);
                updated.ret_type = alloc_init(self->allocator, func_decl->ret_type);
                self->func_env.current_func = .Some(updated);
            }
            case .None => {}
        }

        const monomorph_id = self->monomorph_registry.get_or_create(
            dynamic self->arena,
            .Func(func_decl_id),
            final_type_args,
            func_decl->params,
            func_decl->ret_type
        );

        self->monomorph_registry.mark_analyzed(monomorph_id);

        // NOTE: stage0 specializes and analyzes the monomorphized body here;
        // deferred until statement analysis is ported (stage1 analyzes no
        // function bodies yet).
        func_call->dispatch = .Monomorph { monomorph_id };

        return .Some(func_decl->ret_type);
    }

    fn monomorphize_generic_method_call(
        self: Self*,
        pure_operand_type: cir::SemaType,
        method_decl_id: cir::MethodDeclId,
        method_decl: cir::MethodDecl*,
        final_type_args: const cir::TypedTypeArgs*,
        is_generic_interface_method_call: bool,
        loc: Span
    ) Option<cir::MonomorphId> {
        if (!is_generic_interface_method_call) {
            // Substitute Self inside params, ret_type, variables
            self->apply_self_type_in_method_decl_and_variable(method_decl, &pure_operand_type);
        }

        self->substitute_func_params(&method_decl->func_decl.params);
        method_decl->func_decl.ret_type = self->substitute_type(&method_decl->func_decl.ret_type);

        if (!self->check_type_arity(method_decl->func_decl.ret_type, loc)) {
            return .None;
        }

        switch (self->func_env.current_func) {
            case .Some(var updated) => {
                updated.params = func_params_as_type_params(self->allocator, &method_decl->func_decl.params);
                updated.ret_type = alloc_init(self->allocator, method_decl->func_decl.ret_type);
                self->func_env.current_func = .Some(updated);
            }
            case .None => {}
        }

        const monomorph_id = self->monomorph_registry.get_or_create(
            dynamic self->arena,
            .Method(method_decl_id),
            final_type_args,
            method_decl->func_decl.params,
            method_decl->func_decl.ret_type
        );
        self->monomorph_registry.mark_analyzed(monomorph_id);

        // NOTE: stage0 specializes and analyzes the monomorphized body here;
        // deferred until statement analysis is ported (stage1 analyzes no
        // function bodies yet).
        return .Some(monomorph_id);
    }

    fn apply_self_type_in_method_decl_and_variable(
        self: Self*,
        method_decl: cir::MethodDecl*,
        concrete_self_type: const cir::SemaType*
    ) {
        for (var i: usize = 0; i < method_decl->func_decl.params.list.len(); i += 1) {
            const kind = method_decl->func_decl.params.list.get(i).unwrap();

            switch (*kind) {
                case .FuncParam(var func_param) => {
                    func_param.ty = self->substitute_self_type(&func_param.ty, concrete_self_type);
                    *kind = .FuncParam(func_param);
                }
                case .SelfModifier(var self_modifier) => {
                    self_modifier.ty = self->substitute_self_type(&self_modifier.ty, concrete_self_type);

                    switch (self_modifier.var_decl_id) {
                        case .Some(var_decl_id) => {
                            const var_decl = self->decl_tables->vars.get(var_decl_id);
                            
                            switch (var_decl) {
                                case .Some(entry) => entry->ty = .Some(self_modifier.ty);
                                case .None => {}
                            }
                        }
                        case .None => {}
                    }

                    *kind = .SelfModifier(self_modifier);
                }
            }
        }

        switch (self->normalize_sema_type(method_decl->func_decl.ret_type, method_decl->func_decl.span, 0)) {
            case .Some(ty) => method_decl->func_decl.ret_type = ty;
            case .None => {}
        }

        var subst_ret_type = self->substitute_self_type(&method_decl->func_decl.ret_type, concrete_self_type);
        
        switch (self->func_env.infer) {
            case .Some(infer_ctx) => subst_ret_type = infer_ctx->resolve(&subst_ret_type);
            case .None => {}
        }

        method_decl->func_decl.ret_type = subst_ret_type;
    }

    /* ************* Dynamic ************* */

    pub fn analyze_dynamic(
        self: Self*,
        dynamic_expr: cir::TypedDynamicExpr*,
        expected_type: Option<cir::SemaType>
    ) Option<cir::SemaType> {
        switch (self->analyze_expr(dynamic_expr->operand, .None)) case .Some(var operand_type) else {
            return .None;
        }

        operand_type = self->expand_sema_type(operand_type, dynamic_expr->span);

        // Prevent cascading failures
        if (operand_type.contains_error()) {
            return .Some(.Err(dynamic_expr->span));
        }

        if (dynamic_expr->operand->kind.is_dynamic()) {
            diags::report_invalid_multiple_dynamic_type(self->dctx, self->allocator, dynamic_expr->span);
            return .None;
        }

        switch (operand_type.as_named_type()) case .Some(named_type) else {
            const type_name = format::format_sema_type(self->allocator, self->decl_tables, &operand_type);
            defer type_name.free();
            diags::report_invalid_dynamic_type(
                self->dctx,
                self->allocator,
                dynamic_expr->span,
                type_name.as_str_const()
            );
            return .None;
        }

        var interface_decl_id_opt: Option<cir::InterfaceDeclId> = .None;
        var interface_type_args = cir::TypedTypeArgs.new(self->allocator);

        switch (expected_type) {
            case .Some(expect) => {
                interface_decl_id_opt = expect.as_named_interface();

                switch (expect.as_named_type()) {
                    case .Some(expected_named) => {
                        interface_type_args = cir::clone_typed_type_args(dynamic self->arena, &expected_named.type_args);
                    }
                    case .None => @unreachable();
                }
            }
            case .None => {}
        }
        
        switch (interface_decl_id_opt) case .Some(interface_decl_id) else {
            diags::report_cannot_infer_dynamic_interface_type(
                self->dctx, 
                self->allocator, 
                dynamic_expr->span
            );
            return .None;
        }

        const interface_decl = self->decl_tables->interfaces.get_const(interface_decl_id).unwrap();

        if (!interface_decl->is_interface_dynamically_dispatchable) {
            diags::report_not_dynamic_compatible_interface(
                self->dctx,
                self->allocator,
                dynamic_expr->span,
                interface_decl->name.as_str_const()
            );
            return .None;
        }

        switch (implement_interfaces_of_named_type(self->decl_tables, &named_type)) 
        case .Some(object_impls) else {
            return .None;
        }

        switch (method_decls_of_named_type(self->decl_tables, &named_type)) 
        case .Some(method_decls) else {
            return .None;
        }

        var object_impls_interface = false;

        for (var i: usize = 0; i < object_impls->len() && !object_impls_interface; i += 1) {
            const implement_interface = object_impls->get_const(i).unwrap();

            switch (self->normalize_sema_type(implement_interface->ty, implement_interface->span, 0)) {
                case .Some(normalized_type) => {
                    const ty = self->expand_sema_type(normalized_type, implement_interface->span);

                    switch (ty.as_named_interface()) {
                        case .Some(id) => {
                            if (id == interface_decl_id) {
                                object_impls_interface = true;
                            }
                        }
                        case .None => {}
                    }
                }
                case .None => {}
            }
        }

        if (!object_impls_interface) {
            const concrete_type_name = format::format_sema_type(
                self->allocator, 
                self->decl_tables, 
                &operand_type
            );
            defer concrete_type_name.free();
            diags::report_dynamic_conversion_missing_interface(
                self->dctx,
                self->allocator,
                dynamic_expr->span,
                interface_decl->name.as_str_const(),
                concrete_type_name.as_str_const()
            );
            return .None;
        }

        const object_generic_params = *type_decl_generic_params(self->decl_tables, named_type.type_decl_id);

        var object_name = format::format_type_decl_name(
            self->allocator,
            self->decl_tables, 
            named_type.type_decl_id
        );
        defer object_name.free();

        const object_generic_env_opt = self->create_inference_generic_env(
            object_name.as_str_const(),
            object_generic_params,
            &named_type.type_args,
            dynamic_expr->span
        );
        switch (object_generic_env_opt) {
            case .None => {
                return .None;
            }
            case .Some(env) => {
                self->push_generic_env(env);
                self->analyze_object_implements_monomorphized_interfaces(
                    interface_decl,
                    &interface_type_args,
                    object_name.as_str_const(),
                    &operand_type,
                    object_impls,
                    method_decls,
                    dynamic_expr->span
                );
                self->pop_generic_env();
            }
        }

        var interface_methods = cir::MethodDecls.new(self->allocator);
        defer interface_methods.free();

        for (var i: usize = 0; i < interface_decl->methods.entries.len(); i += 1) {
            const entry = interface_decl->methods.entries.get_const(i).unwrap();

            switch (method_decls->get(entry->name.as_str_const())) {
                case .Some(object_method_decl_id) => {
                    interface_methods.entries.push(cir::MethodDeclEntry {
                        name: entry->name.clone(self->allocator),
                        id: object_method_decl_id,
                    });
                }
                case .None => {}
            }
        }

        const is_interface_generic = interface_decl->is_generic();

        const vtable_id = self->vtable_registry.get_or_create_vtable(
            dynamic self->arena,
            &operand_type,
            interface_decl_id,
            &interface_type_args,
            &interface_methods,
            is_interface_generic,
            dynamic_expr->span
        );

        self->monomorphize_interface_object_methods(
            vtable_id,
            &interface_methods,
            is_interface_generic,
            &operand_type,
            dynamic_expr->span
        );


        var interface_named_type = cir::NamedType {
            type_decl_id: .Interface(interface_decl_id),
            type_args: interface_type_args,
        };

        var interface_object_type = cir::InterfaceObjectType {
            interface_type: interface_named_type,
            concrete_type: alloc_init(self->allocator, operand_type),
            vtable_id,
            span: dynamic_expr->span,
        };

        dynamic_expr->concrete_type = .Some(operand_type);
        dynamic_expr->interface_object_type = .Some(interface_object_type);

        return .Some(.InterfaceObject(interface_object_type));
    }

    fn analyze_object_implements_monomorphized_interfaces(
        self: Self*,
        interface_decl: const cir::InterfaceDecl*,
        interface_type_args: const cir::TypedTypeArgs*,
        object_name: const uint8*,
        object_type: const cir::SemaType*,
        object_impls: const Vec<cir::TypedImplementInterface>*,
        method_decls: const cir::MethodDecls*,
        loc: Span
    ) {
        const generic_env_opt = self->create_inference_generic_env(
            interface_decl->name.as_str_const(),
            interface_decl->generic_params,
            interface_type_args,
            loc
        );

        switch (generic_env_opt) case .Some(env) else {
            return;   
        }

        self->push_generic_env(env);

        for (var i: usize = 0; i < object_impls->len(); i += 1) {
            const implement_interface = object_impls->get_const(i).unwrap();

            const normalized_opt = self->normalize_sema_type(
                implement_interface->ty,
                implement_interface->span,
                0
            );

            switch (normalized_opt) case .Some(normalized_type) else {
                continue;
            }

            const sema_type = self->expand_sema_type(normalized_type, implement_interface->span);

            switch (sema_type.as_named_interface()) case .Some(inner_interface_id) else {
                const symbol_name = format::format_sema_type(self->allocator, self->decl_tables, &sema_type);
                defer symbol_name.free();
                diags::report_non_interface_symbol(
                    self->dctx,
                    self->allocator,
                    implement_interface->span,
                    symbol_name.as_str_const()
                );
                continue;
            }

            const inner_interface_decl = self->decl_tables->interfaces.get_const(inner_interface_id).unwrap();

            for (var j: usize = 0; j < inner_interface_decl->methods.entries.len(); j += 1) {
                const ientry = inner_interface_decl->methods.entries.get_const(j).unwrap();
                const table_interface_method = self->decl_tables->methods.get(ientry->id).unwrap();

                // Interface method
                var interface_func = table_interface_method->func_decl;
                const ifp = &interface_func;
                ifp->params = clone_func_params_list(self->allocator, &table_interface_method->func_decl.params);

                switch (ifp->params.list.first()) {
                    case .Some(first_kind) => {
                        switch (*first_kind) {
                            case .SelfModifier(var updated) => {
                                updated.ty = self->substitute_self_type(&updated.ty, object_type);
                                *first_kind = .SelfModifier(updated);
                            }
                            else => {}
                        }
                    }
                    case .None => {}
                }
                self->substitute_func_params(&interface_func.params);
                interface_func.ret_type = self->substitute_type(&interface_func.ret_type);

                // Object method
                switch (method_decls->get(ifp->name.as_str_const())) case .Some(object_method_id) else {
                    continue;
                }

                const table_object_method = self->decl_tables->methods.get(object_method_id).unwrap();

                if (!table_object_method->func_decl.is_generic()) {
                    // Skip comparison for generic methods
                    // because they will be validated during 
                    // monomorphization
                    var object_func = table_object_method->func_decl;
                    const ofp = &object_func;
                    ofp->params = clone_func_params_list(self->allocator, &table_object_method->func_decl.params);

                    switch (ofp->params.list.first()) {
                        case .Some(first_kind) => {
                            switch (*first_kind) {
                                case .SelfModifier(var self_modifier) => {
                                    self_modifier.ty = self->substitute_self_type(&self_modifier.ty, object_type);
                                    *first_kind = .SelfModifier(self_modifier);
                                }
                                else => {}
                            }
                        }
                        case .None => {}
                    }

                    self->substitute_func_params(&object_func.params);
                    object_func.ret_type = self->substitute_type(&object_func.ret_type);

                    // Check method declaration mismatch
                    if (!func_decl_eq(&object_func, &interface_func)) {
                        diags::report_interface_method_type_mismatch(
                            self->dctx,
                            self->allocator,
                            interface_func.span,
                            object_name,
                            interface_func.name.as_str_const(),
                            inner_interface_decl->name.as_str_const()
                        );
                    }
                }
            }

            if (!self->check_type_correctness(sema_type, implement_interface->span)) {
                continue;
            }
        }

        self->pop_generic_env();
    }

    fn monomorphize_interface_object_methods(
        self: Self*,
        vtable_id: cir::VTableId,
        methods: const cir::MethodDecls*,
        is_interface_generic: bool,
        concrete_type: const cir::SemaType*,
        loc: Span
    ) {
        switch (concrete_type->as_named_type()) case .Some(concrete_named) else {
            return;
        }

        const object_generic_params_ptr = type_decl_generic_params(self->decl_tables, concrete_named.type_decl_id);
        const is_object_generic = !object_generic_params_ptr->is_empty();
        const object_generic_params = *object_generic_params_ptr;

        for (var method_index: usize = 0; method_index < methods->entries.len(); method_index += 1) {
            const entry = methods->entries.get_const(method_index).unwrap();

            if (is_interface_generic && is_object_generic) {
                // Monomorphize object method

                switch (self->decl_tables->methods.get_owned(entry->id)) case .Some(var method_decl_storage) else {
                    continue;
                }

                method_decl_storage.func_decl.params = clone_func_params_list(
                    self->allocator, 
                    &method_decl_storage.func_decl.params
                );

                const method_decl = &method_decl_storage;

                switch (self->create_inference_generic_env(
                    entry->name.as_str_const(),
                    object_generic_params,
                    &concrete_named.type_args,
                    loc
                )) case .Some(object_method_generic_env) else {
                    continue;
                }

                self->push_generic_env(object_method_generic_env);

                self->substitute_func_params(&method_decl_storage.func_decl.params);
                method_decl_storage.func_decl.ret_type = self->substitute_type(&method_decl_storage.func_decl.ret_type);

                // Substitute Self inside the self modifier
                switch (method_decl->func_decl.params.list.first()) {
                    case .Some(first_kind) => {
                        switch (*first_kind) {
                            case .SelfModifier(var self_modifier) => {
                                self_modifier.ty = self->substitute_self_type(&self_modifier.ty, concrete_type);
                                *first_kind = .SelfModifier(self_modifier);
                            }
                            else => {}
                        }
                    }
                    case .None => {}
                }

                const func_type = func_decl_as_func_type(self->allocator, &method_decl_storage.func_decl);

                var func_env = self->create_method_env(entry->id, func_type, self->func_env.infer);

                const final_generics_params = extend_generic_params(
                    self->allocator,
                    &method_decl_storage.func_decl.generic_params,
                    &object_generic_params
                );

                const final_type_args = self->collect_instantiated_type_args(final_generics_params);

                var saved_func_env = self->func_env;
                self->func_env = func_env;
                self->func_env.current_object = .Some(*concrete_type);

                const monomorph_id_opt = self->monomorphize_generic_method_call(
                    *concrete_type,
                    entry->id,
                    method_decl,
                    &final_type_args,
                    true,
                    loc
                );
                self->func_env = saved_func_env;

                switch (monomorph_id_opt) {
                    case .Some(monomorph_id) => {
                        self->vtable_registry.set_monomorphized_method(
                            vtable_id,
                            method_index,
                            monomorph_id
                        );
                    }
                    case .None => {}
                }

                self->pop_generic_env();
            }
        }
    }

    /* ************* Statements ************* */

    pub fn analyze(self: Self*) {
        for (var i: usize = 0; i < self->trees.len(); i += 1) {
            var tree = self->trees.get(i).unwrap();
            self->analyze_toplevel_stmts(&tree->body);
        }
    }

    pub fn analyze_toplevel_stmts(self: Self*, typed_stmts: Vec<cir::TypedStmt>*) {
        for (var i: usize = 0; i < typed_stmts->len(); i += 1) {
            var stmt = typed_stmts->get(i).unwrap();

            switch (stmt->kind) {
                case .Typedef(var typedef) => {
                    self->analyze_typedef(&typedef);
                    stmt->kind = .Typedef(typedef);
                }
                else => {}
            }
        }

        for (var i: usize = 0; i < typed_stmts->len(); i += 1) {
            var stmt = typed_stmts->get(i).unwrap();

            switch (stmt->kind) {
                case .GlobalVar(var global_var) => {
                    self->analyze_global_var(&global_var);
                    stmt->kind = .GlobalVar(global_var);
                }
                else => {}
            }
        }

        for (var i: usize = 0; i < typed_stmts->len(); i += 1) {
            var stmt = typed_stmts->get(i).unwrap();
            self->analyze_toplevel_stmt(stmt);
        }
    }

    fn analyze_toplevel_stmt(self: Self*, stmt: cir::TypedStmt*) {
        switch (stmt->kind) {
            case .FuncDef(var func_def) => {
                self->analyze_func_def(&func_def);
                stmt->kind = .FuncDef(func_def);
            }
            case .FuncDecl(var func_decl) => {
                self->analyze_func_decl_stmt(&func_decl);
                stmt->kind = .FuncDecl(func_decl);
            }
            case .Interface(var interace_) => {
                self->analyze_interface(&interace_);
                stmt->kind = .Interface(interace_);
            }
            case .Struct(var struct_) => {
                self->analyze_struct_stmt(&struct_);
                stmt->kind = .Struct(struct_);
            }
            case .Enum(var enum_) => {
                self->analyze_enum_stmt(&enum_);
                stmt->kind = .Enum(enum_);
            }
            case .Union(var union_) => {
                self->analyze_union_stmt(&union_);
                stmt->kind = .Union(union_);
            }
            case .Builtin => {
                self->analyze_builtin(stmt, true);
            }

            case .GlobalVar => { /* Skipped */ }
            
            case .Typedef => { /* Skipped */ }
            
            else => {
                diags::report_invalid_statement(
                    self->dctx,
                    self->allocator,
                    stmt->kind.span()
                );
            }
        }
    }

    pub fn analyze_stmt(self: Self*, stmt: cir::TypedStmt*) FlowState {
        switch (stmt->kind) {
            case .Builtin => {
                return self->analyze_builtin_func_used_as_stmt(stmt);
            }
            else => {}
        }

        switch (stmt->kind) {
            case .Defer(defer_stmt) => {
                self->analyze_defer_stmt(defer_stmt.operand);
                return .Reachable;
            }

            case .BlockStmt(var block) => {
                const flow = self->analyze_block_stmt(&block);
                stmt->kind = .BlockStmt(block);
                return flow;
            }

            case .Expr(var expr) => {
                const expect = expr.ty;
                self->analyze_expr(&expr, expect);
                stmt->kind = .Expr(expr);
                return .Reachable;
            }

            case .Variable(var var_) => {
                self->analyze_var(&var_);
                stmt->kind = .Variable(var_);
                return .Reachable;
            }

            case .InlineAsm(var inline_asm) => {
                self->analyze_inline_asm_stmt(&inline_asm);
                stmt->kind = .InlineAsm(inline_asm);
                return .Reachable;
            }

            case .TupleExport(var tuple_export) => {
                self->analyze_export_tuple_values(&tuple_export);
                stmt->kind = .TupleExport(tuple_export);
                return .Reachable;
            }

            case .If(var if_) => {
                const flow = self->analyze_if_stmt(&if_);
                stmt->kind = .If(if_);
                return flow;
            }

            case .For(var for_) => {
                const flow = self->analyze_for_loop(&for_);
                stmt->kind = .For(for_);
                return flow;
            }

            case .While(var while_) => {
                const flow = self->analyze_while_loop(&while_);
                stmt->kind = .While(while_);
                return flow;
            }

            case .Break(break_stmt) => {
                return self->analyze_break(&break_stmt);
            }

            case .Continue(continue_stmt) => {
                return self->analyze_continue(&continue_stmt);
            }

            case .Return(var return_) => {
                const flow = self->analyze_return(&return_);
                stmt->kind = .Return(return_);
                return flow;
            }

            case .Switch(var switch_) => {
                const flow = self->analyze_switch(&switch_);
                stmt->kind = .Switch(switch_);
                return flow;
            }

            case .Label => return .Reachable;
            
            case .Goto => return .Reachable;

            else => {
                diags::report_invalid_statement(
                    self->dctx, 
                    self->allocator, 
                    stmt->kind.span()
                );
                return .Reachable;
            }
        }
    }

    fn analyze_defer_stmt(self: Self*, operand: cir::TypedStmt*) {
        self->analyze_stmt(operand);
    }

    pub fn analyze_block_stmt(self: Self*, block: cir::TypedBlockStmt*) FlowState {
        const total = block->stmts.len();

        var flow_state: FlowState = .Reachable;
        var terminated = false;

        var final_stmts: Vec<cir::TypedStmt> = Vec.new(self->allocator);
        var block_defers: Vec<cir::TypedDeferStmt> = Vec.new(self->allocator);

        for (var i: usize = 0; i < total; i += 1) {
            var stmt = block->stmts.get(i).unwrap();

            const stmt_state = self->analyze_stmt(stmt);

            switch (stmt->kind) {
                case .Defer(var defer_copy) => {
                    defer_copy.operand->is_dead = terminated;
                    block_defers.push(defer_copy);
                }
                else => {}
            }

            if (terminated) {
                stmt->is_dead = true;

                if (!self->dctx->has_errors()) {
                    diags::report_unreachable_code(
                        self->dctx,
                        self->allocator,
                        stmt->kind.span()
                    );
                }

                continue;
            }

            switch (stmt_state) {
                case .Reachable => {
                    final_stmts.push(*stmt);
                }
                case .Unreachable => {
                    final_stmts.push(*stmt);
                    flow_state = .Unreachable;
                    terminated = true;
                }
                case .Returns => {
                    final_stmts.push(*stmt);
                    flow_state = .Returns;
                    terminated = true;
                }
            }
        }

        block->stmts.free();
        block->stmts = final_stmts;
        block->defers.free();
        block->defers = block_defers;

        return flow_state;
    }

    fn analyze_generic_bounds(self: Self*, generic_params: const cir::TypedGenericParams*) {
        for (var i: usize = 0; i < generic_params->ids.len(); i += 1) {
            const generic_param_id = *generic_params->ids.get_const(i).unwrap();

            var generic_param = self->decl_tables->generic_params.get(generic_param_id).unwrap();

            switch (generic_param->default) {
                case .Some(default_type) => {
                    switch (self->normalize_sema_type(*default_type, generic_param->name.span, 0)) {
                        case .Some(ty) => {
                            *default_type = ty;
                        }
                        case .None => {}
                    }
                }
                case .None => {}
            }

            for (var j: usize = 0; j < generic_param->bounds.len(); j += 1) {
                const bound = generic_param->bounds.get_const(j).unwrap();

                switch (self->normalize_sema_type(bound->ty, generic_param->name.span, 0)) {
                    case .Some(ty) => {
                        if (!ty.is_interface()) {
                            var found = format::format_sema_type(self->allocator, self->decl_tables, &ty);
                            defer found.free();
                            diags::report_expected_interface_in_bound(
                                self->dctx,
                                self->allocator,
                                bound->span,
                                found.as_str_const()
                            );
                        }

                        self->check_type_correctness(ty, bound->span);

                        var bound = generic_param->bounds.get(j).unwrap();
                        bound->ty = ty;
                    }
                    case .None => {}
                }
            }
        }
    }

    fn analyze_typedef(self: Self*, typedef: cir::TypedTypedefStmt*) {
        const normalized = self->normalize_and_check_type_formation(typedef->ty, typedef->span, 0);

        switch (normalized) {
            case .Some(ty) => {
                typedef->ty = ty;
            }
            case .None => {
                typedef->ty = cir::SemaType.Err(typedef->span);
                var typedef_decl = self->decl_tables->typedefs.get(typedef->typedef_decl_id).unwrap();
                *typedef_decl->ty = cir::SemaType.Err(typedef->span);
                return;
            }
        }

        self->analyze_generic_bounds(&typedef->generic_params);

        var typedef_decl2 = self->decl_tables->typedefs.get(typedef->typedef_decl_id).unwrap();
        *typedef_decl2->ty = typedef->ty;
    }



    fn validate_variable_type(self: Self*, ty: const cir::SemaType*, is_init: bool, loc: Span) bool {
        if (ty->const_inner()->is_void()) {
            diags::report_void_variable_type(self->dctx, self->allocator, loc);
        }

        if (ty->const_inner()->is_interface() && !is_init) {
            diags::report_interface_type_must_be_initialized(self->dctx, self->allocator, loc);
        }

        if (ty->const_inner()->is_func_type() && !is_init) {
            diags::report_lambda_type_must_be_initialized(self->dctx, self->allocator, loc);
        }

        return self->check_type_arity(*ty, loc);
    }

    fn validate_non_static_global_var_modifiers(self: Self*, global_var: const cir::TypedGlobalVarStmt*) {
        if (global_var->modifiers.weak
            || global_var->modifiers.link_once
            || global_var->modifiers.thread_local
            || global_var->modifiers.extrn.is_some()
            || global_var->modifiers.section.is_some()
        ) {
            diags::report_invalid_modifier_for_non_static_global_var(
                self->dctx, 
                self->allocator, 
                global_var->span
            );
        }

        if (!global_var->is_const) {
            diags::report_non_static_non_const_global_var(
                self->dctx, 
                self->allocator, 
                global_var->span
            );
        }
    }

    fn analyze_global_var(self: Self*, global_var: cir::TypedGlobalVarStmt*) {
        switch (global_var->rhs) {
            case .Some(var expr) => {
                if (self->analyze_expr(&expr, global_var->ty).is_none()) {
                    global_var->rhs = .Some(expr);

                    if (global_var->ty.is_none()) {
                        const err_ty = cir::SemaType.Err(global_var->span);
                        global_var->ty = .Some(err_ty);
                    }

                    self->write_back_global_var(global_var);
                    return;
                }

                if (!global_var->is_static && !is_expr_const_evaluable(&expr.kind)) {
                    diags::report_not_const_evaluable_global_variable_expr(
                        self->dctx,
                        self->allocator,
                        global_var->span
                    );

                    global_var->rhs = .Some(expr);
                    
                    if (global_var->ty.is_none()) {
                        const err_ty = cir::SemaType.Err(global_var->span);
                        global_var->ty = .Some(err_ty);
                    }
                    
                    self->write_back_global_var(global_var);
                    return;
                }

                if (global_var->is_static && !expr.is_comptime_expr()) {
                    diags::report_not_comptime_static_global_variable_expr(
                        self->dctx,
                        self->allocator,
                        global_var->span
                    );

                    global_var->rhs = .Some(expr);
                    
                    if (global_var->ty.is_none()) {
                        const err_ty = cir::SemaType.Err(global_var->span);
                        global_var->ty = .Some(err_ty);
                    }
                    
                    self->write_back_global_var(global_var);
                    return;
                }

                global_var->rhs = .Some(expr);
            }
            case .None => {}
        }

        switch (global_var->ty) {
            case .Some(ty) => {
                const normalized = self->normalize_and_check_type_formation(ty, global_var->span, 0);

                switch (normalized) {
                    case .Some(inner) => global_var->ty = .Some(inner);
                    case .None => global_var->ty = .None;
                }
            }
            case .None => {
                switch (global_var->rhs) {
                    case .Some(expr) => {
                        switch (expr.ty) {
                            case .Some(expr_ty) => {
                                global_var->ty = .Some(expr_ty);
                            }
                            case .None => {
                                global_var->ty = .Some(cir::SemaType.Err(global_var->span));

                                diags::report_global_var_requires_type_annotation(
                                    self->dctx,
                                    self->allocator,
                                    global_var->span
                                );

                                self->write_back_global_var(global_var);
                                return;
                            }
                        }
                    }
                    case .None => {
                        global_var->ty = .Some(cir::SemaType.Err(global_var->span));

                        diags::report_global_var_requires_type_annotation(
                            self->dctx,
                            self->allocator,
                            global_var->span
                        );
                        self->write_back_global_var(global_var);
                        return;
                    }
                }
            }
        }

        switch (global_var->ty) {
            case .Some(ty) => {
                const is_init = global_var->rhs.is_some() || global_var->is_undef;
                
                if (!self->validate_variable_type(&ty, is_init, global_var->span)) {
                    global_var->ty = .Some(cir::SemaType.Err(global_var->span));
                    self->write_back_global_var(global_var);
                    return;
                }

                const expand = self->expand_sema_type(ty, global_var->span);
                global_var->ty = .Some(expand);
            }
            else => {}
        }

        switch (global_var->rhs) {
            case .Some(expr) => {
                switch (global_var->ty) {
                    case .Some(target_type) => {
                        if (is_const_qualified_type_assigned_to_non_const_variable(&target_type, global_var->is_const)) {
                            diags::report_const_qualified_type_assigned_to_non_const_variable(
                                self->dctx,
                                self->allocator,
                                global_var->span
                            );
                        }

                        switch (expr.ty) {
                            case .Some(expr_ty) => {
                                if (!cir_types_eq(expr_ty.const_inner(), target_type.const_inner())) {
                                    var lhs_name = format::format_sema_type(
                                        self->allocator,
                                        self->decl_tables,
                                        &target_type
                                    );
                                    defer lhs_name.free();
                                    var rhs_name = format::format_sema_type(
                                        self->allocator,
                                        self->decl_tables,
                                        &expr_ty
                                    );
                                    defer rhs_name.free();
                                    diags::report_assignment_type_mismatch(
                                        self->dctx,
                                        self->allocator,
                                        global_var->span,
                                        lhs_name.as_str_const(),
                                        rhs_name.as_str_const()
                                    );
                                }
                            }
                            case .None => {}
                        }
                    }
                    case .None => {}
                }
            }
            case .None => {}
        }

        if (global_var->ty.is_none() && global_var->is_undef) {
            diags::report_undefined_without_type_annotation(self->dctx, self->allocator, global_var->span);
        }

        if (global_var->is_const && global_var->is_undef) {
            diags::report_undefined_const_variable(self->dctx, self->allocator, global_var->span);
        }

        if (global_var->is_const && global_var->rhs.is_none()) {
            diags::report_const_variable_must_be_initialized(self->dctx, self->allocator, global_var->span);
        }

        if (!global_var->is_static) {
            self->validate_non_static_global_var_modifiers(global_var);
        }

        self->write_back_global_var(global_var);
    }

    fn write_back_global_var(self: Self*, global_var: const cir::TypedGlobalVarStmt*) {
        var decl = self->decl_tables->global_vars.get(global_var->global_var_decl_id).unwrap();
        decl->rhs = global_var->rhs;
        decl->ty = global_var->ty;
    }

    fn write_back_var(self: Self*, var_: const cir::TypedVarStmt*) {
        var decl = self->decl_tables->vars.get(var_->var_decl_id).unwrap();
        decl->rhs = var_->rhs;
        decl->ty = var_->ty;
    }

    fn analyze_var(self: Self*, var_: cir::TypedVarStmt*) {
        switch (var_->ty) {
            case .Some(ty) => {
                const normalized = self->normalize_and_check_type_formation(ty, var_->span, 0);
                var_->ty = normalized;
            }
            case .None => {}
        }

        switch (var_->rhs) {
            case .Some(var expr) => {
                const inferred_type_opt = self->analyze_expr(&expr, var_->ty);

                var_->rhs = .Some(expr);

                switch (inferred_type_opt) {
                    case .None => {
                        if (var_->ty.is_none()) {
                            var_->ty = .Some(cir::SemaType.Err(var_->span));
                        }
                        self->write_back_var(var_);
                        return;
                    }
                    case .Some(inferred_type) => {
                        if (var_->ty.is_none()) {
                            var_->ty = .Some(inferred_type);
                        }
                    }
                }

                var ty = var_->ty.unwrap();
                var rhs = var_->rhs.unwrap();

                const coerce = self->coerce_interface_as_interface_object_if_possible(
                    &ty,
                    &rhs,
                    var_->span
                );

                var_->ty = .Some(coerce);
            }
            case .None => {}
        }

        switch (var_->ty) {
            case .Some(ty) => {
                if (ty.contains_error()) {
                    self->write_back_var(var_);
                    return;
                }

                if (is_const_qualified_type_assigned_to_non_const_variable(&ty, var_->is_const)) {
                    diags::report_const_qualified_type_assigned_to_non_const_variable(
                        self->dctx,
                        self->allocator,
                        var_->span
                    );
                }

                const is_init = var_->rhs.is_some() || var_->is_undef;

                if (!self->validate_variable_type(&ty, is_init, var_->span)) {
                    var_->ty = .Some(cir::SemaType.Err(var_->span));
                    self->write_back_var(var_);
                    return;
                }

                const expand = self->expand_sema_type(ty, var_->span);
                var_->ty = .Some(expand);
            }
            case .None => {}
        }

        switch (var_->rhs) {
            case .Some(expr) => {
                switch (var_->ty) {
                    case .Some(target_type) => {
                        var skip_mismatch = target_type.contains_error();

                        switch (expr.ty) {
                            case .Some(expr_ty) => {
                                if (expr_ty.contains_error()) {
                                    skip_mismatch = true;
                                }
                            }
                            case .None => skip_mismatch = true;
                        }

                        if (!skip_mismatch) {
                            switch (expr.ty) {
                                case .Some(expr_ty) => {
                                    if (!self->is_assignable_to(expr_ty, target_type, var_->span)) {
                                        var lhs_name = format::format_sema_type(
                                            self->allocator,
                                            self->decl_tables,
                                            &target_type
                                        );
                                        defer lhs_name.free();
                                        var rhs_name = format::format_sema_type(
                                            self->allocator,
                                            self->decl_tables,
                                            &expr_ty
                                        );
                                        defer rhs_name.free();
                                        diags::report_assignment_type_mismatch(
                                            self->dctx,
                                            self->allocator,
                                            var_->span,
                                            lhs_name.as_str_const(),
                                            rhs_name.as_str_const()
                                        );
                                    }
                                }
                                case .None => {}
                            }
                        }
                    }
                    case .None => {}
                }
            }
            case .None => {}
        }

        if (var_->ty.is_none()) {
            const err = cir::SemaType.Err(var_->span);
            var_->ty = .Some(err);
        }

        if (var_->ty.is_none() && var_->is_undef) {
            diags::report_undefined_without_type_annotation(self->dctx, self->allocator, var_->span);
        }

        self->write_back_var(var_);
    }

    pub fn analyze_func_def(self: Self*, func_def: cir::TypedFuncDefStmt*) {
        const is_generic_func = func_def->is_generic();

        self->analyze_entry_func(func_def);

        const func_decl_id = func_def->func_decl_id.unwrap();

        var func_decl = *self->decl_tables->funcs.get(func_decl_id).unwrap();

        self->analyze_func_decl(&func_decl);

        func_def->params = func_decl.params;
        func_def->ret_type = func_decl.ret_type;

        var decl_slot = self->decl_tables->funcs.get(func_decl_id).unwrap();
        decl_slot->params = func_decl.params;
        decl_slot->ret_type = func_decl.ret_type;

        if (!is_generic_func) {
            const func_type = func_decl_as_func_type(self->allocator, &func_decl);
            
            var func_env = self->create_func_def_env(func_decl.name.as_str_const(), func_type, .None);
            var saved_func_env = self->func_env;
            self->func_env = func_env;
            self->analyze_func_body(func_def->body, &func_def->ret_type);
            self->func_env = saved_func_env;
        }
    }

    pub fn analyze_func_decl_stmt(self: Self*, func_decl_stmt: cir::TypedFuncDeclStmt*) {
        if (func_decl_stmt->is_generic()) {
            diags::report_generic_function_declaration(self->dctx, self->allocator, func_decl_stmt->span);
        }

        var func_decl = *self->decl_tables->funcs.get(func_decl_stmt->func_decl_id).unwrap();

        self->analyze_func_decl(&func_decl);

        func_decl_stmt->params = func_decl.params;
        func_decl_stmt->ret_type = func_decl.ret_type;

        var decl_slot = self->decl_tables->funcs.get(func_decl_stmt->func_decl_id).unwrap();
        decl_slot->params = func_decl.params;
        decl_slot->ret_type = func_decl.ret_type;
    }

    pub fn analyze_func_decl(self: Self*, func_decl: cir::FuncDecl*) {
        const is_not_generic_func = !func_decl->is_generic();

        diags::report_if_duplicate_param_names(
            self->dctx, 
            self->allocator, 
            self->decl_tables, 
            &func_decl->params,
            func_decl->span
        );

        switch (self->normalize_sema_type(func_decl->ret_type, func_decl->span, 0)) {
            case .Some(ty) => {
                func_decl->ret_type = ty;
            }
            case .None => {
                return;
            }
        }

        if (is_not_generic_func) {
            self->check_type_formation(func_decl->ret_type, func_decl->span);
        }

        self->normalize_func_params(&func_decl->params, is_not_generic_func, 0);

        self->analyze_generic_bounds(&func_decl->generic_params);
    }

    pub fn analyze_func_body(self: Self*, body: cir::TypedBlockStmt*, ret_type: const cir::SemaType*) {
        const flow_state = self->analyze_block_stmt(body);

        if (!ret_type->is_void() 
            && !flow_state.is_returns() 
            && !flow_state.is_unreachable() 
            && !self->dctx->has_errors()) {
            diags::report_missing_return(self->dctx, self->allocator, body->span);
        }
    }

    fn analyze_entry_func(self: Self*, func_def: const cir::TypedFuncDefStmt*) {
        var is_public = false;
        var is_extern = false;

        switch (func_def->modifiers.vis) {
            case .Public => { is_public = true; }
            case .Private => {}
        }

        switch (func_def->modifiers.extrn) {
            case .Some => { is_extern = true; }
            case .None => {}
        }

        if (func_def->name.as_str_const() == "main") {
            if (!is_public && !is_extern) {
                diags::report_private_entry_point(self->dctx, self->allocator, func_def->span);
            }
        }
    }

    fn analyze_builtin_func_used_as_stmt(self: Self*, stmt: cir::TypedStmt*) FlowState {
        switch (stmt->kind) {
            case .Builtin(.BuiltinFunc(builtin_func)) => {
                const span = builtin_func.span;
                const name = builtin_func.name.str.as_str_const();

                var builtin_expr = cir::TypedExpr.new(.Builtin(.BuiltinFunc(builtin_func)), span);
                builtin_expr.val_cat = .RValue;

                if (self->analyze_expr(&builtin_expr, .None).is_none()) {
                    return .Reachable;
                }

                stmt->kind = .Expr(builtin_expr);

                if (cir::is_builtin_unreachable(name)) {
                    return .Unreachable;
                }

                return .Reachable;
            }
            case .Builtin(.BuiltinBlock) => {
                return self->analyze_builtin(stmt, false);
            }
            else => {
                return .Reachable;
            }
        }
    }

    fn analyze_builtin(self: Self*, stmt: cir::TypedStmt*, is_toplevel: bool) FlowState {
        switch (stmt->kind) {
            case .Builtin(.BuiltinFunc(var builtin_func)) => {
                const result = self->analyze_builtin_expr(&builtin_func);
                
                stmt->kind = .Builtin(.BuiltinFunc(builtin_func));

                if (result.is_none()) {
                    return .Reachable;
                }

                if (cir::is_builtin_unreachable(builtin_func.name.str.as_str_const())) {
                    return .Unreachable;
                }

                return .Reachable;
            }
            case .Builtin(.BuiltinBlock(var builtin_block)) => {
                const flow = self->analyze_builtin_block(&builtin_block, is_toplevel);
                stmt->kind = .Builtin(.BuiltinBlock(builtin_block));
                return flow;
            }
            else => {
                return .Reachable;
            }
        }
    }

    fn analyze_builtin_block(self: Self*, builtin_block: cir::TypedBuiltinBlock*, is_toplevel: bool) FlowState {
        switch (cir::lookup_builtin(builtin_block->name.str.as_str_const())) case .Some(builtin_kind) else {
            diags::report_builtin_not_defined(
                self->dctx,
                self->allocator,
                builtin_block->span,
                builtin_block->name.str.as_str_const()
            );
            return .Reachable;
        }

        const builtin_spec = cir::builtin_spec_of(builtin_kind);

        if (!self->validate_builtin_form(builtin_spec, .Stmt, builtin_block->span)) {
            return .Reachable;
        }

        builtin_block->is_toplevel = .Some(is_toplevel);

        if (is_toplevel) {
            self->analyze_toplevel_stmts(&builtin_block->block->stmts);
            return .Reachable;
        } else {
            return self->analyze_block_stmt(builtin_block->block);
        }
    }

    fn write_struct_back(self: Self*, struct_decl_id: cir::StructDeclId, struct_decl: cir::StructDecl) {
        var slot = self->decl_tables->structs.get(struct_decl_id).unwrap();
        *slot = struct_decl;
    }

    fn write_union_back(self: Self*, union_decl_id: cir::UnionDeclId, union_decl: cir::UnionDecl) {
        var slot = self->decl_tables->unions.get(union_decl_id).unwrap();
        *slot = union_decl;
    }

    fn write_enum_back(self: Self*, enum_decl_id: cir::EnumDeclId, enum_decl: cir::EnumDecl) {
        var slot = self->decl_tables->enums.get(enum_decl_id).unwrap();
        *slot = enum_decl;
    }

    fn write_method_back(self: Self*, method_decl_id: cir::MethodDeclId, method_decl: cir::MethodDecl) {
        var slot = self->decl_tables->methods.get(method_decl_id).unwrap();
        *slot = method_decl;
    }


    pub fn analyze_struct_stmt(self: Self*, struct_stmt: cir::TypedStructStmt*) {
        var struct_decl = *self->decl_tables->structs.get(struct_stmt->struct_decl_id).unwrap();

        if (!struct_stmt->is_generic()) {
            var object_type = cir::SemaType.Named(cir::NamedType {
                type_decl_id: .Struct(struct_stmt->struct_decl_id),
                type_args: cir::TypedTypeArgs.new(self->allocator),
            });
            var old_object = self->func_env.current_object;
            self->func_env.current_object = .Some(object_type);
            self->analyze_struct_decl(struct_stmt->struct_decl_id, &struct_decl);
            self->func_env.current_object = old_object;
        } else {
            self->analyze_struct_decl(struct_stmt->struct_decl_id, &struct_decl);
        }

        struct_stmt->fields = struct_decl.fields;

        self->write_struct_back(struct_stmt->struct_decl_id, struct_decl);
    }

    fn analyze_struct_decl(self: Self*, struct_decl_id: cir::StructDeclId, struct_decl: cir::StructDecl*) {
        self->validate_align(&struct_decl->align, struct_decl->span);
        self->validate_struct_repr_attr(&struct_decl->modifiers.repr_attr, struct_decl->fields.len(), struct_decl->span);

        var object_name = format::format_struct_decl(self->allocator, self->decl_tables, struct_decl);
        defer object_name.free();
        
        self->check_duplicate_struct_field(object_name.as_str_const(), &struct_decl->fields);

        for (var i: usize = 0; i < struct_decl->fields.len(); i += 1) {
            const field = struct_decl->fields.get(i).unwrap();

            switch (self->normalize_and_check_type_formation(field->ty, field->span, 0)) {
                case .Some(ty) => field->ty = ty;
                case .None => field->ty = .Err(field->span);
            }

            if (!field->ty.contains_generic_param()) {
                self->validate_struct_field_type(struct_decl_id, &field->ty, field->span);
            }
        }

        self->analyze_generic_bounds(&struct_decl->generic_params);

        if (!struct_decl->is_generic()) {
            self->analyze_object_methods(.Struct(struct_decl_id), &struct_decl->methods);
        }

        self->analyze_object_implements_interfaces(
            object_name.as_str_const(),
            struct_decl->is_generic(),
            &struct_decl->impls,
            &struct_decl->methods
        );

    }

    fn check_duplicate_struct_field(self: Self*, object_name: const uint8*, fields: const Vec<cir::TypedStructField>*) {
        for (var i: usize = 0; i < fields->len(); i += 1) {
            const field = fields->get_const(i).unwrap();

            for (var j: usize = 0; j < i; j += 1) {
                const prev = fields->get_const(j).unwrap();

                if (prev->name.as_str_const() == field->name.as_str_const()) {
                    diags::report_duplicate_field_name(
                        self->dctx,
                        self->allocator,
                        field->span,
                        object_name,
                        field->name.as_str_const()
                    );
                    break;
                }
            }
        }
    }

    fn validate_struct_repr_attr(
        self: Self*, 
        repr_attr: const Option<ast::ASTReprAttr>*, 
        fields_count: usize,
        span: Span
    ) {
        switch (*repr_attr) {
            case .Some(attr) => {
                switch (repr_attr_kind(&attr)) {
                    case .Some(.Cyrus) => return;
                    case .Some(.C) => return;
                    case .None => return;
                    case .Some(.Transparent) => {
                        if (fields_count != 1) {
                            diags::report_invalid_repr_attr(
                                self->dctx,
                                self->allocator,
                                span,
                                "repr(transparent)` struct must have exactly one field",
                            "remove the extra fields or drop the `repr(transparent)` attribute"
                            );
                        }

                        if (is_attr_repr_packed(&attr)) {
                            diags::report_invalid_repr_attr(
                                self->dctx,
                                self->allocator,
                                span,
                                "`repr(transparent)` cannot be combined with `repr(packed)`",
                            "use either `repr(transparent)` or `repr(packed)`, not both"
                            );
                        }
                    }
                }
            }
            case .None => return;
        }
    }

    fn validate_struct_field_type(self: Self*, struct_decl_id: cir::StructDeclId, sema_type: const cir::SemaType*, span: Span) {
        const inner = sema_type->const_inner();

        if (inner->is_void()) {
            diags::report_void_field_type(self->dctx, self->allocator, span);
        }

        var ty = cir::NamedType {
            type_decl_id: .Struct(struct_decl_id),
            type_args: cir::TypedTypeArgs.new(self->allocator),
        };

        if (type_contains_self_by_value(inner, &ty)) {
            var type_name = format::format_sema_type(self->allocator, self->decl_tables, inner);
            defer type_name.free();
            diags::report_infinite_size_recursive_type(self->dctx, self->allocator, span, type_name.as_str_const());
            return;
        }

        self->check_type_arity(*inner, span);
    }

    pub fn analyze_union_stmt(self: Self*, union_stmt: cir::TypedUnionStmt*) {
        var union_decl = *self->decl_tables->unions.get(union_stmt->union_decl_id).unwrap();

        if (!union_stmt->is_generic()) {
            var object_type = cir::SemaType.Named(cir::NamedType {
                type_decl_id: .Union(union_stmt->union_decl_id),
                type_args: cir::TypedTypeArgs.new(self->allocator),
            });
            var old_object = self->func_env.current_object;
            self->func_env.current_object = .Some(object_type);
            self->analyze_union_decl(union_stmt->union_decl_id, &union_decl);
            self->func_env.current_object = old_object;
        } else {
            self->analyze_union_decl(union_stmt->union_decl_id, &union_decl);
        }

        union_stmt->fields = union_decl.fields;

        self->write_union_back(union_stmt->union_decl_id, union_decl);
    }

    fn analyze_union_decl(self: Self*, union_decl_id: cir::UnionDeclId, union_decl: cir::UnionDecl*) {
        self->validate_align(&union_decl->align, union_decl->span);
        self->validate_union_repr_attr(&union_decl->modifiers.repr_attr, union_decl->fields.len(), union_decl->span);

        var object_name = format::format_union_decl(self->allocator, self->decl_tables, union_decl);
        defer object_name.free();

        self->check_duplicate_union_field(object_name.as_str_const(), &union_decl->fields);

        for (var i: usize = 0; i < union_decl->fields.len(); i += 1) {
            const field = union_decl->fields.get(i).unwrap();

            switch (self->normalize_and_check_type_formation(field->ty, field->span, 0)) {
                case .Some(ty) => field->ty = ty;
                case .None => field->ty = .Err(field->span);
            }

            if (!field->ty.contains_generic_param()) {
                self->validate_union_field_type(union_decl_id, &field->ty, field->span);
            }
        }

        self->analyze_generic_bounds(&union_decl->generic_params);

        if (!union_decl->is_generic()) {
            self->analyze_object_methods(.Union(union_decl_id), &union_decl->methods);
        }

        self->analyze_object_implements_interfaces(
            object_name.as_str_const(),
            union_decl->is_generic(),
            &union_decl->impls,
            &union_decl->methods
        );

    }

    fn check_duplicate_union_field(self: Self*, object_name: const uint8*, fields: const Vec<cir::TypedUnionField>*) {
        for (var i: usize = 0; i < fields->len(); i += 1) {
            const field = fields->get_const(i).unwrap();

            for (var j: usize = 0; j < i; j += 1) {
                const other = fields->get_const(j).unwrap();

                if (field->name.as_str_const() == other->name.as_str_const()) {
                    diags::report_duplicate_field_name(
                        self->dctx,
                        self->allocator,
                        field->span,
                        object_name,
                        field->name.as_str_const()
                    );
                    break;
                }
            }
        }
    }

    fn validate_union_repr_attr(self: Self*, repr_attr: const Option<ast::ASTReprAttr>*, fields_count: usize, span: Span) {
        switch (*repr_attr) {
            case .Some(attr) => {
                if (is_attr_repr_packed(&attr)) {
                    diags::report_invalid_repr_attr(
                        self->dctx,
                        self->allocator,
                        span,
                        "packed layout is not supported for unions",
                    "remove the `repr(packed)` attribute"
                    );
                    return;
                }

                switch (repr_attr_kind(&attr)) {
                    case .Some(.Cyrus) => return;
                    case .Some(.C) => return;
                    case .Some(.Transparent) => {
                        if (fields_count != 1) {
                            diags::report_invalid_repr_attr(
                                self->dctx,
                                self->allocator,
                                span,
                                "`repr(transparent)` union must have exactly one field",
                            "remove the extra fields or drop the `repr(transparent)` attribute"
                            );
                        }
                    }
                    case .None => return;
                }
            }
            case .None => return;
        }
    }

    fn validate_union_field_type(self: Self*, union_decl_id: cir::UnionDeclId, sema_type: const cir::SemaType*, span: Span) {
        const inner = sema_type->const_inner();

        if (inner->is_void()) {
            diags::report_void_field_type(self->dctx, self->allocator, span);
        }

        var ty = cir::NamedType {
            type_decl_id: .Union(union_decl_id),
            type_args: cir::TypedTypeArgs.new(self->allocator),
        };

        if (type_contains_self_by_value(inner, &ty)) {
            var type_name = format::format_sema_type(self->allocator, self->decl_tables, inner);
            defer type_name.free();
            diags::report_infinite_size_recursive_type(self->dctx, self->allocator, span, type_name.as_str_const());
            return;
        }

        self->check_type_arity(*inner, span);
    }

    pub fn analyze_enum_stmt(self: Self*, enum_stmt: cir::TypedEnumStmt*) {
        var enum_decl = *self->decl_tables->enums.get(enum_stmt->enum_decl_id).unwrap();

        if (!enum_stmt->is_generic()) {
            var object_type = cir::SemaType.Named(cir::NamedType {
                type_decl_id: .Enum(enum_stmt->enum_decl_id),
                type_args: cir::TypedTypeArgs.new(self->allocator),
            });
            var old_object = self->func_env.current_object;
            self->func_env.current_object = .Some(object_type);
            self->analyze_enum_decl(enum_stmt->enum_decl_id, &enum_decl);
            self->func_env.current_object = old_object;
        } else {
            self->analyze_enum_decl(enum_stmt->enum_decl_id, &enum_decl);
        }

        enum_stmt->variants = enum_decl.variants;
        enum_stmt->tag_type = enum_decl.tag_type;

        self->write_enum_back(enum_stmt->enum_decl_id, enum_decl);
    }

    fn analyze_enum_decl(self: Self*, enum_decl_id: cir::EnumDeclId, enum_decl: cir::EnumDecl*) {
        const is_repr_c = enum_decl->is_repr_c();

        self->validate_align(&enum_decl->align, enum_decl->span);
        self->validate_enum_repr_attr(&enum_decl->modifiers.repr_attr, enum_decl->align.is_some(), enum_decl->span);
        self->validate_enum_tag_type(&enum_decl->tag_type, enum_decl->span);

        var object_name = format::format_enum_decl(self->allocator, self->registry, self->decl_tables, enum_decl);
        defer object_name.free();
        
        self->check_duplicate_enum_variants(object_name.as_str_const(), &enum_decl->variants);

        for (var i: usize = 0; i < enum_decl->variants.len(); i += 1) {
            const variant = enum_decl->variants.get(i).unwrap();
            self->analyze_enum_variant(enum_decl_id, variant, &enum_decl->tag_type, is_repr_c);
        }

        self->analyze_generic_bounds(&enum_decl->generic_params);

        if (!enum_decl->is_generic()) {
            self->analyze_object_methods(.Enum(enum_decl_id), &enum_decl->methods);
        }

        self->analyze_object_implements_interfaces(
            object_name.as_str_const(),
            enum_decl->is_generic(),
            &enum_decl->impls,
            &enum_decl->methods
        );

    }

    fn analyze_enum_variant(
        self: Self*,
        enum_decl_id: cir::EnumDeclId,
        variant: cir::TypedEnumVariant*,
        tag_type_opt: const Option<cir::SemaType>*,
        is_repr_c: bool
    ) {
        switch (*variant) {
            case .Unit => return;

            case .Valued { ident, value } => {
                self->analyze_expr(value, *tag_type_opt);

                switch (value->ty) {
                    case .Some(value_type) => {
                        if (is_repr_c && !value_type.is_integer()) {
                            diags::report_repr_c_enum_with_non_integer_variant(
                                self->dctx,
                                self->allocator,
                                ident.span
                            );
                        }

                        switch (*tag_type_opt) {
                            case .Some(tag_type) => {
                                if (!self->is_assignable_to(value_type, tag_type, value->span)) {
                                    var got = format::format_sema_type(self->allocator, self->decl_tables, &value_type);
                                    defer got.free();
                                    var expected_str = format::format_sema_type(
                                        self->allocator,
                                        self->decl_tables,
                                        &tag_type
                                    );
                                    defer expected_str.free();
                                    diags::report_invalid_enum_variant_value_type(
                                        self->dctx,
                                        self->allocator,
                                        value->span,
                                        got.as_str_const(),
                                        expected_str.as_str_const()
                                    );
                                }
                            }
                            case .None => return;
                        }
                    }
                    case .None => return;
                }
            }

            case .Tuple { ident, var fields } => {
                if (is_repr_c) {
                    diags::report_repr_c_enum_with_non_integer_variant(
                        self->dctx, 
                        self->allocator, 
                        ident.span
                    );
                }

                for (var i: usize = 0; i < fields.len(); i += 1) {
                    const field = fields.get(i).unwrap();

                    switch (self->normalize_and_check_type_formation(field->ty, field->span, 0)) {
                        case .Some(ty) => field->ty = ty;
                        case .None => field->ty = .Err(field->span);
                    }

                    if (!field->ty.contains_generic_param()) {
                        self->validate_enum_variant_field_type(enum_decl_id, &field->ty, field->span);
                    }
                }
            }

            case .Struct { ident, var fields } => {
                if (is_repr_c) {
                    diags::report_repr_c_enum_with_non_integer_variant(
                        self->dctx, 
                        self->allocator, 
                        ident.span
                    );
                }

                for (var i: usize = 0; i < fields.len(); i += 1) {
                    const field = fields.get(i).unwrap();

                    switch (self->normalize_and_check_type_formation(field->ty, field->span, 0)) {
                        case .Some(ty) => field->ty = ty;
                        case .None => field->ty = .Err(field->span);
                    }

                    if (!field->ty.contains_generic_param()) {
                        self->validate_enum_variant_field_type(enum_decl_id, &field->ty, field->span);
                    }
                }
            }
        }
    }

    fn check_duplicate_enum_variants(self: Self*, object_name: const uint8*, variants: const Vec<cir::TypedEnumVariant>*) {
        for (var i: usize = 0; i < variants->len(); i += 1) {
            const variant = variants->get_const(i).unwrap();
            const name = variant->name();

            for (var j: usize = 0; j < i; j += 1) {
                const prev = variants->get_const(j).unwrap();

                if (prev->name() == name) {
                    diags::report_duplicate_enum_variant_name(
                        self->dctx,
                        self->allocator,
                        variant->span(),
                        object_name,
                        name
                    );
                    break;
                }
            }
        }
    }

    fn validate_enum_repr_attr(self: Self*, repr_attr: const Option<ast::ASTReprAttr>*, has_align: bool, span: Span) {
        switch (*repr_attr) {
            case .Some(attr) => {
                if (is_attr_repr_packed(&attr)) {
                    diags::report_invalid_repr_attr(
                        self->dctx,
                        self->allocator,
                        span,
                        "`repr(packed)` is not valid for enums",
                        "remove the `repr(packed)` attribute"
                    );
                    return;
                }

                switch (repr_attr_kind(&attr)) {
                    case .Some(.C) => {
                        if (has_align) {
                            diags::report_invalid_repr_attr(
                                self->dctx,
                                self->allocator,
                                span,
                                "cannot specify alignment with `repr(c)` or `repr(cyrus)` enum layout, alignment is determined by the target ABI",
                                "remove the alignment from the repr attribute"
                            );
                            return;
                        }
                    }
                    case .Some(.Cyrus) => {
                        if (has_align) {
                            diags::report_invalid_repr_attr(
                                self->dctx,
                                self->allocator,
                                span,
                                "cannot specify alignment with `repr(c)` or `repr(cyrus)` enum layout, alignment is determined by the target ABI",
                                "remove the alignment from the repr attribute"
                            );
                            return;
                        }
                    }
                    case .Some(.Transparent) => {
                        diags::report_invalid_repr_attr(
                            self->dctx,
                            self->allocator,
                            span,
                            "`repr(transparent)` cannot be applied to enums",
                            "enums only support `repr(c)` and `repr(cyrus)` layouts"
                        );
                        return;
                    }
                    case .None => return;
                }
            }
            case .None => return;
        }
    }

    fn validate_enum_tag_type(self: Self*, tag_type: const Option<cir::SemaType>*, span: Span) {
        switch (*tag_type) {
            case .Some(ty) => {
                const inner = ty.const_inner();
                const valid = inner->is_integer() 
                    || inner->is_uint8() 
                    || inner->is_bool();

                if (!valid) {
                    var got = format::format_sema_type(self->allocator, self->decl_tables, inner);
                    defer got.free();
                    diags::report_invalid_enum_tag_type(self->dctx, self->allocator, span, got.as_str_const());
                }
            }
            case .None => return;
        }
    }

    fn validate_enum_variant_field_type(self: Self*, enum_decl_id: cir::EnumDeclId, sema_type: const cir::SemaType*, span: Span) {
        const inner = sema_type->const_inner();

        var ty = cir::NamedType {
            type_decl_id: .Enum(enum_decl_id),
            type_args: cir::TypedTypeArgs.new(self->allocator),
        };

        if (type_contains_self_by_value(inner, &ty)) {
            var type_name = format::format_sema_type(self->allocator, self->decl_tables, inner);
            defer type_name.free();
            diags::report_infinite_size_recursive_type(self->dctx, self->allocator, span, type_name.as_str_const());
            return;
        }

        self->check_type_arity(*inner, span);
    }

    fn validate_align(self: Self*, align: const Option<usize>*, span: Span) {
        switch (*align) {
            case .Some(value) => {
                if (value == 0 || (value & (value - 1)) != 0) {
                    diags::report_invalid_align(self->dctx, self->allocator, span, value);
                }
            }
            case .None => return;
        }
    }

    pub fn analyze_interface(self: Self*, interface_stmt: cir::TypedInterfaceStmt*) {
        const interface_name = interface_stmt->name.as_str_const();
        
        var is_interface_dynamically_dispatchable = true;

        for (var i: usize = 0; i < interface_stmt->methods.entries.len(); i += 1) {
            const entry = interface_stmt->methods.entries.get_const(i).unwrap();

            var method_decl = *self->decl_tables->methods.get(entry->id).unwrap();
            self->analyze_method_decl(.Interface(interface_stmt->interface_decl_id), &method_decl);

            self->write_method_back(entry->id, method_decl);

            const func_decl = &method_decl.func_decl;

            var params_start: usize = 0;

            switch (func_decl->params.get_self_modifier()) {
                case .Some(self_modifier) => {
                    if (!self_modifier.ty.is_pointer()) {
                        diags::report_interface_methods_must_use_referenced_self(
                            self->dctx,
                            self->allocator,
                            self_modifier.span
                        );
                    }
                    params_start = 1;
                }
                case .None => {
                    diags::report_interface_methods_must_have_self_modifier(
                        self->dctx,
                        self->allocator,
                        func_decl->span
                    );
                }
            }

            for (var j: usize = params_start; j < func_decl->params.list.len(); j += 1) {
                const param = func_decl->params.list.get_const(j).unwrap();
                const ty = param->ty();

                if (ty.contains_self_type()) {
                    diags::report_interface_method_param_contains_self(
                        self->dctx,
                        self->allocator,
                        param->span(),
                        interface_name,
                        func_decl->name.as_str_const()
                    );
                }
            }

            if (func_decl->is_generic()) {
                is_interface_dynamically_dispatchable = false;
            }

            if (func_decl->ret_type.contains_self_type()) {
                is_interface_dynamically_dispatchable = false;
            }

            var is_duplicate = false;

            for (var j: usize = 0; j < i; j += 1) {
                const entry = interface_stmt->methods.entries.get_const(j).unwrap();

                if (entry->name.as_str_const() == func_decl->name.as_str_const()) {
                    is_duplicate = true;
                    break;
                }
            }

            if (is_duplicate) {
                diags::report_interface_duplicate_method(
                    self->dctx,
                    self->allocator,
                    func_decl->span,
                    interface_name,
                    func_decl->name.as_str_const()
                );
                continue;
            }
        }

        var slot = self->decl_tables->interfaces.get(interface_stmt->interface_decl_id).unwrap();
        slot->is_interface_dynamically_dispatchable = is_interface_dynamically_dispatchable;
    }

    pub fn analyze_object_implements_interfaces(
        self: Self*,
        object_name: const uint8*,
        is_object_generic: bool,
        impls: const Vec<cir::TypedImplementInterface>*,
        method_decls: const cir::MethodDecls*
    ) {
        for (var i: usize = 0; i < impls->len(); i += 1) {
            const implement_interface = impls->get_const(i).unwrap();
            
            switch (self->normalize_and_check_type_formation(
                implement_interface->ty,
                implement_interface->span,
                0
            )) case .Some(normalized) else {
                continue;
            }

            const ty = self->expand_sema_type(normalized, implement_interface->span);

            switch (ty.as_named_interface()) case .Some(interface_id) else {
                var sym = format::format_sema_type(self->allocator, self->decl_tables, &ty);
                defer sym.free();
                diags::report_non_interface_symbol(
                    self->dctx,
                    self->allocator,
                    implement_interface->span,
                    sym.as_str_const()
                );
                continue;
            }

            const named = ty.as_named_type().unwrap();

            const interface_decl = self->decl_tables->interfaces.get(interface_id).unwrap();

            for (var j: usize = 0; j < interface_decl->methods.entries.len(); j += 1) {
                const mentry = interface_decl->methods.entries.get_const(j).unwrap();

                var method = *self->decl_tables->methods.get(mentry->id).unwrap();
                
                const inst = instantiate_method_decl(
                    self->allocator,
                    &method,
                    &interface_decl->generic_params,
                    &named.type_args
                );
                const inst_func = &inst.func_decl;

                if (!method_decls->contains(inst_func->name.as_str_const())) {
                    diags::report_missing_interface_method_impl(
                        self->dctx,
                        self->allocator,
                        implement_interface->span,
                        object_name,
                        inst_func->name.as_str_const(),
                        interface_decl->name.as_str_const()
                    );
                    continue;
                }

                const method_id = method_decls->get(inst_func->name.as_str_const()).unwrap();
                
                var object_method = *self->decl_tables->methods.get(method_id).unwrap();

                if (!is_object_generic && !object_method.func_decl.is_generic()) {
                    if (!func_decl_eq(&object_method.func_decl, inst_func)) {
                        diags::report_interface_method_type_mismatch(
                            self->dctx,
                            self->allocator,
                            inst_func->span,
                            object_name,
                            inst_func->name.as_str_const(),
                            interface_decl->name.as_str_const()
                        );
                    }
                }
            }

            if (!is_object_generic) {
                self->check_type_correctness(ty, implement_interface->span);
            }
        }
    }

    pub fn analyze_object_methods(self: Self*, object_type_decl_id: cir::TypeDeclId, method_decls: const cir::MethodDecls*) {
        for (var i: usize = 0; i < method_decls->entries.len(); i += 1) {
            const entry = method_decls->entries.get_const(i).unwrap();

            var method_decl = *self->decl_tables->methods.get(entry->id).unwrap();
            self->analyze_method_decl(object_type_decl_id, &method_decl);

            switch (self->decl_tables->methods.get(entry->id)) case .Some(var slot) else {
                continue;
            }
            *slot = method_decl;
        }

        var object_type = cir::SemaType.Named(cir::NamedType {
            type_decl_id: object_type_decl_id,
            type_args: cir::TypedTypeArgs.new(self->allocator),
        });

        for (var i: usize = 0; i < method_decls->entries.len(); i += 1) {
            const entry = method_decls->entries.get_const(i).unwrap();

            if (self->decl_tables->methods.get(entry->id).is_none()) {
                continue;
            }

            var method_decl = *self->decl_tables->methods.get(entry->id).unwrap();

            if (!method_decl.func_decl.is_generic()) {
                self->analyze_method_body(&object_type, entry->id, &method_decl);
            }
        }
    }

    fn analyze_method_decl(self: Self*, object_type_decl_id: cir::TypeDeclId, method_decl: cir::MethodDecl*) {
        if (!method_decl->func_decl.is_generic() && !object_type_decl_id.is_interface()) {
            var concrete_self_type = cir::SemaType.Named(cir::NamedType {
                type_decl_id: object_type_decl_id,
                type_args: cir::TypedTypeArgs.new(self->allocator),
            });
            self->apply_self_type_in_method_decl_and_variable(method_decl, &concrete_self_type);
        }

        self->analyze_func_decl(&method_decl->func_decl);
    }

    pub fn analyze_method_body(
        self: Self*,
        object_type: const cir::SemaType*,
        method_decl_id: cir::MethodDeclId,
        method_decl: const cir::MethodDecl*
    ) {
        const func_type = func_decl_as_func_type(self->allocator, &method_decl->func_decl);
        
        var method_env = self->create_method_env(method_decl_id, func_type, .None);
        method_env.current_object = .Some(*object_type);

        if (method_decl->body.is_none()) {
            return;
        }

        const body_id = method_decl->body.unwrap();

        var saved_env = self->func_env;
        self->func_env = method_env;

        var body = *self->decl_tables->bodies.get(body_id).unwrap();
        self->analyze_func_body(&body, &method_decl->func_decl.ret_type);
        
        switch (self->decl_tables->bodies.get(body_id)) case .Some(var slot) else {
            self->func_env = saved_env;
            return;
        }
        *slot = body;

        self->func_env = saved_env;
    }

    pub fn analyze_if_stmt(self: Self*, if_stmt: cir::TypedIfStmt*) FlowState {
        self->analyze_cond_expr(&if_stmt->cond);

        const then_state = self->analyze_block_stmt(if_stmt->then_block);

        var else_state: FlowState = .Reachable;

        switch (if_stmt->else_block) {
            case .Some(block) => else_state = self->analyze_block_stmt(block);
            case .None => {}
        }

        for (var i: usize = 0; i < if_stmt->branches.len(); i += 1) {
            const branch = if_stmt->branches.get(i).unwrap();
            self->analyze_if_stmt(branch);
        }

        return then_state.merge(else_state);
    }

    pub fn analyze_while_loop(self: Self*, typed_while: cir::TypedWhileStmt*) FlowState {
        self->analyze_cond_expr(&typed_while->cond);

        self->control_region_stack.push(.Loop);
        self->analyze_block_stmt(typed_while->body);
        self->control_region_stack.pop();

        return .Reachable;
    }

    pub fn analyze_for_loop(self: Self*, typed_for: cir::TypedForStmt*) FlowState {
        switch (typed_for->initializer) {
            case .Some(var var_) => {
                self->analyze_var(&var_);
                typed_for->initializer = .Some(var_);
            }
            case .None => {}
        }

        switch (typed_for->cond) {
            case .Some(var expr) => {
                self->analyze_cond_expr(&expr);
                typed_for->cond = .Some(expr);
            }
            case .None => {}
        }

        switch (typed_for->increment) {
            case .Some(var expr) => {
                self->analyze_expr(&expr, .None);
                typed_for->increment = .Some(expr);
            }
            case .None => {}
        }

        self->control_region_stack.push(.Loop);
        self->analyze_block_stmt(typed_for->body);
        self->control_region_stack.pop();

        return .Reachable;
    }

    pub fn analyze_return(self: Self*, ret: cir::TypedReturnStmt*) FlowState {
        switch (self->func_env.current_func) case .Some(func_type) else {
            return .Reachable;
        }
        const ret_type = func_type.ret_type;

        switch (ret->arg) {
            case .Some(var expr) => {
                const arg_span = expr.span;
                const arg_type_opt = self->analyze_expr(&expr, .Some(*ret_type));
                ret->arg = .Some(expr);

                switch (arg_type_opt) {
                    case .Some(arg_type) => {
                        const expand = self->expand_sema_type(arg_type, ret->span);

                        if (expand.is_void()) {
                            diags::report_void_function_returns_value(self->dctx, self->allocator, ret->span);
                        } else if (!self->is_assignable_to(arg_type, *ret_type, arg_span)) {
                            var expect = format::format_sema_type(
                                self->allocator,
                                self->decl_tables,
                                ret_type->const_inner()
                            );
                            defer expect.free();
                            var got = format::format_sema_type(
                                self->allocator,
                                self->decl_tables,
                                arg_type.const_inner()
                            );
                            defer got.free();
                            diags::report_return_statement_type_mismatch(
                                self->dctx,
                                self->allocator,
                                ret->span,
                                expect.as_str_const(),
                                got.as_str_const()
                            );
                        }
                    }
                    case .None => return .Reachable;
                }
            }
            case .None => {
                const expand = self->expand_sema_type(*ret_type, ret->span);

                if (!expand.is_void()) {
                    var arg_str = format::format_sema_type(self->allocator, self->decl_tables, ret_type);
                    defer arg_str.free();
                    diags::report_return_statement_needs_an_argument(
                        self->dctx,
                        self->allocator,
                        ret->span,
                        arg_str.as_str_const()
                    );
                }
            }
        }

        return .Returns;
    }

    pub fn analyze_break(self: Self*, break_stmt: const cir::TypedBreakStmt*) FlowState {
        var valid = false;

        for (var i: usize = 0; i < self->control_region_stack.len(); i += 1) {
            const region = self->control_region_stack.get_const(i).unwrap();

            if (region->allows_break()) {
                valid = true;
                break;
            }
        }

        if (!valid) {
            diags::report_invalid_break_statement(
                self->dctx, 
                self->allocator, 
                break_stmt->span
            );
            return .Reachable;
        }

        return .Unreachable;
    }

    pub fn analyze_continue(self: Self*, continue_: const cir::TypedContinueStmt*) FlowState {
        var valid = false;

        for (var i: usize = 0; i < self->control_region_stack.len(); i += 1) {
            const region = self->control_region_stack.get_const(i).unwrap();

            if (region->allows_continue()) {
                valid = true;
                break;
            }
        }

        if (!valid) {
            diags::report_invalid_continue_statement(self->dctx, self->allocator, continue_->span);
            return .Reachable;
        }

        return .Unreachable;
    }

    pub fn analyze_switch(self: Self*, switch_: cir::TypedSwitchStmt*) FlowState {
        if (self->analyze_expr(&switch_->operand, .None).is_none()) {
            return .Reachable;
        }

        switch (switch_->operand.ty) {
            case .Some(ty) => {
                var expand = self->expand_sema_type(ty, switch_->span);
                switch_->operand.ty = .Some(expand);
            }
            case .None => return .Reachable;
        }

        const operand_type = switch_->operand.ty.unwrap();

        self->control_region_stack.push(.Switch);
        const flow = self->analyze_switch_dispatch(switch_, &operand_type);
        self->control_region_stack.pop();

        return flow;
    }

    fn analyze_switch_dispatch(self: Self*, switch_: cir::TypedSwitchStmt*, operand_type: const cir::SemaType*) FlowState {
        if (switch_->cases.is_empty()) {
            diags::report_empty_case_switch(self->dctx, self->allocator, switch_->span);
            return .Reachable;
        }

        if (operand_type->is_enum()) {
            return self->analyze_switch_on_enum(switch_, operand_type);
        }

        if (operand_type->is_plain_type() || operand_type->is_uint8_pointer()) {
            return self->analyze_switch_on_value(switch_, operand_type);
        }

        if (operand_type->contains_error()) {
            // Prevent cascading failures
            return self->analyze_switch_on_poisoned_operand(switch_);
        }

        var expr_type = format::format_sema_type(self->allocator, self->decl_tables, operand_type);
        defer expr_type.free();
        diags::report_switch_operand_not_enum(
            self->dctx,
            self->allocator,
            switch_->span,
            expr_type.as_str_const()
        );
        return .Reachable;
    }

    fn analyze_switch_on_poisoned_operand(self: Self*, switch_: cir::TypedSwitchStmt*) FlowState {
        for (var i: usize = 0; i < switch_->cases.len(); i += 1) {
            const case_ = switch_->cases.get(i).unwrap();
            self->analyze_block_stmt(case_->body);
        }
        
        switch (switch_->else_case) {
            case .Some(var block) => {
                self->analyze_block_stmt(&block);
                switch_->else_case = .Some(block);
            }
            case .None => {}
        }

        switch_->all_cases_covered = .Some(true);

        return .Reachable;
    }

    fn analyze_switch_on_value(self: Self*, switch_: cir::TypedSwitchStmt*, operand_type: const cir::SemaType*) FlowState {
        var flow_states: Vec<FlowState> = Vec.new(self->allocator);
        defer flow_states.free();

        for (var i: usize = 0; i < switch_->cases.len(); i += 1) {
            const case_ = switch_->cases.get(i).unwrap();

            self->analyze_switch_on_value_case_patterns(&case_->patterns, operand_type, case_->span);

            const body_flow = self->analyze_block_stmt(case_->body);
            flow_states.push(body_flow);
        }

        switch_->all_cases_covered = .Some(false);

        switch (switch_->else_case) {
            case .Some(var block) => {
                const default_flow = self->analyze_block_stmt(&block);
                switch_->else_case = .Some(block);

                flow_states.push(default_flow);
                switch_->all_cases_covered = .Some(true);
            }
            case .None => flow_states.push(.Reachable);
        }

        var result: FlowState = .Reachable;

        if (all_flow_states_terminate(&flow_states)) {
            result = .Returns;
        } else if (all_flow_states_are_unreachable(&flow_states)) {
            result = .Unreachable;
        }

        return result;
    }

    fn analyze_switch_on_value_case_patterns(
        self: Self*,
        patterns: cir::Vec<cir::TypedSwitchCasePattern>*,
        operand_type: const cir::SemaType*,
        case_span: Span
    ) {
        var table: Vec<usize> = Vec.new(self->allocator);
        defer table.free();

        for (var i: usize = 0; i < patterns->len(); i += 1) {
            const pattern = patterns->get(i).unwrap();

            var pattern_ranges_opt = self->analyze_switch_value_pattern(pattern, operand_type);

            switch (pattern_ranges_opt) case .Some(var pattern_ranges) else {
                continue;
            }

            if (switch_ranges_valid(&table, &pattern_ranges)) {
                for (var j: usize = 0; j < pattern_ranges.len(); j += 1) {
                    table.push(*pattern_ranges.get_const(j).unwrap());
                }
            } else {
                diags::report_overlapping_switch_case_range(self->dctx, self->allocator, case_span);
                pattern_ranges.free();
                return;
            }

            pattern_ranges.free();
        }

    }

    fn analyze_switch_value_pattern(
        self: Self*,
        pattern: cir::TypedSwitchCasePattern*,
        operand_type: const cir::SemaType*
    ) Option<Vec<usize>> {
        var kind = pattern->kind;

        switch (kind) {
            case .EnumUnit 
            | .EnumStructVariant 
            | .EnumTupleVariant 
            | .Binding 
            | .Wildcard => {
                diags::report_invalid_switch_case_pattern(self->dctx, self->allocator, pattern->span);
                return .Some(Vec.new(self->allocator));
            }

            case .Range(var range) => {
                self->analyze_expr(&range.lower, .Some(*operand_type));
                self->analyze_expr(&range.upper, .Some(*operand_type));
                pattern->kind = .Range(range);

                switch (fold_const_expr_int(self->decl_tables, self->registry, &range.lower)) case .Some(lower_lit) else {
                    return .None;
                }

                switch (fold_const_expr_int(self->decl_tables, self->registry, &range.upper)) case .Some(upper_lit) else {
                    return .None;
                }

                const lower = cir::integer_literal_as_usize(lower_lit);
                const upper = cir::integer_literal_as_usize(upper_lit);

                if (lower >= upper) {
                    diags::report_invalid_range(self->dctx, self->allocator, range.span);
                    return .None;
                }

                var ranges: Vec<usize> = Vec.new(self->allocator);
                ranges.push(lower);
                ranges.push(upper);
                return .Some(ranges);
            }

            case .Expr(var expr) => {
                const expr_type_opt = self->analyze_expr(&expr, .Some(*operand_type));
                pattern->kind = .Expr(expr);

                switch (expr_type_opt) case .Some(expr_type) else {
                    return .None;
                }

                if (!self->is_assignable_to(expr_type, *operand_type, expr.span)) {
                    var pattern_str = format::format_sema_type(
                        self->allocator,
                        self->decl_tables,
                        &expr_type
                    );
                    defer pattern_str.free();
                    var operand_str = format::format_sema_type(
                        self->allocator,
                        self->decl_tables,
                        operand_type
                    );
                    defer operand_str.free();
                    diags::report_incompatible_switch_pattern_type(
                        self->dctx,
                        self->allocator,
                        expr.span,
                        pattern_str.as_str_const(),
                        operand_str.as_str_const()
                    );
                }

                return .Some(Vec.new(self->allocator));
            }
        }
    }

    fn analyze_switch_on_enum(self: Self*, switch_: cir::TypedSwitchStmt*, operand_type: const cir::SemaType*) FlowState {
        switch (operand_type->as_named_type()) case .Some(named) else {
            return .Unreachable;
        }

        switch (named.type_decl_id.as_enum()) case .Some(enum_decl_id) else {
            return .Unreachable;
        }

        const enum_decl = self->decl_tables->enums.get(enum_decl_id).unwrap();
        var inst_enum_decl = instantiate_enum_decl_with_type_args(self->allocator, enum_decl, &named.type_args);

        const all_variants_count = inst_enum_decl.variants.len();

        var all_covered_variants: Vec<String> = Vec.new(self->allocator);
        defer all_covered_variants.free();
        var flow_states: Vec<FlowState> = Vec.new(self->allocator);
        defer flow_states.free();

        for (var i: usize = 0; i < switch_->cases.len(); i += 1) {
            const case_ = switch_->cases.get(i).unwrap();

            var covered = self->analyze_switch_on_enum_case_patterns(&case_->patterns, &inst_enum_decl, case_->span);

            const body_flow = self->analyze_block_stmt(case_->body);
            flow_states.push(body_flow);

            for (var j: usize = 0; j < covered.len(); j += 1) {
                const name = *covered.get_const(j).unwrap();
                str_set_insert(&all_covered_variants, name);
            }

            covered.free();
        }

        switch_->all_cases_covered = .Some(false);

        switch (switch_->else_case) {
            case .Some(var block) => {
                const default_flow = self->analyze_block_stmt(&block);
                switch_->else_case = .Some(block);

                flow_states.push(default_flow);
                switch_->all_cases_covered = .Some(true);
            }
            case .None => {
                if (all_covered_variants.len() == all_variants_count) {
                    switch_->all_cases_covered = .Some(true);
                } else {
                    var missing = String.new(self->allocator);
                    defer missing.free();

                    for (var k: usize = 0; k < inst_enum_decl.variants.len(); k += 1) {
                        const variant = inst_enum_decl.variants.get_const(k).unwrap();
                        const variant_name = variant->name();

                        if (!str_set_contains(&all_covered_variants, variant_name)) {
                            if (missing.len() > 0) {
                                missing.push_str(", ");
                            }

                            missing.push_str(variant_name);
                        }
                    }

                    diags::report_non_exhaustive_switch(
                        self->dctx,
                        self->allocator,
                        switch_->span,
                        missing.as_str_const()
                    );

                    switch_->all_cases_covered = .Some(false);
                    flow_states.push(.Reachable);
                }
            }
        }

        var result: FlowState = .Reachable;

        if (all_flow_states_terminate(&flow_states)) {
            if (all_flow_states_are_unreachable(&flow_states)) {
                result = .Unreachable;
            } else {
                result = .Returns;
            }
        }

        return result;
    }

    fn analyze_switch_on_enum_case_patterns(
        self: Self*,
        patterns: const cir::Vec<cir::TypedSwitchCasePattern>*,
        inst_enum_decl: cir::EnumDecl*,
        span: Span
    ) Vec<String> {
        var enum_name = format::format_enum_decl(self->allocator, self->registry, self->decl_tables, inst_enum_decl);
        defer enum_name.free();

        var exporting_pattern_count: usize = 0;
        var covered_variants: Vec<String> = Vec.new(self->allocator);

        for (var i: usize = 0; i < patterns->len(); i += 1) {
            const pattern = patterns->get_const(i).unwrap();

            self->analyze_enum_switch_pattern(
                pattern,
                inst_enum_decl,
                enum_name.as_str_const(),
                &exporting_pattern_count,
                &covered_variants
            );
        }

        if (exporting_pattern_count > 1) {
            diags::report_multiple_exporting_patterns_in_switch_case(
                self->dctx,
                self->allocator,
                span
            );
        }

        return covered_variants;
    }

    fn analyze_enum_switch_pattern(
        self: Self*,
        pattern: const cir::TypedSwitchCasePattern*,
        inst_enum_decl: cir::EnumDecl*,
        enum_name: const uint8*,
        exporting_pattern_count: usize*,
        covered_variants: Vec<String>*
    ) {
        switch (pattern->kind) {
            case .Wildcard => {
                diags::report_only_variant_pattern_is_allowed_in_switch(
                    self->dctx,
                    self->allocator,
                    pattern->span
                );
                return;
            }

            case .Binding => {
                diags::report_only_variant_pattern_is_allowed_in_switch(
                    self->dctx,
                    self->allocator,
                    pattern->span
                );
                return;
            }

            case .EnumUnit(ident) => {
                const name = ident.str.as_str_const();

                if (inst_enum_decl->lookup_variant(name).is_none()) {
                    diags::report_no_such_enum_variant(
                        self->dctx,
                        self->allocator,
                        pattern->span,
                        enum_name,
                        name
                    );
                }

                if (!str_set_insert(covered_variants, ident.str)) {
                    diags::report_duplicate_enum_variant_in_switch_patterns(
                        self->dctx,
                        self->allocator,
                        pattern->span,
                        name
                    );
                }
            }

            case .EnumTupleVariant { ident, items } => {
                const name = ident.str.as_str_const();

                switch (inst_enum_decl->lookup_variant(name)) case .Some(var variant) else {
                    diags::report_no_such_enum_variant(
                        self->dctx,
                        self->allocator,
                        pattern->span,
                        enum_name,
                        name
                    );
                    return;
                }

                if (!str_set_insert(covered_variants, ident.str)) {
                    diags::report_duplicate_enum_variant_in_switch_patterns(
                        self->dctx,
                        self->allocator,
                        pattern->span,
                        name
                    );
                }

                switch (*variant) {
                    case .Tuple { fields, .. } => {
                        if (fields.len() != items.len()) {
                            diags::report_enum_variant_arg_count_mismatch(
                                self->dctx,
                                self->allocator,
                                pattern->span,
                                name,
                                @cast(uint32, fields.len()),
                                @cast(uint32, items.len())
                            );
                            return;
                        }

                        *exporting_pattern_count = *exporting_pattern_count + 1;

                        for (var i: usize = 0; i < items.len(); i += 1) {
                            const item = items.get_const(i).unwrap();
                            const field = fields.get_const(i).unwrap();
                            self->analyze_pattern_recursively(item, &field->ty);
                        }
                    }

                    case .Valued { value, .. } => {
                        *exporting_pattern_count = *exporting_pattern_count + 1;

                        if (items.len() != 1) {
                            diags::report_valued_enum_variant_can_only_export_one_field(
                                self->dctx,
                                self->allocator,
                                pattern->span,
                                name
                            );
                            return;
                        }

                        const item = items.get_const(0).unwrap();

                        switch (self->analyze_expr(value, .None)) {
                            case .Some(expr_type) => self->analyze_pattern_recursively(item, &expr_type);
                            case .None => {}
                        }
                    }

                    else => {
                        diags::report_enum_variant_kind_mismatch_in_switch_pattern(
                            self->dctx,
                            self->allocator,
                            pattern->span
                        );
                    }
                }
            }

            case .EnumStructVariant { ident, items, ignore } => {
                const name = ident.str.as_str_const();
                
                switch (inst_enum_decl->lookup_variant(name)) case .Some(var variant) else {
                    diags::report_no_such_enum_variant(
                        self->dctx,
                        self->allocator,
                        pattern->span,
                        enum_name,
                        name
                    );
                    return;
                }

                *exporting_pattern_count = *exporting_pattern_count + 1;

                if (!str_set_insert(covered_variants, ident.str)) {
                    diags::report_duplicate_enum_variant_in_switch_patterns(
                        self->dctx,
                        self->allocator,
                        pattern->span,
                        name
                    );
                }

                switch (*variant) {
                    case .Struct { fields, .. } => {
                        var error = false;

                        if (!ignore && fields.len() != items.len()) {
                            diags::report_enum_variant_arg_count_mismatch(
                                self->dctx,
                                self->allocator,
                                pattern->span,
                                name,
                                @cast(uint32, fields.len()),
                                @cast(uint32, items.len())
                            );
                            return;
                        }

                        for (var i: usize = 0; i < items.len(); i += 1) {
                            const item = items.get_const(i).unwrap();
                            
                            var exists = false;

                            for (var j: usize = 0; j < fields.len(); j += 1) {
                                const field = fields.get_const(j).unwrap();

                                if (field->name.str.as_str_const() == item->name.str.as_str_const()) {
                                    exists = true;
                                    break;
                                }
                            }

                            if (!exists) {
                                diags::report_unknown_field_in_enum_struct_pattern(
                                    self->dctx,
                                    self->allocator,
                                    pattern->span,
                                    item->name.str.as_str_const()
                                );
                                error = true;
                            }
                        }

                        if (!error) {
                            for (var i: usize = 0; i < items.len(); i += 1) {
                                const item = items.get_const(i).unwrap();
                                var found_field = false;

                                for (var j: usize = 0; j < fields.len(); j += 1) {
                                    const field = fields.get_const(j).unwrap();

                                    if (field->name.str.as_str_const() == item->name.str.as_str_const()) {
                                        self->analyze_pattern_recursively(&item->pattern, &field->ty);
                                        found_field = true;
                                        break;
                                    }
                                }

                                if (!found_field) {
                                    diags::report_unknown_field_in_enum_struct_pattern(
                                        self->dctx,
                                        self->allocator,
                                        item->name.span,
                                        item->name.str.as_str_const()
                                    );
                                }
                            }
                        }
                    }

                    else => {
                        diags::report_enum_variant_kind_mismatch_in_switch_pattern(
                            self->dctx,
                            self->allocator,
                            pattern->span
                        );
                    }
                }
            }

            else => {
                diags::report_only_variant_pattern_is_allowed_in_switch(
                    self->dctx,
                    self->allocator,
                    pattern->span
                );
            }
        }
    }

    fn analyze_pattern_recursively(
        self: Self*,
        pattern: const cir::TypedSwitchCasePattern*,
        ty: const cir::SemaType*
    ) {
        switch (pattern->kind) {
            case .Wildcard => {}

            case .Binding { var_decl_id, .. } => {
                switch (self->decl_tables->vars.get(var_decl_id)) case .Some(entry) else {
                    return;
                }
                entry->ty = .Some(*ty);
            }

            case .EnumUnit(ident) => {
                self->analyze_nested_enum_pattern(pattern, ty, ident);
            }

            case .EnumTupleVariant { ident, .. } => {
                self->analyze_nested_enum_pattern(pattern, ty, ident);
            }

            case .EnumStructVariant { ident, .. } => {
                self->analyze_nested_enum_pattern(pattern, ty, ident);
            }

            else => {
                diags::report_only_variant_pattern_is_allowed_in_switch(
                    self->dctx,
                    self->allocator,
                    pattern->span
                );
            }
        }
    }

    fn analyze_nested_enum_pattern(
        self: Self*,
        pattern: const cir::TypedSwitchCasePattern*,
        ty: const cir::SemaType*,
        ident: ast::ASTIdent
    ) {
        const expanded = self->expand_sema_type(*ty, pattern->span);

        switch (expanded.as_named_type()) case .Some(named) else {
            diags::report_only_variant_pattern_is_allowed_in_switch(
                self->dctx,
                self->allocator,
                pattern->span
            );
            return;
        }

        switch (named.type_decl_id.as_enum()) case .Some(enum_decl_id) else {
            diags::report_only_variant_pattern_is_allowed_in_switch(
                self->dctx,
                self->allocator,
                pattern->span
            );
            return;
        }

        const enum_decl = self->decl_tables->enums.get(enum_decl_id).unwrap();
        var inst_enum_decl = instantiate_enum_decl_with_type_args(self->allocator, enum_decl, &named.type_args);
        var enum_name = format::format_enum_decl(self->allocator, self->registry, self->decl_tables, &inst_enum_decl);
        defer enum_name.free();

        const name = ident.str.as_str_const();

        switch (inst_enum_decl.lookup_variant(name)) case .Some(var variant) else {
            diags::report_no_such_enum_variant(
                self->dctx,
                self->allocator,
                pattern->span,
                enum_name.as_str_const(),
                name
            );
            return;
        }

        switch (pattern->kind) {
            case .EnumUnit(_) => {}

            case .EnumTupleVariant { items, .. } => {
                switch (*variant) {
                    case .Tuple { fields, .. } => {
                        if (fields.len() != items.len()) {
                            diags::report_enum_variant_arg_count_mismatch(
                                self->dctx,
                                self->allocator,
                                pattern->span,
                                name,
                                @cast(uint32, fields.len()),
                                @cast(uint32, items.len())
                            );
                            return;
                        }

                        for (var i: usize = 0; i < items.len(); i += 1) {
                            const item = items.get_const(i).unwrap();
                            const field = fields.get_const(i).unwrap();
                            self->analyze_pattern_recursively(item, &field->ty);
                        }
                    }

                    case .Valued { value, .. } => {
                        if (items.len() != 1) {
                            diags::report_valued_enum_variant_can_only_export_one_field(
                                self->dctx,
                                self->allocator,
                                pattern->span,
                                name
                            );
                            return;
                        }

                        const item = items.get_const(0).unwrap();

                        switch (self->analyze_expr(value, .None)) {
                            case .Some(expr_type) => self->analyze_pattern_recursively(item, &expr_type);
                            case .None => {}
                        }
                    }

                    else => {
                        diags::report_enum_variant_kind_mismatch_in_switch_pattern(
                            self->dctx,
                            self->allocator,
                            pattern->span
                        );
                    }
                }
            }

            case .EnumStructVariant { items, ignore, .. } => {
                switch (*variant) {
                    case .Struct { fields, .. } => {
                        if (!ignore && fields.len() != items.len()) {
                            diags::report_enum_variant_arg_count_mismatch(
                                self->dctx,
                                self->allocator,
                                pattern->span,
                                name,
                                @cast(uint32, fields.len()),
                                @cast(uint32, items.len())
                            );
                            return;
                        }

                        var error = false;

                        for (var i: usize = 0; i < items.len(); i += 1) {
                            const item = items.get_const(i).unwrap();
                            var exists = false;

                            for (var j: usize = 0; j < fields.len(); j += 1) {
                                const field = fields.get_const(j).unwrap();

                                if (field->name.str.as_str_const() == item->name.str.as_str_const()) {
                                    exists = true;
                                    break;
                                }
                            }

                            if (!exists) {
                                diags::report_unknown_field_in_enum_struct_pattern(
                                    self->dctx,
                                    self->allocator,
                                    pattern->span,
                                    item->name.str.as_str_const()
                                );
                                error = true;
                            }
                        }

                        if (!error) {
                            for (var i: usize = 0; i < items.len(); i += 1) {
                                const item = items.get_const(i).unwrap();

                                for (var j: usize = 0; j < fields.len(); j += 1) {
                                    const field = fields.get_const(j).unwrap();

                                    if (field->name.str.as_str_const() == item->name.str.as_str_const()) {
                                        self->analyze_pattern_recursively(&item->pattern, &field->ty);
                                        break;
                                    }
                                }
                            }
                        }
                    }

                    else => {
                        diags::report_enum_variant_kind_mismatch_in_switch_pattern(
                            self->dctx,
                            self->allocator,
                            pattern->span
                        );
                    }
                }
            }

            else => {
                diags::report_only_variant_pattern_is_allowed_in_switch(
                    self->dctx,
                    self->allocator,
                    pattern->span
                );
            }
        }

    }

    pub fn analyze_export_tuple_values(self: Self*, export_tuple: cir::TypedTupleExportStmt*) {
        switch (export_tuple->rhs) case .Some(rhs_val) else {
            diags::report_tuple_destruction_with_no_rhs(self->dctx, self->allocator, export_tuple->span);
            return;
        }

        const expected_type = self->build_expected_tuple_type_from_pattern(&export_tuple->pattern);

        var rhs = rhs_val;
        const rhs_type_opt = self->analyze_expr(&rhs, expected_type);
        export_tuple->rhs = .Some(rhs);

        if (rhs_type_opt.is_none()) {
            return;
        }

        switch (rhs.ty) {
            case .None => return;
            case .Some(ty_val) => {
                var tuple_type_opt = ty_val.as_tuple_type();

                switch (tuple_type_opt) case .Some(tuple_type) else {
                    diags::report_tuple_member_access_on_non_tuple_operand(
                        self->dctx,
                        self->allocator,
                        export_tuple->span
                    );
                    return;
                }

                switch (export_tuple->pattern.kind) {
                    case .Tuple(patterns) => {
                        if (patterns.len() != tuple_type.elements.len()) {
                            diags::report_tuple_exported_values_and_tuple_elements_count_mismatch(
                                self->dctx,
                                self->allocator,
                                export_tuple->span,
                                tuple_type.elements.len(),
                                patterns.len()
                            );
                            return;
                        }

                        var path: Vec<usize> = Vec.new(self->allocator);
                        defer path.free();

                        for (var i: usize = 0; i < patterns.len(); i += 1) {
                            const sub_pattern = patterns.get_const(i).unwrap();
                            const element = tuple_type.elements.get_const(i).unwrap();

                            path.push(i);
                            self->analyze_tuple_pattern(
                                sub_pattern,
                                &element->ty,
                                &rhs,
                                export_tuple->is_const,
                                export_tuple->span,
                                &path
                            );
                            path.pop();
                        }

                    }
                    else => {}
                }
            }
        }
    }

    fn analyze_tuple_ident_pattern(
        self: Self*,
        var_decl_id: cir::VarDeclId,
        sema_type: const cir::SemaType*,
        rhs: const cir::TypedExpr*,
        is_const: bool
    ) {
        const var_decl = self->decl_tables->vars.get(var_decl_id);

        switch (var_decl) {
            case .Some(entry) => {
                entry->ty = .Some(*sema_type);
                entry->rhs = .Some(*rhs);
                entry->is_const = is_const;
            }
            case .None => {}
        }
    }

    fn analyze_tuple_pattern(
        self: Self*,
        pattern: const cir::TypedTupleExportPattern*,
        sema_type: const cir::SemaType*,
        root_expr: const cir::TypedExpr*,
        stmt_is_const: bool,
        loc: Span,
        path: Vec<usize>*
    ) {
        switch (pattern->ty) {
            case .Some(explicit_type) => {
                if (!self->is_assignable_to(*sema_type, explicit_type, loc)) {
                    var lhs_str = format::format_sema_type(self->allocator, self->decl_tables, &explicit_type);
                    var rhs_str = format::format_sema_type(self->allocator, self->decl_tables, sema_type);

                    diags::report_assignment_type_mismatch(
                        self->dctx,
                        self->allocator,
                        loc,
                        lhs_str.as_str_const(),
                        rhs_str.as_str_const()
                    );

                    lhs_str.free();
                    rhs_str.free();
                    return;
                }
            }
            case .None => {}
        }

        switch (pattern->kind) {
            case .Ident(var_decl_id) => {
                const access_expr = tuple_access_expr(self->allocator, root_expr, path, loc);

                var is_const_opt: Option<bool> = .None;
                switch (pattern->mutability) {
                    case .Some(.Const) => is_const_opt = .Some(true);
                    case .Some(.Var) => is_const_opt = .Some(false);
                    case .None => {}
                }

                if (is_const_opt.is_some()) {
                    const is_const = is_const_opt.unwrap();

                    if (is_const == stmt_is_const) {
                        var mutability_str = "var";

                        if (is_const) {
                            mutability_str = "const";
                        }
                        
                        diags::report_invalid_nested_export_tuple(
                            self->dctx,
                            self->allocator,
                            loc,
                            mutability_str
                        );
                    }
                }

                const final_is_const = is_const_opt.unwrap_or(stmt_is_const);
                self->analyze_tuple_ident_pattern(var_decl_id, sema_type, &access_expr, final_is_const);
            }

            case .Tuple(patterns) => {
                var tuple_type_opt = sema_type->as_tuple_type();

                switch (tuple_type_opt) case .Some(tuple_type) else {
                    diags::report_tuple_member_access_on_non_tuple_operand(
                        self->dctx,
                        self->allocator,
                        loc
                    );
                    return;
                }

                if (patterns.len() != tuple_type.elements.len()) {
                    diags::report_tuple_exported_values_and_tuple_elements_count_mismatch(
                        self->dctx,
                        self->allocator,
                        loc,
                        tuple_type.elements.len(),
                        patterns.len()
                    );
                    return;
                }

                for (var i: usize = 0; i < patterns.len(); i += 1) {
                    const sub_pattern = patterns.get_const(i).unwrap();
                    const element = tuple_type.elements.get_const(i).unwrap();

                    path->push(i);
                    self->analyze_tuple_pattern(sub_pattern, &element->ty, root_expr, stmt_is_const, loc, path);
                    path->pop();
                }
            }

            case .Ignore => {}
        }
    }

    fn build_expected_tuple_type_from_pattern(self: Self*, pattern: const cir::TypedTupleExportPattern*) Option<cir::SemaType> {
        switch (pattern->kind) {
            case .Tuple(elements) => {
                var result_type: Vec<cir::TypedTupleElement> = Vec.new(self->allocator);
                defer result_type.free();
        var has_explicit_type = false;

        for (var i: usize = 0; i < elements.len(); i += 1) {
            const element = elements.get_const(i).unwrap();

            switch (element->ty) {
                case .Some(ty) => {
                    result_type.push(cir::TypedTupleElement { ty, span: element->span });
                    has_explicit_type = true;
                }
                case .None => {
                    switch (element->kind) {
                        case .Tuple => {
                            switch (self->build_expected_tuple_type_from_pattern(element)) {
                                case .Some(inner) => {
                                    result_type.push(cir::TypedTupleElement { ty: inner, span: element->span });
                                    has_explicit_type = true;
                                }
                                case .None => {
                                    switch (self->func_env.infer) {
                                        case .Some(infer_ctx) => {
                                            result_type.push(cir::TypedTupleElement {
                                                ty: infer_ctx->new_var(),
                                                span: element->span,
                                            });
                                        }
                                        case .None => {
                                            return .None;
                                        }
                                    }
                                }
                            }
                        }
                        else => {
                            switch (self->func_env.infer) {
                                case .Some(infer_ctx) => {
                                    result_type.push(cir::TypedTupleElement {
                                        ty: infer_ctx->new_var(),
                                        span: element->span,
                                    });
                                }
                                case .None => {
                                    return .None;
                                }
                            }
                        }
                    }
                }
            }
        }

                if (!has_explicit_type) {
                    return .None;
                }

                return .Some(.Tuple(cir::TypedTupleType {
                    elements: result_type,
                    span: pattern->span,
                }));
            }
            else => { return .None; }
        }
    }

    pub fn analyze_inline_asm_stmt(self: Self*, asm: cir::TypedInlineAsm*) {
        self->validate_asm_template(asm);
        self->validate_asm_outputs(asm);
        self->validate_asm_inputs(asm);
        self->validate_asm_clobbers(asm);
        self->validate_asm_template_indices(asm);
        self->validate_asm_constraint_types(asm);
    }

}

fn is_const_qualified_type_assigned_to_non_const_variable(
    ty: const cir::SemaType*,
    is_variable_const: bool
) bool {
    return !is_variable_const && ty->is_const();
}

// FIXME: Move to cir/index.cyrus
fn clone_func_params_list(
    allocator: Allocator,
    src: const cir::TypedFuncParams*
) cir::TypedFuncParams {
    var list: Vec<cir::TypedFuncParamKind> = Vec.new(allocator);

    for (var i: usize = 0; i < src->list.len(); i += 1) {
        list.push(*src->list.get_const(i).unwrap());
    }

    return cir::TypedFuncParams {
        variadic: src->variadic,
        list,
    };
}

// FIXME: Move to cir/index.cyrus
fn method_decls_of_named_type(
    decl_tables: DeclTables*,
    named_type: const cir::NamedType*
) Option<const cir::MethodDecls*> {
    switch (named_type->type_decl_id) {
        case .Struct(id) => {
            const decl = decl_tables->structs.get_const(id).unwrap();
            return .Some(&decl->methods);
        }
        case .Enum(id) => {
            const decl = decl_tables->enums.get_const(id).unwrap();
            return .Some(&decl->methods);
        }
        case .Union(id) => {
            const decl = decl_tables->unions.get_const(id).unwrap();
            return .Some(&decl->methods);
        }
        case .Interface | .Typedef => return .None;
    }
}

// FIXME: Move to cir/index.cyrus
fn implement_interfaces_of_named_type(
    decl_tables: DeclTables*,
    named_type: const cir::NamedType*
) Option<const Vec<cir::TypedImplementInterface>*> {
    switch (named_type->type_decl_id) {
        case .Struct(id) => {
            const decl = decl_tables->structs.get_const(id).unwrap();
            return .Some(&decl->impls);
        }
        case .Enum(id) => {
            const decl = decl_tables->enums.get_const(id).unwrap();
            return .Some(&decl->impls);
        }
        case .Union(id) => {
            const decl = decl_tables->unions.get_const(id).unwrap();
            return .Some(&decl->impls);
        }
        case .Interface | .Typedef => return .None;
    }
}

fn is_plain_type_assignable_to(value_type: cir::PlainType, target_type: cir::PlainType) bool {
    if (value_type == target_type) {
        return true;
    }

    if (value_type.is_integer() && target_type.is_integer()) {
        const signedness = (value_type.is_signed() && target_type.is_signed())
            || (!value_type.is_signed() && !target_type.is_signed());

        const rank1 = cir::PlainType.plain_type_rank(&value_type);
        const rank2 = cir::PlainType.plain_type_rank(&target_type);

        switch (rank1) {
            case .Some(r1) => {
                switch (rank2) {
                    case .Some(r2) => return r1 <= r2 && signedness;
                    case .None => return false;
                }
            }
            case .None => return false;
        }
    }

    if (value_type.is_float() && target_type.is_float()) {
        const rank1 = cir::PlainType.plain_type_rank(&value_type);
        const rank2 = cir::PlainType.plain_type_rank(&target_type);

        switch (rank1) {
            case .Some(r1) => {
                switch (rank2) {
                    case .Some(r2) => return r1 <= r2;
                    case .None => return false;
                }
            }
            case .None => return false;
        }
    }

    switch (value_type) {
        case .Bool => {
            switch (target_type) {
                case .Int8 | .UInt8 => return true;
                else => {}
            }
        }
        case .Int8 | .UInt8 => {
            switch (target_type) {
                case .Bool => return true;
                else => {}
            }
        }
        else => {}
    }

    return false;
}

/// Strips leading and trailing `{` and `}` from an asm constraint.
fn asm_trim_constraint(allocator: Allocator, constraint: const uint8*) String {
    var len: usize = 0;

    while (constraint[len] != 0) {
        len += 1;
    }

    var start: usize = 0;
    var end: usize = len;

    while (start < len && (constraint[start] == '{' || constraint[start] == '}')) {
        start += 1;
    }

    while (end > start && (constraint[end - 1] == '{' || constraint[end - 1] == '}')) {
        end -= 1;
    }

    var result = String.new(allocator);

    for (var i: usize = start; i < end; i += 1) {
        result.push(constraint[i]);
    }
    
    return result;
}

fn asm_is_integer_bool_or_pointer(ty: const cir::SemaType*) bool {
    switch (*ty) {
        case .Const(inner) => return asm_is_integer_bool_or_pointer(inner);
        case .Plain(p) => return p.is_integer_or_bool();
        case .Pointer => return true;
        else => return false;
    }
}

fn switch_ranges_valid(existing: const Vec<usize>*, new_ranges: const Vec<usize>*) bool {
    var i: usize = 0;
    while (i + 1 < new_ranges->len()) {
        const new_start = *new_ranges->get_const(i).unwrap();
        const new_end = *new_ranges->get_const(i + 1).unwrap();

        if (new_start > new_end) {
            return false;
        }

        var j: usize = 0;

        while (j + 1 < existing->len()) {
            const old_start = *existing->get_const(j).unwrap();
            const old_end = *existing->get_const(j + 1).unwrap();

            if (new_start <= old_end && old_start <= new_end) {
                return false;
            }

            j += 2;
        }

        i += 2;
    }

    return true;
}

fn tuple_access_expr(
    allocator: Allocator,
    base_expr: const cir::TypedExpr*,
    access_path: const Vec<usize>*, 
    loc: Span
) cir::TypedExpr {
    var expr: cir::TypedExpr = *base_expr;
    var current_type = expr.ty;

    var done = false;
    
    for (var i: usize = 0; i < access_path->len() && !done; i += 1) {
        const index = *access_path->get_const(i).unwrap();

        var element_type: cir::SemaType;

        switch (current_type) {
            case .Some(ty) => {
                switch (ty.as_tuple_type()) {
                    case .Some(tuple_type) => {
                        if (index < tuple_type.elements.len()) {
                            const element = tuple_type.elements.get_const(index).unwrap();
                            element_type = element->ty;
                        } else {
                            done = true;
                        }
                    }
                    case .None => done = true;
                }
            }
            case .None => done = true;
        }

        if (done) {
            break;
        }

        expr = cir::TypedExpr {
            kind: .TupleAccess(cir::TypedTupleAccessExpr {
                operand: alloc_init(allocator, expr),
                index,
                span: loc,
            }),
            ty: .Some(element_type),
            analyzed: false,
            val_cat: expr.val_cat,
            span: loc,
        };

        current_type = .Some(element_type);
    }

    return expr;
}

fn analyze_symbol_expr(
    registry: const GlobalSymbolRegistry*,
    symbol_expr: cir::TypedSymbolExpr*
) Option<cir::DeclId> {
    switch (symbol_expr->as_decl_id()) {
        case .Some(decl_id) => return .Some(decl_id);
        else => {}
    }

    const symbol_id = symbol_expr->as_symbol_id();

    switch (symbol_id) {
        case .Some(id) => {
            const decl_id = registry->lookup_symbol_as_decl_id(id);

            switch (decl_id) {
                case .Some(resolved) => {
                    symbol_expr->to_resolved_decl_id(resolved);
                    return .Some(resolved);
                }
                else => {}
            }
        }
        else => {}
    }

    return .None;
}

/* ************* Helpers ************* */

fn pointer_arithmetic_type(
    lhs_type: const cir::SemaType*,
    rhs_type: const cir::SemaType*,
    is_addition: bool
) Option<cir::SemaType> {
    if (lhs_type->is_pointer() && rhs_type->is_integer()) {
        return .Some(*lhs_type);
    } else if (lhs_type->is_integer() && rhs_type->is_pointer()) {
        return .Some(*rhs_type);
    } else if (lhs_type->is_pointer() && rhs_type->is_pointer() && !is_addition) {
        return .Some(.Plain(.ISize));
    } else {
        return .None;
    }
}

fn null_coalesce_type(lhs_type: cir::SemaType, rhs_type: cir::SemaType) Option<cir::SemaType> {
    if (lhs_type.is_plain_null()) {
        switch (rhs_type) {
            case .Pointer(inner) => return .Some(.Pointer(inner));
            case .Plain(.Null) => return .Some(lhs_type);
            else => {}
        }
    } else if (lhs_type.is_pointer()) {
        switch (rhs_type) {
            case .Pointer(inner_rhs) => {
                switch (lhs_type) {
                    case .Pointer(inner_lhs) => {
                        if (cir_types_eq(inner_lhs, inner_rhs)) {
                            return .Some(lhs_type);
                        }
                    }
                    else => {}
                }
            }
            case .Plain(.Null) => {
                return .Some(lhs_type);
            }
            else => {}
        }
    }

    return .None;
}

// FIXME: Move to cir/index.cyrus
fn func_params_as_type_params(
    allocator: Allocator,
    params: const cir::TypedFuncParams*
) cir::TypedFuncTypeParams {
    var list: Vec<cir::SemaType> = Vec.new(allocator);

    for (var i: usize = 0; i < params->list.len(); i += 1) {
        const param_kind = params->list.get_const(i).unwrap();

        switch (*param_kind) {
            case .FuncParam(func_param) => list.push(func_param.ty);
            case .SelfModifier(self_modifier) => list.push(self_modifier.ty);
        }
    }

    var variadic: Option<cir::TypedFuncTypeVariadicParam*> = .None;

    switch (params->variadic) {
        case .Some(.UntypedCStyle) => {
            variadic = .Some(alloc_init(
                allocator,
                cir::TypedFuncTypeVariadicParam.UntypedCStyle
            ));
        }
        case .Some(.Typed { ty, .. }) => {
            variadic = .Some(alloc_init(
                allocator,
                cir::TypedFuncTypeVariadicParam.Typed(ty)
            ));
        }
        else => {}
    }

    return cir::TypedFuncTypeParams { list, variadic };
}

// FIXME: Remove this helper method
fn str_set_contains(values: const Vec<String>*, name: const uint8*) bool {
    for (var i: usize = 0; i < values->len(); i += 1) {
        const value = values->get_const(i).unwrap();

        if (value->as_str_const() == name) {
            return true;
        }
    }

    return false;
}

// FIXME: Remove this helper method
fn str_set_insert(values: Vec<String>*, name: String) bool {
    if (str_set_contains(values, name.as_str_const())) {
        return false;
    }

    values->push(name);
    return true;
}

[[inline]]
fn decl_id_as_type_decl_id(decl_id: cir::DeclId) Option<cir::TypeDeclId> {
    switch (decl_id) {
        case .Interface(id) => return .Some(.Interface(id));
        case .Typedef(id) => return .Some(.Typedef(id));
        case .Struct(id) => return .Some(.Struct(id));
        case .Union(id) => return .Some(.Union(id));
        case .Enum(id) => return .Some(.Enum(id));
        else => return .None;
    }
}

fn analyze_symbol_expr_readonly(
    registry: const GlobalSymbolRegistry*,
    symbol_expr: const cir::TypedSymbolExpr*
) Option<cir::DeclId> {
    switch (symbol_expr->as_symbol_id()) {
        case .Some(symbol_id) => {
            switch (registry->lookup_symbol_as_decl_id(symbol_id)) {
                case .Some(decl_id) => return .Some(decl_id);
                else => {}
            }
        }
        else => {}
    }

    return symbol_expr->as_decl_id();
}


fn integer_suffix_to_sema_type(suffix: IntegerSuffix) Option<cir::SemaType> {
    switch (suffix) {
        case .ISize => return .Some(.Plain(.ISize));
        case .USize => return .Some(.Plain(.USize));
        case .Int8 => return .Some(.Plain(.Int8));
        case .Int16 => return .Some(.Plain(.Int16));
        case .Int32 => return .Some(.Plain(.Int32));
        case .Int64 => return .Some(.Plain(.Int64));
        case .Int128 => return .Some(.Plain(.Int128));
        case .UInt8 => return .Some(.Plain(.UInt8));
        case .UInt16 => return .Some(.Plain(.UInt16));
        case .UInt32 => return .Some(.Plain(.UInt32));
        case .UInt64 => return .Some(.Plain(.UInt64));
        case .UInt128 => return .Some(.Plain(.UInt128));
    }
}

fn float_suffix_to_sema_type(suffix: FloatSuffix) Option<cir::SemaType> {
    switch (suffix) {
        case .Float16 => return .Some(.Plain(.Float16));
        case .Float32 => return .Some(.Plain(.Float32));
        case .Float64 => return .Some(.Plain(.Float64));
        case .Float128 => return .Some(.Plain(.Float128));
    }
}
