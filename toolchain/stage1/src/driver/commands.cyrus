static var command_exit_code: int32 = 0;

/* ************* Commands ************* */

pub fn command_new(action: cli::ActionContext) {
    const allocator: Allocator = dynamic LibcAllocator.new();

    switch (action.args->get_str(0)) case .Some(project_path) else {
        compile_error("please provide a project name");
        command_exit_code = 1;
        return;
    }

    var kind = ProjectKind.Executable;

    if (is_library_flag_enabled(action.opts)) {
        kind = ProjectKind.Library;
    }

    command_exit_code = create_project(allocator, project_path, kind);
}

pub fn command_run(action: cli::ActionContext) {
    command_exit_code = build_or_run(action, true);
}

pub fn command_build(action: cli::ActionContext) {
    command_exit_code = build_or_run(action, false);
}

pub fn command_dump(action: cli::ActionContext) {
    action.print_help();
}

pub fn command_dump_lexer(action: cli::ActionContext) {
    const allocator: Allocator = dynamic LibcAllocator.new();

    switch (file_path_from_action_context(action)) case .Value(var file_path) else {
        command_exit_code = 1;
        return;
    }
    defer file_path.free();

    var context = CompilerContext.new(allocator);
    defer context.free();

    const lexical = LexicalContext.new(&context);
    const path = Path.new(allocator, file_path.as_str_const());

    switch (lexical.tokenize_source(path)) case .Value(var source_tokens) else {
        command_exit_code = 1;
        return;
    }
    defer source_tokens.free();

    dump_tokens(&source_tokens.tokens);
    command_exit_code = 0;
}

pub fn command_dump_parser(action: cli::ActionContext) {
    const allocator: Allocator = dynamic LibcAllocator.new();

    switch (file_path_from_action_context(action)) case .Value(var file_path) else {
        command_exit_code = 1;
        return;
    }
    defer file_path.free();

    var context = CompilerContext.new(allocator);
    defer context.free();

    const lexical = LexicalContext.new(&context);
    const path = Path.new(allocator, file_path.as_str_const());

    switch (lexical.tokenize_source(path)) case .Value(var source_tokens) else {
        command_exit_code = 1;
        return;
    }
    defer source_tokens.free();

    switch (lexical.parse_source(source_tokens)) case .Value(var program) else {
        command_exit_code = 1;
        return;
    }
    defer program.free();

    lexical.dump_ast(program);
    command_exit_code = 0;
}

pub fn command_dump_resolver(action: cli::ActionContext) {
    const allocator: Allocator = dynamic LibcAllocator.new();

    switch (file_path_from_action_context(action)) case .Value(var file_path) else {
        command_exit_code = 1;
        return;
    }
    defer file_path.free();

    switch (resolver_opts_from_action_context(action)) case .Value(var opts) else {
        command_exit_code = 1;
        return;
    }
    defer opts.free();

    var context = CompilerContext.new(allocator);
    defer context.free();

    const analysis_context = AnalysisContext.new(&context, &opts);
    defer analysis_context.free();

    command_exit_code = analysis_context.dump_resolver(
        file_path.as_str_const()
    );
}

pub fn command_dump_analyzer(action: cli::ActionContext) {
    const allocator: Allocator = dynamic LibcAllocator.new();

    switch (file_path_from_action_context(action)) case .Value(var file_path) else {
        command_exit_code = 1;
        return;
    }
    defer file_path.free();

    switch (resolver_opts_from_action_context(action)) case .Value(var opts) else {
        command_exit_code = 1;
        return;
    }
    defer opts.free();

    var context = CompilerContext.new(allocator);
    defer context.free();

    const analysis_context = AnalysisContext.new(&context, &opts);
    defer analysis_context.free();

    command_exit_code = analysis_context.dump_cir_from_source(file_path.as_str_const());
}

pub fn command_dump_bir(action: cli::ActionContext) {
    const allocator: Allocator = dynamic LibcAllocator.new();

    if (module_merge_mode_unsupported(action.opts)) {
        compile_error("unsupported module merge mode (expected `separate`)");
        command_exit_code = 1;
        return;
    }

    switch (backend_from_action(action)) case .Some(var backend) else {
        compile_error("unknown backend (expected `c` or `llvm`)");
        command_exit_code = 1;
        return;
    }

    switch (target_from_action(action)) case .Some(var target) else {
        compile_error("unsupported target triple");
        command_exit_code = 1;
        return;
    }

    const config = CompilerConfig {
        enable_timing: action.opts->enabled("time"),
    };

    var timings = CompilerTimings.new();
    var timings_ptr: CompilerTimings*;

    if (config.enable_timing) {
        timings_ptr = &timings;
        timings.total.start();
    }

    var codegen = CodegenContext.new(allocator, backend, target);
    const writer: Writer = dynamic StdoutWriter.new();

    switch (output_option(action)) {
        case .Some(var out_path) => {
            defer out_path.free();

            var file_content = String.new(allocator);
            defer file_content.free();

            var ok = false;

            {
                const file_writer: Writer = dynamic StringWriter.new(&file_content);
                
                const status = emit_backend_ir(
                    allocator, 
                    action, 
                    &codegen, 
                    file_writer, 
                    timings_ptr
                );
                
                ok = status == 0;
            }

            if (ok && !write_file(
                allocator, 
                out_path.as_str_const(), 
                file_content.as_str_const()
            )) {
                compile_error("failed to write IR output file");
                command_exit_code = 1;
                return;
            }

            if (ok) {
                command_exit_code = 0;
            } else {
                command_exit_code = 1;
            }
        }
        case .None => {
            command_exit_code = emit_backend_ir(
                allocator, 
                action, 
                &codegen, 
                writer, 
                timings_ptr
            );
        }
    }
}

pub fn command_version(action: cli::ActionContext) {
    printf("Cyrus %s\n", version::COMPILER_VERSION);
}

/* ************* Helpers ************* */

fn build_or_run(action: cli::ActionContext, execute: bool) int32 {
    const allocator: Allocator = dynamic LibcAllocator.new();

    switch (action.args->get_str(0)) {
        case .Some(file_or_dir) => {
            if (os::is_dir(file_or_dir)) {
                var manifest = join_path(allocator, file_or_dir, "build.cyrus");
                defer manifest.free();

                if (!os::is_file(manifest.as_str_const())) {
                    compile_error("project directory does not contain `build.cyrus`");
                    return 1;
                }

                return build_or_run_project(
                    allocator,
                    action,
                    execute,
                    file_or_dir,
                    manifest.as_str_const()
                );
            }

            if (!os::is_file(file_or_dir)) {
                compile_error("input must be a file or project directory");
                return 1;
            }

            if (ends_with_build_cyrus(file_or_dir)) {
                var proj_root = dir_of_file(allocator, file_or_dir);
                defer proj_root.free();

                var root_str: const uint8* = ".";

                if (!proj_root.is_empty()) {
                    root_str = proj_root.as_str_const();
                }

                return build_or_run_project(
                    allocator,
                    action,
                    execute,
                    root_str,
                    file_or_dir
                );
            }

            return build_or_run_single_file(
                allocator, 
                action, 
                execute, 
                file_or_dir
            );
        }
        case .None => {
            if (os::is_file("build.cyrus")) {
                return build_or_run_project(
                    allocator, 
                    action, 
                    execute, 
                    ".", 
                    "build.cyrus"
                );
            }

            compile_error("please provide an input file");
            return 1;
        }
    }
}

fn build_or_run_single_file(
    allocator: Allocator,
    action: cli::ActionContext,
    execute: bool,
    file_path: const uint8*
) int32 {
    if (execute) {
        switch (dir::TempDir.create(allocator)) case .Some(temp_dir) else {
            compile_error("failed to create a temporary directory");
            return 1;
        }
        defer temp_dir.free();

        var output_path = join_path(allocator, temp_dir.path(), "a.out");
        defer output_path.free();
        defer dir::remove_file(output_path.as_str_const());

        var arena = ArenaAllocator.new(allocator, 65000);
        defer arena.destroy();

        const status = compile_file(dynamic arena, action, &output_path);
        
        if (status != 0) {
            return status;
        }

        return run_compiled_binary(
            allocator, 
            output_path.as_str_const(), 
            action.extra_args
        );
    }

    var output_path = resolve_output_path(
        allocator, 
        action, 
        file_path, 
        ""
    );
    defer output_path.free();

    return compile_file(allocator, action, &output_path);
}

fn emit_backend_ir(
    allocator: Allocator,
    action: cli::ActionContext,
    codegen: CodegenContext*,
    writer: Writer,
    timings: CompilerTimings*
) int32 {
    switch (action.args->get_str(0)) case .Some(file_path) else {
        compile_error("please provide an input file");
        return 1;
    }

    switch (resolver_opts_from_action_context(action)) case .Value(var opts) else {
        return 1;
    }
    defer opts.free();

    return emit_backend_ir_with_opts(
        allocator,
        file_path,
        &opts,
        codegen,
        writer,
        timings
    );
}

fn compile_file(
    allocator: Allocator,
    action: cli::ActionContext,
    output_path: const String*
) int32 {
    switch (file_path_from_action_context(action)) case .Value(var file_path) else {
        return 1;
    }
    defer file_path.free();

    return compile_source_with_options(
        allocator,
        action,
        file_path.as_str_const(),
        output_path,
        .None,
        null,
        null,
        null,
        null,
        null,
        .None,
        null
    );
}

fn write_file(
    allocator: Allocator,
    path: const uint8*,
    content: const uint8*
) bool {
    const file_path = Path.new(allocator, path);
    defer file_path.free();

    switch (os::File.open(
        &file_path, 
        .Write
    )) case .Value(var file) else {
        return false;
    }

    const result = file.write(content);
    file.close();

    switch (result) {
        case .Value(_) => return true;
        case .Error(_) => return false;
    }
}

fn resolve_output_path(
    allocator: Allocator,
    action: cli::ActionContext,
    file_path: const uint8*,
    extension: const uint8*
) String {
    switch (output_option(action)) {
        case .Some(var path) => return path;
        else => {}
    }

    var stem = std::path::file_stem(allocator, file_path);
    defer stem.free();

    var parent_dir = dir_of_file(allocator, file_path);
    defer parent_dir.free();

    var joined = join_path(
        allocator, 
        parent_dir.as_str_const(), 
        stem.as_str_const()
    );

    var ext = String.from_str(allocator, extension);
    defer ext.free();

    if (ext.is_empty()) {
        return joined;
    }

    var out = String.new(allocator);
    out.push_str(joined.as_str_const());
    out.push_str(ext.as_str_const());
    joined.free();

    return out;
}

fn is_library_flag_enabled(opts: cli::Opts*) bool {
    switch (opts->find("lib")) {
        case .Some(opt) => {
            if (!opt->enabled) {
                return false;
            }

            if (opt->values.len() == 0) {
                return true;
            }

            switch (opt->values.get_const(opt->values.len() - 1)) {
                case .Some(value) => {
                    switch (*value) {
                        case .Bool(flag) => return flag;
                        else => return true;
                    }
                }
                case .None => return true;
            }
        }
        case .None => return false;
    }
}

fn file_path_from_action_context(action: cli::ActionContext) 
    ErrorOr<String, ()> 
{
    switch (action.args->get_str(0)) case .Some(file_path) else {
        compile_error("please provide an input file");
        return .Error(());
    }

    if (!os::is_file(file_path)) {
        compile_error("input must be a file");
        return .Error(());
    }

    return .Value(String.from_str(action.allocator, file_path));
}

fn resolver_opts_from_action_context(action: cli::ActionContext) 
    ErrorOr<ResolverOptions, ()> 
{
    const allocator: Allocator = dynamic LibcAllocator.new();

    switch (file_path_from_action_context(action)) case .Value(var file_path) else {
        return .Error(());
    }
    defer file_path.free();

    var opts = ResolverOptions.new(allocator);

    opts.base_path.free();
    opts.base_path = dir::cwd(allocator);

    opts.source_dirs.push(dir_of_file(
        allocator, 
        file_path.as_str_const()
    ));

    apply_stdlib_option(allocator, action.opts, &opts);

    if (!apply_profile_option(action.opts, &opts)) {
        opts.free();
        return .Error(());
    }

    if (action.cmd->name == "test") {
        opts.profile = .Test;
    }

    switch (target_from_action(action)) {
        case .Some(target) => {
            opts.target = target;
        }
        case .None => {
            compile_error("unsupported target triple");
            opts.free();
            return .Error(());
        }
    }

    apply_cli_features(
        allocator, 
        action.opts, 
        &opts.features
    );

    return .Value(opts);
}

pub fn exit_code() int32 {
    return command_exit_code;
}
