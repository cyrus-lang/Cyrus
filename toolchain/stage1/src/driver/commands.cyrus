static var command_exit_code: int32 = 0;

/* ************* Commands ************* */

pub fn command_new(action: cli::ActionContext) {
    @todo();
}

pub fn command_run(action: cli::ActionContext) {
    command_exit_code = build_or_run(action, true);
}

pub fn command_build(action: cli::ActionContext) {
    command_exit_code = build_or_run(action, false);
}

pub fn command_dump(action: cli::ActionContext) {
    action.print_help();
}

pub fn command_dump_lexer(action: cli::ActionContext) {
    const allocator: Allocator = dynamic LibcAllocator.new();

    switch (file_path_from_action_context(action)) case .Value(var file_path) else {
        command_exit_code = 1;
        return;
    }
    defer file_path.free();

    var context = CompilerContext.new(allocator);
    defer context.free();
    
    const lexical = LexicalContext.new(&context);

    const path = Path.new(allocator, file_path.as_str_const());

    switch (lexical.tokenize_source(path)) case .Value(var source_tokens) else {
        command_exit_code = 1;
        return;
    }
    defer source_tokens.free();

    dump_tokens(&source_tokens.tokens);

    command_exit_code = 0;
}

pub fn command_dump_parser(action: cli::ActionContext) {
    const allocator: Allocator = dynamic LibcAllocator.new();

    switch (file_path_from_action_context(action)) case .Value(var file_path) else {
        command_exit_code = 1;
        return;
    }
    defer file_path.free();

    var context = CompilerContext.new(allocator);
    defer context.free();
    
    const lexical = LexicalContext.new(&context);

    const path = Path.new(allocator, file_path.as_str_const());

    switch (lexical.tokenize_source(path)) case .Value(var source_tokens) else {
        command_exit_code = 1;
        return;
    }
    defer source_tokens.free();

    switch (lexical.parse_source(source_tokens)) case .Value(var program) else {
        command_exit_code = 1;
        return;
    }
    defer program.free();

    lexical.dump_ast(program);

    command_exit_code = 0;
}

pub fn command_dump_resolver(action: cli::ActionContext) {
    const allocator: Allocator = dynamic LibcAllocator.new();

    switch (file_path_from_action_context(action)) case .Value(var file_path) else {
        command_exit_code = 1;
        return;
    }
    defer file_path.free();

    switch (resolver_opts_from_action_context(action)) case .Value(var opts) else {
        command_exit_code = 1;
        return;
    }
    defer opts.free();
    
    var context = CompilerContext.new(allocator);
    defer context.free();
    
    const analysis_context = AnalysisContext.new(&context, &opts);
    defer analysis_context.free();

    command_exit_code = analysis_context.dump_resolver(
        file_path.as_str_const()
    );
}

pub fn command_dump_analyzer(action: cli::ActionContext) {
    const allocator: Allocator = dynamic LibcAllocator.new();

    switch (file_path_from_action_context(action)) case .Value(var file_path) else {
        command_exit_code = 1;
        return;
    }
    defer file_path.free();

    switch (resolver_opts_from_action_context(action)) case .Value(var opts) else {
        command_exit_code = 1;
        return;
    }
    defer opts.free();
    
    var context = CompilerContext.new(allocator);
    defer context.free();
    
    const analysis_context = AnalysisContext.new(&context, &opts);
    defer analysis_context.free();

    command_exit_code = analysis_context.dump_cir_from_source(
        file_path.as_str_const()
    );
}

pub fn command_dump_bir(action: cli::ActionContext) {
    const allocator: Allocator = dynamic LibcAllocator.new();

    switch (backend_from_action(action)) case .Some(var backend) else {
        compile_error("unknown backend (expected `c` or `llvm`)");
        command_exit_code = 1;
        return;
    }

    var codegen = CodegenContext.new(allocator, backend);

    switch (output_option(action)) {
        case .Some(var output_path) => {
            defer output_path.free();

            var out = String.new(allocator);
            defer out.free();

            {
                const writer: Writer = dynamic StringWriter.new(&out);
                command_exit_code = emit_backend_ir(allocator, action, &codegen, writer);

                if (command_exit_code != 0) {
                    return;
                }
            }

            if (!write_file(allocator, output_path.as_str_const(), out.as_str_const())) {
                compile_error("failed to write the backend IR to the output file");
                command_exit_code = 1;
            }
        }
        case .None => {
            const writer: Writer = dynamic StdoutWriter.new();

            command_exit_code = emit_backend_ir(allocator, action, &codegen, writer);
        }
    }
}

pub fn command_version(action: cli::ActionContext) {
    printf("Cyrus %s\n", version::COMPILER_VERSION);
}

/* ************* Compiler ************* */

fn build_or_run(action: cli::ActionContext, execute: bool) int32 {
    const allocator: Allocator = dynamic LibcAllocator.new();

    switch (action.args->get_str(0)) case .Some(file_path) else {
        compile_error("please provide an input file");
        return 1;
    }

    if (!os::is_file(file_path)) {
        compile_error("input must be a file");
        return 1;
    }

    if (execute) {
        switch (dir::TempDir.create(allocator)) case .Some(temp_dir) else {
            compile_error("failed to create a temporary directory");
            return 1;
        }
        defer temp_dir.free();

        var output_path = std::path::join_path(
            allocator,
            temp_dir.path(),
            "a.out"
        );

        defer output_path.free();
        defer dir::remove_file(output_path.as_str_const());
        
        var arena = ArenaAllocator.new(allocator, 65000);
        defer arena.destroy();

        const status = compile_file(dynamic arena, action, &output_path);

        if (status != 0) {
            return status;
        }

        var command = process::Command.new(
            allocator,
            output_path.as_str_const()
        );
        defer command.free();

        const exit_status = command.exec();

        const child_status = @cast(uint32, exit_status);
        return @cast(int32, (child_status >> 8) & 0xff);
    }

    var output_path = resolve_output_path(allocator, action, file_path, "");
    defer output_path.free();

    return compile_file(allocator, action, &output_path);
}

/// Runs the front end (parse, resolve, analyze) over the command's input
/// file and emits the selected backend's IR through `writer`.
///
/// Returns 0 on success, or a non-zero exit code when the front end fails.
fn emit_backend_ir(
    allocator: Allocator,
    action: cli::ActionContext,
    codegen: CodegenContext*,
    writer: Writer
) int32 {
    // Driver-owned arena for the analyzer's temporary allocations
    // (normalized/cloned SemaTypes are never freed individually).
    // Its `defer` is registered before all other defers below so it is
    // destroyed last, after codegen and after the resolver freed the
    // trees that may point into it.
    var mem = ArenaAllocator.new(allocator, 65536);
    defer mem.destroy();

    switch (action.args->get_str(0)) case .Some(file_path) else {
        compile_error("please provide an input file");
        return 1;
    }

    var context = CompilerContext.new(allocator);
    defer context.free();
    
    const lexical = LexicalContext.new(&context);

    switch (resolver_opts_from_action_context(action)) case .Value(var opts) else {
        return 1;
    }
    defer opts.free();

    var resolver = Resolver.new(allocator, &lexical, &opts);
    defer resolver.free();

    const path = Path.new(allocator, file_path);

    switch (lexical.tokenize_source(path)) case .Value(var source_tokens) else {
        return 1;
    }
    defer source_tokens.free();

    switch (lexical.parse_source(source_tokens)) case .Value(var program) else {
        return 1;
    }
    defer program.free();

    resolver.resolve_entry(
        source_tokens.source_id, 
        file_path, 
        &program
    );

    if (context.dctx.has_errors()) {
        context.render_diags();
        return 1;
    }

    var analyzer_context = AnalyzerContext.new(
        dynamic mem,
        &context.dctx,
        &resolver.global_symbols,
        &resolver.decl_tables,
        resolver.program_trees
    );
    defer analyzer_context.free();

    trigger_analyzer(&analyzer_context);

    if (context.dctx.has_errors()) {
        context.render_diags();
        return 1;
    }

    codegen->emit(&context, &resolver, &analyzer_context, writer);
    return 0;
}

fn output_option(action: cli::ActionContext) Option<String> {
    switch (action.opts->find("output")) {
        case .Some(opt) => {
            switch (opt->values.get(0)) {
                case .Some(value) => {
                    switch (*value) {
                        case .Str(str) => return .Some(str.clone(action.allocator));
                        else => {}
                    }
                }
                else => {}
            }
        }
        else => {}
    }

    return .None;
}

/// Writes `content` to `path`, 
/// replacing the file if it already exists.
fn write_file(
    allocator: Allocator,
    path: const uint8*,
    content: const uint8*
) bool {
    const file_path = Path.new(allocator, path);

    switch (os::File.open(&file_path, .Write)) case .Value(var file) else {
        return false;
    }

    const result = file.write(content);
    file.close();

    switch (result) {
        case .Value(_) => return true;
        case .Error(_) => return false;
    }
}

fn resolve_output_path(
    allocator: Allocator,
    action: cli::ActionContext,
    file_path: const uint8*,
    extension: const uint8*
) String {
    switch (output_option(action)) {
        case .Some(var path) => return path;
        else => {}
    }

    var stem = std::path::file_stem(allocator, file_path);
    defer stem.free();

    var parent_dir = dir_of_file(allocator, file_path);
    defer parent_dir.free();

    var joined = std::path::join_path(
        allocator,
        parent_dir.as_str_const(),
        stem.as_str_const()
    );

    var ext = String.from_str(allocator, extension);
    defer ext.free();

    if (ext.is_empty()) {
        return joined;
    }

    var out = String.new(allocator);
    out.push_str(joined.as_str_const());
    out.push_str(ext.as_str_const());
    joined.free();

    return out;
}

fn backend_from_action(action: cli::ActionContext) Option<Backend> {
    const allocator = action.allocator;

    var name = String.from_str(allocator, "c");
    defer name.free();

    switch (action.opts->find("backend")) {
        case .Some(opt) => {
            switch (opt->values.get(0)) {
                case .Some(value) => {
                    switch (*value) {
                        case .Str(str) => {
                            name.free();
                            name = str.clone(allocator);
                        }
                        else => {}
                    }
                }
                else => {}
            }
        }
        else => {}
    }

    return Backend.from_str(name.as_str_const());
}

// Joins every value of a repeatable option (`-z`, `-L`, `-l`) into
// `dest` as a newline separated list, matching `tcc::compile`s inputs.
fn collect_opt_values(opts: cli::Opts*, name: const uint8*, dest: String*) void {
    switch (opts->find(name)) case .Some(opt) else {
        return;
    }

    for (var i: usize = 0; i < opt->values.len(); i += 1) {
        switch (opt->values.get(i)) {
            case .Some(value) => {
                switch (*value) {
                    case .Str(str) => {
                        if (!dest->is_empty()) {
                            dest->push('\n');
                        }
                        dest->push_str(str.as_str_const());
                    }
                    else => {}
                }
            }
            else => {}
        }
    }
}

fn module_merge_mode_unsupported(opts: cli::Opts*) bool {
    switch (opts->find("module-merge-mode")) case .Some(opt) else {
        return false;
    }

    switch (opt->values.get(0)) case .Some(value) else {
        return false;
    }

    switch (*value) case .Str(str) else {
        return false;
    }

    return str.as_str_const() != "separate";
}

fn compile_file(
    allocator: Allocator,
    action: cli::ActionContext,
    output_path: const String*
) int32 {
    if (module_merge_mode_unsupported(action.opts)) {
        compile_error("unsupported module merge mode (expected `separate`)");
        return 1;
    }

    switch (backend_from_action(action)) case .Some(var backend) else {
        compile_error("unknown backend (expected `c` or `llvm`)");
        return 1;
    }

    var codegen = CodegenContext.new(allocator, backend);

    var out = String.new(allocator);
    defer out.free();

    {
        const writer: Writer = dynamic StringWriter.new(&out);
        const status = emit_backend_ir(allocator, action, &codegen, writer);

        if (status != 0) {
            return status;
        }
    }

    var extra_files = String.new(allocator);
    defer extra_files.free();

    var lib_paths = String.new(allocator);
    defer lib_paths.free();

    var libraries = String.new(allocator);
    defer libraries.free();

    collect_opt_values(action.opts, "z", &extra_files);
    collect_opt_values(action.opts, "L", &lib_paths);
    collect_opt_values(action.opts, "l", &libraries);

    if (!codegen.build(
        out.as_str_const(),
        output_path->as_str_const(),
        extra_files.as_str_const(),
        lib_paths.as_str_const(),
        libraries.as_str_const()
    )) {
        compile_error("tcc failed to compile the input file");
        return 1;
    }

    return 0;
}

fn file_path_from_action_context(action: cli::ActionContext) ErrorOr<String, ()> {
    switch (action.args->get_str(0)) case .Some(file_path) else {
        compile_error("please provide an input file");
        return .Error(());
    }

    if (!os::is_file(file_path)) {
        compile_error("input must be a file");
        return .Error(());
    }

    return .Value(String.from_str(action.allocator, file_path));
}

fn resolver_opts_from_action_context(action: cli::ActionContext) ErrorOr<ResolverOptions, ()> {
    const allocator: Allocator = dynamic LibcAllocator.new();

    switch (file_path_from_action_context(action)) case .Value(var file_path) else {
        return .Error(());
    }
    defer file_path.free();
    
    var opts = ResolverOptions.new(allocator);

    opts.base_path.free();
    opts.base_path = dir::cwd(allocator);
    opts.source_dirs.push(dir_of_file(allocator, file_path.as_str_const()));

    apply_stdlib_option(allocator, action.opts, &opts);

    if (!apply_profile_option(action.opts, &opts)) {
        opts.free();
        return .Error(());
    }   

    return .Value(opts);
}

/* ************* Options Helpers ************* */

fn apply_stdlib_option(
    allocator: Allocator,
    ctx_opts: const cli::Opts*,
    opts: ResolverOptions*
) {
    switch (ctx_opts->find("stdlib")) case .Some(opt) else {
        return;
    }

    switch (opt->values.get(0)) case .Some(value) else {
        return;
    }

    switch (*value) case .Str(value_str) else {
        return;
    }

    var stdlib = value_str.clone(allocator);

    switch (opts->stdlib_path) {
        case .Some(var prev) => {
            prev.free();
        }
        else => {}
    }

    opts->stdlib_path = .Some(stdlib);
}

fn apply_profile_option(
    ctx_opts: const cli::Opts*,
    opts: ResolverOptions*
) bool {
    switch (ctx_opts->find("profile")) case .Some(opt) else {
        return true;
    }

    switch (opt->values.get(0)) case .Some(value) else {
        return true;
    }

    switch (*value) case .Str(value_str) else {
        return true;
    }

    if (value_str.as_str_const() == "release") {
        opts->profile = .Release;
        return true;
    }

    if (value_str.as_str_const() == "debug") {
        opts->profile = .Debug;
        return true;
    }

    compile_error("invalid profile (expected `debug` or `release`)");
    return false;
}

pub fn exit_code() int32 {
    return command_exit_code;
}