import std::io{Writer, FileWriter};
import std::mem{Allocator};
import std::option{Option};
import std::libc{getenv};
import std::path{Path};
import std::os{File};

import sema::context{AnalyzerContext};
import .::index{CompilerContext};
import resolver::index{Resolver};
import codegen::c{CodegenC};
import .::tcc;

pub enum Backend {
    LLVM
    C,

    pub fn from_str(name: const uint8*) Option<Self> {
        switch (name) {
            case "llvm" => return .Some(.LLVM);
            case "c" => return .Some(.C);
            else => return .None;
        }
    }
}

pub struct CodegenContext {
    pub allocator: Allocator,
    pub backend: Backend,

    pub fn new(allocator: Allocator, backend: Backend) Self {
        return Self { allocator, backend };
    }

    pub fn emit(
        self: Self*,
        context: const CompilerContext*,
        resolver: Resolver*,
        analyzer: AnalyzerContext*,
        writer: Writer
    ) {
        switch (self->backend) {
            case .C => {
                var codegen = CodegenC.new(
                    self->allocator,
                    &resolver->decl_tables,
                    &resolver->global_symbols,
                    &resolver->program_trees,
                    &analyzer->vtable_registry,
                    &analyzer->monomorph_registry,
                    &context->sctx
                );
                codegen.emit(writer);
                codegen.free();
            }
            case .LLVM => {
                @todo();
            }
        }
    }

    /// Compiles emitted `source` into `output_path`.
    pub fn build(
        self: Self*,
        source: const uint8*,
        output_path: const uint8*,
        extra_files: const uint8*,
        lib_paths: const uint8*,
        libraries: const uint8*
    ) bool {
        switch (self->backend) {
            case .C => {
                self->write_debug_source(source);

                return tcc::compile(
                    source,
                    output_path,
                    tcc::OutputKind.EXE,
                    extra_files,
                    lib_paths,
                    libraries
                );
            }
            case .LLVM => {
                @todo();
            }
        }

        return false;
    }

    fn write_debug_source(self: Self*, source: const uint8*) {
        const emit_path = getenv("CYRUS_EMIT_C");

        if (emit_path == null) {
            return;
        }

        const path = Path.new(self->allocator, emit_path);

        switch (File.open(&path, .Write)) case .Value(var file) else {
            return;
        }
        defer file.close();

        var writer: Writer = dynamic FileWriter.new(&file);
        writer.write_all(source);
    }
}
