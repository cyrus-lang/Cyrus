import std::io{Writer, FileWriter};
import std::collections{Vec};
import std::string{String};
import std::mem{Allocator};
import std::option{Option};
import std::path{Path};
import std::os{File};
import std::os::env;

import sema::context{AnalyzerContext};
import .::index{CompilerContext};
import resolver::index{Resolver};
import linker{Linker, OptLevel};
import abi::target{TargetInfo};
import codegen::c{CodegenC};
import .::tcc;

pub enum Backend {
    LLVM,
    C,

    pub fn from_str(name: const uint8*) Option<Self> {
        switch (name) {
            case "llvm" => return .Some(.LLVM);
            case "c" => return .Some(.C);
            else => return .None;
        }
    }
}

pub struct CodegenContext {
    pub allocator: Allocator,
    pub backend: Backend,
    pub target: TargetInfo,
    pub linker_program: const uint8*,
    pub opt_level: OptLevel,
    pub debug_info: bool,
    pub lto: bool,
    pub strip: bool,
    pub extra_linker_args: const Vec<String>*,

    pub fn new(
        allocator: Allocator, 
        backend: Backend, 
        target: TargetInfo
    ) Self {
        return Self { 
            allocator, 
            backend, 
            target,
            linker_program: "tcc",
            opt_level: .O0,
            debug_info: false,
            lto: false,
            strip: false,
            extra_linker_args: null,
        };
    }

    pub fn set_linker_options(
        self: Self*,
        linker_program: const uint8*,
        opt_level: OptLevel,
        debug_info: bool,
        lto: bool,
        strip: bool,
        extra_linker_args: const Vec<String>*
    ) {
        self->linker_program = linker_program;
        self->opt_level = opt_level;
        self->debug_info = debug_info;
        self->lto = lto;
        self->strip = strip;
        self->extra_linker_args = extra_linker_args;
    }

    pub fn emit(
        self: Self*,
        context: const CompilerContext*,
        resolver: Resolver*,
        analyzer: AnalyzerContext*,
        writer: Writer
    ) {
        switch (self->backend) {
            case .C => {
                var codegen = CodegenC.new(
                    self->allocator,
                    &resolver->decl_tables,
                    &resolver->global_symbols,
                    &resolver->program_trees,
                    &analyzer->vtable_registry,
                    &analyzer->monomorph_registry,
                    &context->sctx,
                    self->target,
                    resolver->opts->profile == .Test
                );
                codegen.emit(writer);
                codegen.free();
            }
            case .LLVM => {
                @todo();
            }
        }
    }

    pub fn build(
        self: Self*,
        source: const uint8*,
        output_path: const uint8*,
        extra_files: const uint8*,
        lib_paths: const uint8*,
        libraries: const uint8*
    ) bool {
        switch (self->backend) {
            case .C => {
                self->write_debug_source(source);

                if (self->linker_program == "tcc") {
                    return tcc::compile(
                        source,
                        output_path,
                        tcc::OutputKind.EXE,
                        extra_files,
                        lib_paths,
                        libraries
                    );
                }

                var linker = Linker.new(
                    self->allocator,
                    self->linker_program,
                    self->opt_level,
                    self->debug_info
                );
                defer linker.free();

                linker.set_flags(self->lto, self->strip, self->extra_linker_args);

                return linker.compile_c_and_link(
                    source,
                    output_path,
                    extra_files,
                    lib_paths,
                    libraries
                );
            }
            case .LLVM => {
                @todo();
            }
        }

        return false;
    }

    fn write_debug_source(self: Self*, source: const uint8*) {
        switch (env::get("CYRUS_EMIT_C")) case .Some(emit_path) else {
            return;
        }

        const path = Path.new(self->allocator, emit_path);
        defer path.free();

        switch (File.open(&path, .Write)) case .Value(var file) else {
            return;
        }
        defer file.close();

        var writer: Writer = dynamic FileWriter.new(&file);
        writer.write_all(source);
    }
}
