import std::mem::arena{ArenaAllocator};
import std::mem{Allocator};
import std::errors{ErrorOr};
import std::path{Path};
import std::os{File};

import .::index{CompilerContext};
import parser::ast{ASTProgram};
import diags{compile_error};
import tokens{SourceTokens};
import source{Source};
import parser{Parser};
import lexer{Lexer};

const TOKENS_ARENA_SIZE: usize = 65536;

pub struct LexicalContext {
    pub context: CompilerContext*,

    pub fn new(context: CompilerContext*) Self {
        return Self { context };
    }

    /// Driver handler responsible for tokenizing source content.
    pub fn tokenize_source(self: const Self*, path: Path) ErrorOr<SourceTokens, ()> {
        const allocator = self->context->allocator;

        switch (File.open(&path, .Read)) case .Value(file) else {
            compile_error("failed to open the file");
            return .Error(());
        }
        defer file.close();

        switch (file.read(allocator)) case .Value(content) else {
            compile_error("failed to open the file");
            return .Error(());
        }

        const source = Source.new(allocator, path, content);
        const source_id = self->context->sctx.add(source);

        const arena = ArenaAllocator.new(allocator, TOKENS_ARENA_SIZE);
        
        const lexer = Lexer.new(
            allocator, 
            arena, 
            &content, 
            source_id, 
            &self->context->dctx
        );

        const source_tokens = SourceTokens.new(
            source_id, 
            lexer.tokenize(),
            arena
        );

        self->context->render_diags();

        if (!self->context->dctx.has_errors()) {
            return .Value(source_tokens);
        } else {
            source_tokens.free();
            return .Error(());
        }
    }

    /// Driver handler responsible for parsing source tokens.
    pub fn parse_source(
        self: const Self*, 
        source_tokens: SourceTokens
    ) ErrorOr<ASTProgram, ()> {
        const allocator = self->context->allocator;

        const result = Parser.parse(
            allocator, 
            source_tokens, 
            &self->context->dctx
        );
        
        self->context->render_diags();
        return result;
    }
}
