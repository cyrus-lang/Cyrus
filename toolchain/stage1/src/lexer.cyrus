import std::mem::arena{ArenaAllocator};
import std::mem{Allocator, alloc_init};
import std::libc::types{c_char};
import std::collections{Vec};
import std::option{Option};
import std::string{
    parse_str_as_uint128,
    parse_str_as_float64,
    parse_str_as_int128,
    String
};
import std::libc{
    printf,
    strtol,
    strlen
};

import diags{DiagContext, Diag};
import source{SourceId};
import escape{
    escape_sequence_to_char,
    is_valid_escape,
    unescape_string,
};
import tokens{
    IntegerSuffix,
    StringPrefix,
    FloatSuffix,
    TokenKind,
    Literal,
    Token,
    Span,
    Loc,
};

pub struct Lexer {
    allocator: Allocator,
    arena: ArenaAllocator,
    input: const String*,
    buf: const uint8*,
    input_len: usize,
    source_id: SourceId,
    dctx: DiagContext*,
    pos: usize,
    line: usize,
    col: usize,

    cached_kinds: TokenKind*[32],
    
    pub fn new(
        allocator: Allocator, 
        arena: ArenaAllocator, 
        input: const String*,
        source_id: SourceId,
        dctx: DiagContext*
    ) Self {
        @assert(input, "input cannot be null");

        var lexer: Self;
        lexer.allocator = allocator;
        lexer.arena = arena;
        lexer.input = input;
        lexer.buf = input->as_str_const();
        lexer.input_len = input->len();
        lexer.source_id = source_id;
        lexer.dctx = dctx;
        lexer.pos = 0;
        lexer.line = 1;
        lexer.col = 1;

        for (var i: usize = 0; i < 32; i += 1) {
            lexer.cached_kinds[i] = null;
        }

        return lexer;
    }

    pub fn tokenize(self: Self*) Vec<Token> {
        var tokens: Vec<Token> = Vec.with_capacity(
            self->allocator, 
            (self->input_len / 4) + 16
        );

        var token: Token = undefined;

        while (true) {
            token = self->next();
            tokens.push(token);

            switch (*token.kind) {
                case .EOF | .INVALID => break;
                else => {}
            }
        }

        return tokens;
    }

    [[inline]]
    fn next(self: Self*) Token {
        self->skip_ws();
        self->skip_comments();

        if (self->pos >= self->input_len) {
            return Token.new(
                self->init_cached_kind(31, .EOF),
                Loc.new(self->pos, self->pos)
            );
        }

        const start_pos = self->pos;
        const kind = self->read_kind();
        const end_pos = self->pos;

        return Token.new(kind, Loc.new(start_pos, end_pos));
    }

    [[inline]]
    fn read_kind(self: Self*) TokenKind* {
        if (self->pos >= self->input_len) {
            return self->init_cached_kind(31, .EOF);
        }

        const char = self->buf[self->pos];

        switch (char) {
            case 'a'..='z' | 'A'..='Z' | '_' => return self->read_ident_or_prefix_or_keyword();
            case '0'..='9' => return self->read_integer_literal();
            case '"' => return self->read_string_literal(.None);
            case '\'' => return self->read_char_literal();

            case '(' => return self->read_single_cached(0, .LeftParen);
            case ')' => return self->read_single_cached(1, .RightParen);
            case '{' => return self->read_single_cached(2, .LeftBrace);
            case '}' => return self->read_single_cached(3, .RightBrace);
            case '[' => return self->read_single_cached(4, .LeftBracket);
            case ']' => return self->read_single_cached(5, .RightBracket);
            case ';' => return self->read_single_cached(6, .Semicolon);
            case ',' => return self->read_single_cached(7, .Comma);
            case '*' => return self->read_single_cached(8, .Asterisk);
            case '%' => return self->read_single_cached(9, .Percent);
            case '/' => return self->read_single_cached(10, .Slash);
            case '~' => return self->read_single_cached(11, .Tilde);
            case '^' => return self->read_single_cached(12, .Caret);
            case '@' => return self->read_single_cached(13, .At);

            case '>' => return self->read_greater();
            case '-' => return self->read_minus();
            case ':' => return self->read_colon();
            case '=' => return self->read_equal();
            case '!' => return self->read_bang();
            case '<' => return self->read_less();
            case '+' => return self->read_plus();
            case '|' => return self->read_pipe();
            case '&' => return self->read_amp();
            case '.' => return self->read_dot();

            case '\0' => return self->init_cached_kind(31, .EOF);

            else => {
                self->dctx->report(Diag.new(
                    self->allocator, 
                    .Error, 
                    "invalid character", 
                    Span.new(self->source_id, self->loc())
                ));
                return self->init_kind(.INVALID);
            }
        }
    }

    /// Advances lexer by consuming a character
    /// and updates line and column.
    [[inline]]
    fn read(self: Self*) {
        if (self->pos >= self->input_len) {
            return;
        }

        if (self->buf[self->pos] == '\n') {
            self->line += 1;
            self->col = 1;
        } else {
            self->col += 1;
        }

        self->pos += 1; // consume
    }

    [[inline]]
    fn read_ident_or_prefix_or_keyword(self: Self*) TokenKind* {
        if (self->cur() == 'b' && self->peek() == '"') {
            self->read();
            return self->read_string_literal(.Some(.Byte));
        }

        return self->read_ident_or_keyword();
    }

    [[inline]]
    fn read_ident_or_keyword(self: Self*) TokenKind* {
        const (start_pos, len, hash) = self->scan_ident();
        const ptr = self->buf + start_pos;

        if (len == 1 && ptr[0] == '_') {
            return self->init_kind(.Underscore);
        }

        switch (TokenKind.lookup_keyword_hashed(ptr, len, hash)) {
            case .Some(token_kind) => {
                return self->init_kind(token_kind);
            }
            else => {}
        }

        var str = String.from_bytes(self->allocator, ptr, len);
        return self->init_ident(str);
    }

    [[inline]]
    fn scan_ident(self: Self*) (usize, usize, uint64) {
        const buf = self->buf;
        const input_len = self->input_len;
        const start_pos = self->pos;

        var hash: uint64 = 5381;

        while (self->pos < input_len && is_alphanumeric(buf[self->pos])) {
            hash = hash ^ (hash << 5) ^ @cast(uint64, buf[self->pos]);
            self->pos += 1;
            self->col += 1;
        }

        return (start_pos, self->pos - start_pos, hash);
    }

    [[inline]]
    fn read_string_literal(self: Self*, suffix: Option<StringPrefix>) TokenKind* {
        const loc = self->loc();

        self->read();

        var value = String.new(self->allocator);

        while (true) {
            if (self->is_eof()) {
                self->dctx->report(Diag.new(
                    self->allocator, 
                    .Error, 
                    "unterminated string literal", 
                    Span.new(self->source_id, loc)
                ));
                value.free();
                return self->init_kind(.INVALID);
            }

            const char = self->cur();

            if (char == '\\') {
                value.push(char);
                self->read();
                if (!self->is_eof()) {
                    value.push(self->cur());
                    self->read();
                }
                continue;
            }

            if (char == '"') {
                self->read();
                break;
            }

            value.push(char);
            self->read();
        }

        switch (unescape_string(self->allocator, &value)) {
            case .Some(unescaped) => {
                value.free();
                return self->init_string_literal(unescaped, suffix);
            }
            case .None => {
                value.free();
                self->dctx->report(Diag.new(
                    self->allocator,
                    .Error,
                    "Invalid escape sequence.",
                    Span.new(self->source_id, loc)
                ));
                return self->init_kind(.INVALID);
            }
        }
    }

    [[inline]]
    fn read_char_literal(self: Self*) TokenKind* {
        const loc = self->loc();
        self->read();

        var char: uint8;

        // Escaping Sequence Char
        if (self->cur() == '\\') {
            self->read();

            // HEX
            if (self->cur() == 'x') {
                switch (self->read_char_hex(loc)) {
                    case .Some(x) => char = x;
                    case .None => return self->init_kind(.INVALID);
                }
            }
            // UNICODE
            else if (self->cur() == 'u') {
                switch (self->read_char_unicode(loc)) {
                    case .Some(x) => char = x;
                    case .None => return self->init_kind(.INVALID);
                }
            }
            // OCTAL
            else if (is_digit(self->cur())) {
                switch (self->read_char_octal(loc)) {
                    case .Some(x) => char = x;
                    case .None => return self->init_kind(.INVALID);
                }
            }  
            // Standard ASCII
            else {
                if (self->is_eof()) {
                    self->dctx->report(Diag.new(
                        self->allocator,
                        .Error,
                        "unterminated character literal",
                        Span.new(self->source_id, loc)
                    ));
                    return self->init_kind(.INVALID);
                }
                
                if (!is_valid_escape(self->cur())) {
                   self->dctx->report(Diag.new(
                        self->allocator,
                        .Error,
                        "invalid escape character",
                        Span.new(self->source_id, loc)
                    ));
                    return self->init_kind(.INVALID);
                }
                
                char = escape_sequence_to_char(self->cur());
                self->read();
            }
        } 
        // Normal Char
        else {
            if (self->is_eof()) {
                const span = Span.new(self->source_id, loc);
                self->dctx->report(
                    Diag.new(self->allocator, .Error, "unterminated character literal", span)
                );
                return self->init_kind(.INVALID);
            }
            
            // REVIEW Add len_utf8 safety check
            char = self->cur();
            self->read();
        }

        if (self->is_eof() || self->cur() != '\'') {
            self->dctx->report(Diag.new(
                self->allocator,
                .Error,
                "unterminated character literal",
                Span.new(self->source_id, loc)
            ));
            return self->init_kind(.INVALID);
        }

        self->read();
        return self->init_kind(.Literal(.Char(char)));
    }

    fn read_char_unicode(self: Self*, loc: Loc) Option<uint8> {
        self->read();

        var buf: uint8[5];
        var i: usize = 0;

        while (i < 4 && !self->is_eof() && self->cur() != '\'') {
            buf[i] = self->cur();
            self->read();
            i += 1;
        }

        // Must have at least one digit
        if (i == 0) {
            self->dctx->report(Diag.new(
                self->allocator,
                .Error,
                "unicode character must have at least one digit",
                Span.new(self->source_id, loc)
            ));
            return .None;
        }

        buf[i] = '\0';

        switch (try_str_as_unicode(&buf[0])) case .Some(unicode) else {
            self->dctx->report(Diag.new(
                self->allocator,
                .Error,
                "given number is not unicode",
                Span.new(self->source_id, loc)
            ));
            return .None;
        }
        
        if (unicode > 255) {
            self->dctx->report(Diag.new(
                self->allocator,
                .Error,
                "unicode character value must be in range `0x00` to `0xff` (0-255)",
                Span.new(self->source_id, loc)
            ));
            return .None;
        }

        if (self->cur() != '\'' && is_digit(self->cur())) {
            self->dctx->report(Diag.new(
                self->allocator,
                .Error,
                "unicode digits must be two",
                Span.new(self->source_id, loc)
            ));
            return .None;
        }

        return .Some(@cast(uint8, unicode));
    }

    fn read_char_hex(self: Self*, loc: Loc) Option<uint8> {
        self->read();

        var buf: uint8[4];
        var i: usize = 0;

        while (i < 2 && !self->is_eof() && self->cur() != '\'') {
            buf[i] = self->cur();
            self->read();
            i += 1;
        }

        // Must have at least one digit
        if (i == 0) {
            self->dctx->report(Diag.new(
                self->allocator,
                .Error,
                "hex character must have at least one digit",
                Span.new(self->source_id, loc)
            ));
            return .None;
        }

        buf[i] = '\0';

        switch (try_str_as_hex(&buf[0])) case .Some(hex) else {
            self->dctx->report(Diag.new(
                self->allocator,
                .Error,
                "given number is not hex",
                Span.new(self->source_id, loc)
            ));
            return .None;
        }
        
        if (hex > 255) {
            self->dctx->report(Diag.new(
                self->allocator,
                .Error,
                "hex character value must be in range `0x00` to `0xff` (0-255)",
                Span.new(self->source_id, loc)
            ));
            return .None;
        }

        if (self->cur() != '\'' && is_digit(self->cur())) {
            self->dctx->report(Diag.new(
                self->allocator,
                .Error,
                "hex digits must be two",
                Span.new(self->source_id, loc)
            ));
            return .None;
        }

        return .Some(@cast(uint8, hex));
    }

    fn read_char_octal(self: Self*, loc: Loc) Option<uint8> {
        var buf: uint8[4];
        var i: usize = 0;

        // Octal char only allows three digits
        while (i < 3 && !self->is_eof() && self->cur() != '\'') {
            buf[i] = self->cur();
            self->read();
            i += 1;
        }

        // Must have at least one digit
        if (i == 0) {
            self->dctx->report(Diag.new(
                self->allocator,
                .Error,
                "octal character must have at least one digit",
                Span.new(self->source_id, loc)
            ));
            return .None;
        }

        buf[i] = '\0';

        switch (try_str_as_octal(&buf[0])) case .Some(octal) else {
            self->dctx->report(Diag.new(
                self->allocator,
                .Error,
                "given number is not octal",
                Span.new(self->source_id, loc)
            ));
            return .None;
        }
        
        if (octal > 255) {
            self->dctx->report(Diag.new(
                self->allocator,
                .Error,
                "octal character digits must be in range 0 to 255",
                Span.new(self->source_id, loc)
            ));
            return .None;
        }

        if (self->cur() != '\'' && is_digit(self->cur())) {
            self->dctx->report(Diag.new(
                self->allocator,
                .Error,
                "octal digits must be three",
                Span.new(self->source_id, loc)
            ));
            return .None;
        }

        return .Some(@cast(uint8, octal));
    }

    fn read_decimal_integer(self: Self*) String {
        var number = String.new(self->allocator);

        // Only digit is allowed in decimal integer
        while (is_digit(self->cur()) || self->cur() == '_') {
            if (self->cur() != '_') {
                number.push(self->cur());
            }
            self->read();
        }

        return number;
    }

    fn read_hexadecimal_integer(self: Self*) String {
        var number = String.new(self->allocator);

        while (is_hex_digit(self->cur()) || self->cur() == '_') {
            if (self->cur() != '_') {
                number.push(self->cur());
            }
            self->read();
        }

        return number;
    }

    fn read_binary_integer(self: Self*) String {
        var number = String.new(self->allocator);

        // Zero/One
        while (self->cur() == '0' || self->cur() == '1' || self->cur() == '_') {
            if (self->cur() != '_') {
                number.push(self->cur());
            }
            self->read();
        }

        return number;
    }

    [[inline]]
    fn read_integer_literal(self: Self*) TokenKind* {
        var base = 10uint32;
        var is_float = false;

        var number: String = undefined;
        defer number.free();
        
        if (self->cur() == '0') {
            if (self->peek() == 'x') { // Hexadecimal
                self->read();
                self->read();
                base = 16;
                number = self->read_hexadecimal_integer();
            } else if (self->peek() == 'b') { // Binary
                self->read();
                self->read();
                base = 2;
                number = self->read_binary_integer();
            } else {
                number = self->read_decimal_integer();
            }
        } else {
            number = self->read_decimal_integer();
        }

        if (!self->is_eof()) {
            if (self->cur() == '.' && is_digit(self->peek())) {
                if (base != 10) {
                    self->dctx->report(Diag.new(
                        self->allocator,
                        .Error,
                        "non-decimal number cannot have mantissa",
                        Span.new(self->source_id, self->loc())
                    ));
                    return self->init_kind(.INVALID);
                }

                is_float = true;
                number.push(self->cur());
                self->read();

                // Mantissa
                while (!self->is_eof() && (is_digit(self->cur()) || self->cur() == '_')) {
                    if (self->cur() != '_') {
                        number.push(self->cur());
                    }
                    self->read();
                }
            }
        }

        if (self->cur() == 'e' || self->cur() == 'E') {
            is_float = true;
            number.push(self->cur());
            self->read();
            if (self->cur() == '+' || self->cur() == '-') {
                number.push(self->cur());
                self->read();
            }
            while (is_digit(self->cur())) {
                number.push(self->cur());
                self->read();
            }
        }

        if (is_float) {
            const suffix = self->read_float_suffix();

            switch (parse_str_as_float64(number.as_str_const())) case .Some(value) else {
                self->dctx->report(Diag.new(
                    self->allocator,
                    .Error,
                    "float does not fit into `float64`",
                    Span.new(self->source_id, self->loc())
                ));
                return self->init_kind(.INVALID);
            }
            
            return self->init_kind(.Literal(.Float { value, suffix: .None }));
        } else {
            const (suffix, is_unsigned) = self->read_integer_suffix();

            if (base == 16) {
                switch (try_str_as_hex(number.as_str_const())) case .Some(value) else {
                    self->dctx->report(Diag.new(
                        self->allocator,
                        .Error,
                        "hexadecimal number does not fit into `uint128`",
                        Span.new(self->source_id, self->loc())
                    ));
                    return self->init_kind(.INVALID);
                }
                
                return self->init_kind(.Literal(.Integer { value: .Unsigned(value), suffix }));
            } else if (base == 2) {
                switch (try_str_as_binary(number.as_str_const())) case .Some(value) else {
                    self->dctx->report(Diag.new(
                        self->allocator,
                        .Error,
                        "binary number does not fit into `uint128`",
                        Span.new(self->source_id, self->loc())
                    ));
                    return self->init_kind(.INVALID);
                }
                
                return self->init_kind(.Literal(.Integer { value: .Unsigned(value), suffix }));
            } else if (is_unsigned || base != 10) {
                switch (parse_str_as_uint128(number.as_str_const())) case .Some(value) else {
                    self->dctx->report(Diag.new(
                        self->allocator,
                        .Error,
                        "integer number does not fit into `u128`",
                        Span.new(self->source_id, self->loc())
                    ));
                    return self->init_kind(.INVALID);
                }
                
                return self->init_kind(.Literal(.Integer { value: .Unsigned(value), suffix }));
            } else {
                switch (parse_str_as_int128(number.as_str_const())) case .Some(value) else {
                    self->dctx->report(Diag.new(
                        self->allocator,
                        .Error,
                        "integer number does not fit into `i128`",
                        Span.new(self->source_id, self->loc())
                    ));
                    return self->init_kind(.INVALID);
                }
                
                return self->init_kind(.Literal(.Integer { value: .Signed(value), suffix }));
            }
        }
    }

    fn read_integer_suffix(self: Self*) (Option<IntegerSuffix>, bool) {
        if (self->cur() == 'i' || self->cur() == 'u') {
            const (start_pos, len, hash) = self->scan_ident();
            const ptr = self->buf + start_pos;

            switch (TokenKind.lookup_keyword_hashed(ptr, len, hash)) {
                case .Some(token_kind) => {
                    return (
                        token_kind.as_integer_suffix(), 
                        token_kind.is_unsigned_integer()
                    );
                }
                else => {}
            }
        }

        return (.None, false);
    }

    fn read_float_suffix(self: Self*) Option<FloatSuffix> {
        if (self->cur() == 'f') {
            const (start_pos, len, hash) = self->scan_ident();
            const ptr = self->buf + start_pos;

            switch (TokenKind.lookup_keyword_hashed(ptr, len, hash)) {
                case .Some(token_kind) => {
                    return token_kind.as_float_suffix();
                }
                else => {}
            }
        }

        return .None;
    }

    [[inline]]
    fn skip_ws(self: Self*) {
        while (self->pos < self->input_len) {
            const char = self->buf[self->pos];

            if (!is_ws(char)) {
                break;
            }

            if (char == '\n') {
                self->line += 1;
                self->col = 1;
            } else {
                self->col += 1;
            }
            
            self->pos += 1;
        }
    }

    fn skip_comments(self: Self*) {
        while (!self->is_eof() && 
            self->cur() == '/' && 
            (self->peek() == '/' || self->peek() == '*'))
        {
            const loc = self->loc();

            // Single Line
            if (self->peek() == '/') {
                self->read();
                self->read();
                
                while (!self->is_eof() && self->cur() != '\n') {
                    self->read();
                }
                
                if (!self->is_eof() && self->cur() == '\n') {
                    self->read();
                }
            } 
            // Multi Line
            else if (self->peek() == '*') {
                const loc = self->loc();

                self->read(); // Consume `/`
                self->read(); // Consume `*`

                var depth: usize = 1;

                while (!self->is_eof() && depth > 0) {
                    // Nested
                    if (self->cur() == '/' && self->peek() == '*') {
                        self->read();
                        self->read();
                        depth += 1;
                    }
                    // Closing 
                    else if (self->cur() == '*' && self->peek() == '/') {
                        self->read();
                        self->read();
                        depth -= 1;
                    } else {
                        self->read();
                    }
                }

                if (depth > 0) {
                    self->dctx->report(
                        Diag.new(
                            self->allocator,
                            .Error,
                            "unclosed multi-line comment",
                            Span.new(self->source_id, self->loc())
                        )
                        ->under("comment is opened here")
                        ->help("consider closing it with `*/`")
                    );
                    return;
                }

                // Skip any newlines after comment
                while (!self->is_eof() && self->cur() == '\n') {
                    self->read();
                }
            }

            self->skip_ws();
        }
    }

    [[inline]]
    fn read_plus(self: Self*) TokenKind* {
        if (self->peek() == '+') {
            self->read();
            self->read();
            return self->init_kind(.Increment);
        } else {
            self->read();
            return self->init_cached_kind(30, .Plus);
        }
    }
    
    [[inline]]
    fn read_minus(self: Self*) TokenKind* {
        if (self->peek() == '-') {
            self->read();
            self->read();
            return self->init_kind(.Decrement);
        } else if (self->peek() == '>') {
            self->read();
            self->read();
            return self->init_cached_kind(20, .ThinArrow);
        } else {
            self->read();
            return self->init_cached_kind(19, .Minus);
        }
    }

    [[inline]]
    fn read_colon(self: Self*) TokenKind* {
        self->read();

        if (self->cur() == ':') {
            self->read();
            return self->init_cached_kind(18, .DoubleColon);
        } else {
            return self->init_cached_kind(17, .Colon);
        }
    }
    
    [[inline]]
    fn read_equal(self: Self*) TokenKind* {
        self->read();

        if (self->cur() == '=') {
            self->read();
            return self->init_cached_kind(22, .Equal);
        } else if (self->cur() == '>') {
            self->read();
            return self->init_cached_kind(23, .FatArrow);
        } else {
            return self->init_cached_kind(21, .Assign);
        }
    }

    [[inline]]
    fn read_bang(self: Self*) TokenKind* {
        self->read();

        if (self->cur() == '=') {
            self->read();
            return self->init_cached_kind(25, .NotEqual);
        } else {
            return self->init_cached_kind(24, .Bang);
        }
    }

    [[inline]]
    fn read_less(self: Self*) TokenKind* {
        self->read();

        if (self->cur() == '=') {
            self->read();
            return self->init_kind(.LessEqual);
        } else if (self->cur() == '<') {
            self->read();
            return self->init_kind(.ShiftLeft);
        } else {
            return self->init_cached_kind(26, .LessThan);
        }
    }

    [[inline]]
    fn read_greater(self: Self*) TokenKind* {
        self->read();

        if (self->cur() == '=') {
            self->read();
            return self->init_kind(.GreaterEqual);
        } else {
            // Notice that '>>' ambiguity is entrusted to the parser.
            return self->init_cached_kind(27, .GreaterThan);
        }
    }
    
    [[inline]]
    fn read_amp(self: Self*) TokenKind* {
        self->read();

        if (self->cur() == '&') {
            self->read();
            return self->init_cached_kind(29, .And);
        } else if (self->cur() == '~') {
            self->read();
            return self->init_kind(.AmpTilde);
        } else {
            return self->init_cached_kind(28, .Ampersand);
        }
    }

    [[inline]]
    fn read_pipe(self: Self*) TokenKind* {
        self->read();

        if (self->cur() == '|') {
            self->read();
            return self->init_kind(.Or);
        } else {
            return self->init_kind(.Pipe);
        }
    }

    [[inline]]
    fn read_dot(self: Self*) TokenKind* {
        self->read();
        
        if (self->cur() == '.' && self->peek() == '.') {
            self->read();
            self->read();
            return self->init_cached_kind(16, .TripleDot);
        } else if (self->cur() == '.') {
            self->read();
            return self->init_cached_kind(15, .DoubleDot);
        } else {
            return self->init_cached_kind(14, .Dot);
        }
    }

    /* ************* Helpers ************* */

    [[inline]]
    fn init_cached_kind(self: Self*, slot: usize, kind: TokenKind) TokenKind* {
        const cache = self->cached_kinds[slot];

        if (cache != null) {
            return cache;
        }

        const allocated = alloc_init(dynamic self->arena, kind);
        @assert(allocated, "token kind allocation failed");
        self->cached_kinds[slot] = allocated;
        return allocated;
    }

    [[inline]]
    fn read_single_cached(self: Self*, slot: usize, kind: TokenKind) TokenKind* {
        self->read();
        return self->init_cached_kind(slot, kind);
    }

    [[inline]]
    fn init_kind(self: Self*, kind: TokenKind) TokenKind* {
        const kind = alloc_init(dynamic self->arena, kind);
        @assert(kind, "token kind allocation failed");
        return kind;
    }

    [[inline]]
    fn init_ident(self: Self*, str: String) TokenKind* {
        var heap: TokenKind* = self->arena.alloc(@size_of(TokenKind));
        @assert(heap, "ident allocation failed");
        *heap = TokenKind.Ident(str);
        return heap;
    }

    [[inline]]
    fn init_string_literal(self: Self*, value: String, suffix: Option<StringPrefix>) TokenKind* {
        var heap: TokenKind* = self->arena.alloc(@size_of(TokenKind));
        @assert(heap, "string literal allocation failed");
        *heap = TokenKind.Literal(Literal.String { value, suffix });
        return heap;
    }

    /// Consumes the current token by advancing the lexer
    /// and returns the provided token kind.
    [[inline]]
    fn read_single(self: Self*, kind: TokenKind) TokenKind* {
        self->read();
        return self->init_kind(kind);
    }

    [[inline]]
    fn is_eof(self: const Self*) bool {
        return self->pos >= self->input_len;
    }

    [[inline]]
    fn peek(self: const Self*) uint8 {
        const next_pos = self->pos + 1;

        if (next_pos >= self->input_len) {
            return '\0';
        }

        return self->buf[next_pos];
    }

    [[inline]]
    fn cur(self: const Self*) uint8 {
        if (self->pos >= self->input_len) {
            return '\0';
        }

        return self->buf[self->pos];
    }

    [[inline]]
    fn loc(self: const Self*) Loc {
        return Loc.new(self->pos, self->pos);
    }
}

fn try_str_as_unicode(str: const uint8*) Option<uint8> {
    @assert(str, "str cannot be empty");

    const len = strlen(str);

    // Unicode escapes must be exactly 4 or 8 hex digits
    if (len == 0 || (len != 4 && len != 8)) {
        return .None;
    }
    
    var value: uint32 = 0;
    
    for (var i: usize = 0; i < len; i += 1) {
        const char = str[i];
        var digit: uint32 = 0;
        
        // Validate hex digit (0-9, A-F, a-f)
        switch (char) {
            case '0'..='9' => digit = char - '0';
            case 'A'..='F' => digit = 10 + (char - 'A');
            case 'a'..='f' => digit = 10 + (char - 'a');
            else => return .None;
        }
        
        value = (value * 16) + digit;
        
        if (value > 255) {
            return .None;
        }
    }
    
    if (value > 255) {
        return .None;
    }
    
    return .Some(@cast(uint8, value));
}

fn try_str_as_octal(str: const uint8*) Option<uint32> {
    @assert(str, "str cannot be empty");
    
    const len = strlen(str);

    if (len == 0 || len > 3) {
        return .None;
    }
    
    var value: uint32 = 0;
    
    for (var i: usize = 0; i < len; i += 1) {
        const char = str[i];
        
        // Validate octal digit (0-7)
        if (char < '0' || char > '7') {
            return .None;
        }
        
        const digit = char - '0';
        
        value = (value * 8) + digit;
    }
    
    return .Some(value);
}

fn try_str_as_hex(str: const uint8*) Option<uint128> {
    @assert(str, "str cannot be empty");

    const len = strlen(str);

    // Hex digits must fit into `uint128` 
    // (at most 16 of them)
    if (len == 0 || len > 16) {
        return .None;
    }
    
    var value: uint128 = 0;
    
    for (var i: usize = 0; i < len; i += 1) {
        const char = str[i];
        var digit: uint128 = 0;
        
        // Validate hex digit (0-9, A-F, a-f)
        switch (char) {
            case '0'..='9' => digit = char - '0';
            case 'A'..='F' => digit = 10 + (char - 'A');
            case 'a'..='f' => digit = 10 + (char - 'a');
            else => return .None;
        }
        
        value = (value * 16) + digit;
    }
    
    return .Some(value);
}

fn try_str_as_binary(str: const uint8*) Option<uint128> {
    @assert(str, "str cannot be empty");

    const len = strlen(str);

    // Binary digits must fit into `uint128` 
    // (at most 32 of them)
    if (len == 0 || len > 32) {
        return .None;
    }
    
    var value: uint128 = 0;
    
    for (var i: usize = 0; i < len; i += 1) {
        const char = str[i];
        var digit: uint128 = 0;
        
        // Validate binary digit (0 or 1)
        switch (char) {
            case '0' => digit = 0;
            case '1' => digit = 1;
            else => return .None;
        }
        
        value = (value * 2) + digit;
    }
    
    return .Some(value);
}

[[inline]]
fn is_ws(char: uint8) bool {
    switch (char) {
        case ' ' | '\t' | '\n' | '\r' | '\v' | '\f' => {
            return true;
        }
        else => return false;
    }
}

[[inline]]
fn is_alphanumeric(char: uint8) bool {
    switch (char) {
        case 'a'..='z' | 'A'..='Z' | '_' | '0'..='9' => return true;
        else => return false;
    }
}

[[inline]]
fn is_digit(char: uint8) bool {
    return (char >= '0' && char <= '9');
}

[[inline]]
fn is_hex_digit(char: uint8) bool {
    return (char >= '0' && char <= '9')
        || (char >= 'a' && char <= 'f')
        || (char >= 'A' && char <= 'F');
}

[[inline]]
fn is_octal_digit(char: uint8) bool {
    return char >= '0' && char <= '7';
}