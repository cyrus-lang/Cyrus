import std::string{String, str_contains_char};
import std::collections::hash_map{HashMap};
import std::hash{hash_usize, eq_usize};
import std::io{Writer, StringWriter};
import std::collections{Vec};
import std::mem{Allocator};
import std::option{Option};
import std::format{
    format_float64, 
    format_usize, 
    format_uint32, 
    format_uint128, 
    format_int128
};

import abi::typectx{is_enum_scalar_optimizable};
import resolver::symbols{GlobalSymbolRegistry};
import tokens{push_c_escaped, push_c_char};
import analyzer::vtables{VTableRegistry};
import codegen::c::types{TypeEmitter};
import cir::tables{DeclTables};
import source{SourceContext};
import analyzer::monomorph{
    MonomorphInstance, 
    MonomorphRegistry
};
import codegen::c::mangle;
import parser::ast;
import cir::clone;
import ciri;
import cir;

pub struct Emitter {
    pub allocator: Allocator,
    pub tables: DeclTables*,
    pub registry: GlobalSymbolRegistry*,
    pub trees: const Vec<cir::ProgramTree>*,
    pub vtables: VTableRegistry*,
    pub monomorphs: MonomorphRegistry*,
    pub types: TypeEmitter,
    pub sctx: const SourceContext*,

    libc_protos: String,
    pending_out: String,
    protos_out: String,
    global_out: String,
    body_out: String,
    ctor_out: String,

    defer_scopes: Vec<Vec<cir::DeferStmt>>,
    vtable_emitted: HashMap<usize, uint8>,
    func_proto_emitted: Vec<uint8>,
    loop_marks: Vec<usize>,
    generic_object_names: Vec<String>,
    switch_binding_names: HashMap<usize, String>,
    switch_binding_owned: Vec<String>,
    fn_var_renames: HashMap<usize, String>,
    fn_scope_names: Vec<String>,
    fn_renames_owned: Vec<String>,
    cur_func_name: Option<String>,
    cur_method_name: Option<String>,
    fn_ctx_owned: Vec<String>,

    tuple_export_id: usize,
    lambda_id: usize,

    needs_panic_helper: bool,
    needs_assert_helper: bool,
    needs_memcpy_proto: bool,
    needs_memset_proto: bool,
    needs_write_proto: bool,
    needs_abort_proto: bool,
    needs_stddef_header: bool,
    needs_strcmp_proto: bool,
    needs_errno_location_proto: bool,

    in_void_main: bool,

    pub fn new(
        allocator: Allocator,
        tables: DeclTables*,
        registry: GlobalSymbolRegistry*,
        trees: const Vec<cir::ProgramTree>*,
        vtables: VTableRegistry*,
        monomorphs: MonomorphRegistry*,
        maps: mangle::ModuleMaps,
        sctx: const SourceContext*
    ) Self {
        var func_proto_emitted: Vec<uint8> = Vec.new(allocator);

        func_proto_emitted.resize(tables->funcs.len(), 0);

        return Self {
            allocator,
            tables,
            registry,
            sctx,
            trees,
            vtables,
            monomorphs,
            func_proto_emitted,
            vtable_emitted: HashMap.with_hasher(allocator, 16, hash_usize, eq_usize),
            types: TypeEmitter.new(allocator, tables, registry, maps),
            pending_out: String.new(allocator),
            protos_out: String.new(allocator),
            global_out: String.new(allocator),
            defer_scopes: Vec.new(allocator),
            body_out: String.new(allocator),
            ctor_out: String.new(allocator),
            libc_protos: String.new(allocator),
            loop_marks: Vec.new(allocator),
            needs_stddef_header: false,
            needs_assert_helper: false,
            needs_memcpy_proto: false,
            needs_memset_proto: false,
            needs_write_proto: false,
            needs_abort_proto: false,
            needs_strcmp_proto: false,
            needs_panic_helper: false,
            needs_errno_location_proto: false,
            generic_object_names: Vec.new(allocator),
            switch_binding_owned: Vec.new(allocator),
            switch_binding_names: HashMap.with_hasher(allocator, 16, hash_usize, eq_usize),
            fn_var_renames: HashMap.with_hasher(allocator, 16, hash_usize, eq_usize),
            fn_renames_owned: Vec.new(allocator),
            fn_scope_names: Vec.new(allocator),
            fn_ctx_owned: Vec.new(allocator),
            cur_method_name: .None,
            cur_func_name: .None,
            in_void_main: false,
            tuple_export_id: 0,
            lambda_id: 0,
        };
    }

    pub fn run(self: Self*, writer: Writer) {
        // 1. Top-level type declaration
        for (var i: usize = 0; i < self->trees->len(); i += 1) {
            const tree = self->trees->get_const(i).unwrap();

            for (var j: usize = 0; j < tree->body.len(); j += 1) {
                const stmt = tree->body.get_const(j).unwrap();

                switch (stmt->kind) {
                    case .Struct(struct_) => {
                        const struct_decl = self->tables->structs.get_const(struct_.struct_decl_id).unwrap();
                        
                        if (struct_decl->is_generic()) {
                            self->generic_object_names.push(String.from_str(
                                self->allocator, 
                                struct_.name.as_str_const()
                            ));
                            continue;
                        }

                        for (var i: usize = 0; i < struct_decl->fields.len(); i += 1) {
                            const field = struct_decl->fields.get_const(i).unwrap();
                            self->types.ensure_named(&field->ty);
                        }
                    }
                    case .Union(union_) => {
                        const union_decl = self->tables->unions.get_const(union_.union_decl_id).unwrap();

                        if (union_decl->is_generic()) {
                            self->generic_object_names.push(String.from_str(
                                self->allocator,
                                union_.name.as_str_const()
                            ));
                            continue;
                        }

                        for (var i: usize = 0; i < union_decl->fields.len(); i += 1) {
                            const field = union_decl->fields.get_const(i).unwrap();
                            self->types.ensure_named(&field->ty);
                        }
                    }
                    case .Enum(enum_) => {
                        var is_generic_enum = false;

                        switch (self->tables->enums.get_const(enum_.enum_decl_id)) {
                            case .Some(enum_decl) => {
                                if (enum_decl->is_generic()) {
                                    is_generic_enum = true;
                                }
                            }
                            else => {}
                        }

                        if (is_generic_enum) {
                            self->generic_object_names.push(String.from_str(
                                self->allocator,
                                enum_.name.as_str_const()
                            ));
                            continue;
                        }

                        const type_decl_id: cir::TypeDeclId = .Enum(enum_.enum_decl_id);
                        self->types.ensure_type_decl(&type_decl_id);
                    }
                    case .Typedef(td) => {
                        const type_decl_id: cir::TypeDeclId = .Typedef(td.typedef_decl_id);
                        self->types.ensure_type_decl(&type_decl_id);
                    }
                    else => {}
                }
            }
        }

        // 2. Global Vars
        for (var i: usize = 0; i < self->trees->len(); i += 1) {
            const tree = self->trees->get_const(i).unwrap();

            for (var j: usize = 0; j < tree->body.len(); j += 1) {
                const stmt = tree->body.get_const(j).unwrap();

                switch (stmt->kind) {
                    case .GlobalVar(global_var) => {
                        self->emit_global(&global_var);
                    }
                    else => {}
                }
            }
        }

        // 3. Function and method definitions
        for (var i: usize = 0; i < self->trees->len(); i += 1) {
            const tree = self->trees->get_const(i).unwrap();

            for (var j: usize = 0; j < tree->body.len(); j += 1) {
                const stmt = tree->body.get_const(j).unwrap();
                
                switch (stmt->kind) {
                    case .FuncDef(func_def) => {
                        if (!func_def.is_generic()) {
                            self->emit_func(&func_def);
                        }
                    }
                    else => {}
                }
            }
        }

        for (var i: usize = 0; i < self->tables->methods.len(); i += 1) {
            const method = self->tables->methods.get_const(i).unwrap();

            if (method->func_decl.is_generic()) {
                continue;
            }

            switch (method->object_name) {
                case .Some(obj_name) => {
                    var is_generic_object = false;

                    for (var k: usize = 0; k < self->generic_object_names.len(); k += 1) {
                        const existing = self->generic_object_names.get_const(k).unwrap();

                        if (existing->as_str_const() == obj_name.as_str_const()) {
                            is_generic_object = true;
                            break;
                        }
                    }

                    if (is_generic_object) {
                        continue;
                    }
                }
                else => {}
            }
            
            switch (method->body) {
                case .Some(body_id) => {
                    self->emit_method(i, method, body_id);
                }
                else => {}
            }
        }

        // 4. Monomorphized specializations
        for (var i: usize = 0; i < self->monomorphs->instances.len(); i += 1) {
            const inst = self->monomorphs->instances.get_const(i).unwrap();

            switch (inst->body) {
                case .Some(body_id) => {
                    self->emit_func_inst(i, inst, body_id);
                }
                else => {}
            }
        }

        self->assemble(writer);
    }

    // FIXME: Make this a header-only library.
    fn emit_int128_helpers(self: Self*, writer: Writer) {
        writer.write("static __cyrus_uint128 __cyrus_u128_from_u64(uint64_t lo) { __cyrus_uint128 r; r.lo = lo; r.hi = 0; return r; } ");
        writer.write("static __cyrus_uint128 __cyrus_u128_of_i128(__cyrus_int128 a) { __cyrus_uint128 r; r.lo = a.lo; r.hi = (uint64_t)a.hi; return r; } ");
        writer.write("static __cyrus_int128 __cyrus_i128_from_i64(int64_t v) { __cyrus_int128 r; r.lo = (uint64_t)v; r.hi = v >> 63; return r; } ");
        writer.write("static __cyrus_int128 __cyrus_i128_of_u128(__cyrus_uint128 a) { __cyrus_int128 r; r.lo = a.lo; r.hi = (int64_t)a.hi; return r; } ");
        writer.write("static uint64_t __cyrus_u128_to_u64(__cyrus_uint128 a) { return a.lo; } ");
        writer.write("static uint64_t __cyrus_i128_to_u64(__cyrus_int128 a) { return a.lo; } ");
        writer.write("static int __cyrus_u128_iszero(__cyrus_uint128 a) { return a.lo == 0 && a.hi == 0; } ");
        writer.write("static int __cyrus_i128_iszero(__cyrus_int128 a) { return a.lo == 0 && a.hi == 0; } ");
        writer.write("static int __cyrus_u128_cmp(__cyrus_uint128 a, __cyrus_uint128 b) { ");
        writer.write("    if (a.hi != b.hi) { return (a.hi < b.hi) ? -1 : 1; } ");
        writer.write("    if (a.lo != b.lo) { return (a.lo < b.lo) ? -1 : 1; } ");
        writer.write("    return 0;\n");
        writer.write("} ");
        writer.write("static int __cyrus_i128_cmp(__cyrus_int128 a, __cyrus_int128 b) { ");
        writer.write("    if (a.hi != b.hi) { return (a.hi < b.hi) ? -1 : 1; } ");
        writer.write("    if (a.lo != b.lo) { return (a.lo < b.lo) ? -1 : 1; } ");
        writer.write("    return 0;\n");
        writer.write("} ");
        writer.write("static __cyrus_uint128 __cyrus_u128_add(__cyrus_uint128 a, __cyrus_uint128 b) { ");
        writer.write("    __cyrus_uint128 r; r.lo = a.lo + b.lo;\n");
        writer.write("    r.hi = a.hi + b.hi + (uint64_t)(r.lo < a.lo);\n");
        writer.write("    return r;\n");
        writer.write("} ");
        writer.write("static __cyrus_uint128 __cyrus_u128_sub(__cyrus_uint128 a, __cyrus_uint128 b) { ");
        writer.write("    __cyrus_uint128 r; r.lo = a.lo - b.lo;\n");
        writer.write("    r.hi = a.hi - b.hi - (uint64_t)(a.lo < b.lo);\n");
        writer.write("    return r;\n");
        writer.write("} ");
        writer.write("static __cyrus_uint128 __cyrus_u128_band(__cyrus_uint128 a, __cyrus_uint128 b) { __cyrus_uint128 r; r.lo = a.lo & b.lo; r.hi = a.hi & b.hi; return r; } ");
        writer.write("static __cyrus_uint128 __cyrus_u128_bor(__cyrus_uint128 a, __cyrus_uint128 b) { __cyrus_uint128 r; r.lo = a.lo | b.lo; r.hi = a.hi | b.hi; return r; } ");
        writer.write("static __cyrus_uint128 __cyrus_u128_bxor(__cyrus_uint128 a, __cyrus_uint128 b) { __cyrus_uint128 r; r.lo = a.lo ^ b.lo; r.hi = a.hi ^ b.hi; return r; } ");
        writer.write("static __cyrus_uint128 __cyrus_u128_bnot(__cyrus_uint128 a) { __cyrus_uint128 r; r.lo = ~a.lo; r.hi = ~a.hi; return r; } ");
        writer.write("static __cyrus_uint128 __cyrus_u128_neg(__cyrus_uint128 a) { return __cyrus_u128_sub(__cyrus_u128_from_u64(0), a); } ");
        writer.write("static __cyrus_uint128 __cyrus_u128_shl(__cyrus_uint128 a, uint64_t n_) { ");
        writer.write("    __cyrus_uint128 r; uint64_t n = n_ & 127;\n");
        writer.write("    if (n == 0) { return a; } ");
        writer.write("    if (n >= 64) { r.lo = 0; r.hi = a.lo << (n - 64); return r; } ");
        writer.write("    r.lo = a.lo << n;\n");
        writer.write("    r.hi = (a.hi << n) | (a.lo >> (64 - n));\n");
        writer.write("    return r;\n");
        writer.write("} ");
        writer.write("static __cyrus_uint128 __cyrus_u128_shr(__cyrus_uint128 a, uint64_t n_) { ");
        writer.write("    __cyrus_uint128 r; uint64_t n = n_ & 127;\n");
        writer.write("    if (n == 0) { return a; } ");
        writer.write("    if (n >= 64) { r.lo = a.hi >> (n - 64); r.hi = 0; return r; } ");
        writer.write("    r.lo = (a.lo >> n) | (a.hi << (64 - n));\n");
        writer.write("    r.hi = a.hi >> n;\n");
        writer.write("    return r;\n");
        writer.write("} ");
        writer.write("static __cyrus_int128 __cyrus_i128_shr(__cyrus_int128 a, uint64_t n_) { ");
        writer.write("    __cyrus_int128 r; uint64_t n = n_ & 127;\n");
        writer.write("    if (n == 0) { return a; } ");
        writer.write("    if (n >= 64) { r.lo = (uint64_t)(a.hi >> (n - 64)); r.hi = a.hi < 0 ? -1 : 0; return r; } ");
        writer.write("    r.lo = (a.lo >> n) | ((uint64_t)a.hi << (64 - n));\n");
        writer.write("    r.hi = a.hi >> n;\n");
        writer.write("    return r;\n");
        writer.write("} ");
        writer.write("static int __cyrus_u128_bit(__cyrus_uint128 a, uint64_t i) { ");
        writer.write("    if (i >= 64) { return (int)((a.hi >> (i - 64)) & 1); } ");
        writer.write("    return (int)((a.lo >> i) & 1);\n");
        writer.write("} ");
        writer.write("static void __cyrus_u128_setbit(__cyrus_uint128 *a, uint64_t i) { ");
        writer.write("    if (i >= 64) { a->hi |= (uint64_t)1 << (i - 64); } else { a->lo |= (uint64_t)1 << i; } ");
        writer.write("} ");
        writer.write("static __cyrus_uint128 __cyrus_u128_mul(__cyrus_uint128 a, __cyrus_uint128 b) { ");
        writer.write("    __cyrus_uint128 r; r.lo = 0; r.hi = 0;\n");
        writer.write("    while (a.lo != 0 || a.hi != 0) { ");
        writer.write("        if (a.lo & 1) { r = __cyrus_u128_add(r, b); } ");
        writer.write("        b = __cyrus_u128_shl(b, 1);\n");
        writer.write("        a = __cyrus_u128_shr(a, 1);\n");
        writer.write(" } ");
        writer.write("    return r;\n");
        writer.write("} ");
        writer.write("static __cyrus_uint128 __cyrus_u128_div(__cyrus_uint128 a, __cyrus_uint128 b) { ");
        writer.write("    __cyrus_uint128 q; q.lo = 0; q.hi = 0;\n");
        writer.write("    __cyrus_uint128 rem; rem.lo = 0; rem.hi = 0;\n");
        writer.write("    if (b.lo == 0 && b.hi == 0) { return q; } ");
        writer.write("    for (int i = 127; i >= 0; i -= 1) { ");
        writer.write("        rem = __cyrus_u128_shl(rem, 1);\n");
        writer.write("        if (__cyrus_u128_bit(a, (uint64_t)i)) { rem.lo |= 1; } ");
        writer.write("        if (__cyrus_u128_cmp(rem, b) >= 0) { rem = __cyrus_u128_sub(rem, b); __cyrus_u128_setbit(&q, (uint64_t)i); } ");
        writer.write(" } ");
        writer.write("    return q;\n");
        writer.write("} ");
        writer.write("static __cyrus_uint128 __cyrus_u128_mod(__cyrus_uint128 a, __cyrus_uint128 b) { ");
        writer.write("    if (b.lo == 0 && b.hi == 0) { return a; } ");
        writer.write("    return __cyrus_u128_sub(a, __cyrus_u128_mul(__cyrus_u128_div(a, b), b));\n");
        writer.write("} ");
        writer.write("static __cyrus_int128 __cyrus_i128_add(__cyrus_int128 a, __cyrus_int128 b) { return __cyrus_i128_of_u128(__cyrus_u128_add(__cyrus_u128_of_i128(a), __cyrus_u128_of_i128(b))); } ");
        writer.write("static __cyrus_int128 __cyrus_i128_sub(__cyrus_int128 a, __cyrus_int128 b) { return __cyrus_i128_of_u128(__cyrus_u128_sub(__cyrus_u128_of_i128(a), __cyrus_u128_of_i128(b))); } ");
        writer.write("static __cyrus_int128 __cyrus_i128_mul(__cyrus_int128 a, __cyrus_int128 b) { return __cyrus_i128_of_u128(__cyrus_u128_mul(__cyrus_u128_of_i128(a), __cyrus_u128_of_i128(b))); } ");
        writer.write("static __cyrus_int128 __cyrus_i128_shl(__cyrus_int128 a, uint64_t n) { return __cyrus_i128_of_u128(__cyrus_u128_shl(__cyrus_u128_of_i128(a), n)); } ");
        writer.write("static __cyrus_int128 __cyrus_i128_band(__cyrus_int128 a, __cyrus_int128 b) { return __cyrus_i128_of_u128(__cyrus_u128_band(__cyrus_u128_of_i128(a), __cyrus_u128_of_i128(b))); } ");
        writer.write("static __cyrus_int128 __cyrus_i128_bor(__cyrus_int128 a, __cyrus_int128 b) { return __cyrus_i128_of_u128(__cyrus_u128_bor(__cyrus_u128_of_i128(a), __cyrus_u128_of_i128(b))); } ");
        writer.write("static __cyrus_int128 __cyrus_i128_bxor(__cyrus_int128 a, __cyrus_int128 b) { return __cyrus_i128_of_u128(__cyrus_u128_bxor(__cyrus_u128_of_i128(a), __cyrus_u128_of_i128(b))); } ");
        writer.write("static __cyrus_int128 __cyrus_i128_bnot(__cyrus_int128 a) { return __cyrus_i128_of_u128(__cyrus_u128_bnot(__cyrus_u128_of_i128(a))); } ");
        writer.write("static __cyrus_int128 __cyrus_i128_neg(__cyrus_int128 a) { return __cyrus_i128_of_u128(__cyrus_u128_neg(__cyrus_u128_of_i128(a))); } ");
        writer.write("static __cyrus_int128 __cyrus_i128_div(__cyrus_int128 a, __cyrus_int128 b) { ");
        writer.write("    int neg = (a.hi < 0) != (b.hi < 0);\n");
        writer.write("    __cyrus_uint128 ua = __cyrus_u128_of_i128(a);\n");
        writer.write("    __cyrus_uint128 ub = __cyrus_u128_of_i128(b);\n");
        writer.write("    if (a.hi < 0) { ua = __cyrus_u128_of_i128(__cyrus_i128_neg(a)); } ");
        writer.write("    if (b.hi < 0) { ub = __cyrus_u128_of_i128(__cyrus_i128_neg(b)); } ");
        writer.write("    __cyrus_int128 q = __cyrus_i128_of_u128(__cyrus_u128_div(ua, ub));\n");
        writer.write("    return neg ? __cyrus_i128_neg(q) : q;\n");
        writer.write("} ");
        writer.write("static __cyrus_int128 __cyrus_i128_mod(__cyrus_int128 a, __cyrus_int128 b) { ");
        writer.write("    if (b.hi == 0 && b.lo == 0) { return a; } ");
        writer.write("    return __cyrus_i128_sub(a, __cyrus_i128_mul(__cyrus_i128_div(a, b), b));\n");
        writer.write("} ");
    }

    fn assemble(self: Self*, parent: Writer) {
        var module = String.new(self->allocator);
        var writer: Writer = dynamic StringWriter.new(&module);

        if (self->types.used_stdint) {
            writer.write("#include <stdint.h>\n");
        }

        if (self->types.used_bool) {
            writer.write("#include <stdbool.h>\n");
        }

        if (self->needs_stddef_header) {
            writer.write("#include <stddef.h>\n");
        }

        if (self->libc_protos.len() > 0) {
            writer.write(self->libc_protos.as_str_const());
        }

        // FIXME: Move this into the header-only library.
        if (self->needs_panic_helper || self->needs_assert_helper) {
            writer.write("static void __cyrus_write_cstr(int fd, const char *s) { ");
            writer.write("    const char *p = s;\n");
            writer.write("    while (*p) { p += 1; } ");
            writer.write("    write(fd, s, (unsigned long)(p - s));\n");
            writer.write("} \n");
        }

        // FIXME: Move this into the header-only library.
        if (self->needs_panic_helper) {
            writer.write("static void __cyrus_panic_(const char *mesg) { ");
            writer.write("    __cyrus_write_cstr(2, \"panic: \");\n");
            writer.write("    __cyrus_write_cstr(2, mesg);\n");
            writer.write("    __cyrus_write_cstr(2, \"");
            writer.write_char('\\');
            writer.write_char('n');
            writer.write("\");\n");
            writer.write("    abort();\n");
            writer.write("} \n");
        }

        // FIXME: Move this into the header-only library.
        if (self->needs_assert_helper) {
            writer.write("static void __cyrus_write_int(int fd, int value) { ");
            writer.write("    char buf[16];\n");
            writer.write("    int i = 15;\n");
            writer.write("    unsigned int u = (unsigned int)value;\n");
            writer.write("    if (value < 0) { u = (unsigned int)(-(value + 1)) + 1u; } ");
            writer.write("    buf[i] = 0;\n");
            writer.write("    do { i -= 1; buf[i] = (char)(48 + (u % 10)); u /= 10; } while (u > 0);\n");
            writer.write("    if (value < 0) { i -= 1; buf[i] = '-'; } ");
            writer.write("    write(fd, buf + i, (unsigned long)(15 - i));\n");
            writer.write("} \n");

            writer.write("static void __cyrus_assert_fail_(const char *file, int line, const char *mesg) { ");
            writer.write("    __cyrus_write_cstr(2, \"assertion failed: \");\n");
            writer.write("    __cyrus_write_cstr(2, mesg);\n");
            writer.write("    __cyrus_write_cstr(2, \" at \");\n");
            writer.write("    __cyrus_write_cstr(2, file);\n");
            writer.write("    __cyrus_write_cstr(2, \":\");\n");
            writer.write("    __cyrus_write_int(2, line);\n");
            writer.write("    __cyrus_write_cstr(2, \"");
            writer.write_char('\\');
            writer.write_char('n');
            writer.write("\");\n");
            writer.write("    abort();\n");
            writer.write("} \n");
        }

        // FIXME: Move this into the header-only library.
        if (self->types.used_int128) {
            writer.write("typedef struct { uint64_t lo; int64_t hi; } __cyrus_int128;\n");
            writer.write("typedef struct { uint64_t lo; uint64_t hi; } __cyrus_uint128;\n");
            self->emit_int128_helpers(writer);
            writer.write("\n");
        }

        self->types.drain_deferred();

        writer.write(self->types.type_out.as_str_const());
        writer.write(self->protos_out.as_str_const());
        writer.write("\n");
        writer.write(self->global_out.as_str_const());

        if (self->ctor_out.len() > 0) {
            writer.write("static void __cyrus_global_ctors(void) __attribute__((constructor));\n");
            writer.write("static void __cyrus_global_ctors(void) { ");
            writer.write(self->ctor_out.as_str_const());
            writer.write("} \n");
        }

        writer.write(self->pending_out.as_str_const());
        writer.write(self->body_out.as_str_const());

        parent.write(module.as_str_const());
        module.free();
    }

    /* ************* Globals ************* */

    fn emit_global(self: Self*, global_var: const cir::GlobalVarStmt*) {
        if (!global_var->is_static && !global_var->is_const) {
            return;
        }

        var name = mangle::mangle_global(
            self->allocator,
            &self->types.maps,
            global_var->name.as_str_const(),
            global_var->global_var_decl_id,
            &global_var->modifiers
        );

        switch (global_var->modifiers.extern_) {
            case .Some(extern_) => {
                switch (extern_) {
                    case .C => {
                        // Extern declaration only
                        if (name.as_str_const() == "errno") {
                            // TLS object: accessed via (*__errno_location())
                            self->ensure_errno_location_proto();
                            name.free();
                            return;
                        }

                        switch (global_var->ty) {
                            case .Some(ty) => {
                                self->types.ensure_named(&ty);

                                var decl = self->types.build_decl(&ty, name.as_str_const());
                                
                                self->global_out.push_str("extern ");
                                self->global_out.push_str(decl.as_str_const());
                                self->global_out.push_str(";\n");
                                
                                decl.free();
                                name.free();
                                return;
                            }
                            else => {
                                name.free();
                                return;
                            }
                        }
                    }
                    else => {}
                }
            }
            else => {}
        }

        switch (global_var->ty) {
            case .Some(ty) => {
                self->types.ensure_named(&ty);

                if (global_var->is_const) {
                    self->global_out.push_str("const ");
                }

                var decl = self->types.build_decl(&ty, name.as_str_const());

                switch (global_var->rhs) {
                    case .Some(rhs) => {
                        if (rhs.is_comptime_expr()) {
                            self->global_out.push_str(decl.as_str_const());
                            self->global_out.push_str(" = ");
                            
                            var init = self->emit_global_init(&rhs, &ty);
                            self->global_out.push_str(init.as_str_const());
                            self->global_out.push_str(";\n");
                            init.free();
                        } else {
                            // Zero-init
                            self->global_out.push_str(decl.as_str_const());
                            self->global_out.push_str(" = {0};\n");

                            self->ctor_out.push_str("    ");
                            self->ctor_out.push_str(name.as_str_const());
                            self->ctor_out.push_str(" = ");
                            
                            var expr = self->emit_expr(&rhs);
                            self->ctor_out.push_str(expr.as_str_const());
                            self->ctor_out.push_str(";\n");
                            expr.free();
                        }
                    }
                    case .None => {
                        self->global_out.push_str(decl.as_str_const());
                        self->global_out.push_str(";\n");
                    }
                }

                decl.free();
            }
            case .None => {}
        }

        name.free();
    }

    fn emit_global_init(self: Self*, expr: const cir::Expr*, ty: const cir::SemaType*) String {
        switch (expr->kind) {
            case .Literal(literal) => {
                return self->emit_literal(&literal);
            }

            case .StructInit(struct_init) => {
                var out = String.from_str(self->allocator, "{ ");

                for (var i: usize = 0; i < struct_init.fields.len(); i += 1) {
                    const field = struct_init.fields.get_const(i).unwrap();

                    out.push_str(".");
                    mangle::sanitize_into(&out, field->name.as_str_const());
                    out.push_str(" = ");
                    
                    switch (field->value.ty) {
                        case .Some(ty) => {
                            var global_var = self->emit_global_init(&field->value, &ty);
                            out.push_str(global_var.as_str_const());
                            global_var.free();
                        }
                        case .None => {
                            var expr = self->emit_expr(&field->value);
                            out.push_str(expr.as_str_const());
                            expr.free();
                        }
                    }
                    
                    out.push_str(", ");
                }

                out.push_str("}");
                return out;
            }

            case .UnionInit(union_init) => {
                var out = String.from_str(self->allocator, "{ .");
                mangle::sanitize_into(&out, union_init.field->name.as_str_const());
                out.push_str(" = ");
                
                var expr = self->emit_expr(&union_init.field->value);
                out.push_str(expr.as_str_const());
                expr.free();
                
                out.push_str(" }");
                return out;
            }

            case .Array(array) => {
                var out = String.from_str(self->allocator, "{ ");
                
                for (var i: usize = 0; i < array.elements.len(); i += 1) {
                    const element = array.elements.get_const(i).unwrap();

                    switch (element->kind) {
                        case .Array(array2) => {
                            var braces = self->emit_array_braces(&array2);
                            out.push_str(braces.as_str_const());
                            braces.free();
                        }
                        else => {
                            var expr = self->emit_expr(element);
                            out.push_str(expr.as_str_const());
                            expr.free();
                        }
                    }

                    out.push_str(", ");
                }
                
                out.push_str("}");
                return out;
            }

            case .Tuple(tuple) => {
                var out = String.from_str(self->allocator, "{ ");

                for (var i: usize = 0; i < tuple.elements.len(); i += 1) {
                    const element = tuple.elements.get_const(i).unwrap();
                    
                    var expr = self->emit_expr(element);
                    out.push_str(expr.as_str_const());
                    expr.free();
                    
                    out.push_str(", ");
                }

                out.push_str("}");
                return out;
            }

            case .EnumInit(enum_init) => {
                switch (enum_init.operand) {
                    case .Named(named) => {
                        switch (named.type_decl_id) {
                            case .Enum(id) => {
                                const enum_decl = self->tables->enums.get_const(id).unwrap();
                                const is_scalar = is_enum_scalar_optimizable(self->tables, enum_decl);
                                const tags = self->types.tctx.enum_variant_tags(id, enum_decl);

                                const tag = enum_decl->find_variant_tag(
                                    tags, 
                                    enum_init.name.as_str_const()
                                );

                                if (is_scalar) {
                                    var out = String.new(self->allocator);

                                    switch (enum_init.arg) {
                                        case .Unit => {}

                                        case .Tuple(exprs) => {
                                            if (exprs.len() == 1) {
                                                const element = exprs.get_const(0).unwrap();
                                                var v = self->emit_expr(element);
                                                out.push_str(v.as_str_const());
                                                v.free();
                                            }
                                        }

                                        else => {}
                                    }
                                    
                                    if (out.len() == 0) {
                                        push_uint32(&out, tag);
                                    }
                                    
                                    return out;
                                }
                            }
                            else => {}
                        }
                    }
                    else => {}
                }

                return self->emit_enum_init(&enum_init);
            }

            else => {
                return self->emit_expr(expr);
            }
        }
    }

    /* ************* Prototypes and definitions ************* */

    fn ensure_func_decl_proto(self: Self*, func_decl_id: cir::FuncDeclId, decl: const cir::FuncDecl*) {
        if (!decl->is_func_decl) {
            return;
        }

        if (func_decl_id >= self->func_proto_emitted.len()) {
            self->func_proto_emitted.resize(func_decl_id + 1, 0);
        }

        switch (self->func_proto_emitted.get(func_decl_id)) {
            case .Some(emitted_flag) => {
                if (*emitted_flag != 0) {
                    return;
                }
                *emitted_flag = 1;
            }
            else => return;
        }

        var mangled_name = mangle::mangle_func(
            self->allocator,
            &self->types.maps,
            decl->name.as_str_const(),
            func_decl_id,
            &decl->modifiers
        );

        // Prevent collisions between 
        // codegen libc declarations 
        /// and language libc declarations
        if (is_emitter_libc_name(mangled_name.as_str_const())) {
            mangled_name.free();
            return;
        }

        var sig = self->build_func_signature(
            &decl->ret_type,
            &decl->params,
            mangled_name.as_str_const()
        );

        self->protos_out.push_str(sig.as_str_const());
        self->protos_out.push_str(";\n");
        
        mangled_name.free();
        sig.free();
    }

    fn emit_func(self: Self*, func_def: const cir::FuncDefStmt*) {
        const func_decl_id = func_def->func_decl_id.unwrap();

        var name = mangle::mangle_func(
            self->allocator,
            &self->types.maps,
            func_def->name.as_str_const(),
            func_decl_id,
            &func_def->modifiers
        );

        const is_void_main = name.as_str_const() == "main"
            && func_def->ret_type.is_void()
            && func_def->params.list.len() == 0;

        const int32_type: cir::SemaType = .Plain(.Int32);

        var ret_type_ptr: const cir::SemaType* = &func_def->ret_type;
        
        if (is_void_main) {
            ret_type_ptr = &int32_type;
        }

        var sig = self->build_func_signature(
            ret_type_ptr, 
            &func_def->params, 
            name.as_str_const()
        );

        self->protos_out.push_str(sig.as_str_const());
        self->protos_out.push_str(";\n");

        self->body_out.push_str(sig.as_str_const());
        self->body_out.push_str(" { ");
        sig.free();

        var saved_func_name = self->cur_func_name;
        var saved_method_name = self->cur_method_name;
        self->set_name_context(func_def->name.as_str_const(), null);

        self->emit_param_prologue(&func_def->params);

        self->in_void_main = is_void_main;

        self->emit_block_stmts(func_def->body, true);

        self->cur_func_name = saved_func_name;
        self->cur_method_name = saved_method_name;

        if (self->in_void_main) {
            self->body_out.push_str("    return 0;\n");
        }
        self->in_void_main = false;

        if (!func_def->ret_type.is_void()) {
            self->body_out.push_str("    __builtin_unreachable();\n");
        }

        self->body_out.push_str("} \n");
        name.free();
    }

    fn emit_method(self: Self*, method_id: usize, method: const cir::MethodDecl*, body_id: cir::BodyId) {
        var name = mangle::mangle_method(
            self->allocator,
            &self->types.maps,
            method_id, 
            method
        );
        
        const func = &method->func_decl;
        
        var sig = self->build_func_signature(
            &func->ret_type,
            &func->params,
            name.as_str_const()
        );

        self->protos_out.push_str(sig.as_str_const());
        self->protos_out.push_str(";\n");

        self->body_out.push_str(sig.as_str_const());
        self->body_out.push_str(" { ");
        sig.free();

        var saved_func_name = self->cur_func_name;
        var saved_method_name = self->cur_method_name;
        self->set_name_context(null, func->name.as_str_const());

        self->emit_param_prologue(&func->params);

        switch (self->tables->bodies.get_const(body_id)) {
            case .Some(body) => {
                self->emit_block_stmts(body, false);
            }
            else => {}
        }

        self->cur_func_name = saved_func_name;
        self->cur_method_name = saved_method_name;

        if (!func->ret_type.is_void()) {
            self->body_out.push_str(" __builtin_unreachable();\n");
        }

        self->body_out.push_str("} \n");
        name.free();
    }

    fn emit_func_inst(
        self: Self*,
        monomorph_id: cir::MonomorphId,
        inst: const MonomorphInstance*,
        body_id: cir::BodyId
    ) {
        var name: String;
        var have_name = false;
        var ctx_name: const uint8*;
        var ctx_is_method = false;

        switch (inst->template_id) {
            case .Func(func_decl_id) => {
                switch (self->tables->funcs.get_const(func_decl_id)) {
                    case .Some(func_decl) => {
                        name = mangle::mangle_monomorphized_func(
                            self->allocator,
                            &self->types.maps,
                            self->tables,
                            func_decl->name.as_str_const(),
                            func_decl_id,
                            &func_decl->modifiers,
                            &inst->type_args
                        );
                        ctx_name = func_decl->name.as_str_const();
                        have_name = true;
                    }
                    else => {}
                }
            }
            case .Method(method_decl_id) => {
                switch (self->tables->methods.get_const(method_decl_id)) {
                    case .Some(method) => {
                        name = mangle::mangle_monomorphized_method(
                            self->allocator,
                            &self->types.maps,
                            self->tables,
                            method_decl_id,
                            method,
                            &inst->type_args
                        );
                        ctx_name = method->func_decl.name.as_str_const();
                        ctx_is_method = true;
                        have_name = true;
                    }
                    else => {}
                }
            }
        }

        if (!have_name) {
            return;
        }

        var sig = self->build_func_signature(&inst->ret_type, &inst->params, name.as_str_const());

        self->protos_out.push_str(sig.as_str_const());
        self->protos_out.push_str(";\n");

        self->body_out.push_str(sig.as_str_const());
        self->body_out.push_str(" { ");
        sig.free();

        var saved_func_name = self->cur_func_name;
        var saved_method_name = self->cur_method_name;

        if (ctx_is_method) {
            self->set_name_context(null, ctx_name);
        } else {
            self->set_name_context(ctx_name, null);
        }

        self->emit_param_prologue(&inst->params);

        switch (self->tables->bodies.get_const(body_id)) {
            case .Some(body) => {
                self->emit_block_stmts(body, true);
            }
            else => {}
        }

        self->cur_func_name = saved_func_name;
        self->cur_method_name = saved_method_name;

        if (!inst->ret_type.is_void()) {
            self->body_out.push_str(" __builtin_unreachable();\n");
        }

        self->body_out.push_str("} \n");
        name.free();
    }

    fn build_func_signature(
        self: Self*,
        ret_type: const cir::SemaType*,
        params: const cir::FuncParams*,
        name: const uint8*
    ) String {
        self->types.ensure_named(ret_type);

        for (var i: usize = 0; i < params->list.len(); i += 1) {
            const param = params->list.get_const(i).unwrap();
            const ty = param->ty();
            self->types.ensure_named(&ty);
        }

        var param_list = String.new(self->allocator);

        if (params->list.len() == 0) {
            switch (params->variadic) {
                case .Some => {
                    param_list.push_str("...");
                }
                else => {
                    param_list.push_str("void");
                }
            }
        } else {
            for (var i: usize = 0; i < params->list.len(); i += 1) {
                const param = params->list.get_const(i).unwrap();
                
                var name = mangle::sanitized(self->allocator, param->name_str());
                var ty = param->ty();

                switch (ty) {
                    case .Array(array) => {
                        ty = .Pointer(array.element_type);
                    }
                    else => {}
                }

                var decl = self->types.build_decl(&ty, name.as_str_const());
                param_list.push_str(decl.as_str_const());
                decl.free();
                name.free();

                if (i + 1 < params->list.len()) {
                    param_list.push_str(", ");
                }
            }

            switch (params->variadic) {
                case .Some => {
                    if (params->list.len() > 0) {
                        param_list.push_str(", ");
                    }
                    param_list.push_str("...");
                }
                else => {}
            }
        }

        var full_name = String.from_str(self->allocator, name);
        full_name.push('(');
        full_name.push_str(param_list.as_str_const());
        full_name.push(')');
        param_list.free();

        var decl = self->types.build_decl(
            ret_type,
            full_name.as_str_const()
        );
        full_name.free();
        return decl;
    }

    // FIXME: Use Option<const uint8*> instead of null literal.
    fn set_name_context(self: Self*, func_name: const uint8*, method_name: const uint8*) {
        if (func_name != null) {
            var owned = String.from_str(self->allocator, func_name);
            self->fn_ctx_owned.push(owned);
            self->cur_func_name = .Some(owned);
        } else {
            self->cur_func_name = .None;
        }

        if (method_name != null) {
            var name = String.from_str(self->allocator, method_name);
            self->fn_ctx_owned.push(name);
            self->cur_method_name = .Some(name);
        } else {
            self->cur_method_name = .None;
        }
    }

    fn tree_for_source(self: Self*, source_id: uint32) Option<const cir::ProgramTree*> {
        for (var i: usize = 0; i < self->trees->len(); i += 1) {
            const tree = self->trees->get_const(i).unwrap();

            if (@cast(usize, tree->file_id) == @cast(usize, source_id)) {
                return .Some(tree);
            }
        }

        return .None;
    }

    fn quoted_cstr(self: Self*, text: const uint8*) String {
        var out = String.from_str(self->allocator, "\"");
        push_c_escaped(&out, text);
        out.push('"');
        return out;
    }

    fn builtin_line_column(
        self: Self*,
        builtin_func: const cir::BuiltinFunc*,
        want_column: bool
    ) Option<usize> {
        if (self->sctx == null) {
            return .None;
        }

        const source = self->sctx->get(builtin_func->name.span.source_id);
        const offset = builtin_func->name.span.loc.start;

        switch (source->nearest_line(offset)) {
            case .Some(line) => {
                if (want_column) {
                    return .Some(source->line_offset_to_column(line, offset));
                }

                return .Some(line);
            }
            else => {}
        }

        return .None;
    }

    fn enter_function_scope(self: Self*, params: const cir::FuncParams*) {
        for (var i: usize = 0; i < self->fn_scope_names.len(); i += 1) {
            self->fn_scope_names.get(i).unwrap()->free();
        }

        self->fn_scope_names.clear();

        for (var i: usize = 0; i < params->list.len(); i += 1) {
            const param = params->list.get_const(i).unwrap();

            var name = self->declare_fn_scope_name(param->name_str());
            name.free();
        }
    }

    /// Returns a unique C identifier for `base` that is
    /// unused in the current function scope.
    fn declare_fn_scope_name(self: Self*, base: const uint8*) String {
        var c_name = mangle::sanitized(self->allocator, base);
        var suffix: usize = 1;

        while (self->fn_name_taken(c_name.as_str_const())) {
            var unique = String.from_str(self->allocator, base);
            unique.push_str("__");
            push_usize(&unique, suffix);
            
            c_name.free();
            c_name = mangle::sanitized(
                self->allocator, 
                unique.as_str_const()
            );
            
            unique.free();
            suffix += 1;
        }

        var name = String.from_str(
            self->allocator, 
            c_name.as_str_const()
        );
        self->fn_scope_names.push(name);
        return c_name;
    }

    fn fn_name_taken(self: Self*, candidate: const uint8*) bool {
        for (var i: usize = 0; i < self->fn_scope_names.len(); i += 1) {
            const existing = self->fn_scope_names.get_const(i).unwrap();

            if (existing->as_str_const() == candidate) {
                return true;
            }
        }

        return false;
    }

    /// Maps `var_decl_id`'s emission name to `final_name`.
    fn register_fn_rename(
        self: Self*,
        var_decl_id: cir::VarDeclId, 
        final_name: const uint8*
    ) {
        var owned = String.from_str(self->allocator, final_name);
        self->fn_renames_owned.push(owned);
        self->fn_var_renames.insert(var_decl_id, owned);
    }

    fn emit_param_prologue(self: Self*, params: const cir::FuncParams*) {
        self->enter_function_scope(params);

        for (var i: usize = 0; i < params->list.len(); i += 1) {
            const param = params->list.get_const(i).unwrap();
            const ty = param->ty();

            switch (ty) {
                case .Array(array) => {
                    var name = mangle::sanitized(self->allocator, param->name_str());
                    var capacity: usize = 1;
                    
                    switch (array.capacity) {
                        case .Fixed(capacity_expr) => {
                            switch (ciri::fold_const_expr_int(self->tables, self->registry, capacity_expr)) {
                                case .Some(literal) => capacity = cir::integer_literal_as_usize(literal);
                                else => {}
                            }
                        }
                        else => {}
                    }

                    var type_name = self->types.type_name(array.element_type);
                    
                    self->body_out.push_str(type_name.as_str_const());
                    self->body_out.push(' ');
                    self->body_out.push_str(name.as_str_const());
                    self->body_out.push('[');
                    push_usize(&self->body_out, capacity);
                    self->body_out.push_str("];\n");
                    
                    self->ensure_memcpy_proto();
                    self->body_out.push_str(" memcpy(");
                    self->body_out.push_str(name.as_str_const());
                    self->body_out.push_str(", ");
                    self->body_out.push_str(name.as_str_const());
                    self->body_out.push_str("__p, sizeof(");
                    self->body_out.push_str(name.as_str_const());
                    self->body_out.push_str("));\n");

                    type_name.free();
                    name.free();
                }
                else => {}
            }
        }
    }

    /* ************* Statements ************* */

    fn emit_block_stmts(self: Self*, block: const cir::BlockStmt*, push_scope: bool) {
        if (push_scope) {
            var scope: Vec<cir::DeferStmt> = Vec.new(self->allocator);

            for (var i: usize = 0; i < block->defers.len(); i += 1) {
                const defers = block->defers.get_const(i).unwrap();
                scope.push(*defers);
            }

            self->defer_scopes.push(scope);
        }

        for (var i: usize = 0; i < block->stmts.len(); i += 1) {
            const stmt = block->stmts.get_const(i).unwrap();
            self->emit_stmt(stmt);
        }

        if (push_scope) {
            self->pop_defer_scope();
        }
    }

    fn emit_stmt(self: Self*, stmt: const cir::Stmt*) {
        switch (stmt->kind) {
            case .Expr(expr) => {
                var expr = self->emit_expr(&expr);
                self->body_out.push_str(expr.as_str_const());
                self->body_out.push_str(";\n");
                expr.free();
            }

            case .BlockStmt(block) => {
                self->body_out.push_str(" { ");
                self->emit_block_stmts(&block, true);
                self->body_out.push_str(" } ");
            }

            case .Label(label) => {
                const name = mangle::sanitized(self->allocator, label.name.as_str_const());

                self->body_out.push_str(name.as_str_const());
                self->body_out.push_str(":\n");

                name.free();
            }

            case .Goto(goto_) => {
                var label = mangle::sanitized(self->allocator, goto_.name.as_str_const());

                self->body_out.push_str(" goto ");
                self->body_out.push_str(label.as_str_const());
                self->body_out.push_str(";\n");
                
                label.free();
            }

            case .Builtin(builtin) => {
                switch (builtin) {
                    case .BuiltinFunc(builtin_func) => {
                        var str = self->emit_builtin_func(&builtin_func);
                        self->body_out.push_str(str.as_str_const());
                        self->body_out.push_str(";\n");
                        str.free();
                    }
                    else => {}
                }
            }

            case .Break => {
                self->emit_defers_to_loop_mark();
                self->body_out.push_str(" break;\n");
            }

            case .Continue => {
                self->emit_defers_to_loop_mark();
                self->body_out.push_str(" continue;\n");
            }

            case .Variable(var_) => {
                self->emit_var(&var_);
            }

            case .TupleExport(tuple_export) => {
                self->emit_tuple_export(&tuple_export);
            }
            
            case .Return(return_) => {
                self->emit_return(&return_);
            }

            case .If(if_) => {
                self->emit_if(&if_);
            }

            case .While(while_) => {
                self->emit_while(&while_);
            }

            case .For(for_) => {
                self->emit_for(&for_);
            }

            case .Switch(switch_) => {
                self->emit_switch(&switch_);
            }
            
            case .InlineAsm(asm) => {
                self->emit_inline_asm_stmt(asm);
            }

            case .Defer => {}

            else => {}
        }
    }

    fn emit_tuple_export(self: Self*, export_tuple: const cir::TupleExportStmt*) {
        switch (export_tuple->rhs) {
            case .Some(rhs) => {
                switch (rhs.ty) {
                    case .Some(ty) => {
                        var rhs_value = self->emit_expr(&rhs);

                        var temp = String.from_str(self->allocator, "__tuple_export_");
                        push_usize(&temp, self->tuple_export_id);
                        self->tuple_export_id += 1;

                        self->types.ensure_named(&ty);

                        var decl = self->types.build_decl(&ty, temp.as_str_const());

                        self->body_out.push_str("const ");
                        self->body_out.push_str(decl.as_str_const());
                        self->body_out.push_str(" = ");
                        self->body_out.push_str(rhs_value.as_str_const());
                        self->body_out.push_str(";\n");

                        self->emit_tuple_export_pattern(
                            &export_tuple->pattern,
                            temp.as_str_const(),
                            export_tuple->is_const
                        );

                        rhs_value.free();
                        temp.free();
                        decl.free();
                    }
                    else => {}
                }
            }
            else => {}
        }
    }

    fn emit_tuple_export_pattern(
        self: Self*,
        pattern: const cir::TupleExportPattern*,
        accessor: const uint8*,
        var is_const: bool
    ) {
        switch (pattern->kind) {
            case .Ident(var_decl_id) => {
                switch (pattern->constness) {
                    case .Some(.Const) => is_const = true;
                    case .Some(.Var) => is_const = false;
                    else => {}
                }

                switch (self->tables->vars.get_const(var_decl_id)) {
                    case .Some(entry) => {
                        var name = mangle::sanitized(self->allocator, entry->name.as_str_const());

                        switch (entry->ty) {
                            case .Some(ty) => {
                                self->types.ensure_named(&ty);

                                var binding_decl = self->types.build_decl(&ty, name.as_str_const());

                                if (is_const) {
                                    self->body_out.push_str("const ");
                                }

                                self->body_out.push_str(binding_decl.as_str_const());
                                self->body_out.push_str(" = ");
                                self->body_out.push_str(accessor);
                                self->body_out.push_str(";\n");

                                binding_decl.free();
                            }
                            else => {}
                        }

                        name.free();
                    }
                    else => {}
                }
            }
            case .Tuple(patterns) => {
                for (var i: usize = 0; i < patterns.len(); i += 1) {
                    const inner = patterns.get_const(i).unwrap();

                    var child_accessor = String.from_str(self->allocator, accessor);
                    child_accessor.push_str(".f");
                    push_usize(&child_accessor, i);

                    self->emit_tuple_export_pattern(inner, child_accessor.as_str_const(), is_const);

                    child_accessor.free();
                }
            }
            case .Ignore => {}
        }
    }

    fn emit_var(self: Self*, var_: const cir::VarStmt*) {
        var base_name = mangle::sanitized(self->allocator, var_->name.as_str_const());
        var name = self->declare_fn_scope_name(base_name.as_str_const());

        if (name.as_str_const() != base_name.as_str_const()) {
            self->register_fn_rename(var_->var_decl_id, name.as_str_const());
        }

        base_name.free();
        
        switch (var_->rhs) {
            case .Some(rhs) => {
                if (rhs.kind.is_lambda()) {
                    self->emit_var_lambda(var_, name);
                    return;
                }
            }
            else => {}
        }

        if (var_->ty.is_none()) {
            // Infer from rhs
            switch (var_->rhs) {
                case .Some(rhs) => {
                    switch (rhs.kind) {
                        case .Lambda => {
                            self->emit_var_lambda(var_, name);
                        }
                        else => {}
                    }
                    
                    switch (rhs.ty) {
                        case .Some(ty) => {
                            self->types.ensure_named(&ty);
                            
                            var decl = self->types.build_decl(&ty, name.as_str_const());
                            
                            if (var_->is_const) {
                                self->body_out.push_str("const ");
                            }
                            
                            self->body_out.push_str(decl.as_str_const());
                            
                            switch (rhs.kind) {
                                case .Array(array) => {
                                    self->body_out.push_str(" = ");
                                    var braces = self->emit_array_braces(&array);
                                    self->body_out.push_str(braces.as_str_const());
                                    braces.free();
                                }
                                else => {
                                    self->body_out.push_str(" = ");
                                    var expr = self->emit_expr(&rhs);
                                    self->body_out.push_str(expr.as_str_const());
                                    expr.free();
                                }
                            }

                            self->body_out.push_str(";\n");
                            decl.free();
                        }
                        case .None => {}
                    }
                }
                case .None => {}
            }

            name.free();
            return;
        }

        switch (var_->ty) {
            case .Some(ty) => {
                self->types.ensure_named(&ty);
                
                var decl = self->types.build_decl(&ty, name.as_str_const());

                if (var_->is_const) {
                    self->body_out.push_str("const ");
                }

                self->body_out.push_str(decl.as_str_const());

                switch (var_->rhs) {
                    case .Some(rhs) => {
                        self->body_out.push_str(" = ");

                        switch (rhs.kind) {
                            case .Array(array) => {
                                var braces = self->emit_array_braces(&array);
                                self->body_out.push_str(braces.as_str_const());
                                braces.free();
                            }
                            else => {
                                var expr = self->emit_expr(&rhs);
                                var dest_128 = self->int128_kind_of(&ty);
                                var src_128 = self->expr_int128_kind(&rhs);

                                if (dest_128.is_some() && !(src_128.is_some() && src_128.unwrap() == dest_128.unwrap())) {
                                    var coerce = self->coerce_to_int128(&rhs, expr.as_str_const(), dest_128.unwrap());
                                    self->body_out.push_str(coerce.as_str_const());
                                    coerce.free();
                                } else {
                                    self->body_out.push_str(expr.as_str_const());
                                }

                                expr.free();
                            }
                        }
                    }
                    case .None => {
                        if (!var_->is_undef) {
                            self->body_out.push_str(" = {0}");
                        }
                    }
                }

                self->body_out.push_str(";\n");
                decl.free();
                name.free();
            }
            case .None => {}
        }
    }

    fn emit_var_lambda(self: Self*, var_: const cir::VarStmt*, name: String) {
        switch (var_->rhs) {
            case .Some(rhs) => {
                switch (rhs.kind) {
                    case .Lambda(lambda) => {
                        var out = String.from_str(self->allocator, "(*");

                        if (var_->is_const) {
                            out.push_str("const ");
                        }

                        out.push_str(name.as_str_const());
                        out.push(')');

                        var decl = self->build_func_signature(
                            &lambda.ret_type,
                            &lambda.params,
                            out.as_str_const()
                        );

                        var expr = self->emit_lambda(&lambda);

                        self->body_out.push_str(decl.as_str_const());
                        self->body_out.push_str(" = ");
                        self->body_out.push_str(expr.as_str_const());
                        self->body_out.push_str(";\n");

                        expr.free();
                        decl.free();
                        out.free();
                        name.free();
                    }
                    else => {}
                }
            }
            else => {}
        }
    }

    fn emit_array_braces(self: Self*, array: const cir::ArrayExpr*) String {
        var out = String.from_str(self->allocator, "{ ");

        for (var i: usize = 0; i < array->elements.len(); i += 1) {
            const element = array->elements.get_const(i).unwrap();
            
            switch (element->kind) {
                case .Array(array2) => {
                    var braces = self->emit_array_braces(&array2);
                    out.push_str(braces.as_str_const());
                    braces.free();
                }
                else => {
                    var expr = self->emit_expr(element);
                    out.push_str(expr.as_str_const());
                    expr.free();
                }
            }

            out.push_str(", ");
        }

        out.push('}');
        return out;
    }

    fn emit_return(self: Self*, return_: const cir::ReturnStmt*) {
        self->emit_all_defers();

        if (self->in_void_main) {
            switch (return_->arg) {
                case .Some(arg) => {
                    var expr = self->emit_expr(&arg);
                    self->body_out.push_str(" return ");
                    self->body_out.push_str(expr.as_str_const());
                    self->body_out.push_str(";\n");
                    expr.free();
                }
                case .None => {
                    self->body_out.push_str(" return 0;\n");
                }
            }
            
            return;
        }

        switch (return_->arg) {
            case .Some(arg) => {
                var expr = self->emit_expr(&arg);
                self->body_out.push_str(" return ");
                self->body_out.push_str(expr.as_str_const());
                self->body_out.push_str(";\n");
                expr.free();
            }
            case .None => {
                self->body_out.push_str(" return;\n");
            }
        }
    }

    fn emit_if(self: Self*, if_: const cir::IfStmt*) {
        var cond = self->emit_expr(&if_->cond);
        
        self->body_out.push_str("    if (");
        self->body_out.push_str(cond.as_str_const());
        self->body_out.push_str(") { ");
        self->emit_block_stmts(if_->then_block, true);
        self->body_out.push_str(" } ");

        cond.free();

        for (var b: usize = 0; b < if_->branches.len(); b += 1) {
            const branch = if_->branches.get_const(b).unwrap();
            
            var cond = self->emit_expr(&branch->cond);
            
            self->body_out.push_str(" else if (");
            self->body_out.push_str(cond.as_str_const());
            self->body_out.push_str(") { ");
            
            self->emit_block_stmts(branch->then_block, true);
            self->body_out.push_str(" } ");

            cond.free();
        }

        switch (if_->else_block) {
            case .Some(else_block) => {
                self->body_out.push_str(" else { ");
                self->emit_block_stmts(else_block, true);
                self->body_out.push_str(" } ");
            }
            else => {}
        }
    }

    fn emit_while(self: Self*, while_: const cir::WhileStmt*) {
        var cond = self->emit_expr(&while_->cond);
        self->body_out.push_str(" while (");
        self->body_out.push_str(cond.as_str_const());
        self->body_out.push_str(") { ");
        cond.free();

        self->loop_marks.push(self->defer_scopes.len());
        self->emit_block_stmts(while_->body, true);
        self->loop_marks.pop();

        self->body_out.push_str(" } ");
    }

    fn emit_for(self: Self*, for_: const cir::ForStmt*) {
        self->body_out.push_str(" for (");

        switch (for_->initializer) {
            case .Some(var_) => {
                const ty = resolve_var_type(&var_).unwrap();

                self->types.ensure_named(&ty);

                var base_name = mangle::sanitized(self->allocator, var_.name.as_str_const());
                var loop_name = self->declare_fn_scope_name(base_name.as_str_const());

                if (loop_name.as_str_const() != base_name.as_str_const()) {
                    self->register_fn_rename(var_.var_decl_id, loop_name.as_str_const());
                }

                var decl = self->types.build_decl(&ty, loop_name.as_str_const());

                base_name.free();
                loop_name.free();
                
                if (var_.is_const) {
                    self->body_out.push_str("const ");
                }
                
                self->body_out.push_str(decl.as_str_const());
                decl.free();

                switch (var_.rhs) {
                    case .Some(rhs) => {
                        self->body_out.push_str(" = ");
                        var expr = self->emit_expr(&rhs);
                        self->body_out.push_str(expr.as_str_const());
                        expr.free();
                    }
                    else => {
                        if (!var_.is_undef) {
                            self->body_out.push_str(" = {0}");
                        }
                    }
                }
            }
            else => {}
        }

        self->body_out.push_str("; ");

        switch (for_->cond) {
            case .Some(cond) => {
                var expr = self->emit_expr(&cond);
                self->body_out.push_str(expr.as_str_const());
                expr.free();
            }
            else => {}
        }

        self->body_out.push_str("; ");

        switch (for_->increment) {
            case .Some(var_) => {
                var expr = self->emit_expr(&var_);
                self->body_out.push_str(expr.as_str_const());
                expr.free();
            }
            else => {}
        }

        self->body_out.push_str(") { ");

        self->loop_marks.push(self->defer_scopes.len());
        self->emit_block_stmts(for_->body, true);
        self->loop_marks.pop();

        self->body_out.push_str(" } ");
    }

    fn emit_switch(self: Self*, switch_: const cir::SwitchStmt*) {
        var enum_decl_id: cir::EnumDeclId;
        var is_scalar_enum = false;
        var is_enum = false;

        switch (switch_->operand.ty) {
            case .Some(ty) => {
                switch (ty.as_enum()) {
                    case .Some(id) => {
                        is_enum = true;
                        enum_decl_id = id;

                        switch (self->tables->enums.get_const(enum_decl_id)) {
                            case .Some(decl) => {
                                is_scalar_enum = is_enum_scalar_optimizable(self->tables, decl);
                            }
                            else => {}
                        }
                    }
                    else => {}
                }
            }
            else => {}
        }

        if (is_enum && is_scalar_enum) {
            self->emit_switch_scalar_enum(switch_, enum_decl_id);
            return;
        }

        if (is_enum) {
            self->emit_switch_payload_enum(switch_, enum_decl_id);
            return;
        }

        if (!switch_->includes_any_range()) {
            switch (switch_->operand.ty) {
                case .Some(ty) => {
                    if (ty.is_integer()) {
                        self->emit_switch_integer(switch_);
                        return;
                    }
                }
                else => {
                    self->emit_switch_integer(switch_);
                    return;
                }
            }
        }

        self->emit_switch_if_chain(switch_);
    }

    fn emit_switch_scalar_enum(
        self: Self*, 
        switch_: const cir::SwitchStmt*, 
        enum_decl_id: cir::EnumDeclId
    ) {
        var name: String;

        switch (switch_->operand.ty) {
            case .Some(ty) => {
                name = self->types.enum_c_name_for_ty(&ty);
            }
            else => {
                name = self->types.enum_c_name(enum_decl_id);
            }
        }

        var operand = self->emit_expr(&switch_->operand);
        self->body_out.push_str(" switch (");
        self->body_out.push_str(operand.as_str_const());
        self->body_out.push_str(") { ");
        operand.free();

        for (var if_: usize = 0; if_ < switch_->cases.len(); if_ += 1) {
            const case_ = switch_->cases.get_const(if_).unwrap();

            var has_default_label = false;
            var binding_name: const uint8*;
            var tuple_decls = String.new(self->allocator);

            for (var j: usize = 0; j < case_->patterns.len(); j += 1) {
                const pattern = case_->patterns.get_const(j).unwrap();
                
                switch (pattern->kind) {
                    case .Wildcard => {
                        if (!has_default_label) {
                            self->body_out.push_str(" default:");
                            has_default_label = true;
                        }
                    }

                    case .EnumUnit(ident) => {
                        self->body_out.push_str(" case ");
                        self->body_out.push_str(name.as_str_const());
                        self->body_out.push('_');
                        self->body_out.push_str(ident.str.as_str_const());
                        self->body_out.push(':');
                    }

                    case .EnumTupleVariant { ident, items } => {
                        self->body_out.push_str(" case ");
                        self->body_out.push_str(name.as_str_const());
                        self->body_out.push('_');
                        self->body_out.push_str(ident.str.as_str_const());
                        self->body_out.push(':');

                        for (var k: usize = 0; k < items.len(); k += 1) {
                            const item = items.get_const(k).unwrap();

                            switch (item->kind) {
                                case .Binding { name: item_binding, .. } => {
                                    switch (switch_->operand.ty) {
                                        case .Some(ty) => {
                                            var type_name = self->types.type_name(&ty);

                                            tuple_decls.push(' ');
                                            tuple_decls.push_str(type_name.as_str_const());
                                            tuple_decls.push(' ');
                                            mangle::sanitize_into(&tuple_decls, item_binding.str.as_str_const());
                                            tuple_decls.push_str(" = ");
                                            tuple_decls.push_str(name.as_str_const());
                                            tuple_decls.push('_');
                                            tuple_decls.push_str(ident.str.as_str_const());
                                            tuple_decls.push_str(";\n");
                                            type_name.free();
                                        }
                                        else => {}
                                    }
                                }
                                else => {}
                            }
                        }
                    }

                    case .Binding { name: binding_ident, .. } => {
                        if (!has_default_label) {
                            self->body_out.push_str(" default:");
                            has_default_label = true;
                        }

                        binding_name = binding_ident.str.as_str_const();
                    }

                    case .Expr(expr) => {
                        switch (expr.literal_const_int_value()) {
                            case .Some(literal) => {
                                self->body_out.push_str(" case ");

                                switch (literal) {
                                    case .Signed(x) => push_int128(&self->body_out, x);
                                    case .Unsigned(x) => push_uint128(&self->body_out, x);
                                }
                                
                                self->body_out.push(':');
                            }
                            case .None => {
                                if (!has_default_label) {
                                    self->body_out.push_str(" default:");
                                    has_default_label = true;
                                }
                            }
                        }
                    }

                    else => {
                        if (!has_default_label) {
                            self->body_out.push_str(" default:");
                            has_default_label = true;
                        }
                    }
                }
            }

            self->body_out.push_str(" { ");

            if (binding_name != null) {
                switch (switch_->operand.ty) {
                    case .Some(ty) => {
                        var type_name = self->types.type_name(&ty);

                        self->body_out.push(' ');
                        self->body_out.push_str(type_name.as_str_const());
                        self->body_out.push(' ');
                        mangle::sanitize_into(&self->body_out, binding_name);
                        self->body_out.push_str(" = ");
                        
                        var expr = self->emit_expr(&switch_->operand);
                        self->body_out.push_str(expr.as_str_const());
                        expr.free();

                        self->body_out.push_str(";\n");
                        type_name.free();
                    }
                    else => {}
                }
            }

            self->body_out.push_str(tuple_decls.as_str_const());
            tuple_decls.free();

            self->emit_block_stmts(case_->body, true);
            self->body_out.push_str(" } break;\n");
        }

        switch (switch_->else_case) {
            case .Some(else_case) => {
                self->body_out.push_str(" default: { ");
                self->emit_block_stmts(&else_case, true);
                self->body_out.push_str(" } break;\n");
            }
            else => {
                self->body_out.push_str(" default: break;\n");
            }
        }

        self->body_out.push_str(" } ");
        name.free();
    }

    fn hoist_switch_binding(
        self: Self*,
        var_decl_id: cir::VarDeclId,
        binding_name: const ast::ASTIdent*,
        ty: const cir::SemaType*
    ) {
        if (self->switch_binding_names.contains_key(var_decl_id)) {
            return;
        }

        self->types.ensure_named(ty);

        var c_name = mangle::sanitized(self->allocator, binding_name->str.as_str_const());

        var suffix: usize = 1;

        while (self->switch_binding_name_taken(c_name.as_str_const())) {
            var unique = String.from_str(self->allocator, binding_name->str.as_str_const());
            unique.push_str("__");
            push_usize(&unique, suffix);

            c_name.free();
            c_name = mangle::sanitized(self->allocator, unique.as_str_const());
            
            unique.free();
            suffix += 1;
        }

        var type_name = self->types.type_name(ty);

        self->body_out.push(' ');
        self->body_out.push_str(type_name.as_str_const());
        self->body_out.push(' ');
        self->body_out.push_str(c_name.as_str_const());
        self->body_out.push_str(" = {0};\n");
        type_name.free();

        self->switch_binding_owned.push(c_name);
        self->switch_binding_names.insert(var_decl_id, c_name);

        // Keep locals declared after this switch 
        // clear of the binding name
        var scoped = String.from_str(self->allocator, c_name.as_str_const());
        self->fn_scope_names.push(scoped);
    }

    fn switch_binding_name_taken(self: Self*, candidate: const uint8*) bool {
        for (var i: usize = 0; i < self->switch_binding_owned.len(); i += 1) {
            const existing = self->switch_binding_owned.get_const(i).unwrap();

            if (existing->as_str_const() == candidate) {
                return true;
            }
        }

        return self->fn_name_taken(candidate);
    }

    fn hoist_switch_pattern_bindings(
        self: Self*,
        pattern: const cir::SwitchCasePattern*,
        enum_decl: const cir::EnumDecl*,
        tags: const Vec<uint32>*,
        inst_args: const cir::TypeArgs*,
        operand_type: const cir::SemaType*
    ) {
        switch (pattern->kind) {
            case .Binding { name, var_decl_id } => {
                self->hoist_switch_binding(var_decl_id, &name, operand_type);
            }

            case .EnumTupleVariant { ident, items } => {
                switch (enum_decl->lookup_variant(ident.str.as_str_const())) {
                    case .Some(variant) => {
                        switch (*variant) {
                            case .Tuple { fields, .. } => {
                                for (var k: usize = 0; k < items.len(); k += 1) {
                                    const item = items.get_const(k).unwrap();

                                    switch (item->kind) {
                                        case .Binding { name, var_decl_id } => {
                                            if (k < fields.len()) {
                                                const field = fields.get_const(k).unwrap();
                                                
                                                var field_type: cir::SemaType = field->ty;

                                                if (inst_args != null) {
                                                    field_type = cir::substitute_sema_type_with_type_args(
                                                        self->allocator,
                                                        &field->ty,
                                                        &enum_decl->generic_params,
                                                        inst_args
                                                    );
                                                }

                                                self->hoist_switch_binding(var_decl_id, &name, &field_type);
                                            }
                                        }
                                        else => {}
                                    }
                                }
                            }

                            case .Valued { value, .. } => {
                                for (var k: usize = 0; k < items.len(); k += 1) {
                                    const item = items.get_const(k).unwrap();

                                    switch (item->kind) {
                                        case .Binding { name, var_decl_id } => {
                                            switch (value->ty) {
                                                case .Some(value_ty) => {
                                                    self->hoist_switch_binding(var_decl_id, &name, &value_ty);
                                                }
                                                else => {}
                                            }
                                        }
                                        else => {}
                                    }
                                }
                            }
                            else => {}
                        }
                    }
                    else => {}
                }
            }

            case .EnumStructVariant { ident, items, .. } => {
                switch (enum_decl->lookup_variant(ident.str.as_str_const())) {
                    case .Some(variant) => {
                        switch (*variant) {
                            case .Struct { fields, .. } => {
                                for (var k: usize = 0; k < items.len(); k += 1) {
                                    const item = items.get_const(k).unwrap();

                                    switch (item->pattern.kind) {
                                        case .Binding { name, var_decl_id } => {
                                            for (var f: usize = 0; f < fields.len(); f += 1) {
                                                const field = fields.get_const(f).unwrap();

                                                if (field->name.str.as_str_const() == item->name.str.as_str_const()) {
                                                    var field_type: cir::SemaType = field->ty;

                                                    if (inst_args != null) {
                                                        field_type = cir::substitute_sema_type_with_type_args(
                                                            self->allocator,
                                                            &field->ty,
                                                            &enum_decl->generic_params,
                                                            inst_args
                                                        );
                                                    }

                                                    self->hoist_switch_binding(var_decl_id, &name, &field_type);
                                                    break;
                                                }
                                            }
                                        }
                                        else => {}
                                    }
                                }
                            }
                            else => {}
                        }
                    }
                    else => {}
                }
            }
            else => {}
        }
    }

    fn emit_switch_payload_enum(
        self: Self*, 
        switch_: const cir::SwitchStmt*, 
        enum_decl_id: cir::EnumDeclId
    ) {
        const enum_decl = self->tables->enums.get_const(enum_decl_id).unwrap();
        const tags = self->types.tctx.enum_variant_tags(enum_decl_id, enum_decl);

        var operand_name: String;

        var has_operand_type = false;
        var inst_args_storage: cir::TypeArgs;
        var has_inst_args = false;

        switch (switch_->operand.ty) {
            case .Some(ty) => {
                operand_name = self->types.enum_c_name_for_ty(&ty);
                has_operand_type = true;

                switch (*ty.const_inner()) {
                    case .Named(named) => {
                        if (!named.type_args.is_empty()) {
                            inst_args_storage = clone::clone_typed_type_args(
                                self->allocator, 
                                &named.type_args
                            );
                            has_inst_args = true;
                        }
                    }
                    else => {}
                }
            }
            else => {}
        }

        if (!has_operand_type) {
            operand_name = self->types.enum_c_name(enum_decl_id);
        }

        var inst_args: const cir::TypeArgs* = null;

        if (has_inst_args) {
            inst_args = &inst_args_storage;
        }

        var has_operand_ty = false;
        var operand_type: cir::SemaType = .Plain(.Void);

        switch (switch_->operand.ty) {
            case .Some(ty) => {
                operand_type = ty;
                has_operand_ty = true;
            }
            else => {}
        }

        if (has_operand_ty) {
            for (var i: usize = 0; i < switch_->cases.len(); i += 1) {
                const case_ = switch_->cases.get_const(i).unwrap();

                for (var j: usize = 0; j < case_->patterns.len(); j += 1) {
                    const pattern = case_->patterns.get_const(j).unwrap();
                    
                    self->hoist_switch_pattern_bindings(
                        pattern,
                        enum_decl,
                        tags,
                        inst_args,
                        &operand_type
                    );
                }
            }
        }

        var operand = self->emit_expr(&switch_->operand);

        self->body_out.push_str(" { ");
        self->body_out.push_str(operand_name.as_str_const());
        self->body_out.push_str(" __sw_op = ");
        self->body_out.push_str(operand.as_str_const());
        self->body_out.push_str(";\n");
        operand.free();

        var first = true;

        for (var i: usize = 0; i < switch_->cases.len(); i += 1) {
            const case_ = switch_->cases.get_const(i).unwrap();

            for (var j: usize = 0; j < case_->patterns.len(); j += 1) {
                const pattern = case_->patterns.get_const(j).unwrap();

                switch (pattern->kind) {
                    case .Wildcard => {
                        self->body_out.push_str(" else { ");
                        self->emit_block_stmts(case_->body, true);
                        self->body_out.push_str(" } ");
                        j = case_->patterns.len();
                        continue;
                    }
                    case .EnumUnit(ident) => {
                        const tag = enum_decl->find_variant_tag(tags, ident.str.as_str_const());

                        if (first) {
                            self->body_out.push_str(" if (__sw_op.tag == ");
                            first = false;
                        } else {
                            self->body_out.push_str(" else if (__sw_op.tag == ");
                        }
                        
                        push_uint32(&self->body_out, tag);
                        self->body_out.push_str(") { ");
                        self->emit_block_stmts(case_->body, true);
                        self->body_out.push_str(" } ");
                    }
                    case .EnumTupleVariant { ident, items } => {
                        const tag = enum_decl->find_variant_tag(tags, ident.str.as_str_const());

                        if (first) {
                            self->body_out.push_str(" if (__sw_op.tag == ");
                            first = false;
                        } else {
                            self->body_out.push_str(" else if (__sw_op.tag == ");
                        }
                        
                        push_uint32(&self->body_out, tag);
                        self->body_out.push_str(") { ");

                        switch (enum_decl->lookup_variant(ident.str.as_str_const())) {
                            case .Some(variant) => {
                                switch (*variant) {
                                    case .Tuple { fields, .. } => {
                                        for (var k: usize = 0; k < items.len(); k += 1) {
                                            const item = items.get_const(k).unwrap();
                                            
                                            switch (item->kind) {
                                                case .Binding { var_decl_id, .. } => {
                                                    if (k < fields.len()) {
                                                        switch (self->switch_binding_names.get(var_decl_id)) {
                                                            case .Some(c_name) => {
                                                                self->body_out.push(' ');
                                                                self->body_out.push_str(c_name->as_str_const());
                                                                self->body_out.push_str(" = __sw_op.u.v");
                                                                push_uint32(&self->body_out, tag);
                                                                self->body_out.push('.');

                                                                var field_name = self->tuple_field_name(k);
                                                                self->body_out.push_str(field_name.as_str_const());
                                                                self->body_out.push_str(";\n");
                                                                field_name.free();
                                                            }
                                                            else => {}
                                                        }
                                                    }
                                                }
                                                else => {}
                                            }
                                        }
                                    }
                                    case .Valued { .. } => {
                                        for (var k: usize = 0; k < items.len(); k += 1) {
                                            const item = items.get_const(k).unwrap();

                                            switch (item->kind) {
                                                case .Binding { var_decl_id, .. } => {
                                                    switch (self->switch_binding_names.get(var_decl_id)) {
                                                        case .Some(c_name) => {
                                                            self->body_out.push(' ');
                                                            self->body_out.push_str(c_name->as_str_const());
                                                            self->body_out.push_str(" = __sw_op.u.v");
                                                            push_uint32(&self->body_out, tag);
                                                            self->body_out.push_str(".value;\n");
                                                        }
                                                        else => {}
                                                    }
                                                }
                                                else => {}
                                            }
                                        }
                                    }
                                    else => {}
                                }
                            }
                            else => {}
                        }

                        self->emit_block_stmts(case_->body, true);
                        self->body_out.push_str(" } ");
                    }
                    case .EnumStructVariant { ident, items, .. } => {
                        const tag = enum_decl->find_variant_tag(tags, ident.str.as_str_const());

                        if (first) {
                            self->body_out.push_str(" if (__sw_op.tag == ");
                            first = false;
                        } else {
                            self->body_out.push_str(" else if (__sw_op.tag == ");
                        }

                        push_uint32(&self->body_out, tag);
                        self->body_out.push_str(") { ");

                        switch (enum_decl->lookup_variant(ident.str.as_str_const())) {
                            case .Some(variant) => {
                                switch (*variant) {
                                    case .Struct { fields, .. } => {
                                        for (var k: usize = 0; k < items.len(); k += 1) {
                                            const item = items.get_const(k).unwrap();

                                            switch (item->pattern.kind) {
                                                case .Binding { var_decl_id, .. } => {
                                                    for (var f: usize = 0; f < fields.len(); f += 1) {
                                                        const field = fields.get_const(f).unwrap();

                                                        if (field->name.str.as_str_const() == item->name.str.as_str_const()) {
                                                            switch (self->switch_binding_names.get(var_decl_id)) {
                                                                case .Some(c_name) => {
                                                                    self->body_out.push(' ');
                                                                    self->body_out.push_str(c_name->as_str_const());
                                                                    self->body_out.push_str(" = __sw_op.u.v");
                                                                    push_uint32(&self->body_out, tag);
                                                                    self->body_out.push('.');
                                                                    mangle::sanitize_into(
                                                                        &self->body_out,
                                                                        item->name.str.as_str_const()
                                                                    );
                                                                    self->body_out.push_str(";\n");
                                                                }
                                                                else => {}
                                                            }
                                                            break;
                                                        }
                                                    }
                                                }
                                                else => {}
                                            }
                                        }
                                    }
                                    else => {}
                                }
                            }
                            else => {}
                        }

                        self->emit_block_stmts(case_->body, true);
                        self->body_out.push_str(" } ");
                    }
                    case .Binding { var_decl_id, .. } => {
                        if (first) {
                            self->body_out.push_str(" if (1) { ");
                            first = false;
                        } else {
                            self->body_out.push_str(" else if (1) { ");
                        }

                        switch (self->switch_binding_names.get(var_decl_id)) {
                            case .Some(c_name) => {
                                self->body_out.push(' ');
                                self->body_out.push_str(c_name->as_str_const());
                                self->body_out.push_str(" = __sw_op;\n");
                            }
                            else => {}
                        }

                        self->emit_block_stmts(case_->body, true);
                        self->body_out.push_str(" } ");
                    }
                    else => {
                        if (first) {
                            self->body_out.push_str(" if (0) { ");
                            first = false;
                        } else {
                            self->body_out.push_str(" else if (0) { ");
                        }
                        self->emit_block_stmts(case_->body, true);
                        self->body_out.push_str(" } ");
                    }
                }
            }
        }

        switch (switch_->else_case) {
            case .Some(else_case) => {
                self->body_out.push_str(" else { ");
                self->emit_block_stmts(&else_case, true);
                self->body_out.push_str(" } ");
            }
            else => {}
        }

        self->body_out.push_str(" } ");
        operand_name.free();

        if (has_inst_args) {
            inst_args_storage.free();
        }
    }

    fn emit_switch_integer(self: Self*, switch_: const cir::SwitchStmt*) {
        var operand = self->emit_expr(&switch_->operand);
        self->body_out.push_str(" switch (");
        self->body_out.push_str(operand.as_str_const());
        self->body_out.push_str(") { ");
        operand.free();

        for (var i: usize = 0; i < switch_->cases.len(); i += 1) {
            const case_ = switch_->cases.get_const(i).unwrap();

            var has_default_label = false;
            var binding_name: const uint8*;

            for (var j: usize = 0; j < case_->patterns.len(); j += 1) {
                const pattern = case_->patterns.get_const(j).unwrap();

                switch (pattern->kind) {
                    case .Wildcard => {
                        if (!has_default_label) {
                            self->body_out.push_str(" default:");
                            has_default_label = true;
                        }
                    }

                    case .Binding { name, .. } => {
                        if (!has_default_label) {
                            self->body_out.push_str(" default:");
                            has_default_label = true;
                        }
                        binding_name = name.str.as_str_const();
                    }

                    case .Expr(expr) => {
                        switch (expr.literal_const_int_value()) {
                            case .Some(literal) => {
                                self->body_out.push_str(" case ");

                                switch (literal) {
                                    case .Signed(x) => {
                                        push_int128(&self->body_out, x);
                                    }
                                    case .Unsigned(x) => {
                                        push_uint128(&self->body_out, x);
                                    }
                                }
                                
                                self->body_out.push(':');
                            }
                            case .None => {
                                if (!has_default_label) {
                                    self->body_out.push_str(" default:");
                                    has_default_label = true;
                                }
                            }
                        }
                    }

                    case .Range => {
                        @panic("range pattern must be lowered into chained if-else statement");
                    }
                    
                    else => {
                        if (!has_default_label) {
                            self->body_out.push_str(" default:");
                            has_default_label = true;
                        }
                    }
                }
            }

            self->body_out.push_str(" { ");

            if (binding_name != null) {
                switch (switch_->operand.ty) {
                    case .Some(operand_type) => {
                        var type_name = self->types.type_name(&operand_type);

                        self->body_out.push_str(type_name.as_str_const());
                        self->body_out.push(' ');
                        mangle::sanitize_into(&self->body_out, binding_name);
                        self->body_out.push_str(" = ");
                        
                        var expr = self->emit_expr(&switch_->operand);
                        self->body_out.push_str(expr.as_str_const());
                        expr.free();
                        
                        self->body_out.push_str(";\n");
                        type_name.free();
                    }
                    case .None => {}
                }
            }

            self->emit_block_stmts(case_->body, true);
            self->body_out.push_str(" } break;\n");
        }

        switch (switch_->else_case) {
            case .Some(else_case) => {
                self->body_out.push_str(" default: { ");
                self->emit_block_stmts(&else_case, true);
                self->body_out.push_str(" } break;\n");
            }
            else => {
                self->body_out.push_str(" default: break;\n");
            }
        }

        self->body_out.push_str(" } ");
    }

    fn emit_switch_if_chain(self: Self*, switch_: const cir::SwitchStmt*) {
        var operand_type_name: String;
        var operand = self->emit_expr(&switch_->operand);

        var operand_is_byte_string = false;
        var operand_is_pointer = false;

        switch (switch_->operand.ty) {
            case .Some(ty) => {
                operand_is_byte_string = self->is_byte_pointer(&ty);

                switch (*ty.const_inner()) {
                    case .Pointer => operand_is_pointer = true;
                    else => {}
                }
            }
            else => {}
        }

        self->body_out.push_str(" {  ");

        switch (switch_->operand.ty) {
            case .Some(ty) => {
                self->types.ensure_named(&ty);
                operand_type_name = self->types.type_name(&ty);
            }
            else => {
                operand_type_name = String.from_str(self->allocator, "int64_t");
            }
        }

        self->body_out.push_str(operand_type_name.as_str_const());
        self->body_out.push_str(" __sw_op = ");

        if (operand_is_pointer) {
            self->body_out.push('(');
            self->body_out.push_str(operand_type_name.as_str_const());
            self->body_out.push(')');
        }

        self->body_out.push_str(operand.as_str_const());
        self->body_out.push_str(";\n");
        operand.free();

        var first = true;

        for (var i: usize = 0; i < switch_->cases.len(); i += 1) {
            const case_ = switch_->cases.get_const(i).unwrap();

            for (var j: usize = 0; j < case_->patterns.len(); j += 1) {
                const pattern = case_->patterns.get_const(j).unwrap();

                switch (pattern->kind) {
                    case .Wildcard => {
                        self->body_out.push_str(" else { ");
                        self->emit_block_stmts(case_->body, true);
                        self->body_out.push_str(" } ");
                        j = case_->patterns.len();
                        continue;
                    }
                    case .Range(range) => {
                        if (first) {
                            self->body_out.push_str("    if (");
                            first = false;
                        } else {
                            self->body_out.push_str("    else if (");
                        }

                        var lo = self->emit_expr(&range.lower);
                        var hi = self->emit_expr(&range.upper);
                        
                        self->body_out.push_str("__sw_op >= ");
                        self->body_out.push_str(lo.as_str_const());
                        self->body_out.push_str(" && __sw_op ");
                        
                        if (range.inclusive_upper) {
                            self->body_out.push_str("<=");
                        } else {
                            self->body_out.push('<');
                        }
                        
                        self->body_out.push(' ');
                        self->body_out.push_str(hi.as_str_const());
                        self->body_out.push_str(") { ");
                        self->emit_block_stmts(case_->body, true);
                        self->body_out.push_str(" } ");
                        
                        lo.free();
                        hi.free();
                    }
                    case .Expr(expr) => {
                        if (first) {
                            self->body_out.push_str(" if (");
                            first = false;
                        } else {
                            self->body_out.push_str(" else if (");
                        }
                        
                        var value = self->emit_expr(&expr);

                        if (operand_is_byte_string) {
                            self->ensure_strcmp_proto();
                            self->body_out.push_str("strcmp((const char *)__sw_op, (const char *)(");
                            self->body_out.push_str(value.as_str_const());
                            self->body_out.push_str(")) == 0");
                        } else {
                            self->body_out.push_str("__sw_op == ");
                            self->body_out.push_str(value.as_str_const());
                        }

                        self->body_out.push_str(") { ");
                        self->emit_block_stmts(case_->body, true);
                        self->body_out.push_str("} ");

                        value.free();
                    }
                    case .Binding { name, .. } => {
                        if (!first) {
                            self->body_out.push_str("else ");
                        }

                        first = false;
                        self->body_out.push_str("{");
                        self->body_out.push_str(operand_type_name.as_str_const());
                        self->body_out.push(' ');
                        mangle::sanitize_into(&self->body_out, name.str.as_str_const());
                        self->body_out.push_str(" = __sw_op;\n");
                        self->emit_block_stmts(case_->body, true);
                        self->body_out.push_str("} ");
                    }
                    case .EnumUnit(ident) => {
                        if (first) {
                            self->body_out.push_str(" if (");
                            first = false;
                        } else {
                            self->body_out.push_str(" else if (");
                        }
                        self->body_out.push_str("__sw_op == ");
                        self->body_out.push_str(ident.str.as_str_const());
                        self->body_out.push_str(") { ");
                        self->emit_block_stmts(case_->body, true);
                        self->body_out.push_str(" } ");
                    }
                    else => {
                        if (!first) {
                            self->body_out.push_str("else ");
                        }

                        first = false;
                        self->body_out.push_str("{ ");
                        self->emit_block_stmts(case_->body, true);
                        self->body_out.push_str(" } ");
                    }
                }
            }
        }

        switch (switch_->else_case) {
            case .Some(else_case) => {
                self->body_out.push_str(" else { ");
                self->emit_block_stmts(&else_case, true);
                self->body_out.push_str(" } ");
            }
            else => {}
        }

        self->body_out.push_str(" } ");
        operand_type_name.free();
    }

    fn emit_inline_asm_stmt(self: Self*, inline_asm: const cir::InlineAsm) {
        var text = self->emit_inline_asm(inline_asm);
        self->body_out.push_str(text.as_str_const());
        self->body_out.push_str(";\n");
        text.free();
    }

    fn emit_inline_asm(self: Self*, inline_asm: const cir::InlineAsm) String {
        var out = String.from_str(self->allocator, " __asm__ ");

        if (inline_asm.is_volatile) {
            out.push_str("__volatile__(");
        } else {
            out.push('(');
        }

        for (var i: usize = 0; i < inline_asm.template.len(); i += 1) {
            const line = inline_asm.template.get_const(i).unwrap();
            const raw = line->as_str_const();

            out.push('"');
            self->push_asm_escaped(&out, raw);

            if (!asm_raw_ends_with_newline(raw)) {
                out.push('\\');
                out.push('n');
            }

            out.push('"');
            
            if (i + 1 < inline_asm.template.len()) {
                out.push(' ');
            }
        }

        if (inline_asm.outputs.len() > 0 ||
            inline_asm.inputs.len() > 0 ||
            inline_asm.clobbers.len() > 0)
        {
            out.push_str(" : ");
            self->emit_asm_operands(&out, &inline_asm.outputs);
            out.push_str(" : ");
            self->emit_asm_operands(&out, &inline_asm.inputs);

            if (inline_asm.clobbers.len() > 0) {
                out.push_str(" : ");

                for (var i: usize = 0; i < inline_asm.clobbers.len(); i += 1) {
                    const clobber = inline_asm.clobbers.get_const(i).unwrap();
                    
                    out.push('"');
                    out.push_str(clobber->name.as_str_const());
                    out.push('"');
                    
                    if (i + 1 < inline_asm.clobbers.len()) {
                        out.push_str(", ");
                    }
                }
            }
        }

        out.push(')');
        return out;
    }

    fn emit_asm_operands(self: Self*, out: String*, operands: const Vec<cir::AsmOperand>*) {
        for (var i: usize = 0; i < operands->len(); i += 1) {
            const operand = operands->get_const(i).unwrap();
            
            out->push_str("\"");
            out->push_str(operand->constraint.as_str_const());
            out->push_str("\"(");

            var expr = self->emit_expr(operand->expr);
            out->push_str(expr.as_str_const());
            expr.free();

            out->push(')');

            if (i + 1 < operands->len()) {
                out->push_str(", ");
            }
        }
    }

    // FIXME: Helper method!
    fn push_asm_escaped(self: Self*, out: String*, raw: const uint8*) {
        var i: usize = 0;

        while (raw[i] != '\0') {
            const ch = raw[i];

            if (ch == '\n') {
                out->push('\\');
                out->push('n');
            } else if (ch == '\t') {
                out->push('\\');
                out->push('t');
            } else if (ch == '"') {
                out->push('\\');
                out->push('"');
            } else if (ch == '\\') {
                out->push('\\');
                out->push('\\');
            } else {
                out->push(ch);
            }

            i += 1;
        }
    }

    /* ************* Expressions ************* */

    fn emit_expr(self: Self*, expr: const cir::Expr*) String {
        switch (expr->kind) {
            case .Prefix(prefix) => {
                var out = String.new(self->allocator);
                var operand = self->emit_expr(prefix.operand);

                switch (self->expr_int128_kind(prefix.operand)) {
                    case .Some(unsigned_domain) => {
                        var a = self->coerce_to_int128(
                            prefix.operand,
                            operand.as_str_const(),
                            unsigned_domain
                        );

                        var prefix_name = "__cyrus_u128";

                        if (!unsigned_domain) {
                            prefix_name = "__cyrus_i128";
                        }

                        var fn_text = String.new(self->allocator);
                        fn_text.push_str(prefix_name);
                        fn_text.push('_');

                        var is_bang = false;

                        switch (prefix.op) {
                            case .BitwiseNot => fn_text.push_str("bnot");
                            case .Minus => fn_text.push_str("neg");
                            case .Bang => {
                                fn_text.push_str("iszero");
                                is_bang = true;
                            }
                        }

                        if (is_bang) {
                            out.push_str("(!");
                            out.push_str(fn_text.as_str_const());
                            out.push('(');
                            out.push_str(a.as_str_const());
                            out.push_str("))");
                        } else {
                            out.push('(');
                            out.push_str(fn_text.as_str_const());
                            out.push('(');
                            out.push_str(a.as_str_const());
                            out.push_str("))");
                        }

                        fn_text.free();
                        a.free();
                        operand.free();
                        return out;
                    }
                    else => {}
                }

                switch (prefix.op) {
                    case .Bang => {
                        out.push_str("(!");
                        out.push_str(operand.as_str_const());
                        out.push(')');
                    }
                    case .Minus => {
                        out.push_str("(-");
                        out.push_str(operand.as_str_const());
                        out.push(')');
                    }
                    case .BitwiseNot => {
                        out.push_str("(~");
                        out.push_str(operand.as_str_const());
                        out.push(')');
                    }
                }

                operand.free();
                return out;
            }

            case .AddrOf(addr) => {
                var out = String.from_str(self->allocator, "(&");
                var expr = self->emit_expr(addr.operand);
                out.push_str(expr.as_str_const());
                expr.free();
                out.push(')');
                return out;
            }

            case .Deref(deref) => {
                var out = String.from_str(self->allocator, "(*");
                var expr = self->emit_expr(deref.operand);
                out.push_str(expr.as_str_const());
                expr.free();
                out.push(')');
                return out;
            }

            case .ArrayIndex(array_index) => {
                var out = String.new(self->allocator);
                var base = self->emit_expr(array_index.operand);
                var idx = self->emit_expr(array_index.index);

                out.push('(');
                out.push_str(base.as_str_const());
                out.push('[');
                out.push_str(idx.as_str_const());
                out.push_str("])");
                base.free();
                idx.free();
                
                return out;
            }

            case .FieldAccess(field_access) => {
                var out = String.new(self->allocator);
                var base = self->emit_expr(field_access.operand);

                if (field_access.is_thin_arrow) {
                    out.push_str("((");
                    out.push_str(base.as_str_const());
                    out.push_str(")->");
                } else {
                    out.push('(');
                    out.push_str(base.as_str_const());
                    out.push('.');
                }

                mangle::sanitize_into(&out, field_access.name.as_str_const());
                out.push(')');
                base.free();
                return out;
            }

            case .UnionInit(union_init) => {
                var type_name = self->type_name_of(&union_init.operand);
                var out = String.from_str(self->allocator, "((");

                out.push_str(type_name.as_str_const());
                out.push_str("){ .");
                mangle::sanitize_into(&out, union_init.field->name.as_str_const());
                out.push_str(" = ");
                
                var expr = self->emit_expr(&union_init.field->value);
                out.push_str(expr.as_str_const());
                expr.free();

                out.push_str(" })");
                type_name.free();
                
                return out;
            }

            case .Array(array) => {
                var type_name: String;

                switch (array.ty) {
                    case .Some(ty) => {
                        self->types.ensure_named(&ty);
                        type_name = self->types.type_name(&ty);
                    }
                    case .None => {
                        type_name = String.from_str(self->allocator, "void *");
                    }
                }

                var out = String.from_str(self->allocator, "((");
                
                out.push_str(type_name.as_str_const());
                out.push_str("){ ");
                
                for (var i: usize = 0; i < array.elements.len(); i += 1) {
                    const element_type = array.elements.get_const(i).unwrap();

                    switch (element_type->kind) {
                        case .Array(array2) => {
                            var braces = self->emit_array_braces(&array2);
                            out.push_str(braces.as_str_const());
                            braces.free();
                        }
                        else => {
                            var expr = self->emit_expr(element_type);
                            out.push_str(expr.as_str_const());
                            expr.free();
                        }
                    }
                    
                    out.push_str(", ");
                }

                out.push_str(" })");
                type_name.free();
                
                return out;
            }

            case .Tuple(tupple) => {
                var type_name: String;

                switch (expr->ty) {
                    case .Some(ty) => {
                        self->types.ensure_named(&ty);
                        type_name = self->types.type_name(&ty);
                    }
                    case .None => type_name = String.from_str(self->allocator, "void");
                }

                var out = String.from_str(self->allocator, "((");
                out.push_str(type_name.as_str_const());
                out.push_str("){ ");

                for (var i: usize = 0; i < tupple.elements.len(); i += 1) {
                    const element = tupple.elements.get_const(i).unwrap();
                    
                    var expr = self->emit_expr(element);
                    out.push_str(expr.as_str_const());
                    expr.free();
                    
                    out.push_str(", ");
                }

                out.push_str(" })");
                type_name.free();
                
                return out;
            }

            case .TupleAccess(tuple_access) => {
                var out = String.new(self->allocator);
                var base = self->emit_expr(tuple_access.operand);

                out.push('(');
                out.push_str(base.as_str_const());
                out.push_str(").f");
                push_usize(&out, tuple_access.index);
                base.free();
                
                return out;
            }

            case .Builtin(builtin) => {
                switch (builtin) {
                    case .BuiltinFunc(builtin_func) => {
                        return self->emit_builtin_func(&builtin_func);
                    }
                    case .BuiltinBlock => {
                        return String.from_str(self->allocator, "((void)0)");
                    }
                }
            }

            case .MethodCall(method_call) => return self->emit_method_call(&method_call);

            case .EnumInit(enum_init) => return self->emit_enum_init(&enum_init);

            case .StructInit(struct_init) => return self->emit_struct_init(&struct_init);
            
            case .FuncCall(func_call) => return self->emit_func_call(&func_call);

            case .Dynamic(dynamic_) => return self->emit_dynamic(&dynamic_);
            
            case .Literal(literal) => return self->emit_literal(&literal);
            
            case .Assign(assign) => return self->emit_assign(&assign);
            
            case .Lambda(lambda) => return self->emit_lambda(&lambda);

            case .Symbol(symbol) => return self->emit_symbol(&symbol);

            case .Infix(infix) => return self->emit_infix(&infix);

            case .EnumStructVariantInit => {
                panic_unlowered(self, expr, "EnumStructVariantInit");
                @unreachable();
            }
            
            case .UnnamedUnionValue => {
                panic_unlowered(self, expr, "UnnamedUnionValue");
                @unreachable();
            }
            
            case .UnnamedStructValue => {
                panic_unlowered(self, expr, "UnnamedStructValue");
                @unreachable();
            }
            
            case .UnnamedEnumValue => {
                panic_unlowered(self, expr, "UnnamedEnumValue");
                @unreachable();
            }

            case .SemaType 
            | .Poisoned => {
                return String.from_str(self->allocator, "((void)0)");
            }

            case .InlineAsm(asm) => {
                return self->emit_inline_asm(asm);
            }
        }
    }

    fn emit_infix(self: Self*, infix: const cir::InfixExpr*) String {
        switch (infix->op) {
            case .Equal | .NotEqual => {
                if (self->is_byte_string_compare(infix)) {
                    return self->emit_strcmp_compare(infix);
                }
            }
            else => {}
        }

        var lhs = self->emit_expr(infix->lhs);
        var rhs = self->emit_expr(infix->rhs);

        var lhs_kind = self->expr_int128_kind(infix->lhs);
        var rhs_kind = self->expr_int128_kind(infix->rhs);

        if ((lhs_kind.is_some() ||
            rhs_kind.is_some()) &&
            self->int128_ops_are_valid(infix->op)) 
        {
            var unsigned_domain = false;

            if (lhs_kind.is_some()) {
                unsigned_domain = lhs_kind.unwrap();
            } else {
                unsigned_domain = rhs_kind.unwrap();
            }

            var result = self->emit_infix_int128(
                infix,
                lhs.as_str_const(),
                rhs.as_str_const(),
                unsigned_domain
            );

            lhs.free();
            rhs.free();

            return result;
        }

        var out = String.new(self->allocator);

        out.push('(');
        out.push_str(lhs.as_str_const());
        out.push(' ');

        switch (infix->op) {
            case .Add => out.push('+');
            case .Sub => out.push('-');
            case .Mul => out.push('*');
            case .Div => out.push('/');
            case .Rem => out.push('%');

            case .GreaterEqual => out.push_str(">=");
            case .LessEqual => out.push_str("<=");
            case .NotEqual => out.push_str("!=");
            case .GreaterThan => out.push('>');
            case .Equal => out.push_str("==");
            case .LessThan => out.push('<');
            
            case .And => out.push_str("&&");
            case .Or => out.push_str("||");
            
            case .ShiftRight => out.push_str(">>");
            case .ShiftLeft => out.push_str("<<");

            case .BitwiseAndNot => out.push_str("&~");
            case .BitwiseAnd => out.push('&');
            case .BitwiseOr => out.push('|');
            case .BitwiseXor => out.push('^');
            
            case .NullCoalesce => {
                lhs.free();
                rhs.free();

                var out2 = String.new(self->allocator);
                var lhs2 = self->emit_expr(infix->lhs);
                var rhs2 = self->emit_expr(infix->rhs);

                out2.push_str("((");
                out2.push_str(lhs2.as_str_const());
                out2.push_str(") ? (");
                out2.push_str(lhs2.as_str_const());
                out2.push_str(") : (");
                out2.push_str(rhs2.as_str_const());
                out2.push_str("))");
                
                lhs2.free();
                rhs2.free();
                out.free();

                return out2;
            }
        }

        out.push(' ');
        out.push_str(rhs.as_str_const());
        out.push(')');
        
        lhs.free();
        rhs.free();

        return out;
    }

    fn is_byte_string_compare(self: Self*, infix: const cir::InfixExpr*) bool {
        switch (infix->lhs->ty) {
            case .Some(lhs_type) => {
                switch (infix->rhs->ty) {
                    case .Some(rhs_type) => {
                        if (lhs_type.is_plain_null() || rhs_type.is_plain_null()) {
                            return false;
                        }

                        if (self->expr_is_null_literal(infix->lhs) ||
                            self->expr_is_null_literal(infix->rhs))
                        {
                            return false;
                        }

                        return self->is_byte_pointer(&lhs_type) && self->is_byte_pointer(&rhs_type);
                    }
                    else => return false;
                }
            }
            else => return false;
        }
    }

    fn expr_is_null_literal(self: Self*, expr: const cir::Expr*) bool {
        switch (expr->kind) {
            case .Literal(literal) => {
                switch (literal.kind) {
                    case .Null => return true;
                    else => return false;
                }
            }
            else => return false;
        }
    }

    /// Returns:
    ///   .Some(true)  for uint128, 
    ///   .Some(false) for int128, 
    ///   .None        for every other type
    fn int128_kind_of(self: Self*, ty: const cir::SemaType*) Option<bool> {
        switch (*ty->const_inner()) {
            case .Plain(plain) => {
                switch (plain) {
                    case .Int128 => return .Some(false);
                    case .UInt128 => return .Some(true);
                    else => {}
                }
            }
            else => {}
        }

        return .None;
    }

    fn expr_int128_kind(self: Self*, expr: const cir::Expr*) Option<bool> {
        switch (expr->ty) {
            case .Some(ty) => {
                return self->int128_kind_of(&ty);
            }
            else => {}
        }

        return .None;
    }

    fn is_signed_plain_int(self: Self*, plain: const cir::PlainType*) bool {
        switch (*plain) {
            case .Int8 
            | .Int16 
            | .Int32 
            | .Int64 
            | .IntPtr 
            | .ISize => return true;

            else => return false;
        }
    }

    fn scalar_operand_is_signed(self: Self*, expr: const cir::Expr*) bool {
        switch (expr->kind) {
            case .Literal(literal) => {
                switch (literal.kind) {
                    case .Integer { value, .. } => {
                        switch (value) {
                            case .Signed(_) => return true;
                            case .Unsigned(_) => return false;
                        }
                    }
                    else => return false;
                }
            }
            else => {}
        }

        switch (expr->ty) {
            case .Some(ty) => {
                switch (*ty.const_inner()) {
                    case .Plain(plain) => {
                        return self->is_signed_plain_int(&plain);
                    }
                    else => {}
                }
            }
            else => {}
        }

        return false;
    }

    fn wrap_str(
        self: Self*,
        prefix: const uint8*,
        inner: const uint8*,
        suffix: const uint8*
    ) String {
        var out = String.new(self->allocator);
        out.push_str(prefix);
        out.push_str(inner);
        out.push_str(suffix);
        return out;
    }

    /// Wraps emitted scalar C text into the 
    /// 128-bit struct representation.
    fn coerce_to_int128(
        self: Self*,
        expr: const cir::Expr*,
        text: const uint8*,
        unsigned_domain: bool
    ) String {
        switch (self->expr_int128_kind(expr)) {
            case .Some(src_unsigned) => {
                if (src_unsigned == unsigned_domain) {
                    return String.from_str(self->allocator, text);
                }

                if (unsigned_domain) {
                    return self->wrap_str("__cyrus_u128_of_i128(", text, ")");
                } else {
                    return self->wrap_str("__cyrus_i128_of_u128(", text, ")");
                }
            }
            else => {}
        }

        if (self->scalar_operand_is_signed(expr)) {
            var wrapped = self->wrap_str("__cyrus_i128_from_i64((int64_t)(", text, "))");
            
            if (unsigned_domain) {
                var str = self->wrap_str(
                    "__cyrus_u128_of_i128(",
                    wrapped.as_str_const(),
                    ")"
                );
                wrapped.free();
                return str;
            }

            return wrapped;
        }

        var wrapped = self->wrap_str(
            "__cyrus_u128_from_u64((uint64_t)(",
            text, 
            "))"
        );
        
        if (!unsigned_domain) {
            var str = self->wrap_str(
                "__cyrus_i128_of_u128(", 
                wrapped.as_str_const(), 
                ")"
            );
            wrapped.free();
            return str;
        }
        
        return wrapped;
    }

    fn int128_ops_are_valid(self: Self*, op: ast::ASTInfixOperator) bool {
        switch (op) {
            case .Add 
            | .Sub 
            | .Mul 
            | .Div 
            | .Rem 
            | .Equal 
            | .NotEqual 
            | .GreaterThan 
            | .LessThan 
            | .GreaterEqual 
            | .LessEqual 
            | .BitwiseAnd 
            | .BitwiseOr 
            | .BitwiseXor 
            | .BitwiseAndNot 
            | .ShiftLeft 
            | .ShiftRight 
            | .And 
            | .Or => return true;

            else => return false;
        }
    }

    fn int128_op_name(
        self: Self*, 
        op: ast::ASTInfixOperator, 
        unsigned_domain: bool
    ) const uint8* {
        switch (op) {
            case .Add => {
                if (unsigned_domain) {
                    return "__cyrus_u128_add";
                }

                return "__cyrus_i128_add";
            }
            
            case .Sub => {
                if (unsigned_domain) {
                    return "__cyrus_u128_sub";
                }

                return "__cyrus_i128_sub";
            }
            
            case .Mul => {
                if (unsigned_domain) {
                    return "__cyrus_u128_mul";
                }

                return "__cyrus_i128_mul";
            }
            
            case .Div => {
                if (unsigned_domain) {
                    return "__cyrus_u128_div";
                }

                return "__cyrus_i128_div";
            }
            
            case .Rem => {
                if (unsigned_domain) {
                    return "__cyrus_u128_mod";
                }

                return "__cyrus_i128_mod";
            }

            case .BitwiseAnd => {
                if (unsigned_domain) {
                    return "__cyrus_u128_band";
                }

                return "__cyrus_i128_band";
            }

            case .BitwiseOr => {
                if (unsigned_domain) {
                    return "__cyrus_u128_bor";
                }

                return "__cyrus_i128_bor";
            }
            
            case .BitwiseXor => {
                if (unsigned_domain) {
                    return "__cyrus_u128_bxor";
                }

                return "__cyrus_i128_bxor";
            }
            
            case .BitwiseAndNot => {
                if (unsigned_domain) {
                    return "__cyrus_u128_band";
                }

                return "__cyrus_i128_band";
            }
            
            case .ShiftLeft => {
                if (unsigned_domain) {
                    return "__cyrus_u128_shl";
                }

                return "__cyrus_i128_shl";
            }
            
            case .ShiftRight => {
                if (unsigned_domain) {
                    return "__cyrus_u128_shr";
                }

                return "__cyrus_i128_shr";
            }

            case .Equal 
            | .NotEqual 
            | .GreaterThan 
            | .LessThan 
            | .GreaterEqual 
            | .LessEqual => {
                if (unsigned_domain) {
                    return "__cyrus_u128_cmp";
                }

                return "__cyrus_i128_cmp";
            }

            else => {
                if (unsigned_domain) { return "__cyrus_u128_add"; }
                return "__cyrus_i128_add";
            }
        }
    }

    fn emit_int128_call(
        self: Self*,
        fn_name: const uint8*, 
        a: const uint8*, 
        b: const uint8*
    ) String {
        var out = String.new(self->allocator);
        out.push('(');
        out.push_str(fn_name);
        out.push('(');
        out.push_str(a);
        out.push_str(", ");
        out.push_str(b);
        out.push_str("))");
        return out;
    }

    fn emit_infix_int128(
        self: Self*,
        infix: const cir::InfixExpr*,
        ltext: const uint8*,
        rtext: const uint8*,
        unsigned_domain: bool
    ) String {
        var a = self->coerce_to_int128(infix->lhs, ltext, unsigned_domain);
        var b = self->coerce_to_int128(infix->rhs, rtext, unsigned_domain);

        var name = self->int128_op_name(infix->op, unsigned_domain);

        var out = String.new(self->allocator);

        switch (infix->op) {
            case .Equal 
            | .NotEqual 
            | .GreaterThan 
            | .LessThan 
            | .GreaterEqual 
            | .LessEqual => {
                out.push('(');
                out.push_str(name);
                out.push('(');
                out.push_str(a.as_str_const());
                out.push_str(", ");
                out.push_str(b.as_str_const());
                out.push_str(") ");

                switch (infix->op) {
                    case .Equal => out.push_str("== 0");
                    case .NotEqual => out.push_str("!= 0");
                    case .GreaterThan => out.push_str("> 0");
                    case .LessThan => out.push_str("< 0");
                    case .GreaterEqual => out.push_str(">= 0");
                    case .LessEqual => out.push_str("<= 0");
                    else => {}
                }

                out.push(')');
            }

            case .And => {
                var zero_fn = "__cyrus_u128_iszero";

                if (!unsigned_domain) {
                    zero_fn = "__cyrus_i128_iszero";
                }

                out.push_str("(!");
                out.push_str(zero_fn);
                out.push('(');
                out.push_str(a.as_str_const());
                out.push_str(") && !");
                out.push_str(zero_fn);
                out.push('(');
                out.push_str(b.as_str_const());
                out.push_str("))");
            }

            case .Or => {
                var zero_fn = "__cyrus_u128_iszero";

                if (!unsigned_domain) {
                    zero_fn = "__cyrus_i128_iszero";
                }

                out.push_str("(!");
                out.push_str(zero_fn);
                out.push('(');
                out.push_str(a.as_str_const());
                out.push_str(") || !");
                out.push_str(zero_fn);
                out.push('(');
                out.push_str(b.as_str_const());
                out.push_str("))");
            }

            case .BitwiseAndNot => {
                var not_fn = "__cyrus_u128_bnot";

                if (!unsigned_domain) {
                    not_fn = "__cyrus_i128_bnot";
                }

                var str = self->wrap_str(not_fn, b.as_str_const(), ")");
                out = self->emit_int128_call(
                    name, 
                    a.as_str_const(), 
                    str.as_str_const()
                );
                str.free();
            }

            case .ShiftLeft 
            | .ShiftRight => {
                var amount = String.new(self->allocator);

                if (self->expr_int128_kind(infix->rhs).is_some()) {
                    var to64 = "__cyrus_u128_to_u64(";

                    if (!unsigned_domain) {
                        to64 = "__cyrus_i128_to_u64(";
                    }
                    
                    amount = self->wrap_str(to64, rtext, ")");
                } else {
                    amount = self->wrap_str("(uint64_t)(", rtext, ")");
                }

                out = self->emit_int128_call(
                    name,
                    a.as_str_const(),
                    amount.as_str_const()
                );

                amount.free();
            }

            else => {
                out = self->emit_int128_call(
                    name,
                    a.as_str_const(),
                    b.as_str_const()
                );
            }
        }

        a.free();
        b.free();
        return out;
    }

    fn is_byte_pointer(self: Self*, ty: const cir::SemaType*) bool {
        switch (*ty->const_inner()) {
            case .Pointer(inner) => {
                switch (*inner->const_inner()) {
                    case .Plain(plain) => {
                        switch (plain) {
                            case .UInt8 => return true;
                            case .Int8 => return true;
                            else => return false;
                        }
                    }
                    else => return false;
                }
            }
            else => return false;
        }
    }

    fn emit_strcmp_compare(self: Self*, infix: const cir::InfixExpr*) String {
        self->ensure_strcmp_proto();

        var lhs = self->emit_expr(infix->lhs);
        var rhs = self->emit_expr(infix->rhs);

        var out = String.from_str(self->allocator, "(strcmp((const char *)(");
        out.push_str(lhs.as_str_const());
        out.push_str("), (const char *)(");
        out.push_str(rhs.as_str_const());
        out.push_str(")) ");

        switch (infix->op) {
            case .Equal => out.push_str("== 0");
            else => out.push_str("!= 0");
        }

        out.push(')');
        lhs.free();
        rhs.free();
        return out;
    }

    fn emit_assign(self: Self*, assign: const cir::AssignExpr*) String {
        var lhs = self->emit_expr(assign->lhs);
        var out = String.new(self->allocator);

        switch (self->expr_int128_kind(assign->lhs)) {
            case .Some(unsigned_domain) => {
                var res = self->emit_assign_int128(
                    assign,
                    lhs.as_str_const(),
                    unsigned_domain
                );
                lhs.free();
                out.free();
                return res;
            }
            else => {}
        }

        switch (assign->kind) {
            case .Default => {
                out.push('(');
                out.push_str(lhs.as_str_const());
                out.push_str(" = ");
                
                var rhs = self->emit_expr(assign->rhs);
                out.push_str(rhs.as_str_const());
                rhs.free();
                out.push(')');
            }

            
            case .AddAssign => {
                return self->compound_assign(lhs, assign->rhs, "+");
            }
            
            case .SubAssign => {
                return self->compound_assign(lhs, assign->rhs, "-");
            }
            
            case .MulAssign => {
                return self->compound_assign(lhs, assign->rhs, "*");
            }
            
            case .DivAssign => {
                return self->compound_assign(lhs, assign->rhs, "/");
            }
            
            case .ModAssign => {
                return self->compound_assign(lhs, assign->rhs, "%");
            }
            
            case .BitwiseAndAssign => {
                return self->compound_assign(lhs, assign->rhs, "&");
            }
            
            case .BitwiseXorAssign => {
                return self->compound_assign(lhs, assign->rhs, "^");
            }
            
            case .LeftShiftAssign => {
                return self->compound_assign(lhs, assign->rhs, "<<");
            }
            
            case .RightShiftAssign => {
                return self->compound_assign(lhs, assign->rhs, ">>");
            }
            
            case .BitwiseAndNotAssign => {
                var rhs = self->emit_expr(assign->rhs);
                out.push('(');
                out.push_str(lhs.as_str_const());
                out.push_str(" = ");
                out.push_str(lhs.as_str_const());
                out.push_str(" & ~(");
                out.push_str(rhs.as_str_const());
                out.push_str("))");
                rhs.free();
            }
        }

        lhs.free();
        return out;
    }

    fn int128_shift_amount(
        self: Self*,
        assign_rhs: const cir::Expr*,
        rhs_text: const uint8*,
        unsigned_domain: bool
    ) String {
        var out = String.new(self->allocator);

        if (self->expr_int128_kind(assign_rhs).is_some()) {
            out.push_str("__cyrus_");
            
            if (unsigned_domain) {
                out.push_str("u128");
            } else {
                out.push_str("i128");
            }
            
            out.push_str("_to_u64(");
            out.push_str(rhs_text);
            out.push(')');
            return out;
        }

        out.push_str("(uint64_t)(");
        out.push_str(rhs_text);
        out.push(')');
        return out;
    }

    fn emit_assign_int128(
        self: Self*,
        assign: const cir::AssignExpr*,
        lhs_value: const uint8*,
        unsigned_domain: bool
    ) String {
        var rhs_text = self->emit_expr(assign->rhs);
        var prefix_name = "__cyrus_u128";
        
        if (!unsigned_domain) {
            prefix_name = "__cyrus_i128";
        }

        var operator_name: const uint8*;
        var rhs_operand: Option<String> = .None;
        var not_rhs_operand: Option<String> = .None;
        var is_default = false;

        switch (assign->kind) {
            case .Default => {
                is_default = true;
                rhs_operand = .Some(self->coerce_to_int128(assign->rhs, rhs_text.as_str_const(), unsigned_domain));
            }
            
            case .AddAssign => {
                operator_name = "add";
                rhs_operand = .Some(self->coerce_to_int128(assign->rhs, rhs_text.as_str_const(), unsigned_domain));
            }
            
            case .SubAssign => {
                operator_name = "sub";
                rhs_operand = .Some(self->coerce_to_int128(assign->rhs, rhs_text.as_str_const(), unsigned_domain));
            }
            
            case .MulAssign => {
                operator_name = "mul";
                rhs_operand = .Some(self->coerce_to_int128(assign->rhs, rhs_text.as_str_const(), unsigned_domain));
            }
            
            case .DivAssign => {
                operator_name = "div";
                rhs_operand = .Some(self->coerce_to_int128(assign->rhs, rhs_text.as_str_const(), unsigned_domain));
            }
            
            case .ModAssign => {
                operator_name = "mod";
                rhs_operand = .Some(self->coerce_to_int128(assign->rhs, rhs_text.as_str_const(), unsigned_domain));
            }
            
            case .BitwiseAndAssign => {
                operator_name = "band";
                rhs_operand = .Some(self->coerce_to_int128(assign->rhs, rhs_text.as_str_const(), unsigned_domain));
            }
            
            case .BitwiseXorAssign => {
                operator_name = "bxor";
                rhs_operand = .Some(self->coerce_to_int128(assign->rhs, rhs_text.as_str_const(), unsigned_domain));
            }
            
            case .BitwiseAndNotAssign => {
                operator_name = "band";

                var coerced_rhs = self->coerce_to_int128(
                    assign->rhs,
                    rhs_text.as_str_const(), 
                    unsigned_domain
                );
                
                var not_fn = self->wrap_str(
                    prefix_name,
                    "_bnot(",
                    coerced_rhs.as_str_const()
                );

                not_fn.push(')');
                coerced_rhs.free();
                not_rhs_operand = .Some(not_fn);
            }
            
            case .LeftShiftAssign => {
                operator_name = "shl";
                rhs_operand = .Some(self->int128_shift_amount(assign->rhs, rhs_text.as_str_const(), unsigned_domain));
            }
            
            case .RightShiftAssign => {
                operator_name = "shr";
                rhs_operand = .Some(self->int128_shift_amount(assign->rhs, rhs_text.as_str_const(), unsigned_domain));
            }
        }

        var out = String.new(self->allocator);
        out.push('(');
        out.push_str(lhs_value);
        out.push_str(" = ");

        if (is_default) {
            switch (rhs_operand) {
                case .Some(operand) => out.push_str(operand.as_str_const());
                case .None => out.push_str("0");
            }
        } else {
            var rhs_arg = lhs_value;

            if (not_rhs_operand.is_some()) {
                switch (not_rhs_operand) {
                    case .Some(inv_op) => rhs_arg = inv_op.as_str_const();
                    case .None => {}
                }
            } else if (rhs_operand.is_some()) {
                switch (rhs_operand) {
                    case .Some(op) => rhs_arg = op.as_str_const();
                    case .None => {}
                }
            }

            var full_fn = String.new(self->allocator);
            
            full_fn.push_str(prefix_name);
            full_fn.push('_');
            
            if (operator_name != null) {
                full_fn.push_str(operator_name);
            } else {
                full_fn.push_str("add");
            }

            out.push_str(full_fn.as_str_const());
            out.push('(');
            out.push_str(lhs_value);
            out.push_str(", ");
            out.push_str(rhs_arg);
            out.push(')');
            full_fn.free();
        }

        out.push(')');

        rhs_text.free();

        switch (rhs_operand) {
            case .Some(operand) => operand.free();
            case .None => {}
        }
        switch (not_rhs_operand) {
            case .Some(inv_op) => inv_op.free();
            case .None => {}
        }
        return out;
    }

    // FIXME: Rename and move
    fn compound_assign(
        self: Self*, 
        lhs: String, 
        rhs: const cir::Expr*, 
        operator: const uint8*
    ) String {
        var out = String.new(self->allocator);
        var rhs = self->emit_expr(rhs);

        out.push('(');
        out.push_str(lhs.as_str_const());
        out.push(' ');
        out.push_str(operator);
        out.push_str("= ");
        out.push_str(rhs.as_str_const());
        out.push(')');
        
        lhs.free();
        rhs.free();
        return out;
    }

    fn emit_symbol(self: Self*, symbol: const cir::SymbolExpr*) String {
        switch (*symbol) {
            case .Resolved { decl_id, .. } => {
                switch (decl_id) {
                    case .Var(var_decl_id) => {
                        switch (self->fn_var_renames.get(var_decl_id)) {
                            case .Some(c_name) => {
                                return String.from_str(self->allocator, c_name->as_str_const());
                            }
                            else => {}
                        }

                        switch (self->switch_binding_names.get(var_decl_id)) {
                            case .Some(c_name) => {
                                return String.from_str(self->allocator, c_name->as_str_const());
                            }
                            else => {}
                        }

                        switch (self->tables->vars.get_const(var_decl_id)) {
                            case .Some(var_decl) => {
                                return mangle::sanitized(self->allocator, var_decl->name.as_str_const());
                            }
                            else => {}
                        }
                    }

                    case .GlobalVar(global_var_decl_id) => {
                        switch (self->tables->global_vars.get_const(global_var_decl_id)) {
                            case .Some(global_var_decl) => {
                                var gname = mangle::mangle_global(
                                    self->allocator,
                                    &self->types.maps,
                                    global_var_decl->name.as_str_const(),
                                    global_var_decl_id,
                                    &global_var_decl->modifiers
                                );

                                if (gname.as_str_const() == "errno") {
                                    gname.free();
                                    self->ensure_errno_location_proto();
                                    return String.from_str(self->allocator, "(*__errno_location())");
                                }

                                return gname;
                            }
                            else => {}
                        }
                    }

                    case .Func(func_decl_id) => {
                        switch (self->tables->funcs.get_const(func_decl_id)) {
                            case .Some(decl) => {
                                self->ensure_func_decl_proto(func_decl_id, decl);

                                return mangle::mangle_func(
                                    self->allocator,
                                    &self->types.maps,
                                    decl->name.as_str_const(),
                                    func_decl_id,
                                    &decl->modifiers
                                );
                            }
                            else => {}
                        }
                    }

                    case .Method(method_decl_id) => {
                        switch (self->tables->methods.get_const(method_decl_id)) {
                            case .Some(method_decl) => {
                                return mangle::mangle_method(
                                    self->allocator, 
                                    &self->types.maps, 
                                    method_decl_id, 
                                    method_decl
                                );
                            }
                            else => {}
                        }
                    }

                    else => {}
                }
            }

            case .Unresolved { symbol_id, .. } => {
                switch (self->registry->symbol_name(symbol_id)) {
                    case .Some(name) => {
                        var out = mangle::sanitized(self->allocator, name.as_str_const());
                        name.free();
                        return out;
                    }
                    else => {}
                }
            }
        }

        return String.from_str(self->allocator, "/*unresolved_symbol*/0");
    }

    fn emit_func_call(self: Self*, func_call: const cir::FuncCall*) String {
        var out = String.new(self->allocator);
        var callee: String;

        switch (func_call->dispatch) {
            case .Normal { func_decl_id } => {
                switch (self->tables->funcs.get_const(func_decl_id)) {
                    case .Some(func_decl) => {
                        self->ensure_func_decl_proto(func_decl_id, func_decl);

                        callee = mangle::mangle_func(
                            self->allocator,
                            &self->types.maps,
                            func_decl->name.as_str_const(),
                            func_decl_id,
                            &func_decl->modifiers
                        );
                    }
                    else => {
                        callee = self->emit_expr(func_call->operand);
                    }
                }
            }
            case .Monomorph { monomorph_id } => {
                var resolved = false;

                switch (self->monomorphs->instances.get_const(monomorph_id)) {
                    case .Some(inst) => {
                        switch (inst->template_id) {
                            case .Func(func_decl_id) => {
                                switch (self->tables->funcs.get_const(func_decl_id)) {
                                    case .Some(func_decl) => {
                                        callee = mangle::mangle_monomorphized_func(
                                            self->allocator,
                                            &self->types.maps,
                                            self->tables,
                                            func_decl->name.as_str_const(),
                                            func_decl_id,
                                            &func_decl->modifiers,
                                            &inst->type_args
                                        );
                                        resolved = true;
                                    }
                                    else => {}
                                }
                            }
                            else => {}
                        }
                    }
                    else => {}
                }

                if (!resolved) {
                    callee = self->emit_expr(func_call->operand);
                }
            }
            else => {
                callee = self->emit_expr(func_call->operand);
            }
        }

        out.push_str(callee.as_str_const());
        out.push('(');

        for (var i: usize = 0; i < func_call->args.len(); i += 1) {
            const arg = func_call->args.get_const(i).unwrap();

            var expr = self->emit_expr(arg);
            out.push_str(expr.as_str_const());
            expr.free();
            
            if (i + 1 < func_call->args.len()) {
                out.push_str(", ");
            }
        }

        out.push(')');
        callee.free();
        return out;
    }

    /// Emits the receiver argument for an instance method call,
    /// returning true when an argument was actually written.
    ///
    /// Static methods produce nothing and return false.
    fn emit_method_self_argument(
        self: Self*,
        out: String*,
        method: const cir::MethodDecl*,
        operand: const cir::Expr*
    ) bool {
        if (!method->is_instance_method()) {
            return false;
        }

        switch (operand->ty) {
            case .Some(ty) => {
                switch (*ty.const_inner()) {
                    case .InterfaceObject => {
                        out->push('(');
                        var expr = self->emit_expr(operand);
                        out->push_str(expr.as_str_const());
                        out->push_str(").data");
                        expr.free();
                        return true;
                    }
                    case .Pointer => {
                        var expr = self->emit_expr(operand);

                        if (self->is_self_by_value(method)) {
                            // Value receiver called through a pointer:
                            //    Deref to materialize the object
                            out->push_str("(*");
                            out->push_str(expr.as_str_const());
                            out->push(')');
                        } else {
                            out->push_str(expr.as_str_const());
                        }
                        
                        expr.free();
                        return true;
                    }
                    else => {
                        var expr = self->emit_expr(operand);

                        if (self->is_self_by_value(method)) {
                            out->push_str(expr.as_str_const());
                        } else {
                            out->push_str("(&");
                            out->push_str(expr.as_str_const());
                            out->push(')');
                        }

                        expr.free();
                        return true;
                    }
                }
            }
            else => {}
        }

        return false;
    }

    // FIXME: Make it a method of MethodDecl in cir/index.cyrus
    fn is_self_by_value(self: Self*, method: const cir::MethodDecl*) bool {
        switch (method->func_decl.params.get_self_modifier()) {
            case .Some(self_mod) => {
                switch (self_mod.ty) {
                    case .Pointer => return false;
                    else => return true;
                }
            }
            else => {}
        }

        return false;
    }

    fn emit_interface_self_argument(
        self: Self*,
        out: String*,
        method: const cir::MethodDecl*,
        operand: const cir::Expr*
    ) bool {
        if (!method->is_instance_method()) {
            return false;
        }

        out->push('(');

        var expr = self->emit_expr(operand);
        out->push_str(expr.as_str_const());
        out->push_str(").data");
        expr.free();
        
        return true;
    }

    fn emit_method_call(self: Self*, method_call: const cir::MethodCall*) String {
        switch (method_call->dispatch) {
            case .Normal { method_decl_id } => {
                switch (self->tables->methods.get_const(method_decl_id)) {
                    case .Some(method) => {
                        var name = mangle::mangle_method(
                            self->allocator,
                            &self->types.maps,
                            method_decl_id,
                            method
                        );
                        
                        var out = String.new(self->allocator);
                        out.push_str(name.as_str_const());
                        out.push('(');

                        const has_self_argument = self->emit_method_self_argument(
                            &out, 
                            method, 
                            method_call->operand
                        );
                        
                        for (var i: usize = 0; i < method_call->args.len(); i += 1) {
                            const arg = method_call->args.get_const(i).unwrap();
                            
                            if (has_self_argument || i != 0) {
                                out.push_str(", ");
                            }
                            
                            var expr = self->emit_expr(arg);
                            out.push_str(expr.as_str_const());
                            expr.free();
                        }

                        out.push(')');
                        name.free();
                        return out;
                    }
                    else => {}
                }
            }
            
            case .Interface { interface_decl_id, index, dispatch } => {
                switch (dispatch) {
                    case .StaticNormal { method_decl_id } => {
                        switch (self->tables->methods.get_const(method_decl_id)) {
                            case .Some(method) => {
                                var name = mangle::mangle_method(
                                    self->allocator, 
                                    &self->types.maps,
                                    method_decl_id, 
                                    method
                                );

                                var out = String.new(self->allocator);
                                
                                out.push_str(name.as_str_const());
                                out.push('(');
                                
                                const has_self_argument = self->emit_interface_self_argument(
                                    &out,
                                    method,
                                    method_call->operand
                                );
                                
                                for (var i: usize = 0; i < method_call->args.len(); i += 1) {
                                    const arg = method_call->args.get_const(i).unwrap();
                                    
                                    if (has_self_argument || i != 0) {
                                        out.push_str(", ");
                                    }
                                    
                                    var expr = self->emit_expr(arg);
                                    out.push_str(expr.as_str_const());
                                    expr.free();
                                }

                                out.push(')');
                                name.free();
                                return out;
                            }
                            else => {}
                        }
                    }

                    case .StaticMonomorphized { monomorph_id } => {
                        // Static call to a monomorphized method: use the
                        // instance's substituted sig.
                        switch (self->monomorphs->instances.get_const(monomorph_id)) {
                            case .Some(inst) => {
                                switch (inst->template_id) {
                                    case .Method(method_decl_id) => {
                                        switch (self->tables->methods.get_const(method_decl_id)) {
                                            case .Some(method) => {
                                                var name = mangle::mangle_monomorphized_method(
                                                    self->allocator,
                                                    &self->types.maps,
                                                    self->tables,
                                                    method_decl_id,
                                                    method,
                                                    &inst->type_args
                                                );

                                                var out = String.new(self->allocator);
                                                out.push_str(name.as_str_const());
                                                out.push('(');
                                                
                                                const has_self_argument = self->emit_interface_self_argument(
                                                    &out, 
                                                    method, 
                                                    method_call->operand
                                                );
                                                
                                                for (var i: usize = 0; i < method_call->args.len(); i += 1) {
                                                    const arg = method_call->args.get_const(i).unwrap();
                                                    
                                                    if (has_self_argument || i != 0) {
                                                        out.push_str(", ");
                                                    }
                                                    
                                                    var expr = self->emit_expr(arg);
                                                    out.push_str(expr.as_str_const());
                                                    expr.free();
                                                }

                                                out.push(')');
                                                name.free();
                                                return out;
                                            }
                                            else => {}
                                        }
                                    }
                                    else => {}
                                }
                            }
                            else => {}
                        }
                    }

                    // ((RET (*)(void *, ...))
                    //   ((void **)fat_pointer.vtable)[IDX])
                    //     (fat_pointer.data, args...)
                    case .Dynamic => {
                        var fat_pointer = self->emit_expr(method_call->operand);

                        var ret_name = self->interface_method_ret_type(
                            interface_decl_id, 
                            index, 
                            &method_call->type_args
                        );

                        var out = String.from_str(self->allocator, "((");
                        out.push_str(ret_name.as_str_const());
                        out.push_str(" (*)(void *");

                        for (var i: usize = 0; i < method_call->args.len(); i += 1) {
                            const arg = method_call->args.get_const(i).unwrap();
                            
                            switch (arg->ty) {
                                case .Some(ty) => {
                                    var type_name = self->types.type_name(&ty);
                                    out.push_str(", ");
                                    out.push_str(type_name.as_str_const());
                                    type_name.free();
                                }
                                else => out.push_str(", void *");
                            }
                        }

                        out.push_str("))((void **)(");
                        out.push_str(fat_pointer.as_str_const());
                        out.push_str(").vtable)[");
                        push_usize(&out, index);
                        out.push_str("])((");
                        out.push_str(fat_pointer.as_str_const());
                        out.push_str(").data");

                        for (var i: usize = 0; i < method_call->args.len(); i += 1) {
                            const arg = method_call->args.get_const(i).unwrap();
                            
                            out.push_str(", ");
                            
                            var expr = self->emit_expr(arg);
                            out.push_str(expr.as_str_const());
                            expr.free();
                        }

                        out.push(')');
                        fat_pointer.free();
                        ret_name.free();
                        return out;
                    }
                    else => {}
                }
            }

            case .Monomorph { monomorph_id, .. } => {
                switch (self->monomorphs->instances.get_const(monomorph_id)) {
                    case .Some(inst) => {
                        switch (inst->template_id) {
                            case .Method(method_decl_id) => {
                                switch (self->tables->methods.get_const(method_decl_id)) {
                                    case .Some(method) => {
                                        var name = mangle::mangle_monomorphized_method(
                                            self->allocator,
                                            &self->types.maps,
                                            self->tables,
                                            method_decl_id,
                                            method,
                                            &inst->type_args
                                        );
                                        
                                        var out = String.new(self->allocator);
                                        out.push_str(name.as_str_const());
                                        out.push('(');

                                        const has_self_argument = self->emit_method_self_argument(
                                            &out, 
                                            method, 
                                            method_call->operand
                                        );
                                        
                                        for (var i: usize = 0; i < method_call->args.len(); i += 1) {
                                            const arg = method_call->args.get_const(i).unwrap();
                                            
                                            if (has_self_argument || i != 0) {
                                                out.push_str(", ");
                                            }
                                            
                                            var expr = self->emit_expr(arg);
                                            out.push_str(expr.as_str_const());
                                            expr.free();
                                        }
                                        
                                        out.push(')');
                                        name.free();
                                        return out;
                                    }
                                    else => {}
                                }
                            }
                            else => {}
                        }
                    }
                    else => {}
                }
            }
            else => {}
        }

        // Fallback:
        // Treat as a plain call on the operand
        var fallback = String.new(self->allocator);

        var base = self->emit_expr(method_call->operand);
        fallback.push_str(base.as_str_const());
        base.free();

        fallback.push_str(" (");

        for (var i: usize = 0; i < method_call->args.len(); i += 1) {
            const arg = method_call->args.get_const(i).unwrap();
            
            var expr = self->emit_expr(arg);
            fallback.push_str(expr.as_str_const());
            expr.free();
            
            if (i + 1 < method_call->args.len()) {
                fallback.push_str(", ");
            }
        }

        fallback.push(')');
        return fallback;
    }

    fn emit_struct_init(self: Self*, struct_init: const cir::StructInitExpr*) String {
        var type_name = self->type_name_of(&struct_init->operand);
        var out = String.from_str(self->allocator, "((");
        out.push_str(type_name.as_str_const());
        out.push_str("){ ");
        
        for (var i: usize = 0; i < struct_init->fields.len(); i += 1) {
            const field = struct_init->fields.get_const(i).unwrap();

            out.push('.');
            mangle::sanitize_into(&out, field->name.as_str_const());
            out.push_str(" = ");
            
            var expr = self->emit_expr(&field->value);
            out.push_str(expr.as_str_const());
            expr.free();

            out.push_str(", ");
        }

        out.push_str(" })");
        type_name.free();
        return out;
    }

    // FIXME: Rename
    fn emit_enum_init(self: Self*, enum_init: const cir::EnumInit*) String {
        var enum_decl_id: cir::EnumDeclId;
        var found = false;

        switch (*enum_init->operand.const_inner()) {
            case .Named(named) => {
                switch (named.type_decl_id) {
                    case .Enum(id) => {
                        enum_decl_id = id;
                        found = true;
                    }
                    else => {}
                }
            }
            else => {}
        }

        if (!found) {
            return String.from_str(self->allocator, "((void)0)");
        }

        const enum_decl = self->tables->enums.get_const(enum_decl_id).unwrap();
        const scalar = is_enum_scalar_optimizable(self->tables, enum_decl);
        const tags = self->types.tctx.enum_variant_tags(enum_decl_id, enum_decl);
        
        var name = self->types.enum_c_name_for_ty(&enum_init->operand);

        const tag = enum_decl->find_variant_tag(
            tags,
            enum_init->name.as_str_const()
        );
        
        var variant_index: usize = 0;
        var found_variant = false;

        for (var i: usize = 0; i < enum_decl->variants.len(); i += 1) {
            const variant = enum_decl->variants.get_const(i).unwrap();
            
            if (variant->name() == enum_init->name.as_str_const()) {
                variant_index = i;
                found_variant = true;
                break;
            }
        }

        if (!found_variant) {
            name.free();
            return String.from_str(self->allocator, "((void)0)");
        }

        if (scalar) {
            var out = String.from_str(self->allocator, "((");
            out.push_str(name.as_str_const());
            out.push(')');
            
            switch (enum_init->arg) {
                case .Unit => push_uint32(&out, tag);

                case .Tuple(exprs) => {
                    if (exprs.len() == 1) {
                        const element = exprs.get_const(0).unwrap();

                        var expr = self->emit_expr(element);
                        out.push_str(expr.as_str_const());
                        expr.free();
                    } else {
                        push_uint32(&out, tag);
                    }
                }

                else => push_uint32(&out, tag);
            }
            
            out.push(')');
            name.free();
            return out;
        }

        self->ensure_memset_proto();
        self->ensure_memcpy_proto();

        const variant = enum_decl->variants.get_const(variant_index).unwrap();

        var out = String.from_str(self->allocator, "(({ ");
        out.push_str(name.as_str_const());
        out.push_str(" __e; memset(&__e, 0, sizeof(__e)); __e.tag = ");
        push_uint32(&out, tag);
        out.push_str("; ");

        switch (*variant) {
            case .Unit => {}

            case .Valued { value, .. } => {
                var variant = self->types.enum_variant_type_name(&name, tag);
                out.push_str(variant.as_str_const());
                out.push_str(" __p = { ");
                
                var expr = self->emit_expr(value);
                out.push_str(expr.as_str_const());
                expr.free();
                
                out.push_str(" }; memcpy(__e.u.raw, &__p, sizeof(__p)); ");
                variant.free();
            }

            case .Tuple { fields, .. } => {
                var variant = self->types.enum_variant_type_name(&name, tag);
                out.push_str(variant.as_str_const());
                out.push_str(" __p = { ");
                
                switch (enum_init->arg) {
                    case .Tuple(exprs) => {
                        for (var j: usize = 0; j < fields.len(); j += 1) {
                            if (j < exprs.len()) {
                                const element = exprs.get_const(j).unwrap();
                                
                                var expr = self->emit_expr(element);
                                out.push_str(expr.as_str_const());
                                expr.free();
                            }
                            out.push_str(", ");
                        }
                    }
                    else => {}
                }

                out.push_str(" }; memcpy(__e.u.raw, &__p, sizeof(__p)); ");
                variant.free();
            }
            case .Struct { fields, .. } => {
                var variant = self->types.enum_variant_type_name(&name, tag);
                out.push_str(variant.as_str_const());
                out.push_str(" __p = { ");

                switch (enum_init->arg) {
                    case .Struct(field_inits) => {
                        for (var j: usize = 0; j < fields.len(); j += 1) {
                            const field = fields.get_const(j).unwrap();
                            
                            for (var k: usize = 0; k < field_inits.len(); k += 1) {
                                const field_init = field_inits.get_const(k).unwrap();

                                if (field_init->name.str.as_str_const() == field->name.str.as_str_const()) {
                                    out.push('.');
                                    mangle::sanitize_into(&out, field->name.str.as_str_const());
                                    out.push_str(" = ");
                                    
                                    var expr = self->emit_expr(field_init->value);
                                    out.push_str(expr.as_str_const());
                                    expr.free();
                                    
                                    out.push_str(", ");
                                    break;
                                }
                            }
                        }
                    }
                    else => {}
                }

                out.push_str(" }; memcpy(__e.u.raw, &__p, sizeof(__p)); ");
                variant.free();
            }
        }

        out.push_str("__e; }))");
        name.free();
        return out;
    }

    fn emit_lambda(self: Self*, lambda: const cir::LambdaExpr*) String {
        const lambda_id = self->lambda_id;
        self->lambda_id += 1;

        var name = String.from_str(self->allocator, "__lambda_");
        push_usize(&name, lambda_id);

        var sig = self->build_func_signature(
            &lambda->ret_type, 
            &lambda->params, 
            name.as_str_const()
        );

        self->protos_out.push_str("static ");
        self->protos_out.push_str(sig.as_str_const());
        self->protos_out.push_str(";\n");

        self->pending_out.push_str("static ");
        self->pending_out.push_str(sig.as_str_const());
        self->pending_out.push_str(" { ");
        
        const parent = self->body_out;
        self->body_out = String.new(self->allocator);

        var saved_scope = self->fn_scope_names;
        self->fn_scope_names = Vec.new(self->allocator);

        var saved_func_name = self->cur_func_name;
        var saved_method_name = self->cur_method_name;
        self->set_name_context("<unnamed>", null);

        self->emit_param_prologue(&lambda->params);
        self->emit_block_stmts(lambda->body, false);

        self->cur_func_name = saved_func_name;
        self->cur_method_name = saved_method_name;

        for (var i: usize = 0; i < self->fn_scope_names.len(); i += 1) {
            self->fn_scope_names.get(i).unwrap()->free();
        }

        self->fn_scope_names.free();
        self->fn_scope_names = saved_scope;

        self->pending_out.push_str(self->body_out.as_str_const());
        self->pending_out.push_str("} \n");

        self->body_out.free();
        self->body_out = parent;

        sig.free();
        return name;
    }

    fn emit_dynamic(self: Self*, dynamic_: const cir::DynamicExpr*) String {
        var vtable_name = self->ensure_vtable_for(dynamic_);

        self->types.ensure_fat_ptr();

        // The operand is always a by-value concrete object
        var out = String.from_str(
            self->allocator, 
            "((__fat_ptr){ .data = (void *)&("
        );

        var expr = self->emit_expr(dynamic_->operand);
        out.push_str(expr.as_str_const());
        expr.free();
        
        out.push_str("), .vtable = (void *)");
        out.push_str(vtable_name.as_str_const());
        out.push_str(" })");

        vtable_name.free();
        return out;
    }

    fn ensure_vtable_for(self: Self*, dynamic_: const cir::DynamicExpr*) String {
        var vtable_id: cir::VTableId = 0;
        var found = false;

        switch (dynamic_->interface_object_type) {
            case .Some(ty) => {
                vtable_id = ty.vtable_id;
                found = true;
            }
            else => {}
        }

        if (!found) {
            switch (dynamic_->concrete_type) {
                case .Some(ty) => {
                    // Find a vtable whose concrete type matches
                    for (var i: usize = 0; i < self->vtables->tables.len(); i += 1) {
                        const info = self->vtables->tables.get_const(i).unwrap();

                        if (cir::cir_types_eq(&info->concrete_type, &ty)) {
                            vtable_id = i;
                            found = true;
                            break;
                        }
                    }
                }
                else => {}
            }
        }

        var out = String.from_str(self->allocator, "__cyrus_vtable_");
        push_usize(&out, vtable_id);

        if (!found) {
            return out;
        }

        switch (self->vtable_emitted.get(vtable_id)) {
            case .Some => return out;
            else => {}
        }

        self->vtable_emitted.insert(vtable_id, 1);

        const info = self->vtables->tables.get_const(vtable_id).unwrap();

        self->pending_out.push_str("static void *__cyrus_vtable_");
        push_usize(&self->pending_out, vtable_id);
        self->pending_out.push_str("[] = { ");

        for (var i: usize = 0; i < info->method_decls.entries.len(); i += 1) {
            const entry = info->method_decls.entries.get_const(i).unwrap();

            // Use the existing specialized function
            // when the analyzer recorded one
            // for this slot
            var done = false;

            switch (info->monomorphized_methods.get_const(i)) {
                case .Some(slot) => {
                    switch (*slot) {
                        case .Some(mono_id) => {
                            switch (self->monomorphs->instances.get_const(mono_id)) {
                                case .Some(inst) => {
                                    switch (inst->template_id) {
                                        case .Method(method_decl_id) => {
                                            switch (self->tables->methods.get_const(method_decl_id)) {
                                                case .Some(method) => {
                                                    var c_name = mangle::mangle_monomorphized_method(
                                                        self->allocator,
                                                        &self->types.maps,
                                                        self->tables,
                                                        method_decl_id,
                                                        method,
                                                        &inst->type_args
                                                    );
                                                    self->pending_out.push_str(" (void *)&");
                                                    self->pending_out.push_str(c_name.as_str_const());
                                                    self->pending_out.push_str(",\n");
                                                    c_name.free();
                                                    done = true;
                                                }
                                                else => {}
                                            }
                                        }
                                        else => {}
                                    }
                                }
                                else => {}
                            }
                        }
                        else => {}
                    }
                }
                else => {}
            }

            if (done) {
                continue;
            }

            switch (self->tables->methods.get_const(entry->id)) {
                case .Some(method) => {
                    var c_name = mangle::mangle_method(
                        self->allocator,
                        &self->types.maps,
                        entry->id,
                        method
                    );

                    self->pending_out.push_str(" (void *)&");
                    self->pending_out.push_str(c_name.as_str_const());
                    self->pending_out.push_str(",\n");
                    c_name.free();
                }
                else => self->pending_out.push_str(" 0,\n");
            }
        }

        self->pending_out.push_str("};\n\n");

        return out;
    }

    fn needs_signed_cast(
        self: Self*, 
        target_type: const cir::SemaType*, 
        value_arg: const cir::Expr*
    ) bool {
        switch (value_arg->ty) {
            case .Some(src_type) => {
                switch (target_type->as_plain_type()) {
                    case .Some(target_plain) => {
                        switch (src_type.as_plain_type()) {
                            case .Some(src_plain) => {
                                if (!target_plain.is_integer() || !src_plain.is_integer()) {
                                    return false;
                                }

                                if (target_plain.is_bool() || src_plain.is_bool()) {
                                    return false;
                                }

                                switch (cir::PlainType.plain_type_rank(&target_plain)) {
                                    case .Some(target_rank) => {
                                        switch (cir::PlainType.plain_type_rank(&src_plain)) {
                                            case .Some(src_rank) => {
                                                if (target_rank <= src_rank) {
                                                    return false;
                                                }

                                                switch (signed_int_c_name(&src_plain)) {
                                                    case .Some => return true;
                                                    else => return false;
                                                }
                                            }
                                            else => return false;
                                        }
                                    }
                                    else => return false;
                                }
                            }
                            else => return false;
                        }
                    }
                    else => return false;
                }
            }
            else => return false;
        }
    }

    fn emit_builtin_func(self: Self*, builtin_func: const cir::BuiltinFunc*) String {
        switch (cir::lookup_builtin(builtin_func->name.str.as_str_const())) {
            case .Some(kind) => {
                switch (kind) {
                    case .SizeOf => {
                        switch (builtin_func->args.get_const(0)) {
                            case .Some(operand) => {
                                switch (operand->ty) {
                                    case .Some(ty) => {
                                        self->types.ensure_named(&ty);
                                        
                                        var type_name = self->types.type_name(&ty);
                                        var out = String.from_str(self->allocator, "sizeof(");

                                        out.push_str(type_name.as_str_const());
                                        out.push(')');
                                        
                                        type_name.free();
                                        return out;
                                    }
                                    case .None => {}
                                }
                            }
                            else => {}
                        }

                        return String.from_str(self->allocator, "sizeof(void)");
                    }

                    case .AlignOf => {
                        switch (builtin_func->args.get_const(0)) {
                            case .Some(operand) => {
                                switch (operand->ty) {
                                    case .Some(ty) => {
                                        self->types.ensure_named(&ty);
                                        
                                        var type_name = self->types.type_name(&ty);
                                        var out = String.from_str(self->allocator, "__alignof__(");
                                        
                                        out.push_str(type_name.as_str_const());
                                        out.push(')');
                                        
                                        type_name.free();
                                        return out;
                                    }
                                    case .None => {}
                                }
                            }
                            else => {}
                        }

                        return String.from_str(self->allocator, "__alignof__(void)");
                    }

                    case .OffsetOf => {
                        self->needs_stddef_header = true;

                        switch (builtin_func->args.get_const(0)) {
                            case .Some(type_arg) => {
                                switch (builtin_func->args.get_const(1)) {
                                    case .Some(field_arg) => {
                                        switch (type_arg->ty) {
                                            case .Some(ty) => {
                                                self->types.ensure_named(&ty);
                                                
                                                var type_name = self->types.type_name(&ty);
                                                var out = String.from_str(self->allocator, "offsetof(");
                                                
                                                out.push_str(type_name.as_str_const());
                                                out.push_str(", ");
                                                
                                                switch (field_arg->literal_const_string_value()) {
                                                    case .Some(name) => out.push_str(name);
                                                    case .None => out.push_str("0");
                                                }
                                                
                                                out.push(')');
                                                type_name.free();
                                                return out;
                                            }
                                            case .None => {}
                                        }
                                    }
                                    else => {}
                                }
                            }
                            else => {}
                        }

                        return String.from_str(self->allocator, "0");
                    }

                    case .Cast => {
                        switch (builtin_func->args.get_const(0)) {
                            case .Some(type_arg) => {
                                switch (builtin_func->args.get_const(1)) {
                                    case .Some(value_arg) => {
                                        switch (type_arg->ty) {
                                            case .Some(ty) => {
                                                var dest_128 = self->int128_kind_of(&ty);
                                                var src_128 = self->expr_int128_kind(value_arg);

                                                if (dest_128.is_some() || src_128.is_some()) {
                                                    self->types.ensure_named(&ty);

                                                    var cast_expr = self->emit_expr(value_arg);
                                                    var cast_out = String.new(self->allocator);

                                                    if (dest_128.is_some()) {
                                                        var coerce = self->coerce_to_int128(
                                                            value_arg,
                                                            cast_expr.as_str_const(), 
                                                            dest_128.unwrap()
                                                        );
                                                        cast_out.push_str(coerce.as_str_const());
                                                        coerce.free();
                                                    } else {
                                                        var dest_name = self->types.type_name(&ty);
                                                        cast_out.push_str("((");
                                                        cast_out.push_str(dest_name.as_str_const());
                                                        cast_out.push_str(")((uint64_t)(");
                                                        cast_out.push_str(cast_expr.as_str_const());
                                                        cast_out.push_str(").lo))");
                                                        dest_name.free();
                                                    }

                                                    cast_expr.free();
                                                    return cast_out;
                                                }

                                                self->types.ensure_named(&ty);

                                                var type_name = self->types.type_name(&ty);
                                                var expr = self->emit_expr(value_arg);
                                                var out = String.new(self->allocator);

                                                if (self->needs_signed_cast(&ty, value_arg)) {
                                                    out.push_str("((");
                                                    out.push_str(type_name.as_str_const());
                                                    out.push_str(")((");
                                                    
                                                    switch (value_arg->ty) {
                                                        case .Some(src_type) => {
                                                            switch (src_type.as_plain_type()) {
                                                                case .Some(plain) => {
                                                                    switch (signed_int_c_name(&plain)) {
                                                                        case .Some(name) => out.push_str(name);
                                                                        else => {}
                                                                    }
                                                                }
                                                                else => {}
                                                            }
                                                        }
                                                        else => {}
                                                    }
                                                    
                                                    out.push_str(")");
                                                    out.push_str(expr.as_str_const());
                                                    out.push_str("))");
                                                } else {
                                                    out.push_str("((");
                                                    out.push_str(type_name.as_str_const());
                                                    out.push_str(")");
                                                    out.push_str(expr.as_str_const());
                                                    out.push(')');
                                                }
                                                
                                                expr.free();
                                                type_name.free();
                                                return out;
                                            }
                                            case .None => {}
                                        }
                                    }
                                    else => {}
                                }
                            }
                            else => {}
                        }

                        return String.from_str(self->allocator, "((void)0)");
                    }

                    case .Assert => {
                        self->note_assert_use();

                        var out = String.from_str(self->allocator, "(((");

                        switch (builtin_func->args.get_const(0)) {
                            case .Some(cond) => {
                                var expr = self->emit_expr(cond);
                                out.push_str(expr.as_str_const());
                                expr.free();
                            }
                            else => out.push_str("1");
                        }

                        out.push_str(") ? (void)0 : __cyrus_assert_fail_(__FILE__, __LINE__, ");

                        switch (builtin_func->args.get_const(1)) {
                            case .Some(mesg) => {
                                switch (mesg->literal_const_string_value()) {
                                    case .Some(mesg) => {
                                        out.push('"');
                                        push_c_escaped(&out, mesg);
                                        out.push('"');
                                    }
                                    case .None => out.push_str("\"assertion failed\"");
                                }
                            }
                            case .None => out.push_str("\"assertion failed\"");
                        }

                        out.push_str(")))");
                        return out;
                    }

                    case .Panic => {
                        self->note_panic_use();

                        var out = String.from_str(self->allocator, "__cyrus_panic_(");
                        
                        switch (builtin_func->args.get_const(0)) {
                            case .Some(mesg) => {
                                switch (mesg->literal_const_string_value()) {
                                    case .Some(mesg) => {
                                        out.push('"');
                                        push_c_escaped(&out, mesg);
                                        out.push('"');
                                    }
                                    case .None => out.push_str("\"panic\"");
                                }
                            }
                            case .None => out.push_str("\"panic\"");
                        }

                        out.push(')');
                        return out;
                    }

                    case .Unreachable => {
                        self->note_panic_use();
                        return String.from_str(self->allocator, "__cyrus_panic_(\"unreachable\")");
                    }

                    case .Todo => {
                        self->note_panic_use();
                        return String.from_str(self->allocator, "__cyrus_panic_(\"todo\")");
                    }

                    case .Unimplemented => {
                        self->note_panic_use();
                        return String.from_str(self->allocator, "__cyrus_panic_(\"unimplemented\")");
                    }

                    case .Memcpy => {
                        self->ensure_memcpy_proto();
                        
                        var out = String.from_str(self->allocator, "memcpy(");
                        
                        for (var i: usize = 0; i < builtin_func->args.len(); i += 1) {
                            const arg = builtin_func->args.get_const(i).unwrap();
                            
                            var expr = self->emit_expr(arg);
                            out.push_str(expr.as_str_const());
                            expr.free();
                            
                            if (i + 1 < builtin_func->args.len()) {
                                out.push_str(", ");
                            }
                        }

                        out.push(')');
                        return out;
                    }

                    case .Memset => {
                        self->ensure_memset_proto();
                        
                        var out = String.from_str(self->allocator, "memset(");
                        
                        for (var i: usize = 0; i < builtin_func->args.len(); i += 1) {
                            const arg = builtin_func->args.get_const(i).unwrap();
                            
                            var expr = self->emit_expr(arg);
                            out.push_str(expr.as_str_const());
                            expr.free();
                            
                            if (i + 1 < builtin_func->args.len()) {
                                out.push_str(", ");
                            }
                        }
                        
                        out.push(')');
                        return out;
                    }

                    case .FuncName => {
                        switch (self->cur_func_name) {
                            case .Some(name) => {
                                return self->quoted_cstr(name.as_str_const());
                            }
                            else => {}
                        }

                        return String.from_str(self->allocator, "\"<undefined>\"");
                    }

                    case .MethodName => {
                        switch (self->cur_method_name) {
                            case .Some(name) => {
                                return self->quoted_cstr(name.as_str_const());
                            }
                            else => {}
                        }

                        return String.from_str(self->allocator, "\"<undefined>\"");
                    }

                    case .ModuleName => {
                        switch (self->tree_for_source(builtin_func->span.source_id)) {
                            case .Some(tree) => {
                                return self->quoted_cstr(tree->module_name.as_str_const());
                            }
                            else => {}
                        }

                        return String.from_str(self->allocator, "\"\"");
                    }

                    case .FileName => {
                        switch (self->tree_for_source(builtin_func->span.source_id)) {
                            case .Some(tree) => {
                                return self->quoted_cstr(tree->file_name.as_str_const());
                            }
                            else => {}
                        }

                        return String.from_str(self->allocator, "\"\"");
                    }

                    case .Line => {
                        switch (self->builtin_line_column(builtin_func, false)) {
                            case .Some(value) => {
                                var out = String.new(self->allocator);
                                push_usize(&out, value);
                                return out;
                            }
                            else => {}
                        }

                        return String.from_str(self->allocator, "0");
                    }

                    case .Column => {
                        switch (self->builtin_line_column(builtin_func, true)) {
                            case .Some(value) => {
                                var out = String.new(self->allocator);
                                push_usize(&out, value);
                                return out;
                            }
                            else => {}
                        }

                        return String.from_str(self->allocator, "0");
                    }

                    else => return String.from_str(self->allocator, "((void)0)");

                }
            }
            else => {}
        }

        return String.from_str(self->allocator, "((void)0)");
    }

    fn emit_literal(self: Self*, literal: const cir::LiteralExpr*) String {
        switch (literal->kind) {
            case .Integer { value, .. } => {
                var literal_domain: Option<bool> = .None;

                switch (literal->ty) {
                    case .Some(ty) => {
                        literal_domain = self->int128_kind_of(&ty);
                    }
                    else => {}
                }

                if (literal_domain.is_some()) {
                    var v: uint128 = 0;

                    switch (value) {
                        case .Signed(x) => {
                            v = @cast(uint128, x);
                        }
                        case .Unsigned(x) => {
                            v = x;
                        }
                    }

                    var hi = v >> 64;
                    var lo = @cast(uint64, v);
                    var hi64 = @cast(uint64, hi);

                    var cout = String.new(self->allocator);

                    if (literal_domain.unwrap()) {
                        cout.push_str("((__cyrus_uint128){ ");
                    } else {
                        cout.push_str("((__cyrus_int128){ ");
                    }

                    push_uint128(&cout, @cast(uint128, lo));
                    cout.push_str("ULL, ");

                    if (!literal_domain.unwrap()) {
                        cout.push_str("(int64_t)");
                    }

                    push_uint128(&cout, @cast(uint128, hi64));
                    cout.push_str("ULL })");
                    return cout;
                }

                var out = String.new(self->allocator);

                switch (value) {
                    case .Signed(x) => {
                        if (x < 0) {
                            out.push('-');
                            push_uint128(&out, @cast(uint128, -(x + 1)) + 1);
                        } else {
                            push_uint128(&out, @cast(uint128, x));
                        }
                    }
                    case .Unsigned(x) => push_uint128(&out, x);
                }

                return out;
            }

            case .Float { value, .. } => {
                var str = String.new(self->allocator);
                var writer: Writer = dynamic StringWriter.new(&str);

                format_float64(writer, value);

                if (!str_contains_char(str.as_str_const(), '.') &&
                    !str_contains_char(str.as_str_const(), 'e') &&
                    !str_contains_char(str.as_str_const(), 'n'))
                {
                    str.push_str(".0");
                }

                return str;
            }

            case .String { value, .. } => {
                var out = String.from_str(self->allocator, "\"");
                push_c_escaped(&out, value.as_str_const());
                out.push('"');
                return out;
            }

            case .Char(c) => {
                var out = String.new(self->allocator);
                out.push('\'');
                push_c_char(&out, c);
                out.push('\'');
                return out;
            }

            case .Bool(x) => {
                self->types.used_bool = true;

                if (x) {
                    return String.from_str(self->allocator, "true");
                } else {
                    return String.from_str(self->allocator, "false");
                }
            }

            case .Null => {
                self->needs_stddef_header = true;
                return String.from_str(self->allocator, "NULL");
            }
        }
    }

    /* ************* Defer ************* */

    fn push_defer(self: Self*, defer_stmt: cir::DeferStmt) {
        if (self->defer_scopes.len() == 0) {
            var scope: Vec<cir::DeferStmt> = Vec.new(self->allocator);
            scope.push(defer_stmt);
            self->defer_scopes.push(scope);
            return;
        }

        switch (self->defer_scopes.last()) {
            case .Some(scope) => scope->push(defer_stmt);
            else => {}
        }
    }

    fn pop_defer_scope(self: Self*) {
        switch (self->defer_scopes.last()) {
            case .Some(scope) => {
                for (var i: usize = scope->len(); i > 0; i -= 1) {
                    const stmt = scope->get_const(i - 1).unwrap();
                    self->emit_defer_stmt(stmt);
                }
            }
            else => {}
        }

        if (self->defer_scopes.len() > 0) {
            var stmt = self->defer_scopes.pop();
            stmt.free();
        }
    }

    fn emit_all_defers(self: Self*) {
        for (var s: usize = self->defer_scopes.len(); s > 0; s -= 1) {
            switch (self->defer_scopes.get_const(s - 1)) {
                case .Some(scope) => {
                    for (var i: usize = scope->len(); i > 0; i -= 1) {
                        const stmt = scope->get_const(i - 1).unwrap();
                        self->emit_defer_stmt(stmt);
                    }
                }
                else => {}
            }
        }
    }

    fn emit_defers_to_loop_mark(self: Self*) {
        switch (self->loop_marks.last_const()) {
            case .Some(mark) => {
                for (var s: usize = self->defer_scopes.len(); s > *mark; s -= 1) {
                    switch (self->defer_scopes.get_const(s - 1)) {
                        case .Some(scope) => {
                            for (var i: usize = scope->len(); i > 0; i -= 1) {
                                const stmt = scope->get_const(i - 1).unwrap();
                                self->emit_defer_stmt(stmt);
                            }
                        }
                        else => {}
                    }
                }
            }
            else => {}
        }
    }

    fn emit_defer_stmt(self: Self*, defer_stmt: const cir::DeferStmt*) {
        self->emit_stmt(defer_stmt->operand);
    }

    /* ************* Types Helpers ************* */

    fn type_name_of(self: Self*, ty: const cir::SemaType*) String {
        self->types.ensure_named(ty);
        return self->types.type_name(ty);
    }

    fn tuple_field_name(self: Self*, index: usize) String {
        var out = String.from_str(self->allocator, "f");
        push_usize(&out, index);
        return out;
    }
    
    /* ************* Methods Helpers ************* */

    fn interface_method_ret_type(
        self: Self*,
        interface_decl_id: cir::InterfaceDeclId,
        index: usize,
        call_type_args: const cir::TypeArgs*
    ) String {
        switch (self->tables->interfaces.get_const(interface_decl_id)) {
            case .Some(interface_) => {
                switch (interface_->methods.entries.get_const(index)) {
                    case .Some(entry) => {
                        switch (self->tables->methods.get_const(entry->id)) {
                            case .Some(method) => {
                                var ret_type = method->func_decl.ret_type;

                                if (interface_->is_generic() && !call_type_args->is_empty()) {
                                    ret_type = cir::substitute_sema_type_with_type_args(
                                        self->allocator,
                                        &ret_type,
                                        &interface_->generic_params,
                                        call_type_args
                                    );
                                }

                                self->types.ensure_named(&ret_type);
                                return self->types.type_name(&ret_type);
                            }
                            else => {}
                        }
                    }
                    else => {}
                }
            }
            else => {}
        }

        return String.from_str(self->allocator, "void");
    }

    /* ************* LIBC Helpers ************* */

    fn ensure_memcpy_proto(self: Self*) {
        if (self->needs_memcpy_proto) {
            return;
        }

        self->needs_memcpy_proto = true;
        self->needs_stddef_header = true;
        self->libc_protos.push_str("void *memcpy(void *dest, const void *src, size_t n);\n");
    }

    fn ensure_memset_proto(self: Self*) {
        if (self->needs_memset_proto) {
            return;
        }

        self->needs_memset_proto = true;
        self->needs_stddef_header = true;
        self->libc_protos.push_str("void *memset(void *s, int c, size_t n);\n");
    }

    fn ensure_abort_proto(self: Self*) {
        if (self->needs_abort_proto) {
            return;
        }

        self->needs_abort_proto = true;
        self->libc_protos.push_str("void abort(void);\n");
    }

    fn ensure_write_proto(self: Self*) {
        if (self->needs_write_proto) {
            return;
        }

        self->needs_write_proto = true;
        self->libc_protos.push_str("extern long write(int fd, const void *buf, unsigned long n);\n");
    }

    fn ensure_strcmp_proto(self: Self*) {
        if (self->needs_strcmp_proto) {
            return;
        }

        self->needs_strcmp_proto = true;
        self->libc_protos.push_str("int strcmp(const char *s1, const char *s2);\n");
    }

    // Glibc exposes `errno` as a thread-local object. 
    //
    // TCC emits a GOT data relocation for plain `extern int errno;` 
    // which the dynamic linker leaves as NULL for TLS symbols,
    // so every access must go through __errno_location() instead.
    fn ensure_errno_location_proto(self: Self*) {
        if (self->needs_errno_location_proto) {
            return;
        }

        self->needs_errno_location_proto = true;
        self->libc_protos.push_str("int *__errno_location(void);\n");
    }

    fn note_panic_use(self: Self*) {
        self->needs_panic_helper = true;
        self->ensure_write_proto();
        self->ensure_abort_proto();
    }

    fn note_assert_use(self: Self*) {
        self->needs_assert_helper = true;
        self->ensure_write_proto();
        self->ensure_abort_proto();
    }

    /* ************* Free ************* */

    pub fn free(self: Self*) {
        self->types.free();
        self->protos_out.free();
        self->global_out.free();
        self->pending_out.free();
        self->body_out.free();
        self->ctor_out.free();
        self->libc_protos.free();

        for (var i: usize = 0; i < self->defer_scopes.len(); i += 1) {
            self->defer_scopes.get(i).unwrap()->free();
        }

        self->defer_scopes.free();
        self->loop_marks.free();
        self->vtable_emitted.free();
        self->func_proto_emitted.free();

        for (var i: usize = 0; i < self->generic_object_names.len(); i += 1) {
            self->generic_object_names.get(i).unwrap()->free();
        }

        self->generic_object_names.free();

        self->switch_binding_names.free();

        for (var i: usize = 0; i < self->switch_binding_owned.len(); i += 1) {
            self->switch_binding_owned.get(i).unwrap()->free();
        }

        self->switch_binding_owned.free();

        for (var i: usize = 0; i < self->fn_scope_names.len(); i += 1) {
            self->fn_scope_names.get(i).unwrap()->free();
        }

        self->fn_scope_names.free();
        self->fn_var_renames.free();

        for (var i: usize = 0; i < self->fn_renames_owned.len(); i += 1) {
            self->fn_renames_owned.get(i).unwrap()->free();
        }

        self->fn_renames_owned.free();

        for (var i: usize = 0; i < self->fn_ctx_owned.len(); i += 1) {
            self->fn_ctx_owned.get(i).unwrap()->free();
        }

        self->fn_ctx_owned.free();
    }
}

/* ************* Helpers ************* */

/// Libc symbols that the emitter already declare 
/// with their canonical signatures.
fn is_emitter_libc_name(name: const uint8*) bool {
    return name == "strcmp"
        || name == "memcpy"
        || name == "memset"
        || name == "abort"
        || name == "write";
}

fn resolve_var_type(var_: const cir::VarStmt*) Option<cir::SemaType> {
    switch (var_->ty) {
        case .Some(ty) => return .Some(ty);
        else => {}
    }

    switch (var_->rhs) {
        case .Some(rhs) => {
            switch (rhs.ty) {
                case .Some(ty) => return .Some(ty);
                else => {}
            }
        }
        else => {}
    }

    return .None;
}

fn signed_int_c_name(plain: const cir::PlainType*) Option<const uint8*> {
    switch (*plain) {
        case .Int8 | .UInt8 => return .Some("int8_t");
        case .Int16 | .UInt16 => return .Some("int16_t");
        case .Int32 | .UInt32 => return .Some("int32_t");
        case .Int64 | .UInt64 => return .Some("int64_t");
        else => return .None;
    }
}

/// True when the raw null-terminated template line
/// already ends in a newline character.
fn asm_raw_ends_with_newline(raw: const uint8*) bool {
    var len: usize = 0;

    while (raw[len] != '\0') {
        len += 1;
    }

    if (len == 0) {
        return false;
    }

    return raw[len - 1] == '\n';
}

[[inline]]
fn push_usize(out: String*, value: usize) {
    format_usize(dynamic StringWriter.new(out), value);
}

fn push_uint32(out: String*, value: uint32) {
    format_uint32(dynamic StringWriter.new(out), value);
}

fn push_uint128(out: String*, value: uint128) {
    format_uint128(dynamic StringWriter.new(out), value);
}

fn push_int128(out: String*, value: int128) {
    format_int128(dynamic StringWriter.new(out), value);
}

/* ************* Debug Helpers ************* */

fn panic_unlowered(
    emitter: Emitter*, 
    expr: const cir::Expr*, 
    kind_name: const uint8*
) {
    var mesg = String.from_str(emitter->allocator, "unlowered expr ");
    mesg.push_str(kind_name);

    if (emitter->sctx != null) {
        const source = emitter->sctx->get(expr->span.source_id);

        if (source != null) {
            mesg.push_str(" at ");
            mesg.push_str(source->path.as_str_const());
            mesg.push(':');

            switch (source->nearest_line(expr->span.loc.start)) {
                case .Some(line) => push_usize(&mesg, line);
                else => mesg.push_str("?");
            }
        }
    }

    @panic(mesg.as_str_const());
}