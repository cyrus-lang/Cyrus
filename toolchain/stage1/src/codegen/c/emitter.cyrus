pub struct Emitter {
    pub allocator: Allocator,
    pub arena: ArenaAllocator,
    pub tables: DeclTables*,
    pub registry: GlobalSymbolRegistry*,
    pub trees: const Vec<cir::ProgramTree>*,
    pub vtables: VTableRegistry*,
    pub monomorphs: MonomorphRegistry*,
    pub types: TypeEmitter,
    pub sctx: const SourceContext*,

    libc_protos: String,
    pending_out: String,
    lambda_defs: String,
    protos_out: String,
    global_out: String,
    body_out: String,
    ctor_out: String,

    defer_scopes: Vec<Vec<cir::DeferStmt>>,
    vtable_emitted: HashMap<usize, uint8>,
    func_proto_emitted: Vec<uint8>,
    loop_marks: Vec<usize>,
    generic_object_names: Vec<String>,
    switch_binding_names: HashMap<usize, String>,
    switch_binding_owned: Vec<String>,
    fn_var_renames: HashMap<usize, String>,
    fn_scope_names: Vec<String>,
    fn_renames_owned: Vec<String>,
    cur_func_name: Option<String>,
    cur_method_name: Option<String>,
    cur_ret_type: Option<cir::SemaType>,
    fn_ctx_owned: Vec<String>,
    label_depth_ids: Vec<usize>,
    label_depths: Vec<usize>,

    tuple_export_id: usize,
    lambda_id: usize,

    needs_panic_helper: bool,
    needs_assert_helper: bool,
    needs_math_header: bool,
    needs_bitop_helpers: bool,
    needs_memcpy_proto: bool,
    needs_memmove_proto: bool,
    needs_memcmp_proto: bool,
    needs_memset_proto: bool,
    needs_stddef_header: bool,
    needs_strcmp_proto: bool,
    needs_errno_location_proto: bool,

    in_void_main: bool,
    builtin_temp_id: usize,
    test_cases: Vec<cir::BuiltinBlock>,

    pub fn new(
        allocator: Allocator,
        tables: DeclTables*,
        registry: GlobalSymbolRegistry*,
        trees: const Vec<cir::ProgramTree>*,
        vtables: VTableRegistry*,
        monomorphs: MonomorphRegistry*,
        maps: mangle::ModuleMaps,
        sctx: const SourceContext*,
        target: TargetInfo
    ) Self {
        var func_proto_emitted: Vec<uint8> = Vec.new(allocator);

        func_proto_emitted.resize(tables->funcs.len(), 0);

        const arena = ArenaAllocator.new(allocator, 65536);

        return Self {
            allocator,
            arena,
            tables,
            registry,
            sctx,
            trees,
            vtables,
            monomorphs,
            func_proto_emitted,
            vtable_emitted: HashMap.with_hasher(allocator, 16, hash_usize, eq_usize),
            types: TypeEmitter.new(allocator, tables, registry, maps, target),
            pending_out: String.new(allocator),
            lambda_defs: String.new(allocator),
            protos_out: String.new(allocator),
            global_out: String.new(allocator),
            defer_scopes: Vec.new(allocator),
            body_out: String.new(allocator),
            ctor_out: String.new(allocator),
            libc_protos: String.new(allocator),
            loop_marks: Vec.new(allocator),
            needs_stddef_header: false,
            needs_assert_helper: false,
            needs_math_header: false,
            needs_bitop_helpers: false,
            needs_memcpy_proto: false,
            needs_memmove_proto: false,
            needs_memcmp_proto: false,
            needs_memset_proto: false,
            needs_strcmp_proto: false,
            needs_panic_helper: false,
            needs_errno_location_proto: false,
            generic_object_names: Vec.new(allocator),
            switch_binding_owned: Vec.new(allocator),
            switch_binding_names: HashMap.with_hasher(allocator, 16, hash_usize, eq_usize),
            fn_var_renames: HashMap.with_hasher(allocator, 16, hash_usize, eq_usize),
            fn_renames_owned: Vec.new(allocator),
            fn_scope_names: Vec.new(allocator),
            fn_ctx_owned: Vec.new(allocator),
            label_depth_ids: Vec.new(allocator),
            label_depths: Vec.new(allocator),
            cur_method_name: .None,
            cur_func_name: .None,
            cur_ret_type: .None,
            in_void_main: false,
            builtin_temp_id: 0,
            test_cases: Vec.new(allocator),
            tuple_export_id: 0,
            lambda_id: 0,
        };
    }

    fn collect_toplevel(self: Self*, tree: const cir::ProgramTree*, out: Vec<cir::Stmt>*) {
        for (var j: usize = 0; j < tree->body_len(); j += 1) {
            self->push_toplevel_stmt(tree->body_get_const(j), out);
        }
    }

    fn push_toplevel_stmt(self: Self*, stmt: const cir::Stmt*, out: Vec<cir::Stmt>*) {
        switch (stmt->kind) {
            case .Builtin(builtin) => {
                switch (builtin) {
                    case .BuiltinBlock(block) => {
                        if (block.args.len() > 0) {
                            if (self->types.maps.test_profile && block.is_active &&
                                block.name.str.as_str_const() == "test")
                            {
                                self->test_cases.push(block);
                            }
                            return;
                        }

                        if (block.is_active) {
                            self->push_toplevel_block(block.block, out);
                        }
                    }
                    case .BuiltinFunc(_) => {
                        out->push(*stmt);
                    }
                }
            }
            else => {
                out->push(*stmt);
            }
        }
    }

    fn push_toplevel_block(self: Self*, block: const cir::BlockStmt*, out: Vec<cir::Stmt>*) {
        for (var i: usize = 0; i < block->stmts.len(); i += 1) {
            self->push_toplevel_stmt(block->stmts.get_const(i).unwrap(), out);
        }
    }

    /// Emits a function definition nested in a statement list at file scope,
    /// where C requires it (and where the already-emitted prototype is in
    /// scope).
    fn emit_nested_func(self: Self*, func_def: const cir::FuncDefStmt*) {
        if (func_def->is_generic()) {
            return;
        }

        const parent = self->body_out;
        self->body_out = String.new(self->allocator);

        var saved_defer_scopes = self->defer_scopes;
        self->defer_scopes = Vec.new(self->allocator);

        var saved_loop_marks = self->loop_marks;
        self->loop_marks = Vec.new(self->allocator);

        self->emit_func(func_def);

        for (var i: usize = 0; i < self->defer_scopes.len(); i += 1) {
            self->defer_scopes.get(i).unwrap()->free();
        }
        self->defer_scopes.free();
        self->defer_scopes = saved_defer_scopes;

        self->loop_marks.free();
        self->loop_marks = saved_loop_marks;

        self->lambda_defs.push_str(self->body_out.as_str_const());
        self->body_out.free();
        self->body_out = parent;
    }

    pub fn run(self: Self*, writer: Writer) {
        var top: Vec<cir::Stmt> = Vec.new(self->allocator);

        for (var i: usize = 0; i < self->trees->len(); i += 1) {
            const tree = self->trees->get_const(i).unwrap();
            self->collect_toplevel(tree, &top);
        }
        defer top.free();

        // 1. Top-level type declaration
        for (var j: usize = 0; j < top.len(); j += 1) {
                const stmt = top.get_const(j).unwrap();

                switch (stmt->kind) {
                    case .Struct(struct_) => {
                        const struct_decl = self->tables->structs.get_const(struct_.struct_decl_id).unwrap();
                        
                        if (struct_decl->is_generic()) {
                            self->generic_object_names.push(String.from_str(
                                self->allocator, 
                                struct_.name.as_str_const()
                            ));
                            continue;
                        }

                        for (var i: usize = 0; i < struct_decl->fields.len(); i += 1) {
                            const field = struct_decl->fields.get_const(i).unwrap();
                            self->types.ensure_named(&field->ty);
                        }
                    }
                    case .Union(union_) => {
                        const union_decl = self->tables->unions.get_const(union_.union_decl_id).unwrap();

                        if (union_decl->is_generic()) {
                            self->generic_object_names.push(String.from_str(
                                self->allocator,
                                union_.name.as_str_const()
                            ));
                            continue;
                        }

                        for (var i: usize = 0; i < union_decl->fields.len(); i += 1) {
                            const field = union_decl->fields.get_const(i).unwrap();
                            self->types.ensure_named(&field->ty);
                        }
                    }
                    case .Enum(enum_) => {
                        var is_generic_enum = false;

                        switch (self->tables->enums.get_const(enum_.enum_decl_id)) {
                            case .Some(enum_decl) => {
                                if (enum_decl->is_generic()) {
                                    is_generic_enum = true;
                                }
                            }
                            else => {}
                        }

                        if (is_generic_enum) {
                            self->generic_object_names.push(String.from_str(
                                self->allocator,
                                enum_.name.as_str_const()
                            ));
                            continue;
                        }

                        const type_decl_id: cir::TypeDeclId = .Enum(enum_.enum_decl_id);
                        self->types.ensure_type_decl(&type_decl_id);
                    }
                    case .Typedef(td) => {
                        const type_decl_id: cir::TypeDeclId = .Typedef(td.typedef_decl_id);
                        self->types.ensure_type_decl(&type_decl_id);
                    }
                else => {}
            }
        }

        // 2. Global Vars
        for (var j: usize = 0; j < top.len(); j += 1) {
                const stmt = top.get_const(j).unwrap();

                switch (stmt->kind) {
                    case .GlobalVar(global_var) => {
                        self->emit_global(&global_var);
                    }
                else => {}
            }
        }

        // 3. Function and method definitions
        for (var j: usize = 0; j < top.len(); j += 1) {
                const stmt = top.get_const(j).unwrap();
                
                switch (stmt->kind) {
                    case .FuncDef(func_def) => {
                        if (!func_def.is_generic()) {
                            self->emit_func(&func_def);
                        }
                    }
                else => {}
            }
        }

        for (var i: usize = 0; i < self->tables->methods.len(); i += 1) {
            const method = self->tables->methods.get_const(i).unwrap();

            if (!method->is_active || method->func_decl.is_generic()) {
                continue;
            }

            switch (method->object_name) {
                case .Some(obj_name) => {
                    var is_generic_object = false;

                    for (var k: usize = 0; k < self->generic_object_names.len(); k += 1) {
                        const existing = self->generic_object_names.get_const(k).unwrap();

                        if (existing->as_str_const() == obj_name.as_str_const()) {
                            is_generic_object = true;
                            break;
                        }
                    }

                    if (is_generic_object) {
                        continue;
                    }
                }
                else => {}
            }
            
            switch (method->body) {
                case .Some(body_id) => {
                    self->emit_method(i, method, body_id);
                }
                else => {}
            }
        }

        // 4. Monomorphized specializations
        for (var i: usize = 0; i < self->monomorphs->instances.len(); i += 1) {
            const inst = self->monomorphs->instances.get_const(i).unwrap();

            switch (inst->body) {
                case .Some(body_id) => {
                    self->emit_func_inst(i, inst, body_id);
                }
                else => {}
            }
        }

        if (self->types.maps.test_profile) {
            self->emit_test_runner();
        }

        self->assemble(writer);
    }

    fn emit_test_runner(self: Self*) {
        self->protos_out.push_str(
            "struct __cyrus_test_case{const char*name;const char*file;unsigned long line;void(*run)(void);};"
        );
        self->protos_out.push_str(
            "int __cyrus_run_tests(const struct __cyrus_test_case*,unsigned long);"
        );

        for (var test_index: usize = 0; test_index < self->test_cases.len(); test_index += 1) {
            const test_case = self->test_cases.get_const(test_index).unwrap();
            var test_name = String.from_str(self->allocator, "__cyrus_test_");
            push_usize(&test_name, test_index);

            self->body_out.push_str("static void ");
            self->body_out.push_str(test_name.as_str_const());
            self->body_out.push_str("(void){");

            var saved_func_name = self->cur_func_name;
            var saved_method_name = self->cur_method_name;
            var saved_ret_type = self->cur_ret_type;

            const case_name = test_case->args.get_const(0).unwrap()->literal_const_string_value().unwrap();
            self->set_name_context(.Some(case_name), .None);
            self->cur_ret_type = .Some(.Plain(.Void));
            self->begin_label_scan();
            self->scan_func_labels(test_case->block, true);
            self->emit_block_stmts(test_case->block, true);

            self->cur_func_name = saved_func_name;
            self->cur_method_name = saved_method_name;
            self->cur_ret_type = saved_ret_type;
            self->body_out.push('}');
            test_name.free();
        }

        if (self->test_cases.len() == 0) {
            self->body_out.push_str("int main(void){return __cyrus_run_tests(0,0);}");
            return;
        }

        self->body_out.push_str("static const struct __cyrus_test_case __cyrus_tests[]={");
        for (var test_index: usize = 0; test_index < self->test_cases.len(); test_index += 1) {
            const test_case = self->test_cases.get_const(test_index).unwrap();
            const case_name = test_case->args.get_const(0).unwrap()->literal_const_string_value().unwrap();
            var quoted_name = self->quoted_cstr(case_name);
            self->body_out.push('{');
            self->body_out.push_str(quoted_name.as_str_const());
            quoted_name.free();
            self->body_out.push(',');

            switch (self->tree_for_source(test_case->span.source_id)) {
                case .Some(tree) => {
                    var path = self->quoted_cstr(tree->file_name.as_str_const());
                    self->body_out.push_str(path.as_str_const());
                    path.free();
                }
                case .None => self->body_out.push_str("\"<unknown>\"");
            }
            self->body_out.push(',');

            var line: usize = 0;
            if (self->sctx != null) {
                const source = self->sctx->get(test_case->span.source_id);
                line = source->nearest_line(test_case->span.loc.start).unwrap_or(0);
            }
            push_usize(&self->body_out, line);
            self->body_out.push(',');
            self->body_out.push_str("__cyrus_test_");
            push_usize(&self->body_out, test_index);
            self->body_out.push_str("},");
        }
        self->body_out.push_str("};int main(void){return __cyrus_run_tests(__cyrus_tests,");
        push_usize(&self->body_out, self->test_cases.len());
        self->body_out.push_str(");}");
    }

    fn emit_int128_decls(self: Self*, writer: Writer) {
        writer.write("typedef struct{uint64_t lo;int64_t hi;}__cyrus_int128;");
        writer.write("typedef struct{uint64_t lo;uint64_t hi;}__cyrus_uint128;");
        writer.write("__cyrus_uint128 __cyrus_u128_from_u64(uint64_t lo);");
        writer.write("__cyrus_uint128 __cyrus_u128_of_i128(__cyrus_int128 a);");
        writer.write("__cyrus_int128 __cyrus_i128_from_i64(int64_t v);");
        writer.write("__cyrus_int128 __cyrus_i128_of_u128(__cyrus_uint128 a);");
        writer.write("uint64_t __cyrus_u128_to_u64(__cyrus_uint128 a);");
        writer.write("uint64_t __cyrus_i128_to_u64(__cyrus_int128 a);");
        writer.write("int __cyrus_u128_iszero(__cyrus_uint128 a);");
        writer.write("int __cyrus_i128_iszero(__cyrus_int128 a);");
        writer.write("int __cyrus_u128_cmp(__cyrus_uint128 a,__cyrus_uint128 b);");
        writer.write("int __cyrus_i128_cmp(__cyrus_int128 a,__cyrus_int128 b);");
        writer.write("__cyrus_uint128 __cyrus_u128_add(__cyrus_uint128 a,__cyrus_uint128 b);");
        writer.write("__cyrus_uint128 __cyrus_u128_sub(__cyrus_uint128 a,__cyrus_uint128 b);");
        writer.write("__cyrus_uint128 __cyrus_u128_band(__cyrus_uint128 a,__cyrus_uint128 b);");
        writer.write("__cyrus_uint128 __cyrus_u128_bor(__cyrus_uint128 a,__cyrus_uint128 b);");
        writer.write("__cyrus_uint128 __cyrus_u128_bxor(__cyrus_uint128 a,__cyrus_uint128 b);");
        writer.write("__cyrus_uint128 __cyrus_u128_bnot(__cyrus_uint128 a);");
        writer.write("__cyrus_uint128 __cyrus_u128_neg(__cyrus_uint128 a);");
        writer.write("__cyrus_uint128 __cyrus_u128_shl(__cyrus_uint128 a,uint64_t n_);");
        writer.write("__cyrus_uint128 __cyrus_u128_shr(__cyrus_uint128 a,uint64_t n_);");
        writer.write("__cyrus_int128 __cyrus_i128_shr(__cyrus_int128 a,uint64_t n_);");
        writer.write("__cyrus_uint128 __cyrus_u128_mul(__cyrus_uint128 a,__cyrus_uint128 b);");
        writer.write("__cyrus_uint128 __cyrus_u128_div(__cyrus_uint128 a,__cyrus_uint128 b);");
        writer.write("__cyrus_uint128 __cyrus_u128_mod(__cyrus_uint128 a,__cyrus_uint128 b);");
        writer.write("__cyrus_int128 __cyrus_i128_add(__cyrus_int128 a,__cyrus_int128 b);");
        writer.write("__cyrus_int128 __cyrus_i128_sub(__cyrus_int128 a,__cyrus_int128 b);");
        writer.write("__cyrus_int128 __cyrus_i128_mul(__cyrus_int128 a,__cyrus_int128 b);");
        writer.write("__cyrus_int128 __cyrus_i128_shl(__cyrus_int128 a,uint64_t n);");
        writer.write("__cyrus_int128 __cyrus_i128_band(__cyrus_int128 a,__cyrus_int128 b);");
        writer.write("__cyrus_int128 __cyrus_i128_bor(__cyrus_int128 a,__cyrus_int128 b);");
        writer.write("__cyrus_int128 __cyrus_i128_bxor(__cyrus_int128 a,__cyrus_int128 b);");
        writer.write("__cyrus_int128 __cyrus_i128_bnot(__cyrus_int128 a);");
        writer.write("__cyrus_int128 __cyrus_i128_neg(__cyrus_int128 a);");
        writer.write("__cyrus_int128 __cyrus_i128_div(__cyrus_int128 a,__cyrus_int128 b);");
        writer.write("__cyrus_int128 __cyrus_i128_mod(__cyrus_int128 a,__cyrus_int128 b);");
    }

    fn assemble(self: Self*, parent: Writer) {
        var module = String.new(self->allocator);
        var writer: Writer = dynamic StringWriter.new(&module);

        if (self->types.used_stdint) {
            writer.write("#include <stdint.h>\n");
        }

        if (self->types.used_bool) {
            writer.write("#include <stdbool.h>\n");
        }

        if (self->needs_stddef_header) {
            writer.write("#include <stddef.h>\n");
        }

        if (self->needs_math_header) {
            writer.write("#include <math.h>\n");
        }

        if (self->needs_bitop_helpers) {
            writer.write("#include <stdint.h>\n");
            writer.write(
                "static inline uint64_t __cyrus_bswap64_(uint64_t x){return ((x&0xFFull)<<56)|((x&0xFF00ull)<<40)|((x&0xFF0000ull)<<24)|((x&0xFF000000ull)<<8)|((x>>8)&0xFF000000ull)|((x>>24)&0xFF0000ull)|((x>>40)&0xFF00ull)|((x>>56)&0xFFull);}\n"
            );
            writer.write(
                "static inline uint64_t __cyrus_bitrev64_(uint64_t x){x=((x>>1)&0x5555555555555555ull)|((x&0x5555555555555555ull)<<1);x=((x>>2)&0x3333333333333333ull)|((x&0x3333333333333333ull)<<2);x=((x>>4)&0x0F0F0F0F0F0F0F0Full)|((x&0x0F0F0F0F0F0F0F0Full)<<4);x=((x>>8)&0x00FF00FF00FF00FFull)|((x&0x00FF00FF00FF00FFull)<<8);x=((x>>16)&0x0000FFFF0000FFFFull)|((x&0x0000FFFF0000FFFFull)<<16);return (x>>32)|(x<<32);}\n"
            );
        }

        if (self->libc_protos.len() > 0) {
            writer.write(self->libc_protos.as_str_const());
        }

        if (self->needs_panic_helper || self->needs_assert_helper) {
            writer.write("void __cyrus_fail_(const char*kind,const char*prefix,const char*file,int line,int col,const char*mesg);");
        }

        if (self->types.used_float16) {
            writer.write("float __cyrus_f16_round(double d);");
        }

        if (self->types.used_int128) {
            self->emit_int128_decls(writer);
        }

        self->types.drain_deferred();

        writer.write(self->types.type_out.as_str_const());
        writer.write(self->protos_out.as_str_const());
        writer.write(self->global_out.as_str_const());

        if (self->ctor_out.len() > 0) {
            writer.write("static void __cyrus_global_ctors(void) __attribute__((constructor));");
            writer.write("static void __cyrus_global_ctors(void){");
            writer.write(self->ctor_out.as_str_const());
            writer.write("}");
        }

        writer.write(self->pending_out.as_str_const());
        writer.write(self->lambda_defs.as_str_const());
        writer.write(self->body_out.as_str_const());

        parent.write(module.as_str_const());
        module.free();
    }

    /* ************* Globals ************* */

    fn emit_global(self: Self*, global_var: const cir::GlobalVarStmt*) {
        if (!global_var->is_static && !global_var->is_const) {
            return;
        }

        var name = mangle::mangle_global(
            self->allocator,
            &self->types.maps,
            global_var->name.as_str_const(),
            global_var->global_var_decl_id,
            &global_var->modifiers
        );

        switch (global_var->modifiers.extern_) {
            case .Some(extern_) => {
                switch (extern_) {
                    case .C => {
                        // Extern declaration only
                        if (name.as_str_const() == "errno") {
                            // TLS object: 
                            // accessed via (*__errno_location())
                            self->ensure_errno_location_proto();
                            name.free();
                            return;
                        }

                        switch (global_var->ty) {
                            case .Some(ty) => {
                                self->types.ensure_named(&ty);

                                var decl = self->types.build_decl(&ty, name.as_str_const());
                                
                                self->global_out.push_str("extern ");
                                self->global_out.push_str(decl.as_str_const());
                                self->global_out.push(';');
                                
                                decl.free();
                                name.free();
                                return;
                            }
                            else => {
                                name.free();
                                return;
                            }
                        }
                    }
                    else => {}
                }
            }
            else => {}
        }

        switch (global_var->ty) {
            case .Some(ty) => {
                self->types.ensure_named(&ty);

                if (global_var->is_const) {
                    var emit_const = true;
                    switch (ty) {
                        case .Const => emit_const = false;
                        else => {}
                    }
                    switch (*ty.const_inner()) {
                        case .Pointer | .Array => emit_const = false;
                        else => {}
                    }
                    if (emit_const) {
                        self->global_out.push_str("const ");
                    }
                }

                var decl = self->types.build_decl(&ty, name.as_str_const());

                switch (global_var->rhs) {
                    case .Some(rhs) => {
                        if (rhs.is_comptime_expr()) {
                            self->global_out.push_str(decl.as_str_const());
                            self->global_out.push('=');
                            
                            var init = self->emit_global_init(&rhs, &ty);
                            self->global_out.push_str(init.as_str_const());
                            self->global_out.push(';');
                            init.free();
                        } else {
                            // Zero-init
                            self->global_out.push_str(decl.as_str_const());
                            self->global_out.push_str("={0};");

                            self->ctor_out.push_str(name.as_str_const());
                            self->ctor_out.push('=');
                            
                            var expr = self->emit_expr(&rhs);
                            self->ctor_out.push_str(expr.as_str_const());
                            self->ctor_out.push(';');
                            expr.free();
                        }
                    }
                    case .None => {
                        self->global_out.push_str(decl.as_str_const());
                        self->global_out.push(';');
                    }
                }

                decl.free();
            }
            case .None => {}
        }

        name.free();
    }

    fn emit_global_init(self: Self*, expr: const cir::Expr*, ty: const cir::SemaType*) String {
        switch (expr->kind) {
            case .Literal(literal) => {
                return self->emit_literal(&literal);
            }

            case .StructInit(struct_init) => {
                var out = String.from_str(self->allocator, "{");

                for (var i: usize = 0; i < struct_init.fields.len(); i += 1) {
                    const field = struct_init.fields.get_const(i).unwrap();

                    out.push('.');
                    mangle::sanitize_into(&out, field->name.as_str_const());
                    out.push('=');
                    
                    switch (field->value.ty) {
                        case .Some(ty) => {
                            var global_var = self->emit_global_init(&field->value, &ty);
                            out.push_str(global_var.as_str_const());
                            global_var.free();
                        }
                        case .None => {
                            var expr = self->emit_expr(&field->value);
                            out.push_str(expr.as_str_const());
                            expr.free();
                        }
                    }
                    
                    if (i + 1 < struct_init.fields.len()) {
                        out.push(',');
                    }
                }

                out.push('}');
                return out;
            }

            case .UnionInit(union_init) => {
                var out = String.from_str(self->allocator, "{.");
                mangle::sanitize_into(&out, union_init.field->name.as_str_const());
                out.push('=');
                
                var expr = self->emit_expr(&union_init.field->value);
                out.push_str(expr.as_str_const());
                expr.free();
                
                out.push('}');
                return out;
            }

            case .Array(array) => {
                var out = String.from_str(self->allocator, "{");
                
                for (var i: usize = 0; i < array.elements.len(); i += 1) {
                    const element = array.elements.get_const(i).unwrap();

                    switch (element->kind) {
                        case .Array(array2) => {
                            var braces = self->emit_array_braces(&array2);
                            out.push_str(braces.as_str_const());
                            braces.free();
                        }
                        else => {
                            var expr = self->emit_expr(element);
                            out.push_str(expr.as_str_const());
                            expr.free();
                        }
                    }

                    if (i + 1 < array.elements.len()) {
                        out.push(',');
                    }
                }
                
                out.push('}');
                return out;
            }

            case .Tuple(tuple) => {
                var out = String.from_str(self->allocator, "{");

                for (var i: usize = 0; i < tuple.elements.len(); i += 1) {
                    const element = tuple.elements.get_const(i).unwrap();
                    
                    var expr = self->emit_expr(element);
                    out.push_str(expr.as_str_const());
                    expr.free();
                    
                    if (i + 1 < tuple.elements.len()) {
                        out.push(',');
                    }
                }

                out.push('}');
                return out;
            }

            case .EnumInit(enum_init) => {
                switch (enum_init.operand) {
                    case .Named(named) => {
                        switch (named.type_decl_id) {
                            case .Enum(id) => {
                                const enum_decl = self->tables->enums.get_const(id).unwrap();
                                const is_scalar = is_enum_scalar_optimizable(self->tables, enum_decl);
                                const tags = self->types.tctx.enum_variant_tags(id, enum_decl);

                                const tag = enum_decl->find_variant_tag(
                                    tags, 
                                    enum_init.name.as_str_const()
                                );

                                if (is_scalar) {
                                    var out = String.new(self->allocator);

                                    switch (enum_init.arg) {
                                        case .Unit => {}

                                        case .Tuple(exprs) => {
                                            if (exprs.len() == 1) {
                                                const element = exprs.get_const(0).unwrap();
                                                
                                                var expr = self->emit_expr(element);
                                                out.push_str(expr.as_str_const());
                                                expr.free();
                                            }
                                        }

                                        else => {}
                                    }
                                    
                                    if (out.len() == 0) {
                                        push_uint32(&out, tag);
                                    }
                                    
                                    return out;
                                }
                            }
                            else => {}
                        }
                    }
                    else => {}
                }

                return self->emit_enum_init(&enum_init);
            }

            else => {
                return self->emit_expr(expr);
            }
        }
    }

    /* ************* Prototypes and definitions ************* */

    fn ensure_func_decl_proto(
        self: Self*, 
        func_decl_id: cir::FuncDeclId, 
        decl: const cir::FuncDecl*
    ) {
        if (!decl->is_func_decl) {
            return;
        }

        if (func_decl_id >= self->func_proto_emitted.len()) {
            self->func_proto_emitted.resize(func_decl_id + 1, 0);
        }

        switch (self->func_proto_emitted.get(func_decl_id)) {
            case .Some(emitted_flag) => {
                if (*emitted_flag != 0) {
                    return;
                }
                *emitted_flag = 1;
            }
            else => return;
        }

        var mangled_name = mangle::mangle_func(
            self->allocator,
            &self->types.maps,
            decl->name.as_str_const(),
            func_decl_id,
            &decl->modifiers
        );

        // Prevent collisions between 
        // codegen libc declarations
        // and language libc declarations
        const name = mangled_name.as_str_const();

        if (name == "strcmp") {
            self->ensure_strcmp_proto();
            mangled_name.free();
            return;
        }

        if (name == "memmove") {
            self->ensure_memmove_proto();
            mangled_name.free();
            return;
        }

        if (name == "memcpy") {
            self->ensure_memcpy_proto();
            mangled_name.free();
            return;
        }

        if (name == "memset") {
            self->ensure_memset_proto();
            mangled_name.free();
            return;
        }

        var sig = self->build_func_signature(
            &decl->ret_type,
            &decl->params,
            mangled_name.as_str_const()
        );

        self->protos_out.push_str(sig.as_str_const());
        self->protos_out.push(';');
        
        mangled_name.free();
        sig.free();
    }

    fn emit_func(self: Self*, func_def: const cir::FuncDefStmt*) {
        const func_decl_id = func_def->func_decl_id.unwrap();

        var name = mangle::mangle_func(
            self->allocator,
            &self->types.maps,
            func_def->name.as_str_const(),
            func_decl_id,
            &func_def->modifiers
        );

        const is_void_main = name.as_str_const() == "main"
            && func_def->ret_type.is_void();

        const int32_type: cir::SemaType = .Plain(.Int32);

        var ret_type_ptr: const cir::SemaType* = &func_def->ret_type;
        
        if (is_void_main) {
            ret_type_ptr = &int32_type;
        }

        var sig = self->build_func_signature(
            ret_type_ptr, 
            &func_def->params, 
            name.as_str_const()
        );

        self->protos_out.push_str(sig.as_str_const());
        self->protos_out.push(';');

        self->body_out.push_str(sig.as_str_const());
        self->body_out.push('{');
        sig.free();

        var saved_func_name = self->cur_func_name;
        var saved_method_name = self->cur_method_name;
        var saved_ret_type = self->cur_ret_type;
        var saved_in_void_main = self->in_void_main;
        self->set_name_context(.Some(func_def->name.as_str_const()), .None);

        self->emit_param_prologue(&func_def->params);

        self->in_void_main = is_void_main;
        self->cur_ret_type = .Some(*ret_type_ptr);

        self->begin_label_scan();
        self->scan_func_labels(func_def->body, true);

        self->emit_block_stmts(func_def->body, true);

        self->cur_func_name = saved_func_name;
        self->cur_method_name = saved_method_name;
        self->cur_ret_type = saved_ret_type;

        if (self->in_void_main) {
            self->body_out.push_str("return 0;");
        }
        self->in_void_main = saved_in_void_main;

        if (!func_def->ret_type.is_void()) {
            self->body_out.push_str("__builtin_unreachable();");
        }

        self->body_out.push('}');
        name.free();
    }

    fn emit_method(
        self: Self*, 
        method_id: usize, 
        method: const cir::MethodDecl*, 
        body_id: cir::BodyId
    ) {
        var name = mangle::mangle_method(
            self->allocator,
            &self->types.maps,
            method_id, 
            method
        );
        
        const func = &method->func_decl;
        
        var sig = self->build_func_signature(
            &func->ret_type,
            &func->params,
            name.as_str_const()
        );

        self->protos_out.push_str(sig.as_str_const());
        self->protos_out.push(';');

        self->body_out.push_str(sig.as_str_const());
        self->body_out.push('{');
        sig.free();

        var saved_func_name = self->cur_func_name;
        var saved_method_name = self->cur_method_name;
        var saved_ret_type = self->cur_ret_type;
        var saved_in_void_main = self->in_void_main;
        self->set_name_context(.None, .Some(func->name.as_str_const()));
        self->cur_ret_type = .Some(func->ret_type);
        self->in_void_main = false;

        self->emit_param_prologue(&func->params);

        switch (self->tables->bodies.get_const(body_id)) {
            case .Some(body) => {
                self->begin_label_scan();
                self->scan_func_labels(body, true);

                self->emit_block_stmts(body, true);
            }
            else => {}
        }

        self->cur_func_name = saved_func_name;
        self->cur_method_name = saved_method_name;
        self->cur_ret_type = saved_ret_type;
        self->in_void_main = saved_in_void_main;

        if (!func->ret_type.is_void()) {
            self->body_out.push_str("__builtin_unreachable();");
        }

        self->body_out.push('}');
        name.free();
    }

    fn emit_func_inst(
        self: Self*,
        monomorph_id: cir::MonomorphId,
        inst: const MonomorphInstance*,
        body_id: cir::BodyId
    ) {
        var name: String;
        var have_name = false;
        var ctx_name: const uint8*;
        var ctx_is_method = false;

        switch (inst->template_id) {
            case .Func(func_decl_id) => {
                switch (self->tables->funcs.get_const(func_decl_id)) {
                    case .Some(func_decl) => {
                        name = mangle::mangle_monomorphized_func(
                            self->allocator,
                            &self->types.maps,
                            self->tables,
                            func_decl->name.as_str_const(),
                            func_decl_id,
                            &func_decl->modifiers,
                            &inst->type_args
                        );
                        ctx_name = func_decl->name.as_str_const();
                        have_name = true;
                    }
                    else => {}
                }
            }
            case .Method(method_decl_id) => {
                switch (self->tables->methods.get_const(method_decl_id)) {
                    case .Some(method) => {
                        name = mangle::mangle_monomorphized_method(
                            self->allocator,
                            &self->types.maps,
                            self->tables,
                            method_decl_id,
                            method,
                            &inst->type_args
                        );
                        ctx_name = method->func_decl.name.as_str_const();
                        ctx_is_method = true;
                        have_name = true;
                    }
                    else => {}
                }
            }
        }

        if (!have_name) {
            return;
        }

        var sig = self->build_func_signature(&inst->ret_type, &inst->params, name.as_str_const());

        self->protos_out.push_str(sig.as_str_const());
        self->protos_out.push(';');

        self->body_out.push_str(sig.as_str_const());
        self->body_out.push('{');
        sig.free();

        var saved_func_name = self->cur_func_name;
        var saved_method_name = self->cur_method_name;
        var saved_ret_type = self->cur_ret_type;
        var saved_in_void_main = self->in_void_main;

        if (ctx_is_method) {
            self->set_name_context(.None, .Some(ctx_name));
        } else {
            self->set_name_context(.Some(ctx_name), .None);
        }
        self->cur_ret_type = .Some(inst->ret_type);
        self->in_void_main = false;

        self->emit_param_prologue(&inst->params);

        switch (self->tables->bodies.get_const(body_id)) {
            case .Some(body) => {
                self->begin_label_scan();
                self->scan_func_labels(body, true);

                self->emit_block_stmts(body, true);
            }
            else => {}
        }

        self->cur_func_name = saved_func_name;
        self->cur_method_name = saved_method_name;
        self->cur_ret_type = saved_ret_type;
        self->in_void_main = saved_in_void_main;

        if (!inst->ret_type.is_void()) {
            self->body_out.push_str("__builtin_unreachable();");
        }

        self->body_out.push('}');
        name.free();
    }

    fn build_func_signature(
        self: Self*,
        ret_type: const cir::SemaType*,
        params: const cir::FuncParams*,
        name: const uint8*
    ) String {
        self->types.ensure_named(ret_type);

        for (var i: usize = 0; i < params->list.len(); i += 1) {
            const param = params->list.get_const(i).unwrap();
            const ty = param->ty();
            self->types.ensure_named(&ty);
        }

        var param_list = String.new(self->allocator);

        if (params->list.len() == 0) {
            switch (params->variadic) {
                case .Some => {
                    param_list.push_str("...");
                }
                else => {
                    param_list.push_str("void");
                }
            }
        } else {
            for (var i: usize = 0; i < params->list.len(); i += 1) {
                const param = params->list.get_const(i).unwrap();
                
                var name = mangle::sanitized(self->allocator, param->name_str());
                var ty = param->ty();

                switch (ty) {
                    case .Array(array) => {
                        switch (array.capacity) {
                            case .Fixed => {
                                // Arrays are passed as a pointer. The body copies
                                // that pointer into a local array named after the
                                // parameter (see emit_param_prologue), so the
                                // pointer parameter itself gets a `__p`
                                // suffix to avoid a redeclaration
                                ty = .Pointer(array.element_type);
                                name.push_str("__p");
                            }
                            case .Slice | .TerminatedSlice => {}
                        }
                    }
                    else => {}
                }

                var decl = self->types.build_decl(&ty, name.as_str_const());
                param_list.push_str(decl.as_str_const());
                decl.free();
                name.free();

                if (i + 1 < params->list.len()) {
                    param_list.push(',');
                }
            }

            switch (params->variadic) {
                case .Some => {
                    if (params->list.len() > 0) {
                        param_list.push(',');
                    }
                    param_list.push_str("...");
                }
                else => {}
            }
        }

        var full_name = String.from_str(self->allocator, name);
        full_name.push('(');
        full_name.push_str(param_list.as_str_const());
        full_name.push(')');
        param_list.free();

        // C cannot return arrays by value. 
        // Array-returning functions are
        // emitted as returning 
        // a generated struct
        // wrapper instead
        switch (ret_type->as_array_type()) {
            case .Some(array) => {
                switch (array.capacity) {
                    case .Fixed => {
                        var ret_name = self->types.array_return_struct_name(ret_type);

                        var decl = String.new(self->allocator);
                        decl.push_str(ret_name.as_str_const());
                        decl.push(' ');
                        decl.push_str(full_name.as_str_const());

                        ret_name.free();
                        full_name.free();
                        return decl;
                    }
                    case .Slice | .TerminatedSlice => {}
                }
            }
            else => {}
        }

        var decl = self->types.build_decl(
            ret_type,
            full_name.as_str_const()
        );
        full_name.free();
        return decl;
    }

    fn set_name_context(
        self: Self*,
        func_name: Option<const uint8*>,
        method_name: Option<const uint8*>
    ) {
        switch (func_name) {
            case .Some(fname) => {
                var owned = String.from_str(self->allocator, fname);
                self->fn_ctx_owned.push(owned);
                self->cur_func_name = .Some(owned);
            }
            case .None => {
                self->cur_func_name = .None;
            }
        }

        switch (method_name) {
            case .Some(mname) => {
                var name = String.from_str(self->allocator, mname);
                self->fn_ctx_owned.push(name);
                self->cur_method_name = .Some(name);
            }
            case .None => {
                self->cur_method_name = .None;
            }
        }
    }

    fn tree_for_source(self: Self*, source_id: uint32) Option<const cir::ProgramTree*> {
        for (var i: usize = 0; i < self->trees->len(); i += 1) {
            const tree = self->trees->get_const(i).unwrap();

            if (@cast(usize, tree->file_id) == @cast(usize, source_id)) {
                return .Some(tree);
            }
        }

        return .None;
    }

    fn quoted_cstr(self: Self*, text: const uint8*) String {
        var out = String.from_str(self->allocator, "\"");
        push_c_escaped(&out, text);
        out.push('"');
        return out;
    }

    fn builtin_line_column(
        self: Self*,
        builtin_func: const cir::BuiltinFunc*,
        want_column: bool
    ) Option<usize> {
        if (self->sctx == null) {
            return .None;
        }

        const source = self->sctx->get(builtin_func->name.span.source_id);
        const offset = builtin_func->name.span.loc.start;

        switch (source->nearest_line(offset)) {
            case .Some(line) => {
                if (want_column) {
                    return .Some(source->line_offset_to_column(line, offset));
                }

                return .Some(line);
            }
            else => {}
        }

        return .None;
    }

    /// Appends the source location arguments of a builtin:
    /// - "<path>"
    /// - <line>
    /// - <col>
    fn push_builtin_location(self: Self*, out: String*, builtin_func: const cir::BuiltinFunc*) {
        self->push_span_location(out, builtin_func->span);
    }

    fn push_span_location(self: Self*, out: String*, span: Span) {
        switch (self->tree_for_source(span.source_id)) {
            case .Some(tree) => {
                var path = self->quoted_cstr(tree->file_name.as_str_const());
                out->push_str(path.as_str_const());
                path.free();
            }
            else => out->push_str("\"<unknown>\"");
        }

        out->push(',');

        var line: usize = 0;
        var col: usize = 0;
        if (self->sctx != null) {
            const source = self->sctx->get(span.source_id);
            const offset = span.loc.start;
            switch (source->nearest_line(offset)) {
                case .Some(l) => {
                    line = l;
                    col = source->line_offset_to_column(l, offset);
                }
                else => {}
            }
        }

        push_usize(out, line);
        out->push(',');
        push_usize(out, col);
    }

    fn emit_try_dispatch_branch_call(
        self: Self*,
        dispatch: const cir::MethodCallDispatch*,
        operand: const cir::Expr*
    ) String {
        switch (*dispatch) {
            case .Normal { method_decl_id } => {
                switch (self->tables->methods.get_const(method_decl_id)) {
                    case .Some(method) => {
                        var name = mangle::mangle_method(
                            self->allocator,
                            &self->types.maps,
                            method_decl_id,
                            method
                        );
                        var out = String.new(self->allocator);
                        out.push_str(name.as_str_const());
                        out.push('(');
                        self->emit_method_self_argument(&out, method, operand);
                        out.push(')');
                        name.free();
                        return out;
                    }
                    else => {}
                }
            }
            case .Monomorph { monomorph_id, .. } => {
                switch (self->monomorphs->instances.get_const(monomorph_id)) {
                    case .Some(inst) => {
                        switch (inst->template_id) {
                            case .Method(method_decl_id) => {
                                switch (self->tables->methods.get_const(method_decl_id)) {
                                    case .Some(method) => {
                                        var name = mangle::mangle_monomorphized_method(
                                            self->allocator,
                                            &self->types.maps,
                                            self->tables,
                                            method_decl_id,
                                            method,
                                            &inst->type_args
                                        );
                                        var out = String.new(self->allocator);
                                        out.push_str(name.as_str_const());
                                        out.push('(');
                                        self->emit_method_self_argument(&out, method, operand);
                                        out.push(')');
                                        name.free();
                                        return out;
                                    }
                                    else => {}
                                }
                            }
                            else => {}
                        }
                    }
                    else => {}
                }
            }
            else => {}
        }

        return String.from_str(self->allocator, "((void)0)");
    }

    fn emit_try_dispatch_from_error_call(
        self: Self*,
        dispatch: const cir::MethodCallDispatch*,
        err_expr: const uint8*
    ) String {
        switch (*dispatch) {
            case .Normal { method_decl_id } => {
                switch (self->tables->methods.get_const(method_decl_id)) {
                    case .Some(method) => {
                        var name = mangle::mangle_method(
                            self->allocator,
                            &self->types.maps,
                            method_decl_id,
                            method
                        );
                        var out = String.new(self->allocator);
                        out.push_str(name.as_str_const());
                        out.push('(');
                        out.push_str(err_expr);
                        out.push(')');
                        name.free();
                        return out;
                    }
                    else => {}
                }
            }
            case .Monomorph { monomorph_id, .. } => {
                switch (self->monomorphs->instances.get_const(monomorph_id)) {
                    case .Some(inst) => {
                        switch (inst->template_id) {
                            case .Method(method_decl_id) => {
                                switch (self->tables->methods.get_const(method_decl_id)) {
                                    case .Some(method) => {
                                        var name = mangle::mangle_monomorphized_method(
                                            self->allocator,
                                            &self->types.maps,
                                            self->tables,
                                            method_decl_id,
                                            method,
                                            &inst->type_args
                                        );
                                        var out = String.new(self->allocator);
                                        out.push_str(name.as_str_const());
                                        out.push('(');
                                        out.push_str(err_expr);
                                        out.push(')');
                                        name.free();
                                        return out;
                                    }
                                    else => {}
                                }
                            }
                            else => {}
                        }
                    }
                    else => {}
                }
            }
            else => {}
        }

        return String.from_str(self->allocator, "((void)0)");
    }

    fn emit_try_dispatch_branch_call_on_var(
        self: Self*,
        dispatch: const cir::MethodCallDispatch*,
        var_name: const uint8*
    ) String {
        switch (*dispatch) {
            case .Normal { method_decl_id } => {
                switch (self->tables->methods.get_const(method_decl_id)) {
                    case .Some(method) => {
                        var name = mangle::mangle_method(
                            self->allocator,
                            &self->types.maps,
                            method_decl_id,
                            method
                        );
                        var out = String.new(self->allocator);
                        out.push_str(name.as_str_const());
                        out.push('(');
                        if (!method->is_self_by_value()) {
                            out.push('&');
                        }
                        out.push_str(var_name);
                        out.push(')');
                        name.free();
                        return out;
                    }
                    else => {}
                }
            }
            case .Monomorph { monomorph_id, .. } => {
                switch (self->monomorphs->instances.get_const(monomorph_id)) {
                    case .Some(inst) => {
                        switch (inst->template_id) {
                            case .Method(method_decl_id) => {
                                switch (self->tables->methods.get_const(method_decl_id)) {
                                    case .Some(method) => {
                                        var name = mangle::mangle_monomorphized_method(
                                            self->allocator,
                                            &self->types.maps,
                                            self->tables,
                                            method_decl_id,
                                            method,
                                            &inst->type_args
                                        );
                                        var out = String.new(self->allocator);
                                        out.push_str(name.as_str_const());
                                        out.push('(');
                                        if (!method->is_self_by_value()) {
                                            out.push('&');
                                        }
                                        out.push_str(var_name);
                                        out.push(')');
                                        name.free();
                                        return out;
                                    }
                                    else => {}
                                }
                            }
                            else => {}
                        }
                    }
                    else => {}
                }
            }
            else => {}
        }

        return String.from_str(self->allocator, "((void)0)");
    }

    fn emit_error_binding_decl(
        self: Self*,
        out: String*,
        var_decl_id: cir::VarDeclId,
        err_type: const cir::SemaType*,
        err_expr: const uint8*
    ) {
        switch (self->tables->vars.get_const(var_decl_id)) {
            case .Some(var_decl) => {
                var base_name = mangle::sanitized(self->allocator, var_decl->name.as_str_const());
                var name = self->declare_fn_scope_name(base_name.as_str_const());
                if (name.as_str_const() != base_name.as_str_const()) {
                    self->register_fn_rename(var_decl_id, name.as_str_const());
                }
                base_name.free();

                const decl_ty = *err_type->const_inner();
                self->types.ensure_named(&decl_ty);
                var decl = self->types.build_decl(&decl_ty, name.as_str_const());
                out->push_str(decl.as_str_const());
                out->push('=');
                out->push_str(err_expr);
                out->push(';');
                decl.free();
                name.free();
            }
            else => {}
        }
    }

    fn emit_try_expr(self: Self*, try_expr: const cir::TryExpr*) String {
        switch (try_expr->control_flow_type) case .Some(cf_type) else {
            return String.from_str(self->allocator, "((void)0)");
        }
        switch (try_expr->value_type) case .Some(val_type) else {
            return String.from_str(self->allocator, "((void)0)");
        }
        switch (try_expr->return_type) case .Some(ret_type) else {
            return String.from_str(self->allocator, "((void)0)");
        }

        const temp_id = self->tuple_export_id;
        self->tuple_export_id += 1;

        var cf_var = String.from_str(self->allocator, "__cyrus_try_cf_");
        push_usize(&cf_var, temp_id);

        var ret_var = String.from_str(self->allocator, "__cyrus_try_ret_");
        push_usize(&ret_var, temp_id);

        var cf_decl = self->types.build_decl(&cf_type, cf_var.as_str_const());
        var branch_call = self->emit_try_dispatch_branch_call(
            &try_expr->branch_dispatch,
            try_expr->operand
        );

        var err_field = self->enum_tuple_payload_base(cf_var.as_str_const(), 1, 0);
        var from_error_call = self->emit_try_dispatch_from_error_call(
            &try_expr->from_error_dispatch,
            err_field.as_str_const()
        );

        var defer_code = String.new(self->allocator);
        if (self->has_active_defers()) {
            const saved_body = self->body_out;
            self->body_out = defer_code;
            self->emit_all_defers_on_error(err_field.as_str_const());
            defer_code = self->body_out;
            self->body_out = saved_body;
        }
        err_field.free();

        var out = String.from_str(self->allocator, "({");
        out.push_str(cf_decl.as_str_const());
        out.push('=');
        out.push_str(branch_call.as_str_const());
        out.push_str(";if(");
        out.push_str(cf_var.as_str_const());
        out.push_str(".tag==1){");

        if (defer_code.len() > 0) {
            var ret_decl = self->types.build_decl(&ret_type, ret_var.as_str_const());
            out.push_str(ret_decl.as_str_const());
            ret_decl.free();
            out.push('=');
            out.push_str(from_error_call.as_str_const());
            out.push(';');
            out.push_str(defer_code.as_str_const());
            out.push_str("return ");
            out.push_str(ret_var.as_str_const());
            out.push(';');
        } else {
            out.push_str("return ");
            out.push_str(from_error_call.as_str_const());
            out.push(';');
        }

        out.push('}');

        if (val_type.is_void()) {
            out.push_str("(void)0;");
        } else {
            var ok_field = self->enum_tuple_payload_base(cf_var.as_str_const(), 0, 0);
            out.push_str(ok_field.as_str_const());
            out.push(';');
            ok_field.free();
        }

        out.push_str("})");

        defer_code.free();
        from_error_call.free();
        branch_call.free();
        cf_decl.free();
        ret_var.free();
        cf_var.free();
        return out;
    }

    fn emit_try_catch_expr(self: Self*, try_catch_expr: const cir::TryCatchExpr*) String {
        switch (try_catch_expr->control_flow_type) case .Some(cf_type) else {
            return String.from_str(self->allocator, "((void)0)");
        }
        switch (try_catch_expr->value_type) case .Some(val_type) else {
            return String.from_str(self->allocator, "((void)0)");
        }

        const temp_id = self->tuple_export_id;
        self->tuple_export_id += 1;

        var cf_var = String.from_str(self->allocator, "__cyrus_try_catch_cf_");
        push_usize(&cf_var, temp_id);

        var cf_decl = self->types.build_decl(&cf_type, cf_var.as_str_const());
        var branch_call = self->emit_try_dispatch_branch_call(
            &try_catch_expr->branch_dispatch,
            try_catch_expr->operand
        );

        var catch_code = String.new(self->allocator);
        {
            const saved_body = self->body_out;
            self->body_out = catch_code;

            switch (try_catch_expr->error_binding) {
                case .Some(var_decl_id) => {
                    switch (try_catch_expr->error_type) {
                        case .Some(err_type) => {
                            var err_field = self->enum_tuple_payload_base(cf_var.as_str_const(), 1, 0);
                            self->emit_error_binding_decl(
                                &self->body_out,
                                var_decl_id,
                                &err_type,
                                err_field.as_str_const()
                            );
                            err_field.free();
                        }
                        case .None => {}
                    }
                }
                case .None => {}
            }

            self->emit_block_stmts(&try_catch_expr->catch_body, true);
            catch_code = self->body_out;
            self->body_out = saved_body;
        }

        var out = String.from_str(self->allocator, "({");
        out.push_str(cf_decl.as_str_const());
        out.push('=');
        out.push_str(branch_call.as_str_const());
        out.push_str(";if(");
        out.push_str(cf_var.as_str_const());
        out.push_str(".tag==1){");
        out.push_str(catch_code.as_str_const());
        out.push('}');

        if (val_type.is_void()) {
            out.push_str("(void)0;");
        } else {
            var ok_field = self->enum_tuple_payload_base(cf_var.as_str_const(), 0, 0);
            out.push_str(ok_field.as_str_const());
            out.push(';');
            ok_field.free();
        }

        out.push_str("})");

        catch_code.free();
        branch_call.free();
        cf_decl.free();
        cf_var.free();
        return out;
    }

    fn is_float16_type(self: Self*, ty: const cir::SemaType*) bool {
        switch (ty->as_plain_type()) {
            case .Some(plain) => {
                switch (plain) {
                    case .Float16 => return true;
                    else => {}
                }
            }
            else => {}
        }

        return false;
    }

    /// Rounds value to binary16 precision when type is `float16`.
    fn coerce_float16(self: Self*, value: String, ty: const cir::SemaType*) String {
        if (!self->is_float16_type(ty)) {
            return value;
        }

        self->types.used_float16 = true;

        var out = String.from_str(self->allocator, "__cyrus_f16_round(");
        out.push_str(value.as_str_const());
        out.push(')');
        value.free();
        return out;
    }

    fn coerce_value(
        self: Self*,
        value: String,
        src_expr: const cir::Expr*,
        dest_ty: const cir::SemaType*
    ) String {
        switch (src_expr->ty) {
            case .Some(src_ty) => {
                switch (src_ty.as_array_type()) {
                    case .Some(src_arr) => {
                        switch (src_arr.capacity) {
                            case .Fixed => {
                                switch (dest_ty->as_array_type()) {
                                    case .Some(dst_arr) => {
                                        switch (dst_arr.capacity) {
                                            case .Slice | .TerminatedSlice => {
                                                self->types.ensure_slice();
                                                const len = self->types.tctx.array_capacity_len(&src_arr);
                                                var out = String.from_str(self->allocator, "((__slice){.ptr=(void*)(");
                                                out.push_str(value.as_str_const());
                                                out.push_str("),.len=");
                                                push_usize(&out, len);
                                                out.push_str("})");
                                                value.free();
                                                return out;
                                            }
                                            case .Fixed => {}
                                        }
                                    }
                                    else => {}
                                }
                            }
                            case .Slice | .TerminatedSlice => {
                                switch (*dest_ty->const_inner()) {
                                    case .Pointer => {
                                        var ptr_type = self->types.build_decl(dest_ty, "");
                                        var out = String.from_str(self->allocator, "((");
                                        out.push_str(ptr_type.as_str_const());
                                        out.push_str(")(");
                                        out.push_str(value.as_str_const());
                                        out.push_str(").ptr)");
                                        ptr_type.free();
                                        value.free();
                                        return out;
                                    }
                                    else => {}
                                }
                            }
                        }
                    }
                    else => {}
                }
            }
            case .None => {}
        }

        var dest_128 = self->int128_kind_of(dest_ty);
        var src_128 = self->expr_int128_kind(src_expr);

        if (dest_128.is_some() && 
            !(src_128.is_some() && src_128.unwrap() == dest_128.unwrap()))
        {
            var coerce = self->coerce_to_int128(
                src_expr, 
                value.as_str_const(), 
                dest_128.unwrap()
            );
            value.free();
            return coerce;
        }

        return self->coerce_float16(value, dest_ty);
    }

    fn func_call_param_type(
        self: Self*,
        func_call: const cir::FuncCall*,
        index: usize
    ) Option<cir::SemaType> {
        switch (func_call->dispatch) {
            case .Normal { func_decl_id } => {
                switch (self->tables->funcs.get_const(func_decl_id)) {
                    case .Some(func_decl) => {
                        if (index < func_decl->params.list.len()) {
                            const param = func_decl->params.list.get_const(index).unwrap();
                            return .Some(param->ty());
                        }
                    }
                    else => {}
                }
            }
            case .Monomorph { monomorph_id } => {
                switch (self->monomorphs->instances.get_const(monomorph_id)) {
                    case .Some(inst) => {
                        if (index < inst->params.list.len()) {
                            const param = inst->params.list.get_const(index).unwrap();
                            return .Some(param->ty());
                        }
                    }
                    else => {}
                }
            }
            case .FunctionPointer { func_type } => {
                if (index < func_type.params.list.len()) {
                    const param_ty = func_type.params.list.get_const(index).unwrap();
                    return .Some(*param_ty);
                }
            }
            else => {}
        }

        return .None;
    }

    fn enter_function_scope(self: Self*, params: const cir::FuncParams*) {
        for (var i: usize = 0; i < self->fn_scope_names.len(); i += 1) {
            self->fn_scope_names.get(i).unwrap()->free();
        }

        self->fn_scope_names.clear();

        for (var i: usize = 0; i < params->list.len(); i += 1) {
            const param = params->list.get_const(i).unwrap();

            var name = self->declare_fn_scope_name(param->name_str());
            name.free();
        }
    }

    /// Returns a unique identifier that is
    /// unused in the current function scope.
    fn declare_fn_scope_name(self: Self*, base: const uint8*) String {
        var c_name = mangle::sanitized(self->allocator, base);
        var suffix: usize = 1;

        while (self->fn_name_taken(c_name.as_str_const())) {
            var unique = String.from_str(self->allocator, base);
            unique.push_str("__");
            push_usize(&unique, suffix);
            
            c_name.free();
            c_name = mangle::sanitized(
                self->allocator, 
                unique.as_str_const()
            );
            
            unique.free();
            suffix += 1;
        }

        var name = String.from_str(
            self->allocator, 
            c_name.as_str_const()
        );
        self->fn_scope_names.push(name);
        return c_name;
    }

    fn fn_name_taken(self: Self*, candidate: const uint8*) bool {
        for (var i: usize = 0; i < self->fn_scope_names.len(); i += 1) {
            const existing = self->fn_scope_names.get_const(i).unwrap();

            if (existing->as_str_const() == candidate) {
                return true;
            }
        }

        return false;
    }

    fn register_fn_rename(
        self: Self*,
        var_decl_id: cir::VarDeclId, 
        final_name: const uint8*
    ) {
        var owned = String.from_str(self->allocator, final_name);
        self->fn_renames_owned.push(owned);
        self->fn_var_renames.insert(var_decl_id, owned);
    }

    fn emit_param_prologue(self: Self*, params: const cir::FuncParams*) {
        self->enter_function_scope(params);

        for (var i: usize = 0; i < params->list.len(); i += 1) {
            const param = params->list.get_const(i).unwrap();
            const ty = param->ty();

            switch (ty) {
                case .Array(array) => {
                    switch (array.capacity) {
                        case .Fixed(capacity_expr) => {
                            var name = mangle::sanitized(self->allocator, param->name_str());
                            var capacity: usize = 1;

                            switch (ciri::fold_const_expr_int(self->tables, self->registry, capacity_expr)) {
                                case .Some(literal) => {
                                    capacity = cir::integer_literal_as_usize(literal);
                                }
                                else => {}
                            }

                            var type_name = self->types.type_name(array.element_type);

                            self->body_out.push_str(type_name.as_str_const());
                            self->body_out.push(' ');
                            self->body_out.push_str(name.as_str_const());
                            self->body_out.push('[');
                            push_usize(&self->body_out, capacity);
                            self->body_out.push_str("];");

                            self->ensure_memcpy_proto();
                            self->body_out.push_str("memcpy(");
                            self->body_out.push_str(name.as_str_const());
                            self->body_out.push(',');
                            self->body_out.push_str(name.as_str_const());
                            self->body_out.push_str("__p,sizeof(");
                            self->body_out.push_str(name.as_str_const());
                            self->body_out.push_str("));");

                            type_name.free();
                            name.free();
                        }
                        case .Slice | .TerminatedSlice => {}
                    }
                }
                else => {}
            }
        }
    }

    /* ************* Statements ************* */

    fn emit_block_stmts(self: Self*, block: const cir::BlockStmt*, push_scope: bool) {
        if (push_scope) {
            var scope: Vec<cir::DeferStmt> = Vec.new(self->allocator);
            self->defer_scopes.push(scope);
        }

        for (var i: usize = 0; i < block->stmts.len(); i += 1) {
            const stmt = block->stmts.get_const(i).unwrap();
            self->emit_stmt(stmt);
        }

        if (push_scope) {
            self->pop_defer_scope();
        }
    }

    /* ************* Label depth scan ************* */

    fn begin_label_scan(self: Self*) {
        self->label_depth_ids.free();
        self->label_depths.free();
        self->label_depth_ids = Vec.new(self->allocator);
        self->label_depths = Vec.new(self->allocator);
    }

    fn scan_func_labels(self: Self*, body: const cir::BlockStmt*, push_scope: bool) {
        var depth = self->defer_scopes.len();

        if (push_scope) {
            depth += 1;
        }

        self->scan_block_labels(body, depth);
    }

    fn scan_block_labels(self: Self*, block: const cir::BlockStmt*, depth: usize) {
        for (var i: usize = 0; i < block->stmts.len(); i += 1) {
            const stmt = block->stmts.get_const(i).unwrap();
            self->scan_stmt_labels(stmt, depth);
        }
    }

    fn scan_stmt_labels(self: Self*, stmt: const cir::Stmt*, depth: usize) {
        switch (stmt->kind) {
            case .Label(label) => {
                self->label_depth_ids.push(label.label_id);
                self->label_depths.push(depth);
            }

            case .BlockStmt(block) => {
                self->scan_block_labels(&block, depth + 1);
            }

            case .If(if_) => {
                self->scan_block_labels(if_.then_block, depth + 1);

                for (var b: usize = 0; b < if_.branches.len(); b += 1) {
                    const branch = if_.branches.get_const(b).unwrap();
                    self->scan_block_labels(branch->then_block, depth + 1);
                }

                switch (if_.else_block) {
                    case .Some(else_block) => {
                        self->scan_block_labels(else_block, depth + 1);
                    }
                    else => {}
                }
            }

            case .While(while_) => {
                self->scan_block_labels(while_.body, depth + 1);
            }

            case .For(for_) => {
                self->scan_block_labels(for_.body, depth + 1);
            }

            case .Foreach(foreach_) => {
                self->scan_block_labels(foreach_.body, depth + 1);
            }

            case .Switch(switch_) => {
                for (var i: usize = 0; i < switch_.cases.len(); i += 1) {
                    const case_ = switch_.cases.get_const(i).unwrap();
                    self->scan_block_labels(case_->body, depth + 1);
                }

                switch (switch_.else_case) {
                    case .Some(else_case) => {
                        self->scan_block_labels(&else_case, depth + 1);
                    }
                    else => {}
                }
            }

            else => {}
        }
    }

    fn label_depth_of(self: Self*, label_id: cir::LabelId) Option<usize> {
        for (var i: usize = 0; i < self->label_depth_ids.len(); i += 1) {
            const id = self->label_depth_ids.get_const(i).unwrap();

            if (*id == label_id) {
                return .Some(*self->label_depths.get_const(i).unwrap());
            }
        }

        return .None;
    }

    fn emit_defers_above(self: Self*, depth: usize) {
        for (var s: usize = self->defer_scopes.len(); s > depth; s -= 1) {
            switch (self->defer_scopes.get_const(s - 1)) {
                case .Some(scope) => {
                    for (var i: usize = scope->len(); i > 0; i -= 1) {
                        const stmt = scope->get_const(i - 1).unwrap();
                        self->emit_defer_stmt(stmt);
                    }
                }
                else => {}
            }
        }
    }

    fn emit_stmt(self: Self*, stmt: const cir::Stmt*) {
        switch (stmt->kind) {
            case .Expr(expr) => {
                var expr = self->emit_expr(&expr);
                self->body_out.push_str(expr.as_str_const());
                self->body_out.push(';');
                expr.free();
            }

            case .BlockStmt(block) => {
                self->body_out.push('{');
                self->emit_block_stmts(&block, true);
                self->body_out.push('}');
            }

            case .Label(label) => {
                const name = mangle::sanitized(self->allocator, label.name.as_str_const());

                self->body_out.push_str(name.as_str_const());
                self->body_out.push(':');

                name.free();
            }

            case .Goto(goto_) => {
                var target_emitted = true;

                // A goto leaves every defer scope deeper than the label
                // it targets, run those defers before jumping
                switch (goto_.label_id) {
                    case .Some(label_id) => {
                        switch (self->label_depth_of(label_id)) {
                            case .Some(depth) => {
                                self->emit_defers_above(depth);
                            }
                            case .None => {
                                // The target label sits in code that the
                                // analyzer removed as unreachable. 
                                // 
                                // The reference backend drops the branch in this
                                // situation, so do the same rather than emit
                                // a jump to a label that will never exist
                                target_emitted = false;
                            }
                        }
                    }
                    else => {}
                }

                if (target_emitted) {
                    var label = mangle::sanitized(self->allocator, goto_.name.as_str_const());

                    self->body_out.push_str("goto ");
                    self->body_out.push_str(label.as_str_const());
                    self->body_out.push(';');
                    
                    label.free();
                }
            }

            case .Builtin(builtin) => {
                switch (builtin) {
                    case .BuiltinFunc(builtin_func) => {
                        var str = self->emit_builtin_func(&builtin_func);
                        self->body_out.push_str(str.as_str_const());
                        self->body_out.push(';');
                        str.free();
                    }
                    case .BuiltinBlock(block) => {
                        if (block.is_active) {
                            self->emit_block_stmts(block.block, false);
                        }
                    }
                }
            }

            case .FuncDef(var func_def) => {
                self->emit_nested_func(&func_def);
            }

            case .Break => {
                self->emit_defers_to_loop_mark();
                self->body_out.push_str("break;");
            }

            case .Continue => {
                self->emit_defers_to_loop_mark();
                self->body_out.push_str("continue;");
            }

            case .Variable(var_) => {
                self->emit_var(&var_);
            }

            case .TupleExport(tuple_export) => {
                self->emit_tuple_export(&tuple_export);
            }
            
            case .Return(return_) => {
                self->emit_return(&return_);
            }

            case .If(if_) => {
                self->emit_if(&if_);
            }

            case .While(while_) => {
                self->emit_while(&while_);
            }

            case .For(for_) => {
                self->emit_for(&for_);
            }

            case .Foreach(foreach_) => {
                self->emit_foreach(&foreach_);
            }

            case .Switch(switch_) => {
                self->emit_switch(&switch_);
            }
            
            case .InlineAsm(asm) => {
                self->emit_inline_asm_stmt(asm);
            }

            case .Defer(defer_stmt) => {
                self->push_defer(defer_stmt);
            }

            else => {}
        }
    }

    fn emit_tuple_export(self: Self*, export_tuple: const cir::TupleExportStmt*) {
        switch (export_tuple->rhs) {
            case .Some(rhs) => {
                switch (rhs.ty) {
                    case .Some(ty) => {
                        var rhs_value = self->emit_expr(&rhs);

                        var temp = String.from_str(self->allocator, "__tuple_export_");
                        push_usize(&temp, self->tuple_export_id);
                        self->tuple_export_id += 1;

                        self->types.ensure_named(&ty);

                        var decl = self->types.build_decl(&ty, temp.as_str_const());

                        self->body_out.push_str(decl.as_str_const());
                        self->body_out.push('=');
                        self->body_out.push_str(rhs_value.as_str_const());
                        self->body_out.push(';');

                        self->emit_tuple_export_pattern(
                            &export_tuple->pattern,
                            temp.as_str_const(),
                            export_tuple->is_const
                        );

                        rhs_value.free();
                        temp.free();
                        decl.free();
                    }
                    else => {}
                }
            }
            else => {}
        }
    }

    fn emit_tuple_export_pattern(
        self: Self*,
        pattern: const cir::TupleExportPattern*,
        accessor: const uint8*,
        var is_const: bool
    ) {
        switch (pattern->kind) {
            case .Ident(var_decl_id) => {
                switch (pattern->constness) {
                    case .Some(.Const) => is_const = true;
                    case .Some(.Var) => is_const = false;
                    else => {}
                }

                switch (self->tables->vars.get_const(var_decl_id)) {
                    case .Some(entry) => {
                        var base_name = mangle::sanitized(self->allocator, entry->name.as_str_const());
                        var name = self->declare_fn_scope_name(base_name.as_str_const());

                        if (name.as_str_const() != base_name.as_str_const()) {
                            self->register_fn_rename(var_decl_id, name.as_str_const());
                        }
                        base_name.free();

                        switch (entry->ty) {
                            case .Some(ty) => {
                                const clean_ty = *ty.const_inner();
                                self->types.ensure_named(&clean_ty);

                                var binding_decl = self->types.build_decl(&clean_ty, name.as_str_const());

                                var is_fixed_array = false;
                                switch (clean_ty.as_array_type()) {
                                    case .Some(array) => {
                                        switch (array.capacity) {
                                            case .Fixed => is_fixed_array = true;
                                            case .Slice | .TerminatedSlice => {}
                                        }
                                    }
                                    else => {}
                                }

                                if (is_fixed_array) {
                                    self->ensure_memcpy_proto();
                                    self->body_out.push_str(binding_decl.as_str_const());
                                    self->body_out.push_str(";memcpy(");
                                    self->body_out.push_str(name.as_str_const());
                                    self->body_out.push(',');
                                    self->body_out.push_str(accessor);
                                    self->body_out.push_str(",sizeof(");
                                    self->body_out.push_str(name.as_str_const());
                                    self->body_out.push_str("));");
                                } else {
                                    self->body_out.push_str(binding_decl.as_str_const());
                                    self->body_out.push('=');
                                    self->body_out.push_str(accessor);
                                    self->body_out.push(';');
                                }

                                binding_decl.free();
                            }
                            else => {}
                        }

                        name.free();
                    }
                    else => {}
                }
            }
            case .Tuple(patterns) => {
                for (var i: usize = 0; i < patterns.len(); i += 1) {
                    const inner = patterns.get_const(i).unwrap();

                    var child_accessor = String.from_str(self->allocator, accessor);
                    child_accessor.push_str(".f");
                    push_usize(&child_accessor, i);

                    self->emit_tuple_export_pattern(inner, child_accessor.as_str_const(), is_const);

                    child_accessor.free();
                }
            }
            case .Struct { fields, .. } => {
                for (var i: usize = 0; i < fields.len(); i += 1) {
                    const field = fields.get_const(i).unwrap();
                    var sanitized_field = mangle::sanitized(
                        self->allocator,
                        field->name.str.as_str_const()
                    );

                    var child_accessor = String.from_str(self->allocator, accessor);
                    child_accessor.push('.');
                    child_accessor.push_str(sanitized_field.as_str_const());

                    self->emit_tuple_export_pattern(
                        &field->pattern, 
                        child_accessor.as_str_const(), 
                        is_const
                    );

                    child_accessor.free();
                    sanitized_field.free();
                }
            }
            case .Ignore => {}
        }
    }

    fn emit_var(self: Self*, var_: const cir::VarStmt*) {
        var base_name = mangle::sanitized(self->allocator, var_->name.as_str_const());
        var name = self->declare_fn_scope_name(base_name.as_str_const());

        if (name.as_str_const() != base_name.as_str_const()) {
            self->register_fn_rename(var_->var_decl_id, name.as_str_const());
        }

        base_name.free();
        
        switch (var_->rhs) {
            case .Some(rhs) => {
                if (rhs.kind.is_lambda()) {
                    self->emit_var_lambda(var_, name);
                    return;
                }
            }
            else => {}
        }

        if (var_->ty.is_none()) {
            // Infer from rhs
            switch (var_->rhs) {
                case .Some(rhs) => {
                    switch (rhs.kind) {
                        case .Lambda => {
                            self->emit_var_lambda(var_, name);
                        }
                        else => {}
                    }
                    
                    switch (rhs.ty) {
                        case .Some(ty) => {
                            const decl_ty = *ty.const_inner();
                            self->types.ensure_named(&decl_ty);
                            
                            var decl = self->types.build_decl(&decl_ty, name.as_str_const());
                            
                            self->body_out.push_str(decl.as_str_const());
                            
                            switch (rhs.kind) {
                                case .Array(array) => {
                                    self->body_out.push('=');
                                    var braces = self->emit_array_braces(&array);
                                    self->body_out.push_str(braces.as_str_const());
                                    braces.free();
                                }
                                else => {
                                    self->body_out.push('=');
                                    var expr = self->emit_expr(&rhs);
                                    self->body_out.push_str(expr.as_str_const());
                                    expr.free();
                                }
                            }

                            self->body_out.push(';');
                            decl.free();
                        }
                        case .None => {}
                    }
                }
                case .None => {}
            }

            name.free();
            return;
        }

        switch (var_->ty) {
            case .Some(ty) => {
                const decl_ty = *ty.const_inner();
                self->types.ensure_named(&decl_ty);
                
                var decl = self->types.build_decl(&decl_ty, name.as_str_const());

                self->body_out.push_str(decl.as_str_const());

                switch (var_->rhs) {
                    case .Some(rhs) => {
                        // C arrays are not assignable and C aggregates of
                        // distinct types are not assignable even when their
                        // layouts match. Both cases are lowered explicitly
                        var is_fixed_array = false;
                        var copy_array = false;

                        switch (ty.as_array_type()) {
                            case .Some(array) => {
                                switch (array.capacity) {
                                    case .Fixed => is_fixed_array = true;
                                    case .Slice | .TerminatedSlice => {}
                                }
                            }
                            else => {}
                        }

                        switch (rhs.kind) {
                            case .Array => {}
                            else => {
                                if (is_fixed_array) {
                                    copy_array = true;
                                }
                            }
                        }

                        var reinterpret_aggregate = false;

                        if (!copy_array) {
                            switch (ty.const_inner()->as_struct()) {
                                case .Some(dest_struct_id) => {
                                    switch (rhs.ty) {
                                        case .Some(source_ty) => {
                                            switch (source_ty.const_inner()->as_struct()) {
                                                case .Some(source_struct_id) => {
                                                    if (dest_struct_id != source_struct_id) {
                                                        reinterpret_aggregate = true;
                                                    }
                                                }
                                                else => {}
                                            }
                                        }
                                        else => {}
                                    }
                                }
                                else => {}
                            }
                        }

                        if (copy_array) {
                            self->ensure_memcpy_proto();
                            self->body_out.push_str(";memcpy(");
                            self->body_out.push_str(name.as_str_const());
                            self->body_out.push(',');

                            var expr = self->emit_expr(&rhs);
                            self->body_out.push_str(expr.as_str_const());
                            expr.free();

                            self->body_out.push_str(",sizeof(");
                            var size_name = self->types.type_name(&ty);
                            self->body_out.push_str(size_name.as_str_const());
                            size_name.free();
                            self->body_out.push_str("))");
                        } else {
                            self->body_out.push('=');

                            switch (rhs.kind) {
                                case .Array(array) => {
                                    if (is_fixed_array) {
                                        var braces = self->emit_array_braces(&array);
                                        self->body_out.push_str(braces.as_str_const());
                                        braces.free();
                                    } else {
                                        var expr = self->emit_expr(&rhs);
                                        expr = self->coerce_value(expr, &rhs, &ty);
                                        self->body_out.push_str(expr.as_str_const());
                                        expr.free();
                                    }
                                }
                                else => {
                                    var expr = self->emit_expr(&rhs);

                                    if (reinterpret_aggregate) {
                                        var cast_name = self->types.type_name(&ty);
                                        self->body_out.push_str("*((");
                                        self->body_out.push_str(cast_name.as_str_const());
                                        self->body_out.push_str(" *)&(");
                                        self->body_out.push_str(expr.as_str_const());
                                        self->body_out.push_str("))");
                                        cast_name.free();
                                        expr.free();
                                    } else {
                                        expr = self->coerce_value(expr, &rhs, &ty);
                                        self->body_out.push_str(expr.as_str_const());
                                        expr.free();
                                    }
                                }
                            }
                        }
                    }
                    case .None => {
                        if (!var_->is_undef) {
                            self->body_out.push_str("={0}");
                        }
                    }
                }

                self->body_out.push(';');
                decl.free();
                name.free();
            }
            case .None => {}
        }
    }

    fn emit_var_lambda(self: Self*, var_: const cir::VarStmt*, name: String) {
        switch (var_->rhs) {
            case .Some(rhs) => {
                switch (rhs.kind) {
                    case .Lambda(lambda) => {
                        var out = String.from_str(self->allocator, "(*");
                        out.push_str(name.as_str_const());
                        out.push(')');

                        var decl = self->build_func_signature(
                            &lambda.ret_type,
                            &lambda.params,
                            out.as_str_const()
                        );

                        var expr = self->emit_lambda(&lambda);

                        self->body_out.push_str(decl.as_str_const());
                        self->body_out.push('=');
                        self->body_out.push_str(expr.as_str_const());
                        self->body_out.push(';');

                        expr.free();
                        decl.free();
                        out.free();
                        name.free();
                    }
                    else => {}
                }
            }
            else => {}
        }
    }

    fn emit_array_braces(self: Self*, array: const cir::ArrayExpr*) String {
        var out = String.from_str(self->allocator, "{");

        for (var i: usize = 0; i < array->elements.len(); i += 1) {
            const element = array->elements.get_const(i).unwrap();
            
            switch (element->kind) {
                case .Array(array2) => {
                    var braces = self->emit_array_braces(&array2);
                    out.push_str(braces.as_str_const());
                    braces.free();
                }
                else => {
                    var expr = self->emit_expr(element);
                    out.push_str(expr.as_str_const());
                    expr.free();
                }
            }

            if (i + 1 < array->elements.len()) {
                out.push(',');
            }
        }

        out.push('}');
        return out;
    }

    fn emit_init_value(self: Self*, value: const cir::Expr*) String {
        switch (value->kind) {
            case .Array(array) => return self->emit_array_braces(&array);
            else => {}
        }

        return self->emit_expr(value);
    }

    fn emit_return(self: Self*, return_: const cir::ReturnStmt*) {
        const has_defers = self->has_active_defers();

        if (self->in_void_main) {
            switch (return_->arg) {
                case .Some(arg) => {
                    var expr = self->emit_expr(&arg);
                    if (has_defers) {
                        self->body_out.push_str("{int32_t __cyrus_ret_val=");
                        self->body_out.push_str(expr.as_str_const());
                        self->body_out.push(';');
                        self->emit_all_defers();
                        self->body_out.push_str("return __cyrus_ret_val;}");
                    } else {
                        self->body_out.push_str("return ");
                        self->body_out.push_str(expr.as_str_const());
                        self->body_out.push(';');
                    }
                    expr.free();
                }
                case .None => {
                    self->emit_all_defers();
                    self->body_out.push_str("return 0;");
                }
            }
            
            return;
        }

        switch (return_->arg) {
            case .Some(arg) => {
                // Array-returning functions dont really return a plain array. 
                // They return a generated struct wrapper. So we copy the
                // array value into that wrapper's storage
                var ret_check_type = self->cur_ret_type;

                if (ret_check_type.is_none()) {
                    ret_check_type = arg.ty;
                }

                switch (ret_check_type) {
                    case .Some(ty) => {
                        switch (ty.as_array_type()) {
                            case .Some(array) => {
                                switch (array.capacity) {
                                    case .Fixed => {
                                        var struct_name = self->types.array_return_struct_name(&ty);
                                        self->ensure_memcpy_proto();

                                        var expr = self->emit_expr(&arg);

                                        if (has_defers) {
                                            self->body_out.push('{');
                                            self->body_out.push_str(struct_name.as_str_const());
                                            self->body_out.push_str(" __cyrus_ret_val;memcpy(__cyrus_ret_val.data,");
                                            self->body_out.push_str(expr.as_str_const());
                                            self->body_out.push_str(",sizeof(__cyrus_ret_val.data));");
                                            self->emit_all_defers();
                                            self->body_out.push_str("return __cyrus_ret_val;}");
                                        } else {
                                            self->body_out.push_str("return({");
                                            self->body_out.push_str(struct_name.as_str_const());
                                            self->body_out.push_str(" __cyrus_ret;memcpy(__cyrus_ret.data,");
                                            self->body_out.push_str(expr.as_str_const());
                                            self->body_out.push_str(",sizeof(__cyrus_ret.data));__cyrus_ret;});");
                                        }

                                        expr.free();
                                        struct_name.free();
                                        return;
                                    }
                                    case .Slice | .TerminatedSlice => {}
                                }
                            }
                            else => {}
                        }
                    }
                    else => {}
                }

                var expr = self->emit_expr(&arg);

                switch (self->cur_ret_type) {
                    case .Some(ret_ty) => {
                        expr = self->coerce_value(expr, &arg, &ret_ty);
                    }
                    case .None => {
                        switch (arg.ty) {
                            case .Some(ty) => {
                                expr = self->coerce_float16(expr, &ty);
                            }
                            else => {}
                        }
                    }
                }

                if (has_defers) {
                    var ret_ty_opt: Option<cir::SemaType> = self->cur_ret_type;
                    if (ret_ty_opt.is_none()) {
                        ret_ty_opt = arg.ty;
                    }

                    var emitted_ret = false;
                    switch (ret_ty_opt) {
                        case .Some(ret_ty) => {
                            if (ret_ty.is_void()) {
                                self->body_out.push_str(expr.as_str_const());
                                self->body_out.push(';');
                                self->emit_all_defers();
                                self->body_out.push_str("return;");
                                emitted_ret = true;
                            } else {
                                const inner_ret = *ret_ty.const_inner();
                                self->types.ensure_named(&inner_ret);
                                var decl = self->types.build_decl(&inner_ret, "__cyrus_ret_val");
                                self->body_out.push('{');
                                self->body_out.push_str(decl.as_str_const());
                                self->body_out.push('=');
                                self->body_out.push_str(expr.as_str_const());
                                self->body_out.push(';');
                                decl.free();
                                self->emit_all_defers_for_return("__cyrus_ret_val");
                                self->body_out.push_str("return __cyrus_ret_val;}");
                                emitted_ret = true;
                            }
                        }
                        else => {}
                    }

                    if (!emitted_ret) {
                        self->emit_all_defers();
                        self->body_out.push_str("return ");
                        self->body_out.push_str(expr.as_str_const());
                        self->body_out.push(';');
                    }
                } else {
                    self->body_out.push_str("return ");
                    self->body_out.push_str(expr.as_str_const());
                    self->body_out.push(';');
                }
                expr.free();
            }
            case .None => {
                self->emit_all_defers();
                self->body_out.push_str("return;");
            }
        }
    }

    fn emit_if(self: Self*, if_: const cir::IfStmt*) {
        var cond = self->emit_expr(&if_->cond);
        
        self->body_out.push_str("if(");
        self->body_out.push_str(cond.as_str_const());
        self->body_out.push_str("){");
        self->emit_block_stmts(if_->then_block, true);
        self->body_out.push('}');

        cond.free();

        for (var b: usize = 0; b < if_->branches.len(); b += 1) {
            const branch = if_->branches.get_const(b).unwrap();
            
            var cond = self->emit_expr(&branch->cond);
            
            self->body_out.push_str("else if(");
            self->body_out.push_str(cond.as_str_const());
            self->body_out.push_str("){");
            
            self->emit_block_stmts(branch->then_block, true);
            self->body_out.push('}');

            cond.free();
        }

        switch (if_->else_block) {
            case .Some(else_block) => {
                self->body_out.push_str("else{");
                self->emit_block_stmts(else_block, true);
                self->body_out.push('}');
            }
            else => {}
        }
    }

    fn emit_while(self: Self*, while_: const cir::WhileStmt*) {
        var cond = self->emit_expr(&while_->cond);
        self->body_out.push_str("while(");
        self->body_out.push_str(cond.as_str_const());
        self->body_out.push_str("){");
        cond.free();

        self->loop_marks.push(self->defer_scopes.len());
        self->emit_block_stmts(while_->body, true);
        self->loop_marks.pop();

        self->body_out.push('}');
    }

    fn emit_for(self: Self*, for_: const cir::ForStmt*) {
        self->body_out.push_str("for(");

        switch (for_->initializer) {
            case .Some(var_) => {
                const ty = resolve_var_type(&var_).unwrap();
                const decl_ty = *ty.const_inner();

                self->types.ensure_named(&decl_ty);

                var base_name = mangle::sanitized(self->allocator, var_.name.as_str_const());
                var loop_name = self->declare_fn_scope_name(base_name.as_str_const());

                if (loop_name.as_str_const() != base_name.as_str_const()) {
                    self->register_fn_rename(var_.var_decl_id, loop_name.as_str_const());
                }

                var decl = self->types.build_decl(&decl_ty, loop_name.as_str_const());

                base_name.free();
                loop_name.free();
                
                self->body_out.push_str(decl.as_str_const());
                decl.free();

                switch (var_.rhs) {
                    case .Some(rhs) => {
                        self->body_out.push('=');
                        var expr = self->emit_expr(&rhs);
                        self->body_out.push_str(expr.as_str_const());
                        expr.free();
                    }
                    else => {
                        if (!var_.is_undef) {
                            self->body_out.push_str("={0}");
                        }
                    }
                }
            }
            else => {}
        }

        self->body_out.push(';');

        switch (for_->cond) {
            case .Some(cond) => {
                var expr = self->emit_expr(&cond);
                self->body_out.push_str(expr.as_str_const());
                expr.free();
            }
            else => {}
        }

        self->body_out.push(';');

        switch (for_->increment) {
            case .Some(var_) => {
                var expr = self->emit_expr(&var_);
                self->body_out.push_str(expr.as_str_const());
                expr.free();
            }
            else => {}
        }

        self->body_out.push_str("){");

        self->loop_marks.push(self->defer_scopes.len());
        self->emit_block_stmts(for_->body, true);
        self->loop_marks.pop();

        self->body_out.push('}');
    }

    fn emit_foreach_next_call(
        self: Self*,
        dispatch: const cir::MethodCallDispatch*,
        option_type: const cir::SemaType*,
        iter_var: const uint8*
    ) String {
        switch (*dispatch) {
            case .Normal { method_decl_id } => {
                switch (self->tables->methods.get_const(method_decl_id)) {
                    case .Some(method) => {
                        var name = mangle::mangle_method(
                            self->allocator,
                            &self->types.maps,
                            method_decl_id,
                            method
                        );

                        var out = String.new(self->allocator);
                        out.push_str(name.as_str_const());
                        out.push('(');
                        
                        if (method->is_self_by_value()) {
                            out.push('*');
                        }
                        
                        out.push_str(iter_var);
                        out.push(')');
                        name.free();
                        return out;
                    }
                    else => {}
                }
            }
            case .Monomorph { monomorph_id, .. } => {
                switch (self->monomorphs->instances.get_const(monomorph_id)) {
                    case .Some(inst) => {
                        switch (inst->template_id) {
                            case .Method(method_decl_id) => {
                                switch (self->tables->methods.get_const(method_decl_id)) {
                                    case .Some(method) => {
                                        var name = mangle::mangle_monomorphized_method(
                                            self->allocator,
                                            &self->types.maps,
                                            self->tables,
                                            method_decl_id,
                                            method,
                                            &inst->type_args
                                        );

                                        var out = String.new(self->allocator);
                                        out.push_str(name.as_str_const());
                                        out.push('(');
                                        
                                        if (method->is_self_by_value()) {
                                            out.push('*');
                                        }
                                        
                                        out.push_str(iter_var);
                                        out.push(')');
                                        name.free();
                                        return out;
                                    }
                                    else => {}
                                }
                            }
                            else => {}
                        }
                    }
                    else => {}
                }
            }
            case .Interface { index, dispatch: icall_dispatch, .. } => {
                switch (icall_dispatch) {
                    case .StaticNormal { method_decl_id } => {
                        switch (self->tables->methods.get_const(method_decl_id)) {
                            case .Some(method) => {
                                var name = mangle::mangle_method(
                                    self->allocator,
                                    &self->types.maps,
                                    method_decl_id,
                                    method
                                );

                                var out = String.new(self->allocator);
                                out.push_str(name.as_str_const());
                                out.push('(');
                                out.push_str(iter_var);
                                out.push_str(".data)");
                                name.free();
                                return out;
                            }
                            else => {}
                        }
                    }
                    case .StaticMonomorphized { monomorph_id } => {
                        switch (self->monomorphs->instances.get_const(monomorph_id)) {
                            case .Some(inst) => {
                                switch (inst->template_id) {
                                    case .Method(method_decl_id) => {
                                        switch (self->tables->methods.get_const(method_decl_id)) {
                                            case .Some(method) => {
                                                var name = mangle::mangle_monomorphized_method(
                                                    self->allocator,
                                                    &self->types.maps,
                                                    self->tables,
                                                    method_decl_id,
                                                    method,
                                                    &inst->type_args
                                                );

                                                var out = String.new(self->allocator);
                                                out.push_str(name.as_str_const());
                                                out.push('(');
                                                out.push_str(iter_var);
                                                out.push_str(".data)");
                                                name.free();
                                                return out;
                                            }
                                            else => {}
                                        }
                                    }
                                    else => {}
                                }
                            }
                            else => {}
                        }
                    }
                    case .Dynamic => {
                        self->types.ensure_named(option_type);
                        var ret_name = self->types.type_name(option_type);

                        var out = String.from_str(self->allocator, "((");
                        out.push_str(ret_name.as_str_const());
                        out.push_str("(*)(void*))((void**)");
                        out.push_str(iter_var);
                        out.push_str(".vtable)[");
                        push_usize(&out, index);
                        out.push_str("])(");
                        out.push_str(iter_var);
                        out.push_str(".data)");

                        ret_name.free();
                        return out;
                    }
                }
            }
            case .Unresolved => {}
        }

        return String.from_str(self->allocator, "((void)0)");
    }

    fn emit_foreach_item_binding(
        self: Self*,
        pattern: const cir::TupleExportPattern*,
        raw_accessor: const uint8*,
        val_ty: const cir::SemaType*,
        deref_ptr: bool,
        id: usize
    ) {
        var needs_temp = false;

        switch (pattern->kind) {
            case .Tuple | .Struct => needs_temp = true;
            case .Ident | .Ignore => {}
        }

        if (needs_temp) {
            const clean_value_type = *val_ty->const_inner();
            self->types.ensure_named(&clean_value_type);

            var item_var = String.from_str(self->allocator, "__cyrus_for_item_");
            push_usize(&item_var, id);

            var item_decl = self->types.build_decl(
                &clean_value_type, 
                item_var.as_str_const()
            );
            self->body_out.push_str(item_decl.as_str_const());
            self->body_out.push('=');

            if (deref_ptr) {
                self->body_out.push_str("*(");
                self->body_out.push_str(raw_accessor);
                self->body_out.push(')');
            } else {
                self->body_out.push_str(raw_accessor);
            }
            
            self->body_out.push(';');
            self->emit_tuple_export_pattern(
                pattern, 
                item_var.as_str_const(), 
                true
            );

            item_decl.free();
            item_var.free();
        } else {
            self->emit_tuple_export_pattern(pattern, raw_accessor, true);
        }
    }

    fn emit_foreach(self: Self*, foreach_: const cir::ForeachStmt*) {
        const id = self->tuple_export_id;
        self->tuple_export_id += 1;

        var index_var = String.from_str(self->allocator, "__cyrus_for_idx_");
        push_usize(&index_var, id);
        defer index_var.free();

        self->body_out.push('{');

        var iter_type: cir::SemaType = .Placeholder;

        switch (foreach_->iterable.ty) {
            case .Some(ty) => {
                iter_type = ty;
            }
            case .None => {
                self->body_out.push('}');
                return;
            }
        }

        var is_ident_item = false;

        switch (foreach_->item_pattern.kind) {
            case .Ident => is_ident_item = true;
            else => {}
        }

        switch (foreach_->kind) {
            case .Array { by_pointer, .. } => {
                var base_type: cir::SemaType = *extract_typedef_inner_type(
                    self->tables,
                    iter_type.const_inner()
                );

                if (by_pointer) {
                    switch (base_type) {
                        case .Pointer(pt) => {
                            base_type = *extract_typedef_inner_type(self->tables, pt->const_inner());
                        }
                        else => {}
                    }
                }

                switch (base_type.as_array_type()) case .Some(array) else {
                    self->body_out.push('}');
                    return;
                }

                var capacity: usize = 0;

                switch (array.capacity) {
                    case .Fixed(capacity_expr) => {
                        switch (ciri::fold_const_expr_int(
                            self->tables, 
                            self->registry, 
                            capacity_expr
                        )) {
                            case .Some(literal) => {
                                capacity = cir::integer_literal_as_usize(literal);
                            }
                            else => {}
                        }
                    }
                    case .Slice | .TerminatedSlice => {}
                }

                var element_inner_type: cir::SemaType = *array.element_type->const_inner();
                self->types.ensure_named(&element_inner_type);

                const element_pointer_type: cir::SemaType = .Pointer(&element_inner_type);
                
                var array_ptr_var = String.from_str(self->allocator, "__cyrus_for_arr_");
                push_usize(&array_ptr_var, id);
                defer array_ptr_var.free();

                var array_ptr_decl = self->types.build_decl(
                    &element_pointer_type, 
                    array_ptr_var.as_str_const()
                );
                var element_ptr_cast = self->types.build_decl(&element_pointer_type, "");

                if (by_pointer) {
                    var iter_expr = self->emit_expr(&foreach_->iterable);
                    self->body_out.push_str(array_ptr_decl.as_str_const());
                    self->body_out.push_str("=(");
                    self->body_out.push_str(element_ptr_cast.as_str_const());
                    self->body_out.push_str(")(");
                    self->body_out.push_str(iter_expr.as_str_const());
                    self->body_out.push_str(");");
                    iter_expr.free();
                } else {
                    var array_value_var = String.from_str(self->allocator, "__cyrus_for_arr_val_");
                    push_usize(&array_value_var, id);

                    var array_value_name_with_capacity = String.from_str(
                        self->allocator, 
                        array_value_var.as_str_const()
                    );

                    array_value_name_with_capacity.push('[');
                    
                    var safe_cap: usize = 1;
                    
                    if (capacity > 0) {
                        safe_cap = capacity;
                    }
                    
                    push_usize(&array_value_name_with_capacity, safe_cap);
                    array_value_name_with_capacity.push(']');

                    var array_value_decl = self->types.build_decl(
                        &element_inner_type, 
                        array_value_name_with_capacity.as_str_const()
                    );

                    self->body_out.push_str(array_value_decl.as_str_const());

                    switch (foreach_->iterable.kind) {
                        case .Array(arr_expr) => {
                            var braces = self->emit_array_braces(&arr_expr);
                            self->body_out.push('=');
                            self->body_out.push_str(braces.as_str_const());
                            self->body_out.push(';');
                            braces.free();
                        }
                        else => {
                            if (capacity > 0) {
                                self->ensure_memcpy_proto();
                                var iter_expr = self->emit_expr(&foreach_->iterable);
                                self->body_out.push_str(";memcpy(");
                                self->body_out.push_str(array_value_var.as_str_const());
                                self->body_out.push(',');
                                self->body_out.push_str(iter_expr.as_str_const());
                                self->body_out.push_str(",sizeof(");
                                self->body_out.push_str(array_value_var.as_str_const());
                                self->body_out.push_str("));");
                                iter_expr.free();
                            } else {
                                self->body_out.push_str("={0};");
                            }
                        }
                    }

                    self->body_out.push_str(array_ptr_decl.as_str_const());
                    self->body_out.push_str("=(");
                    self->body_out.push_str(element_ptr_cast.as_str_const());
                    self->body_out.push_str(")");
                    self->body_out.push_str(array_value_var.as_str_const());
                    self->body_out.push(';');

                    array_value_decl.free();
                    array_value_name_with_capacity.free();
                    array_value_var.free();
                }

                array_ptr_decl.free();
                element_ptr_cast.free();

                self->body_out.push_str("for(uintptr_t ");
                self->body_out.push_str(index_var.as_str_const());
                self->body_out.push_str("=0;");
                self->body_out.push_str(index_var.as_str_const());
                self->body_out.push('<');
                push_usize(&self->body_out, capacity);
                self->body_out.push(';');
                self->body_out.push_str(index_var.as_str_const());
                self->body_out.push_str("+=1){");

                switch (foreach_->index_pattern) {
                    case .Some(idx_pat) => {
                        self->emit_tuple_export_pattern(&idx_pat, index_var.as_str_const(), true);
                    }
                    case .None => {}
                }

                // FIXME: Rename
                var item_acc = String.new(self->allocator);

                if (by_pointer && is_ident_item) {
                    item_acc.push_str("(&");
                    item_acc.push_str(array_ptr_var.as_str_const());
                    item_acc.push('[');
                    item_acc.push_str(index_var.as_str_const());
                    item_acc.push_str("])");
                } else {
                    item_acc.push_str(array_ptr_var.as_str_const());
                    item_acc.push('[');
                    item_acc.push_str(index_var.as_str_const());
                    item_acc.push(']');
                }

                self->emit_foreach_item_binding(
                    &foreach_->item_pattern,
                    item_acc.as_str_const(),
                    &element_inner_type,
                    false,
                    id
                );

                item_acc.free();
            }

            case .Slice { by_pointer, .. } => {
                var slice_type: cir::SemaType = *extract_typedef_inner_type(
                    self->tables,
                    iter_type.const_inner()
                );

                if (by_pointer) {
                    switch (slice_type) {
                        case .Pointer(pt) => {
                            slice_type = *extract_typedef_inner_type(self->tables, pt->const_inner());
                        }
                        else => {}
                    }
                }

                switch (slice_type.as_array_type()) case .Some(array) else {
                    self->body_out.push('}');
                    return;
                }

                self->types.ensure_slice();
                self->types.ensure_named(&slice_type);

                var element_inner_type: cir::SemaType = *array.element_type->const_inner();
                self->types.ensure_named(&element_inner_type);

                const element_pointer_type: cir::SemaType = .Pointer(&element_inner_type);
                var element_ptr_cast = self->types.build_decl(&element_pointer_type, "");

                var slice_var = String.from_str(self->allocator, "__cyrus_for_slice_");
                push_usize(&slice_var, id);
                defer slice_var.free();

                var slice_decl = self->types.build_decl(&slice_type, slice_var.as_str_const());
                var iter_expr = self->emit_expr(&foreach_->iterable);

                self->body_out.push_str(slice_decl.as_str_const());
                self->body_out.push('=');

                if (by_pointer) {
                    self->body_out.push_str("*(");
                    self->body_out.push_str(iter_expr.as_str_const());
                    self->body_out.push(')');
                } else {
                    self->body_out.push_str(iter_expr.as_str_const());
                }

                self->body_out.push(';');

                iter_expr.free();
                slice_decl.free();

                self->body_out.push_str("for(uintptr_t ");
                self->body_out.push_str(index_var.as_str_const());
                self->body_out.push_str("=0;");
                self->body_out.push_str(index_var.as_str_const());
                self->body_out.push('<');
                self->body_out.push_str(slice_var.as_str_const());
                self->body_out.push_str(".len;");
                self->body_out.push_str(index_var.as_str_const());
                self->body_out.push_str("+=1){");

                switch (foreach_->index_pattern) {
                    case .Some(idx_pat) => {
                        self->emit_tuple_export_pattern(&idx_pat, index_var.as_str_const(), true);
                    }
                    case .None => {}
                }

                var item_acc = String.new(self->allocator);

                if (by_pointer && is_ident_item) {
                    item_acc.push_str("(&((");
                    item_acc.push_str(element_ptr_cast.as_str_const());
                    item_acc.push(')');
                    item_acc.push_str(slice_var.as_str_const());
                    item_acc.push_str(".ptr)[");
                    item_acc.push_str(index_var.as_str_const());
                    item_acc.push_str("])");
                } else {
                    item_acc.push_str("(((");
                    item_acc.push_str(element_ptr_cast.as_str_const());
                    item_acc.push(')');
                    item_acc.push_str(slice_var.as_str_const());
                    item_acc.push_str(".ptr)[");
                    item_acc.push_str(index_var.as_str_const());
                    item_acc.push_str("])");
                }

                element_ptr_cast.free();

                self->emit_foreach_item_binding(
                    &foreach_->item_pattern,
                    item_acc.as_str_const(),
                    &element_inner_type,
                    false,
                    id
                );

                item_acc.free();
            }

            case .Iterator {
                next_dispatch,
                option_type,
                element_type,
                pass_by_addr,
                is_interface_fat_ptr,
            } => {
                var iter_var = String.from_str(self->allocator, "__cyrus_for_iter_");
                push_usize(&iter_var, id);
                defer iter_var.free();

                var iter_expr = self->emit_expr(&foreach_->iterable);

                if (is_interface_fat_ptr) {
                    self->types.ensure_fat_ptr();
                    self->body_out.push_str("__fat_ptr ");
                    self->body_out.push_str(iter_var.as_str_const());
                    self->body_out.push('=');

                    if (pass_by_addr) {
                        self->body_out.push_str(iter_expr.as_str_const());
                    } else {
                        self->body_out.push_str("*(");
                        self->body_out.push_str(iter_expr.as_str_const());
                        self->body_out.push(')');
                    }
                    
                    self->body_out.push(';');
                } else {
                    var concrete_type: cir::SemaType = *iter_type.const_inner();
                    
                    if (!pass_by_addr) {
                        switch (concrete_type) {
                            case .Pointer(pt) => concrete_type = *pt->const_inner();
                            else => {}
                        }
                    }

                    concrete_type = *extract_typedef_inner_type(self->tables, &concrete_type);
                    self->types.ensure_named(&concrete_type);

                    const iter_ptr_ty: cir::SemaType = .Pointer(&concrete_type);
                    
                    var iter_ptr_decl = self->types.build_decl(&iter_ptr_ty, iter_var.as_str_const());

                    if (pass_by_addr) {
                        var iter_val_var = String.from_str(self->allocator, "__cyrus_for_iter_val_");
                        push_usize(&iter_val_var, id);

                        var iter_val_decl = self->types.build_decl(
                            &concrete_type, 
                            iter_val_var.as_str_const()
                        );
                        self->body_out.push_str(iter_val_decl.as_str_const());
                        self->body_out.push('=');
                        self->body_out.push_str(iter_expr.as_str_const());
                        self->body_out.push(';');

                        self->body_out.push_str(iter_ptr_decl.as_str_const());
                        self->body_out.push_str("=&");
                        self->body_out.push_str(iter_val_var.as_str_const());
                        self->body_out.push(';');

                        iter_val_decl.free();
                        iter_val_var.free();
                    } else {
                        var iter_ptr_cast = self->types.build_decl(&iter_ptr_ty, "");
                        self->body_out.push_str(iter_ptr_decl.as_str_const());
                        self->body_out.push_str("=(");
                        self->body_out.push_str(iter_ptr_cast.as_str_const());
                        self->body_out.push_str(")(");
                        self->body_out.push_str(iter_expr.as_str_const());
                        self->body_out.push_str(");");
                        iter_ptr_cast.free();
                    }

                    iter_ptr_decl.free();
                }

                iter_expr.free();

                if (foreach_->index_pattern.is_some()) {
                    self->body_out.push_str("uintptr_t ");
                    self->body_out.push_str(index_var.as_str_const());
                    self->body_out.push_str("=0;for(;;");
                    self->body_out.push_str(index_var.as_str_const());
                    self->body_out.push_str("+=1){");
                } else {
                    self->body_out.push_str("for(;;){");
                }

                var some_tag: uint32 = 0;

                switch (option_type.const_inner()->as_named_type()) {
                    case .Some(opt_named) => {
                        switch (opt_named.type_decl_id.as_enum()) {
                            case .Some(enum_id) => {
                                switch (self->tables->enums.get_const(enum_id)) {
                                    case .Some(enum_decl) => {
                                        for (var vi: usize = 0; vi < enum_decl->variants.len(); vi += 1) {
                                            const variant = enum_decl->variants.get_const(vi).unwrap();
                                            
                                            if (variant->name() == "Some") {
                                                some_tag = @cast(uint32, vi);
                                                break;
                                            }
                                        }
                                    }
                                    case .None => {}
                                }
                            }
                            case .None => {}
                        }
                    }
                    case .None => {}
                }

                self->types.ensure_named(&option_type);

                var opt_var = String.from_str(self->allocator, "__cyrus_for_opt_");
                push_usize(&opt_var, id);

                var opt_decl = self->types.build_decl(&option_type, opt_var.as_str_const());

                var next_call = self->emit_foreach_next_call(
                    &next_dispatch,
                    &option_type,
                    iter_var.as_str_const()
                );

                self->body_out.push_str(opt_decl.as_str_const());
                self->body_out.push('=');
                self->body_out.push_str(next_call.as_str_const());
                self->body_out.push_str(";if(");
                self->body_out.push_str(opt_var.as_str_const());
                self->body_out.push_str(".tag!=");
                push_uint32(&self->body_out, some_tag);
                self->body_out.push_str("){break;}");

                opt_decl.free();
                next_call.free();

                switch (foreach_->index_pattern) {
                    case .Some(idx_pat) => {
                        self->emit_tuple_export_pattern(&idx_pat, index_var.as_str_const(), true);
                    }
                    case .None => {}
                }

                var payload_acc = self->enum_tuple_payload_base(
                    opt_var.as_str_const(),
                    some_tag,
                    0
                );

                var deref_ptr = false;
                var destruct_value_type: cir::SemaType = *element_type.const_inner();

                switch (*element_type.const_inner()) {
                    case .Pointer(inner) => {
                        deref_ptr = true;
                        destruct_value_type = *inner->const_inner();
                    }
                    else => {}
                }

                self->emit_foreach_item_binding(
                    &foreach_->item_pattern,
                    payload_acc.as_str_const(),
                    &destruct_value_type,
                    deref_ptr,
                    id
                );

                payload_acc.free();
                opt_var.free();
            }

            case .Unresolved => {
                self->body_out.push('}');
                return;
            }
        }

        self->loop_marks.push(self->defer_scopes.len());
        self->emit_block_stmts(foreach_->body, true);
        self->loop_marks.pop();

        self->body_out.push_str("}}");
    }

    fn emit_switch(self: Self*, switch_: const cir::SwitchStmt*) {
        var enum_decl_id: cir::EnumDeclId;
        var is_scalar_enum = false;
        var is_enum = false;

        switch (switch_->operand.ty) {
            case .Some(ty) => {
                switch (ty.as_enum()) {
                    case .Some(id) => {
                        is_enum = true;
                        enum_decl_id = id;

                        switch (self->tables->enums.get_const(enum_decl_id)) {
                            case .Some(decl) => {
                                is_scalar_enum = is_enum_scalar_optimizable(self->tables, decl);
                            }
                            else => {}
                        }
                    }
                    else => {}
                }
            }
            else => {}
        }

        if (is_enum && is_scalar_enum) {
            self->emit_switch_scalar_enum(switch_, enum_decl_id);
            return;
        }

        if (is_enum) {
            self->emit_switch_payload_enum(switch_, enum_decl_id);
            return;
        }

        if (!switch_->includes_any_range()) {
            switch (switch_->operand.ty) {
                case .Some(ty) => {
                    if (ty.is_integer()) {
                        self->emit_switch_integer(switch_);
                        return;
                    }
                }
                else => {
                    self->emit_switch_integer(switch_);
                    return;
                }
            }
        }

        self->emit_switch_if_chain(switch_);
    }

    fn emit_switch_scalar_enum(
        self: Self*, 
        switch_: const cir::SwitchStmt*, 
        enum_decl_id: cir::EnumDeclId
    ) {
        var name: String;

        switch (switch_->operand.ty) {
            case .Some(ty) => {
                name = self->types.enum_c_name_for_ty(&ty);
            }
            else => {
                name = self->types.enum_c_name(enum_decl_id);
            }
        }

        var operand = self->emit_expr(&switch_->operand);
        self->body_out.push_str("switch(");
        self->body_out.push_str(operand.as_str_const());
        self->body_out.push_str("){");
        operand.free();

        for (var if_: usize = 0; if_ < switch_->cases.len(); if_ += 1) {
            const case_ = switch_->cases.get_const(if_).unwrap();

            var has_default_label = false;
            var binding_name: const uint8*;
            var tuple_decls = String.new(self->allocator);

            for (var j: usize = 0; j < case_->patterns.len(); j += 1) {
                const pattern = case_->patterns.get_const(j).unwrap();
                
                switch (pattern->kind) {
                    case .Wildcard => {
                        if (!has_default_label) {
                            self->body_out.push_str("default:");
                            has_default_label = true;
                        }
                    }

                    case .EnumUnit(ident) => {
                        self->body_out.push_str("case ");
                        self->body_out.push_str(name.as_str_const());
                        self->body_out.push('_');
                        self->body_out.push_str(ident.str.as_str_const());
                        self->body_out.push(':');
                    }

                    case .EnumTupleVariant { ident, items } => {
                        self->body_out.push_str("case ");
                        self->body_out.push_str(name.as_str_const());
                        self->body_out.push('_');
                        self->body_out.push_str(ident.str.as_str_const());
                        self->body_out.push(':');

                        for (var k: usize = 0; k < items.len(); k += 1) {
                            const item = items.get_const(k).unwrap();

                            switch (item->kind) {
                                case .Binding { name: item_binding, .. } => {
                                    switch (switch_->operand.ty) {
                                        case .Some(ty) => {
                                            var type_name = self->types.type_name(&ty);

                                            tuple_decls.push_str(type_name.as_str_const());
                                            tuple_decls.push(' ');
                                            mangle::sanitize_into(&tuple_decls, item_binding.str.as_str_const());
                                            tuple_decls.push('=');
                                            tuple_decls.push_str(name.as_str_const());
                                            tuple_decls.push('_');
                                            tuple_decls.push_str(ident.str.as_str_const());
                                            tuple_decls.push(';');
                                            type_name.free();
                                        }
                                        else => {}
                                    }
                                }
                                else => {}
                            }
                        }
                    }

                    case .Binding { name: binding_ident, .. } => {
                        if (!has_default_label) {
                            self->body_out.push_str("default:");
                            has_default_label = true;
                        }

                        binding_name = binding_ident.str.as_str_const();
                    }

                    case .Expr(expr) => {
                        switch (expr.literal_const_int_value()) {
                            case .Some(literal) => {
                                self->body_out.push_str("case ");

                                switch (literal) {
                                    case .Signed(x) => push_int128(&self->body_out, x);
                                    case .Unsigned(x) => push_uint128(&self->body_out, x);
                                }
                                
                                self->body_out.push(':');
                            }
                            case .None => {
                                if (!has_default_label) {
                                    self->body_out.push_str("default:");
                                    has_default_label = true;
                                }
                            }
                        }
                    }

                    else => {
                        if (!has_default_label) {
                            self->body_out.push_str("default:");
                            has_default_label = true;
                        }
                    }
                }
            }

            self->body_out.push('{');

            if (binding_name != null) {
                switch (switch_->operand.ty) {
                    case .Some(ty) => {
                        var type_name = self->types.type_name(&ty);

                        self->body_out.push_str(type_name.as_str_const());
                        self->body_out.push(' ');
                        mangle::sanitize_into(&self->body_out, binding_name);
                        self->body_out.push('=');
                        
                        var expr = self->emit_expr(&switch_->operand);
                        self->body_out.push_str(expr.as_str_const());
                        expr.free();

                        self->body_out.push(';');
                        type_name.free();
                    }
                    else => {}
                }
            }

            self->body_out.push_str(tuple_decls.as_str_const());
            tuple_decls.free();

            self->emit_block_stmts(case_->body, true);
            self->body_out.push_str("}break;");
        }

        switch (switch_->else_case) {
            case .Some(else_case) => {
                self->body_out.push_str("default:{");
                self->emit_block_stmts(&else_case, true);
                self->body_out.push_str("}break;");
            }
            else => {
                self->body_out.push_str("default:break;");
            }
        }

        self->body_out.push('}');
        name.free();
    }

    fn hoist_switch_binding(
        self: Self*,
        var_decl_id: cir::VarDeclId,
        binding_name: const ast::ASTIdent*,
        ty: const cir::SemaType*
    ) {
        if (self->switch_binding_names.contains_key(var_decl_id)) {
            return;
        }

        self->types.ensure_named(ty);

        var c_name = mangle::sanitized(self->allocator, binding_name->str.as_str_const());

        var suffix: usize = 1;

        while (self->switch_binding_name_taken(c_name.as_str_const())) {
            var unique = String.from_str(self->allocator, binding_name->str.as_str_const());
            unique.push_str("__");
            push_usize(&unique, suffix);

            c_name.free();
            c_name = mangle::sanitized(self->allocator, unique.as_str_const());
            
            unique.free();
            suffix += 1;
        }

        var decl = self->types.build_decl(ty, c_name.as_str_const());

        self->body_out.push_str(decl.as_str_const());
        self->body_out.push_str("={0};");
        
        decl.free();

        self->switch_binding_owned.push(c_name);
        self->switch_binding_names.insert(var_decl_id, c_name);

        var scoped = String.from_str(self->allocator, c_name.as_str_const());
        self->fn_scope_names.push(scoped);
    }

    fn switch_binding_name_taken(self: Self*, candidate: const uint8*) bool {
        for (var i: usize = 0; i < self->switch_binding_owned.len(); i += 1) {
            const existing = self->switch_binding_owned.get_const(i).unwrap();

            if (existing->as_str_const() == candidate) {
                return true;
            }
        }

        return self->fn_name_taken(candidate);
    }

    fn hoist_nested_pattern_item(
        self: Self*,
        item: const cir::SwitchCasePattern*,
        item_type: const cir::SemaType*,
        tags: const Vec<uint32>*
    ) {
        switch (item->kind) {
            case .Binding { name, var_decl_id } => {
                self->hoist_switch_binding(var_decl_id, &name, item_type);
            }

            case .EnumTupleVariant | .EnumStructVariant => {
                switch (item_type->as_enum()) {
                    case .Some(inner_enum_id) => {
                        switch (self->tables->enums.get_const(inner_enum_id)) {
                            case .Some(inner_decl) => {
                                // A nested enum value carries its own
                                // instantiated type arguments
                                var nested_args: const cir::TypeArgs* = null;

                                switch (*item_type->const_inner()) {
                                    case .Named(named) => {
                                        if (!named.type_args.is_empty()) {
                                            nested_args = &named.type_args;
                                        }
                                    }
                                    else => {}
                                }

                                self->hoist_switch_pattern_bindings(
                                    item,
                                    inner_decl,
                                    tags,
                                    nested_args,
                                    item_type
                                );
                            }
                            else => {}
                        }
                    }
                    else => {}
                }
            }

            else => {}
        }
    }

    fn hoist_switch_pattern_bindings(
        self: Self*,
        pattern: const cir::SwitchCasePattern*,
        enum_decl: const cir::EnumDecl*,
        tags: const Vec<uint32>*,
        inst_args: const cir::TypeArgs*,
        operand_type: const cir::SemaType*
    ) {
        switch (pattern->kind) {
            case .Binding { name, var_decl_id } => {
                self->hoist_switch_binding(var_decl_id, &name, operand_type);
            }

            case .EnumTupleVariant { ident, items } => {
                switch (enum_decl->lookup_variant(ident.str.as_str_const())) {
                    case .Some(variant) => {
                        switch (*variant) {
                            case .Tuple { fields, .. } => {
                                for (var k: usize = 0; k < items.len(); k += 1) {
                                    const item = items.get_const(k).unwrap();

                                    switch (item->kind) {
                                        case .Binding { name, var_decl_id } => {
                                            if (k < fields.len()) {
                                                const field = fields.get_const(k).unwrap();
                                                
                                                var field_typepe: cir::SemaType = field->ty;

                                                if (inst_args != null) {
                                                    field_typepe = cir::substitute_sema_type_with_type_args(
                                                        dynamic self->arena,
                                                        &field->ty,
                                                        &enum_decl->generic_params,
                                                        inst_args
                                                    );
                                                }

                                                self->hoist_switch_binding(var_decl_id, &name, &field_typepe);
                                            }
                                        }
                                        else => {
                                            if (k < fields.len()) {
                                                const field = fields.get_const(k).unwrap();

                                                var nested_type = self->substitute_variant_field_typepe(
                                                    enum_decl,
                                                    &field->ty,
                                                    inst_args
                                                );

                                                self->hoist_nested_pattern_item(
                                                    item,
                                                    &nested_type,
                                                    tags
                                                );
                                            }
                                        }
                                    }
                                }
                            }

                            case .Valued { value, .. } => {
                                for (var k: usize = 0; k < items.len(); k += 1) {
                                    const item = items.get_const(k).unwrap();

                                    switch (item->kind) {
                                        case .Binding { name, var_decl_id } => {
                                            switch (value->ty) {
                                                case .Some(value_ty) => {
                                                    self->hoist_switch_binding(var_decl_id, &name, &value_ty);
                                                }
                                                else => {}
                                            }
                                        }
                                        else => {
                                            switch (value->ty) {
                                                case .Some(value_ty) => {
                                                    var nested_type = self->substitute_variant_field_typepe(
                                                        enum_decl,
                                                        &value_ty,
                                                        inst_args
                                                    );

                                                    self->hoist_nested_pattern_item(
                                                        item,
                                                        &nested_type,
                                                        tags
                                                    );
                                                }
                                                else => {}
                                            }
                                        }
                                    }
                                }
                            }
                            else => {}
                        }
                    }
                    else => {}
                }
            }

            case .EnumStructVariant { ident, items, .. } => {
                switch (enum_decl->lookup_variant(ident.str.as_str_const())) {
                    case .Some(variant) => {
                        switch (*variant) {
                            case .Struct { fields, .. } => {
                                for (var k: usize = 0; k < items.len(); k += 1) {
                                    const item = items.get_const(k).unwrap();

                                    switch (item->pattern.kind) {
                                        case .Binding { name, var_decl_id } => {
                                            for (var f: usize = 0; f < fields.len(); f += 1) {
                                                const field = fields.get_const(f).unwrap();

                                                if (field->name.str.as_str_const() == item->name.str.as_str_const()) {
                                                    var field_typepe: cir::SemaType = field->ty;

                                                    if (inst_args != null) {
                                                        field_typepe = cir::substitute_sema_type_with_type_args(
                                                            dynamic self->arena,
                                                            &field->ty,
                                                            &enum_decl->generic_params,
                                                            inst_args
                                                        );
                                                    }

                                                    self->hoist_switch_binding(var_decl_id, &name, &field_typepe);
                                                    break;
                                                }
                                            }
                                        }
                                        else => {
                                            for (var f: usize = 0; f < fields.len(); f += 1) {
                                                const field = fields.get_const(f).unwrap();

                                                if (field->name.str.as_str_const() == item->name.str.as_str_const()) {
                                                    var nested_type = self->substitute_variant_field_typepe(
                                                        enum_decl,
                                                        &field->ty,
                                                        inst_args
                                                    );

                                                    self->hoist_nested_pattern_item(
                                                        &item->pattern,
                                                        &nested_type,
                                                        tags
                                                    );
                                                    break;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            else => {}
                        }
                    }
                    else => {}
                }
            }
            else => {}
        }
    }

    fn substitute_variant_field_typepe(
        self: Self*,
        enum_decl: const cir::EnumDecl*,
        ty: const cir::SemaType*,
        inst_args: const cir::TypeArgs*
    ) cir::SemaType {
        if (inst_args != null) {
            return cir::substitute_sema_type_with_type_args(
                dynamic self->arena,
                ty,
                &enum_decl->generic_params,
                inst_args
            );
        }

        return *ty;
    }

    fn enum_tuple_payload_base(
        self: Self*,
        base: const uint8*,
        tag: uint32,
        index: usize
    ) String {
        var out = String.from_str(self->allocator, base);
        out.push_str(".u.v");
        push_uint32(&out, tag);
        out.push('.');

        var field_name = self->tuple_field_name(index);
        out.push_str(field_name.as_str_const());
        field_name.free();

        return out;
    }

    fn enum_valued_payload_base(
        self: Self*,
        base: const uint8*,
        tag: uint32
    ) String {
        var out = String.from_str(self->allocator, base);
        out.push_str(".u.v");
        push_uint32(&out, tag);
        out.push_str(".value");
        return out;
    }

    fn emit_enum_pattern_condition(
        self: Self*,
        pattern: const cir::SwitchCasePattern*,
        enum_decl: const cir::EnumDecl*,
        tags: const Vec<uint32>*,
        inst_args: const cir::TypeArgs*,
        base: const uint8*,
        out: String*
    ) {
        const scalar = is_enum_scalar_optimizable(self->tables, enum_decl);

        switch (pattern->kind) {
            case .EnumUnit(ident) => {
                const tag = enum_decl->find_variant_tag(tags, ident.str.as_str_const());

                if (out->len() > 0) {
                    out->push_str(" && ");
                }

                out->push_str(base);

                if (scalar) {
                    out->push_str(" == ");
                } else {
                    out->push_str(".tag == ");
                }
                
                push_uint32(out, tag);
            }

            case .EnumTupleVariant { ident, items } => {
                const tag = enum_decl->find_variant_tag(tags, ident.str.as_str_const());

                if (out->len() > 0) {
                    out->push_str(" && ");
                }

                out->push_str(base);
                out->push_str(".tag == ");
                push_uint32(out, tag);

                switch (enum_decl->lookup_variant(ident.str.as_str_const())) {
                    case .Some(variant) => {
                        switch (*variant) {
                            case .Tuple { fields, .. } => {
                                for (var k: usize = 0; k < items.len(); k += 1) {
                                    if (k >= fields.len()) {
                                        break;
                                    }

                                    const item = items.get_const(k).unwrap();
                                    const field = fields.get_const(k).unwrap();

                                    var nested_type = self->substitute_variant_field_typepe(
                                        enum_decl,
                                        &field->ty,
                                        inst_args
                                    );

                                    var child_base = self->enum_tuple_payload_base(base, tag, k);
                                    
                                    self->emit_nested_pattern_condition(
                                        item,
                                        &nested_type,
                                        child_base.as_str_const(),
                                        out
                                    );
                                    
                                    child_base.free();
                                }
                            }

                            case .Valued { value, .. } => {
                                if (items.len() > 0) {
                                    switch (value->ty) {
                                        case .Some(value_ty) => {
                                            const item = items.get_const(0).unwrap();

                                            var nested_type = self->substitute_variant_field_typepe(
                                                enum_decl,
                                                &value_ty,
                                                inst_args
                                            );

                                            var child_base = self->enum_valued_payload_base(base, tag);
                                            
                                            self->emit_nested_pattern_condition(
                                                item,
                                                &nested_type,
                                                child_base.as_str_const(),
                                                out
                                            );
                                            
                                            child_base.free();
                                        }
                                        else => {}
                                    }
                                }
                            }

                            else => {}
                        }
                    }
                    else => {}
                }
            }

            case .EnumStructVariant { ident, items, .. } => {
                const tag = enum_decl->find_variant_tag(tags, ident.str.as_str_const());

                if (out->len() > 0) {
                    out->push_str(" && ");
                }

                out->push_str(base);
                out->push_str(".tag == ");
                push_uint32(out, tag);

                switch (enum_decl->lookup_variant(ident.str.as_str_const())) {
                    case .Some(variant) => {
                        switch (*variant) {
                            case .Struct { fields, .. } => {
                                for (var k: usize = 0; k < items.len(); k += 1) {
                                    const item = items.get_const(k).unwrap();

                                    for (var f: usize = 0; f < fields.len(); f += 1) {
                                        const field = fields.get_const(f).unwrap();

                                        if (field->name.str.as_str_const() == item->name.str.as_str_const()) {
                                            var nested_type = self->substitute_variant_field_typepe(
                                                enum_decl,
                                                &field->ty,
                                                inst_args
                                            );
                                            
                                            var child_base = String.from_str(self->allocator, base);
                                            
                                            child_base.push_str(".u.v");
                                            push_uint32(&child_base, tag);
                                            child_base.push('.');
                                            mangle::sanitize_into(
                                                &child_base,
                                                item->name.str.as_str_const()
                                            );

                                            self->emit_nested_pattern_condition(
                                                &item->pattern,
                                                &nested_type,
                                                child_base.as_str_const(),
                                                out
                                            );

                                            child_base.free();
                                            break;
                                        }
                                    }
                                }
                            }
                            else => {}
                        }
                    }
                    else => {}
                }
            }

            else => {}
        }
    }

    fn emit_nested_pattern_condition(
        self: Self*,
        item: const cir::SwitchCasePattern*,
        item_type: const cir::SemaType*,
        base: const uint8*,
        out: String*
    ) {
        switch (item->kind) {
            case .EnumUnit | .EnumTupleVariant | .EnumStructVariant => {
                switch (item_type->as_enum()) {
                    case .Some(inner_enum_id) => {
                        switch (self->tables->enums.get_const(inner_enum_id)) {
                            case .Some(inner_decl) => {
                                const inner_tags = self->types.tctx.enum_variant_tags(
                                    inner_enum_id,
                                    inner_decl
                                );

                                var nested_args: const cir::TypeArgs* = null;

                                switch (*item_type->const_inner()) {
                                    case .Named(named) => {
                                        if (!named.type_args.is_empty()) {
                                            nested_args = &named.type_args;
                                        }
                                    }
                                    else => {}
                                }

                                self->emit_enum_pattern_condition(
                                    item,
                                    inner_decl,
                                    inner_tags,
                                    nested_args,
                                    base,
                                    out
                                );
                            }
                            else => {}
                        }
                    }
                    else => {}
                }
            }
            else => {}
        }
    }

    fn assign_switch_binding(
        self: Self*,
        var_decl_id: cir::VarDeclId,
        base: const uint8*
    ) {
        switch (self->switch_binding_names.get(var_decl_id)) {
            case .Some(c_name) => {
                self->body_out.push_str(c_name->as_str_const());
                self->body_out.push('=');
                self->body_out.push_str(base);
                self->body_out.push(';');
            }
            else => {}
        }
    }

    fn emit_nested_pattern_bindings(
        self: Self*,
        item: const cir::SwitchCasePattern*,
        item_type: const cir::SemaType*,
        base: const uint8*
    ) {
        switch (item->kind) {
            case .Binding { var_decl_id, .. } => {
                self->assign_switch_binding(var_decl_id, base);
            }

            case .EnumTupleVariant | .EnumStructVariant => {
                switch (item_type->as_enum()) {
                    case .Some(inner_enum_id) => {
                        switch (self->tables->enums.get_const(inner_enum_id)) {
                            case .Some(inner_decl) => {
                                const inner_tags = self->types.tctx.enum_variant_tags(
                                    inner_enum_id,
                                    inner_decl
                                );

                                var nested_args: const cir::TypeArgs* = null;

                                switch (*item_type->const_inner()) {
                                    case .Named(named) => {
                                        if (!named.type_args.is_empty()) {
                                            nested_args = &named.type_args;
                                        }
                                    }
                                    else => {}
                                }

                                self->emit_enum_pattern_bindings(
                                    item,
                                    inner_decl,
                                    inner_tags,
                                    nested_args,
                                    base
                                );
                            }
                            else => {}
                        }
                    }
                    else => {}
                }
            }

            else => {}
        }
    }

    fn emit_enum_pattern_bindings(
        self: Self*,
        pattern: const cir::SwitchCasePattern*,
        enum_decl: const cir::EnumDecl*,
        tags: const Vec<uint32>*,
        inst_args: const cir::TypeArgs*,
        base: const uint8*
    ) {
        switch (pattern->kind) {
            case .Binding { var_decl_id, .. } => {
                self->assign_switch_binding(var_decl_id, base);
            }

            case .EnumTupleVariant { ident, items } => {
                const tag = enum_decl->find_variant_tag(tags, ident.str.as_str_const());

                switch (enum_decl->lookup_variant(ident.str.as_str_const())) {
                    case .Some(variant) => {
                        switch (*variant) {
                            case .Tuple { fields, .. } => {
                                for (var k: usize = 0; k < items.len(); k += 1) {
                                    if (k >= fields.len()) {
                                        break;
                                    }

                                    const item = items.get_const(k).unwrap();
                                    const field = fields.get_const(k).unwrap();

                                    var nested_type = self->substitute_variant_field_typepe(
                                        enum_decl,
                                        &field->ty,
                                        inst_args
                                    );

                                    var child_base = self->enum_tuple_payload_base(base, tag, k);
                                    
                                    self->emit_nested_pattern_bindings(
                                        item,
                                        &nested_type,
                                        child_base.as_str_const()
                                    );
                                    
                                    child_base.free();
                                }
                            }

                            case .Valued { value, .. } => {
                                if (items.len() > 0) {
                                    switch (value->ty) {
                                        case .Some(value_ty) => {
                                            const item = items.get_const(0).unwrap();

                                            var nested_type = self->substitute_variant_field_typepe(
                                                enum_decl,
                                                &value_ty,
                                                inst_args
                                            );
                                            var child_base = self->enum_valued_payload_base(base, tag);
                                            self->emit_nested_pattern_bindings(
                                                item,
                                                &nested_type,
                                                child_base.as_str_const()
                                            );
                                            child_base.free();
                                        }
                                        else => {}
                                    }
                                }
                            }

                            else => {}
                        }
                    }
                    else => {}
                }
            }

            case .EnumStructVariant { ident, items, .. } => {
                const tag = enum_decl->find_variant_tag(tags, ident.str.as_str_const());

                switch (enum_decl->lookup_variant(ident.str.as_str_const())) {
                    case .Some(variant) => {
                        switch (*variant) {
                            case .Struct { fields, .. } => {
                                for (var k: usize = 0; k < items.len(); k += 1) {
                                    const item = items.get_const(k).unwrap();

                                    for (var f: usize = 0; f < fields.len(); f += 1) {
                                        const field = fields.get_const(f).unwrap();

                                        if (field->name.str.as_str_const() == item->name.str.as_str_const()) {
                                            var nested_type = self->substitute_variant_field_typepe(
                                                enum_decl,
                                                &field->ty,
                                                inst_args
                                            );
                                            
                                            var child_base = String.from_str(self->allocator, base);
                                            
                                            child_base.push_str(".u.v");
                                            push_uint32(&child_base, tag);
                                            child_base.push('.');
                                            mangle::sanitize_into(
                                                &child_base,
                                                item->name.str.as_str_const()
                                            );

                                            self->emit_nested_pattern_bindings(
                                                &item->pattern,
                                                &nested_type,
                                                child_base.as_str_const()
                                            );

                                            child_base.free();
                                            break;
                                        }
                                    }
                                }
                            }
                            else => {}
                        }
                    }
                    else => {}
                }
            }

            else => {}
        }
    }

    fn emit_switch_payload_enum(
        self: Self*, 
        switch_: const cir::SwitchStmt*, 
        enum_decl_id: cir::EnumDeclId
    ) {
        const enum_decl = self->tables->enums.get_const(enum_decl_id).unwrap();
        const tags = self->types.tctx.enum_variant_tags(enum_decl_id, enum_decl);

        var operand_name: String;

        var has_operand_type = false;
        var inst_args_storage: cir::TypeArgs;
        var has_inst_args = false;

        switch (switch_->operand.ty) {
            case .Some(ty) => {
                operand_name = self->types.enum_c_name_for_ty(&ty);
                has_operand_type = true;

                switch (*ty.const_inner()) {
                    case .Named(named) => {
                        if (!named.type_args.is_empty()) {
                            inst_args_storage = clone::clone_typed_type_args(
                                self->allocator, 
                                &named.type_args
                            );
                            has_inst_args = true;
                        }
                    }
                    else => {}
                }
            }
            else => {}
        }

        if (!has_operand_type) {
            operand_name = self->types.enum_c_name(enum_decl_id);
        }

        var inst_args: const cir::TypeArgs* = null;

        if (has_inst_args) {
            inst_args = &inst_args_storage;
        }

        var has_operand_ty = false;
        var operand_type: cir::SemaType = .Plain(.Void);

        switch (switch_->operand.ty) {
            case .Some(ty) => {
                operand_type = ty;
                has_operand_ty = true;
            }
            else => {}
        }

        if (has_operand_ty) {
            const mark = self->arena.mark();

            for (var i: usize = 0; i < switch_->cases.len(); i += 1) {
                const case_ = switch_->cases.get_const(i).unwrap();

                for (var j: usize = 0; j < case_->patterns.len(); j += 1) {
                    const pattern = case_->patterns.get_const(j).unwrap();
                    
                    self->hoist_switch_pattern_bindings(
                        pattern,
                        enum_decl,
                        tags,
                        inst_args,
                        &operand_type
                    );
                }
            }

            self->arena.restore(mark);
        }

        var operand = self->emit_expr(&switch_->operand);

        self->body_out.push('{');
        self->body_out.push_str(operand_name.as_str_const());
        self->body_out.push_str(" __sw_op=");
        self->body_out.push_str(operand.as_str_const());
        self->body_out.push(';');
        operand.free();

        var first = true;

        for (var i: usize = 0; i < switch_->cases.len(); i += 1) {
            const case_ = switch_->cases.get_const(i).unwrap();

            var has_wildcard = false;
            for (var j: usize = 0; j < case_->patterns.len(); j += 1) {
                switch (case_->patterns.get_const(j).unwrap()->kind) {
                    case .Wildcard => {
                        has_wildcard = true;
                        break;
                    }
                    else => {}
                }
            }

            if (has_wildcard) {
                if (!first) {
                    self->body_out.push_str("else");
                }
                first = false;
                self->body_out.push('{');
                self->emit_block_stmts(case_->body, true);
                self->body_out.push('}');
                continue;
            }

            if (case_->patterns.len() == 0) {
                continue;
            }

            var combined_cond = String.new(self->allocator);
            var has_any_binding = false;

            const cond_mark = self->arena.mark();

            for (var j: usize = 0; j < case_->patterns.len(); j += 1) {
                const pattern = case_->patterns.get_const(j).unwrap();

                if (j > 0) {
                    combined_cond.push_str("||");
                }

                switch (pattern->kind) {
                    case .EnumUnit(ident) => {
                        const tag = enum_decl->find_variant_tag(tags, ident.str.as_str_const());
                        combined_cond.push_str("(__sw_op.tag==");
                        push_uint32(&combined_cond, tag);
                        combined_cond.push(')');
                    }
                    case .EnumTupleVariant | .EnumStructVariant => {
                        has_any_binding = true;
                        var pattern_cond = String.new(self->allocator);
                        self->emit_enum_pattern_condition(
                            pattern,
                            enum_decl,
                            tags,
                            inst_args,
                            "__sw_op",
                            &pattern_cond
                        );
                        combined_cond.push('(');
                        combined_cond.push_str(pattern_cond.as_str_const());
                        combined_cond.push(')');
                        pattern_cond.free();
                    }
                    case .Binding => {
                        has_any_binding = true;
                        combined_cond.push('1');
                    }
                    else => {
                        combined_cond.push('0');
                    }
                }
            }

            self->arena.restore(cond_mark);

            if (first) {
                self->body_out.push_str("if(");
                first = false;
            } else {
                self->body_out.push_str("else if(");
            }

            self->body_out.push_str(combined_cond.as_str_const());
            self->body_out.push_str("){");
            combined_cond.free();

            if (has_any_binding) {
                const bind_mark = self->arena.mark();

                if (case_->patterns.len() == 1) {
                    const pattern = case_->patterns.get_const(0).unwrap();

                    switch (pattern->kind) {
                        case .EnumTupleVariant | .EnumStructVariant => {
                            self->emit_enum_pattern_bindings(
                                pattern,
                                enum_decl,
                                tags,
                                inst_args,
                                "__sw_op"
                            );
                        }
                        case .Binding { var_decl_id, .. } => {
                            switch (self->switch_binding_names.get(var_decl_id)) {
                                case .Some(c_name) => {
                                    self->body_out.push_str(c_name->as_str_const());
                                    self->body_out.push_str("=__sw_op;");
                                }
                                else => {}
                            }
                        }
                        else => {}
                    }
                } else {
                    var is_first_binding_branch = true;

                    for (var j: usize = 0; j < case_->patterns.len(); j += 1) {
                        const pattern = case_->patterns.get_const(j).unwrap();

                        switch (pattern->kind) {
                            case .EnumTupleVariant | .EnumStructVariant => {
                                var pattern_cond = String.new(self->allocator);

                                self->emit_enum_pattern_condition(
                                    pattern,
                                    enum_decl,
                                    tags,
                                    inst_args,
                                    "__sw_op",
                                    &pattern_cond
                                );

                                if (is_first_binding_branch) {
                                    self->body_out.push_str("if(");
                                    is_first_binding_branch = false;
                                } else {
                                    self->body_out.push_str("else if(");
                                }

                                self->body_out.push_str(pattern_cond.as_str_const());
                                self->body_out.push_str("){");
                                pattern_cond.free();
                                self->emit_enum_pattern_bindings(
                                    pattern,
                                    enum_decl,
                                    tags,
                                    inst_args,
                                    "__sw_op"
                                );
                                self->body_out.push('}');
                            }
                            case .Binding { var_decl_id, .. } => {
                                if (is_first_binding_branch) {
                                    self->body_out.push_str("if(1){");
                                    is_first_binding_branch = false;
                                } else {
                                    self->body_out.push_str("else if(1){");
                                }

                                switch (self->switch_binding_names.get(var_decl_id)) {
                                    case .Some(c_name) => {
                                        self->body_out.push_str(c_name->as_str_const());
                                        self->body_out.push_str("=__sw_op;");
                                    }
                                    else => {}
                                }

                                self->body_out.push('}');
                            }
                            else => {}
                        }
                    }
                }

                self->arena.restore(bind_mark);
            }

            self->emit_block_stmts(case_->body, true);
            self->body_out.push('}');
        }

        switch (switch_->else_case) {
            case .Some(else_case) => {
                if (!first) {
                    self->body_out.push_str("else");
                }
                self->body_out.push('{');
                self->emit_block_stmts(&else_case, true);
                self->body_out.push('}');
            }
            else => {}
        }

        self->body_out.push('}');
        operand_name.free();

        if (has_inst_args) {
            inst_args_storage.free();
        }
    }

    fn emit_switch_integer(self: Self*, switch_: const cir::SwitchStmt*) {
        var operand = self->emit_expr(&switch_->operand);
        self->body_out.push_str("switch(");
        self->body_out.push_str(operand.as_str_const());
        self->body_out.push_str("){");
        operand.free();

        for (var i: usize = 0; i < switch_->cases.len(); i += 1) {
            const case_ = switch_->cases.get_const(i).unwrap();

            var has_default_label = false;
            var binding_name: const uint8*;

            for (var j: usize = 0; j < case_->patterns.len(); j += 1) {
                const pattern = case_->patterns.get_const(j).unwrap();

                switch (pattern->kind) {
                    case .Wildcard => {
                        if (!has_default_label) {
                            self->body_out.push_str("default:");
                            has_default_label = true;
                        }
                    }

                    case .Binding { name, .. } => {
                        if (!has_default_label) {
                            self->body_out.push_str("default:");
                            has_default_label = true;
                        }
                        binding_name = name.str.as_str_const();
                    }

                    case .Expr(expr) => {
                        switch (expr.literal_const_int_value()) {
                            case .Some(literal) => {
                                self->body_out.push_str("case ");

                                switch (literal) {
                                    case .Signed(x) => {
                                        push_int128(&self->body_out, x);
                                    }
                                    case .Unsigned(x) => {
                                        push_uint128(&self->body_out, x);
                                    }
                                }
                                
                                self->body_out.push(':');
                            }
                            case .None => {
                                if (!has_default_label) {
                                    self->body_out.push_str("default:");
                                    has_default_label = true;
                                }
                            }
                        }
                    }

                    case .Range => {
                        @panic("range pattern must be lowered into chained if-else statement");
                    }
                    
                    else => {
                        if (!has_default_label) {
                            self->body_out.push_str("default:");
                            has_default_label = true;
                        }
                    }
                }
            }

            self->body_out.push('{');

            if (binding_name != null) {
                switch (switch_->operand.ty) {
                    case .Some(operand_type) => {
                        var type_name = self->types.type_name(&operand_type);

                        self->body_out.push_str(type_name.as_str_const());
                        self->body_out.push(' ');
                        mangle::sanitize_into(&self->body_out, binding_name);
                        self->body_out.push('=');
                        
                        var expr = self->emit_expr(&switch_->operand);
                        self->body_out.push_str(expr.as_str_const());
                        expr.free();
                        
                        self->body_out.push(';');
                        type_name.free();
                    }
                    case .None => {}
                }
            }

            self->emit_block_stmts(case_->body, true);
            self->body_out.push_str("}break;");
        }

        switch (switch_->else_case) {
            case .Some(else_case) => {
                self->body_out.push_str("default:{");
                self->emit_block_stmts(&else_case, true);
                self->body_out.push_str("}break;");
            }
            else => {
                self->body_out.push_str("default:break;");
            }
        }

        self->body_out.push('}');
    }

    fn emit_switch_if_chain(self: Self*, switch_: const cir::SwitchStmt*) {
        var operand_type_name: String;
        var operand = self->emit_expr(&switch_->operand);

        var operand_is_byte_string = false;
        var operand_is_pointer = false;

        switch (switch_->operand.ty) {
            case .Some(ty) => {
                operand_is_byte_string = self->is_byte_pointer(&ty);

                switch (*ty.const_inner()) {
                    case .Pointer => operand_is_pointer = true;
                    else => {}
                }
            }
            else => {}
        }

        self->body_out.push('{');

        switch (switch_->operand.ty) {
            case .Some(ty) => {
                self->types.ensure_named(&ty);
                operand_type_name = self->types.type_name(&ty);
            }
            else => {
                operand_type_name = String.from_str(self->allocator, "int64_t");
            }
        }

        self->body_out.push_str(operand_type_name.as_str_const());
        self->body_out.push_str(" __sw_op=");

        if (operand_is_pointer) {
            self->body_out.push('(');
            self->body_out.push_str(operand_type_name.as_str_const());
            self->body_out.push(')');
        }

        self->body_out.push_str(operand.as_str_const());
        self->body_out.push(';');
        operand.free();

        var first = true;

        for (var i: usize = 0; i < switch_->cases.len(); i += 1) {
            const case_ = switch_->cases.get_const(i).unwrap();

            var has_wildcard = false;
            var binding_name: const uint8*;

            for (var j: usize = 0; j < case_->patterns.len(); j += 1) {
                switch (case_->patterns.get_const(j).unwrap()->kind) {
                    case .Wildcard => {
                        has_wildcard = true;
                        break;
                    }
                    case .Binding { name, .. } => {
                        binding_name = name.str.as_str_const();
                        break;
                    }
                    else => {}
                }
            }

            if (has_wildcard || binding_name != null) {
                if (!first) {
                    self->body_out.push_str("else");
                }
                
                first = false;
                self->body_out.push('{');
                
                if (binding_name != null) {
                    self->body_out.push_str(operand_type_name.as_str_const());
                    self->body_out.push(' ');
                    mangle::sanitize_into(&self->body_out, binding_name);
                    self->body_out.push_str("=__sw_op;");
                }

                self->emit_block_stmts(case_->body, true);
                self->body_out.push('}');
                continue;
            }

            if (case_->patterns.len() == 0) {
                continue;
            }

            var combined_cond = String.new(self->allocator);

            for (var j: usize = 0; j < case_->patterns.len(); j += 1) {
                const pattern = case_->patterns.get_const(j).unwrap();

                if (j > 0) {
                    combined_cond.push_str("||");
                }

                switch (pattern->kind) {
                    case .Range(range) => {
                        var lo = self->emit_expr(&range.lower);
                        var hi = self->emit_expr(&range.upper);

                        combined_cond.push_str("(__sw_op>=");
                        combined_cond.push_str(lo.as_str_const());
                        combined_cond.push_str("&&__sw_op");

                        if (range.inclusive_upper) {
                            combined_cond.push_str("<=");
                        } else {
                            combined_cond.push('<');
                        }

                        combined_cond.push_str(hi.as_str_const());
                        combined_cond.push(')');

                        lo.free();
                        hi.free();
                    }
                    case .Expr(expr) => {
                        var value = self->emit_expr(&expr);

                        if (operand_is_byte_string) {
                            self->ensure_strcmp_proto();
                            combined_cond.push_str("(strcmp((const char*)__sw_op,(const char*)(");
                            combined_cond.push_str(value.as_str_const());
                            combined_cond.push_str("))==0)");
                        } else {
                            combined_cond.push_str("(__sw_op==");
                            combined_cond.push_str(value.as_str_const());
                            combined_cond.push(')');
                        }

                        value.free();
                    }
                    case .EnumUnit(ident) => {
                        combined_cond.push_str("(__sw_op==");
                        combined_cond.push_str(ident.str.as_str_const());
                        combined_cond.push(')');
                    }
                    else => {
                        combined_cond.push('0');
                    }
                }
            }

            if (first) {
                self->body_out.push_str("if(");
                first = false;
            } else {
                self->body_out.push_str("else if(");
            }

            self->body_out.push_str(combined_cond.as_str_const());
            self->body_out.push_str("){");
            combined_cond.free();

            self->emit_block_stmts(case_->body, true);
            self->body_out.push('}');
        }

        switch (switch_->else_case) {
            case .Some(else_case) => {
                if (!first) {
                    self->body_out.push_str("else");
                }
                self->body_out.push('{');
                self->emit_block_stmts(&else_case, true);
                self->body_out.push('}');
            }
            else => {}
        }

        self->body_out.push('}');
        operand_type_name.free();
    }

    fn emit_inline_asm_stmt(self: Self*, inline_asm: const cir::InlineAsm) {
        var text = self->emit_inline_asm(inline_asm);
        self->body_out.push_str(text.as_str_const());
        self->body_out.push(';');
        text.free();
    }

    fn emit_inline_asm(self: Self*, inline_asm: const cir::InlineAsm) String {
        var out = String.from_str(self->allocator, "__asm__ ");

        if (inline_asm.is_volatile) {
            out.push_str("__volatile__(");
        } else {
            out.push('(');
        }

        for (var i: usize = 0; i < inline_asm.template.len(); i += 1) {
            const line = inline_asm.template.get_const(i).unwrap();
            const raw = line->as_str_const();

            out.push('"');
            push_asm_escaped(&out, raw);

            if (!asm_raw_ends_with_newline(raw)) {
                out.push('\\');
                out.push('n');
            }

            out.push('"');
            
            if (i + 1 < inline_asm.template.len()) {
                out.push(' ');
            }
        }

        if (inline_asm.outputs.len() > 0 ||
            inline_asm.inputs.len() > 0 ||
            inline_asm.clobbers.len() > 0)
        {
            out.push_str(" : ");
            self->emit_asm_operands(&out, &inline_asm.outputs);
            out.push_str(" : ");
            self->emit_asm_operands(&out, &inline_asm.inputs);

            if (inline_asm.clobbers.len() > 0) {
                out.push_str(" : ");

                for (var i: usize = 0; i < inline_asm.clobbers.len(); i += 1) {
                    const clobber = inline_asm.clobbers.get_const(i).unwrap();
                    
                    out.push('"');
                    out.push_str(clobber->name.as_str_const());
                    out.push('"');
                    
                    if (i + 1 < inline_asm.clobbers.len()) {
                        out.push_str(", ");
                    }
                }
            }
        }

        out.push(')');
        return out;
    }

    fn emit_asm_operands(self: Self*, out: String*, operands: const Vec<cir::AsmOperand>*) {
        for (var i: usize = 0; i < operands->len(); i += 1) {
            const operand = operands->get_const(i).unwrap();
            
            out->push_str("\"");
            out->push_str(operand->constraint.as_str_const());
            out->push_str("\"(");

            var expr = self->emit_expr(operand->expr);
            out->push_str(expr.as_str_const());
            expr.free();

            out->push(')');

            if (i + 1 < operands->len()) {
                out->push_str(", ");
            }
        }
    }

    /* ************* Expressions ************* */

    /// Unwraps the result of an array-returning call.
    fn decay_array_value(self: Self*, expr: const cir::Expr*, value: String) String {
        switch (expr->ty) {
            case .Some(ty) => {
                switch (ty.as_array_type()) {
                    case .Some(array) => {
                        switch (array.capacity) {
                            case .Fixed => {
                                var struct_name = self->types.array_return_struct_name(&ty);

                                var out = String.from_str(self->allocator, "({ ");
                                out.push_str(struct_name.as_str_const());
                                out.push_str(" __cyrus_arr = ");
                                out.push_str(value.as_str_const());
                                out.push_str("; __cyrus_arr.data; })");

                                struct_name.free();
                                value.free();
                                return out;
                            }
                            case .Slice | .TerminatedSlice => {}
                        }
                    }
                    else => {}
                }
            }
            else => {}
        }

        return value;
    }

    fn emit_expr(self: Self*, expr: const cir::Expr*) String {
        switch (expr->kind) {
            case .Prefix(prefix) => {
                var out = String.new(self->allocator);
                var operand = self->emit_expr(prefix.operand);

                switch (self->expr_int128_kind(prefix.operand)) {
                    case .Some(unsigned_domain) => {
                        var a = self->coerce_to_int128(
                            prefix.operand,
                            operand.as_str_const(),
                            unsigned_domain
                        );

                        var prefix_name = "__cyrus_u128";

                        if (!unsigned_domain) {
                            prefix_name = "__cyrus_i128";
                        }

                        var fn_ = String.new(self->allocator);
                        fn_.push_str(prefix_name);
                        fn_.push('_');

                        var is_bang = false;

                        switch (prefix.op) {
                            case .BitwiseNot => fn_.push_str("bnot");
                            case .Minus => fn_.push_str("neg");
                            case .Bang => {
                                fn_.push_str("iszero");
                                is_bang = true;
                            }
                        }

                        if (is_bang) {
                            out.push_str("(!");
                            out.push_str(fn_.as_str_const());
                            out.push('(');
                            out.push_str(a.as_str_const());
                            out.push_str("))");
                        } else {
                            out.push('(');
                            out.push_str(fn_.as_str_const());
                            out.push('(');
                            out.push_str(a.as_str_const());
                            out.push_str("))");
                        }

                        fn_.free();
                        a.free();
                        operand.free();
                        return out;
                    }
                    else => {}
                }

                switch (prefix.op) {
                    case .Bang => {
                        out.push_str("(!");
                        out.push_str(operand.as_str_const());
                        out.push(')');
                    }
                    case .Minus => {
                        out.push_str("(-");
                        out.push_str(operand.as_str_const());
                        out.push(')');
                    }
                    case .BitwiseNot => {
                        out.push_str("(~");
                        out.push_str(operand.as_str_const());
                        out.push(')');
                    }
                }

                operand.free();
                return out;
            }

            case .AddrOf(addr) => {
                return self->emit_addr_of_expr(addr.operand);
            }

            case .Deref(deref) => {
                var out = String.from_str(self->allocator, "(*");
                var expr = self->emit_expr(deref.operand);
                out.push_str(expr.as_str_const());
                expr.free();
                out.push(')');
                return out;
            }

            case .ArrayIndex(array_index) => {
                var out = String.new(self->allocator);
                var base = self->emit_expr(array_index.operand);
                var idx = self->emit_expr(array_index.index);

                var is_slice = false;
                var element_ptr_decl = String.new(self->allocator);

                switch (array_index.operand->ty) {
                    case .Some(op_ty) => {
                        switch (op_ty.as_array_type()) {
                            case .Some(array) => {
                                switch (array.capacity) {
                                    case .Slice | .TerminatedSlice => {
                                        is_slice = true;
                                        const ptr_ty: cir::SemaType = .Pointer(array.element_type);
                                        element_ptr_decl.free();
                                        element_ptr_decl = self->types.build_decl(&ptr_ty, "");
                                    }
                                    case .Fixed => {}
                                }
                            }
                            else => {}
                        }
                    }
                    case .None => {}
                }

                if (is_slice) {
                    out.push_str("(((");
                    out.push_str(element_ptr_decl.as_str_const());
                    out.push_str(")(");
                    out.push_str(base.as_str_const());
                    out.push_str(").ptr)[");
                    out.push_str(idx.as_str_const());
                    out.push_str("])");
                } else {
                    out.push('(');
                    out.push_str(base.as_str_const());
                    out.push('[');
                    out.push_str(idx.as_str_const());
                    out.push_str("])");
                }

                element_ptr_decl.free();
                base.free();
                idx.free();
                
                return out;
            }

            case .Slice(slice_expr) => {
                self->types.ensure_slice();
                var base = self->emit_expr(slice_expr.operand);
                var start_str = String.from_str(self->allocator, "0");
                switch (slice_expr.start) {
                    case .Some(s) => {
                        start_str.free();
                        start_str = self->emit_expr(s);
                    }
                    case .None => {}
                }

                var is_slice_op = false;
                var fixed_len: usize = 0;
                var element_ptr_decl = String.new(self->allocator);

                switch (slice_expr.operand->ty) {
                    case .Some(op_ty) => {
                        if (op_ty.is_pointer()) {
                            element_ptr_decl.free();
                            element_ptr_decl = self->types.build_decl(&op_ty, "");
                        } else {
                            switch (op_ty.as_array_type()) {
                                case .Some(array) => {
                                    const ptr_ty: cir::SemaType = .Pointer(array.element_type);
                                    
                                    element_ptr_decl.free();
                                    element_ptr_decl = self->types.build_decl(&ptr_ty, "");

                                    switch (array.capacity) {
                                        case .Fixed => {
                                            fixed_len = self->types.tctx.array_capacity_len(&array);
                                        }
                                        case .Slice | .TerminatedSlice => {
                                            is_slice_op = true;
                                        }
                                    }
                                }
                                else => {}
                            }
                        }
                    }
                    case .None => {}
                }

                var out = String.from_str(self->allocator, "({ ");

                if (is_slice_op) {
                    out.push_str("__slice __s=(");
                    out.push_str(base.as_str_const());
                    out.push_str("); uintptr_t __start=(uintptr_t)(");
                    out.push_str(start_str.as_str_const());
                    out.push_str("); uintptr_t __end=");

                    switch (slice_expr.end) {
                        case .Some(end) => {
                            var expr = self->emit_expr(end);
                            out.push_str("(uintptr_t)(");
                            out.push_str(expr.as_str_const());
                            out.push(')');
                            expr.free();
                        }
                        case .None => {
                            out.push_str("__s.len");
                        }
                    }

                    out.push_str("; ((__slice){.ptr=(void*)(((");
                    out.push_str(element_ptr_decl.as_str_const());
                    out.push_str(")(__s.ptr))+__start),.len=__end-__start}); })");
                } else {
                    out.push_str(element_ptr_decl.as_str_const());
                    out.push_str(" __p=(");
                    out.push_str(element_ptr_decl.as_str_const());
                    out.push_str(")(");
                    out.push_str(base.as_str_const());
                    out.push_str("); uintptr_t __start=(uintptr_t)(");
                    out.push_str(start_str.as_str_const());
                    out.push_str("); uintptr_t __end=");

                    switch (slice_expr.end) {
                        case .Some(end) => {
                            var expr = self->emit_expr(end);
                            out.push_str("(uintptr_t)(");
                            out.push_str(expr.as_str_const());
                            out.push(')');
                            expr.free();
                        }
                        case .None => {
                            push_usize(&out, fixed_len);
                        }
                    }
                    out.push_str("; ((__slice){.ptr=(void*)(__p+__start),.len=__end-__start}); })");
                }

                element_ptr_decl.free();
                start_str.free();
                base.free();
                return out;
            }

            case .FieldAccess(field_access) => {
                var out = String.new(self->allocator);
                var base = self->emit_expr(field_access.operand);

                if (field_access.is_thin_arrow) {
                    out.push_str("((");
                    out.push_str(base.as_str_const());
                    out.push_str(")->");
                } else {
                    out.push('(');
                    out.push_str(base.as_str_const());
                    out.push('.');
                }

                mangle::sanitize_into(&out, field_access.name.as_str_const());
                out.push(')');
                base.free();
                return out;
            }

            case .UnionInit(union_init) => {
                var type_name = self->type_name_of(&union_init.operand);
                var out = String.from_str(self->allocator, "((");

                out.push_str(type_name.as_str_const());
                out.push_str("){.");
                mangle::sanitize_into(&out, union_init.field->name.as_str_const());
                out.push('=');
                
                var expr = self->emit_init_value(&union_init.field->value);
                out.push_str(expr.as_str_const());
                expr.free();

                out.push_str("})");
                type_name.free();
                
                return out;
            }

            case .Array(array) => {
                var is_slice_lit = false;
                var type_name = String.new(self->allocator);
                var resolved_array_type = array.ty;

                if (expr->ty.is_some()) {
                    resolved_array_type = expr->ty;
                }

                switch (resolved_array_type) {
                    case .Some(ty) => {
                        switch (ty.as_array_type()) {
                            case .Some(array) => {
                                switch (array.capacity) {
                                    case .Slice | .TerminatedSlice => {
                                        is_slice_lit = true;
                                        self->types.ensure_slice();
                                        self->types.ensure_named(array.element_type);
                                        type_name.free();
                                        type_name = self->types.type_name(array.element_type);
                                    }
                                    case .Fixed => {
                                        self->types.ensure_named(&ty);
                                        type_name.free();
                                        type_name = self->types.type_name(&ty);
                                    }
                                }
                            }
                            else => {
                                self->types.ensure_named(&ty);
                                type_name.free();
                                type_name = self->types.type_name(&ty);
                            }
                        }
                    }
                    case .None => {
                        type_name.free();
                        type_name = String.from_str(self->allocator, "void*");
                    }
                }

                if (is_slice_lit) {
                    if (array.elements.len() == 0) {
                        type_name.free();
                        return String.from_str(self->allocator, "((__slice){.ptr=(void*)0,.len=0})");
                    }

                    var out = String.from_str(self->allocator, "((__slice){.ptr=(void*)((");
                    out.push_str(type_name.as_str_const());
                    out.push('[');
                    push_usize(&out, array.elements.len());
                    out.push_str("]){");

                    for (var i: usize = 0; i < array.elements.len(); i += 1) {
                        const element_type = array.elements.get_const(i).unwrap();

                        switch (element_type->kind) {
                            case .Array(array2) => {
                                var braces = self->emit_array_braces(&array2);
                                out.push_str(braces.as_str_const());
                                braces.free();
                            }
                            else => {
                                var elem_expr = self->emit_expr(element_type);
                                out.push_str(elem_expr.as_str_const());
                                elem_expr.free();
                            }
                        }

                        if (i + 1 < array.elements.len()) {
                            out.push(',');
                        }
                    }

                    out.push_str("}),.len=");
                    push_usize(&out, array.elements.len());
                    out.push_str("})");
                    type_name.free();
                    return out;
                }

                var out = String.from_str(self->allocator, "((");
                
                out.push_str(type_name.as_str_const());
                out.push_str("){");
                
                for (var i: usize = 0; i < array.elements.len(); i += 1) {
                    const element_type = array.elements.get_const(i).unwrap();

                    switch (element_type->kind) {
                        case .Array(array2) => {
                            var braces = self->emit_array_braces(&array2);
                            out.push_str(braces.as_str_const());
                            braces.free();
                        }
                        else => {
                            var expr = self->emit_expr(element_type);
                            out.push_str(expr.as_str_const());
                            expr.free();
                        }
                    }
                    
                    if (i + 1 < array.elements.len()) {
                        out.push(',');
                    }
                }

                out.push_str("})");
                type_name.free();
                
                return out;
            }

            case .Tuple(tupple) => {
                var type_name: String;

                switch (expr->ty) {
                    case .Some(ty) => {
                        self->types.ensure_named(&ty);
                        type_name = self->types.type_name(&ty);
                    }
                    case .None => {
                        type_name = String.from_str(self->allocator, "void");
                    }
                }

                var out = String.from_str(self->allocator, "((");
                out.push_str(type_name.as_str_const());
                out.push_str("){");

                for (var i: usize = 0; i < tupple.elements.len(); i += 1) {
                    const element = tupple.elements.get_const(i).unwrap();
                    
                    var expr = self->emit_expr(element);
                    out.push_str(expr.as_str_const());
                    expr.free();
                    
                    if (i + 1 < tupple.elements.len()) {
                        out.push(',');
                    }
                }

                out.push_str("})");
                type_name.free();
                
                return out;
            }

            case .TupleAccess(tuple_access) => {
                var out = String.new(self->allocator);
                var base = self->emit_expr(tuple_access.operand);

                out.push('(');
                out.push_str(base.as_str_const());
                out.push_str(").f");
                push_usize(&out, tuple_access.index);
                base.free();
                
                return out;
            }

            case .Builtin(builtin) => {
                switch (builtin) {
                    case .BuiltinFunc(builtin_func) => {
                        return self->emit_builtin_func(&builtin_func);
                    }
                    case .BuiltinBlock => {
                        return String.from_str(self->allocator, "((void)0)");
                    }
                }
            }

            case .MethodCall(method_call) => {
                var call = self->emit_method_call(&method_call);
                return self->decay_array_value(expr, call);
            }

            case .StructInit(struct_init) => return self->emit_struct_init(&struct_init);
            
            case .EnumInit(enum_init) => return self->emit_enum_init(&enum_init);
            
            case .Dynamic(dynamic_) => return self->emit_dynamic(&dynamic_);
            
            case .Literal(literal) => return self->emit_literal(&literal);
            
            case .Assign(assign) => return self->emit_assign(&assign);
            
            case .Lambda(lambda) => return self->emit_lambda(&lambda);

            case .Symbol(symbol) => return self->emit_symbol(&symbol);

            case .Infix(infix) => return self->emit_infix(&infix);

            case .FuncCall(func_call) => {
                var call = self->emit_func_call(&func_call);
                return self->decay_array_value(expr, call);
            }

            case .EnumStructVariantInit => {
                panic_unlowered(self, expr, "EnumStructVariantInit");
                @unreachable();
            }
            
            case .UnnamedUnionValue => {
                panic_unlowered(self, expr, "UnnamedUnionValue");
                @unreachable();
            }
            
            case .UnnamedStructValue => {
                panic_unlowered(self, expr, "UnnamedStructValue");
                @unreachable();
            }
            
            case .UnnamedEnumValue => {
                panic_unlowered(self, expr, "UnnamedEnumValue");
                @unreachable();
            }

            case .SemaType | .Poisoned => {
                return String.from_str(self->allocator, "((void)0)");
            }

            case .InlineAsm(asm) => {
                return self->emit_inline_asm(asm);
            }

            case .Try(try_expr) => {
                return self->emit_try_expr(&try_expr);
            }

            case .TryCatch(try_catch_expr) => {
                return self->emit_try_catch_expr(&try_catch_expr);
            }
        }
    }

    /// Returns the enum type when `expr` has a non-scalar enum type.
    fn enum_aggregate_type_of_expr(self: Self*, expr: const cir::Expr*) Option<cir::SemaType> {
        switch (expr->ty) {
            case .Some(ty) => {
                switch (ty.const_inner()->as_named_type()) {
                    case .Some(named) => {
                        switch (named.type_decl_id.as_enum()) {
                            case .Some(enum_id) => {
                                switch (self->tables->enums.get_const(enum_id)) {
                                    case .Some(enum_decl) => {
                                        if (!is_enum_scalar_optimizable(self->tables, enum_decl)) {
                                            return .Some(ty);
                                        }
                                    }
                                    else => {}
                                }
                            }
                            else => {}
                        }
                    }
                    else => {}
                }
            }
            else => {}
        }

        return .None;
    }

    fn emit_infix(self: Self*, infix: const cir::InfixExpr*) String {
        switch (infix->op) {
            case .Equal | .NotEqual => {
                if (self->is_byte_string_compare(infix)) {
                    return self->emit_strcmp_compare(infix);
                }

                switch (self->enum_aggregate_type_of_expr(infix->lhs)) {
                    case .Some(enum_ty) => {
                        self->ensure_memcmp_proto();

                        var type_name = self->types.type_name(&enum_ty);
                        var lhs_expr = self->emit_expr(infix->lhs);
                        var rhs_expr = self->emit_expr(infix->rhs);

                        var out = String.new(self->allocator);
                        out.push_str("({ ");
                        out.push_str(type_name.as_str_const());
                        out.push_str(" __ea = ");
                        out.push_str(lhs_expr.as_str_const());
                        out.push_str("; ");
                        out.push_str(type_name.as_str_const());
                        out.push_str(" __eb = ");
                        out.push_str(rhs_expr.as_str_const());
                        out.push_str("; memcmp(&__ea, &__eb, sizeof(");
                        out.push_str(type_name.as_str_const());
                        out.push_str(")) ");

                        switch (infix->op) {
                            case .Equal => {
                                out.push_str("== 0");
                            }
                            case .NotEqual => {
                                out.push_str("!= 0");
                            }
                            else => {
                                out.push_str("== 0");
                            }
                        }

                        out.push_str("; })");

                        type_name.free();
                        lhs_expr.free();
                        rhs_expr.free();
                        return out;
                    }
                    case .None => {}
                }
            }
            else => {}
        }

        var lhs = self->emit_expr(infix->lhs);
        var rhs = self->emit_expr(infix->rhs);

        var lhs_kind = self->expr_int128_kind(infix->lhs);
        var rhs_kind = self->expr_int128_kind(infix->rhs);

        if ((lhs_kind.is_some() ||
            rhs_kind.is_some()) &&
            self->int128_ops_are_valid(infix->op)) 
        {
            var unsigned_domain = false;

            if (lhs_kind.is_some()) {
                unsigned_domain = lhs_kind.unwrap();
            } else {
                unsigned_domain = rhs_kind.unwrap();
            }

            var result = self->emit_infix_int128(
                infix,
                lhs.as_str_const(),
                rhs.as_str_const(),
                unsigned_domain
            );

            lhs.free();
            rhs.free();

            return result;
        }

        var out = String.new(self->allocator);

        out.push('(');
        out.push_str(lhs.as_str_const());

        switch (infix->op) {
            case .Add => out.push('+');
            case .Sub => out.push('-');
            case .Mul => out.push('*');
            case .Div => out.push('/');
            case .Rem => out.push('%');

            case .GreaterEqual => out.push_str(">=");
            case .LessEqual => out.push_str("<=");
            case .NotEqual => out.push_str("!=");
            case .GreaterThan => out.push('>');
            case .Equal => out.push_str("==");
            case .LessThan => out.push('<');
            
            case .And => out.push_str("&&");
            case .Or => out.push_str("||");
            
            case .ShiftRight => out.push_str(">>");
            case .ShiftLeft => out.push_str("<<");

            case .BitwiseAndNot => out.push_str("&~");
            case .BitwiseAnd => out.push('&');
            case .BitwiseOr => out.push('|');
            case .BitwiseXor => out.push('^');
            
            case .NullCoalesce => {
                lhs.free();
                rhs.free();

                var out2 = String.new(self->allocator);
                var lhs2 = self->emit_expr(infix->lhs);
                var rhs2 = self->emit_expr(infix->rhs);

                out2.push_str("((");
                out2.push_str(lhs2.as_str_const());
                out2.push_str(")?(");
                out2.push_str(lhs2.as_str_const());
                out2.push_str("):(");
                out2.push_str(rhs2.as_str_const());
                out2.push_str("))");
                
                lhs2.free();
                rhs2.free();
                out.free();

                return out2;
            }
        }

        out.push_str(rhs.as_str_const());
        out.push(')');
        
        lhs.free();
        rhs.free();

        return out;
    }

    fn is_byte_string_compare(self: Self*, infix: const cir::InfixExpr*) bool {
        switch (infix->lhs->ty) {
            case .Some(lhs_type) => {
                switch (infix->rhs->ty) {
                    case .Some(rhs_type) => {
                        if (lhs_type.is_plain_null() || rhs_type.is_plain_null()) {
                            return false;
                        }

                        if (self->expr_is_null_literal(infix->lhs) ||
                            self->expr_is_null_literal(infix->rhs))
                        {
                            return false;
                        }

                        return self->is_byte_pointer(&lhs_type) && self->is_byte_pointer(&rhs_type);
                    }
                    else => return false;
                }
            }
            else => return false;
        }
    }

    fn expr_is_null_literal(self: Self*, expr: const cir::Expr*) bool {
        switch (expr->kind) {
            case .Literal(literal) => {
                switch (literal.kind) {
                    case .Null => return true;
                    else => return false;
                }
            }
            else => return false;
        }
    }

    /// Returns:
    ///   .Some(true)  for uint128, 
    ///   .Some(false) for int128, 
    ///   .None        for every other type
    fn int128_kind_of(self: Self*, ty: const cir::SemaType*) Option<bool> {
        switch (*ty->const_inner()) {
            case .Plain(plain) => {
                switch (plain) {
                    case .Int128 => return .Some(false);
                    case .UInt128 => return .Some(true);
                    else => {}
                }
            }
            else => {}
        }

        return .None;
    }

    fn expr_int128_kind(self: Self*, expr: const cir::Expr*) Option<bool> {
        switch (expr->ty) {
            case .Some(ty) => {
                return self->int128_kind_of(&ty);
            }
            else => {}
        }

        return .None;
    }

    fn is_signed_plain_int(self: Self*, plain: const cir::PlainType*) bool {
        switch (*plain) {
            case .Int8 
            | .Int16 
            | .Int32 
            | .Int64 
            | .IntPtr 
            | .ISize => return true;

            else => return false;
        }
    }

    fn scalar_operand_is_signed(self: Self*, expr: const cir::Expr*) bool {
        switch (expr->kind) {
            case .Literal(literal) => {
                switch (literal.kind) {
                    case .Integer { value, .. } => {
                        switch (value) {
                            case .Signed(_) => return true;
                            case .Unsigned(_) => return false;
                        }
                    }
                    else => return false;
                }
            }
            else => {}
        }

        switch (expr->ty) {
            case .Some(ty) => {
                switch (*ty.const_inner()) {
                    case .Plain(plain) => {
                        return self->is_signed_plain_int(&plain);
                    }
                    else => {}
                }
            }
            else => {}
        }

        return false;
    }

    fn wrap_str(
        self: Self*,
        prefix: const uint8*,
        inner: const uint8*,
        suffix: const uint8*
    ) String {
        var out = String.new(self->allocator);
        out.push_str(prefix);
        out.push_str(inner);
        out.push_str(suffix);
        return out;
    }

    fn coerce_to_int128(
        self: Self*,
        expr: const cir::Expr*,
        text: const uint8*,
        unsigned_domain: bool
    ) String {
        switch (self->expr_int128_kind(expr)) {
            case .Some(src_unsigned) => {
                if (src_unsigned == unsigned_domain) {
                    return String.from_str(self->allocator, text);
                }

                if (unsigned_domain) {
                    return self->wrap_str("__cyrus_u128_of_i128(", text, ")");
                } else {
                    return self->wrap_str("__cyrus_i128_of_u128(", text, ")");
                }
            }
            else => {}
        }

        if (self->scalar_operand_is_signed(expr)) {
            var wrapped = self->wrap_str("__cyrus_i128_from_i64((int64_t)(", text, "))");
            
            if (unsigned_domain) {
                var str = self->wrap_str(
                    "__cyrus_u128_of_i128(",
                    wrapped.as_str_const(),
                    ")"
                );
                wrapped.free();
                return str;
            }

            return wrapped;
        }

        var wrapped = self->wrap_str(
            "__cyrus_u128_from_u64((uint64_t)(",
            text, 
            "))"
        );
        
        if (!unsigned_domain) {
            var str = self->wrap_str(
                "__cyrus_i128_of_u128(", 
                wrapped.as_str_const(), 
                ")"
            );
            wrapped.free();
            return str;
        }
        
        return wrapped;
    }

    fn int128_ops_are_valid(self: Self*, op: ast::ASTInfixOperator) bool {
        switch (op) {
            case .Add 
            | .Sub 
            | .Mul 
            | .Div 
            | .Rem 
            | .Equal 
            | .NotEqual 
            | .GreaterThan 
            | .LessThan 
            | .GreaterEqual 
            | .LessEqual 
            | .BitwiseAnd 
            | .BitwiseOr 
            | .BitwiseXor 
            | .BitwiseAndNot 
            | .ShiftLeft 
            | .ShiftRight 
            | .And 
            | .Or => return true;

            else => return false;
        }
    }

    fn int128_op_name(
        self: Self*, 
        op: ast::ASTInfixOperator, 
        unsigned_domain: bool
    ) const uint8* {
        switch (op) {
            case .Add => {
                if (unsigned_domain) {
                    return "__cyrus_u128_add";
                }

                return "__cyrus_i128_add";
            }
            
            case .Sub => {
                if (unsigned_domain) {
                    return "__cyrus_u128_sub";
                }

                return "__cyrus_i128_sub";
            }
            
            case .Mul => {
                if (unsigned_domain) {
                    return "__cyrus_u128_mul";
                }

                return "__cyrus_i128_mul";
            }
            
            case .Div => {
                if (unsigned_domain) {
                    return "__cyrus_u128_div";
                }

                return "__cyrus_i128_div";
            }
            
            case .Rem => {
                if (unsigned_domain) {
                    return "__cyrus_u128_mod";
                }

                return "__cyrus_i128_mod";
            }

            case .BitwiseAnd => {
                if (unsigned_domain) {
                    return "__cyrus_u128_band";
                }

                return "__cyrus_i128_band";
            }

            case .BitwiseOr => {
                if (unsigned_domain) {
                    return "__cyrus_u128_bor";
                }

                return "__cyrus_i128_bor";
            }
            
            case .BitwiseXor => {
                if (unsigned_domain) {
                    return "__cyrus_u128_bxor";
                }

                return "__cyrus_i128_bxor";
            }
            
            case .BitwiseAndNot => {
                if (unsigned_domain) {
                    return "__cyrus_u128_band";
                }

                return "__cyrus_i128_band";
            }
            
            case .ShiftLeft => {
                if (unsigned_domain) {
                    return "__cyrus_u128_shl";
                }

                return "__cyrus_i128_shl";
            }
            
            case .ShiftRight => {
                if (unsigned_domain) {
                    return "__cyrus_u128_shr";
                }

                return "__cyrus_i128_shr";
            }

            case .Equal 
            | .NotEqual 
            | .GreaterThan 
            | .LessThan 
            | .GreaterEqual 
            | .LessEqual => {
                if (unsigned_domain) {
                    return "__cyrus_u128_cmp";
                }

                return "__cyrus_i128_cmp";
            }

            else => {
                if (unsigned_domain) { return "__cyrus_u128_add"; }
                return "__cyrus_i128_add";
            }
        }
    }

    fn emit_int128_call(
        self: Self*,
        fn_name: const uint8*, 
        a: const uint8*, 
        b: const uint8*
    ) String {
        var out = String.new(self->allocator);
        out.push('(');
        out.push_str(fn_name);
        out.push('(');
        out.push_str(a);
        out.push(',');
        out.push_str(b);
        out.push_str("))");
        return out;
    }

    fn emit_infix_int128(
        self: Self*,
        infix: const cir::InfixExpr*,
        ltext: const uint8*,
        rtext: const uint8*,
        unsigned_domain: bool
    ) String {
        var a = self->coerce_to_int128(infix->lhs, ltext, unsigned_domain);
        var b = self->coerce_to_int128(infix->rhs, rtext, unsigned_domain);

        var name = self->int128_op_name(infix->op, unsigned_domain);

        var out: String;

        switch (infix->op) {
            case .Equal 
            | .NotEqual 
            | .GreaterThan 
            | .LessThan 
            | .GreaterEqual 
            | .LessEqual => {
                out = String.new(self->allocator);
                out.push('(');
                out.push_str(name);
                out.push('(');
                out.push_str(a.as_str_const());
                out.push(',');
                out.push_str(b.as_str_const());
                out.push(')');

                switch (infix->op) {
                    case .GreaterEqual => out.push_str(">= 0");
                    case .GreaterThan => out.push_str("> 0");
                    case .LessEqual => out.push_str("<= 0");
                    case .NotEqual => out.push_str("!= 0");
                    case .LessThan => out.push_str("< 0");
                    case .Equal => out.push_str("== 0");
                    else => {}
                }

                out.push(')');
            }

            case .And => {
                var zero_fn = "__cyrus_u128_iszero";

                if (!unsigned_domain) {
                    zero_fn = "__cyrus_i128_iszero";
                }

                out = String.new(self->allocator);
                out.push_str("(!");
                out.push_str(zero_fn);
                out.push('(');
                out.push_str(a.as_str_const());
                out.push_str(") && !");
                out.push_str(zero_fn);
                out.push('(');
                out.push_str(b.as_str_const());
                out.push_str("))");
            }

            case .Or => {
                var zero_fn = "__cyrus_u128_iszero";

                if (!unsigned_domain) {
                    zero_fn = "__cyrus_i128_iszero";
                }

                out = String.new(self->allocator);
                out.push_str("(!");
                out.push_str(zero_fn);
                out.push('(');
                out.push_str(a.as_str_const());
                out.push_str(") || !");
                out.push_str(zero_fn);
                out.push('(');
                out.push_str(b.as_str_const());
                out.push_str("))");
            }

            case .BitwiseAndNot => {
                var not_fn = "__cyrus_u128_bnot";

                if (!unsigned_domain) {
                    not_fn = "__cyrus_i128_bnot";
                }

                var str = self->wrap_str(not_fn, b.as_str_const(), ")");
                out = self->emit_int128_call(
                    name, 
                    a.as_str_const(), 
                    str.as_str_const()
                );
                str.free();
            }

            case .ShiftLeft 
            | .ShiftRight => {
                var amount: String;

                if (self->expr_int128_kind(infix->rhs).is_some()) {
                    var to64 = "__cyrus_u128_to_u64(";

                    if (!unsigned_domain) {
                        to64 = "__cyrus_i128_to_u64(";
                    }
                    
                    amount = self->wrap_str(to64, rtext, ")");
                } else {
                    amount = self->wrap_str("(uint64_t)(", rtext, ")");
                }

                out = self->emit_int128_call(
                    name,
                    a.as_str_const(),
                    amount.as_str_const()
                );

                amount.free();
            }

            else => {
                out = self->emit_int128_call(
                    name,
                    a.as_str_const(),
                    b.as_str_const()
                );
            }
        }

        a.free();
        b.free();
        return out;
    }

    fn is_byte_pointer(self: Self*, ty: const cir::SemaType*) bool {
        const resolved = extract_typedef_inner_type(self->tables, ty);

        switch (*resolved) {
            case .Pointer(inner) => {
                const elem = extract_typedef_inner_type(self->tables, inner);

                switch (*elem) {
                    case .Plain(plain) => {
                        switch (plain) {
                            case .UInt8 => return true;
                            case .Int8 => return true;
                            else => return false;
                        }
                    }
                    else => return false;
                }
            }
            else => return false;
        }
    }

    fn emit_strcmp_compare(self: Self*, infix: const cir::InfixExpr*) String {
        self->ensure_strcmp_proto();

        var lhs = self->emit_expr(infix->lhs);
        var rhs = self->emit_expr(infix->rhs);

        var out = String.from_str(self->allocator, "(strcmp((const char*)(");
        out.push_str(lhs.as_str_const());
        out.push_str("),(const char*)(");
        out.push_str(rhs.as_str_const());
        out.push_str("))");

        switch (infix->op) {
            case .Equal => out.push_str("==0");
            else => out.push_str("!=0");
        }

        out.push(')');
        lhs.free();
        rhs.free();
        return out;
    }

    fn emit_assign(self: Self*, assign: const cir::AssignExpr*) String {
        var lhs = self->emit_expr(assign->lhs);

        switch (self->expr_int128_kind(assign->lhs)) {
            case .Some(unsigned_domain) => {
                var res = self->emit_assign_int128(
                    assign,
                    lhs.as_str_const(),
                    unsigned_domain
                );
                lhs.free();
                return res;
            }
            else => {}
        }

        var out: String;

        switch (assign->kind) {
            case .Default => {
                out = String.new(self->allocator);
                out.push('(');
                out.push_str(lhs.as_str_const());
                out.push('=');
                
                var rhs = self->emit_expr(assign->rhs);

                switch (assign->lhs->ty) {
                    case .Some(lhs_ty) => {
                        rhs = self->coerce_value(rhs, assign->rhs, &lhs_ty);
                    }
                    else => {}
                }

                out.push_str(rhs.as_str_const());
                rhs.free();
                out.push(')');
            }

            
            case .AddAssign => {
                return self->compound_assign(lhs, assign->rhs, "+");
            }
            
            case .SubAssign => {
                return self->compound_assign(lhs, assign->rhs, "-");
            }
            
            case .MulAssign => {
                return self->compound_assign(lhs, assign->rhs, "*");
            }
            
            case .DivAssign => {
                return self->compound_assign(lhs, assign->rhs, "/");
            }
            
            case .ModAssign => {
                return self->compound_assign(lhs, assign->rhs, "%");
            }
            
            case .BitwiseAndAssign => {
                return self->compound_assign(lhs, assign->rhs, "&");
            }
            
            case .BitwiseXorAssign => {
                return self->compound_assign(lhs, assign->rhs, "^");
            }
            
            case .LeftShiftAssign => {
                return self->compound_assign(lhs, assign->rhs, "<<");
            }
            
            case .RightShiftAssign => {
                return self->compound_assign(lhs, assign->rhs, ">>");
            }
            
            case .BitwiseAndNotAssign => {
                out = String.new(self->allocator);

                var rhs = self->emit_expr(assign->rhs);

                out.push('(');
                out.push_str(lhs.as_str_const());
                out.push_str(" = ");
                out.push_str(lhs.as_str_const());
                out.push_str(" & ~(");
                out.push_str(rhs.as_str_const());
                out.push_str("))");

                rhs.free();
            }
        }

        lhs.free();
        return out;
    }

    fn int128_shift_amount(
        self: Self*,
        assign_rhs: const cir::Expr*,
        rhs_text: const uint8*,
        unsigned_domain: bool
    ) String {
        var out = String.new(self->allocator);

        if (self->expr_int128_kind(assign_rhs).is_some()) {
            out.push_str("__cyrus_");
            
            if (unsigned_domain) {
                out.push_str("u128");
            } else {
                out.push_str("i128");
            }
            
            out.push_str("_to_u64(");
            out.push_str(rhs_text);
            out.push(')');
            return out;
        }

        out.push_str("(uint64_t)(");
        out.push_str(rhs_text);
        out.push(')');
        return out;
    }

    fn emit_assign_int128(
        self: Self*,
        assign: const cir::AssignExpr*,
        lhs_value: const uint8*,
        unsigned_domain: bool
    ) String {
        var rhs_text = self->emit_expr(assign->rhs);
        var prefix_name = "__cyrus_u128";
        
        if (!unsigned_domain) {
            prefix_name = "__cyrus_i128";
        }

        var operator_name: const uint8*;
        var rhs_operand: Option<String> = .None;
        var not_rhs_operand: Option<String> = .None;
        var is_default = false;

        switch (assign->kind) {
            case .Default => {
                is_default = true;
                
                rhs_operand = .Some(self->coerce_to_int128(
                    assign->rhs, 
                    rhs_text.as_str_const(), 
                    unsigned_domain
                ));
            }
            
            case .AddAssign => {
                operator_name = "add";
                
                rhs_operand = .Some(self->coerce_to_int128(
                    assign->rhs, 
                    rhs_text.as_str_const(), 
                    unsigned_domain
                ));
            }
            
            case .SubAssign => {
                operator_name = "sub";
                
                rhs_operand = .Some(self->coerce_to_int128(
                    assign->rhs, 
                    rhs_text.as_str_const(), 
                    unsigned_domain
                ));
            }
            
            case .MulAssign => {
                operator_name = "mul";
                
                rhs_operand = .Some(self->coerce_to_int128(
                    assign->rhs, 
                    rhs_text.as_str_const(), 
                    unsigned_domain
                ));
            }
            
            case .DivAssign => {
                operator_name = "div";
                
                rhs_operand = .Some(self->coerce_to_int128(
                    assign->rhs, 
                    rhs_text.as_str_const(), 
                    unsigned_domain
                ));
            }
            
            case .ModAssign => {
                operator_name = "mod";
                
                rhs_operand = .Some(self->coerce_to_int128(
                    assign->rhs, 
                    rhs_text.as_str_const(), 
                    unsigned_domain
                ));
            }
            
            case .BitwiseAndAssign => {
                operator_name = "band";
                
                rhs_operand = .Some(self->coerce_to_int128(
                    assign->rhs, 
                    rhs_text.as_str_const(), 
                    unsigned_domain
                ));
            }
            
            case .BitwiseXorAssign => {
                operator_name = "bxor";
                
                rhs_operand = .Some(self->coerce_to_int128(
                    assign->rhs, 
                    rhs_text.as_str_const(), 
                    unsigned_domain
                ));
            }
            
            case .BitwiseAndNotAssign => {
                operator_name = "band";

                var coerce_rhs = self->coerce_to_int128(
                    assign->rhs,
                    rhs_text.as_str_const(), 
                    unsigned_domain
                );
                
                var not_fn = self->wrap_str(
                    prefix_name,
                    "_bnot(",
                    coerce_rhs.as_str_const()
                );

                not_fn.push(')');
                coerce_rhs.free();
                not_rhs_operand = .Some(not_fn);
            }
            
            case .LeftShiftAssign => {
                operator_name = "shl";
                
                rhs_operand = .Some(self->int128_shift_amount(
                    assign->rhs, 
                    rhs_text.as_str_const(), 
                    unsigned_domain
                ));
            }
            
            case .RightShiftAssign => {
                operator_name = "shr";
                
                rhs_operand = .Some(self->int128_shift_amount(
                    assign->rhs, 
                    rhs_text.as_str_const(), 
                    unsigned_domain
                ));
            }
        }

        var out = String.new(self->allocator);
        out.push('(');
        out.push_str(lhs_value);
        out.push('=');

        if (is_default) {
            switch (rhs_operand) {
                case .Some(operand) => out.push_str(operand.as_str_const());
                case .None => out.push_str("0");
            }
        } else {
            var rhs_arg = lhs_value;

            if (not_rhs_operand.is_some()) {
                switch (not_rhs_operand) {
                    case .Some(inv_op) => rhs_arg = inv_op.as_str_const();
                    case .None => {}
                }
            } else if (rhs_operand.is_some()) {
                switch (rhs_operand) {
                    case .Some(op) => rhs_arg = op.as_str_const();
                    case .None => {}
                }
            }

            var fn_ = String.new(self->allocator);
            
            fn_.push_str(prefix_name);
            fn_.push('_');
            
            if (operator_name != null) {
                fn_.push_str(operator_name);
            } else {
                fn_.push_str("add");
            }

            out.push_str(fn_.as_str_const());
            out.push('(');
            out.push_str(lhs_value);
            out.push(',');
            out.push_str(rhs_arg);
            out.push(')');

            fn_.free();
        }

        out.push(')');

        rhs_text.free();

        switch (rhs_operand) {
            case .Some(operand) => operand.free();
            case .None => {}
        }
        
        switch (not_rhs_operand) {
            case .Some(operand) => operand.free();
            case .None => {}
        }

        return out;
    }

    fn compound_assign(
        self: Self*, 
        lhs: String, 
        rhs: const cir::Expr*, 
        operator: const uint8*
    ) String {
        var out = String.new(self->allocator);
        var rhs = self->emit_expr(rhs);

        out.push('(');
        out.push_str(lhs.as_str_const());
        out.push(' ');
        out.push_str(operator);
        out.push_str("= ");
        out.push_str(rhs.as_str_const());
        out.push(')');
        
        lhs.free();
        rhs.free();
        return out;
    }

    fn emit_symbol(self: Self*, symbol: const cir::SymbolExpr*) String {
        switch (*symbol) {
            case .Resolved { decl_id, .. } => {
                switch (decl_id) {
                    case .Var(var_decl_id) => {
                        switch (self->fn_var_renames.get(var_decl_id)) {
                            case .Some(c_name) => {
                                return String.from_str(self->allocator, c_name->as_str_const());
                            }
                            else => {}
                        }

                        switch (self->switch_binding_names.get(var_decl_id)) {
                            case .Some(c_name) => {
                                return String.from_str(self->allocator, c_name->as_str_const());
                            }
                            else => {}
                        }

                        switch (self->tables->vars.get_const(var_decl_id)) {
                            case .Some(var_decl) => {
                                return mangle::sanitized(self->allocator, var_decl->name.as_str_const());
                            }
                            else => {}
                        }
                    }

                    case .GlobalVar(global_var_decl_id) => {
                        switch (self->tables->global_vars.get_const(global_var_decl_id)) {
                            case .Some(global_var_decl) => {
                                var gname = mangle::mangle_global(
                                    self->allocator,
                                    &self->types.maps,
                                    global_var_decl->name.as_str_const(),
                                    global_var_decl_id,
                                    &global_var_decl->modifiers
                                );

                                if (gname.as_str_const() == "errno") {
                                    gname.free();
                                    self->ensure_errno_location_proto();
                                    return String.from_str(self->allocator, "(*__errno_location())");
                                }

                                return gname;
                            }
                            else => {}
                        }
                    }

                    case .Func(func_decl_id) => {
                        switch (self->tables->funcs.get_const(func_decl_id)) {
                            case .Some(decl) => {
                                self->ensure_func_decl_proto(func_decl_id, decl);

                                return mangle::mangle_func(
                                    self->allocator,
                                    &self->types.maps,
                                    decl->name.as_str_const(),
                                    func_decl_id,
                                    &decl->modifiers
                                );
                            }
                            else => {}
                        }
                    }

                    case .Method(method_decl_id) => {
                        switch (self->tables->methods.get_const(method_decl_id)) {
                            case .Some(method_decl) => {
                                return mangle::mangle_method(
                                    self->allocator, 
                                    &self->types.maps, 
                                    method_decl_id, 
                                    method_decl
                                );
                            }
                            else => {}
                        }
                    }

                    else => {}
                }
            }

            case .Unresolved { symbol_id, .. } => {
                switch (self->registry->symbol_name(symbol_id)) {
                    case .Some(name) => {
                        var out = mangle::sanitized(self->allocator, name.as_str_const());
                        name.free();
                        return out;
                    }
                    else => {}
                }
            }
        }

        return String.from_str(self->allocator, "/*unresolved_symbol*/0");
    }

    /// Returns the index of the first variadic argument when the callee
    /// accepts varargs, so arguments at or after it can be promoted.
    fn variadic_arg_start(self: Self*, func_call: const cir::FuncCall*) Option<usize> {
        switch (func_call->dispatch) {
            case .Normal { func_decl_id } => {
                switch (self->tables->funcs.get_const(func_decl_id)) {
                    case .Some(func_decl) => {
                        switch (func_decl->params.variadic) {
                            case .Some => return .Some(func_decl->params.list.len());
                            else => {}
                        }
                    }
                    else => {}
                }
            }
            case .Monomorph { monomorph_id } => {
                switch (self->monomorphs->instances.get_const(monomorph_id)) {
                    case .Some(inst) => {
                        switch (inst->params.variadic) {
                            case .Some => return .Some(inst->params.list.len());
                            else => {}
                        }
                    }
                    else => {}
                }
            }
            case .FunctionPointer { func_type } => {
                switch (func_type.params.variadic) {
                    case .Some => return .Some(func_type.params.list.len());
                    else => {}
                }
            }
            else => {}
        }

        return .None;
    }

    /// Applies the default argument promotions for a variadic argument.
    fn emit_variadic_arg(self: Self*, arg: const cir::Expr*, value: String) String {
        switch (arg->ty) {
            case .Some(ty) => {
                switch (ty.as_plain_type()) {
                    case .Some(plain) => {
                        switch (plain) {
                            case .UInt8 => {
                                var out = String.from_str(self->allocator, "((uint32_t)(int8_t)(");
                                out.push_str(value.as_str_const());
                                out.push_str("))");
                                value.free();
                                return out;
                            }
                            case .UInt16 => {
                                var out = String.from_str(self->allocator, "((uint32_t)(int16_t)(");
                                out.push_str(value.as_str_const());
                                out.push_str("))");
                                value.free();
                                return out;
                            }
                            else => {}
                        }
                    }
                    else => {}
                }
            }
            else => {}
        }

        return value;
    }

    fn emit_func_call(self: Self*, func_call: const cir::FuncCall*) String {
        var out = String.new(self->allocator);
        var callee: String;

        switch (func_call->dispatch) {
            case .Normal { func_decl_id } => {
                switch (self->tables->funcs.get_const(func_decl_id)) {
                    case .Some(func_decl) => {
                        self->ensure_func_decl_proto(func_decl_id, func_decl);

                        callee = mangle::mangle_func(
                            self->allocator,
                            &self->types.maps,
                            func_decl->name.as_str_const(),
                            func_decl_id,
                            &func_decl->modifiers
                        );
                    }
                    else => {
                        callee = self->emit_expr(func_call->operand);
                    }
                }
            }
            case .Monomorph { monomorph_id } => {
                var resolved = false;

                switch (self->monomorphs->instances.get_const(monomorph_id)) {
                    case .Some(inst) => {
                        switch (inst->template_id) {
                            case .Func(func_decl_id) => {
                                switch (self->tables->funcs.get_const(func_decl_id)) {
                                    case .Some(func_decl) => {
                                        callee = mangle::mangle_monomorphized_func(
                                            self->allocator,
                                            &self->types.maps,
                                            self->tables,
                                            func_decl->name.as_str_const(),
                                            func_decl_id,
                                            &func_decl->modifiers,
                                            &inst->type_args
                                        );
                                        resolved = true;
                                    }
                                    else => {}
                                }
                            }
                            else => {}
                        }
                    }
                    else => {}
                }

                if (!resolved) {
                    callee = self->emit_expr(func_call->operand);
                }
            }
            else => {
                callee = self->emit_expr(func_call->operand);
            }
        }

        out.push_str(callee.as_str_const());
        out.push('(');

        const variadic_start = self->variadic_arg_start(func_call);

        for (var i: usize = 0; i < func_call->args.len(); i += 1) {
            const arg = func_call->args.get_const(i).unwrap();

            var expr = self->emit_expr(arg);

            switch (variadic_start) {
                case .Some(start) => {
                    if (i >= start) {
                        expr = self->emit_variadic_arg(arg, expr);
                    }
                }
                else => {}
            }

            switch (self->func_call_param_type(func_call, i)) {
                case .Some(param_ty) => {
                    expr = self->coerce_value(expr, arg, &param_ty);
                }
                else => {}
            }

            out.push_str(expr.as_str_const());
            expr.free();
            
            if (i + 1 < func_call->args.len()) {
                out.push(',');
            }
        }

        out.push(')');
        callee.free();
        return out;
    }

    fn emit_addr_of_expr(self: Self*, operand: const cir::Expr*) String {
        var expr = self->emit_expr(operand);
        var out = String.new(self->allocator);

        if (is_c_lvalue(operand) || is_compound_literal_expr(operand)) {
            out.push_str("(&");
            out.push_str(expr.as_str_const());
            out.push(')');
            expr.free();
            return out;
        }

        switch (operand->ty) {
            case .Some(ty) => {
                const unconst_ty = *ty.const_inner();
                switch (unconst_ty) {
                    case .Array => {
                        out.push_str("(&");
                        out.push_str(expr.as_str_const());
                        out.push(')');
                    }
                    else => {
                        self->types.ensure_named(&unconst_ty);
                        var arr_decl = self->types.build_decl(&unconst_ty, "[]");
                        out.push_str("((");
                        out.push_str(arr_decl.as_str_const());
                        out.push_str("){");
                        out.push_str(expr.as_str_const());
                        out.push_str("})");
                        arr_decl.free();
                    }
                }
            }
            case .None => {
                out.push_str("(&");
                out.push_str(expr.as_str_const());
                out.push(')');
            }
        }

        expr.free();
        return out;
    }

    /// Emits the receiver argument for an instance method call,
    /// returning true when an argument was actually written.
    ///
    /// Static methods produce nothing and return false.
    fn emit_method_self_argument(
        self: Self*,
        out: String*,
        method: const cir::MethodDecl*,
        operand: const cir::Expr*
    ) bool {
        if (!method->is_instance_method()) {
            return false;
        }

        var needs_non_const_cast = false;

        if (!method->is_self_by_value()) {
            switch (method->func_decl.params.list.first()) {
                case .Some(param_kind) => {
                    switch (*param_kind) {
                        case .SelfModifier(self_modifier) => {
                            switch (self_modifier.ty) {
                                case .Pointer(inner) => {
                                    if (!inner->is_const()) {
                                        needs_non_const_cast = true;
                                    }
                                }
                                else => {}
                            }
                        }
                        else => {}
                    }
                }
                else => {}
            }
        }

        switch (operand->ty) {
            case .Some(ty) => {
                switch (*ty.const_inner()) {
                    case .InterfaceObject => {
                        out->push('(');
                        var expr = self->emit_expr(operand);
                        out->push_str(expr.as_str_const());
                        out->push_str(").data");
                        expr.free();
                        return true;
                    }
                    case .Pointer(inner) => {
                        var expr = self->emit_expr(operand);

                        // Value receiver called through a pointer
                        if (method->is_self_by_value()) {
                            out->push_str("(*");
                            out->push_str(expr.as_str_const());
                            out->push(')');
                        } else if (needs_non_const_cast) {
                            var non_const_inner = *inner->const_inner();
                            
                            const ptr_type: cir::SemaType = .Pointer(&non_const_inner);

                            var cast_type = self->types.build_decl(&ptr_type, "");
                            
                            out->push_str("((");
                            out->push_str(cast_type.as_str_const());
                            out->push_str(")(");
                            out->push_str(expr.as_str_const());
                            out->push_str("))");
                            
                            cast_type.free();
                        } else {
                            out->push_str(expr.as_str_const());
                        }
                        
                        expr.free();
                        return true;
                    }
                    else => {
                        if (method->is_self_by_value()) {
                            var expr = self->emit_expr(operand);
                            out->push_str(expr.as_str_const());
                            expr.free();
                        } else if (needs_non_const_cast) {
                            var addr = self->emit_addr_of_expr(operand);
                            var non_const_inner = *ty.const_inner();

                            const ptr_type: cir::SemaType = .Pointer(&non_const_inner);
                            
                            var cast_type = self->types.build_decl(&ptr_type, "");
                            
                            out->push_str("((");
                            out->push_str(cast_type.as_str_const());
                            out->push_str(")(");
                            out->push_str(addr.as_str_const());
                            out->push_str("))");
                            cast_type.free();

                            addr.free();
                        } else {
                            var addr = self->emit_addr_of_expr(operand);
                            out->push_str(addr.as_str_const());
                            addr.free();
                        }

                        return true;
                    }
                }
            }
            else => {}
        }

        return false;
    }

    fn emit_interface_self_argument(
        self: Self*,
        out: String*,
        method: const cir::MethodDecl*,
        operand: const cir::Expr*
    ) bool {
        if (!method->is_instance_method()) {
            return false;
        }

        out->push('(');

        var expr = self->emit_expr(operand);
        out->push_str(expr.as_str_const());
        out->push_str(").data");
        expr.free();
        
        return true;
    }

    fn emit_method_call(self: Self*, method_call: const cir::MethodCall*) String {
        switch (method_call->dispatch) {
            case .Normal { method_decl_id } => {
                switch (self->tables->methods.get_const(method_decl_id)) {
                    case .Some(method) => {
                        var name = mangle::mangle_method(
                            self->allocator,
                            &self->types.maps,
                            method_decl_id,
                            method
                        );
                        
                        var out = String.new(self->allocator);
                        out.push_str(name.as_str_const());
                        out.push('(');

                        const has_self_argument = self->emit_method_self_argument(
                            &out, 
                            method, 
                            method_call->operand
                        );
                        
                        for (var i: usize = 0; i < method_call->args.len(); i += 1) {
                            const arg = method_call->args.get_const(i).unwrap();
                            
                            if (has_self_argument || i != 0) {
                                out.push(',');
                            }
                            
                            var expr = self->emit_expr(arg);
                            out.push_str(expr.as_str_const());
                            expr.free();
                        }

                        out.push(')');
                        name.free();
                        return out;
                    }
                    else => {}
                }
            }
            
            case .Interface { interface_decl_id, index, dispatch } => {
                switch (dispatch) {
                    case .StaticNormal { method_decl_id } => {
                        switch (self->tables->methods.get_const(method_decl_id)) {
                            case .Some(method) => {
                                var name = mangle::mangle_method(
                                    self->allocator, 
                                    &self->types.maps,
                                    method_decl_id, 
                                    method
                                );

                                var out = String.new(self->allocator);
                                
                                out.push_str(name.as_str_const());
                                out.push('(');
                                
                                const has_self_argument = self->emit_interface_self_argument(
                                    &out,
                                    method,
                                    method_call->operand
                                );
                                
                                for (var i: usize = 0; i < method_call->args.len(); i += 1) {
                                    const arg = method_call->args.get_const(i).unwrap();
                                    
                                    if (has_self_argument || i != 0) {
                                        out.push_str(", ");
                                    }
                                    
                                    var expr = self->emit_expr(arg);
                                    out.push_str(expr.as_str_const());
                                    expr.free();
                                }

                                out.push(')');
                                name.free();
                                return out;
                            }
                            else => {}
                        }
                    }

                    case .StaticMonomorphized { monomorph_id } => {
                        // Static call to a monomorphized method
                        switch (self->monomorphs->instances.get_const(monomorph_id)) {
                            case .Some(inst) => {
                                switch (inst->template_id) {
                                    case .Method(method_decl_id) => {
                                        switch (self->tables->methods.get_const(method_decl_id)) {
                                            case .Some(method) => {
                                                var name = mangle::mangle_monomorphized_method(
                                                    self->allocator,
                                                    &self->types.maps,
                                                    self->tables,
                                                    method_decl_id,
                                                    method,
                                                    &inst->type_args
                                                );

                                                var out = String.new(self->allocator);
                                                out.push_str(name.as_str_const());
                                                out.push('(');
                                                
                                                const has_self_argument = self->emit_interface_self_argument(
                                                    &out, 
                                                    method, 
                                                    method_call->operand
                                                );
                                                
                                                for (var i: usize = 0; i < method_call->args.len(); i += 1) {
                                                    const arg = method_call->args.get_const(i).unwrap();
                                                    
                                                    if (has_self_argument || i != 0) {
                                                        out.push_str(", ");
                                                    }
                                                    
                                                    var expr = self->emit_expr(arg);
                                                    out.push_str(expr.as_str_const());
                                                    expr.free();
                                                }

                                                out.push(')');
                                                name.free();
                                                return out;
                                            }
                                            else => {}
                                        }
                                    }
                                    else => {}
                                }
                            }
                            else => {}
                        }
                    }

                    // ((RET (*)(void *, ...))
                    //   ((void **)fat_pointer.vtable)[IDX])
                    //     (fat_pointer.data, args...)
                    case .Dynamic => {
                        var fat_pointer = self->emit_expr(method_call->operand);

                        var ret_name = self->interface_method_ret_type(
                            interface_decl_id, 
                            index, 
                            &method_call->type_args
                        );

                        var out = String.from_str(self->allocator, "((");
                        out.push_str(ret_name.as_str_const());
                        out.push_str("(*)(void*");

                        var emitted_interface_params = false;

                        switch (self->tables->interfaces.get_const(interface_decl_id)) {
                            case .Some(interface_) => {
                                switch (interface_->methods.entries.get_const(index)) {
                                    case .Some(entry) => {
                                        switch (self->tables->methods.get_const(entry->id)) {
                                            case .Some(iface_method) => {
                                                emitted_interface_params = true;

                                                const mark = self->arena.mark();

                                                const params = &iface_method->func_decl.params;

                                                for (var p: usize = 0; p < params->list.len(); p += 1) {
                                                    const param = params->list.get_const(p).unwrap();
                                                    switch (*param) {
                                                        case .SelfModifier => continue;
                                                        else => {}
                                                    }

                                                    var p_ty = param->ty();
                                                    if (interface_->is_generic() && !method_call->type_args.is_empty()) {
                                                        p_ty = cir::substitute_sema_type_with_type_args(
                                                            dynamic self->arena,
                                                            &p_ty,
                                                            &interface_->generic_params,
                                                            &method_call->type_args
                                                        );
                                                    }

                                                    self->types.ensure_named(&p_ty);
                                                    var type_name = self->types.type_name(&p_ty);
                                                    out.push(',');
                                                    out.push_str(type_name.as_str_const());
                                                    type_name.free();
                                                }

                                                self->arena.restore(mark);
                                            }
                                            else => {}
                                        }
                                    }
                                    else => {}
                                }
                            }
                            else => {}
                        }

                        if (!emitted_interface_params) {
                            for (var i: usize = 0; i < method_call->args.len(); i += 1) {
                                const arg = method_call->args.get_const(i).unwrap();
                                
                                switch (arg->ty) {
                                    case .Some(ty) => {
                                        var type_name = self->types.type_name(&ty);
                                        out.push(',');
                                        out.push_str(type_name.as_str_const());
                                        type_name.free();
                                    }
                                    else => out.push_str(",void*");
                                }
                            }
                        }

                        out.push_str("))((void**)(");
                        out.push_str(fat_pointer.as_str_const());
                        out.push_str(").vtable)[");
                        push_usize(&out, index);
                        out.push_str("])((");
                        out.push_str(fat_pointer.as_str_const());
                        out.push_str(").data");

                        for (var i: usize = 0; i < method_call->args.len(); i += 1) {
                            const arg = method_call->args.get_const(i).unwrap();
                            
                            out.push(',');
                            
                            var expr = self->emit_expr(arg);
                            out.push_str(expr.as_str_const());
                            expr.free();
                        }

                        out.push(')');
                        fat_pointer.free();
                        ret_name.free();
                        return out;
                    }
                    else => {}
                }
            }

            case .Monomorph { monomorph_id, .. } => {
                switch (self->monomorphs->instances.get_const(monomorph_id)) {
                    case .Some(inst) => {
                        switch (inst->template_id) {
                            case .Method(method_decl_id) => {
                                switch (self->tables->methods.get_const(method_decl_id)) {
                                    case .Some(method) => {
                                        var name = mangle::mangle_monomorphized_method(
                                            self->allocator,
                                            &self->types.maps,
                                            self->tables,
                                            method_decl_id,
                                            method,
                                            &inst->type_args
                                        );
                                        
                                        var out = String.new(self->allocator);
                                        out.push_str(name.as_str_const());
                                        out.push('(');

                                        const has_self_argument = self->emit_method_self_argument(
                                            &out, 
                                            method, 
                                            method_call->operand
                                        );
                                        
                                        for (var i: usize = 0; i < method_call->args.len(); i += 1) {
                                            const arg = method_call->args.get_const(i).unwrap();
                                            
                                            if (has_self_argument || i != 0) {
                                                out.push_str(", ");
                                            }
                                            
                                            var expr = self->emit_expr(arg);
                                            out.push_str(expr.as_str_const());
                                            expr.free();
                                        }
                                        
                                        out.push(')');
                                        name.free();
                                        return out;
                                    }
                                    else => {}
                                }
                            }
                            else => {}
                        }
                    }
                    else => {}
                }
            }
            else => {}
        }

        // Fallback:
        // Treat as a plain call on the operand
        var fallback = String.new(self->allocator);

        var base = self->emit_expr(method_call->operand);
        fallback.push_str(base.as_str_const());
        base.free();

        fallback.push_str(" (");

        for (var i: usize = 0; i < method_call->args.len(); i += 1) {
            const arg = method_call->args.get_const(i).unwrap();
            
            var expr = self->emit_expr(arg);
            fallback.push_str(expr.as_str_const());
            expr.free();
            
            if (i + 1 < method_call->args.len()) {
                fallback.push(',');
            }
        }

        fallback.push(')');
        return fallback;
    }

    fn emit_struct_init(self: Self*, struct_init: const cir::StructInitExpr*) String {
        var type_name = self->type_name_of(&struct_init->operand);
        var out = String.from_str(self->allocator, "((");
        out.push_str(type_name.as_str_const());
        out.push_str("){");

        var struct_decl: const cir::StructDecl* = null;
        var struct_args: const cir::TypeArgs* = null;

        switch (*struct_init->operand.const_inner()) {
            case .Named(named) => {
                switch (named.type_decl_id) {
                    case .Struct(id) => {
                        switch (self->tables->structs.get_const(id)) {
                            case .Some(decl) => {
                                struct_decl = decl;
                                if (!named.type_args.is_empty()) {
                                    struct_args = &named.type_args;
                                }
                            }
                            else => {}
                        }
                    }
                    else => {}
                }
            }
            else => {}
        }

        const mark = self->arena.mark();

        for (var i: usize = 0; i < struct_init->fields.len(); i += 1) {
            const field = struct_init->fields.get_const(i).unwrap();

            out.push('.');
            mangle::sanitize_into(&out, field->name.as_str_const());
            out.push('=');
            
            var expr = self->emit_init_value(&field->value);

            if (struct_decl != null) {
                switch (struct_decl->lookup_field(field->name.as_str_const())) {
                    case .Some(decl_field) => {
                        var field_type = decl_field->ty;

                        if (struct_args != null) {
                            field_type = cir::substitute_sema_type_with_type_args(
                                dynamic self->arena,
                                &field_type,
                                &struct_decl->generic_params,
                                struct_args
                            );
                        }

                        expr = self->coerce_value(expr, &field->value, &field_type);
                    }
                    else => {}
                }
            }

            out.push_str(expr.as_str_const());
            expr.free();

            if (i + 1 < struct_init->fields.len()) {
                out.push(',');
            }
        }

        self->arena.restore(mark);

        out.push_str("})");
        type_name.free();
        return out;
    }

    fn emit_enum_init(self: Self*, enum_init: const cir::EnumInit*) String {
        var enum_decl_id: cir::EnumDeclId;
        var found = false;
        var enum_args: const cir::TypeArgs* = null;

        switch (*enum_init->operand.const_inner()) {
            case .Named(named) => {
                switch (named.type_decl_id) {
                    case .Enum(id) => {
                        enum_decl_id = id;
                        found = true;

                        if (!named.type_args.is_empty()) {
                            enum_args = &named.type_args;
                        }
                    }
                    else => {}
                }
            }
            else => {}
        }

        if (!found) {
            return String.from_str(self->allocator, "((void)0)");
        }

        const enum_decl = self->tables->enums.get_const(enum_decl_id).unwrap();
        const scalar = is_enum_scalar_optimizable(self->tables, enum_decl);
        const tags = self->types.tctx.enum_variant_tags(enum_decl_id, enum_decl);
        
        var name = self->types.enum_c_name_for_ty(&enum_init->operand);

        const tag = enum_decl->find_variant_tag(
            tags,
            enum_init->name.as_str_const()
        );
        
        var variant_index: usize = 0;
        var found_variant = false;

        for (var i: usize = 0; i < enum_decl->variants.len(); i += 1) {
            const variant = enum_decl->variants.get_const(i).unwrap();
            
            if (variant->name() == enum_init->name.as_str_const()) {
                variant_index = i;
                found_variant = true;
                break;
            }
        }

        if (!found_variant) {
            name.free();
            return String.from_str(self->allocator, "((void)0)");
        }

        if (scalar) {
            var out = String.from_str(self->allocator, "((");
            out.push_str(name.as_str_const());
            out.push(')');
            
            switch (enum_init->arg) {
                case .Unit => push_uint32(&out, tag);

                case .Tuple(exprs) => {
                    if (exprs.len() == 1) {
                        const element = exprs.get_const(0).unwrap();

                        var expr = self->emit_expr(element);
                        out.push_str(expr.as_str_const());
                        expr.free();
                    } else {
                        push_uint32(&out, tag);
                    }
                }

                else => push_uint32(&out, tag);
            }
            
            out.push(')');
            name.free();
            return out;
        }

        const variant = enum_decl->variants.get_const(variant_index).unwrap();

        var out = String.from_str(self->allocator, "((");
        out.push_str(name.as_str_const());
        out.push_str("){.tag=");
        push_uint32(&out, tag);

        switch (*variant) {
            case .Unit => {}

            case .Valued { value, .. } => {
                out.push_str(",.u={.v");
                push_uint32(&out, tag);
                out.push_str("={");

                var expr = self->emit_expr(value);
                out.push_str(expr.as_str_const());
                expr.free();

                out.push_str("}}");
            }

            case .Tuple { fields, .. } => {
                out.push_str(",.u={.v");
                push_uint32(&out, tag);
                out.push_str("={");

                const mark = self->arena.mark();

                switch (enum_init->arg) {
                    case .Tuple(exprs) => {
                        for (var j: usize = 0; j < fields.len(); j += 1) {
                            if (j < exprs.len()) {
                                const element = exprs.get_const(j).unwrap();
                                const field = fields.get_const(j).unwrap();

                                var field_type = self->substitute_variant_field_typepe(
                                    enum_decl,
                                    &field->ty,
                                    enum_args
                                );

                                var expr = self->emit_expr(element);
                                expr = self->coerce_value(expr, element, &field_type);
                                out.push_str(expr.as_str_const());
                                expr.free();
                            }

                            if (j + 1 < fields.len()) {
                                out.push(',');
                            }
                        }
                    }
                    else => {}
                }

                self->arena.restore(mark);
                out.push_str("}}");
            }

            case .Struct { fields, .. } => {
                out.push_str(",.u={.v");
                push_uint32(&out, tag);
                out.push_str("={");

                const mark = self->arena.mark();

                switch (enum_init->arg) {
                    case .Struct(field_inits) => {
                        for (var j: usize = 0; j < fields.len(); j += 1) {
                            const field = fields.get_const(j).unwrap();

                            for (var k: usize = 0; k < field_inits.len(); k += 1) {
                                const field_init = field_inits.get_const(k).unwrap();

                                if (field_init->name.str.as_str_const() == field->name.str.as_str_const()) {
                                    out.push('.');
                                    mangle::sanitize_into(&out, field->name.str.as_str_const());
                                    out.push('=');

                                    var field_type = self->substitute_variant_field_typepe(
                                        enum_decl,
                                        &field->ty,
                                        enum_args
                                    );

                                    var expr = self->emit_expr(field_init->value);
                                    expr = self->coerce_value(expr, field_init->value, &field_type);
                                    out.push_str(expr.as_str_const());
                                    expr.free();

                                    out.push(',');
                                    break;
                                }
                            }
                        }
                    }
                    else => {}
                }

                self->arena.restore(mark);
                out.push_str("}}");
            }
        }

        out.push_str("})");
        name.free();
        return out;
    }

    fn emit_lambda(self: Self*, lambda: const cir::LambdaExpr*) String {
        const lambda_id = self->lambda_id;
        self->lambda_id += 1;

        var name = String.from_str(self->allocator, "__lambda_");
        push_usize(&name, lambda_id);

        var sig = self->build_func_signature(
            &lambda->ret_type, 
            &lambda->params, 
            name.as_str_const()
        );

        self->protos_out.push_str("static ");
        self->protos_out.push_str(sig.as_str_const());
        self->protos_out.push(';');

        
        var definition = String.new(self->allocator);
        definition.push_str("static ");
        definition.push_str(sig.as_str_const());
        definition.push('{');
        
        const parent = self->body_out;
        self->body_out = String.new(self->allocator);

        var saved_scope = self->fn_scope_names;
        self->fn_scope_names = Vec.new(self->allocator);

        
        var saved_defer_scopes = self->defer_scopes;
        self->defer_scopes = Vec.new(self->allocator);

        var saved_loop_marks = self->loop_marks;
        self->loop_marks = Vec.new(self->allocator);

        var saved_func_name = self->cur_func_name;
        var saved_method_name = self->cur_method_name;
        var saved_ret_type = self->cur_ret_type;
        var saved_in_void_main = self->in_void_main;
        self->set_name_context(.Some("<unnamed>"), .None);
        self->cur_ret_type = .Some(lambda->ret_type);
        self->in_void_main = false;

        var saved_label_ids = self->label_depth_ids;
        var saved_label_depths = self->label_depths;
        self->label_depth_ids = Vec.new(self->allocator);
        self->label_depths = Vec.new(self->allocator);

        self->emit_param_prologue(&lambda->params);
        self->scan_func_labels(lambda->body, true);
        self->emit_block_stmts(lambda->body, true);

        self->label_depth_ids.free();
        self->label_depths.free();
        self->label_depth_ids = saved_label_ids;
        self->label_depths = saved_label_depths;

        self->cur_func_name = saved_func_name;
        self->cur_method_name = saved_method_name;
        self->cur_ret_type = saved_ret_type;
        self->in_void_main = saved_in_void_main;

        for (var i: usize = 0; i < self->fn_scope_names.len(); i += 1) {
            self->fn_scope_names.get(i).unwrap()->free();
        }

        self->fn_scope_names.free();
        self->fn_scope_names = saved_scope;

        for (var i: usize = 0; i < self->defer_scopes.len(); i += 1) {
            self->defer_scopes.get(i).unwrap()->free();
        }

        self->defer_scopes.free();
        self->defer_scopes = saved_defer_scopes;

        self->loop_marks.free();
        self->loop_marks = saved_loop_marks;

        definition.push_str(self->body_out.as_str_const());
        definition.push('}');

        self->lambda_defs.push_str(definition.as_str_const());
        definition.free();

        self->body_out.free();
        self->body_out = parent;

        sig.free();
        return name;
    }

    fn emit_dynamic(self: Self*, dynamic_: const cir::DynamicExpr*) String {
        var vtable_name = self->ensure_vtable_for(dynamic_);

        self->types.ensure_fat_ptr();

        // The operand is always a 
        // by-value concrete object
        var out = String.from_str(
            self->allocator, 
            "((__fat_ptr){.data=(void*)"
        );

        var expr = self->emit_addr_of_expr(dynamic_->operand);
        out.push_str(expr.as_str_const());
        expr.free();
        
        out.push_str(",.vtable=(void*)");
        out.push_str(vtable_name.as_str_const());
        out.push_str("})");

        vtable_name.free();
        return out;
    }

    fn ensure_vtable_for(self: Self*, dynamic_: const cir::DynamicExpr*) String {
        var vtable_id: cir::VTableId = 0;
        var found = false;

        switch (dynamic_->interface_object_type) {
            case .Some(ty) => {
                vtable_id = ty.vtable_id;
                found = true;
            }
            else => {}
        }

        if (!found) {
            switch (dynamic_->concrete_type) {
                case .Some(ty) => {
                    // Find a vtable whose concrete type matches
                    for (var i: usize = 0; i < self->vtables->tables.len(); i += 1) {
                        const info = self->vtables->tables.get_const(i).unwrap();

                        if (cir::cir_types_eq(&info->concrete_type, &ty)) {
                            vtable_id = i;
                            found = true;
                            break;
                        }
                    }
                }
                else => {}
            }
        }

        var out = String.from_str(self->allocator, "__cyrus_vtable_");
        push_usize(&out, vtable_id);

        if (!found) {
            return out;
        }

        switch (self->vtable_emitted.get(vtable_id)) {
            case .Some => return out;
            else => {}
        }

        self->vtable_emitted.insert(vtable_id, 1);

        const info = self->vtables->tables.get_const(vtable_id).unwrap();

        self->pending_out.push_str("static void*__cyrus_vtable_");
        push_usize(&self->pending_out, vtable_id);
        self->pending_out.push_str("[]={");

        for (var i: usize = 0; i < info->method_decls.entries.len(); i += 1) {
            const entry = info->method_decls.entries.get_const(i).unwrap();

            // Use the existing specialized function
            // when the analyzer recorded one
            // for this slot
            var done = false;

            switch (info->monomorphized_methods.get_const(i)) {
                case .Some(slot) => {
                    switch (*slot) {
                        case .Some(mono_id) => {
                            switch (self->monomorphs->instances.get_const(mono_id)) {
                                case .Some(inst) => {
                                    switch (inst->template_id) {
                                        case .Method(method_decl_id) => {
                                            switch (self->tables->methods.get_const(method_decl_id)) {
                                                case .Some(method) => {
                                                    var name = mangle::mangle_monomorphized_method(
                                                        self->allocator,
                                                        &self->types.maps,
                                                        self->tables,
                                                        method_decl_id,
                                                        method,
                                                        &inst->type_args
                                                    );
                                                    self->pending_out.push_str("(void*)&");
                                                    self->pending_out.push_str(name.as_str_const());
                                                    self->pending_out.push(',');
                                                    name.free();
                                                    done = true;
                                                }
                                                else => {}
                                            }
                                        }
                                        else => {}
                                    }
                                }
                                else => {}
                            }
                        }
                        else => {}
                    }
                }
                else => {}
            }

            if (done) {
                continue;
            }

            switch (self->tables->methods.get_const(entry->id)) {
                case .Some(method) => {
                    var name = mangle::mangle_method(
                        self->allocator,
                        &self->types.maps,
                        entry->id,
                        method
                    );

                    self->pending_out.push_str("(void*)&");
                    self->pending_out.push_str(name.as_str_const());
                    self->pending_out.push(',');
                    name.free();
                }
                else => self->pending_out.push_str("0,");
            }
        }

        self->pending_out.push_str("};");

        return out;
    }

    fn needs_signed_cast(
        self: Self*, 
        target_type: const cir::SemaType*, 
        value_arg: const cir::Expr*
    ) bool {
        switch (value_arg->ty) {
            case .Some(src_type) => {
                switch (target_type->as_plain_type()) {
                    case .Some(target_plain) => {
                        switch (src_type.as_plain_type()) {
                            case .Some(src_plain) => {
                                if (!target_plain.is_integer() || !src_plain.is_integer()) {
                                    return false;
                                }

                                if (target_plain.is_bool() || src_plain.is_bool()) {
                                    return false;
                                }

                                switch (cir::PlainType.plain_type_rank(&target_plain)) {
                                    case .Some(target_rank) => {
                                        switch (cir::PlainType.plain_type_rank(&src_plain)) {
                                            case .Some(src_rank) => {
                                                if (target_rank <= src_rank) {
                                                    return false;
                                                }

                                                switch (signed_int_c_name(&src_plain)) {
                                                    case .Some => return true;
                                                    else => return false;
                                                }
                                            }
                                            else => return false;
                                        }
                                    }
                                    else => return false;
                                }
                            }
                            else => return false;
                        }
                    }
                    else => return false;
                }
            }
            else => return false;
        }
    }

    fn emit_builtin_func(self: Self*, builtin_func: const cir::BuiltinFunc*) String {
        switch (cir::lookup_builtin(builtin_func->name.str.as_str_const())) {
            case .Some(kind) => {
                switch (kind) {
                    case .Len => {
                        switch (builtin_func->args.get_const(0)) {
                            case .Some(operand) => {
                                switch (operand->ty) {
                                    case .Some(ty) => {
                                        switch (ty.as_array_type()) {
                                            case .Some(array) => {
                                                switch (array.capacity) {
                                                    case .Fixed => {
                                                        const len = self->types.tctx.array_capacity_len(&array);
                                                        
                                                        var out = String.from_str(self->allocator, "((uintptr_t)");
                                                        push_usize(&out, len);
                                                        out.push(')');
                                                        return out;
                                                    }
                                                    case .Slice | .TerminatedSlice => {
                                                        var expr = self->emit_expr(operand);
                                                        var out = String.from_str(self->allocator, "((");
                                                        
                                                        out.push_str(expr.as_str_const());
                                                        out.push_str(").len)");
                                                        
                                                        expr.free();
                                                        return out;
                                                    }
                                                }
                                            }
                                            else => {}
                                        }
                                    }
                                    case .None => {}
                                }
                            }
                            else => {}
                        }

                        return String.from_str(self->allocator, "((uintptr_t)0)");
                    }

                    case .Ptr => {
                        switch (builtin_func->args.get_const(0)) {
                            case .Some(operand) => {
                                switch (operand->ty) {
                                    case .Some(ty) => {
                                        switch (ty.const_inner()->as_array_type()) {
                                            case .Some(array) => {
                                                const ptr_ty: cir::SemaType = .Pointer(array.element_type);

                                                var expr = self->emit_expr(operand);
                                                var ptr_decl = self->types.build_decl(&ptr_ty, "");
                                                var out = String.from_str(self->allocator, "((");
                                                out.push_str(ptr_decl.as_str_const());
                                                
                                                switch (array.capacity) {
                                                    case .Fixed => {
                                                        out.push_str(")(");
                                                        out.push_str(expr.as_str_const());
                                                        out.push_str("))");
                                                    }
                                                    case .Slice | .TerminatedSlice => {
                                                        out.push_str(")((");
                                                        out.push_str(expr.as_str_const());
                                                        out.push_str(").ptr))");
                                                    }
                                                }
                                                
                                                ptr_decl.free();
                                                expr.free();
                                                return out;
                                            }
                                            else => {}
                                        }
                                    }
                                    case .None => {}
                                }
                            }
                            else => {}
                        }

                        return String.from_str(self->allocator, "((void*)0)");
                    }

                    case .Slice => {
                        self->types.ensure_slice();
                        switch (builtin_func->args.get_const(0)) {
                            case .Some(ptr_arg) => {
                                switch (builtin_func->args.get_const(1)) {
                                    case .Some(len_arg) => {
                                        var ptr_str = self->emit_expr(ptr_arg);
                                        var len_str = self->emit_expr(len_arg);
                                        var out = String.from_str(self->allocator, "((__slice){.ptr=(void*)(");
                                        
                                        out.push_str(ptr_str.as_str_const());
                                        out.push_str("),.len=(uintptr_t)(");
                                        out.push_str(len_str.as_str_const());
                                        out.push_str(")})");

                                        len_str.free();
                                        ptr_str.free();
                                        return out;
                                    }
                                    else => {}
                                }
                            }
                            else => {}
                        }

                        return String.from_str(self->allocator, "((__slice){.ptr=(void*)0,.len=0})");
                    }

                    case .SizeOf => {
                        switch (builtin_func->args.get_const(0)) {
                            case .Some(operand) => {
                                switch (operand->ty) {
                                    case .Some(ty) => {
                                        self->types.ensure_named(&ty);
                                        
                                        var type_name = self->types.type_name(&ty);
                                        var out = String.from_str(self->allocator, "sizeof(");

                                        out.push_str(type_name.as_str_const());
                                        out.push(')');
                                        
                                        type_name.free();
                                        return out;
                                    }
                                    case .None => {}
                                }
                            }
                            else => {}
                        }

                        return String.from_str(self->allocator, "sizeof(void)");
                    }

                    case .AlignOf => {
                        switch (builtin_func->args.get_const(0)) {
                            case .Some(operand) => {
                                switch (operand->ty) {
                                    case .Some(ty) => {
                                        self->types.ensure_named(&ty);
                                        
                                        var type_name = self->types.type_name(&ty);
                                        var out = String.from_str(self->allocator, "__alignof__(");
                                        
                                        out.push_str(type_name.as_str_const());
                                        out.push(')');
                                        
                                        type_name.free();
                                        return out;
                                    }
                                    case .None => {}
                                }
                            }
                            else => {}
                        }

                        return String.from_str(self->allocator, "__alignof__(void)");
                    }

                    case .OffsetOf => {
                        self->needs_stddef_header = true;

                        switch (builtin_func->args.get_const(0)) {
                            case .Some(type_arg) => {
                                switch (builtin_func->args.get_const(1)) {
                                    case .Some(field_arg) => {
                                        switch (type_arg->ty) {
                                            case .Some(ty) => {
                                                self->types.ensure_named(&ty);
                                                
                                                var type_name = self->types.type_name(&ty);
                                                var out = String.from_str(self->allocator, "offsetof(");
                                                
                                                out.push_str(type_name.as_str_const());
                                                out.push(',');
                                                
                                                switch (field_arg->literal_const_string_value()) {
                                                    case .Some(name) => out.push_str(name);
                                                    case .None => out.push_str("0");
                                                }
                                                
                                                out.push(')');
                                                type_name.free();
                                                return out;
                                            }
                                            case .None => {}
                                        }
                                    }
                                    else => {}
                                }
                            }
                            else => {}
                        }

                        return String.from_str(self->allocator, "0");
                    }

                    case .Cast => {
                        switch (builtin_func->args.get_const(0)) {
                            case .Some(type_arg) => {
                                switch (builtin_func->args.get_const(1)) {
                                    case .Some(value_arg) => {
                                        switch (type_arg->ty) {
                                            case .Some(ty) => {
                                                var dest_128 = self->int128_kind_of(&ty);
                                                var src_128 = self->expr_int128_kind(value_arg);

                                                if (dest_128.is_some() || src_128.is_some()) {
                                                    self->types.ensure_named(&ty);

                                                    var cast_expr = self->emit_expr(value_arg);
                                                    var cast_out = String.new(self->allocator);

                                                    if (dest_128.is_some()) {
                                                        var coerce = self->coerce_to_int128(
                                                            value_arg,
                                                            cast_expr.as_str_const(), 
                                                            dest_128.unwrap()
                                                        );
                                                        cast_out.push_str(coerce.as_str_const());
                                                        coerce.free();
                                                    } else {
                                                        var dest_name = self->types.type_name(&ty);
                                                        cast_out.push_str("((");
                                                        cast_out.push_str(dest_name.as_str_const());
                                                        cast_out.push_str(")((uint64_t)(");
                                                        cast_out.push_str(cast_expr.as_str_const());
                                                        cast_out.push_str(").lo))");
                                                        dest_name.free();
                                                    }

                                                    cast_expr.free();
                                                    return cast_out;
                                                }

                                                var expr = self->emit_expr(value_arg);

                                                switch (value_arg->ty) {
                                                    case .Some(src_type) => {
                                                        switch (src_type.as_array_type()) {
                                                            case .Some(src_arr) => {
                                                                switch (src_arr.capacity) {
                                                                    case .Slice | .TerminatedSlice => {
                                                                        switch (*ty.const_inner()) {
                                                                            case .Pointer => {
                                                                                return self->coerce_value(expr, value_arg, &ty);
                                                                            }
                                                                            case .Array(dst_arr) => {
                                                                                switch (dst_arr.capacity) {
                                                                                    case .Slice | .TerminatedSlice => {
                                                                                        return expr;
                                                                                    }
                                                                                    case .Fixed => {}
                                                                                }
                                                                            }
                                                                            else => {}
                                                                        }
                                                                    }
                                                                    case .Fixed => {}
                                                                }
                                                            }
                                                            else => {}
                                                        }
                                                    }
                                                    case .None => {}
                                                }

                                                self->types.ensure_named(&ty);

                                                var type_name = self->types.type_name(&ty);
                                                var out = String.new(self->allocator);

                                                if (self->needs_signed_cast(&ty, value_arg)) {
                                                    out.push_str("((");
                                                    out.push_str(type_name.as_str_const());
                                                    out.push_str(")((");
                                                    
                                                    switch (value_arg->ty) {
                                                        case .Some(src_type) => {
                                                            switch (src_type.as_plain_type()) {
                                                                case .Some(plain) => {
                                                                    switch (signed_int_c_name(&plain)) {
                                                                        case .Some(name) => out.push_str(name);
                                                                        else => {}
                                                                    }
                                                                }
                                                                else => {}
                                                            }
                                                        }
                                                        else => {}
                                                    }
                                                    
                                                    out.push_str(")");
                                                    out.push_str(expr.as_str_const());
                                                    out.push_str("))");
                                                } else {
                                                    out.push_str("((");
                                                    out.push_str(type_name.as_str_const());
                                                    out.push_str(")");
                                                    out.push_str(expr.as_str_const());
                                                    out.push(')');
                                                }
                                                
                                                expr.free();
                                                type_name.free();
                                                return out;
                                            }
                                            case .None => {}
                                        }
                                    }
                                    else => {}
                                }
                            }
                            else => {}
                        }

                        return String.from_str(self->allocator, "((void)0)");
                    }

                    case .Assert => {
                        self->note_assert_use();

                        var out = String.from_str(self->allocator, "(((");

                        switch (builtin_func->args.get_const(0)) {
                            case .Some(cond) => {
                                var expr = self->emit_expr(cond);
                                out.push_str(expr.as_str_const());
                                expr.free();
                            }
                            else => out.push_str("1");
                        }

                        out.push_str(")?(void)0:__cyrus_fail_(\"panicked\",\"assertion failed: \",");
                        self->push_builtin_location(&out, builtin_func);
                        out.push(',');

                        switch (builtin_func->args.get_const(1)) {
                            case .Some(mesg) => {
                                switch (mesg->literal_const_string_value()) {
                                    case .Some(mesg) => {
                                        out.push('"');
                                        push_c_escaped(&out, mesg);
                                        out.push('"');
                                    }
                                    case .None => out.push_str("\"unknown\"");
                                }
                            }
                            case .None => out.push_str("\"unknown\"");
                        }

                        out.push_str(")))");
                        return out;
                    }

                    case .Panic => {
                        self->note_panic_use();

                        var out = String.from_str(self->allocator, "__cyrus_fail_(\"panicked\",\"\",");
                        self->push_builtin_location(&out, builtin_func);
                        out.push(',');
                        
                        switch (builtin_func->args.get_const(0)) {
                            case .Some(mesg) => {
                                switch (mesg->literal_const_string_value()) {
                                    case .Some(mesg) => {
                                        out.push('"');
                                        push_c_escaped(&out, mesg);
                                        out.push('"');
                                    }
                                    case .None => out.push_str("\"explicit panic\"");
                                }
                            }
                            case .None => out.push_str("\"explicit panic\"");
                        }

                        out.push(')');
                        return out;
                    }

                    case .Unreachable => {
                        self->note_panic_use();

                        var out = String.from_str(self->allocator, "__cyrus_fail_(\"entered unreachable code\",\"\",");
                        self->push_builtin_location(&out, builtin_func);
                        out.push(',');

                        switch (builtin_func->args.get_const(0)) {
                            case .Some(mesg) => {
                                switch (mesg->literal_const_string_value()) {
                                    case .Some(mesg) => {
                                        out.push('"');
                                        push_c_escaped(&out, mesg);
                                        out.push('"');
                                    }
                                    case .None => out.push_str("\"entered unreachable code\"");
                                }
                            }
                            case .None => out.push_str("\"entered unreachable code\"");
                        }

                        out.push(')');
                        return out;
                    }

                    case .Todo => {
                        self->note_panic_use();

                        var out = String.from_str(self->allocator, "__cyrus_fail_(\"hit TODO\",\"\",");
                        self->push_builtin_location(&out, builtin_func);
                        out.push(',');

                        switch (builtin_func->args.get_const(0)) {
                            case .Some(mesg) => {
                                switch (mesg->literal_const_string_value()) {
                                    case .Some(mesg) => {
                                        out.push('"');
                                        push_c_escaped(&out, mesg);
                                        out.push('"');
                                    }
                                    case .None => out.push_str("\"not yet implemented\"");
                                }
                            }
                            case .None => out.push_str("\"not yet implemented\"");
                        }

                        out.push(')');
                        return out;
                    }

                    case .Unimplemented => {
                        self->note_panic_use();

                        var out = String.from_str(self->allocator, "__cyrus_fail_(\"hit UNIMPLEMENTED code\",\"\",");
                        self->push_builtin_location(&out, builtin_func);
                        out.push(',');

                        switch (builtin_func->args.get_const(0)) {
                            case .Some(mesg) => {
                                switch (mesg->literal_const_string_value()) {
                                    case .Some(mesg) => {
                                        out.push('"');
                                        push_c_escaped(&out, mesg);
                                        out.push('"');
                                    }
                                    case .None => out.push_str("\"feature is not implemented\"");
                                }
                            }
                            case .None => out.push_str("\"feature is not implemented\"");
                        }

                        out.push(')');
                        return out;
                    }

                    case .PtrOffset | .PtrDiff => {
                        var left = self->emit_expr(builtin_func->args.get_const(0).unwrap());
                        var right = self->emit_expr(builtin_func->args.get_const(1).unwrap());
                        var out = String.from_str(self->allocator, "((");
                        out.push_str(left.as_str_const());

                        if (kind == .PtrDiff) {
                            out.push_str(")-(");
                        } else {
                            out.push_str(")+(");
                        }
                        
                        out.push_str(right.as_str_const());
                        out.push_str("))");

                        left.free();
                        right.free();
                        return out;
                    }

                    case .VolatileLoad | .VolatileStore => {
                        var ptr = self->emit_expr(builtin_func->args.get_const(0).unwrap());
                        var out = String.from_str(self->allocator, "(*(volatile __typeof__(*(");
                        out.push_str(ptr.as_str_const());
                        out.push_str("))*)(");
                        out.push_str(ptr.as_str_const());
                        out.push(')');

                        if (kind == .VolatileStore) {
                            var value = self->emit_expr(builtin_func->args.get_const(1).unwrap());
                            out.push_str("=(");
                            out.push_str(value.as_str_const());
                            out.push(')');
                            value.free();
                        }

                        out.push(')');
                        ptr.free();
                        return out;
                    }

                    case .Memcpy | .Memmove => {
                        var name: const uint8* = "memcpy(";
                        if (kind == .Memmove) {
                            self->ensure_memmove_proto();
                            name = "memmove(";
                        } else {
                            self->ensure_memcpy_proto();
                        }
                        var out = String.from_str(self->allocator, name);
                        
                        for (var i: usize = 0; i < builtin_func->args.len(); i += 1) {
                            const arg = builtin_func->args.get_const(i).unwrap();
                            
                            var expr = self->emit_expr(arg);
                            out.push_str(expr.as_str_const());
                            expr.free();
                            
                            if (i + 1 < builtin_func->args.len()) {
                                out.push(',');
                            }
                        }

                        out.push(')');
                        return out;
                    }

                    case .Memset => {
                        self->ensure_memset_proto();
                        
                        var out = String.from_str(self->allocator, "memset(");
                        
                        for (var i: usize = 0; i < builtin_func->args.len(); i += 1) {
                            const arg = builtin_func->args.get_const(i).unwrap();
                            
                            var expr = self->emit_expr(arg);
                            out.push_str(expr.as_str_const());
                            expr.free();
                            
                            if (i + 1 < builtin_func->args.len()) {
                                out.push(',');
                            }
                        }
                        
                        out.push(')');
                        return out;
                    }

                    case .BitCast
                    | .ReadUnaligned
                    | .WriteUnaligned => {
                        return self->emit_repr_builtin(builtin_func, kind);
                    }

                    case .PopCount
                    | .CountLeadingZeros
                    | .CountTrailingZeros
                    | .ByteSwap
                    | .BitReverse
                    | .RotateLeft
                    | .RotateRight
                    | .Abs
                    | .Min
                    | .Max
                    | .Copysign
                    | .PositiveDifference
                    | .DivCeil
                    | .DivFloor
                    | .DivTrunc
                    | .Mod
                    | .Rem
                    | .Ceil
                    | .Floor
                    | .Trunc
                    | .Round
                    | .RoundEven
                    | .Sqrt
                    | .Cbrt
                    | .Pow
                    | .Hypot
                    | .MulAdd
                    | .Sin
                    | .Cos
                    | .Tan
                    | .Asin
                    | .Acos
                    | .Atan
                    | .Atan2
                    | .Sinh
                    | .Cosh
                    | .Tanh
                    | .Asinh
                    | .Acosh
                    | .Atanh
                    | .Exp
                    | .Exp2
                    | .Expm1
                    | .Log
                    | .Log2
                    | .Log10
                    | .Log1p
                    | .Fmod
                    | .Remainder
                    | .Ldexp
                    | .Ilogb
                    | .Logb
                    | .Scalbn
                    | .NextAfter
                    | .NextUp
                    | .NextDown
                    | .Erf
                    | .Erfc
                    | .Gamma
                    | .IsNan
                    | .IsInf
                    | .IsFinite
                    | .IsNormal
                    | .Signbit => {
                        return self->emit_scalar_builtin(builtin_func, kind);
                    }

                    case .Infinity | .Nan => {
                        return self->emit_special_float_builtin(builtin_func, kind);
                    }

                    case .Breakpoint
                    | .FrameAddress
                    | .ReturnAddress
                    | .Trap => {
                        return self->emit_debug_builtin(builtin_func, kind);
                    }

                    case .FuncName => {
                        switch (self->cur_func_name) {
                            case .Some(name) => {
                                return self->quoted_cstr(name.as_str_const());
                            }
                            else => {}
                        }

                        return String.from_str(self->allocator, "\"<undefined>\"");
                    }

                    case .MethodName => {
                        switch (self->cur_method_name) {
                            case .Some(name) => {
                                return self->quoted_cstr(name.as_str_const());
                            }
                            else => {}
                        }

                        return String.from_str(self->allocator, "\"<undefined>\"");
                    }

                    case .ModuleName => {
                        switch (self->tree_for_source(builtin_func->span.source_id)) {
                            case .Some(tree) => {
                                return self->quoted_cstr(tree->module_name.as_str_const());
                            }
                            else => {}
                        }

                        return String.from_str(self->allocator, "\"\"");
                    }

                    case .FileName => {
                        switch (self->tree_for_source(builtin_func->span.source_id)) {
                            case .Some(tree) => {
                                return self->quoted_cstr(tree->file_name.as_str_const());
                            }
                            else => {}
                        }

                        return String.from_str(self->allocator, "\"\"");
                    }

                    case .Line => {
                        switch (self->builtin_line_column(builtin_func, false)) {
                            case .Some(value) => {
                                var out = String.new(self->allocator);
                                push_usize(&out, value);
                                return out;
                            }
                            else => {}
                        }

                        return String.from_str(self->allocator, "0");
                    }

                    case .Column => {
                        switch (self->builtin_line_column(builtin_func, true)) {
                            case .Some(value) => {
                                var out = String.new(self->allocator);
                                push_usize(&out, value);
                                return out;
                            }
                            else => {}
                        }

                        return String.from_str(self->allocator, "0");
                    }

                    else => return String.from_str(self->allocator, "((void)0)");

                }
            }
            else => {}
        }

        return String.from_str(self->allocator, "((void)0)");
    }

    fn emit_literal(self: Self*, literal: const cir::LiteralExpr*) String {
        switch (literal->kind) {
            case .Integer { value, .. } => {
                var literal_domain: Option<bool> = .None;

                switch (literal->ty) {
                    case .Some(ty) => {
                        literal_domain = self->int128_kind_of(&ty);
                    }
                    else => {}
                }

                if (literal_domain.is_some()) {
                    var v: uint128 = 0;

                    switch (value) {
                        case .Signed(x) => {
                            v = @cast(uint128, x);
                        }
                        case .Unsigned(x) => {
                            v = x;
                        }
                    }

                    var hi = v >> 64;
                    var lo = @cast(uint64, v);
                    var hi64 = @cast(uint64, hi);

                    var cout = String.new(self->allocator);

                    if (literal_domain.unwrap()) {
                        cout.push_str("((__cyrus_uint128){ ");
                    } else {
                        cout.push_str("((__cyrus_int128){ ");
                    }

                    push_uint128(&cout, @cast(uint128, lo));
                    cout.push_str("ULL, ");

                    if (!literal_domain.unwrap()) {
                        cout.push_str("(int64_t)");
                    }

                    push_uint128(&cout, @cast(uint128, hi64));
                    cout.push_str("ULL })");
                    return cout;
                }

                var out = String.new(self->allocator);
                
                const c_int_max: uint128 = 2147483647;
                const int64_min_mag: uint128 = 9223372036854775808;
                var magnitude: uint128 = 0;
                var is_negative = false;

                switch (value) {
                    case .Signed(x) => {
                        if (x < 0) {
                            is_negative = true;
                            magnitude = @cast(uint128, -(x + 1)) + 1;

                            if (magnitude == int64_min_mag) {
                                out.push_str("(-9223372036854775807LL-1)");
                            } else {
                                out.push_str("(-");
                                push_uint128(&out, magnitude);
                                out.push(')');
                            }
                        } else {
                            magnitude = @cast(uint128, x);
                            push_uint128(&out, magnitude);
                        }
                    }
                    case .Unsigned(x) => {
                        magnitude = x;
                        push_uint128(&out, x);
                    }
                }

                switch (literal->ty) {
                    case .Some(ty) => {
                        switch (*ty.const_inner()) {
                            case .Plain(plain) => {
                                const need_type_cast = magnitude > c_int_max || is_64bit_int_plain(&plain);
                                
                                if (need_type_cast) {
                                    switch (int_literal_c_type_name(&plain)) {
                                        case .Some(ctype) => {
                                            if (!is_negative && magnitude > c_int_max) {
                                                out.push_str("ULL");
                                            }
                                            var casted = String.new(self->allocator);
                                            casted.push_str("((");
                                            casted.push_str(ctype);
                                            casted.push(')');
                                            casted.push_str(out.as_str_const());
                                            casted.push(')');
                                            out.free();
                                            out = casted;
                                        }
                                        else => {}
                                    }
                                }
                            }
                            else => {}
                        }
                    }
                    else => {}
                }

                return out;
            }

            case .Float { value, .. } => {
                var str = String.new(self->allocator);
                var writer: Writer = dynamic StringWriter.new(&str);

                format_float64_precise(writer, value);

                if (!str_contains_char(str.as_str_const(), '.') &&
                    !str_contains_char(str.as_str_const(), 'e') &&
                    !str_contains_char(str.as_str_const(), 'n'))
                {
                    str.push_str(".0");
                }

                if (str.len() > 0 && str.as_str_const()[0] == '-') {
                    var wrapped = String.from_str(self->allocator, "(");
                    wrapped.push_str(str.as_str_const());
                    wrapped.push(')');
                    str.free();
                    return wrapped;
                }

                return str;
            }

            case .String { value, .. } => {
                var is_array = false;
                var is_slice = false;
                var is_mut_ptr = false;

                switch (literal->ty) {
                    case .Some(ty) => {
                        switch (*ty.const_inner()) {
                            case .Array(array) => {
                                switch (array.capacity) {
                                    case .Slice | .TerminatedSlice => is_slice = true;
                                    case .Fixed => is_array = true;
                                }
                            }
                            case .Pointer(inner) => {
                                switch (*inner) {
                                    case .Const => {}
                                    else => is_mut_ptr = true;
                                }
                            }
                            else => {}
                        }
                    }
                    else => {}
                }

                var out = String.new(self->allocator);

                if (is_slice) {
                    self->types.ensure_slice();
                    out.push_str("((__slice){.ptr=(void*)(\"");
                    push_c_escaped(&out, value.as_str_const());
                    out.push_str("\"),.len=");
                    push_usize(&out, value.len());
                    out.push_str("})");
                    return out;
                }
                
                if (!is_array) {
                    if (is_mut_ptr) {
                        out.push_str("((uint8_t*)");
                    } else {
                        out.push_str("((const uint8_t*)");
                    }
                }
                
                out.push('"');
                push_c_escaped(&out, value.as_str_const());
                out.push('"');
                
                if (!is_array) {
                    out.push(')');
                }
                
                return out;
            }

            case .Char(c) => {
                var out = String.new(self->allocator);
                out.push('\'');
                push_c_char(&out, c);
                out.push('\'');
                return out;
            }

            case .Bool(x) => {
                self->types.used_bool = true;

                if (x) {
                    return String.from_str(self->allocator, "true");
                } else {
                    return String.from_str(self->allocator, "false");
                }
            }

            case .Null => {
                self->needs_stddef_header = true;
                return String.from_str(self->allocator, "NULL");
            }
        }
    }

    /* ************* Defer ************* */

    fn push_defer(self: Self*, defer_stmt: cir::DeferStmt) {
        if (self->defer_scopes.len() == 0) {
            var scope: Vec<cir::DeferStmt> = Vec.new(self->allocator);
            scope.push(defer_stmt);
            self->defer_scopes.push(scope);
            return;
        }

        switch (self->defer_scopes.last()) {
            case .Some(scope) => scope->push(defer_stmt);
            else => {}
        }
    }

    fn pop_defer_scope(self: Self*) {
        switch (self->defer_scopes.last()) {
            case .Some(scope) => {
                for (var i: usize = scope->len(); i > 0; i -= 1) {
                    const stmt = scope->get_const(i - 1).unwrap();
                    self->emit_defer_stmt(stmt);
                }
            }
            else => {}
        }

        if (self->defer_scopes.len() > 0) {
            var stmt = self->defer_scopes.pop();
            stmt.free();
        }
    }

    fn has_active_defers(self: const Self*) bool {
        for (var s: usize = 0; s < self->defer_scopes.len(); s += 1) {
            switch (self->defer_scopes.get_const(s)) {
                case .Some(scope) => {
                    if (scope->len() > 0) {
                        return true;
                    }
                }
                else => {}
            }
        }

        return false;
    }

    fn find_conditional_defer(self: const Self*) Option<const cir::DeferStmt*> {
        for (var s: usize = self->defer_scopes.len(); s > 0; s -= 1) {
            switch (self->defer_scopes.get_const(s - 1)) {
                case .Some(scope) => {
                    for (var i: usize = scope->len(); i > 0; i -= 1) {
                        const stmt = scope->get_const(i - 1).unwrap();
                        switch (stmt->kind) {
                            case .OnError | .OnSuccess => return .Some(stmt);
                            case .Always => {}
                        }
                    }
                }
                else => {}
            }
        }
        return .None;
    }

    fn emit_all_defers(self: Self*) {
        for (var s: usize = self->defer_scopes.len(); s > 0; s -= 1) {
            switch (self->defer_scopes.get_const(s - 1)) {
                case .Some(scope) => {
                    for (var i: usize = scope->len(); i > 0; i -= 1) {
                        const stmt = scope->get_const(i - 1).unwrap();
                        self->emit_defer_stmt(stmt);
                    }
                }
                else => {}
            }
        }
    }

    fn emit_all_defers_on_error(self: Self*, err_expr: const uint8*) {
        for (var s: usize = self->defer_scopes.len(); s > 0; s -= 1) {
            switch (self->defer_scopes.get_const(s - 1)) {
                case .Some(scope) => {
                    for (var i: usize = scope->len(); i > 0; i -= 1) {
                        const stmt = scope->get_const(i - 1).unwrap();
                        switch (stmt->kind) {
                            case .Always => {
                                self->emit_stmt(stmt->operand);
                            }
                            case .OnError => {
                                switch (stmt->error_binding) {
                                    case .Some(var_decl_id) => {
                                        switch (stmt->error_type) {
                                            case .Some(err_type) => {
                                                self->body_out.push('{');
                                                self->emit_error_binding_decl(
                                                    &self->body_out,
                                                    var_decl_id,
                                                    &err_type,
                                                    err_expr
                                                );
                                                self->emit_stmt(stmt->operand);
                                                self->body_out.push('}');
                                            }
                                            case .None => {
                                                self->emit_stmt(stmt->operand);
                                            }
                                        }
                                    }
                                    case .None => {
                                        self->emit_stmt(stmt->operand);
                                    }
                                }
                            }
                            case .OnSuccess => {}
                        }
                    }
                }
                else => {}
            }
        }
    }

    fn emit_all_defers_for_return(self: Self*, ret_var_name: const uint8*) {
        switch (self->find_conditional_defer()) {
            case .None => {
                self->emit_all_defers();
                return;
            }
            case .Some(cond_defer) => {
                switch (cond_defer->return_control_flow_type) case .Some(cf_type) else {
                    self->emit_all_defers();
                    return;
                }

                const temp_id = self->tuple_export_id;
                self->tuple_export_id += 1;

                var cf_var = String.from_str(self->allocator, "__cyrus_ret_cf_");
                push_usize(&cf_var, temp_id);

                var cf_decl = self->types.build_decl(&cf_type, cf_var.as_str_const());
                var branch_call = self->emit_try_dispatch_branch_call_on_var(
                    &cond_defer->return_branch_dispatch,
                    ret_var_name
                );

                self->body_out.push_str(cf_decl.as_str_const());
                self->body_out.push('=');
                self->body_out.push_str(branch_call.as_str_const());
                self->body_out.push(';');

                cf_decl.free();
                branch_call.free();

                var err_field = self->enum_tuple_payload_base(cf_var.as_str_const(), 1, 0);

                for (var s: usize = self->defer_scopes.len(); s > 0; s -= 1) {
                    switch (self->defer_scopes.get_const(s - 1)) {
                        case .Some(scope) => {
                            for (var i: usize = scope->len(); i > 0; i -= 1) {
                                const stmt = scope->get_const(i - 1).unwrap();
                                switch (stmt->kind) {
                                    case .Always => {
                                        self->emit_stmt(stmt->operand);
                                    }
                                    case .OnError => {
                                        self->body_out.push_str("if(");
                                        self->body_out.push_str(cf_var.as_str_const());
                                        self->body_out.push_str(".tag==1){");
                                        switch (stmt->error_binding) {
                                            case .Some(var_decl_id) => {
                                                switch (stmt->error_type) {
                                                    case .Some(err_type) => {
                                                        self->emit_error_binding_decl(
                                                            &self->body_out,
                                                            var_decl_id,
                                                            &err_type,
                                                            err_field.as_str_const()
                                                        );
                                                    }
                                                    case .None => {}
                                                }
                                            }
                                            case .None => {}
                                        }
                                        self->emit_stmt(stmt->operand);
                                        self->body_out.push('}');
                                    }
                                    case .OnSuccess => {
                                        self->body_out.push_str("if(");
                                        self->body_out.push_str(cf_var.as_str_const());
                                        self->body_out.push_str(".tag==0){");
                                        self->emit_stmt(stmt->operand);
                                        self->body_out.push('}');
                                    }
                                }
                            }
                        }
                        else => {}
                    }
                }

                err_field.free();
                cf_var.free();
            }
        }
    }

    fn emit_defers_to_loop_mark(self: Self*) {
        switch (self->loop_marks.last_const()) {
            case .Some(mark) => {
                for (var s: usize = self->defer_scopes.len(); s > *mark; s -= 1) {
                    switch (self->defer_scopes.get_const(s - 1)) {
                        case .Some(scope) => {
                            for (var i: usize = scope->len(); i > 0; i -= 1) {
                                const stmt = scope->get_const(i - 1).unwrap();
                                self->emit_defer_stmt(stmt);
                            }
                        }
                        else => {}
                    }
                }
            }
            else => {}
        }
    }

    fn emit_defer_stmt(self: Self*, defer_stmt: const cir::DeferStmt*) {
        switch (defer_stmt->kind) {
            case .Always => self->emit_stmt(defer_stmt->operand);
            case .OnError | .OnSuccess => {}
        }
    }

    /* ************* Types Helpers ************* */

    fn type_name_of(self: Self*, ty: const cir::SemaType*) String {
        self->types.ensure_named(ty);
        return self->types.type_name(ty);
    }

    fn tuple_field_name(self: Self*, index: usize) String {
        var out = String.from_str(self->allocator, "f");
        push_usize(&out, index);
        return out;
    }
    
    /* ************* Methods Helpers ************* */

    fn interface_method_ret_type(
        self: Self*,
        interface_decl_id: cir::InterfaceDeclId,
        index: usize,
        call_type_args: const cir::TypeArgs*
    ) String {
        switch (self->tables->interfaces.get_const(interface_decl_id)) {
            case .Some(interface_) => {
                switch (interface_->methods.entries.get_const(index)) {
                    case .Some(entry) => {
                        switch (self->tables->methods.get_const(entry->id)) {
                            case .Some(method) => {
                                var ret_type = method->func_decl.ret_type;

                                if (interface_->is_generic() && !call_type_args->is_empty()) {
                                    ret_type = cir::substitute_sema_type_with_type_args(
                                        dynamic self->arena,
                                        &ret_type,
                                        &interface_->generic_params,
                                        call_type_args
                                    );
                                }

                                self->types.ensure_named(&ret_type);
                                return self->types.type_name(&ret_type);
                            }
                            else => {}
                        }
                    }
                    else => {}
                }
            }
            else => {}
        }

        return String.from_str(self->allocator, "void");
    }

    /* ************* LIBC Helpers ************* */

    fn ensure_memcmp_proto(self: Self*) {
        if (self->needs_memcmp_proto) {
            return;
        }

        self->needs_memcmp_proto = true;
        self->needs_stddef_header = true;
        self->libc_protos.push_str("int memcmp(const void*s1,const void*s2,size_t n);");
    }

    fn builtin_arg_text(
        self: Self*,
        builtin_func: const cir::BuiltinFunc*,
        index: usize
    ) String {
        const arg = builtin_func->args.get_const(index).unwrap();
        return self->emit_expr(arg);
    }

    fn builtin_arg_type(
        self: Self*,
        builtin_func: const cir::BuiltinFunc*,
        index: usize
    ) cir::SemaType {
        const arg = builtin_func->args.get_const(index).unwrap();

        switch (arg->ty) {
            case .Some(ty) => return ty;
            case .None => return .Placeholder;
        }
    }

    fn emit_math_expr(
        self: Self*,
        name: const uint8*,
        builtin_func: const cir::BuiltinFunc*,
        ret_name: const uint8*,
        arg_count: usize
    ) String {
        self->needs_math_header = true;

        var out = String.new(self->allocator);
        out.push_str("((");
        out.push_str(ret_name);
        out.push(')');
        out.push_str(name);
        out.push('(');

        for (var i: usize = 0; i < arg_count; i += 1) {
            var arg = self->builtin_arg_text(builtin_func, i);

            out.push_str("(double)(");
            out.push_str(arg.as_str_const());
            out.push(')');
            arg.free();

            if (i + 1 < arg_count) {
                out.push(',');
            }
        }

        out.push_str("))");
        return out;
    }

    fn emit_math_scale_expr(
        self: Self*,
        name: const uint8*,
        builtin_func: const cir::BuiltinFunc*,
        ret_name: const uint8*
    ) String {
        self->needs_math_header = true;

        var value = self->builtin_arg_text(builtin_func, 0);
        var scale = self->builtin_arg_text(builtin_func, 1);

        var out = String.new(self->allocator);
        out.push_str("((");
        out.push_str(ret_name);
        out.push(')');
        out.push_str(name);
        out.push_str("((double)(");
        out.push_str(value.as_str_const());
        out.push_str("),(int)(");
        out.push_str(scale.as_str_const());
        out.push_str(")))");

        value.free();
        scale.free();
        return out;
    }

    fn emit_scalar_builtin(
        self: Self*,
        builtin_func: const cir::BuiltinFunc*,
        kind: cir::BuiltinKind
    ) String {
        var ret_type: cir::SemaType = .Placeholder;

        switch (builtin_func->ret_type) {
            case .Some(ty) => ret_type = ty;
            case .None => {}
        }

        var ret_name = self->type_name_of(&ret_type);
        var first_type = self->builtin_arg_type(builtin_func, 0);
        var out = String.new(self->allocator);

        switch (kind) {
            case .PopCount | .CountLeadingZeros | .CountTrailingZeros => {
                var value = self->builtin_arg_text(builtin_func, 0);
                var width: usize = 0;
                var id = self->builtin_temp_id;
                self->builtin_temp_id += 1;

                switch (cir::builtin_integer_bit_width(&first_type)) {
                    case .Some(bits) => width = bits;
                    case .None => {}
                }

                switch (kind) {
                    case .PopCount => {
                        out.push_str("((int32_t)__builtin_popcountll((unsigned long long)(");
                        out.push_str(value.as_str_const());
                        out.push_str(")))");
                    }
                    case .CountLeadingZeros => {
                        self->types.used_stdint = true;
                        out.push_str("({ uint64_t __cyrus_cv");
                        push_usize(&out, id);
                        out.push_str("=(uint64_t)(");
                        out.push_str(value.as_str_const());
                        out.push_str("); int32_t __cyrus_cr");
                        push_usize(&out, id);
                        out.push_str("=((__cyrus_cv");
                        push_usize(&out, id);
                        out.push_str(")==0 ? ");
                        push_usize(&out, width);
                        out.push_str(" : (int32_t)(__builtin_clzll(__cyrus_cv");
                        push_usize(&out, id);
                        out.push_str(") - ");
                        push_usize(&out, 64 - width);
                        out.push_str(")); __cyrus_cr");
                        push_usize(&out, id);
                        out.push_str("; })");
                    }
                    case .CountTrailingZeros => {
                        self->types.used_stdint = true;
                        out.push_str("({ uint64_t __cyrus_tv");
                        push_usize(&out, id);
                        out.push_str("=(uint64_t)(");
                        out.push_str(value.as_str_const());
                        out.push_str("); int32_t __cyrus_tr");
                        push_usize(&out, id);
                        out.push_str("=((__cyrus_tv");
                        push_usize(&out, id);
                        out.push_str(")==0 ? ");
                        push_usize(&out, width);
                        out.push_str(" : (int32_t)__builtin_ctzll(__cyrus_tv");
                        push_usize(&out, id);
                        out.push_str(")); __cyrus_tr");
                        push_usize(&out, id);
                        out.push_str("; })");
                    }
                    else => {}
                }

                value.free();
            }

            case .ByteSwap | .BitReverse => {
                var value = self->builtin_arg_text(builtin_func, 0);
                var width: usize = 0;

                switch (cir::builtin_integer_bit_width(&first_type)) {
                    case .Some(bits) => width = bits;
                    case .None => {}
                }

                self->needs_bitop_helpers = true;

                out.push_str("((");
                out.push_str(ret_name.as_str_const());
                out.push(')');

                switch (kind) {
                    case .ByteSwap => {
                        out.push_str("(__cyrus_bswap64_((uint64_t)(");
                    }
                    case .BitReverse => {
                        out.push_str("(__cyrus_bitrev64_((uint64_t)(");
                    }
                    else => {}
                }

                out.push_str(value.as_str_const());
                out.push_str(")) >> ");
                push_usize(&out, 64 - width);
                out.push_str("))");
                value.free();
            }

            case .RotateLeft | .RotateRight => {
                var value = self->builtin_arg_text(builtin_func, 0);
                var count = self->builtin_arg_text(builtin_func, 1);
                var width: usize = 0;
                var id = self->builtin_temp_id;
                self->builtin_temp_id += 1;

                switch (cir::builtin_integer_bit_width(&first_type)) {
                    case .Some(bits) => width = bits;
                    case .None => {}
                }

                self->types.used_stdint = true;
                out.push_str("({ uint64_t __cyrus_rv");
                push_usize(&out, id);
                out.push_str("=(uint64_t)(");
                out.push_str(value.as_str_const());
                out.push_str("); unsigned __cyrus_rk");
                push_usize(&out, id);
                out.push_str("=(unsigned)((");
                out.push_str(count.as_str_const());
                out.push_str(") % ");
                push_usize(&out, width);
                out.push_str("); (");
                out.push_str(ret_name.as_str_const());
                out.push_str(")(");

                if (kind == .RotateLeft) {
                    out.push_str("(__cyrus_rv");
                    push_usize(&out, id);
                    out.push_str(" << __cyrus_rk");
                    push_usize(&out, id);
                    out.push_str(") | (__cyrus_rv");
                    push_usize(&out, id);
                    out.push_str(" >> ((");
                    push_usize(&out, width);
                    out.push_str(" - __cyrus_rk");
                    push_usize(&out, id);
                    out.push_str(") % ");
                    push_usize(&out, width);
                    out.push_str("))");
                } else {
                    out.push_str("(__cyrus_rv");
                    push_usize(&out, id);
                    out.push_str(" >> __cyrus_rk");
                    push_usize(&out, id);
                    out.push_str(") | (__cyrus_rv");
                    push_usize(&out, id);
                    out.push_str(" << ((");
                    push_usize(&out, width);
                    out.push_str(" - __cyrus_rk");
                    push_usize(&out, id);
                    out.push_str(") % ");
                    push_usize(&out, width);
                    out.push_str("))");
                }

                out.push_str("); })");
                value.free();
                count.free();
            }

            case .Abs => {
                if (first_type.const_inner()->is_float()) {
                    out = self->emit_math_expr("fabs", builtin_func, ret_name.as_str_const(), 1);
                } else {
                    var value = self->builtin_arg_text(builtin_func, 0);
                    out.push_str("((");
                    out.push_str(ret_name.as_str_const());
                    out.push_str(")(((");
                    out.push_str(value.as_str_const());
                    out.push_str(") < 0) ? -(");
                    out.push_str(value.as_str_const());
                    out.push_str(") : (");
                    out.push_str(value.as_str_const());
                    out.push_str(")))");
                    value.free();
                }
            }

            case .Min | .Max => {
                if (first_type.const_inner()->is_float()) {
                    var name: const uint8* = "fmin";

                    if (kind == .Max) {
                        name = "fmax";
                    }

                    out = self->emit_math_expr(name, builtin_func, ret_name.as_str_const(), 2);
                } else {
                    var left = self->builtin_arg_text(builtin_func, 0);
                    var right = self->builtin_arg_text(builtin_func, 1);

                    out.push_str("((");
                    out.push_str(ret_name.as_str_const());
                    out.push_str(")(((");
                    out.push_str(left.as_str_const());
                    out.push(')');

                    if (kind == .Min) {
                        out.push_str(" < (");
                    } else {
                        out.push_str(" > (");
                    }

                    out.push_str(right.as_str_const());
                    out.push_str(")) ? (");
                    out.push_str(left.as_str_const());
                    out.push_str(") : (");
                    out.push_str(right.as_str_const());
                    out.push_str(")))");

                    left.free();
                    right.free();
                }
            }

            case .PositiveDifference => {
                var left = self->builtin_arg_text(builtin_func, 0);
                var right = self->builtin_arg_text(builtin_func, 1);

                out.push_str("((");
                out.push_str(ret_name.as_str_const());
                out.push_str(")(((");
                out.push_str(left.as_str_const());
                out.push_str(") > (");
                out.push_str(right.as_str_const());
                out.push_str(")) ? ((");
                out.push_str(left.as_str_const());
                out.push_str(") - (");
                out.push_str(right.as_str_const());
                out.push_str(")) : ((((");
                out.push_str(left.as_str_const());
                out.push_str(") != (");
                out.push_str(left.as_str_const());
                out.push_str(")) || ((");
                out.push_str(right.as_str_const());
                out.push_str(") != (");
                out.push_str(right.as_str_const());
                out.push_str("))) ? ((");
                out.push_str(left.as_str_const());
                out.push_str(") - (");
                out.push_str(right.as_str_const());
                out.push_str(")) : 0.0)))");

                left.free();
                right.free();
            }

            case .DivCeil | .DivFloor | .DivTrunc | .Mod | .Rem => {
                var left = self->builtin_arg_text(builtin_func, 0);
                var right = self->builtin_arg_text(builtin_func, 1);

                out.push_str("((");
                out.push_str(ret_name.as_str_const());
                out.push_str(")(");

                switch (kind) {
                    case .DivTrunc => {
                        out.push_str("(");
                        out.push_str(left.as_str_const());
                        out.push_str(") / (");
                        out.push_str(right.as_str_const());
                        out.push(')');
                    }
                    case .DivCeil => {
                        out.push_str("((");
                        out.push_str(left.as_str_const());
                        out.push_str(") / (");
                        out.push_str(right.as_str_const());
                        out.push_str(") + ((((");
                        out.push_str(left.as_str_const());
                        out.push_str(") % (");
                        out.push_str(right.as_str_const());
                        out.push_str(")) != 0 && (((");
                        out.push_str(left.as_str_const());
                        out.push_str(") < 0) == ((");
                        out.push_str(right.as_str_const());
                        out.push_str(") < 0))) ? 1 : 0))");
                    }
                    case .DivFloor => {
                        out.push_str("((");
                        out.push_str(left.as_str_const());
                        out.push_str(") / (");
                        out.push_str(right.as_str_const());
                        out.push_str(") - ((((");
                        out.push_str(left.as_str_const());
                        out.push_str(") % (");
                        out.push_str(right.as_str_const());
                        out.push_str(")) != 0 && (((");
                        out.push_str(left.as_str_const());
                        out.push_str(") < 0) != ((");
                        out.push_str(right.as_str_const());
                        out.push_str(") < 0))) ? 1 : 0))");
                    }
                    case .Mod => {
                        out.push_str("(((");
                        out.push_str(left.as_str_const());
                        out.push_str(") % (");
                        out.push_str(right.as_str_const());
                        out.push_str(")) + (");
                        out.push_str(right.as_str_const());
                        out.push_str(")) % (");
                        out.push_str(right.as_str_const());
                        out.push(')');
                    }
                    case .Rem => {
                        out.push_str("(");
                        out.push_str(left.as_str_const());
                        out.push_str(") % (");
                        out.push_str(right.as_str_const());
                        out.push(')');
                    }
                    else => {}
                }

                out.push_str("))");
                left.free();
                right.free();
            }

            case .Ilogb => {
                var value = self->builtin_arg_text(builtin_func, 0);
                self->needs_math_header = true;
                out.push_str("((int32_t)ilogb((double)(");
                out.push_str(value.as_str_const());
                out.push_str(")))");
                value.free();
            }

            case .Ldexp => {
                out = self->emit_math_scale_expr(
                    "ldexp", builtin_func, ret_name.as_str_const()
                );
            }
            case .Scalbn => {
                out = self->emit_math_scale_expr(
                    "scalbn", builtin_func, ret_name.as_str_const()
                );
            }

            case .NextUp | .NextDown => {
                var value = self->builtin_arg_text(builtin_func, 0);
                self->needs_math_header = true;
                out.push_str("((");
                out.push_str(ret_name.as_str_const());
                out.push_str(")nextafter((double)(");
                out.push_str(value.as_str_const());

                if (kind == .NextUp) {
                    out.push_str("),INFINITY))");
                } else {
                    out.push_str("),(-INFINITY)))");
                }

                value.free();
            }

            case .IsNan | .IsInf | .IsFinite | .IsNormal | .Signbit => {
                var value = self->builtin_arg_text(builtin_func, 0);
                var name: const uint8* = "isnan";

                switch (kind) {
                    case .IsNan => {
                        name = "isnan";
                    }
                    case .IsInf => {
                        name = "isinf";
                    }
                    case .IsFinite => {
                        name = "isfinite";
                    }
                    case .IsNormal => {
                        name = "isnormal";
                    }
                    case .Signbit => {
                        name = "signbit";
                    }
                    else => {}
                }

                self->needs_math_header = true;
                out.push_str("((bool)(");
                out.push_str(name);
                out.push_str("((double)(");
                out.push_str(value.as_str_const());
                out.push_str(")) != 0))");
                value.free();
            }

            else => {
                switch (cir::builtin_math_c_name(kind)) {
                    case .Some(name) => {
                        var count: usize = 1;

                        switch (kind) {
                            case .Pow
                            | .Hypot
                            | .Atan2
                            | .Fmod
                            | .Remainder
                            | .Copysign
                            | .NextAfter => count = 2;
                            case .MulAdd => count = 3;
                            else => {}
                        }

                        out = self->emit_math_expr(
                            name, builtin_func, ret_name.as_str_const(), count
                        );
                    }
                    case .None => {}
                }
            }
        }

        ret_name.free();
        return out;
    }

    fn emit_repr_builtin(
        self: Self*,
        builtin_func: const cir::BuiltinFunc*,
        kind: cir::BuiltinKind
    ) String {
        var ret_type: cir::SemaType = .Placeholder;

        switch (builtin_func->ret_type) {
            case .Some(ty) => ret_type = ty;
            case .None => {}
        }

        var ret_name = self->type_name_of(&ret_type);
        var out = String.new(self->allocator);
        var id = self->builtin_temp_id;
        self->builtin_temp_id += 1;

        switch (kind) {
            case .BitCast => {
                var value_type = self->builtin_arg_type(builtin_func, 1);
                var value_name = self->type_name_of(&value_type);
                var value = self->builtin_arg_text(builtin_func, 1);

                out.push_str("({ union { ");
                out.push_str(ret_name.as_str_const());
                out.push_str(" __cyrus_bt");
                push_usize(&out, id);
                out.push(';');
                out.push_str(value_name.as_str_const());
                out.push_str(" __cyrus_bv");
                push_usize(&out, id);
                out.push_str("; } __cyrus_bu");
                push_usize(&out, id);
                out.push_str("; __cyrus_bu");
                push_usize(&out, id);
                out.push_str(".__cyrus_bv");
                push_usize(&out, id);
                out.push_str(" = (");
                out.push_str(value.as_str_const());
                out.push_str("); __cyrus_bu");
                push_usize(&out, id);
                out.push_str(".__cyrus_bt");
                push_usize(&out, id);
                out.push_str("; })");

                value.free();
                value_name.free();
            }

            case .ReadUnaligned => {
                var pointer = self->builtin_arg_text(builtin_func, 1);
                self->ensure_memcpy_proto();

                out.push_str("({ ");
                out.push_str(ret_name.as_str_const());
                out.push_str(" __cyrus_ul");
                push_usize(&out, id);
                out.push_str("; memcpy(&__cyrus_ul");
                push_usize(&out, id);
                out.push_str(",(void*)(");
                out.push_str(pointer.as_str_const());
                out.push_str("),sizeof(__cyrus_ul");
                push_usize(&out, id);
                out.push_str(")); __cyrus_ul");
                push_usize(&out, id);
                out.push_str("; })");

                pointer.free();
            }

            case .WriteUnaligned => {
                var pointer = self->builtin_arg_text(builtin_func, 1);
                var value = self->builtin_arg_text(builtin_func, 2);
                var target_type = self->builtin_arg_type(builtin_func, 0);
                var target_name = self->type_name_of(&target_type);
                self->ensure_memcpy_proto();

                out.push_str("({ ");
                out.push_str(target_name.as_str_const());
                out.push_str(" __cyrus_uv");
                push_usize(&out, id);
                out.push_str(" = (");
                out.push_str(value.as_str_const());
                out.push_str("); memcpy((void*)(");
                out.push_str(pointer.as_str_const());
                out.push_str("),&__cyrus_uv");
                push_usize(&out, id);
                out.push_str(",sizeof(__cyrus_uv");
                push_usize(&out, id);
                out.push_str(")); (void)0; })");

                pointer.free();
                value.free();
                target_name.free();
            }

            else => {}
        }

        ret_name.free();
        return out;
    }

    fn emit_special_float_builtin(
        self: Self*,
        builtin_func: const cir::BuiltinFunc*,
        kind: cir::BuiltinKind
    ) String {
        var ret_type: cir::SemaType = .Placeholder;

        switch (builtin_func->ret_type) {
            case .Some(ty) => ret_type = ty;
            case .None => {}
        }

        var ret_name = self->type_name_of(&ret_type);
        var out = String.new(self->allocator);
        self->needs_math_header = true;

        out.push_str("((");
        out.push_str(ret_name.as_str_const());
        out.push(')');

        switch (kind) {
            case .Infinity => {
                out.push_str("INFINITY");
            }
            case .Nan => {
                out.push_str("NAN");
            }
            else => {}
        }

        out.push(')');
        ret_name.free();
        return out;
    }

    fn emit_debug_builtin(
        self: Self*,
        builtin_func: const cir::BuiltinFunc*,
        kind: cir::BuiltinKind
    ) String {
        var out = String.new(self->allocator);

        switch (kind) {
            case .Breakpoint => {
                out.push_str("({ __asm__ __volatile__(\"int3\"); (void)0; })");
            }
            case .Trap => {
                self->libc_protos.push_str("void abort(void);");
                out.push_str("abort()");
            }
            case .FrameAddress => {
                self->types.used_stdint = true;
                out.push_str("((uintptr_t)__builtin_frame_address(0))");
            }
            case .ReturnAddress => {
                self->types.used_stdint = true;
                out.push_str("((uintptr_t)__builtin_return_address(0))");
            }
            else => {}
        }

        return out;
    }

    fn ensure_memmove_proto(self: Self*) {
        if (!self->needs_memmove_proto) {
            self->needs_memmove_proto = true;
            self->needs_stddef_header = true;
            self->libc_protos.push_str("void*memmove(void*dest,const void*src,size_t n);");
        }
    }

    fn ensure_memcpy_proto(self: Self*) {
        if (self->needs_memcpy_proto) {
            return;
        }

        self->needs_memcpy_proto = true;
        self->needs_stddef_header = true;
        self->libc_protos.push_str("void*memcpy(void*dest,const void*src,size_t n);");
    }

    fn ensure_memset_proto(self: Self*) {
        if (self->needs_memset_proto) {
            return;
        }

        self->needs_memset_proto = true;
        self->needs_stddef_header = true;
        self->libc_protos.push_str("void*memset(void*s,int c,size_t n);");
    }

    fn ensure_strcmp_proto(self: Self*) {
        if (self->needs_strcmp_proto) {
            return;
        }

        self->needs_strcmp_proto = true;
        self->libc_protos.push_str("int strcmp(const char*s1,const char*s2);");
    }

    // GNU LIBC exposes `errno` as a thread-local object. 
    //
    // TCC emits a GOT data relocation for plain `extern int errno;` 
    // which the dynamic linker leaves as NULL 
    // for TLS symbols, so every access must
    // go through __errno_location() 
    // instead.
    fn ensure_errno_location_proto(self: Self*) {
        if (self->needs_errno_location_proto) {
            return;
        }

        self->needs_errno_location_proto = true;
        self->libc_protos.push_str("int*__errno_location(void);");
    }

    fn note_panic_use(self: Self*) {
        self->needs_panic_helper = true;
    }

    fn note_assert_use(self: Self*) {
        self->needs_assert_helper = true;
    }

    /* ************* Free ************* */

    pub fn free(self: Self*) {
        self->types.free();
        self->protos_out.free();
        self->global_out.free();
        self->pending_out.free();
        self->lambda_defs.free();
        self->body_out.free();
        self->ctor_out.free();
        self->libc_protos.free();

        for (var i: usize = 0; i < self->defer_scopes.len(); i += 1) {
            self->defer_scopes.get(i).unwrap()->free();
        }

        self->defer_scopes.free();
        self->loop_marks.free();
        self->vtable_emitted.free();
        self->func_proto_emitted.free();
        self->test_cases.free();

        for (var i: usize = 0; i < self->generic_object_names.len(); i += 1) {
            self->generic_object_names.get(i).unwrap()->free();
        }

        self->generic_object_names.free();

        self->switch_binding_names.free();

        for (var i: usize = 0; i < self->switch_binding_owned.len(); i += 1) {
            self->switch_binding_owned.get(i).unwrap()->free();
        }

        self->switch_binding_owned.free();

        for (var i: usize = 0; i < self->fn_scope_names.len(); i += 1) {
            self->fn_scope_names.get(i).unwrap()->free();
        }

        self->fn_scope_names.free();
        self->fn_var_renames.free();

        for (var i: usize = 0; i < self->fn_renames_owned.len(); i += 1) {
            self->fn_renames_owned.get(i).unwrap()->free();
        }

        self->fn_renames_owned.free();

        for (var i: usize = 0; i < self->fn_ctx_owned.len(); i += 1) {
            self->fn_ctx_owned.get(i).unwrap()->free();
        }

        self->fn_ctx_owned.free();
        self->label_depth_ids.free();
        self->label_depths.free();
        self->arena.destroy();
    }
}

/* ************* Helpers ************* */

fn is_c_lvalue(expr: const cir::Expr*) bool {
    switch (expr->kind) {
        case .Symbol 
        | .Deref 
        | .ArrayIndex => return true;

        case .FieldAccess(field_access) => {
            if (field_access.is_thin_arrow) {
                return true;
            }
            
            return is_c_lvalue(field_access.operand);
        }

        case .TupleAccess(tuple_access) => {
            return is_c_lvalue(tuple_access.operand);
        }
        
        else => return false;
    }
}

fn is_compound_literal_expr(expr: const cir::Expr*) bool {
    switch (expr->kind) {
        case .StructInit
           | .EnumInit
           | .UnionInit
           | .UnnamedStructValue
           | .UnnamedUnionValue
           | .UnnamedEnumValue => return true;

        else => return false;
    }
}

fn is_64bit_int_plain(plain: const cir::PlainType*) bool {
    switch (*plain) {
        case .Int64 | .UInt64 | .ISize | .USize | .IntPtr | .UIntPtr => return true;
        else => return false;
    }
}

fn int_literal_c_type_name(plain: const cir::PlainType*) Option<const uint8*> {
    switch (*plain) {
        case .USize | .UIntPtr => return .Some("uintptr_t");
        case .ISize | .IntPtr => return .Some("intptr_t");
        case .UInt64 => return .Some("uint64_t");
        case .UInt32 => return .Some("uint32_t");
        case .UInt16 => return .Some("uint16_t");
        case .Int32 => return .Some("int32_t");
        case .Int64 => return .Some("int64_t");
        case .UInt8 => return .Some("uint8_t");
        case .Int16 => return .Some("int16_t");
        case .Int8 => return .Some("int8_t");
        else => return .None;
    }
}

fn push_asm_escaped(out: String*, raw: const uint8*) {
    var i: usize = 0;

    while (raw[i] != '\0') {
        const ch = raw[i];

        if (ch == '\n') {
            out->push('\\');
            out->push('n');
        } else if (ch == '\t') {
            out->push('\\');
            out->push('t');
        } else if (ch == '"') {
            out->push('\\');
            out->push('"');
        } else if (ch == '\\') {
            out->push('\\');
            out->push('\\');
        } else {
            out->push(ch);
        }

        i += 1;
    }
}

fn resolve_var_type(var_: const cir::VarStmt*) Option<cir::SemaType> {
    switch (var_->ty) {
        case .Some(ty) => return .Some(ty);
        else => {}
    }

    switch (var_->rhs) {
        case .Some(rhs) => {
            switch (rhs.ty) {
                case .Some(ty) => return .Some(ty);
                else => {}
            }
        }
        else => {}
    }

    return .None;
}

fn signed_int_c_name(plain: const cir::PlainType*) Option<const uint8*> {
    switch (*plain) {
        case .Int8 | .UInt8 => return .Some("int8_t");
        case .Int16 | .UInt16 => return .Some("int16_t");
        case .Int32 | .UInt32 => return .Some("int32_t");
        case .Int64 | .UInt64 => return .Some("int64_t");
        else => return .None;
    }
}

/// True when the raw null-terminated template line
/// already ends in a newline character.
fn asm_raw_ends_with_newline(raw: const uint8*) bool {
    var len: usize = 0;

    while (raw[len] != '\0') {
        len += 1;
    }

    if (len == 0) {
        return false;
    }

    return raw[len - 1] == '\n';
}

[[inline]]
fn push_usize(out: String*, value: usize) {
    format_usize(dynamic StringWriter.new(out), value);
}

fn push_uint32(out: String*, value: uint32) {
    format_uint32(dynamic StringWriter.new(out), value);
}

fn push_uint128(out: String*, value: uint128) {
    format_uint128(dynamic StringWriter.new(out), value);
}

fn push_int128(out: String*, value: int128) {
    format_int128(dynamic StringWriter.new(out), value);
}

/* ************* Debug Helpers ************* */

fn panic_unlowered(
    emitter: Emitter*, 
    expr: const cir::Expr*, 
    kind_name: const uint8*
) {
    var mesg = String.from_str(emitter->allocator, "unlowered expr ");
    mesg.push_str(kind_name);

    if (emitter->sctx != null) {
        const source = emitter->sctx->get(expr->span.source_id);

        if (source != null) {
            mesg.push_str(" at ");
            mesg.push_str(source->path.as_str_const());
            mesg.push(':');

            switch (source->nearest_line(expr->span.loc.start)) {
                case .Some(line) => push_usize(&mesg, line);
                else => mesg.push_str("?");
            }
        }
    }

    @panic(mesg.as_str_const());
}
