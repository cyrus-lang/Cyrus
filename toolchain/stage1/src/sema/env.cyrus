import std::mem{Allocator, alloc_init};
import std::collections{Vec};
import std::string{String};
import std::option{Option};

import .::infer{InferContext};
import cir;

pub struct FuncEnv {
    allocator: Allocator,
    pub current_func_name: Option<String>,
    pub current_object: Option<cir::SemaType>,
    pub current_method: Option<cir::MethodDeclId>,
    pub current_func: Option<cir::FuncType>,
    pub infer: Option<InferContext*>,

    pub fn new(allocator: Allocator) Self {
        return Self {
            allocator,
            current_func_name: .None,
            current_object: .None,
            current_method: .None,
            current_func: .None,
            infer: .None,
        };
    }

    pub fn with_infer(allocator: Allocator, name: const uint8*) Self {
        const infer: InferContext* = alloc_init(allocator, InferContext.new(allocator));

        var env = Self {
            allocator,
            current_func_name: .None,
            current_object: .None,
            current_method: .None,
            current_func: .None,
            infer: .Some(infer),
        };

        env.current_func_name = .Some(String.from_str(allocator, name));
        return env;
    }

    pub fn with_object_infer(allocator: Allocator, object_type: cir::SemaType) Self {
        const infer: InferContext* = alloc_init(allocator, InferContext.new(allocator));

        var env = Self {
            allocator,
            current_func_name: .None,
            current_object: .None,
            current_method: .None,
            current_func: .None,
            infer: .Some(infer),
        };

        env.current_object = .Some(object_type);
        return env;
    }

    pub fn free(self: Self*) {
        switch (self->current_func_name) {
            case .Some(name) => name.free();
            else => {}
        }

        switch (self->infer) {
            case .Some(infer) => {
                infer->free();
                self->allocator.free(infer);
            }
            else => {}
        }
    }
}

pub struct GenericEnv {
    allocator: Allocator,
    pub params: cir::GenericParams,
    bindings: Vec<Option<cir::SemaType>>,

    pub fn new(allocator: Allocator, params: cir::GenericParams) Self {
        var bindings: Vec<Option<cir::SemaType>> = Vec.with_capacity(allocator, params.len());

        for (var i: usize = 0; i < params.len(); i += 1) {
            bindings.push(.None);
        }

        return Self {
            allocator,
            params,
            bindings,
        };
    }

    pub fn from_type_args(
        allocator: Allocator,
        params: cir::GenericParams,
        type_args: const cir::TypeArgs*
    ) Self {
        var env = GenericEnv.new(allocator, params);

        for (var i: usize = 0; i < env.params.len() && i < type_args->len(); i += 1) {
            const arg = type_args->get(i).unwrap();
            
            switch (*arg) {
                case .Type(ty, _) => {
                    const param_id = env.params.ids.get_owned(i).unwrap();
                    env.bind(param_id, ty);
                }
                else => {}
            }
        }

        return env;
    }

    pub fn merge(self: const Self*, other: const GenericEnv*) Self {
        var params = cir::GenericParams.new(self->allocator);

        params.ids = Vec.with_capacity(self->allocator, self->params.len() + other->params.len());

        for (var i: usize = 0; i < self->params.len(); i += 1) {
            const param_id = self->params.ids.get_owned(i).unwrap();
            params.ids.push(param_id);
        }

        for (var i: usize = 0; i < other->params.len(); i += 1) {
            const param_id = other->params.ids.get_owned(i).unwrap();
            params.ids.push(param_id);
        }

        var bindings: Vec<Option<cir::SemaType>> 
            = Vec.with_capacity(self->allocator, self->bindings.len() + other->bindings.len());
        
        for (var i: usize = 0; i < self->bindings.len(); i += 1) {
            const ty = self->bindings.get_const(i).unwrap();
            bindings.push(*ty);
        }

        for (var i: usize = 0; i < other->bindings.len(); i += 1) {
            const ty = other->bindings.get_const(i).unwrap();
            bindings.push(*ty);
        }

        return Self {
            allocator: self->allocator,
            params,
            bindings,
        };
    }

    pub fn bind(self: Self*, generic_param_id: cir::GenericParamId, ty: cir::SemaType) bool {
        const slot = self->slot(generic_param_id);

        switch (slot) {
            case .Some(index) => {
                const existing = self->bindings.get_const(index).unwrap();

                switch (*existing) {
                    case .Some(old_type) => {
                        return cir::cir_types_eq(&old_type, &ty);
                    }
                    case .None => {
                        const binding = self->bindings.get(index).unwrap();
                        *binding = .Some(ty);
                        return true;
                    }
                }
            }
            else => {}
        }

        return false;
    }

    pub fn lookup(self: const Self*, generic_param_id: cir::GenericParamId) Option<cir::SemaType> {
        const slot = self->slot(generic_param_id);

        switch (slot) {
            case .Some(idx) => {
                const b = self->bindings.get_const(idx).unwrap();
                return *b;
            }
            else => {}
        }

        return .None;
    }

    pub fn substitute_sema_type(self: const Self*, ty: const cir::SemaType*) cir::SemaType {
        switch (*ty) {
            case .GenericParam(id) => {
                const bound = self->lookup(id);

                switch (bound) {
                    case .Some(bound_ty) => return bound_ty;
                    case .None => return *ty;
                }
            }

            case .Named(named_type) => {
                var type_args = cir::TypeArgs.new(self->allocator);

                for (var i: usize = 0; i < named_type.type_args.len(); i += 1) {
                    const arg = named_type.type_args.get(i).unwrap();

                    switch (*arg) {
                        case .Type(inner, span) => {
                            const subst = self->substitute_sema_type(&inner);
                            type_args.push(.Type(subst, span));
                        }
                        case .Infer => {
                            type_args.push(.Infer);
                        }
                    }
                }

                return .Named(cir::NamedType {
                    type_decl_id: named_type.type_decl_id,
                    type_args,
                });
            }

            case .Array(array_type) => {
                const element_type = self->substitute_sema_type(array_type.element_type);

                return .Array(cir::ArrayType {
                    element_type: alloc_init(self->allocator, element_type),
                    capacity: array_type.capacity,
                    span: array_type.span,
                });
            }

            case .Const(inner) => {
                const subst = self->substitute_sema_type(inner);
                return .Const(alloc_init(self->allocator, subst));
            }

            case .Pointer(inner) => {
                const subst = self->substitute_sema_type(inner);
                return .Pointer(alloc_init(self->allocator, subst));
            }

            case .Tuple(tuple_type) => {
                var elements: Vec<cir::TupleElement> =
                    Vec.with_capacity(self->allocator, tuple_type.elements.len());

                for (var i: usize = 0; i < tuple_type.elements.len(); i += 1) {
                    const element = tuple_type.elements.get_const(i).unwrap();
                    const subst = self->substitute_sema_type(&element->ty);
                    
                    elements.push(cir::TupleElement {
                        ty: subst,
                        span: element->span,
                    });
                }

                return .Tuple(cir::TupleType {
                    elements,
                    span: tuple_type.span,
                });
            }

            case .FuncType(func_type) => {
                var params = cir::FuncTypeParams {
                    list: Vec.with_capacity(self->allocator, func_type.params.list.len()),
                    variadic: .None,
                };

                for (var i: usize = 0; i < func_type.params.list.len(); i += 1) {
                    const param = func_type.params.list.get_const(i).unwrap();
                    const subst = self->substitute_sema_type(param);
                    params.list.push(subst);
                }

                switch (func_type.params.variadic) {
                    case .Some(variadic) => {
                        switch (*variadic) {
                            case .UntypedCStyle => {
                                params.variadic = .Some(alloc_init(
                                    self->allocator,
                                    cir::FuncTypeVariadicParam.UntypedCStyle
                                ));
                            }
                            case .Typed(inner) => {
                                const subst = self->substitute_sema_type(&inner);
                                
                                params.variadic = .Some(alloc_init(
                                    self->allocator,
                                    cir::FuncTypeVariadicParam.Typed(subst)
                                ));
                            }
                        }
                    }
                    else => {}
                }

                const ret_type = self->substitute_sema_type(func_type.ret_type);

                return .FuncType(cir::FuncType {
                    params,
                    ret_type: alloc_init(self->allocator, ret_type),
                    vis: func_type.vis,
                    callconv: func_type.callconv,
                    span: func_type.span,
                });
            }

            case .InterfaceObject(interface_object) => {
                const concrete_type = self->substitute_sema_type(interface_object.concrete_type);

                return .InterfaceObject(cir::InterfaceObjectType {
                    interface_type: interface_object.interface_type,
                    concrete_type: alloc_init(self->allocator, concrete_type),
                    vtable_id: interface_object.vtable_id,
                    span: interface_object.span,
                });
            }

            else => return *ty;
        }
    }

    fn slot(self: const Self*, generic_param_id: cir::GenericParamId) Option<usize> {
        for (var i: usize = 0; i < self->params.len(); i += 1) {
            const param_id = self->params.ids.get_owned(i).unwrap();
            
            if (param_id == generic_param_id) {
                return .Some(i);
            }
        }

        return .None;
    }

    pub fn free(self: Self*) {
        self->bindings.free();
    }
}