import std::collections::hash_map{HashMap};
import std::hash{hash_usize, eq_usize};
import std::collections{Vec};
import std::mem{Allocator};
import std::option{Option};
import std::string{String};

import cir{type_args_eq};
import tokens{Span};
import cir::clone;
import cir;

/// A single deferred generic specialization.
pub struct MonomorphInstance {
    pub template_id: MonomorphTemplateId,
    pub type_args: cir::TypeArgs,
    pub params: cir::FuncParams,
    pub ret_type: cir::SemaType,
    pub body: Option<cir::BodyId>,
    pub template_body: Option<cir::BodyId>,
    pub generic_params: cir::GenericParams,
    pub self_type: Option<cir::SemaType>,
    pub analyzed: bool,
}

pub enum MonomorphTemplateId {
    Func(cir::FuncDeclId),
    Method(cir::MethodDeclId),
}

fn template_key(template_id: MonomorphTemplateId) usize {
    switch (template_id) {
        case .Func(id) => return (id << 1) | 0;
        case .Method(id) => return (id << 1) | 1;
    }
}

pub struct MonomorphRegistry {
    pub allocator: Allocator,
    pub instances: Vec<MonomorphInstance>,
    buckets: HashMap<usize, Vec<cir::MonomorphId>>,

    pub fn new(allocator: Allocator) Self {
        return Self {
            allocator,
            instances: Vec.new(allocator),
            buckets: HashMap.with_hasher(allocator, 64, hash_usize, eq_usize),
        };
    }

    fn find(
        self: const Self*,
        template_id: MonomorphTemplateId,
        type_args: const cir::TypeArgs*
    ) Option<cir::MonomorphId> {
        switch (self->buckets.get_const(template_key(template_id))) {
            case .None => return .None;
            case .Some(bucket) => {
                for (var i: usize = 0; i < bucket->len(); i += 1) {
                    const id = *bucket->get_const(i).unwrap();
                    const inst = self->instances.get_const(id).unwrap();

                    if (type_args_eq(&inst->type_args, type_args)) {
                        return .Some(id);
                    }
                }
            }
        }

        return .None;
    }

    /// Records a monomorphization request and 
    /// returns its globally deduplicated id.
    /// 
    /// The body is NOT specialized here.
    pub fn request(
        self: Self*,
        arena: Allocator,
        template_id: MonomorphTemplateId,
        type_args: const cir::TypeArgs*,
        params: const cir::FuncParams*,
        ret_type: cir::SemaType,
        template_body: Option<cir::BodyId>,
        generic_params: const cir::GenericParams*,
        self_type: Option<cir::SemaType>
    ) cir::MonomorphId {
        switch (self->find(template_id, type_args)) {
            case .Some(existing) => return existing;
            case .None => {}
        }

        var generic_ids: Vec<cir::GenericParamId> = Vec.with_capacity(
            arena,
            generic_params->len()
        );

        for (var i: usize = 0; i < generic_params->len(); i += 1) {
            generic_ids.push(*generic_params->ids.get_const(i).unwrap());
        }

        const monomorph_id = self->instances.len();
        self->instances.push(MonomorphInstance {
            template_id,
            type_args: clone::clone_typed_type_args(arena, type_args),
            params: clone::clone_func_params(arena, params),
            ret_type,
            body: .None,
            template_body,
            generic_params: cir::GenericParams { ids: generic_ids },
            self_type,
            analyzed: false,
        });

        const key = template_key(template_id);

        switch (self->buckets.get(key)) {
            case .Some(bucket) => {
                bucket->push(monomorph_id);
            }
            case .None => {
                var bucket: Vec<cir::MonomorphId> = Vec.new(self->allocator);
                bucket.push(monomorph_id);
                self->buckets.insert(key, bucket);
            }
        }

        return monomorph_id;
    }

    pub fn is_pending(self: Self*, monomorph_id: cir::MonomorphId) bool {
        switch (self->instances.get_const(monomorph_id)) case .Some(entry) else {
            return false;
        }

        return !entry->analyzed;
    }

    pub fn mark_analyzed(self: Self*, monomorph_id: cir::MonomorphId) {
        switch (self->instances.get(monomorph_id)) case .Some(var entry) else {
            return;
        }

        entry->analyzed = true;
    }

    pub fn get(self: Self*, monomorph_id: cir::MonomorphId) const MonomorphInstance* {
        switch (self->instances.get_const(monomorph_id)) case .Some(entry) else {
            return null;
        }

        return entry;
    }

    pub fn is_analyzed(self: Self*, monomorph_id: cir::MonomorphId) bool {
        switch (self->instances.get_const(monomorph_id)) case .Some(entry) else {
            return false;
        }

        return entry->analyzed;
    }

    pub fn set_body_and_params(
        self: Self*,
        monomorph_id: cir::MonomorphId,
        body: cir::BodyId,
        params: cir::FuncParams
    ) {
        switch (self->instances.get(monomorph_id)) case .Some(var entry) else {
            return;
        }

        entry->body = .Some(body);
        entry->params = params;
    }

    pub fn free(self: Self*) {
        var bucket_iter = self->buckets.iter_owned();

        while (true) {
            switch (bucket_iter.next_owned()) {
                case .Some(entry) => {
                    var bucket = entry.1;
                    bucket.free();
                }
                case .None => break;
            }
        }

        self->buckets.free();

        for (var i: usize = 0; i < self->instances.len(); i += 1) {
            const inst = self->instances.get(i).unwrap();
            inst->type_args.free();
            inst->params.list.free();
            inst->generic_params.ids.free();
        }
        
        self->instances.free();
    }
}

/// Records a generic instantiation key 
/// together with its use-site span.
pub struct InstanceSite {
    pub key: String,
    pub span: Span,
}