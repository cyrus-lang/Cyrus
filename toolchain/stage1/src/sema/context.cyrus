import std::collections::hash_map{HashMap};
import std::hash{hash_usize, eq_usize};
import std::mem{Allocator, alloc_init};
import std::mem::arena{ArenaAllocator};
import std::collections{Vec};
import std::string{String};
import std::option{Option};

import .::monomorph{MonomorphRegistry, InstanceSite};
import resolver::symbols{GlobalSymbolRegistry};
import .::vtables{VTableRegistry};
import diags{DiagContext};
import tokens{Span};
import cir::tables;
import sema::infer;
import .::flow;
import .::env;
import cir;

const ANALYZER_ARENA_INITIAL_SIZE: usize = 65536;
const SCRATCH_ARENA_INITIAL_SIZE: usize = 16384;
const TYPE_CACHE_INITIAL_SIZE: usize = 64;

pub struct AnalyzerContext {
    pub allocator: Allocator,
    pub arena: ArenaAllocator,
    pub scratch_arena: ArenaAllocator,
    pub dctx: DiagContext*,
    pub registry: GlobalSymbolRegistry*,
    pub decl_tables: tables::DeclTables*,
    pub trees: Vec<cir::ProgramTree>,
    pub func_env: env::FuncEnv,
    pub type_cache: TypeCache,
    pub typedef_stack: Vec<usize>,
    pub generic_env_stack: Vec<env::GenericEnv*>,
    pub reported_typedef_cycles: Vec<String>,
    pub reported_const_cycles: Vec<cir::GlobalVarDeclId>,
    pub control_region_stack: Vec<flow::ControlRegion>,
    pub instantiations: Vec<InstanceSite>,
    pub monomorph_registry: MonomorphRegistry,
    pub vtable_registry: VTableRegistry,
    pub dispatcher: AnalyzerDispatcher,

    pub fn new(
        allocator: Allocator,
        dctx: DiagContext*,
        registry: GlobalSymbolRegistry*,
        decl_tables: tables::DeclTables*,
        trees: Vec<cir::ProgramTree>,
        dispatcher: AnalyzerDispatcher
    ) Self {
        const scratch_arena = ArenaAllocator.new(allocator, SCRATCH_ARENA_INITIAL_SIZE);
        const reported_const_cycles: Vec<cir::GlobalVarDeclId> = Vec.new(allocator);
        const control_region_stack: Vec<flow::ControlRegion> = Vec.new(allocator);
        const arena = ArenaAllocator.new(allocator, ANALYZER_ARENA_INITIAL_SIZE);
        const generic_env_stack: Vec<env::GenericEnv*> = Vec.new(allocator);
        const reported_typedef_cycles: Vec<String> = Vec.new(allocator);
        const instantiations: Vec<InstanceSite> = Vec.new(allocator);
        const monomorph_registry = MonomorphRegistry.new(allocator);
        const vtable_registry = VTableRegistry.new(allocator);
        const typedef_stack: Vec<usize> = Vec.new(allocator);
        const func_env = env::FuncEnv.new(allocator);
        const type_cache = TypeCache.new(allocator);

        return Self {
            allocator,
            arena,
            scratch_arena,
            dctx,
            registry,
            decl_tables,
            trees,
            func_env,
            typedef_stack,
            instantiations,
            type_cache,
            generic_env_stack,
            control_region_stack,
            reported_typedef_cycles,
            reported_const_cycles,
            vtable_registry,
            monomorph_registry,
            dispatcher,
        };
    }

    pub fn free(self: Self*) {
        for (var i: usize = 0; i < self->generic_env_stack.len(); i += 1) {
            const env = *self->generic_env_stack.get(i).unwrap();
            env->free();
        }

        self->generic_env_stack.free();

        for (var i: usize = 0; i < self->instantiations.len(); i += 1) {
            const record = self->instantiations.get(i).unwrap();
            record->key.free();
        }

        self->instantiations.free();

        for (var i: usize = 0; i < self->reported_typedef_cycles.len(); i += 1) {
            var key = self->reported_typedef_cycles.get(i).unwrap();
            key->free();
        }

        self->reported_typedef_cycles.free();
        self->reported_const_cycles.free();
        self->typedef_stack.free();
        self->control_region_stack.free();
        self->type_cache.free();
        self->monomorph_registry.free();
        self->vtable_registry.free();
        self->func_env.free();
        self->scratch_arena.destroy();
        self->arena.destroy();
    }
}

pub struct AnalyzerDispatcher {
    pub adopt_const_matched_type_args_fn: fn(
        void*, 
        infer::InferContext*, 
        const cir::SemaType*, 
        const cir::SemaType*, 
        const cir::GenericParams*, 
        const Span*
    ) void,

    pub create_inference_generic_env_fn: fn(
        void*, 
        const uint8*, 
        const cir::GenericParams*, 
        const cir::TypeArgs*, 
        const Span*, 
        Option<env::GenericEnv>*
    ) void,

    pub normalize_and_check_type_formation_fn: fn(
        void*, 
        const cir::SemaType*, 
        const Span*, 
        uint8, Option<cir::SemaType>*
    ) void,

    pub analyze_expr_fn: fn(
        void*, 
        cir::Expr*, 
        const Option<cir::SemaType>*, 
        Option<cir::SemaType>*
    ) void,

    pub analyze_func_body_fn: fn(
        void*, 
        cir::BlockStmt*, 
        const cir::SemaType*
    ) void,

    pub analyze_block_stmt_fn: fn(
        void*,
        cir::BlockStmt*
    ) flow::FlowState,
    
    pub check_type_arity_fn: fn(
        void*, 
        const cir::SemaType*, 
        const Span*
    ) bool,

    pub fn analyze_block_stmt(
        self: const Self*,
        context: AnalyzerContext*,
        block: cir::BlockStmt*
    ) flow::FlowState {
        return (self->analyze_block_stmt_fn)(@cast(void*, context), block);
    }

    pub fn adopt_const_matched_type_args(
        self: const Self*,
        context: AnalyzerContext*,
        infer_context: infer::InferContext*,
        operand: const cir::SemaType*,
        expect: const cir::SemaType*,
        generic_params: cir::GenericParams,
        span: Span
    ) {
        (self->adopt_const_matched_type_args_fn)(
            @cast(void*, context), 
            infer_context, 
            operand, 
            expect, 
            &generic_params, 
            &span
        );
    }

    pub fn analyze_expr(
        self: const Self*,
        context: AnalyzerContext*,
        expr: cir::Expr*,
        expected_type: Option<cir::SemaType>
    ) Option<cir::SemaType> {
        var result: Option<cir::SemaType>;

        (self->analyze_expr_fn)(
            @cast(void*, context), 
            expr, 
            &expected_type, 
            &result
        );
        
        return result;
    }

    pub fn analyze_func_body(
        self: const Self*,
        context: AnalyzerContext*,
        body: cir::BlockStmt*,
        ret_type: const cir::SemaType*
    ) {
        (self->analyze_func_body_fn)(
            @cast(void*, context), 
            body, 
            ret_type
        );
    }

    pub fn check_type_arity(
        self: const Self*,
        context: AnalyzerContext*,
        ty: cir::SemaType,
        span: Span
    ) bool {
        return (self->check_type_arity_fn)(
            @cast(void*, context), 
            &ty, 
            &span
        );
    }

    pub fn create_inference_generic_env(
        self: const Self*,
        context: AnalyzerContext*,
        type_name: const uint8*,
        params: cir::GenericParams,
        type_args: const cir::TypeArgs*,
        span: Span
    ) Option<env::GenericEnv> {
        var result: Option<env::GenericEnv>;
        
        (self->create_inference_generic_env_fn)(
            @cast(void*, context), 
            type_name, 
            &params, 
            type_args, 
            &span, 
            &result
        );
        
        return result;
    }

    pub fn normalize_and_check_type_formation(
        self: const Self*,
        context: AnalyzerContext*,
        ty: cir::SemaType,
        span: Span,
        indirection: uint8
    ) Option<cir::SemaType> {
        var result: Option<cir::SemaType>;

        (self->normalize_and_check_type_formation_fn)(
            @cast(void*, context), 
            &ty, 
            &span, 
            indirection, 
            &result
        );
        
        return result;
    }
}

pub enum TypeCacheState {
    Resolving,
    Resolved(cir::SemaType),
}

pub struct TypeCacheFrame {
    pub key: usize,
    pub indirection: uint8,
}

pub enum TypeCacheEnterResult {
    Entered,
    AlreadyResolving(uint8),
}

/// Caches type resolutions and detects cyclic type definitions.
/// (Any indirection makes the cycle legal)
pub struct TypeCache {
    allocator: Allocator,
    states: HashMap<usize, TypeCacheState>,
    stack: Vec<TypeCacheFrame>,

    pub fn new(allocator: Allocator) Self {
        var states: HashMap<usize, TypeCacheState> = HashMap.with_hasher(
            allocator,
            TYPE_CACHE_INITIAL_SIZE,
            hash_usize,
            eq_usize
        );

        return Self {
            allocator,
            states,
            stack: Vec.new(allocator),
        };
    }

    pub fn get(self: const Self*, key: usize) Option<cir::SemaType> {
        const state = self->states.get_const(key);

        switch (state) {
            case .Some(entry) => {
                switch (*entry) {
                    case .Resolved(ty) => return .Some(ty);
                    else => {}
                }
            }
            else => {}
        }

        return .None;
    }

    pub fn enter(self: Self*, key: usize, indirection: uint8) TypeCacheEnterResult {
        for (var i: usize = 0; i < self->stack.len(); i += 1) {
            const frame = self->stack.get_const(i).unwrap();

            if (frame->key == key) {
                return .AlreadyResolving(frame->indirection);
            }
        }

        self->states.insert(key, .Resolving);
        self->stack.push(TypeCacheFrame { key, indirection });
        return .Entered;
    }

    pub fn leave(self: Self*, key: usize, ty: cir::SemaType) {
        self->stack.pop();
        self->states.insert(key, .Resolved(ty));
    }

    pub fn free(self: Self*) {
        self->states.free();
        self->stack.free();
    }
}
