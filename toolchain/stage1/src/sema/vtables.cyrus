import std::collections::hash_map{HashMap};
import std::hash{hash_usize, eq_usize};
import std::collections{Vec};
import std::mem{Allocator};
import std::option{Option};

import cir{cir_types_eq, type_args_eq};
import tokens{Span};
import cir::clone;
import cir;

/* ************* VTables ************* */

pub struct VTableInfo {
    pub monomorphized_methods: Vec<Option<cir::MonomorphId>>,
    pub interface_decl_id: cir::InterfaceDeclId,
    pub interface_type_args: cir::TypeArgs,
    pub method_decls: cir::MethodDecls,
    pub concrete_type: cir::SemaType,
    pub is_interface_generic: bool,
    pub vtable_id: cir::VTableId,
    pub span: Span,

    pub fn free(self: Self*) {
        self->interface_type_args.free();
        
        for (var i: usize = 0; i < self->method_decls.entries.len(); i += 1) {
            const entry = self->method_decls.entries.get(i).unwrap();
            entry->name.free();
        }

        self->method_decls.entries.free();
        self->monomorphized_methods.free();
    }
}

pub struct VTableRegistry {
    pub allocator: Allocator,
    pub tables: Vec<VTableInfo>,
    buckets: HashMap<usize, Vec<cir::VTableId>>,

    pub fn new(allocator: Allocator) Self {
        return Self {
            allocator,
            tables: Vec.new(allocator),
            buckets: HashMap.with_hasher(allocator, 32, hash_usize, eq_usize),
        };
    }

    pub fn get_or_create_vtable(
        self: Self*,
        arena: Allocator,
        sema_type: const cir::SemaType*,
        interface_decl_id: cir::InterfaceDeclId,
        interface_type_args: const cir::TypeArgs*,
        methods: const cir::MethodDecls*,
        is_interface_generic: bool,
        span: Span
    ) cir::VTableId {
        switch (self->buckets.get_const(interface_decl_id)) {
            case .Some(bucket) => {
                for (var i: usize = 0; i < bucket->len(); i += 1) {
                    const id = *bucket->get_const(i).unwrap();
                    const existing = self->tables.get_const(id).unwrap();

                    if (existing->interface_decl_id == interface_decl_id 
                        && cir_types_eq(&existing->concrete_type, sema_type) 
                        && type_args_eq(&existing->interface_type_args, interface_type_args)) {
                        return id;
                    }
                }
            }
            case .None => {}
        }

        const vtable_id = self->tables.len();

        var monomorphized_methods: Vec<Option<cir::MonomorphId>> = Vec.with_capacity(
            self->allocator,
            methods->entries.len()
        );
            
        // Placeholder
        for (var i: usize = 0; i < methods->entries.len(); i += 1) {
            monomorphized_methods.push(.None);
        }

        self->tables.push(VTableInfo {
            concrete_type: *sema_type,
            interface_decl_id,
            is_interface_generic,
            interface_type_args: clone::clone_typed_type_args(arena, interface_type_args),
            method_decls: clone::clone_method_decls(arena, methods),
            vtable_id,
            monomorphized_methods,
            span,
        });

        switch (self->buckets.get(interface_decl_id)) {
            case .Some(bucket) => {
                bucket->push(vtable_id);
            }
            case .None => {
                var bucket: Vec<cir::VTableId> = Vec.new(self->allocator);
                bucket.push(vtable_id);
                self->buckets.insert(interface_decl_id, bucket);
            }
        }

        return vtable_id;
    }

    pub fn set_monomorphized_method(
        self: Self*,
        vtable_id: cir::VTableId,
        index: usize,
        monomorph_id: cir::MonomorphId
    ) {
        const info = self->tables.get(vtable_id);

        switch (info) {
            case .Some(entry) => {
                if (index < entry->monomorphized_methods.len()) {
                    entry->monomorphized_methods.set(index, .Some(monomorph_id));
                }
            }
            else => {}
        }
    }

    pub fn free(self: Self*) {
        var bucket_iter = self->buckets.iter_owned();

        while (true) {
            switch (bucket_iter.next_owned()) {
                case .Some(entry) => {
                    var bucket = entry.1;
                    bucket.free();
                }
                case .None => break;
            }
        }

        self->buckets.free();

        for (var i: usize = 0; i < self->tables.len(); i += 1) {
            const entry = self->tables.get(i).unwrap();
            entry->free();
        }

        self->tables.free();
    }
}

