pub struct Builder {
    raw: core::LLVMBuilderRef,
    is_disposed: bool,
    context_raw: core::LLVMContextRef,
    context_disposed: const bool*,

    pub fn new(
        raw: core::LLVMBuilderRef,
        context_raw: core::LLVMContextRef,
        context_disposed: const bool*
    ) Self {
        return Self {
            raw,
            is_disposed: false,
            context_raw,
            context_disposed,
        };
    }

    pub fn dispose(
        self: Self*
    ) {
        if (self->is_disposed || self->raw == null) {
            return;
        }

        core::LLVMDisposeBuilder(
            self->raw
        );

        self->raw = null;
        self->is_disposed = true;
    }

    fn assert_alive(
        self: const Self*
    ) {
        assert_context(
            self->context_disposed
        );

        @assert(
            !self->is_disposed && self->raw != null,
            "kara: Builder used after dispose"
        );
    }

    fn assert_ready_for_insert(
        self: const Self*
    ) {
        self->assert_alive();

        const basic_block = core::LLVMGetInsertBlock(
            self->raw
        );

        @assert(
            basic_block != null,
            "kara: Builder has no insertion block set"
        );

        @assert(
            core::LLVMGetBasicBlockTerminator(basic_block) == null,
            "kara: cannot insert instruction after terminator"
        );
    }

    pub fn position_at_end(
        self: const Self*,
        block: BasicBlock
    ) {
        self->assert_alive();

        core::LLVMPositionBuilderAtEnd(
            self->raw,
            block.as_raw()
        );
    }

    pub fn position_before(
        self: const Self*,
        inst: InstructionValue
    ) {
        self->assert_alive();

        core::LLVMPositionBuilderBefore(
            self->raw,
            inst.as_raw()
        );
    }

    pub fn get_insert_block(
        self: const Self*
    ) Option<BasicBlock> {
        self->assert_alive();

        const basic_block = core::LLVMGetInsertBlock(
            self->raw
        );

        if (basic_block == null) {
            return .None;
        }

        return .Some(
            BasicBlock.new(
                basic_block,
                self->context_raw,
                self->context_disposed
            )
        );
    }

    pub fn build_int_add(
        self: const Self*,
        lhs: IntValue,
        rhs: IntValue,
        name: const uint8*
    ) IntValue {
        self->assert_ready_for_insert();

        const raw = core::LLVMBuildAdd(
            self->raw,
            lhs.as_raw(),
            rhs.as_raw(),
            @cast(const c_char*, name)
        );

        return IntValue.new(
            raw,
            self->context_raw,
            self->context_disposed
        );
    }

