    pub fn build_int_to_float(
        self: const Self*,
        val: IntValue,
        dest_ty: FloatType,
        is_signed: bool,
        name: const uint8*
    ) FloatValue {
        self->assert_ready_for_insert();

        var raw: core::LLVMValueRef = null;

        if (is_signed) {
            raw = core::LLVMBuildSIToFP(
                self->raw,
                val.as_raw(),
                dest_ty.as_raw(),
                @cast(const c_char*, name)
            );
        } else {
            raw = core::LLVMBuildUIToFP(
                self->raw,
                val.as_raw(),
                dest_ty.as_raw(),
                @cast(const c_char*, name)
            );
        }

        return FloatValue.new(
            raw,
            self->context_raw,
            self->context_disposed
        );
    }

    pub fn build_float_to_int(
        self: const Self*,
        val: FloatValue,
        dest_ty: IntType,
        is_signed: bool,
        name: const uint8*
    ) IntValue {
        self->assert_ready_for_insert();

        var raw: core::LLVMValueRef = null;

        if (is_signed) {
            raw = core::LLVMBuildFPToSI(
                self->raw,
                val.as_raw(),
                dest_ty.as_raw(),
                @cast(const c_char*, name)
            );
        } else {
            raw = core::LLVMBuildFPToUI(
                self->raw,
                val.as_raw(),
                dest_ty.as_raw(),
                @cast(const c_char*, name)
            );
        }

        return IntValue.new(
            raw,
            self->context_raw,
            self->context_disposed
        );
    }

    pub fn build_return(
        self: const Self*,
        val: Option<BasicValue>
    ) InstructionValue {
        self->assert_ready_for_insert();

        switch (val) {
            case .None => {
                const raw = core::LLVMBuildRetVoid(
                    self->raw
                );

                return InstructionValue.new(
                    raw,
                    self->context_raw,
                    self->context_disposed
                );
            }
            case .Some(v) => {
                const raw = core::LLVMBuildRet(
                    self->raw,
                    v.as_raw()
                );

                return InstructionValue.new(
                    raw,
                    self->context_raw,
                    self->context_disposed
                );
            }
        }
    }

    pub fn build_br(
        self: const Self*,
        dest: BasicBlock
    ) InstructionValue {
        self->assert_ready_for_insert();

        const raw = core::LLVMBuildBr(
            self->raw,
            dest.as_raw()
        );

        return InstructionValue.new(
            raw,
            self->context_raw,
            self->context_disposed
        );
    }

    pub fn build_cond_br(
        self: const Self*,
        cond: IntValue,
        then_bb: BasicBlock,
        else_bb: BasicBlock
    ) InstructionValue {
        self->assert_ready_for_insert();

        @assert(
            cond.get_type().get_bit_width() == 1,
            "kara: build_cond_br condition must be i1"
        );

        const raw = core::LLVMBuildCondBr(
            self->raw,
            cond.as_raw(),
            then_bb.as_raw(),
            else_bb.as_raw()
        );

        return InstructionValue.new(
            raw,
            self->context_raw,
            self->context_disposed
        );
    }

    pub fn build_call(
        self: const Self*,
        fn_ty: FunctionType,
        fn_ptr: PointerValue,
        args: const Slice<BasicValue>,
        name: const uint8*
    ) Option<BasicValue> {
        self->assert_ready_for_insert();

        const count = args.len();
        var raw_call: core::LLVMValueRef = null;

        if (count == 0) {
            var empty: core::LLVMValueRef = null;

            raw_call = core::LLVMBuildCall2(
                self->raw,
                fn_ty.as_raw(),
                fn_ptr.as_raw(),
                &empty,
                0,
                @cast(const c_char*, name)
            );
        } else {
            var allocator: Allocator = dynamic LibcAllocator.new();
            var raw_args: core::LLVMValueRef* = allocator.alloc(
                count * @sizeof(core::LLVMValueRef)
            );

            defer allocator.free(
                raw_args
            );

            for (var i: usize = 0; i < count; i += 1) {
                const arg = args.get_const(i).unwrap();
                raw_args[i] = arg->as_raw();
            }

            raw_call = core::LLVMBuildCall2(
                self->raw,
                fn_ty.as_raw(),
                fn_ptr.as_raw(),
                raw_args,
                @cast(c_uint, count),
                @cast(const c_char*, name)
            );
        }

        const ret_ty = core::LLVMTypeOf(
            raw_call
        );

        if (core::LLVMGetTypeKind(ret_ty) == core::LLVM_VOID_TYPE_KIND) {
            return .None;
        }

        return .Some(
            BasicValue.from_raw(
                raw_call,
                self->context_raw,
                self->context_disposed
            )
        );
    }

    pub fn build_phi(
        self: const Self*,
        ty: BasicType,
        name: const uint8*
    ) PhiValue {
        self->assert_ready_for_insert();

        const raw = core::LLVMBuildPhi(
            self->raw,
            ty.as_raw(),
            @cast(const c_char*, name)
        );

        return PhiValue.new(
            raw,
            self->context_raw,
            self->context_disposed
        );
    }
}
