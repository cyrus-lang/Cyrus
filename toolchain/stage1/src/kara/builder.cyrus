    pub fn build_gep(
        self: const Self*,
        pointee_ty: BasicType,
        ptr: PointerValue,
        indices: const Slice<IntValue>,
        name: const uint8*
    ) PointerValue {
        self->assert_ready_for_insert();

        const count = indices.len();

        if (count == 0) {
            var empty: core::LLVMValueRef = null;
            const raw = core::LLVMBuildGEP2(
                self->raw,
                pointee_ty.as_raw(),
                ptr.as_raw(),
                &empty,
                0,
                @cast(const c_char*, name)
            );

            return PointerValue.new(
                raw,
                self->context_raw,
                self->context_disposed
            );
        }

        var allocator: Allocator = dynamic LibcAllocator.new();
        var raw_indices: core::LLVMValueRef* = allocator.alloc(
            count * @sizeof(core::LLVMValueRef)
        );

        defer allocator.free(
            raw_indices
        );

        for (var i: usize = 0; i < count; i += 1) {
            const idx = indices.get_const(i).unwrap();
            raw_indices[i] = idx->as_raw();
        }

        const raw = core::LLVMBuildGEP2(
            self->raw,
            pointee_ty.as_raw(),
            ptr.as_raw(),
            raw_indices,
            @cast(c_uint, count),
            @cast(const c_char*, name)
        );

        return PointerValue.new(
            raw,
            self->context_raw,
            self->context_disposed
        );
    }

