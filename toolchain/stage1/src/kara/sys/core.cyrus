pub struct LLVMOpaqueBuilder { _unused: uint8 }
pub type LLVMBuilderRef = LLVMOpaqueBuilder*;

pub struct LLVMOpaqueMemoryBuffer { _unused: uint8 }
pub type LLVMMemoryBufferRef = LLVMOpaqueMemoryBuffer*;

pub type LLVMBool = c_int;

