pub fn llvm_mesg_to_string(
    ptr: c_char*
) String {
    var allocator: Allocator = dynamic LibcAllocator.new();

    if (ptr == null) {
        return String.new(allocator);
    }
    
    const result = String.from_str(allocator, ptr);
    LLVMDisposeMessage(ptr);
    return result;
}

pub fn llvm_error_to_string(err: LLVMErrorRef) String {
    var allocator: Allocator = dynamic LibcAllocator.new();
    
    if (err == null) {
        return String.new(allocator);
    }
    
    const mesg_ptr = LLVMGetErrorMessage(err);
    
    if (mesg_ptr == null) {
        return String.new(allocator);
    }
    
    const result = String.from_str(allocator, mesg_ptr);
    LLVMDisposeErrorMessage(mesg_ptr);
    return result;
}
