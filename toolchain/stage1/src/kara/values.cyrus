pub struct PhiValue {
    raw: core::LLVMValueRef,
    context_raw: core::LLVMContextRef,
    context_disposed: const bool*,

    pub fn new(
        raw: core::LLVMValueRef, 
        context_raw: core::LLVMContextRef, 
        context_disposed: const bool*
    ) Self {
        return Self {
            raw,
            context_raw,
            context_disposed
        };
    }

    pub fn as_raw(self: const Self*) core::LLVMValueRef {
        assert_context(self->context_disposed);
        return self->raw;
    }

    pub fn add_incoming(self: const Self*, value: BasicValue, block: BasicBlock) {
        assert_context(self->context_disposed);
        var value_raw = value.as_raw();
        var basic_block_raw = block.as_raw();
        core::LLVMAddIncoming(self->raw, &value_raw, &basic_block_raw, 1);
    }

    pub fn as_basic_value(self: const Self*) BasicValue {
        assert_context(self->context_disposed);

        return BasicValue.from_raw(
            self->raw, 
            self->context_raw, 
            self->context_disposed
        );
    }
}

pub struct GlobalValue {
    raw: core::LLVMValueRef,
    context_raw: core::LLVMContextRef,
    context_disposed: const bool*,

    pub fn new(
        raw: core::LLVMValueRef, 
        context_raw: core::LLVMContextRef, 
        context_disposed: const bool*
    ) Self {
        return Self {
            raw,
            context_raw,
            context_disposed
        };
    }

    pub fn as_raw(self: const Self*) core::LLVMValueRef {
        assert_context(self->context_disposed);
        return self->raw;
    }

    pub fn set_initializer(self: const Self*, value: BasicValue) {
        assert_context(self->context_disposed);
        core::LLVMSetInitializer(self->raw, value.as_raw());
    }

    pub fn set_constant(self: const Self*, is_constant: bool) {
        assert_context(self->context_disposed);
        core::LLVMSetGlobalConstant(self->raw, bool_to_llvm(is_constant));
    }

    pub fn as_pointer_value(self: const Self*) PointerValue {
        assert_context(self->context_disposed);

        return PointerValue.new(
            self->raw, 
            self->context_raw, 
            self->context_disposed
        );
    }
}

pub struct FunctionValue {
    raw: core::LLVMValueRef,
    context_raw: core::LLVMContextRef,
    context_disposed: const bool*,

    pub fn new(
        raw: core::LLVMValueRef,
        context_raw: core::LLVMContextRef, 
        context_disposed: const bool*
    ) Self {
        return Self {
            raw,
            context_raw,
            context_disposed
        };
    }

    pub fn as_raw(self: const Self*) core::LLVMValueRef {
        assert_context(self->context_disposed);
        return self->raw;
    }

    pub fn count_params(self: const Self*) uint32 {
        assert_context(self->context_disposed);
        return @cast(uint32, core::LLVMCountParams(self->raw));
    }

    pub fn get_param(self: const Self*, index: uint32) Option<BasicValue> {
        assert_context(self->context_disposed);
        const count = self->count_params();
        
        if (index >= count) {
            return .None;
        }

        const param_raw = core::LLVMGetParam(
            self->raw, 
            @cast(c_uint, index)
        );
        
        return .Some(BasicValue.from_raw(
            param_raw, 
            self->context_raw, 
            self->context_disposed
        ));
    }

    pub fn append_basic_block(self: const Self*, name: const uint8*) BasicBlock {
        assert_context(self->context_disposed);

        const basic_block_raw = core::LLVMAppendBasicBlockInContext(
            self->context_raw,
            self->raw,
            @cast(const c_char*, name)
        );
        
        return BasicBlock.new(
            basic_block_raw, 
            self->context_raw, 
            self->context_disposed
        );
    }

    pub fn as_pointer_value(self: const Self*) PointerValue {
        assert_context(self->context_disposed);

        return PointerValue.new(
            self->raw, 
            self->context_raw, 
            self->context_disposed
        );
    }
}
