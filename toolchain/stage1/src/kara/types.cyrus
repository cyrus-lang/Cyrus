pub struct StructType {
    raw: core::LLVMTypeRef,
    pub context_raw: core::LLVMContextRef,
    pub context_disposed: const bool*,

    pub fn new(raw: core::LLVMTypeRef, context_raw: core::LLVMContextRef, context_disposed: const bool*) Self {
        return Self { raw, context_raw, context_disposed };
    }

    pub fn as_raw(self: const Self*) core::LLVMTypeRef {
        assert_context(self->context_disposed);
        return self->raw;
    }

    pub fn as_basic_type(self: const Self*) BasicType {
        assert_context(self->context_disposed);
        return .Struct(*self);
    }

    pub fn set_body(self: const Self*, fields: const Slice<BasicType>, packed: bool) {
        assert_context(self->context_disposed);
        const count = fields.len();
        if (count == 0) {
            var empty: core::LLVMTypeRef = null;
            core::LLVMStructSetBody(self->raw, &empty, 0, bool_to_llvm(packed));
            return;
        }
        var allocator: Allocator = dynamic LibcAllocator.new();
        var raw_fields: core::LLVMTypeRef* = allocator.alloc(count * @sizeof(core::LLVMTypeRef));
        defer allocator.free(raw_fields);
        for (var i: usize = 0; i < count; i += 1) {
            const field = fields.get_const(i).unwrap();
            raw_fields[i] = field->as_raw();
        }
        core::LLVMStructSetBody(self->raw, raw_fields, @cast(c_uint, count), bool_to_llvm(packed));
    }

    pub fn array_type(self: const Self*, count: uint64) ArrayType {
        assert_context(self->context_disposed);
        const raw = core::LLVMArrayType2(self->raw, @cast(c_unsigned_long_long, count));
        return ArrayType.new(raw, self->context_raw, self->context_disposed);
    }

    pub fn fn_type(self: const Self*, param_types: const Slice<BasicType>, is_var_arg: bool) FunctionType {
        assert_context(self->context_disposed);
        return make_fn_type(self->raw, self->context_raw, self->context_disposed, param_types, is_var_arg);
    }
}

