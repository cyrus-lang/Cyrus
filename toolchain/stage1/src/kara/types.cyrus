import std::mem::libc{LibcAllocator};
import std::mem{Allocator};
import std::slices{Slice};
import std::libc::types{
    c_unsigned_long_long,
    c_uint, 
    c_int, 
};

import .::sys::core;

pub enum IntPredicate {
    EQ,
    NE,
    UGT,
    UGE,
    ULT,
    ULE,
    SGT,
    SGE,
    SLT,
    SLE,

    pub fn to_raw(self: const Self*) c_int {
        switch (*self) {
            case .EQ => return core::LLVM_INT_EQ;
            case .NE => return core::LLVM_INT_NE;
            case .UGT => return core::LLVM_INT_UGT;
            case .UGE => return core::LLVM_INT_UGE;
            case .ULT => return core::LLVM_INT_ULT;
            case .ULE => return core::LLVM_INT_ULE;
            case .SGT => return core::LLVM_INT_SGT;
            case .SGE => return core::LLVM_INT_SGE;
            case .SLT => return core::LLVM_INT_SLT;
            case .SLE => return core::LLVM_INT_SLE;
        }
    }
}

pub enum FloatPredicate {
    False,
    OEQ,
    OGT,
    OGE,
    OLT,
    OLE,
    ONE,
    ORD,
    UNO,
    UEQ,
    UGT,
    UGE,
    ULT,
    ULE,
    UNE,
    True,

    pub fn to_raw(self: const Self*) c_int {
        switch (*self) {
            case .False => return core::LLVM_REAL_PREDICATE_FALSE;
            case .OEQ => return core::LLVM_REAL_OEQ;
            case .OGT => return core::LLVM_REAL_OGT;
            case .OGE => return core::LLVM_REAL_OGE;
            case .OLT => return core::LLVM_REAL_OLT;
            case .OLE => return core::LLVM_REAL_OLE;
            case .ONE => return core::LLVM_REAL_ONE;
            case .ORD => return core::LLVM_REAL_ORD;
            case .UNO => return core::LLVM_REAL_UNO;
            case .UEQ => return core::LLVM_REAL_UEQ;
            case .UGT => return core::LLVM_REAL_UGT;
            case .UGE => return core::LLVM_REAL_UGE;
            case .ULT => return core::LLVM_REAL_ULT;
            case .ULE => return core::LLVM_REAL_ULE;
            case .UNE => return core::LLVM_REAL_UNE;
            case .True => return core::LLVM_REAL_PREDICATE_TRUE;
        }
    }
}

pub struct VoidType {
    raw: core::LLVMTypeRef,
    context_raw: core::LLVMContextRef,
    context_disposed: const bool*,

    pub fn new(raw: core::LLVMTypeRef, context_raw: core::LLVMContextRef, context_disposed: const bool*) Self {
        return Self { raw, context_raw, context_disposed };
    }

    pub fn as_raw(self: const Self*) core::LLVMTypeRef {
        assert_context(self->context_disposed);
        return self->raw;
    }

    pub fn fn_type(self: const Self*, param_types: const Slice<BasicType>, is_var_arg: bool) FunctionType {
        assert_context(self->context_disposed);
        return make_fn_type(self->raw, self->context_raw, self->context_disposed, param_types, is_var_arg);
    }
}

pub struct IntType {
    raw: core::LLVMTypeRef,
    pub context_raw: core::LLVMContextRef,
    pub context_disposed: const bool*,

    pub fn new(raw: core::LLVMTypeRef, context_raw: core::LLVMContextRef, context_disposed: const bool*) Self {
        return Self { raw, context_raw, context_disposed };
    }

    pub fn as_raw(self: const Self*) core::LLVMTypeRef {
        assert_context(self->context_disposed);
        return self->raw;
    }

    pub fn get_bit_width(self: const Self*) uint32 {
        assert_context(self->context_disposed);
        return @cast(uint32, core::LLVMGetIntTypeWidth(self->raw));
    }

    pub fn as_basic_type(self: const Self*) BasicType {
        assert_context(self->context_disposed);
        return .Int(*self);
    }

    pub fn array_type(self: const Self*, count: uint64) ArrayType {
        assert_context(self->context_disposed);
        const raw = core::LLVMArrayType2(self->raw, @cast(c_unsigned_long_long, count));
        return ArrayType.new(raw, self->context_raw, self->context_disposed);
    }

    pub fn fn_type(self: const Self*, param_types: const Slice<BasicType>, is_var_arg: bool) FunctionType {
        assert_context(self->context_disposed);
        return make_fn_type(self->raw, self->context_raw, self->context_disposed, param_types, is_var_arg);
    }
}

