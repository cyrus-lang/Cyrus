pub struct FunctionType {
    raw: core::LLVMTypeRef,
    context_raw: core::LLVMContextRef,
    context_disposed: const bool*,

    pub fn new(raw: core::LLVMTypeRef, context_raw: core::LLVMContextRef, context_disposed: const bool*) Self {
        return Self { raw, context_raw, context_disposed };
    }

    pub fn as_raw(self: const Self*) core::LLVMTypeRef {
        assert_context(self->context_disposed);
        return self->raw;
    }
}

pub enum BasicType {
    Int(IntType),
    Float(FloatType),
    Pointer(PointerType),
    Struct(StructType),
    Array(ArrayType),

    pub fn as_raw(self: const Self*) core::LLVMTypeRef {
        switch (*self) {
            case .Int(t) => return t.as_raw();
            case .Float(t) => return t.as_raw();
            case .Pointer(t) => return t.as_raw();
            case .Struct(t) => return t.as_raw();
            case .Array(t) => return t.as_raw();
        }
    }

    pub fn context_raw_handle(self: const Self*) core::LLVMContextRef {
        switch (*self) {
            case .Int(t) => return t.context_raw;
            case .Float(t) => return t.context_raw;
            case .Pointer(t) => return t.context_raw;
            case .Struct(t) => return t.context_raw;
            case .Array(t) => return t.context_raw;
        }
    }

    pub fn context_disposed_ptr(self: const Self*) const bool* {
        switch (*self) {
            case .Int(t) => return t.context_disposed;
            case .Float(t) => return t.context_disposed;
            case .Pointer(t) => return t.context_disposed;
            case .Struct(t) => return t.context_disposed;
            case .Array(t) => return t.context_disposed;
        }
    }

    pub fn array_type(self: const Self*, count: uint64) ArrayType {
        const disposed = self->context_disposed_ptr();
        assert_context(disposed);
        const raw = core::LLVMArrayType2(self->as_raw(), @cast(c_unsigned_long_long, count));
        return ArrayType.new(raw, self->context_raw_handle(), disposed);
    }

    pub fn fn_type(self: const Self*, param_types: const Slice<BasicType>, is_var_arg: bool) FunctionType {
        const disposed = self->context_disposed_ptr();
        assert_context(disposed);
        return make_fn_type(self->as_raw(), self->context_raw_handle(), disposed, param_types, is_var_arg);
    }

    pub fn from_raw(raw: core::LLVMTypeRef, context_raw: core::LLVMContextRef, context_disposed: const bool*) Self {
        assert_context(context_disposed);
        const kind = core::LLVMGetTypeKind(raw);
        if (kind == core::LLVM_INTEGER_TYPE_KIND) {
            return .Int(IntType.new(raw, context_raw, context_disposed));
        }
        if (kind == core::LLVM_FLOAT_TYPE_KIND || kind == core::LLVM_DOUBLE_TYPE_KIND || kind == core::LLVM_HALF_TYPE_KIND || kind == core::LLVM_BFLOAT_TYPE_KIND || kind == core::LLVM_X86_FP80_TYPE_KIND || kind == core::LLVM_FP128_TYPE_KIND) {
            return .Float(FloatType.new(raw, context_raw, context_disposed));
        }
        if (kind == core::LLVM_POINTER_TYPE_KIND) {
            return .Pointer(PointerType.new(raw, context_raw, context_disposed));
        }
        if (kind == core::LLVM_STRUCT_TYPE_KIND) {
            return .Struct(StructType.new(raw, context_raw, context_disposed));
        }
        if (kind == core::LLVM_ARRAY_TYPE_KIND) {
            return .Array(ArrayType.new(raw, context_raw, context_disposed));
        }
        @panic("kara: unsupported LLVMTypeKind for BasicType");
    }
}

[[inline]]
pub fn bool_to_llvm(value: bool) core::LLVMBool {
    if (value) {
        return 1;
    } else {
        return 0;
    }
}

fn make_fn_type(
    ret_raw: core::LLVMTypeRef,
    context_raw: core::LLVMContextRef,
    context_disposed: const bool*,
    param_types: const Slice<BasicType>,
    is_var_arg: bool
) FunctionType {
    const count = param_types.len();

    if (count == 0) {
        var empty: core::LLVMTypeRef;
        
        const raw = core::LLVMFunctionType(
            ret_raw, 
            &empty, 
            0, 
            bool_to_llvm(is_var_arg)
        );

        return FunctionType.new(
            raw, 
            context_raw, 
            context_disposed
        );
    }
    
    const allocator: Allocator = dynamic LibcAllocator.new();
    
    var raw_params: core::LLVMTypeRef* = allocator.alloc(
        count * @sizeof(core::LLVMTypeRef)
    );
    defer allocator.free(raw_params);
    
    for (var i: usize = 0; i < count; i += 1) {
        const param = param_types.get_const(i).unwrap();
        raw_params[i] = param->as_raw();
    }
    
    const raw = core::LLVMFunctionType(
        ret_raw, 
        raw_params, 
        @cast(c_uint, count), 
        bool_to_llvm(is_var_arg)
    );

    return FunctionType.new(
        raw, 
        context_raw, 
        context_disposed
    );
}

[[inline]]
pub fn assert_context(disposed: const bool*) {
    @assert(disposed != null, "kara: invalid null context state");
    @assert(!(*disposed), "kara: handle used after Context was disposed");
}