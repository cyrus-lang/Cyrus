import std::string{String, free_strings};
import std::collections{Vec};
import std::errors{ErrorOr};
import std::os{path_exists};
import std::option{Option};
import std::mem{Allocator};
import std::libc{strlen};
import std::path{
    canonicalize_absolute_path, 
    has_path_prefix,
    file_parent, 
    join_path, 
    file_stem, 
    same_file
};
import std::os::dir;
import std::os::env;
import std::os;

import parser::ast{ASTModuleSegment};
import abi::target{TargetInfo};
import tokens{Span, Loc};
import source{SourceId};
import cir::format{
    format_sub_module_names,
    format_module_segments, 
    sub_module_names, 
};

const INDEX_MODULE_FILENAME = "index.cyrus";
const CYRUS_EXTENSION = ".cyrus";

pub enum Profile {
    Debug,
    Release,
    Test,
}

pub struct ProfileSet {
    pub debug: bool,
    pub release: bool,
    pub test: bool,

    [[inline]]
    pub fn all() Self {
        return Self {
            debug: true, 
            release: true, 
            test: true
        };
    }

    [[inline]]
    pub fn none() Self {
        return Self {
            debug: false, 
            release: false, 
            test: false
        };
    }

    [[inline]]
    pub fn only_debug() Self {
        return Self { 
            debug: true, 
            release: false, 
            test: false
        };
    }

    [[inline]]
    pub fn only_release() Self {
        return Self { 
            debug: false, 
            release: true, 
            test: false
        };
    }

    [[inline]]
    pub fn only_test() Self {
        return Self { 
            debug: false, 
            release: false, 
            test: true
        };
    }

    [[inline]]
    pub fn from_profile(profile: Profile) Self {
        switch (profile) {
            case .Release => return Self.only_release();
            case .Debug => return Self.only_debug();
            case .Test => return Self.only_test();
        }
    }

    [[inline]]
    pub fn contains_profile(self: Self, profile: Profile) bool {
        switch (profile) {
            case .Debug => return self.debug;
            case .Release => return self.release;
            case .Test => return self.test;
        }
    }

    [[inline]]
    pub fn is_empty(self: Self) bool {
        return !self.debug && !self.release && !self.test;
    }

    [[inline]]
    pub fn is_all(self: Self) bool {
        return self.debug && self.release && self.test;
    }

    [[inline]]
    pub fn intersect(self: Self, other: Self) Self {
        return Self {
            debug: self.debug && other.debug,
            release: self.release && other.release,
            test: self.test && other.test,
        };
    }

    [[inline]]
    pub fn union_with(self: Self, other: Self) Self {
        return Self {
            debug: self.debug || other.debug,
            release: self.release || other.release,
            test: self.test || other.test,
        };
    }

    [[inline]]
    pub fn difference(self: Self, other: Self) Self {
        return Self {
            debug: self.debug && !other.debug,
            release: self.release && !other.release,
            test: self.test && !other.test,
        };
    }

    [[inline]]
    pub fn is_subset_of(self: Self, other: Self) bool {
        return (!self.debug || other.debug) &&
            (!self.release || other.release) &&
            (!self.test || other.test);
    }

    [[inline]]
    pub fn overlaps(self: Self, other: Self) bool {
        return (self.debug && other.debug) ||
            (self.release && other.release) ||
            (self.test && other.test);
    }

    pub fn append_to(self: Self, out: String*) {
        var added = false;

        if (self.debug) {
            out->push_str("debug");
            added = true;
        }
        
        if (self.release) {
            if (added) {
                out->push_str(", ");
            }
            out->push_str("release");
            added = true;
        }

        if (self.test) {
            if (added) {
                out->push_str(", ");
            }
            out->push_str("test");
            added = true;
        }

        if (!added) {
            out->push_str("none");
        }
    }
}

pub struct ModuleAlias {
    pub name: String,
    pub file_path: Option<String>,
    pub dir_path: Option<String>,

    pub fn free(self: Self*) {
        self->name.free();

        switch (self->file_path) {
            case .Some(var path) => path.free();
            case .None => {}
        }

        switch (self->dir_path) {
            case .Some(var path) => path.free();
            case .None => {}
        }
    }
}

pub struct ResolverOptions {
    pub stdlib_path: Option<String>,
    pub source_dirs: Vec<String>,
    pub module_aliases: Vec<ModuleAlias>,
    pub features: Vec<String>,
    pub base_path: String,
    pub profile: Profile,
    pub target: TargetInfo,

    pub fn new(allocator: Allocator) Self {
        return Self {
            base_path: String.from_str(allocator, "."),
            source_dirs: Vec.new(allocator),
            module_aliases: Vec.new(allocator),
            features: Vec.new(allocator),
            stdlib_path: .None,
            profile: .Debug,
            target: TargetInfo.host(),
        };
    }

    pub fn free(self: Self*) {
        for (var i: usize = 0; i < self->source_dirs.len(); i += 1) {
            var dir = self->source_dirs.get_owned(i).unwrap();
            dir.free();
        }
        self->source_dirs.free();

        for (var i: usize = 0; i < self->module_aliases.len(); i += 1) {
            var alias = self->module_aliases.get_owned(i).unwrap();
            alias.free();
        }
        self->module_aliases.free();

        free_strings(&self->features);

        switch (self->stdlib_path) {
            case .Some(path) => path.free();
            else => {}
        }

        self->base_path.free();
    }
}

pub enum LoaderError {
    RelativeImportEscapesProjectRoot,
    ModuleNotFound(String, Span),
    ModuleCannotImportItself,
    DuplicateModule(String),
    StdlibNotFound,

    pub fn free(self: Self*) {
        switch (*self) {
            case .ModuleNotFound(name, _) => name.free();
            case .DuplicateModule(name) => name.free();
            else => {}
        }
    }
}

pub struct ResolvedModuleFile {
    pub file_path: String,
    pub directory_modules: Vec<String>,
    pub file_module_name: String,
    pub consumed_segments: usize,

    pub fn free(self: Self*) {
        self->file_path.free();
        self->file_module_name.free();
        free_strings(&self->directory_modules);
    }
}

fn has_stdlib_prefix_sanitized(path: const uint8*, first: usize, end: usize) bool {
    if (end - first < 7) {
        return false;
    }

    return path[first] == 's'
        && path[first + 1] == 't'
        && path[first + 2] == 'd'
        && path[first + 3] == 'l'
        && path[first + 4] == 'i'
        && path[first + 5] == 'b'
        && !is_ident_char(path[first + 6]);
}

pub fn module_name_from_file_path(
    allocator: Allocator,
    opts: const ResolverOptions*,
    file_path: const uint8*,
) String {
    var path_owned: Option<String> = .None;
    var path_str: const uint8* = file_path;
    var start: usize = 0;
    var is_stdlib = false;

    switch (opts->stdlib_path) {
        case .Some(std_path) => {
            const std_str = std_path.as_str_const();

            if (has_path_prefix(file_path, std_str)) {
                is_stdlib = true;
                start = strlen(std_str);
                while (file_path[start] == '/') {
                    start += 1;
                }
            } else {
                var cwd = dir::cwd(allocator);

                switch (canonicalize_absolute_path(
                    allocator, 
                    cwd.as_str_const(), 
                    file_path
                )) {
                    case .Some(var file_canon) => {
                        switch (canonicalize_absolute_path(
                            allocator, 
                            cwd.as_str_const(), 
                            std_str
                        )) {
                            case .Some(var std_canon) => {
                                if (has_path_prefix(
                                    file_canon.as_str_const(), 
                                    std_canon.as_str_const()
                                )) {
                                    is_stdlib = true;
                                    start = strlen(std_canon.as_str_const());
                                    path_str = file_canon.as_str_const();
                                    
                                    while (path_str[start] == '/') {
                                        start += 1;
                                    }
                                    
                                    path_owned = .Some(file_canon);
                                } else {
                                    file_canon.free();
                                }

                                std_canon.free();
                            }
                            else => file_canon.free();
                        }
                    }
                    else => {}
                }
                cwd.free();
            }
        }
        else => {}
    }

    if (!is_stdlib) {
        const base_len = strlen(opts->base_path.as_str_const());

        if (file_path[0] == '/' 
            && base_len > 0 
            && has_path_prefix(file_path, opts->base_path.as_str_const())
        ) {
            start = base_len;

            while (file_path[start] == '/') {
                start += 1;
            }
        }
    }

    var end = strlen(path_str);
    var seg = start;

    for (var i: usize = start; i < end; i += 1) {
        if (path_str[i] == '/') {
            seg = i + 1;
        }
    }

    // Strip the extension `.cyrus`
    if (ends_with_exten(path_str, seg, end)) {
        end -= 6;
    } else {
        for (var i: usize = end; i > seg; i -= 1) {
            if (path_str[i - 1] == '.') {
                end = i - 1;
                break;
            }
        }
    }

    var first = start;
    while (first < end && !is_ident_char(path_str[first])) {
        first += 1;
    }

    const need_stdlib_prefix = is_stdlib && 
        !has_stdlib_prefix_sanitized(path_str, first, end);

    var cap = end - first;
    
    if (need_stdlib_prefix) {
        cap += 7;
    }
    
    if (cap < 6) {
        cap = 6;
    }

    var name = String.with_capacity(allocator, cap);
    
    if (need_stdlib_prefix) {
        name.push_str("stdlib_");
    }

    if (first >= end) {
        name.push_str("module");
    } else {
        for (var i: usize = first; i < end; i += 1) {
            const char = path_str[i];
            
            if (is_ident_char(char)) {
                name.push(char);
            } else {
                name.push('_');
            }
        }
    }

    switch (path_owned) {
        case .Some(var owned) => owned.free();
        else => {}
    }

    return name;
}

pub fn last_sub_module_name(
    allocator: Allocator, 
    segments: const Vec<ASTModuleSegment>*
) String {
    var i = segments->len();

    while (i > 0) {
        i -= 1;

        const seg = segments->get_const(i).unwrap();

        switch (*seg) {
            case .SubModule(ident) => return String.from_str(
                allocator, 
                ident.str.as_str_const()
            );
            else => {}
        }
    }

    return String.new(allocator);
}

/// Span of the submodule segment at `ordinal`.
pub fn segment_span(segments: const Vec<ASTModuleSegment>*, ordinal: usize) Span {
    var seen: usize = 0;

    for (var i: usize = 0; i < segments->len(); i += 1) {
        const seg = segments->get_owned(i).unwrap();

        switch (seg) {
            case .SubModule(ident) => {
                if (seen == ordinal) {
                    return ident.span;
                }

                seen += 1;
            }
            else => {}
        }
    }

    return first_segment_span(segments);
}

/// Span of the last submodule segment of an import path.
pub fn last_sub_module_span(segments: const Vec<ASTModuleSegment>*) Span {
    var i = segments->len();

    while (i > 0) {
        i -= 1;

        switch (segments->get_owned(i).unwrap()) {
            case .SubModule(ident) => return ident.span;
            else => {}
        }
    }

    return first_segment_span(segments);
}

/// Span of the first identifiable piece of an import path.
pub fn first_segment_span(segments: const Vec<ASTModuleSegment>*) Span {
    for (var i: usize = 0; i < segments->len(); i += 1) {
        const seg = segments->get_owned(i).unwrap();

        switch (seg) {
            case .SubModule(ident) => {
                return ident.span;
            }
            case .Single(singles) => {
                if (singles.len() > 0) {
                    const single = singles.get_const(0).unwrap();
                    return single->ident.span;
                }
            }
        }
    }

    return Span.new(0, Loc.new(0, 0));
}

/// Locate an imported module file for an import statement.
pub fn resolve_import(
    allocator: Allocator,
    opts: const ResolverOptions*,
    segments: const Vec<ASTModuleSegment>*,
    relative_level: isize,
    current_file_path: const uint8*,
) ErrorOr<ResolvedModuleFile, LoaderError> {
    var names = sub_module_names(allocator, segments);

    if (names.len() == 0) {
        free_strings(&names);

        return .Error(.ModuleNotFound(
            format_module_segments(allocator, segments),
            first_segment_span(segments)
        ));
    }

    var sources: Vec<String> = Vec.new(allocator);
    var is_std = false;
    var alias_prefix: Option<const uint8*> = .None;

    const first = names.get_const(0).unwrap();

    if (first->as_str_const() == "std") {
        is_std = true;

        var removed = names.remove(0);
        removed.free();

        switch (stdlib_modules_path(allocator, opts)) {
            case .Some(root) => {
                sources.push(root);
            }
            case .None => {
                free_strings(&sources);
                free_strings(&names);
                return .Error(.StdlibNotFound);
            }
        }
    } else if (relative_level < 0) {
        switch (relative_search_dir(
            allocator, 
            opts, 
            current_file_path, 
            relative_level
        )) {
            case .Some(search_dir) => {
                sources.push(search_dir);
            }
            case .None => {
                free_strings(&sources);
                free_strings(&names);
                return .Error(.RelativeImportEscapesProjectRoot);
            }
        }
    } else {
        var matched_alias = false;

        const first_str = first->as_str_const();

        for (var i: usize = 0; i < opts->module_aliases.len(); i += 1) {
            const alias = opts->module_aliases.get_const(i).unwrap();
            
            if (alias->name.as_str_const() != first_str) {
                continue;
            }

            if (names.len() == 1) {
                switch (alias->file_path) {
                    case .Some(path) => {
                        if (same_file(allocator, path.as_str_const(), current_file_path)) {
                            free_strings(&sources);
                            free_strings(&names);
                            return .Error(.ModuleCannotImportItself);
                        }

                        var module_file = ResolvedModuleFile {
                            file_path: String.from_str(allocator, path.as_str_const()),
                            directory_modules: Vec.new(allocator),
                            file_module_name: String.from_str(allocator, alias->name.as_str_const()),
                            consumed_segments: 1,
                        };

                        free_strings(&sources);
                        free_strings(&names);
                        return .Value(module_file);
                    }
                    case .None => {}
                }
            }

            switch (alias->dir_path) {
                case .Some(path) => {
                    matched_alias = true;
                    alias_prefix = .Some(alias->name.as_str_const());
                    
                    var removed = names.remove(0);
                    removed.free();
                    
                    sources.push(String.from_str(
                        allocator, 
                        path.as_str_const()
                    ));
                    break;
                }
                case .None => {}
            }
        }

        if (!matched_alias) {
            for (var i: usize = 0; i < opts->source_dirs.len(); i += 1) {
                const source_dir = opts->source_dirs.get_const(i).unwrap();
                sources.push(String.from_str(allocator, source_dir->as_str_const()));
            }
        }
    }

    if (names.len() == 0) {
        free_strings(&sources);
        free_strings(&names);

        return .Error(.ModuleNotFound(
            format_module_segments(allocator, segments),
            first_segment_span(segments)
        ));
    }

    var name_offset: usize = 0;

    if (is_std || alias_prefix.is_some()) {
        name_offset = 1;
    }

    const result = load_module_segments(
        allocator, 
        &names, 
        &sources, 
        segments, 
        name_offset
    );
    free_strings(&sources);
    free_strings(&names);

    switch (result) {
        case .Value(var resolved) => {
            if (same_file(
                allocator, 
                resolved.file_path.as_str_const(), 
                current_file_path
            )) {
                resolved.free();
                return .Error(.ModuleCannotImportItself);
            }

            if (is_std) {
                resolved.directory_modules.insert(0, String.from_str(allocator, "std"));
                resolved.consumed_segments += 1;
            } else {
                switch (alias_prefix) {
                    case .Some(aname) => {
                        resolved.directory_modules.insert(0, String.from_str(allocator, aname));
                        resolved.consumed_segments += 1;
                    }
                    case .None => {}
                }
            }

            return .Value(resolved);
        }
        case .Error(err) => {
            return .Error(err);
        }
    }
}

fn load_module_segments(
    allocator: Allocator,
    names: const Vec<String>*,
    sources: const Vec<String>*,
    segments: const Vec<ASTModuleSegment>*,
    name_offset: usize,
) ErrorOr<ResolvedModuleFile, LoaderError> {
    var directory_modules: Vec<String> = Vec.new(allocator);
    var current_path = String.new(allocator);

    for (var i: usize = 0; i < names->len(); i += 1) {
        const name_str = names->get_const(i).unwrap()->as_str_const();

        var file_candidate = join_path(allocator, current_path.as_str_const(), name_str);
        file_candidate.push_str(CYRUS_EXTENSION);

        var dir_candidate = join_path(allocator, current_path.as_str_const(), name_str);

        const has_base = !current_path.is_empty();
        const file_hit = find_in_sources(allocator, file_candidate, sources, has_base);
        const dir_hit = find_dir_in_sources(allocator, dir_candidate, sources, has_base);

        switch (file_hit) {
            case .Some(file_path) => {
                switch (dir_hit) {
                    case .Some(conflict_path) => {
                        file_path.free();
                        conflict_path.free();
                        free_strings(&directory_modules);
                        current_path.free();

                        return .Error(.DuplicateModule(String.from_str(
                            allocator, 
                            name_str
                        )));
                    }
                    case .None => {
                        const result = ResolvedModuleFile {
                            file_path,
                            directory_modules,
                            file_module_name: String.from_str(allocator, name_str),
                            consumed_segments: i + 1,
                        };
                        current_path.free();
                        return .Value(result);
                    }
                }
            }
            case .None => {
                switch (dir_hit) {
                    case .Some(dir_path) => {
                        const is_last = (i + 1 == names->len());

                        if (is_last) {
                            var index_path = join_path(
                                allocator, 
                                dir_path.as_str_const(), 
                                INDEX_MODULE_FILENAME
                            );

                            if (path_exists(index_path.as_str_const())) {
                                const result = ResolvedModuleFile {
                                    file_path: index_path,
                                    directory_modules,
                                    file_module_name: String.from_str(allocator, name_str),
                                    consumed_segments: i + 1,
                                };
                                dir_path.free();
                                current_path.free();
                                return .Value(result);
                            }

                            index_path.free();
                        }

                        // Descend into the directory module
                        current_path.free();
                        current_path = dir_path;
                        directory_modules.push(String.from_str(allocator, name_str));
                    }
                    case .None => {
                        free_strings(&directory_modules);
                        current_path.free();
                        return .Error(.ModuleNotFound(
                            format_sub_module_names(allocator, names),
                            segment_span(segments, i + name_offset)
                        ));
                    }
                }
            }
        }
    }

    // If the walk is ended inside a directory,
    // we gotta look for its index file
    if (os::is_dir(current_path.as_str_const())) {
        var index_path = join_path(
            allocator, 
            current_path.as_str_const(), 
            INDEX_MODULE_FILENAME
        );

        if (path_exists(index_path.as_str_const())) {
            const result = ResolvedModuleFile {
                file_path: index_path,
                directory_modules,
                file_module_name: file_stem(allocator, current_path.as_str_const()),
                consumed_segments: names->len(),
            };
            current_path.free();
            return .Value(result);
        }

        index_path.free();
        free_strings(&directory_modules);
        current_path.free();
        return .Error(.ModuleNotFound(
            format_sub_module_names(allocator, names),
            segment_span(segments, (names->len() - 1) + name_offset)
        ));
    }

    // Fallback: 
    // The path itself is the module file 
    const result = ResolvedModuleFile {
        file_path: current_path,
        directory_modules,
        file_module_name: file_stem(allocator, current_path.as_str_const()),
        consumed_segments: names->len(),
    };
    return .Value(result);
}

fn relative_search_dir(
    allocator: Allocator,
    opts: const ResolverOptions*,
    current_file_path: const uint8*,
    relative_level: isize,
) Option<String> {
    switch (file_parent(
        allocator, 
        current_file_path
    )) case .Some(var current) else {
        return .None;
    }

    const ascents = (-relative_level) - 1;

    for (var a: isize = 0; a < ascents; a += 1) {
        switch (file_parent(allocator, current.as_str_const())) {
            case .Some(parent) => {
                current.free();
                current = parent;
            }
            case .None => {
                current.free();
                return .None;
            }
        }
    }

    var cwd = dir::cwd(allocator);

    const abs = canonicalize_absolute_path(
        allocator, 
        cwd.as_str_const(), 
        current.as_str_const()
    );

    switch (abs) case .Some(var search_dir) else {
        cwd.free();
        current.free();
        return .None;
    }
    
    current.free();

    var root: String = undefined;

    switch (canonicalize_absolute_path(
        allocator, 
        cwd.as_str_const(), 
        opts->base_path.as_str_const()
    )) {
        case .Some(path) => root = path;

        case .None => root = String.from_str(
            allocator, 
            opts->base_path.as_str_const()
        );
    }
    
    cwd.free();

    if (!has_path_prefix(
        search_dir.as_str_const(), 
        root.as_str_const()
    )) {
        search_dir.free();
        root.free();
        return .None;
    }

    root.free();
    return .Some(search_dir);
}

fn stdlib_modules_path(
    allocator: Allocator, 
    opts: const ResolverOptions*
) Option<String> {
    switch (opts->stdlib_path) {
        case .Some(path) => return .Some(String.from_str(
            allocator, 
            path.as_str_const()
        ));
        else => {}
    }

    return env::get_string(allocator, "CYRUS_STDLIB_PATH");
}

fn find_in_sources(
    allocator: Allocator,
    candidate: String,
    sources: const Vec<String>*,
    has_base: bool,
) Option<String> {
    if (has_base && path_exists(candidate.as_str_const())) {
        return .Some(candidate);
    }

    for (var i: usize = 0; i < sources->len(); i += 1) {
        const source = sources->get_const(i).unwrap();

        const path = join_path(
            allocator,
            source->as_str_const(),
            candidate.as_str_const()
        );

        if (path_exists(path.as_str_const())) {
            candidate.free();
            return .Some(path);
        }

        path.free();
    }

    candidate.free();
    return .None;
}

fn find_dir_in_sources(
    allocator: Allocator,
    candidate: String,
    sources: const Vec<String>*,
    has_base: bool,
) Option<String> {
    if (has_base && os::is_dir(candidate.as_str_const())) {
        return .Some(candidate);
    }

    for (var i: usize = 0; i < sources->len(); i += 1) {
        const source = sources->get_const(i).unwrap();
        
        const path = join_path(
            allocator, 
            source->as_str_const(), 
            candidate.as_str_const()
        );

        if (os::is_dir(path.as_str_const())) {
            candidate.free();
            return .Some(path);
        }

        path.free();
    }

    candidate.free();
    return .None;
}

fn ends_with_exten(path: const uint8*, seg: usize, end: usize) bool {
    if (end < seg + 6) {
        return false;
    }

    for (var i: usize = 0; i < 6; i += 1) {
        if (path[end - 6 + i] != CYRUS_EXTENSION[i]) {
            return false;
        }
    }

    return true;
}

[[inline]]
fn is_ident_char(char: uint8) bool {
    return (char >= 'a' && char <= 'z')
        || (char >= 'A' && char <= 'Z')
        || (char >= '0' && char <= '9');
}

pub fn is_feature_enabled(
    enabled_features: const Vec<String>*,
    feature_name: const uint8*
) bool {
    if (enabled_features == null) {
        return false;
    }

    for (var i: usize = 0; i < enabled_features->len(); i += 1) {
        const enabled_feature = enabled_features->get_const(i).unwrap()->as_str_const();

        if (enabled_feature == feature_name) {
            return true;
        }
    }

    return false;
}
