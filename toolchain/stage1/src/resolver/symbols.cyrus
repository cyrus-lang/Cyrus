import std::mem{Allocator, alloc_init};
import std::collections{Vec};
import std::option{Option};
import std::string{String};

import resolver::loader{Profile, ProfileSet};
import parser::ast{ASTVisibility};
import cir::tables{DeclTables};
import tokens{Span};
import cir;

const GLOBAL_NAMESPACE = "GLOBAL";

pub struct ProfileSymbolPair {
    pub name: String,
    pub debug_symbol_id: cir::SymbolId,
    pub release_symbol_id: cir::SymbolId,
    pub span: Span,
}

pub struct ScopeBinding {
    pub name: String,
    pub symbol_id: cir::SymbolId,
    pub debug_symbol_id: Option<cir::SymbolId>,
    pub release_symbol_id: Option<cir::SymbolId>,
    pub availability: ProfileSet,

    pub fn symbol_for_profiles(
        self: const Self*, 
        active: ProfileSet, 
        target_profile: Profile
    ) cir::SymbolId {
        if (active.debug && !active.release) {
            switch (self->debug_symbol_id) {
                case .Some(id) => return id;
                case .None => {}
            }
        }

        if (active.release && !active.debug) {
            switch (self->release_symbol_id) {
                case .Some(id) => return id;
                case .None => {}
            }
        }

        switch (target_profile) {
            case .Debug => {
                switch (self->debug_symbol_id) {
                    case .Some(id) => return id;
                    case .None => {}
                }
            }
            case .Release => {
                switch (self->release_symbol_id) {
                    case .Some(id) => return id;
                    case .None => {}
                }
            }
        }

        return self->symbol_id;
    }
}

pub struct ScopeTable {
    pub bindings: Vec<ScopeBinding>,
    allocator: Allocator,

    pub fn new(allocator: Allocator) Self {
        return Self { bindings: Vec.new(allocator), allocator };
    }

    pub fn lookup(self: const Self*, name: const uint8*) Option<cir::SymbolId> {
        for (var i: usize = 0; i < self->bindings.len(); i += 1) {
            const binding = self->bindings.get_const(i).unwrap();

            if (binding->name.as_str_const() == name) {
                return .Some(binding->symbol_id);
            }
        }

        return .None;
    }

    pub fn lookup_binding(self: const Self*, name: const uint8*) Option<const ScopeBinding*> {
        for (var i: usize = 0; i < self->bindings.len(); i += 1) {
            const binding = self->bindings.get_const(i).unwrap();

            if (binding->name.as_str_const() == name) {
                return .Some(binding);
            }
        }

        return .None;
    }

    pub fn bind(self: Self*, name: const uint8*, symbol_id: cir::SymbolId) Option<cir::SymbolId> {
        for (var i: usize = 0; i < self->bindings.len(); i += 1) {
            var binding = self->bindings.get(i).unwrap();

            if (binding->name.as_str_const() == name) {
                const previous = binding->symbol_id;
                binding->symbol_id = symbol_id;
                binding->debug_symbol_id = .Some(symbol_id);
                binding->release_symbol_id = .Some(symbol_id);
                binding->availability = ProfileSet.all();
                return .Some(previous);
            }
        }

        self->bindings.push(ScopeBinding {
            name: String.from_str(self->allocator, name),
            symbol_id,
            debug_symbol_id: .Some(symbol_id),
            release_symbol_id: .Some(symbol_id),
            availability: ProfileSet.all(),
        });

        return .None;
    }

    pub fn bind_with_profiles(
        self: Self*,
        name: const uint8*,
        symbol_id: cir::SymbolId,
        profiles: ProfileSet,
        target_profile: Profile,
    ) Option<cir::SymbolId> {
        var debug_symbol_id: Option<cir::SymbolId> = .None;
        var release_symbol_id: Option<cir::SymbolId> = .None;

        if (profiles.debug) {
            debug_symbol_id = .Some(symbol_id);
        }

        if (profiles.release) {
            release_symbol_id = .Some(symbol_id);
        }

        for (var i: usize = 0; i < self->bindings.len(); i += 1) {
            var binding = self->bindings.get(i).unwrap();

            if (binding->name.as_str_const() == name) {
                const previous = binding->symbol_id;

                if (profiles.debug) {
                    binding->debug_symbol_id = .Some(symbol_id);
                }

                if (profiles.release) {
                    binding->release_symbol_id = .Some(symbol_id);
                }

                binding->availability = binding->availability.union_with(profiles);

                if (profiles.contains_profile(target_profile)) {
                    binding->symbol_id = symbol_id;
                }

                return .Some(previous);
            }
        }

        self->bindings.push(ScopeBinding {
            name: String.from_str(self->allocator, name),
            symbol_id,
            debug_symbol_id,
            release_symbol_id,
            availability: profiles,
        });

        return .None;
    }

    pub fn contains(self: const Self*, name: const uint8*) bool {
        switch (self->lookup(name)) {
            case .Some(symbol_id) => return true;
            case .None => return false;
        }
    }

    pub fn free(self: Self*) {
        const allocator = self->allocator;

        for (var i: usize = 0; i < self->bindings.len(); i += 1) {
            var binding = self->bindings.get_owned(i).unwrap();
            binding.name.free();
        }

        self->bindings.free();
        allocator.free(self);
    }
}

pub struct Module {
    pub scope: ScopeTable*,
}

pub struct Namespace {
    pub scope: ScopeTable*,
}

pub enum SymbolEntryKind {
    ProxiedSymbol { scope_id: cir::SymbolId, symbol_id: cir::SymbolId },
    ProxiedModule { symbol_id: cir::SymbolId },
    GlobalVar(cir::GlobalVarDeclId),
    Interface(cir::InterfaceDeclId),
    Typedef(cir::TypedefDeclId),
    Struct(cir::StructDeclId),
    Method(cir::MethodDeclId),
    Union(cir::UnionDeclId),
    Func(cir::FuncDeclId),
    Enum(cir::EnumDeclId),
    Namespace(Namespace),
    Var(cir::VarDeclId),
    Module(Module),
    Unresolved,
    Poisoned,
}

pub struct SymbolEntry {
    pub parent_scope_id: Option<cir::SymbolId>,
    pub vis_opt: Option<ASTVisibility>,
    pub kind: SymbolEntryKind,
    pub availability: ProfileSet,
    pub name: String,
    pub used: bool,

    pub fn free(self: Self*) {
        self->name.free();

        switch (self->kind) {
            case .Namespace(namespace) => namespace.scope->free();
            case .Module(module) => module.scope->free();
            else => {}
        }
    }
}

pub struct GlobalSymbolRegistry {
    pub allocator: Allocator,
    pub entries: Vec<SymbolEntry>,
    pub profile_pairs: Vec<ProfileSymbolPair>,
    root: Option<cir::SymbolId>,

    pub fn new(allocator: Allocator) Self {
        const entries: Vec<SymbolEntry> = Vec.new(allocator);

        var registry = Self {
            allocator,
            entries,
            profile_pairs: Vec.new(allocator),
            root: .None,
        };

        const root_id = registry.insert_symbol_entry(SymbolEntry {
            name: String.from_str(allocator, GLOBAL_NAMESPACE),
            parent_scope_id: .None,
            kind: .Namespace(Namespace {
                scope: alloc_init(allocator, ScopeTable.new(allocator)),
            }),
            availability: ProfileSet.all(),
            used: false,
            vis_opt: .None,
        });
        registry.root = .Some(root_id);

        return registry;
    }

    pub fn free(self: Self*) {
        for (var i: usize = 0; i < self->entries.len(); i += 1) {
            var entry = self->entries.get_owned(i).unwrap();
            entry.free();
        }

        self->entries.free();

        for (var i: usize = 0; i < self->profile_pairs.len(); i += 1) {
            var pair = self->profile_pairs.get_owned(i).unwrap();
            pair.name.free();
        }

        self->profile_pairs.free();
    }

    pub fn record_profile_pair(
        self: Self*,
        name: const uint8*,
        debug_symbol_id: cir::SymbolId,
        release_symbol_id: cir::SymbolId,
        span: Span,
    ) {
        if (debug_symbol_id == release_symbol_id) {
            return;
        }

        self->profile_pairs.push(ProfileSymbolPair {
            name: String.from_str(self->allocator, name),
            debug_symbol_id,
            release_symbol_id,
            span,
        });
    }

    pub fn root_scope_id(self: const Self*) cir::SymbolId {
        return self->root.unwrap();
    }

    pub fn insert_symbol_entry(self: Self*, entry: SymbolEntry) cir::SymbolId {
        const symbol_id = self->entries.len();
        self->entries.push(entry);
        return symbol_id;
    }

    pub fn insert_symbol_name(
        self: Self*,
        scope_id: cir::SymbolId,
        symbol_id: cir::SymbolId,
        name: const uint8*,
    ) {
        const scope_idx = self->resolve_concrete_scope_id(scope_id);
        const scope_entry = self->entries.get(scope_idx).unwrap();

        switch (scope_entry->kind) {
            case .Module(module) => module.scope->bind(name, symbol_id);
            case .Namespace(namespace) => namespace.scope->bind(name, symbol_id);
            else => @assert(false, "scope does not exist for given scope id");
        }
    }

    pub fn insert_symbol_name_with_profiles(
        self: Self*,
        scope_id: cir::SymbolId,
        symbol_id: cir::SymbolId,
        name: const uint8*,
        profiles: ProfileSet,
        target_profile: Profile,
    ) {
        const scope_idx = self->resolve_concrete_scope_id(scope_id);
        const scope_entry = self->entries.get(scope_idx).unwrap();

        switch (scope_entry->kind) {
            case .Module(module) => {
                module.scope->bind_with_profiles(
                    name, 
                    symbol_id, 
                    profiles, 
                    target_profile
                );
            }
            case .Namespace(namespace) => {
                namespace.scope->bind_with_profiles(
                    name, 
                    symbol_id, 
                    profiles, 
                    target_profile
                );
            }
            else => @assert(false, "scope does not exist for given scope id");
        }
    }

    pub fn insert_module_symbol(
        self: Self*,
        parent_scope_id: cir::SymbolId,
        ident: const uint8*,
        name: const uint8*,
    ) cir::SymbolId {
        const scope = alloc_init(self->allocator, ScopeTable.new(self->allocator));

        const module_symbol_id = self->insert_symbol_entry(SymbolEntry {
            name: String.from_str(self->allocator, name),
            parent_scope_id: .Some(parent_scope_id),
            kind: .Module(Module { scope }),
            availability: ProfileSet.all(),
            used: false,
            vis_opt: .None,
        });

        self->insert_symbol_name(parent_scope_id, module_symbol_id, ident);
        return module_symbol_id;
    }

    pub fn insert_namespace_symbol(
        self: Self*,
        parent_scope_id: cir::SymbolId,
        name: const uint8*,
        vis_opt: Option<ASTVisibility>,
    ) cir::SymbolId {
        return self->insert_namespace_symbol_with_profiles(
            parent_scope_id,
            name,
            vis_opt,
            ProfileSet.all(),
            .Debug
        );
    }

    pub fn insert_namespace_symbol_with_profiles(
        self: Self*,
        parent_scope_id: cir::SymbolId,
        name: const uint8*,
        vis_opt: Option<ASTVisibility>,
        profiles: ProfileSet,
        target_profile: Profile,
    ) cir::SymbolId {
        const scope = alloc_init(self->allocator, ScopeTable.new(self->allocator));

        const namespace_symbol_id = self->insert_symbol_entry(SymbolEntry {
            name: String.from_str(self->allocator, name),
            parent_scope_id: .Some(parent_scope_id),
            kind: .Namespace(Namespace { scope }),
            availability: profiles,
            used: false,
            vis_opt,
        });

        self->insert_symbol_name_with_profiles(parent_scope_id, namespace_symbol_id, name, profiles, target_profile);
        return namespace_symbol_id;
    }

    pub fn insert_unresolved_symbol(
        self: Self*,
        scope_id: cir::SymbolId,
        name: const uint8*,
        vis_opt: Option<ASTVisibility>,
    ) cir::SymbolId {
        return self->insert_unresolved_symbol_with_profiles(
            scope_id,
            name,
            vis_opt,
            ProfileSet.all(),
            .Debug
        );
    }

    pub fn insert_unresolved_symbol_with_profiles(
        self: Self*,
        scope_id: cir::SymbolId,
        name: const uint8*,
        vis_opt: Option<ASTVisibility>,
        profiles: ProfileSet,
        target_profile: Profile,
    ) cir::SymbolId {
        const symbol_id = self->insert_symbol_entry(SymbolEntry {
            name: String.from_str(self->allocator, name),
            parent_scope_id: .Some(scope_id),
            availability: profiles,
            kind: .Unresolved,
            used: false,
            vis_opt,
        });

        self->insert_symbol_name_with_profiles(
            scope_id, 
            symbol_id, 
            name, 
            profiles, 
            target_profile
        );
        return symbol_id;
    }

    pub fn insert_proxied_symbol(
        self: Self*,
        current_scope_id: cir::SymbolId,
        name: const uint8*,
        imported_scope_id: cir::SymbolId,
        target_symbol_id: cir::SymbolId,
    ) cir::SymbolId {
        // The proxy inherits visibility 
        // and availability from the target symbol
        var vis_opt: Option<ASTVisibility> = .None;
        var availability = ProfileSet.all();
        
        if (target_symbol_id < self->entries.len()) {
            const entry = self->entries.get_const(target_symbol_id).unwrap();
            vis_opt = entry->vis_opt;
            availability = entry->availability;
        }

        const proxy_id = self->insert_symbol_entry(SymbolEntry {
            name: String.from_str(self->allocator, name),
            parent_scope_id: .Some(current_scope_id),
            kind: .ProxiedSymbol {
                scope_id: imported_scope_id,
                symbol_id: target_symbol_id,
            },
            availability,
            used: false,
            vis_opt
        });

        self->insert_symbol_name_with_profiles(
            current_scope_id, 
            proxy_id, 
            name, 
            availability, 
            .Debug
        );
        return proxy_id;
    }

    pub fn insert_proxied_binding(
        self: Self*,
        current_scope_id: cir::SymbolId,
        name: const uint8*,
        imported_scope_id: cir::SymbolId,
        source_binding: const ScopeBinding*,
        target_profile: Profile,
    ) {
        switch (source_binding->debug_symbol_id) {
            case .Some(dbg_target) => {
                var vis_opt: Option<ASTVisibility> = .None;
                var profiles = ProfileSet.only_debug();

                if (dbg_target < self->entries.len()) {
                    vis_opt = self->entries.get_const(dbg_target).unwrap()->vis_opt;
                }

                switch (source_binding->release_symbol_id) {
                    case .Some(rel_target) => {
                        if (rel_target == dbg_target) {
                            profiles = ProfileSet.all();
                        }
                    }
                    case .None => {}
                }

                const dbg_proxy = self->insert_symbol_entry(SymbolEntry {
                    name: String.from_str(self->allocator, name),
                    parent_scope_id: .Some(current_scope_id),
                    kind: .ProxiedSymbol {
                        scope_id: imported_scope_id,
                        symbol_id: dbg_target,
                    },
                    availability: profiles,
                    used: false,
                    vis_opt,
                });

                self->insert_symbol_name_with_profiles(
                    current_scope_id,
                    dbg_proxy,
                    name,
                    profiles,
                    target_profile
                );
            }
            case .None => {}
        }

        switch (source_binding->release_symbol_id) {
            case .Some(rel_target) => {
                var same_as_debug = false;
                switch (source_binding->debug_symbol_id) {
                    case .Some(dbg_target) => {
                        if (dbg_target == rel_target) {
                            same_as_debug = true;
                        }
                    }
                    case .None => {}
                }

                if (!same_as_debug) {
                    var vis_opt: Option<ASTVisibility> = .None;

                    if (rel_target < self->entries.len()) {
                        vis_opt = self->entries.get_const(rel_target).unwrap()->vis_opt;
                    }

                    const rel_proxy = self->insert_symbol_entry(SymbolEntry {
                        name: String.from_str(self->allocator, name),
                        parent_scope_id: .Some(current_scope_id),
                        kind: .ProxiedSymbol {
                            scope_id: imported_scope_id,
                            symbol_id: rel_target,
                        },
                        availability: ProfileSet.only_release(),
                        used: false,
                        vis_opt,
                    });

                    self->insert_symbol_name_with_profiles(
                        current_scope_id,
                        rel_proxy,
                        name,
                        ProfileSet.only_release(),
                        target_profile
                    );
                }
            }
            case .None => {}
        }
    }

    pub fn insert_proxied_module(
        self: Self*,
        parent_scope_id: cir::SymbolId,
        name: const uint8*,
        target_symbol_id: cir::SymbolId,
    ) cir::SymbolId {
        self->upgrade_virtual_directory_module(parent_scope_id, name, target_symbol_id);

        const proxy_id = self->insert_symbol_entry(SymbolEntry {
            name: String.from_str(self->allocator, name),
            parent_scope_id: .Some(parent_scope_id),
            kind: .ProxiedModule { symbol_id: target_symbol_id },
            availability: ProfileSet.all(),
            used: false,
            vis_opt: .None,
        });

        self->insert_symbol_name(parent_scope_id, proxy_id, name);
        return proxy_id;
    }

    fn upgrade_virtual_directory_module(
        self: Self*,
        parent_scope_id: cir::SymbolId,
        name: const uint8*,
        target_symbol_id: cir::SymbolId,
    ) {
        switch (self->lookup_symbol_id_in_scope(parent_scope_id, name)) case .Some(existing) else {
            return;
        }

        const entry = self->entries.get_const(existing).unwrap();

        switch (entry->kind) {
            case .Module(module) => {
                for (var i: usize = 0; i < module.scope->bindings.len(); i += 1) {
                    const binding = module.scope->bindings.get_const(i).unwrap();

                    self->insert_symbol_name(
                        target_symbol_id,
                        binding->symbol_id,
                        binding->name.as_str_const()
                    );
                }
            }
            else => {}
        }
    }

    pub fn set_symbol_kind(self: Self*, symbol_id: cir::SymbolId, kind: SymbolEntryKind) {
        if (symbol_id >= self->entries.len()) {
            return;
        }

        var entry = self->entries.get(symbol_id).unwrap();
        entry->kind = kind;
    }

    pub fn lookup_symbol_id_in_scope(
        self: const Self*,
        scope_id: cir::SymbolId,
        name: const uint8*,
    ) Option<cir::SymbolId> {
        const index = self->resolve_concrete_scope_id(scope_id);

        if (index >= self->entries.len()) {
            return .None;
        }

        return self->lookup_in_single_scope(index, name);
    }

    pub fn lookup_binding_in_scope(
        self: const Self*,
        scope_id: cir::SymbolId,
        name: const uint8*,
    ) Option<const ScopeBinding*> {
        const index = self->resolve_concrete_scope_id(scope_id);

        if (index >= self->entries.len()) {
            return .None;
        }

        return self->lookup_binding_in_single_scope(index, name);
    }

    pub fn lookup_in_scope_chain(
        self: const Self*,
        scope_id: cir::SymbolId,
        name: const uint8*,
    ) Option<cir::SymbolId> {
        var current = self->resolve_concrete_scope_id(scope_id);

        while (true) {
            const current_idx = current;

            if (current_idx >= self->entries.len()) {
                return .None;
            }

            const found = self->lookup_in_single_scope(current_idx, name);

            switch (found) {
                case .Some(symbol_id) => {
                    return .Some(symbol_id);
                }
                case .None => {
                    const entry = self->entries.get_const(current_idx).unwrap();

                    switch (entry->parent_scope_id) {
                        case .Some(parent) => {
                            current = parent;
                            continue;
                        }
                        case .None => {
                            return .None;
                        }
                    }
                }
            }
        }

        @unreachable();
    }

    pub fn lookup_binding_in_scope_chain(
        self: const Self*,
        scope_id: cir::SymbolId,
        name: const uint8*,
    ) Option<const ScopeBinding*> {
        var current = self->resolve_concrete_scope_id(scope_id);

        while (true) {
            const current_idx = current;

            if (current_idx >= self->entries.len()) {
                return .None;
            }

            const found = self->lookup_binding_in_single_scope(current_idx, name);

            switch (found) {
                case .Some(binding) => {
                    return .Some(binding);
                }
                case .None => {
                    const entry = self->entries.get_const(current_idx).unwrap();

                    switch (entry->parent_scope_id) {
                        case .Some(parent) => {
                            current = parent;
                            continue;
                        }
                        case .None => {
                            return .None;
                        }
                    }
                }
            }
        }

        @unreachable();
    }

    pub fn resolve_concrete_scope_id(self: const Self*, scope_id: cir::SymbolId) cir::SymbolId {
        if (scope_id >= self->entries.len()) {
            return scope_id;
        }

        const entry = self->entries.get_const(scope_id).unwrap();

        switch (entry->kind) {
            case .ProxiedModule { symbol_id } => return self->resolve_concrete_scope_id(symbol_id);
            else => return scope_id;
        }
    }

    pub fn resolve_concrete_symbol_id(self: const Self*, symbol_id: cir::SymbolId) cir::SymbolId {
        if (symbol_id >= self->entries.len()) {
            return symbol_id;
        }

        const entry = self->entries.get_const(symbol_id).unwrap();

        switch (entry->kind) {
            case .ProxiedSymbol { symbol_id: target, .. } => return self->resolve_concrete_symbol_id(target);
            else => return symbol_id;
        }
    }

    pub fn symbol_name(self: const Self*, symbol_id: cir::SymbolId) Option<String> {
        if (symbol_id >= self->entries.len()) {
            return .None;
        }

        const entry = self->entries.get_const(symbol_id).unwrap();
        return .Some(entry->name.clone(self->allocator));
    }

    fn lookup_in_single_scope(
        self: const Self*,
        index: usize,
        name: const uint8*,
    ) Option<cir::SymbolId> {
        const entry = self->entries.get_const(index).unwrap();

        switch (entry->kind) {
            case .Namespace(namespace) => return namespace.scope->lookup(name);
            case .Module(module) => return module.scope->lookup(name);
            else => return .None;
        }
    }

    fn lookup_binding_in_single_scope(
        self: const Self*,
        index: usize,
        name: const uint8*,
    ) Option<const ScopeBinding*> {
        const entry = self->entries.get_const(index).unwrap();

        switch (entry->kind) {
            case .Namespace(namespace) => return namespace.scope->lookup_binding(name);
            case .Module(module) => return module.scope->lookup_binding(name);
            else => return .None;
        }
    }

    pub fn lookup_symbol_as_decl_id(self: const Self*, symbol_id: cir::SymbolId) Option<cir::DeclId> {
        const concrete = self->resolve_concrete_symbol_id(symbol_id);
        const entry = self->entries.get_const(concrete);

        switch (entry) {
            case .Some(e) => {
                switch (e->kind) {
                    case .GlobalVar(id) => return .Some(.GlobalVar(id));
                    case .Interface(id) => return .Some(.Interface(id));
                    case .Typedef(id) => return .Some(.Typedef(id));
                    case .Struct(id) => return .Some(.Struct(id));
                    case .Method(id) => return .Some(.Method(id));
                    case .Union(id) => return .Some(.Union(id));
                    case .Func(id) => return .Some(.Func(id));
                    case .Enum(id) => return .Some(.Enum(id));
                    case .Var(id) => return .Some(.Var(id));

                    case .ProxiedModule 
                    | .ProxiedSymbol 
                    | .Unresolved 
                    | .Poisoned
                    | .Namespace 
                    | .Module => return .None;
                }
            }
            case .None => return .None;
        }
    }

    pub fn insert_poisoned_symbol(
        self: Self*,
        scope_id: cir::SymbolId,
        name: const uint8*
    ) {
        if (self->lookup_symbol_id_in_scope(scope_id, name).is_some()) {
            return;
        }

        const entry_id = self->insert_symbol_entry(SymbolEntry {
            parent_scope_id: .Some(scope_id),
            vis_opt: .None,
            kind: .Poisoned,
            availability: ProfileSet.all(),
            name: String.from_str(self->allocator, name),
            used: true,
        });

        self->insert_symbol_name(scope_id, entry_id, name);
    }

}

pub fn is_decl_const(decl_tables: const DeclTables*, decl_id: cir::DeclId) bool {
    switch (decl_id) {
        case .GlobalVar(id) => {
            const decl = decl_tables->global_vars.get_const(id).unwrap();
            return decl->is_const;
        }
        case .Var(id) => {
            const decl = decl_tables->vars.get_const(id).unwrap();
            return decl->is_const;
        }
        else => return false;
    }
}

pub fn symbol_decl_id(
    registry: const GlobalSymbolRegistry*, 
    symbol_expr: const cir::SymbolExpr*
) Option<cir::DeclId> {
    switch (symbol_expr->as_decl_id()) {
        case .Some(decl_id) => return .Some(decl_id);
        else => {}
    }

    switch (symbol_expr->as_symbol_id()) {
        case .Some(symbol_id) => {
            return registry->lookup_symbol_as_decl_id(symbol_id);
        }
        case .None => return .None;
    }
}
