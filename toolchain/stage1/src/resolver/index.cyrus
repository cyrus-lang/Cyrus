import std::mem::arena{ArenaAllocator};
import std::mem{Allocator, alloc_init};
import std::io{Writer, StdoutWriter};
import std::collections{Vec};
import std::option{Option};
import std::string{String};
import std::path{Path};
import std::os;

import cir{ProgramTree, Stmt, StmtArena, StmtList};
import resolver::symbols{GlobalSymbolRegistry};
import resolver::dump{dump_resolver_symbols};
import cir::format{format_module_segments};
import resolver::context{TraverseContext};
import parser::ast{ASTProgram, ASTImport};
import driver::lexical{LexicalContext};
import cir::tables{DeclTables};
import resolver::traverse{
    bind_program_decl_names, 
    resolve_decl_full
};
import resolver::loader{
    resolve_import as fs_resolve_import,
    module_name_from_file_path,
    last_sub_module_name,
    last_sub_module_span,
    ResolvedModuleFile, 
    ResolverOptions,
};
import tokens{SourceTokens};
import resolver::modules;
import resolver::graph{ModuleGraph};
import source{SourceId};
import resolver::diags;
import cir{SymbolId};

pub struct SourceProgram {
    pub absolute_path: String,
    pub source_id: SourceId,
    pub program: ASTProgram*,
    pub tokens: SourceTokens
}

struct GroupImportRecord {
    pub scope: SymbolId,
    pub alias: String,
}

const RESOLVER_ARENA_SIZE: usize = 65536;

pub struct Resolver {
    pub allocator: Allocator,
    pub opts: const ResolverOptions*,
    pub decl_tables: DeclTables,
    pub lexical: const LexicalContext*,
    pub global_symbols: GlobalSymbolRegistry,
    pub program_trees: Vec<ProgramTree>,
    pub arena: ArenaAllocator,
    group_imports: Vec<GroupImportRecord>,
    module_symbols: Vec<modules::SourceSymbolBinding>,
    source_programs: Vec<SourceProgram>,
    visiting: modules::VisitingModule,

    pub fn new(
        allocator: Allocator,
        lexical: const LexicalContext*,
        opts: const ResolverOptions*
    ) Self {
        const arena = ArenaAllocator.new(allocator, RESOLVER_ARENA_SIZE);
        const decl_tables = DeclTables.new(allocator);

        return Self {
            allocator,
            global_symbols: GlobalSymbolRegistry.new(allocator),
            visiting: modules::VisitingModule.new(allocator),
            source_programs: Vec.new(allocator),
            module_symbols: Vec.new(allocator),
            program_trees: Vec.new(allocator),
            group_imports: Vec.new(allocator),
            decl_tables,
            lexical,
            arena,
            opts,
        };
    }

    pub fn free(self: Self*) {
        for (var i: usize = 0; i < self->source_programs.len(); i += 1) {
            var file = self->source_programs.get(i).unwrap();
            
            file->absolute_path.free();
            file->tokens.free();
            file->program->free();
            self->allocator.free(file->program);
        }

        self->source_programs.free();
        self->module_symbols.free();
        self->global_symbols.free();
        self->visiting.free();

        for (var i: usize = 0; i < self->group_imports.len(); i += 1) {
            var record = self->group_imports.get(i).unwrap();
            record->alias.free();
        }
        
        self->group_imports.free();
        self->program_trees.free();
        self->decl_tables.free();
        self->arena.destroy();
    }

    pub fn resolve_entry(
        self: Self*,
        source_id: SourceId,
        file_path: const uint8*,
        program: ASTProgram*
    ) {
        // A. Module discovery 
        //
        // Parses every reachable module once and
        // records the import graph;
        // declarations and bodies 
        // are untouched
        var graph = ModuleGraph.discover(
            self->allocator,
            &self->lexical->context->dctx,
            self->lexical,
            self->opts,
            file_path,
            source_id,
            program
        );
        defer graph.free();

        if (graph.has_errors || self->lexical->context->dctx.has_errors()) {
            return;
        }

        // B. Create the entry module symbol
        //
        // Imported modules get theirs when their
        // import edge is processed below
        self->create_entry_module_symbol(&graph);

        if (self->lexical->context->dctx.has_errors()) {
            return;
        }

        // C. Resolve modules recursively in import order
        var resolved: Vec<bool> = Vec.new(self->allocator);
        defer resolved.free();

        for (var i: usize = 0; i < graph.nodes.len(); i += 1) {
            resolved.push(false);
        }

        if (!self->resolve_module_recursive(&graph, 0, &resolved)) {
            return;
        }

        self->adopt_discovered_modules(&graph);
    }

    fn adopt_discovered_modules(self: Self*, graph: ModuleGraph*) {
        const allocator = self->allocator;

        for (var i: usize = 0; i < graph->nodes.len(); i += 1) {
            var node = graph->nodes.get(i).unwrap();

            if (!node->owns_program) {
                continue;
            }

            var tokens: SourceTokens;

            switch (node->tokens) {
                case .Some(owned_tokens) => tokens = owned_tokens;
                case .None => continue;
            }

            self->source_programs.push(SourceProgram {
                absolute_path: node->key.clone(allocator),
                source_id: node->source_id,
                program: node->program,
                tokens,
            });

            node->owns_program = false;
            node->tokens = .None;
        }
    }

    pub fn dump_symbols(self: Self*) {
        const writer: Writer = dynamic StdoutWriter.new();

        dump_resolver_symbols(
            &self->global_symbols, 
            &self->lexical->context->sctx,
            writer, 
            self->allocator
        );
    }

    fn create_entry_module_symbol(self: Self*, graph: ModuleGraph*) {
        const allocator = self->allocator;
        const entry = graph->nodes.get_const(0).unwrap();

        const entry_name = module_name_from_file_path(
            allocator,
            self->opts,
            entry->file_path.as_str_const()
        );

        const entry_symbol_id = self->global_symbols.insert_module_symbol(
            self->global_symbols.root_scope_id(),
            entry_name.as_str_const(),
            entry_name.as_str_const()
        );

        entry_name.free();

        self->module_symbols.push(modules::SourceSymbolBinding {
            source_id: entry->source_id,
            symbol_id: entry_symbol_id,
        });

        graph->nodes.get(0).unwrap()->symbol = .Some(entry_symbol_id);
    }

    fn resolve_module_recursive(
        self: Self*,
        graph: ModuleGraph*,
        index: usize,
        resolved: Vec<bool>*
    ) bool {
        const allocator = self->allocator;

        switch (resolved->get_const(index)) {
            case .Some(flag) => {
                if (*flag) {
                    return true;
                }
            }
            else => return false;
        }

        switch (resolved->get(index)) {
            case .Some(flag) => *flag = true;
            else => return false;
        }

        const node = graph->nodes.get_const(index).unwrap();

        var module_symbol_id: usize = 0;

        switch (node->symbol) {
            case .Some(symbol) => module_symbol_id = symbol;
            case .None => return false;
        }

        for (var e: usize = 0; e < node->edges.len(); e += 1) {
            const edge = node->edges.get_const(e).unwrap();

            const import_ast_node = 
                node->
                program->
                nodes.get_const(edge->import_node).unwrap();

            switch (*import_ast_node) {
                case .Import(import_) => {
                    const target_source_id = graph->nodes
                        .get_const(edge->target).unwrap()->source_id;

                    const segment = last_sub_module_name(allocator, &import_.segments);

                    const real_symbol_id = modules::get_or_create_module_symbol(
                        &self->global_symbols,
                        self->opts,
                        &self->module_symbols,
                        module_symbol_id,
                        target_source_id,
                        &edge->resolved,
                        segment.as_str_const()
                    );

                    segment.free();

                    const concrete = self->global_symbols
                        .resolve_concrete_scope_id(real_symbol_id);

                    const target_node = graph->nodes.get_const(edge->target).unwrap();

                    switch (target_node->symbol) {
                        case .None => {
                            const node = graph->nodes.get(edge->target).unwrap();
                            
                            node->symbol = .Some(concrete);
                        }
                        else => {}
                    }

                    if (!self->resolve_module_recursive(
                        graph,
                        edge->target,
                        resolved
                    )) {
                        return false;
                    }

                    if (!self->bind_resolved_import(
                        module_symbol_id,
                        &import_,
                        concrete,
                        edge->resolved.consumed_segments
                    )) {
                        return false;
                    }
                }
                else => {}
            }
        }

        bind_program_decl_names(
            &self->global_symbols,
            &self->lexical->context->dctx,
            allocator,
            module_symbol_id,
            node->program,
            self->opts->profile
        );

        var ctx = TraverseContext.new(
            dynamic self->arena,
            self->allocator,
            &self->lexical->context->dctx,
            &self->global_symbols,
            &self->decl_tables,
            node->source_id,
            self->opts->profile,
            module_symbol_id
        );

        const body = resolve_decl_full(&ctx, node->program);
        self->insert_program_tree(
            node->source_id,
            node->file_path.as_str_const(),
            body
        );
        ctx.free();

        return true;
    }

    fn insert_program_tree(
        self: Self*,
        source_id: SourceId,
        file_path: const uint8*,
        body: Vec<Stmt>,
    ) {
        const allocator: Allocator = dynamic self->arena;

        const module_name = module_name_from_file_path(allocator, self->opts, file_path);

        var arena = StmtArena.new(allocator);
        const start = arena.len();

        for (var i: usize = 0; i < body.len(); i += 1) {
            arena.alloc(body.get_owned(i).unwrap());
        }

        body.free();

        self->program_trees.push(ProgramTree {
            file_id: source_id,
            body: StmtList {
                start: @cast(uint32, start),
                len: @cast(uint32, arena.len() - start),
            },
            arena,
            file_name: String.from_str(allocator, file_path),
            module_name,
        });
    }

    /// Binds an import whose module has
    /// already been discovered by the graph.
    fn bind_resolved_import(
        self: Self*,
        parent_scope_id: SymbolId,
        import_: const ASTImport*,
        target_scope_id: SymbolId,
        consumed_segments: usize
    ) bool {
        const allocator = self->allocator;
        const dctx = &self->lexical->context->dctx;
        const span = import_->span;

        var alias = modules::group_alias(allocator, import_);

        switch (alias) {
            case .Some(name) => {
                if (self->group_import_already_done(parent_scope_id, name.as_str_const())) {
                    diags::report_import_twice(
                        dctx,
                        allocator,
                        span,
                        name.as_str_const()
                    );

                    name.free();
                    return false;
                }
            }
            else => {}
        }

        var current_symbol = target_scope_id;

        for (var i: usize = consumed_segments; i < import_->segments.len(); i += 1) {
            const segment_node = import_->segments.get_const(i).unwrap();

            switch (*segment_node) {
                case .SubModule(ident) => {
                    switch (self->global_symbols.lookup_symbol_id_in_scope(
                        current_symbol,
                        ident.str.as_str_const()
                    )) {
                        case .Some(found) => {
                            current_symbol = self->global_symbols
                                .resolve_concrete_scope_id(found);
                        }
                        case .None => {
                            diags::report_namespace_segment_not_found(
                                dctx,
                                allocator,
                                ident.span,
                                ident.str.as_str_const()
                            );

                            switch (alias) {
                                case .Some(str) => str.free();
                                else => {}
                            }

                            return false;
                        }
                    }
                }
                else => {}
            }
        }

        switch (alias) {
            case .Some(name) => {
                self->global_symbols.insert_proxied_module(
                    parent_scope_id,
                    name.as_str_const(),
                    current_symbol
                );

                self->group_imports.push(GroupImportRecord {
                    scope: parent_scope_id,
                    alias: String.from_str(allocator, name.as_str_const()),
                });

                name.free();
                return true;
            }
            case .None => {
                return self->resolve_single_import(
                    parent_scope_id,
                    current_symbol,
                    import_
                );
            }
        }
    }

    fn group_import_already_done(
        self: Self*,
        scope: SymbolId,
        alias: const uint8*
    ) bool {
        for (var i: usize = 0; i < self->group_imports.len(); i += 1) {
            const record = self->group_imports.get_const(i).unwrap();
            
            if (record->scope == scope && record->alias.as_str_const() == alias) {
                return true;
            }
        }

        return false;
    }

    fn resolve_single_import(
        self: Self*,
        parent_scope_id: SymbolId,
        module_symbol_id: SymbolId,
        import_: const ASTImport*
    ) bool {
        const allocator = self->allocator;
        const dctx = &self->lexical->context->dctx;

        if (import_->segments.len() == 0) {
            return true;
        }

        const source_scope_id = self->global_symbols.resolve_concrete_scope_id(module_symbol_id);
        const last = import_->segments.get_const(import_->segments.len() - 1).unwrap();
        var ok = true;

        switch (*last) {
            case .Single(singles) => {
                for (var i: usize = 0; i < singles.len(); i += 1) {
                    const single = singles.get_const(i).unwrap();
                    const actual = single->ident.str.as_str_const();
                    const single_span = single->ident.span;

                    var name = actual;

                    switch (single->renamed) {
                        case .Some(renamed) => name = renamed.str.as_str_const();
                        else => {}
                    }

                    switch (self->global_symbols.lookup_symbol_id_in_scope(source_scope_id, actual)) {
                        case .None => {
                            diags::report_symbol_not_found(dctx, allocator, single_span, actual);
                            ok = false;
                        }
                        case .Some(target) => {
                            const entry = self->global_symbols.entries
                                .get_const(target).unwrap();

                            switch (entry->kind) {
                                case .Namespace => {
                                    diags::report_namespace_as_single(
                                        dctx,
                                        allocator,
                                        single_span,
                                        entry->name.as_str_const()
                                    );
                                    ok = false;
                                }
                                else => {
                                    var is_private = false;

                                    switch (entry->vis_opt) {
                                        case .Some(.Private) => is_private = true;
                                        else => {}
                                    }

                                    if (is_private) {
                                        diags::report_private_symbol(
                                            dctx, 
                                            allocator, 
                                            single_span, 
                                            actual
                                        );
                                        ok = false;
                                    } else {
                                        switch (self->global_symbols.lookup_symbol_id_in_scope(parent_scope_id, name)) {
                                            case .Some => {
                                                diags::report_duplicate_symbol(
                                                    dctx, allocator, single_span, name
                                                );
                                                ok = false;
                                            }
                                            case .None => {
                                                self->global_symbols.insert_proxied_symbol(
                                                    parent_scope_id,
                                                    name,
                                                    source_scope_id,
                                                    target
                                                );
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            else => {}
        }

        return ok;
    }

    fn get_source_program(self: Self*, key: const uint8*) Option<usize> {
        for (var i: usize = 0; i < self->source_programs.len(); i += 1) {
            const entry = self->source_programs.get_const(i).unwrap();

            if (entry->absolute_path.as_str_const() == key) {
                return .Some(i);
            }
        }

        return .None;
    }
}