import std::mem{Allocator, alloc_init};
import std::collections{Vec};
import std::option{Option};
import std::string{String};
import std::path{Path};
import std::os;

import driver::lexical{LexicalContext};
import resolver::modules{visit_key};
import tokens{SourceTokens, Span};
import diags{DiagContext};
import resolver::loader{
    last_sub_module_span,
    is_feature_enabled,
    ResolvedModuleFile,
    ResolverOptions,
    resolve_import,
    LoaderError,
};
import parser::ast{
    ASTBuiltinBlock, 
    ASTProgram, 
    ASTImport, 
    NodeId
};
import source{SourceId};
import resolver::diags;
import abi::target{TargetInfo, PlatformMatch};
import cir;

/// A resolved import is 
/// one edge of the module graph.
pub struct ModuleEdge {
    pub resolved: ResolvedModuleFile,
    pub import_node: NodeId,
    pub target: usize,
    pub span: Span,
}

/// One module in the graph.
pub struct ModuleNode {
    pub tokens: Option<SourceTokens>,
    pub file_path: String,
    pub source_id: SourceId,
    pub program: ASTProgram*,
    pub owns_program: bool,
    pub has_errors: bool,
    pub edges: Vec<ModuleEdge>,
    pub parent: Option<usize>,
    pub parent_edge: Option<usize>,
    pub symbol: Option<usize>,
    pub key: String,
}

pub struct ModuleGraph {
    pub allocator: Allocator,
    pub dctx: DiagContext*,
    pub nodes: Vec<ModuleNode>,
    pub order: Vec<usize>,
    pub has_errors: bool,
    active: Vec<usize>,

    pub fn discover(
        allocator: Allocator,
        dctx: DiagContext*,
        lexical: const LexicalContext*,
        opts: const ResolverOptions*,
        entry_file_path: const uint8*,
        entry_source_id: SourceId,
        entry_program: ASTProgram*
    ) Self {
        var graph = Self {
            allocator,
            dctx,
            nodes: Vec.new(allocator),
            order: Vec.new(allocator),
            active: Vec.new(allocator),
            has_errors: false,
        };

        graph.nodes.push(ModuleNode {
            key: visit_key(allocator, entry_file_path),
            file_path: String.from_str(allocator, entry_file_path),
            source_id: entry_source_id,
            program: entry_program,
            tokens: .None,
            owns_program: false,
            has_errors: false,
            edges: Vec.new(allocator),
            parent: .None,
            parent_edge: .None,
            symbol: .None,
        });

        graph.visit_node(0, lexical, opts);
        return graph;
    }

    pub fn free(self: Self*) {
        for (var i: usize = 0; i < self->nodes.len(); i += 1) {
            var node = self->nodes.get(i).unwrap();

            node->key.free();
            node->file_path.free();

            switch (node->tokens) {
                case .Some(var tokens) => tokens.free();
                else => {}
            }

            if (node->owns_program) {
                node->program->free();
                self->allocator.free(node->program);
            }

            for (var e: usize = 0; e < node->edges.len(); e += 1) {
                var edge = node->edges.get(e).unwrap();
                edge->resolved.free();
            }

            node->edges.free();
        }

        self->nodes.free();
        self->order.free();
        self->active.free();
    }

    pub fn index_of(self: const Self*, key: const uint8*) Option<usize> {
        for (var i: usize = 0; i < self->nodes.len(); i += 1) {
            const node = self->nodes.get_const(i).unwrap();

            if (node->key.as_str_const() == key) {
                return .Some(i);
            }
        }

        return .None;
    }

    fn active_contains(self: const Self*, index: usize) bool {
        for (var i: usize = 0; i < self->active.len(); i += 1) {
            if (*self->active.get_const(i).unwrap() == index) {
                return true;
            }
        }

        return false;
    }

    fn report_cycle(self: Self*, span: Span) {
        var paths: Vec<String> = Vec.new(self->allocator);

        for (var i: usize = 0; i < self->active.len(); i += 1) {
            const node = self->nodes.get_const(
                *self->active.get_const(i).unwrap()
            ).unwrap();
            
            paths.push(visit_key(
                self->allocator, 
                node->file_path.as_str_const()
            ));
        }

        diags::report_import_cycle(
            self->dctx,
            self->allocator,
            span,
            &paths
        );

        for (var i: usize = 0; i < paths.len(); i += 1) {
            var path = paths.get(i).unwrap();
            path->free();
        }

        paths.free();
        self->has_errors = true;
    }

    fn visit_node(
        self: Self*,
        index: usize,
        lexical: const LexicalContext*,
        opts: const ResolverOptions*
    ) {
        self->active.push(index);

        const entry_node = self->nodes.get_const(index).unwrap();

        switch (entry_node->program->statements) {
            case .Some(statements) => {
                self->discover_stmt_list(
                    index,
                    statements.start,
                    statements.len,
                    lexical,
                    opts
                );
            }
            else => {}
        }

        self->active.remove(self->active.len() - 1);
        self->order.push(index);
    }

    fn discover_stmt_list(
        self: Self*,
        index: usize,
        start: usize,
        count: usize,
        lexical: const LexicalContext*,
        opts: const ResolverOptions*
    ) {
        var position: usize = 0;

        while (position < count) {
            const node = self->nodes.get_const(index).unwrap();
            const program = node->program;
            const node_id = program->children.get_owned(start + position).unwrap();

            position += 1;

            const ast_node = program->nodes.get_const(node_id).unwrap();

            switch (*ast_node) {
                case .Import(import_) => {
                    self->discover_import(index, &import_, node_id, lexical, opts);
                }
                case .Builtin(.BuiltinBlock(builtin_block)) => {
                    var block_active = false;

                    switch (cir::lookup_builtin(builtin_block.name.str.as_str_const())) {
                        case .Some(.Feature) => {
                            switch (ast_feature_block_name(program, &builtin_block)) {
                                case .Some(feature_name) => {
                                    block_active = is_feature_enabled(&opts->features, feature_name);
                                }
                                case .None => {}
                            }
                        }
                        case .Some(builtin_kind) => {
                            if (cir::is_platform_builtin_kind(builtin_kind)) {
                                block_active = ast_platform_block_active(
                                    program,
                                    &builtin_block,
                                    builtin_kind,
                                    &opts->target
                                );
                            }
                        }
                        case .None => {}
                    }

                    if (block_active) {
                        const block_node = program->nodes.get_const(builtin_block.block).unwrap();

                        switch (*block_node) {
                            case .Block(inner_block) => {
                                self->discover_stmt_list(
                                    index,
                                    inner_block.stmts.start,
                                    inner_block.stmts.len,
                                    lexical,
                                    opts
                                );
                            }
                            else => {}
                        }
                    }
                }
                else => {}
            }
        }
    }

    fn discover_import(
        self: Self*,
        from: usize,
        import_: const ASTImport*,
        import_node: NodeId,
        lexical: const LexicalContext*,
        opts: const ResolverOptions*
    ) {
        const allocator = self->allocator;

        const parent_path = 
            self->nodes.get_const(from).unwrap()->file_path.as_str_const();

        const load = resolve_import(
            allocator,
            opts,
            &import_->segments,
            import_->relative_level,
            parent_path
        );

        switch (load) {
            case .Error(err) => {
                self->report_load_error(import_, err);
                self->nodes.get(from).unwrap()->has_errors = true;
                err.free();
                return;
            }
            case .Value(var resolved) => {
                const key = visit_key(allocator, resolved.file_path.as_str_const());

                switch (self->index_of(key.as_str_const())) {
                    case .Some(existing) => {
                        if (self->active_contains(existing)) {
                            self->report_cycle(last_sub_module_span(&import_->segments));
                            self->nodes.get(from).unwrap()->has_errors = true;
                            key.free();
                            resolved.free();
                            return;
                        }

                        if (self->nodes.get_const(existing).unwrap()->has_errors) {
                            self->nodes.get(from).unwrap()->has_errors = true;
                        }

                        self->push_edge(from, import_, import_node, existing, resolved);
                        key.free();
                        return;
                    }
                    case .None => {}
                }

                if (!os::is_file(resolved.file_path.as_str_const())) {
                    diags::report_module_not_found(
                        self->dctx,
                        allocator,
                        last_sub_module_span(&import_->segments),
                        key.as_str_const()
                    );

                    self->has_errors = true;
                    self->nodes.get(from).unwrap()->has_errors = true;
                    key.free();
                    resolved.free();
                    return;
                }

                const path = Path.new(allocator, resolved.file_path.as_str_const());

                switch (lexical->tokenize_source(path)) case .Value(var source_tokens) else {
                    const target = self->nodes.len();

                    self->nodes.push(ModuleNode {
                        key,
                        file_path: String.from_str(allocator, resolved.file_path.as_str_const()),
                        source_id: 0,
                        program: null,
                        tokens: .None,
                        owns_program: false,
                        has_errors: true,
                        edges: Vec.new(allocator),
                        parent: .Some(from),
                        parent_edge: .None,
                        symbol: .None,
                    });
                    
                    self->push_edge(from, import_, import_node, target, resolved);
                    self->nodes.get(from).unwrap()->has_errors = true;
                    self->has_errors = true;
                    return;
                }

                const target_source_id = source_tokens.source_id;

                switch (lexical->parse_source(source_tokens)) case .Value(var parsed) else {
                    source_tokens.free();
                    const target = self->nodes.len();

                    self->nodes.push(ModuleNode {
                        key,
                        file_path: String.from_str(allocator, resolved.file_path.as_str_const()),
                        source_id: target_source_id,
                        program: null,
                        tokens: .None,
                        owns_program: false,
                        has_errors: true,
                        edges: Vec.new(allocator),
                        parent: .Some(from),
                        parent_edge: .None,
                        symbol: .None,
                    });

                    self->push_edge(from, import_, import_node, target, resolved);
                    self->nodes.get(from).unwrap()->has_errors = true;
                    self->has_errors = true;
                    return;
                }

                const target = self->nodes.len();

                self->nodes.push(ModuleNode {
                    file_path: String.from_str(allocator, resolved.file_path.as_str_const()),
                    program: alloc_init(allocator, parsed),
                    source_id: target_source_id,
                    tokens: .Some(source_tokens),
                    edges: Vec.new(allocator),
                    parent: .Some(from),
                    parent_edge: .None,
                    owns_program: true,
                    has_errors: false,
                    symbol: .None,
                    key,
                });

                self->push_edge(from, import_, import_node, target, resolved);

                // Recurse only after the edge and node are in place, so a
                // cycle back to `target` is reported through `active`
                self->visit_node(target, lexical, opts);
                return;
            }
        }
    }

    fn push_edge(
        self: Self*,
        from: usize,
        import_: const ASTImport*,
        import_node: NodeId,
        target: usize,
        resolved: ResolvedModuleFile
    ) {
        const edge_index = self->nodes.get_const(from).unwrap()->edges.len();

        self->nodes.get(from).unwrap()->edges.push(ModuleEdge {
            span: import_->span,
            import_node,
            target,
            resolved,
        });

        const target_node = self->nodes.get(target).unwrap();

        switch (target_node->parent) {
            case .None => {
                target_node->parent = .Some(from);
                target_node->parent_edge = .Some(edge_index);
            }
            else => {}
        }
    }

    fn report_load_error(
        self: Self*,
        import_: const ASTImport*,
        err: LoaderError
    ) {
        const allocator = self->allocator;

        switch (err) {
            case .RelativeImportEscapesProjectRoot => {
                diags::report_relative_import_escapes_project_root(
                    self->dctx, allocator, import_->span
                );
            }
            case .ModuleNotFound(name, span) => {
                diags::report_module_not_found(
                    self->dctx, allocator, span, name.as_str_const()
                );
            }
            case .DuplicateModule(name) => {
                diags::report_duplicate_module(
                    self->dctx, allocator, import_->span, name.as_str_const()
                );
            }
            case .ModuleCannotImportItself => {
                diags::report_module_cannot_import_itself(
                    self->dctx, allocator, import_->span
                );
            }
            case .StdlibNotFound => {
                diags::report_stdlib_not_found(
                    self->dctx, allocator, import_->span
                );
            }
        }

        self->has_errors = true;
    }
}

fn ast_feature_block_name(
    program: const ASTProgram*,
    builtin_block: const ASTBuiltinBlock*
) Option<const uint8*> {
    if (builtin_block->args.len() != 1) {
        return .None;
    }

    const argument_node_id = builtin_block->args.get_owned(0).unwrap();
    const argument_node = program->nodes.get_const(argument_node_id).unwrap();

    switch (*argument_node) {
        case .Expr(.Literal(token)) => {
            switch (*token.kind) {
                case .Literal(literal) => {
                    switch (literal) {
                        case .String { value, suffix: .None } => {
                            return .Some(value.as_str_const());
                        }
                        else => {}
                    }
                }
                else => {}
            }
        }
        else => {}
    }

    return .None;
}

fn ast_platform_block_active(
    program: const ASTProgram*,
    builtin_block: const ASTBuiltinBlock*,
    builtin_kind: cir::BuiltinKind,
    target: const TargetInfo*
) bool {
    if (builtin_block->args.len() == 0) {
        return false;
    }

    var any_matched = false;

    for (var i: usize = 0; i < builtin_block->args.len(); i += 1) {
        const argument_node_id = builtin_block->args.get_owned(i).unwrap();
        const argument_node = program->nodes.get_const(argument_node_id).unwrap();

        switch (*argument_node) {
            case .Expr(.UnnamedEnumValue(enum_value)) => {
                switch (enum_value.kind) {
                    case .Plain => {
                        const variant_name = enum_value.ident.str.as_str_const();
                        const match_result = target->match_platform_builtin_variant(
                            builtin_kind,
                            variant_name
                        );

                        switch (match_result) {
                            case .Matched => {
                                any_matched = true;
                            }
                            case .NotMatched => {}
                            case .UnknownVariant => return false;
                        }
                    }
                    else => return false;
                }
            }
            else => return false;
        }
    }

    return any_matched;
}
