import std::mem{Allocator};
import std::string{String};

import diags{DiagContext, Diag};
import tokens{Span};

/// Report that an imported module file could not be located.
pub fn report_module_not_found(
    dctx: DiagContext*,
    allocator: Allocator,
    span: Span,
    name: const uint8*,
) {
    var msg = String.new(allocator);
    msg.push_str("module `");
    msg.push_str(name);
    msg.push_str("` not found");

    var help = String.new(allocator);
    help.push_str("check that it exists under one of the configured source directories");

    const diag = Diag.new(allocator, .Error, msg.as_str_const(), span);
    diag->help(help.as_str_const());
    dctx->report(diag);

    msg.free();
    help.free();
}

/// Report that no stdlib directory is configured.
pub fn report_stdlib_not_found(
    dctx: DiagContext*,
    allocator: Allocator,
    span: Span,
) {
    var msg = String.from_str(allocator, "standard library not found");
    var help = String.new(allocator);
    help.push_str("set it with `CYRUS_STDLIB_PATH` environment variable or `--stdlib` command line argument");

    const diag = Diag.new(allocator, .Error, msg.as_str_const(), span);
    diag->help(help.as_str_const());
    dctx->report(diag);

    msg.free();
    help.free();
}

/// Report a module name that resolves to both a file and a directory.
pub fn report_duplicate_module(
    dctx: DiagContext*,
    allocator: Allocator,
    span: Span,
    name: const uint8*,
) {
    var msg = String.new(allocator);
    msg.push_str("module `");
    msg.push_str(name);
    msg.push_str("` is both a file and a directory");

    var help = String.new(allocator);
    help.push_str("keep only one of `");
    help.push_str(name);
    help.push_str(".cyrus` or the `");
    help.push_str(name);
    help.push_str("/` directory");

    const diag = Diag.new(allocator, .Error, msg.as_str_const(), span);
    diag->help(help.as_str_const());
    dctx->report(diag);

    msg.free();
    help.free();
}

/// Report a module importing itself.
pub fn report_module_cannot_import_itself(
    dctx: DiagContext*,
    allocator: Allocator,
    span: Span,
) {
    var msg = String.from_str(allocator, "module cannot import itself");

    const diag = Diag.new(allocator, .Error, msg.as_str_const(), span);
    diag->help("remove this import statement");
    dctx->report(diag);

    msg.free();
}

/// Report a relative import climbing above the project root.
pub fn report_relative_import_escapes_project_root(
    dctx: DiagContext*,
    allocator: Allocator,
    span: Span,
) {
    var msg = String.from_str(allocator, "relative import escapes the project root");

    const diag = Diag.new(allocator, .Error, msg.as_str_const(), span);
    diag->help("use a path that stays under the project base directory");
    dctx->report(diag);

    msg.free();
}

/// Report an import cycle. `active_paths` is the formatted chain of
/// module paths currently being resolved (first path repeated last).
pub fn report_import_cycle(
    dctx: DiagContext*,
    allocator: Allocator,
    span: Span,
    active_paths: const uint8*,
) {
    var msg = String.new(allocator);
    msg.push_str("import cycle detected:\n\n");
    msg.push_str(active_paths);

    const diag = Diag.new(allocator, .Error, msg.as_str_const(), span);
    diag->help("break the cycle by removing one import");
    dctx->report(diag);

    msg.free();
}

/// Report that the same module group was imported twice in one scope.
pub fn report_import_twice(
    dctx: DiagContext*,
    allocator: Allocator,
    span: Span,
    module_name: const uint8*,
) {
    var msg = String.new(allocator);
    msg.push_str("module `");
    msg.push_str(module_name);
    msg.push_str("` imported twice");

    const diag = Diag.new(allocator, .Error, msg.as_str_const(), span);
    diag->help("consider removing the previous declaration");
    dctx->report(diag);

    msg.free();
}

/// Report a name that could not be found in the current scope.
pub fn report_symbol_not_found(
    dctx: DiagContext*,
    allocator: Allocator,
    span: Span,
    name: const uint8*,
) {
    var msg = String.new(allocator);
    msg.push_str("symbol `");
    msg.push_str(name);
    msg.push_str("` not found");

    const diag = Diag.new(allocator, .Error, msg.as_str_const(), span);
    diag->help("declare or import it before use");
    dctx->report(diag);

    msg.free();
}

/// Report a path segment that is missing from an already loaded module.
pub fn report_namespace_segment_not_found(
    dctx: DiagContext*,
    allocator: Allocator,
    span: Span,
    name: const uint8*,
) {
    var msg = String.new(allocator);
    msg.push_str("symbol `");
    msg.push_str(name);
    msg.push_str("` not found");

    var help = String.new(allocator);
    help.push_str("declare it with `mod ");
    help.push_str(name);
    help.push_str(" { ... }` inside that module or import the correct path");

    const diag = Diag.new(allocator, .Error, msg.as_str_const(), span);
    diag->help(help.as_str_const());
    dctx->report(diag);

    msg.free();
    help.free();
}

/// Report a namespace (inline `mod`) imported through `{ }` items.
pub fn report_namespace_as_single(
    dctx: DiagContext*,
    allocator: Allocator,
    span: Span,
    name: const uint8*,
) {
    var msg = String.new(allocator);
    msg.push_str("namespace `");
    msg.push_str(name);
    msg.push_str("` cannot be imported as a single item");

    var help = String.new(allocator);
    help.push_str("import it as a path segment instead");

    const diag = Diag.new(allocator, .Error, msg.as_str_const(), span);
    diag->help(help.as_str_const());
    dctx->report(diag);

    msg.free();
    help.free();
}

/// Report a private symbol pulled in through a single import.
pub fn report_private_symbol(
    dctx: DiagContext*,
    allocator: Allocator,
    span: Span,
    name: const uint8*,
) {
    var msg = String.new(allocator);
    msg.push_str("symbol `");
    msg.push_str(name);
    msg.push_str("` is private");

    const diag = Diag.new(allocator, .Error, msg.as_str_const(), span);
    diag->help("declare it as `pub` to make it importable");
    dctx->report(diag);

    msg.free();
}

/// Report a name declared twice in the same scope.
pub fn report_duplicate_symbol(
    dctx: DiagContext*,
    allocator: Allocator,
    span: Span,
    name: const uint8*,
) {
    var msg = String.new(allocator);
    msg.push_str("symbol `");
    msg.push_str(name);
    msg.push_str("` is already declared");

    const diag = Diag.new(allocator, .Error, msg.as_str_const(), span);
    diag->help("remove or rename the duplicate declaration");
    dctx->report(diag);

    msg.free();
}
