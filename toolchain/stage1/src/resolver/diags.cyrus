pub fn report_duplicate_method_name(
    dctx: DiagContext*,
    allocator: Allocator,
    span: Span,
    struct_name: const uint8*,
    method_name: const uint8*,
) {
    var msg = String.new(allocator);
    msg.push_str("duplicate declaration of method `");
    msg.push_str(method_name);
    msg.push_str("` in `");
    msg.push_str(struct_name);
    msg.push_str("`");

    var help = String.new(allocator);
    help.push_str("consider renaming the method to a different name");

    const diag = Diag.new(allocator, .Error, msg.as_str_const(), span);
    diag->help(help.as_str_const());
    dctx->report(diag);

    msg.free();
    help.free();
}

pub fn report_if_duplicate_method_names(
    dctx: DiagContext*,
    allocator: Allocator,
    program: const ast::ASTProgram*,
    object_name: const uint8*,
    methods: const Vec<ast::NodeId>*
) {
    for (var i: usize = 0; i < methods->len(); i += 1) {
        const node_id = methods->get_owned(i).unwrap();

        switch (*program->nodes.get_const(node_id).unwrap()) {
            case .FuncDef(func_def) => {
                const name = func_def.ident.str.as_str_const();
                var dup = false;

                var j: usize = 0;

                while (!dup && j < i) {
                    const prev_node_id = methods->get_owned(j).unwrap();

                    switch (*program->nodes.get_const(prev_node_id).unwrap()) {
                        case .FuncDef(prev_func_def) => {
                            if (prev_func_def.ident.str.as_str_const() == name) {
                                dup = true;
                            }
                        }
                    }

                    j += 1;
                }

                if (dup) {
                    report_duplicate_method_name(dctx, allocator, func_def.span, object_name, name);
                }
            }
        }
    }
}

pub fn report_invalid_struct_init_operand(
    dctx: DiagContext*,
