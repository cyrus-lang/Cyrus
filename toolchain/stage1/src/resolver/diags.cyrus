import std::collections{Vec};
import std::mem{Allocator};
import std::string{String};

import diags{DiagContext, Diag};
import tokens{Span};
import parser::ast;

pub fn report_module_not_found(
    dctx: DiagContext*,
    allocator: Allocator,
    span: Span,
    name: const uint8*,
) {
    var msg = String.new(allocator);
    msg.push_str("module `");
    msg.push_str(name);
    msg.push_str("` not found");

    var help = String.new(allocator);
    help.push_str("check that it exists under one of the configured source directories");

    const diag = Diag.new(allocator, .Error, msg.as_str_const(), span);
    diag->help(help.as_str_const());
    dctx->report(diag);

    msg.free();
    help.free();
}

pub fn report_stdlib_not_found(
    dctx: DiagContext*,
    allocator: Allocator,
    span: Span,
) {
    var msg = String.from_str(allocator, "standard library not found");
    var help = String.new(allocator);
    help.push_str("set it with `CYRUS_STDLIB_PATH` environment variable or `--stdlib` command line argument");

    const diag = Diag.new(allocator, .Error, msg.as_str_const(), span);
    diag->help(help.as_str_const());
    dctx->report(diag);

    msg.free();
    help.free();
}

pub fn report_duplicate_module(
    dctx: DiagContext*,
    allocator: Allocator,
    span: Span,
    name: const uint8*,
) {
    var msg = String.new(allocator);
    msg.push_str("module `");
    msg.push_str(name);
    msg.push_str("` is both a file and a directory");

    var help = String.new(allocator);
    help.push_str("keep only one of `");
    help.push_str(name);
    help.push_str(".cyrus` or the `");
    help.push_str(name);
    help.push_str("/` directory");

    const diag = Diag.new(allocator, .Error, msg.as_str_const(), span);
    diag->help(help.as_str_const());
    dctx->report(diag);

    msg.free();
    help.free();
}

