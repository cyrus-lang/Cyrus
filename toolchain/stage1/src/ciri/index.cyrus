import std::collections{Vec};
import std::option{Option};
import std::mem{Allocator};
import std::string{String};

import cir::tables{DeclTables};
import resolver::symbols{
    GlobalSymbolRegistry, 
    is_decl_const, 
    symbol_decl_id
};
import cir;

pub fn fold_const_expr_int(
    decl_tables: const DeclTables*, 
    registry: const GlobalSymbolRegistry*, 
    expr: const cir::Expr*
) Option<cir::IntegerLiteral> {
    var visited: Vec<cir::GlobalVarDeclId> = Vec.new(decl_tables->allocator);
    defer visited.free();

    return fold_const_expr_int_depth(
        decl_tables, 
        registry, 
        expr, 
        0, 
        &visited
    );
}

fn contains_global_var_id(
    list: const Vec<cir::GlobalVarDeclId>*, 
    target: cir::GlobalVarDeclId
) Option<usize> {
    for (var i: usize = 0; i < list->len(); i += 1) {
        if (*list->get_const(i).unwrap() == target) {
            return .Some(i);
        }
    }
    return .None;
}

fn fold_const_expr_int_depth(
    decl_tables: const DeclTables*,
    registry: const GlobalSymbolRegistry*,
    expr: const cir::Expr*,
    depth: usize,
    visited: Vec<cir::GlobalVarDeclId>*
) Option<cir::IntegerLiteral> {
    if (depth > 32) {
        return .None;
    }

    switch (expr->kind) {
        case .Literal(literal) => {
            switch (literal.kind) {
                case .Integer { value, .. } => {
                    switch (value) {
                        case .Unsigned(x) => return .Some(.Unsigned(x));
                        case .Signed(x) => return .Some(.Signed(x));
                    }
                }
                case .Bool(x) => {
                    if (x) {
                        return .Some(.Unsigned(1));
                    } else {
                        return .Some(.Unsigned(0));
                    }
                }
                else => {}
            }
        }

        case .Symbol(symbol_expr) => {
            switch (symbol_decl_id(registry, &symbol_expr)) {
                case .Some(decl_id) => {
                    if (!is_decl_const(decl_tables, decl_id)) {
                        return .None;
                    }

                    switch (decl_id) {
                        case .GlobalVar(global_var_decl_id) => {
                            if (contains_global_var_id(visited, global_var_decl_id).is_some()) {
                                return .None;
                            }

                            const global_var_decl = 
                                decl_tables->global_vars.get_const(global_var_decl_id).unwrap();

                            switch (global_var_decl->rhs) {
                                case .Some(rhs) => {
                                    visited->push(global_var_decl_id);
                                    const res = fold_const_expr_int_depth(
                                        decl_tables, 
                                        registry, 
                                        &rhs, 
                                        depth + 1, 
                                        visited
                                    );
                                    visited->pop();
                                    return res;
                                }
                                else => {}
                            }
                        }
                        else => return .None;
                    }
                }
                else => {}
            }
        }

        case .Prefix(prefix_expr) => {
            switch (prefix_expr.op) {
                case .Minus => {
                    const inner = fold_const_expr_int_depth(
                        decl_tables, 
                        registry, 
                        prefix_expr.operand, 
                        depth + 1,
                        visited
                    );
                    
                    switch (inner) {
                        case .Some(.Signed(x)) => return .Some(.Signed(-x));
                        case .Some(.Unsigned) => return .None;
                        else => {}
                    }
                }
                else => {}
            }
        }

        case .Infix(infix_expr) => {
            const lhs = fold_const_expr_int_depth(decl_tables, registry, infix_expr.lhs, depth + 1, visited);
            const rhs = fold_const_expr_int_depth(decl_tables, registry, infix_expr.rhs, depth + 1, visited);

            switch (lhs) case .Some(lv) else {
                return .None;
            }

            switch (rhs) case .Some(rv) else {
                return .None;
            }

            switch (lv) {
                case .Signed(ls) => {
                    switch (rv) case .Signed(rs) else {
                        return .None;
                    }

                    switch (infix_expr.op) {
                        case .Add => return .Some(.Signed(ls + rs));
                        case .Sub => return .Some(.Signed(ls - rs));
                        case .Mul => return .Some(.Signed(ls * rs));

                        case .Div => {
                            if (rs == 0) {
                                return .None;
                            }
                            return .Some(.Signed(ls / rs));
                        }
                        
                        case .Rem => {
                            if (rs == 0) {
                                return .None;
                            }
                            return .Some(.Signed(ls % rs));
                        }
                        
                        else => return .None;
                    }
                }
                case .Unsigned(lu) => {
                    switch (rv) case .Unsigned(ru) else {
                        return .None;
                    }

                    switch (infix_expr.op) {
                        case .Add => return .Some(.Unsigned(lu + ru));
                        case .Sub => return .Some(.Unsigned(lu - ru));
                        case .Mul => return .Some(.Unsigned(lu * ru));
                        
                        case .Div => {
                            if (ru == 0) {
                                return .None;
                            }
                            return .Some(.Unsigned(lu / ru));
                        }
                        
                        case .Rem => {
                            if (ru == 0) {
                                return .None;
                            }
                            return .Some(.Unsigned(lu % ru));
                        }
                        
                        else => {}
                    }
                }
            }
        }
        else => {}
    }

    return .None;
}


pub fn fold_const_expr(
    decl_tables: const DeclTables*,
    registry: const GlobalSymbolRegistry*,
    expr: cir::Expr*
) {
    switch (expr->kind) {
        case .Prefix(prefix_expr) => {
            fold_const_expr(decl_tables, registry, prefix_expr.operand);
        }
        case .Infix(infix_expr) => {
            fold_const_expr(decl_tables, registry, infix_expr.lhs);
            fold_const_expr(decl_tables, registry, infix_expr.rhs);
        }
        case .ArrayIndex(array_index) => {
            fold_const_expr(decl_tables, registry, array_index.operand);
            fold_const_expr(decl_tables, registry, array_index.index);
        }
        case .Array(array_expr) => {
            for (var i: usize = 0; i < array_expr.elements.len(); i += 1) {
                const element = array_expr.elements.get(i).unwrap();
                fold_const_expr(decl_tables, registry, element);
            }
        }
        else => {}
    }

    switch (fold_const_expr_int(decl_tables, registry, expr)) {
        case .Some(x) => {
            switch (x) {
                case .Signed(val) => {
                    expr->kind = .Literal(cir::LiteralExpr {
                        ty: expr->ty,
                        kind: .Integer { value: .Signed(val), suffix: .None },
                        span: expr->span,
                    });
                }
                case .Unsigned(val) => {
                    expr->kind = .Literal(cir::LiteralExpr {
                        ty: expr->ty,
                        kind: .Integer { value: .Signed(@cast(int128, val)), suffix: .None },
                        span: expr->span,
                    });
                }
            }
        }
        case .None => {}
    }
}

pub fn is_expr_const_evaluable(kind: const cir::ExprKind*) bool {
    switch (*kind) {
        case .Prefix(prefix) => {
            return is_expr_const_evaluable(&prefix.operand->kind);
        }
        
        case .Infix(infix) => {
            return is_expr_const_evaluable(&infix.lhs->kind)
                && is_expr_const_evaluable(&infix.rhs->kind);
        }
        
        case .InlineAsm 
        | .Poisoned 
        | .Builtin => return false;

        case .SemaType 
        | .Literal 
        | .Lambda => return true;

        else => return false;
    }
}

pub fn detect_const_eval_cycle(
    decl_tables: const DeclTables*,
    registry: const GlobalSymbolRegistry*,
    start_id: cir::GlobalVarDeclId,
    allocator: Allocator,
    cycle_ids_out: Vec<cir::GlobalVarDeclId>*
) Option<Vec<String>> {
    var visiting: Vec<cir::GlobalVarDeclId> = Vec.new(allocator);
    defer visiting.free();

    const start_decl = decl_tables->global_vars.get_const(start_id).unwrap();

    switch (start_decl->rhs) {
        case .Some(rhs) => {
            visiting.push(start_id);
            
            return detect_const_cycle_in_expr(
                decl_tables, 
                registry, 
                &rhs, 
                &visiting, 
                allocator, 
                cycle_ids_out
            );
        }
        case .None => return .None;
    }
}

fn detect_const_cycle_in_expr(
    decl_tables: const DeclTables*,
    registry: const GlobalSymbolRegistry*,
    expr: const cir::Expr*,
    visiting: Vec<cir::GlobalVarDeclId>*,
    allocator: Allocator,
    cycle_ids_out: Vec<cir::GlobalVarDeclId>*
) Option<Vec<String>> {
    switch (expr->kind) {
        case .Symbol(symbol_expr) => {
            switch (symbol_decl_id(registry, &symbol_expr)) {
                case .Some(.GlobalVar(dep_id)) => {
                    switch (contains_global_var_id(visiting, dep_id)) {
                        case .Some(cycle_start) => {
                            var cycle: Vec<String> = Vec.new(allocator);

                            for (var i: usize = cycle_start; i < visiting->len(); i += 1) {
                                const id = visiting->get_owned(i).unwrap();
                                const decl = decl_tables->global_vars.get_const(id).unwrap();
                                cycle.push(String.from_str(allocator, decl->name.as_str_const()));
                                cycle_ids_out->push(id);
                            }

                            const dep_decl = decl_tables->global_vars.get_const(dep_id).unwrap();
                            cycle.push(String.from_str(allocator, dep_decl->name.as_str_const()));
                            return .Some(cycle);
                        }
                        case .None => {
                            const dep_decl = decl_tables->global_vars.get_const(dep_id).unwrap();
                            
                            if (dep_decl->is_const && !dep_decl->is_static) {
                                switch (dep_decl->rhs) {
                                    case .Some(rhs) => {
                                        visiting->push(dep_id);
                                        
                                        const found = detect_const_cycle_in_expr(
                                            decl_tables,
                                            registry,
                                            &rhs,
                                            visiting,
                                            allocator,
                                            cycle_ids_out
                                        );
                                        
                                        visiting->pop();

                                        if (found.is_some()) {
                                            return found;
                                        }
                                    }
                                    case .None => {}
                                }
                            }
                        }
                    }
                }
                else => {}
            }
        }
        case .Prefix(prefix_expr) => {
            return detect_const_cycle_in_expr(
                decl_tables, 
                registry, 
                prefix_expr.operand, 
                visiting, 
                allocator, 
                cycle_ids_out
            );
        }
        case .Infix(infix_expr) => {
            const left = detect_const_cycle_in_expr(
                decl_tables, 
                registry, 
                infix_expr.lhs, 
                visiting, 
                allocator, 
                cycle_ids_out
            );
            
            if (left.is_some()) {
                return left;
            }
            
            return detect_const_cycle_in_expr(
                decl_tables, 
                registry, 
                infix_expr.rhs, 
                visiting, 
                allocator, 
                cycle_ids_out
            );
        }
        case .ArrayIndex(array_index) => {
            const operand = detect_const_cycle_in_expr(
                decl_tables, 
                registry, 
                array_index.operand, 
                visiting, 
                allocator, 
                cycle_ids_out
            );
            
            if (operand.is_some()) {
                return operand;
            }
            
            return detect_const_cycle_in_expr(
                decl_tables, 
                registry, 
                array_index.index, 
                visiting, 
                allocator, 
                cycle_ids_out
            );
        }
        case .Array(array_expr) => {
            for (var i: usize = 0; i < array_expr.elements.len(); i += 1) {
                const element = array_expr.elements.get_const(i).unwrap();
                
                const found = detect_const_cycle_in_expr(
                    decl_tables, 
                    registry, 
                    element, 
                    visiting, 
                    allocator, 
                    cycle_ids_out
                );
                
                if (found.is_some()) {
                    return found;
                }
            }
        }
        case .Tuple(tuple_expr) => {
            for (var i: usize = 0; i < tuple_expr.elements.len(); i += 1) {
                const element = tuple_expr.elements.get_const(i).unwrap();

                const found = detect_const_cycle_in_expr(
                    decl_tables, 
                    registry, 
                    element, 
                    visiting, 
                    allocator, 
                    cycle_ids_out
                );
                
                if (found.is_some()) {
                    return found;
                }
            }
        }
        case .FieldAccess(field_access) => {
            return detect_const_cycle_in_expr(
                decl_tables, 
                registry, 
                field_access.operand, 
                visiting, 
                allocator, 
                cycle_ids_out
            );
        }
        case .Try(try_expr) => {
            return detect_const_cycle_in_expr(
                decl_tables,
                registry,
                try_expr->operand,
                visiting,
                allocator,
                cycle_ids_out
            );
        }
        case .TryCatch(try_catch_expr) => {
            return detect_const_cycle_in_expr(
                decl_tables,
                registry,
                try_catch_expr->operand,
                visiting,
                allocator,
                cycle_ids_out
            );
        }
        case .AddrOf(addr_expr) => {
            return detect_const_cycle_in_expr(
                decl_tables, 
                registry, 
                addr_expr.operand, 
                visiting, 
                allocator, 
                cycle_ids_out
            );
        }
        case .Deref(deref_expr) => {
            return detect_const_cycle_in_expr(
                decl_tables, 
                registry, 
                deref_expr.operand, 
                visiting, 
                allocator, 
                cycle_ids_out
            );
        }
        else => {}
    }

    return .None;
}