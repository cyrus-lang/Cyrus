import std::option{Option};
import std::mem{Allocator};
import std::string{
    push_escaped_tsv_field, 
    unescape_tsv_field,
    String, 
};

[[inline]]
pub fn escape_sequence_to_char(seq: uint8) uint8 {
    switch (seq) {
        case '0' => return '\0';
        case 'n' => return '\n';
        case 't' => return '\t';
        case 'r' => return '\r';
        case 'b' => return '\b';
        case 'a' => return '\a';
        case 'v' => return '\v';
        case 'f' => return '\f';
        case '\\' => return '\\';
        case '\'' => return '\'';
        case '"' => return '"';
    }
    return seq;
}

[[inline]]
pub fn char_to_escape_sequence(char: uint8) uint8 {
    switch (char) {
        case '\0' => return '0';
        case '\n' => return 'n';
        case '\t' => return 't';
        case '\r' => return 'r';
        case '\b' => return 'b';
        case '\a' => return 'a';
        case '\v' => return 'v';
        case '\f' => return 'f';
        case '\\' => return '\\';
        case '\'' => return '\'';
        case '"' => return '"';
    }
    return char;
}

[[inline]]
pub fn is_valid_escape(char: uint8) bool {
    return char == '0' || char == 'n' || char == 't'
        || char == 'r' || char == 'b' || char == 'a'
        || char == 'v' || char == 'f' || char == '"'
        || char == '\\' || char == '\'';
}

[[inline]]
pub fn is_escaped_char(char: uint8) bool {
    return char == '\0' || char == '\n' || char == '\t'
        || char == '\r' || char == '\b' || char == '\a'
        || char == '\v' || char == '\f' || char == '\"'
        || char == '\\' || char == '\'';
}

pub fn push_c_escaped(out: String*, s: const uint8*) {
    var i: usize = 0;

    while (s[i] != 0) {
        const ch = s[i];

        if (ch == '"') {
            out->push('\\');
            out->push('"');
        } else if (ch == '\\') {
            out->push('\\');
            out->push('\\');
        } else if (ch == '\n') {
            out->push('\\');
            out->push('n');
        } else if (ch == '\t') {
            out->push('\\');
            out->push('t');
        } else if (ch == '\r') {
            out->push('\\');
            out->push('r');
        } else if (ch < 32 || ch > 126) {
            out->push('\\');
            push_octal3(out, ch);
        } else {
            out->push(ch);
        }

        i += 1;
    }
}

pub fn push_c_string_literal(out: String*, text: const uint8*) {
    out->push('"');
    push_c_escaped(out, text);
    out->push('"');
}

pub fn push_c_char(out: String*, c: uint8) {
    if (c == '\'') {
        out->push('\\');
        out->push('\'');
    } else if (c == '\\') {
        out->push('\\');
        out->push('\\');
    } else if (c == '\n') {
        out->push('\\');
        out->push('n');
    } else if (c == '\t') {
        out->push('\\');
        out->push('t');
    } else if (c == '\r') {
        out->push('\\');
        out->push('r');
    } else if (c < 32 || c > 126) {
        out->push('\\');
        push_octal3(out, c);
    } else {
        out->push(c);
    }
}

pub fn push_asm_escaped(out: String*, raw: const uint8*) {
    var i: usize = 0;

    while (raw[i] != '\0') {
        const ch = raw[i];

        if (ch == '\n') {
            out->push('\\');
            out->push('n');
        } else if (ch == '\t') {
            out->push('\\');
            out->push('t');
        } else if (ch == '"') {
            out->push('\\');
            out->push('"');
        } else if (ch == '\\') {
            out->push('\\');
            out->push('\\');
        } else {
            out->push(ch);
        }

        i += 1;
    }
}

pub fn push_shell_quoted(out: String*, arg: const uint8*) {
    out->push('\'');
    
    var i: usize = 0;

    while (arg[i] != '\0') {
        if (arg[i] == '\'') {
            out->push_str("'\"'\"'");
        } else {
            out->push(arg[i]);
        }
        
        i += 1;
    }
    
    out->push('\'');
}

pub fn push_shell_quoted_arg(out: String*, arg: const uint8*) {
    out->push(' ');
    push_shell_quoted(out, arg);
}

pub fn push_escaped_field(out: String*, val: const uint8*) {
    push_escaped_tsv_field(out, val);
}

pub fn unescape_field(allocator: Allocator, val: const uint8*) String {
    return unescape_tsv_field(allocator, val);
}

fn push_octal3(out: String*, value: uint8) {
    var d2 = @cast(uint8, (value >> 6) & 7);
    var d1 = @cast(uint8, (value >> 3) & 7);
    var d0 = @cast(uint8, value & 7);
    out->push(@cast(uint8, '0' + d2));
    out->push(@cast(uint8, '0' + d1));
    out->push(@cast(uint8, '0' + d0));
}

fn unescape_hex_digit(c: uint8) Option<uint8> {
    if (c >= '0' && c <= '9') {
        return .Some(c - '0');
    }
    if (c >= 'a' && c <= 'f') {
        return .Some(c - 'a' + 10);
    }
    if (c >= 'A' && c <= 'F') {
        return .Some(c - 'A' + 10);
    }
    return .None;
}

fn unescape_is_valid_codepoint(code: uint32) bool {
    if (code > 0x10FFFF) {
        return false;
    }
    if (code >= 0xD800 && code <= 0xDFFF) {
        return false;
    }
    return true;
}

fn push_codepoint_utf8(out: String*, code: uint32) {
    if (code < 0x80) {
        out->push(@cast(uint8, code));
    } else if (code < 0x800) {
        out->push(@cast(uint8, @cast(uint32, 0xC0) | (code >> 6)));
        out->push(@cast(uint8, @cast(uint32, 0x80) | (code & 0x3F)));
    } else if (code < 0x10000) {
        out->push(@cast(uint8, @cast(uint32, 0xE0) | (code >> 12)));
        out->push(@cast(uint8, @cast(uint32, 0x80) | ((code >> 6) & 0x3F)));
        out->push(@cast(uint8, @cast(uint32, 0x80) | (code & 0x3F)));
    } else {
        out->push(@cast(uint8, @cast(uint32, 0xF0) | (code >> 18)));
        out->push(@cast(uint8, @cast(uint32, 0x80) | ((code >> 12) & 0x3F)));
        out->push(@cast(uint8, @cast(uint32, 0x80) | ((code >> 6) & 0x3F)));
        out->push(@cast(uint8, @cast(uint32, 0x80) | (code & 0x3F)));
    }
}

pub fn unescape_string(allocator: Allocator, input: const String*) Option<String> {
    const data = input->as_str_const();
    const len = input->len();

    var out = String.new(allocator);
    var i: usize = 0;

    while (i < len) {
        const c = data[i];

        if (c != '\\') {
            out.push(c);
            i += 1;
            continue;
        }

        i += 1;
        if (i >= len) {
            out.free();
            return .None;
        }

        const esc = data[i];
        i += 1;

        switch (esc) {
            case 'n' => out.push('\n');
            case 't' => out.push('\t');
            case 'r' => out.push('\r');
            case 'b' => out.push('\b');
            case 'a' => out.push('\a');
            case 'v' => out.push('\v');
            case 'f' => out.push('\f');
            case '\\' => out.push('\\');
            case '"' => out.push('"');
            case '\'' => out.push('\'');

            case 'x' => {
                if (i + 2 > len) {
                    out.free();
                    return .None;
                }

                switch (unescape_hex_digit(data[i])) case .Some(hex1) else {
                    out.free();
                    return .None;
                }
                switch (unescape_hex_digit(data[i + 1])) case .Some(hex2) else {
                    out.free();
                    return .None;
                }

                out.push(hex1 * 16 + hex2);
                i += 2;
            }

            case '0' | '1' | '2' | '3' | '4' | '5' | '6' | '7' => {
                var value: uint32 = @cast(uint32, esc - '0');
                var count: usize = 1;

                while (count < 3 && i < len && data[i] >= '0' && data[i] <= '7') {
                    value = value * 8 + @cast(uint32, data[i] - '0');
                    i += 1;
                    count += 1;
                }

                if (value > 255) {
                    out.free();
                    return .None;
                }

                out.push(@cast(uint8, value));
            }

            case 'u' => {
                var code: uint32 = 0;

                if (i < len && data[i] == '{') {
                    i += 1;

                    var digits: uint32 = 0;
                    var seen = false;

                    while (i < len && data[i] != '}') {
                        switch (unescape_hex_digit(data[i])) case .Some(dg) else {
                            out.free();
                            return .None;
                        }

                        digits = digits * 16 + @cast(uint32, dg);
                        seen = true;
                        i += 1;
                    }

                    if (i >= len || !seen) {
                        out.free();
                        return .None;
                    }

                    i += 1;
                    code = digits;
                } else {
                    var digits: uint32 = 0;

                    for (var k: usize = 0; k < 4; k += 1) {
                        if (i >= len) {
                            out.free();
                            return .None;
                        }

                        switch (unescape_hex_digit(data[i])) case .Some(dg) else {
                            out.free();
                            return .None;
                        }

                        digits = digits * 16 + @cast(uint32, dg);
                        i += 1;
                    }

                    code = digits;
                }

                if (!unescape_is_valid_codepoint(code)) {
                    out.free();
                    return .None;
                }

                push_codepoint_utf8(&out, code);
            }

            case 'U' => {
                var code: uint32 = 0;

                for (var k: usize = 0; k < 8; k += 1) {
                    if (i >= len) {
                        out.free();
                        return .None;
                    }

                    switch (unescape_hex_digit(data[i])) case .Some(dg) else {
                        out.free();
                        return .None;
                    }

                    code = code * 16 + @cast(uint32, dg);
                    i += 1;
                }

                if (!unescape_is_valid_codepoint(code)) {
                    out.free();
                    return .None;
                }

                push_codepoint_utf8(&out, code);
            }

            else => {
                out.push('\\');
                out.push(esc);
            }
        }
    }

    return .Some(out);
}
