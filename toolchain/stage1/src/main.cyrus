// FIXME: Move to driver
fn build_or_run(action: cli::ActionContext, execute: bool) int32 {
    const allocator: Allocator = dynamic LibcAllocator.new();

    switch (action.args->get_str(0)) case .Some(file_path) else {
        compile_error("please provide an input file");
        return 1;
    }

    if (!os::is_file(file_path)) {
        compile_error("input must be a file");
        return 1;
    }

    if (execute) {
        switch (dir::TempDir.create(allocator)) case .Some(temp_dir) else {
            compile_error("failed to create a temporary directory");
            return 1;
        }
        defer temp_dir.free();

        var output_path = std::path::join_path(
            allocator,
            temp_dir.path(),
            "a.out"
        );

        defer output_path.free();
        defer dir::remove_file(output_path.as_str_const());
        
        var arena = ArenaAllocator.new(allocator, 65000);
        defer arena.destroy();

        const status = compile_file(dynamic arena, action, &output_path);

        if (status != 0) {
            return status;
        }

        var command = process::Command.new(
            allocator,
            output_path.as_str_const()
        );
        defer command.free();

        const exit_status = command.exec();

        const child_status = @cast(uint32, exit_status);
        return @cast(int32, (child_status >> 8) & 0xff);
    }

    var output_path = String.new(allocator);
    defer output_path.free();

    var explicit_output: bool = false;

    switch (action.opts->find("output")) {
        case .Some(opt) => {
            switch (opt->values.get(0)) {
                case .Some(value) => {
                    switch (*value) {
                        case .Str(str) => {
                            output_path.free();
                            output_path = str.clone(allocator);
                            explicit_output = true;
                        }
                        else => {}
                    }
                }
                else => {}
            }
        }
        else => {}
    }

    if (!explicit_output) {
        var stem = std::path::file_stem(allocator, file_path);
        defer stem.free();

        var parent_dir = dir_of_file(allocator, file_path);
        defer parent_dir.free();

        output_path.free();

        output_path = std::path::join_path(
            allocator,
            parent_dir.as_str_const(),
            stem.as_str_const()
        );
    }

    return compile_file(allocator, action, &output_path);
}

// Joins every value of a repeatable option (`-z`, `-L`, `-l`) into
// `dst` as a newline separated list, matching tcc::compile's inputs.
fn collect_opt_values(opts: cli::Opts*, name: const uint8*, dst: String*) void {
    switch (opts->find(name)) case .Some(opt) else {
        return;
    }

    for (var i: usize = 0; i < opt->values.len(); i += 1) {
        switch (opt->values.get(i)) {
            case .Some(value) => {
                switch (*value) {
                    case .Str(str) => {
                        if (!dst->is_empty()) {
                            dst->push('\n');
                        }
                        dst->push_str(str.as_str_const());
                    }
                    else => {}
                }
            }
            else => {}
        }
    }
}

// Stage1 always compiles modules separately, so only `separate` is a
// valid `--module-merge-mode` value. Returns true when an unsupported
// mode was explicitly requested.
fn module_merge_mode_unsupported(opts: cli::Opts*) bool {
    switch (opts->find("module-merge-mode")) case .Some(opt) else {
        return false;
    }

    switch (opt->values.get(0)) case .Some(value) else {
        return false;
    }

    switch (*value) case .Str(str) else {
        return false;
    }

    return str.as_str_const() != "separate";
}

// FIXME: Move to driver
fn compile_file(
    allocator: Allocator,
    action: cli::ActionContext,
    output_path: const String*
) int32 {
    // Driver-owned arena for the analyzer's temporary allocations
    // (normalized/cloned SemaTypes are never freed individually).
    // Its `defer` is registered before all other defers below so it is
    // destroyed last, after codegen and after the resolver freed the
    // trees that may point into it.
    var mem = ArenaAllocator.new(allocator, 65536);
    defer mem.destroy();

    switch (action.args->get_str(0)) case .Some(file_path) else {
        compile_error("please provide an input file");
        return 1;
    }

    var context = CompilerContext.new(allocator);
    defer context.free();
    
    const lexical = LexicalContext.new(&context);

    switch (resolver_opts_from_action_context(action)) case .Value(var opts) else {
        return 1;
    }
    defer opts.free();

    var resolver = Resolver.new(allocator, &lexical, &opts);
    defer resolver.free();

    const path = Path.new(allocator, file_path);

    switch (lexical.tokenize_source(path)) case .Value(var source_tokens) else {
        return 1;
    }
    defer source_tokens.free();

    switch (lexical.parse_source(source_tokens)) case .Value(var program) else {
        return 1;
    }
    defer program.free();

    resolver.resolve_entry(
        source_tokens.source_id, 
        file_path, 
        &program
    );

    if (context.dctx.has_errors()) {
        context.render_diags();
        return 1;
    }

    var analyzer_context = AnalyzerContext.new(
        dynamic mem,
        &context.dctx,
        &resolver.global_symbols,
        &resolver.decl_tables,
        resolver.program_trees
    );
    defer analyzer_context.free();

    trigger_analyzer(&analyzer_context);

    if (context.dctx.has_errors()) {
        context.render_diags();
        return 1;
    }

    var backend = String.from_str(allocator, "c");
    defer backend.free();

    switch (action.opts->find("backend")) {
        case .Some(opt) => {
            switch (opt->values.get(0)) {
                case .Some(value) => {
                    switch (*value) {
                        case .Str(str) => {
                            backend.free();
                            backend = str.clone(allocator);
                        }
                        else => {}
                    }
                }
                else => {}
            }
        }
        else => {}
    }

    if (backend.as_str_const() == "llvm") {
        compile_error("LLVM backend is not supported yet");
        return 1;
    }

    if (backend.as_str_const() != "c") {
        compile_error("unknown backend (expected `c` or `llvm`)");
        return 1;
    }

    var out = String.new(allocator);
    defer out.free();

    var extra_files = String.new(allocator);
    defer extra_files.free();

    var lib_paths = String.new(allocator);
    defer lib_paths.free();

    var libraries = String.new(allocator);
    defer libraries.free();

    if (module_merge_mode_unsupported(action.opts)) {
        compile_error("unsupported module merge mode (expected `separate`)");
        return 1;
    }

    collect_opt_values(action.opts, "z", &extra_files);
    collect_opt_values(action.opts, "L", &lib_paths);
    collect_opt_values(action.opts, "l", &libraries);

    {
        const writer: Writer = dynamic StringWriter.new(&out);

        var codegen = CodegenC.new(
            allocator,
            &resolver.decl_tables,
            &resolver.global_symbols,
            &resolver.program_trees,
            &analyzer_context.vtable_registry,
            &analyzer_context.monomorph_registry,
            &context.sctx
        );
        codegen.emit(writer);
        codegen.free();
    }

    // Debug hook: CYRUS_EMIT_C=<path> dumps the generated C so it can be
    // inspected without going through tcc.
    const emit_path = getenv("CYRUS_EMIT_C");

    if (emit_path != null) {
        const emit_stream = fopen(emit_path, "w");

        if (emit_stream != null) {
            fwrite(out.as_str_const(), 1, out.len(), emit_stream);
            fclose(emit_stream);
        }
    }

    if (!tcc::compile(
        out.as_str_const(),
        output_path->as_str_const(),
        tcc::OutputKind.EXE,
        extra_files.as_str_const(),
        lib_paths.as_str_const(),
        libraries.as_str_const()
    )) {
        compile_error("tcc failed to compile the input file");
        return 1;
    }

    return 0;
}

fn file_path_from_action_context(action: cli::ActionContext) ErrorOr<String, ()> {
    switch (action.args->get_str(0)) case .Some(file_path) else {
        compile_error("please provide an input file");
        return .Error(());
    }

    if (!os::is_file(file_path)) {
        compile_error("input must be a file");
        return .Error(());
    }

    return .Value(String.from_str(action.allocator, file_path));
}

fn resolver_opts_from_action_context(action: cli::ActionContext) ErrorOr<ResolverOptions, ()> {
    const allocator: Allocator = dynamic LibcAllocator.new();

    switch (file_path_from_action_context(action)) case .Value(var file_path) else {
        return .Error(());
    }
    defer file_path.free();
    
    var opts = ResolverOptions.new(allocator);

    // NOTE: `opts` is returned by value on success, so its owned heap
    // memory (base_path, source_dirs, stdlib_path) transfers to the
    // caller, which frees it with `opts.free()`. We must only free
    // `opts` here ourselves on the error paths.

    opts.base_path.free();
    opts.base_path = dir::cwd(allocator);
    opts.source_dirs.push(dir_of_file(allocator, file_path.as_str_const()));

    apply_stdlib_option(allocator, action.opts, &opts);

    if (!apply_profile_option(action.opts, &opts)) {
        opts.free();
        return .Error(());
    }   

    return .Value(opts);
}

/* ************* Options Helpers ************* */

fn apply_stdlib_option(
    allocator: Allocator,
    ctx_opts: const cli::Opts*,
    opts: ResolverOptions*
) {
    switch (ctx_opts->find("stdlib")) case .Some(opt) else {
        return;
    }

    switch (opt->values.get(0)) case .Some(value) else {
        return;
    }

    switch (*value) case .Str(value_str) else {
        return;
    }

    var stdlib = value_str.clone(allocator);

    switch (opts->stdlib_path) {
        case .Some(var prev) => {
            prev.free();
        }
        else => {}
    }

    opts->stdlib_path = .Some(stdlib);
}

fn apply_profile_option(
    ctx_opts: const cli::Opts*,
    opts: ResolverOptions*
) bool {
    switch (ctx_opts->find("profile")) case .Some(opt) else {
        return true;
    }

    switch (opt->values.get(0)) case .Some(value) else {
        return true;
    }

    switch (*value) case .Str(value_str) else {
        return true;
    }

    if (value_str.as_str_const() == "release") {
        opts->profile = .Release;
        return true;
    }

    if (value_str.as_str_const() == "debug") {
        opts->profile = .Debug;
        return true;
    }

    compile_error("invalid profile (expected `debug` or `release`)");
    return false;
}
