pub fn main(argc: c_int, argv: c_char**) {
    const allocator: Allocator = dynamic LibcAllocator.new();

    var opts = cli::Opts.new(allocator);
    defer opts.free();
    
    var app = cli::App.new(allocator, &opts, "cyrus");
    defer app.free();

    const profile_opt = opts.add(*cli::Opt.new(allocator, "profile").arg(.Str)->help("Build profile (debug|release)"));
    const jobs_opt = opts.add(*cli::Opt.new(allocator, "jobs").short('j')->arg(.Int)->help("Number of parallel jobs"));
    const output_opt = opts.add(*cli::Opt.new(allocator, "output").short('o')->arg(.Str)->help("Output file path"));
    const backend_opt = opts.add(*cli::Opt.new(allocator, "backend").arg(.Str)->help("Backend compiler (c|llvm)"));
    const release_opt = opts.add(*cli::Opt.new(allocator, "release").short('r')->help("Build in release mode"));
    const debug_opt = opts.add(*cli::Opt.new(allocator, "debug").short('g')->help("Build with debug symbols"));
    const verbose_opt = opts.add(*cli::Opt.new(allocator, "verbose").short('v')->help("Increase verbosity"));
    const stdlib_opt = opts.add(*cli::Opt.new(allocator, "stdlib").arg(.Str)->help("Stdlib root directory"));
    const quiet_opt = opts.add(*cli::Opt.new(allocator, "quiet").short('q')->help("Suppress output"));
    const target_opt = opts.add(*cli::Opt.new(allocator, "target").short('t')->help("Target triple"));
    const color_opt = opts.add(*cli::Opt.new(allocator, "color").help("Colored output"));

    const new_cmd = 
        cli::Cmd.new(allocator, "new", command_new)
        .help("Create new project");

    const run_cmd = 
        cli::Cmd.new(allocator, "run", command_run)
        .help("Build and run")
        ->optional_argument(.Str)
        ->add_option(verbose_opt)
        ->add_option(quiet_opt)
        ->add_option(release_opt)
        ->add_option(debug_opt)
        ->add_option(target_opt)
        ->add_option(backend_opt)
        ->add_option(output_opt)
        ->add_option(stdlib_opt)
        ->add_option(profile_opt)
        ->add_option(jobs_opt);
    
    const build_cmd = 
        cli::Cmd.new(allocator, "build", command_build)
        .help("Build project")
        ->optional_argument(.Str)
        ->add_option(verbose_opt)
        ->add_option(quiet_opt)
        ->add_option(release_opt)
        ->add_option(debug_opt)
        ->add_option(backend_opt)
        ->add_option(output_opt)
        ->add_option(stdlib_opt)
        ->add_option(profile_opt)
        ->add_option(jobs_opt);
    
    const test_cmd = 
        cli::Cmd.new(allocator, "test", command_build) 
        .help("Run tests")
        ->add_option(verbose_opt)
        ->add_option(quiet_opt)
        ->add_option(target_opt)
        ->add_option(backend_opt)
        ->add_option(output_opt)
        ->add_option(jobs_opt);
    
    const clean_cmd = 
        cli::Cmd.new(allocator, "clean", command_build)
        .help("Clean build artifacts");
    
    const dump_tokenize_cmd = 
        cli::Cmd.new(allocator, "lexer", command_dump_lexer)
        .help("Dump scanned tokens")
        ->optional_argument(.Str);

    const dump_parse_cmd = 
        cli::Cmd.new(allocator, "parser", command_dump_parser)
        .help("Parse file and dump the AST")
        ->optional_argument(.Str);

    const dump_resolve_cmd = 
        cli::Cmd.new(allocator, "resolver", command_dump_resolver)
        .help("Resolve modules and dump the symbol table")
        ->optional_argument(.Str)
        ->add_option(stdlib_opt)
        ->add_option(profile_opt);

    const dump_analyze_cmd = 
        cli::Cmd.new(allocator, "analyzer", command_dump_analyzer)
        .help("Analyze modules and dump the CIR")
        ->optional_argument(.Str)
        ->add_option(stdlib_opt)
        ->add_option(profile_opt);

    const dump_bir_cmd = 
        cli::Cmd.new(allocator, "bir", command_dump_bir)
        .help("Analyze modules and dump the BackendIR")
        ->optional_argument(.Str)
        ->add_option(stdlib_opt)
        ->add_option(profile_opt);

    const dump_cmd = 
        cli::Cmd.new(allocator, "dump", command_dump)
        .help("Dump compiler intermediate representations");

    dump_cmd->add_sub_command(*dump_tokenize_cmd);
    dump_cmd->add_sub_command(*dump_parse_cmd);
    dump_cmd->add_sub_command(*dump_resolve_cmd);
    dump_cmd->add_sub_command(*dump_analyze_cmd);
    dump_cmd->add_sub_command(*dump_bir_cmd);

    const version_cmd = 
        cli::Cmd.new(allocator, "version", command_version)
        .help("Compiler version");

    app.register(*new_cmd);
    app.register(*run_cmd);
    app.register(*build_cmd);
    app.register(*test_cmd);
    app.register(*clean_cmd);
    app.register(*dump_cmd);
    app.register(*version_cmd);

    app.run(struct { argc, argv });
}

fn command_new(ctx: cli::ActionContext) {
    @todo();
}

fn command_run(ctx: cli::ActionContext) {
    const allocator: Allocator = dynamic LibcAllocator.new();

    var driver = CompilerDriver.new(allocator);

    // TODO: Support Babylon
    switch (ctx.args->get_str(0)) case .Some(file_path) else {
        exit_with_compile_error("please provide an input file");
        @unreachable();
    }

    var output_path: String;
    defer output_path.free();

    switch (dir::TempDir.create(allocator)) case .Some(temp_dir) else {
        exit_with_compile_error("failed to create a temporary directory");
        @unreachable();
    }
    defer temp_dir.free();

    output_path = std::path::join_path(allocator, temp_dir.path(), "a.out");

    var opts = ResolverOptions.new(allocator);

    opts.base_path.free();
    opts.base_path = dir::cwd(allocator);
    opts.source_dirs.push(dir_of_file(allocator, file_path));
    apply_stdlib_option(allocator, ctx.opts, &opts);
    apply_profile_option(allocator, ctx.opts, &opts);

    var resolver = Resolver.new(allocator, &driver, &opts);

    const lexical = driver.create_lexical_resource();
    const path = Path.new(allocator, file_path);

    switch (lexical.tokenize_source(path)) case .Value(var source_tokens) else {
        free_driver_resources(&driver, &resolver, &opts);
        output_path.free();
        temp_dir.free();
        ctx.opts->free();
        exit(1);
        @unreachable();
    }

    switch (lexical.parse_source(source_tokens)) case .Value(var program) else {
        source_tokens.free();
        free_driver_resources(&driver, &resolver, &opts);
        output_path.free();
        temp_dir.free();
        ctx.opts->free();
        exit(1);
        @unreachable();
    }

    resolver.resolve_entry(source_tokens.source_id, file_path, &program);

    var run: bool = false;
    var error: bool = false;
    var exit_code: int32 = 0;

    if (!driver.dctx.has_errors()) {
        const arena_allocator: Allocator = dynamic resolver.arena;

        var analyzer = check::Analyzer.new(
            arena_allocator,
            &driver.dctx,
            &resolver.global_symbols,
            &resolver.decl_tables,
            resolver.program_trees
        );
        analyzer.analyze();

        if (driver.dctx.has_errors()) {
            driver.render_diags();
            error = true;
        } else {
            var backend = String.from_str(allocator, "c");
            
            switch (ctx.opts->find("backend")) {
                case .Some(opt) => {
                    switch (opt->values.get_owned(0)) {
                        case .Some(value) => {
                            switch (value) {
                                case .Str(str) => {
                                    backend.free();
                                    backend = str.clone(allocator);
                                }
                                else => {}
                            }
                        }
                        else => {}
                    }
                }
                else => {}
            }

            if (backend.as_str_const() == "llvm") {
                backend.free();
                analyzer.free();
                exit_with_compile_error("LLVM backend is not supported yet");
                @unreachable();
            } else if (backend.as_str_const() == "c") {
                var out = String.new(allocator);
                const writer: Writer = dynamic StringWriter.new(&out);

                var codegen = CodegenC.new(
                    allocator,
                    &resolver.decl_tables,
                    &resolver.global_symbols,
                    &resolver.program_trees,
                    &analyzer.vtable_registry,
                    &analyzer.monomorph_registry,
                    &driver.sctx
                );

                codegen.emit(writer);
                codegen.free();

                if (!tcc::compile(out.as_str_const(), output_path.as_str_const(), tcc::OutputKind.EXE)) {
                    out.free();
                    analyzer.free();
                    program.free();
                    source_tokens.free();
                    output_path.free();
                    temp_dir.free();
                    free_driver_resources(&driver, &resolver, &opts);
                    ctx.opts->free();
                    exit_with_compile_error("failed to compile the input file");
                    backend.free();
                    @unreachable();
                }

                out.free();

                var command = process::Command.new(allocator, output_path.as_str_const());
                const exit_status = command.exec();
                command.free();

                dir::remove_file(output_path.as_str_const());

                const child_status = @cast(uint32, exit_status);
                exit_code = @cast(int32, (child_status >> 8) & 0xff);
                run = true;
                
                backend.free();
            } else {
                backend.free();
                exit_with_compile_error("unknown backend (expected `c` or `llvm`)");
            }
        }

        analyzer.free();
    } else {
        driver.render_diags();
        error = true;
    }

    program.free();
    source_tokens.free();
    free_driver_resources(&driver, &resolver, &opts);

    if (run) {
        ctx.opts->free();
        exit(exit_code);
        @unreachable();
    }

    if (error) {
        ctx.opts->free();
        exit(1);
        @unreachable();
    }
}

fn command_build(ctx: cli::ActionContext) {
    const allocator: Allocator = dynamic LibcAllocator.new();

    var driver = CompilerDriver.new(allocator);

    switch (ctx.args->get_str(0)) case .Some(file_path) else {
        exit_with_compile_error("please provide an input file");
        @unreachable();
    }

    var output_path: String;
    defer output_path.free();

    switch (ctx.opts->find("output")) {
        case .Some(opt) => {
            switch (opt->values.get_owned(0)) {
                case .Some(value) => {
                    switch (value) {
                        case .Str(str) => {
                            output_path = str.clone(allocator);
                        }
                        else => {
                            var stem = std::path::file_stem(allocator, file_path);
                            var dir = dir_of_file(allocator, file_path);
                            output_path = std::path::join_path(allocator, dir.as_str_const(), stem.as_str_const());
                            stem.free();
                            dir.free();
                        }
                    }
                }
                else => {
                    var stem = std::path::file_stem(allocator, file_path);
                    var dir = dir_of_file(allocator, file_path);
                    output_path = std::path::join_path(allocator, dir.as_str_const(), stem.as_str_const());
                    stem.free();
                    dir.free();
                }
            }
        }
        case .None => {
            var stem = std::path::file_stem(allocator, file_path);
            var dir = dir_of_file(allocator, file_path);
            output_path = std::path::join_path(allocator, dir.as_str_const(), stem.as_str_const());
            stem.free();
            dir.free();
        }
    }

    var opts = ResolverOptions.new(allocator);

    opts.base_path.free();
    opts.base_path = dir::cwd(allocator);
    opts.source_dirs.push(dir_of_file(allocator, file_path));
    apply_stdlib_option(allocator, ctx.opts, &opts);
    apply_profile_option(allocator, ctx.opts, &opts);

    var resolver = Resolver.new(allocator, &driver, &opts);

    const lexical = driver.create_lexical_resource();
    const path = Path.new(allocator, file_path);

    switch (lexical.tokenize_source(path)) case .Value(var source_tokens) else {
        free_driver_resources(&driver, &resolver, &opts);
        output_path.free();
        ctx.opts->free();
        exit(1);
        @unreachable();
    }
    defer source_tokens.free();

    switch (lexical.parse_source(source_tokens)) case .Value(var program) else {
        source_tokens.free();
        free_driver_resources(&driver, &resolver, &opts);
        output_path.free();
        ctx.opts->free();
        exit(1);
        @unreachable();
    }
    defer program.free();

    resolver.resolve_entry(source_tokens.source_id, file_path, &program);

    var error: bool = false;

    if (!driver.dctx.has_errors()) {
        const arena_allocator: Allocator = dynamic resolver.arena;

        var analyzer = check::Analyzer.new(
            arena_allocator,
            &driver.dctx,
            &resolver.global_symbols,
            &resolver.decl_tables,
            resolver.program_trees
        );
        analyzer.analyze();

        if (driver.dctx.has_errors()) {
            driver.render_diags();
            error = true;
        } else {
            var backend = String.from_str(allocator, "c");
            switch (ctx.opts->find("backend")) {
                case .Some(opt) => {
                    switch (opt->values.get_owned(0)) {
                        case .Some(value) => {
                            switch (value) {
                                case .Str(str) => {
                                    backend.free();
                                    backend = str.clone(allocator);
                                }
                                else => {}
                            }
                        }
                        else => {}
                    }
                }
                else => {}
            }

            if (backend.as_str_const() == "c") {
                var out = String.new(allocator);
                const writer: Writer = dynamic StringWriter.new(&out);

                var codegen = CodegenC.new(
                    allocator,
                    &resolver.decl_tables,
                    &resolver.global_symbols,
                    &resolver.program_trees,
                    &analyzer.vtable_registry,
                    &analyzer.monomorph_registry,
                    &driver.sctx
                );

                codegen.emit(writer);
                codegen.free();

                if (!tcc::compile(out.as_str_const(), output_path.as_str_const(), .EXE)) {
                    out.free();
                    analyzer.free();
                    program.free();
                    source_tokens.free();
                    output_path.free();
                    free_driver_resources(&driver, &resolver, &opts);
                    ctx.opts->free();
                    exit_with_compile_error("failed to compile the input file");
                    @unreachable();
                }

                out.free();
            } else if (backend.as_str_const() == "llvm") {
                exit_with_compile_error("LLVM backend is not supported yet");
                @unreachable();
            } else {
                exit_with_compile_error("unknown backend (expected `c` or `llvm`)");
                @unreachable();
            }
            backend.free();
        }

        analyzer.free();
    } else {
        driver.render_diags();
        error = true;
    }

    free_driver_resources(&driver, &resolver, &opts);

    if (error) {
        ctx.opts->free();
        exit(1);
        @unreachable();
    }
}

fn command_dump(ctx: cli::ActionContext) {
    ctx.print_help();
}

fn command_dump_lexer(ctx: cli::ActionContext) {
    const allocator: Allocator = dynamic LibcAllocator.new();

    const driver = CompilerDriver.new(allocator);
    defer driver.free();

    const lexical = driver.create_lexical_resource();

    switch (ctx.args->get_str(0)) case .Some(file_path) else {
        exit_with_compile_error("please provide an input file");
        @unreachable();
    }

    const path = Path.new(allocator, file_path);

    switch (lexical.tokenize_source(path)) case .Value(var source_tokens) else {
        return;
    }
    defer source_tokens.free();

    dump_tokens(&source_tokens.tokens);
}

fn command_dump_parser(ctx: cli::ActionContext) {
    const allocator: Allocator = dynamic LibcAllocator.new();

    const driver = CompilerDriver.new(allocator);
    defer driver.free();

    const lexical = driver.create_lexical_resource();

    switch (ctx.args->get_str(0)) case .Some(file_path) else {
        exit_with_compile_error("please provide an input file");
        @unreachable();
    }

    const path = Path.new(allocator, file_path);

    switch (lexical.tokenize_source(path)) case .Value(var source_tokens) else {
        return;
    }
    defer source_tokens.free();

    switch (lexical.parse_source(source_tokens)) case .Value(var program) else {
        return;
    }
    defer program.free();

    const writer: Writer = dynamic StdoutWriter.new();
    var dump = ASTDump.new(program, writer);
    dump.dump();
}

fn command_dump_resolver(ctx: cli::ActionContext) {
    const allocator: Allocator = dynamic LibcAllocator.new();

    var driver = CompilerDriver.new(allocator);
    defer driver.free();

    switch (ctx.args->get_str(0)) case .Some(file_path) else {
        exit_with_compile_error("please provide an input file");
        @unreachable();
    }

    var opts = ResolverOptions.new(allocator);
    defer opts.free();

    opts.base_path.free();
    opts.base_path = dir::cwd(allocator);
    opts.source_dirs.push(dir_of_file(allocator, file_path));
    apply_stdlib_option(allocator, ctx.opts, &opts);
    apply_profile_option(allocator, ctx.opts, &opts);

    var resolver = Resolver.new(allocator, &driver, &opts);
    defer resolver.free();

    const lexical = driver.create_lexical_resource();
    const path = Path.new(allocator, file_path);

    switch (lexical.tokenize_source(path)) case .Value(var source_tokens) else {
        if (!driver.dctx.has_errors()) {
            resolver.dump_symbols();
        }
        return;
    }
    defer source_tokens.free();

    switch (lexical.parse_source(source_tokens)) case .Value(var program) else {
        if (!driver.dctx.has_errors()) {
            resolver.dump_symbols();
        }
        return;
    }
    defer program.free();

    resolver.resolve_entry(source_tokens.source_id, file_path, &program);

    driver.render_diags();

    if (!driver.dctx.has_errors()) {
        resolver.dump_symbols();
    }
}

fn command_dump_analyzer(ctx: cli::ActionContext) {
    const allocator: Allocator = dynamic LibcAllocator.new();

    var driver = CompilerDriver.new(allocator);

    switch (ctx.args->get_str(0)) case .Some(file_path) else {
        exit_with_compile_error("please provide an input file");
        @unreachable();
    }

    var opts = ResolverOptions.new(allocator);

    opts.base_path.free();
    opts.base_path = dir::cwd(allocator);
    opts.source_dirs.push(dir_of_file(allocator, file_path));
    apply_stdlib_option(allocator, ctx.opts, &opts);
    apply_profile_option(allocator, ctx.opts, &opts);

    var resolver = Resolver.new(allocator, &driver, &opts);

    const lexical = driver.create_lexical_resource();
    const path = Path.new(allocator, file_path);

    switch (lexical.tokenize_source(path)) case .Value(var source_tokens) else {
        free_driver_resources(&driver, &resolver, &opts);
        return;
    }
    defer source_tokens.free();

    switch (lexical.parse_source(source_tokens)) case .Value(var program) else {
        free_driver_resources(&driver, &resolver, &opts);
        return;
    }
    defer program.free();

    resolver.resolve_entry(source_tokens.source_id, file_path, &program);

    if (!driver.dctx.has_errors()) {
        const arena_allocator: Allocator = dynamic resolver.arena;

        var analyzer = check::Analyzer.new(
            arena_allocator,
            &driver.dctx,
            &resolver.global_symbols,
            &resolver.decl_tables,
            resolver.program_trees
        );
        analyzer.analyze();
        analyzer.free();
    }

    driver.render_diags();

    if (!driver.dctx.has_errors()) {
        const writer: Writer = dynamic StdoutWriter.new();

        dump::dump_cir(
            &resolver.global_symbols,
            &resolver.decl_tables,
            &resolver.program_trees,
            writer,
            allocator
        );
    }

    free_driver_resources(&driver, &resolver, &opts);
}

fn command_dump_bir(ctx: cli::ActionContext) {
    const allocator: Allocator = dynamic LibcAllocator.new();

    var driver = CompilerDriver.new(allocator);

    switch (ctx.args->get_str(0)) case .Some(file_path) else {
        exit_with_compile_error("please provide an input file");
        @unreachable();
    }

    var opts = ResolverOptions.new(allocator);

    opts.base_path.free();
    opts.base_path = dir::cwd(allocator);
    opts.source_dirs.push(dir_of_file(allocator, file_path));
    apply_stdlib_option(allocator, ctx.opts, &opts);
    apply_profile_option(allocator, ctx.opts, &opts);

    var resolver = Resolver.new(allocator, &driver, &opts);

    const lexical = driver.create_lexical_resource();
    const path = Path.new(allocator, file_path);

    switch (lexical.tokenize_source(path)) case .Value(var source_tokens) else {
        free_driver_resources(&driver, &resolver, &opts);
        return;
    }
    defer source_tokens.free();

    switch (lexical.parse_source(source_tokens)) case .Value(var program) else {
        free_driver_resources(&driver, &resolver, &opts);
        return;
    }
    defer program.free();

    resolver.resolve_entry(source_tokens.source_id, file_path, &program);

    if (!driver.dctx.has_errors()) {
        const arena_allocator: Allocator = dynamic resolver.arena;

        var analyzer = check::Analyzer.new(
            arena_allocator,
            &driver.dctx,
            &resolver.global_symbols,
            &resolver.decl_tables,
            resolver.program_trees
        );
        analyzer.analyze();

        if (driver.dctx.has_errors()) {
            driver.render_diags();
        } else {
            const writer: Writer = dynamic StdoutWriter.new();

            var codegen = CodegenC.new(
                allocator,
                &resolver.decl_tables,
                &resolver.global_symbols,
                &resolver.program_trees,
                &analyzer.vtable_registry,
                &analyzer.monomorph_registry,
                &driver.sctx
            );

            codegen.emit(writer);
            codegen.free();
        }

        analyzer.free();
    } else {
        driver.render_diags();
    }

    free_driver_resources(&driver, &resolver, &opts);
}

fn command_version(ctx: cli::ActionContext) {
    printf("Cyrus %s\n", version::COMPILER_VERSION);
}

fn apply_stdlib_option(allocator: Allocator, ctx_opts: const cli::Opts*, opts: ResolverOptions*) {
    switch (ctx_opts->find("stdlib")) case .Some(opt) else {
        return;
    }

    switch (opt->values.get(0)) case .Some(value) else {
        return;
    }

    switch (*value) case .Str(value_str) else {
        return;
    }

    opts->stdlib_path = .Some(value_str.clone(allocator));
}

fn apply_profile_option(allocator: Allocator, ctx_opts: const cli::Opts*, opts: ResolverOptions*) {
    switch (ctx_opts->find("profile")) case .Some(opt) else {
        return;
    }

    switch (opt->values.get(0)) case .Some(value) else {
        return;
    }

    switch (*value) case .Str(value_str) else {
        return;
    }

    if (value_str.as_str_const() == "release") {
        opts->profile = .Release;
    } else if (value_str.as_str_const() == "debug") {
        opts->profile = .Debug;
    } else {
        exit_with_compile_error("invalid profile (expected `debug` or `release`)");
        @unreachable();
    }
}

fn free_driver_resources(
    driver: CompilerDriver*, 
    resolver: Resolver*, 
    opts: ResolverOptions*
) {
    driver->free();
    resolver->free();
    opts->free();
}