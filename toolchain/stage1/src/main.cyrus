static var command_exit_code: int32 = 0;

pub fn main(argc: c_int, argv: c_char**) {
    run_cli(argc, argv);
    exit(command_exit_code);
}

fn run_cli(argc: c_int, argv: c_char**) {
    const allocator: Allocator = dynamic LibcAllocator.new();

    var opts = cli::Opts.new(allocator);
    defer opts.free();

    var app = cli::App.new(allocator, &opts, "cyrus");
    defer app.free();

    const profile_opt = opts.add(
        *cli::Opt.new(allocator, "profile")
        .arg(.Str)
        ->help("Build profile (debug | release)")
    );

    const jobs_opt = opts.add(
        *cli::Opt.new(allocator, "jobs")
        .short('j')
        ->arg(.Int)
        ->help("Number of parallel jobs")
    );

    const output_opt = opts.add(
        *cli::Opt.new(allocator, "output")
        .short('o')
        ->arg(.Str)
        ->help("Output file path")
    );

    const backend_opt = opts.add(
        *cli::Opt.new(allocator, "backend")
        .arg(.Str)
        ->help("Backend compiler (c | llvm)")
    );

    const release_opt = opts.add(
        *cli::Opt.new(allocator, "release")
        .short('r')
        ->help("Build in release mode")
    );

    const debug_opt = opts.add(
        *cli::Opt.new(allocator, "debug")
        .short('g')
        ->help("Build with debug symbols")
    );

    const verbose_opt = opts.add(
        *cli::Opt.new(allocator, "verbose")
        .short('v')
        ->help("Increase verbosity")
    );

    const stdlib_opt = opts.add(
        *cli::Opt.new(allocator, "stdlib")
        .arg(.Str)
        ->help("Stdlib root directory")
    );

    const extra_input_opt = opts.add(
        *cli::Opt.new(allocator, "z")
        .short('z')
        ->arg(.Str)
        ->help("Additional C source/object input to link (repeatable)")
    );

    const library_path_opt = opts.add(
        *cli::Opt.new(allocator, "L")
        .short('L')
        ->arg(.Str)
        ->help("Library search path (repeatable)")
    );

    const library_opt = opts.add(
        *cli::Opt.new(allocator, "l")
        .short('l')
        ->arg(.Str)
        ->help("Library to link against (repeatable)")
    );

    const merge_mode_opt = opts.add(
        *cli::Opt.new(allocator, "module-merge-mode")
        .arg(.Str)
        ->help("Module merging strategy (only `separate` is supported)")
    );

    const quiet_opt = opts.add(
        *cli::Opt.new(allocator, "quiet")
        .short('q')
        ->help("Suppress output")
    );

    const target_opt = opts.add(
        *cli::Opt.new(allocator, "target")
        .short('t')
        ->help("Target triple")
    );

    const color_opt = opts.add(
        *cli::Opt.new(allocator, "color")
        .help("Colored output")
    );

    const new_cmd =
        cli::Cmd.new(allocator, "new", command_new)
        .help("Create new project");

    const run_cmd =
        cli::Cmd.new(allocator, "run", command_run)
        .help("Build and run")
        ->optional_argument(.Str)
        ->add_option(extra_input_opt)
        ->add_option(library_path_opt)
        ->add_option(library_opt)
        ->add_option(merge_mode_opt)
        ->add_option(verbose_opt)
        ->add_option(quiet_opt)
        ->add_option(release_opt)
        ->add_option(debug_opt)
        ->add_option(target_opt)
        ->add_option(backend_opt)
        ->add_option(output_opt)
        ->add_option(stdlib_opt)
        ->add_option(profile_opt)
        ->add_option(jobs_opt);

    const build_cmd =
        cli::Cmd.new(allocator, "build", command_build)
        .help("Build project")
        ->optional_argument(.Str)
        ->add_option(extra_input_opt)
        ->add_option(library_path_opt)
        ->add_option(library_opt)
        ->add_option(merge_mode_opt)
        ->add_option(verbose_opt)
        ->add_option(quiet_opt)
        ->add_option(release_opt)
        ->add_option(debug_opt)
        ->add_option(backend_opt)
        ->add_option(output_opt)
        ->add_option(stdlib_opt)
        ->add_option(profile_opt)
        ->add_option(jobs_opt);

    const test_cmd =
        cli::Cmd.new(allocator, "test", command_build)
        .help("Run tests")
        ->add_option(extra_input_opt)
        ->add_option(library_path_opt)
        ->add_option(library_opt)
        ->add_option(merge_mode_opt)
        ->add_option(verbose_opt)
        ->add_option(quiet_opt)
        ->add_option(target_opt)
        ->add_option(backend_opt)
        ->add_option(output_opt)
        ->add_option(jobs_opt);

    const clean_cmd =
        cli::Cmd.new(allocator, "clean", command_build)
        .help("Clean build artifacts");

    const dump_tokenize_cmd =
        cli::Cmd.new(allocator, "lexer", command_dump_lexer)
        .help("Dump scanned tokens")
        ->optional_argument(.Str);

    const dump_parse_cmd =
        cli::Cmd.new(allocator, "parser", command_dump_parser)
        .help("Parse file and dump the AST")
        ->optional_argument(.Str);

    const dump_resolve_cmd =
        cli::Cmd.new(allocator, "resolver", command_dump_resolver)
        .help("Resolve modules and dump the symbol table")
        ->optional_argument(.Str)
        ->add_option(stdlib_opt)
        ->add_option(profile_opt);

    const dump_analyze_cmd =
        cli::Cmd.new(allocator, "analyzer", command_dump_analyzer)
        .help("Analyze modules and dump the CIR")
        ->optional_argument(.Str)
        ->add_option(stdlib_opt)
        ->add_option(profile_opt);

    const dump_bir_cmd =
        cli::Cmd.new(allocator, "bir", command_dump_bir)
        .help("Analyze modules and dump the BackendIR")
        ->optional_argument(.Str)
        ->add_option(stdlib_opt)
        ->add_option(profile_opt);

    const dump_cmd =
        cli::Cmd.new(allocator, "dump", command_dump)
        .help("Dump compiler intermediate representations");

    dump_cmd->add_sub_command(*dump_tokenize_cmd);
    dump_cmd->add_sub_command(*dump_parse_cmd);
    dump_cmd->add_sub_command(*dump_resolve_cmd);
    dump_cmd->add_sub_command(*dump_analyze_cmd);
    dump_cmd->add_sub_command(*dump_bir_cmd);

    const version_cmd =
        cli::Cmd.new(allocator, "version", command_version)
        .help("Compiler version");

    app.register(*new_cmd);
    app.register(*run_cmd);
    app.register(*build_cmd);
    app.register(*test_cmd);
    app.register(*clean_cmd);
    app.register(*dump_cmd);
    app.register(*version_cmd);

    switch (app.run(struct { argc, argv })) {
        case .Value(_) => {}
        case .Error(_) => {
            command_exit_code = 1;
        }
    }
}

/* ************* Commands ************* */

fn command_new(action: cli::ActionContext) {
    @todo();
}

fn command_run(action: cli::ActionContext) {
    command_exit_code = build_or_run(action, true);
}

fn command_build(action: cli::ActionContext) {
    command_exit_code = build_or_run(action, false);
}

fn command_dump(action: cli::ActionContext) {
    action.print_help();
}

fn command_dump_lexer(action: cli::ActionContext) {
    const allocator: Allocator = dynamic LibcAllocator.new();

    switch (file_path_from_action_context(action)) case .Value(var file_path) else {
        command_exit_code = 1;
        return;
    }
    defer file_path.free();

    var context = CompilerContext.new(allocator);
    defer context.free();
    
    const lexical = LexicalContext.new(&context);

    const path = Path.new(allocator, file_path.as_str_const());

    switch (lexical.tokenize_source(path)) case .Value(var source_tokens) else {
        command_exit_code = 1;
        return;
    }
    defer source_tokens.free();

    dump_tokens(&source_tokens.tokens);

    command_exit_code = 0;
}

fn command_dump_parser(action: cli::ActionContext) {
    const allocator: Allocator = dynamic LibcAllocator.new();

    switch (file_path_from_action_context(action)) case .Value(var file_path) else {
        command_exit_code = 1;
        return;
    }
    defer file_path.free();

    var context = CompilerContext.new(allocator);
    defer context.free();
    
    const lexical = LexicalContext.new(&context);

    const path = Path.new(allocator, file_path.as_str_const());

    switch (lexical.tokenize_source(path)) case .Value(var source_tokens) else {
        command_exit_code = 1;
        return;
    }
    defer source_tokens.free();

    switch (lexical.parse_source(source_tokens)) case .Value(var program) else {
        command_exit_code = 1;
        return;
    }
    defer program.free();

    // FIXME: Move this part into LexicalContext

    const writer: Writer = dynamic StdoutWriter.new();

    var dump = ASTDump.new(program, writer);
    dump.dump();

    command_exit_code = 0;

    // FIXME END
}

fn command_dump_resolver(action: cli::ActionContext) {
    const allocator: Allocator = dynamic LibcAllocator.new();

    switch (file_path_from_action_context(action)) case .Value(var file_path) else {
        command_exit_code = 1;
        return;
    }
    defer file_path.free();

    switch (resolver_opts_from_action_context(action)) case .Value(var opts) else {
        command_exit_code = 1;
        return;
    }
    defer opts.free();
    
    var context = CompilerContext.new(allocator);
    defer context.free();
    
    const analysis_context = AnalysisContext.new(&context, &opts);
    defer analysis_context.free();

    command_exit_code = analysis_context.dump_resolver(
        file_path.as_str_const()
    );
}

fn command_dump_analyzer(action: cli::ActionContext) {
    const allocator: Allocator = dynamic LibcAllocator.new();

    switch (file_path_from_action_context(action)) case .Value(var file_path) else {
        command_exit_code = 1;
        return;
    }
    defer file_path.free();

    switch (resolver_opts_from_action_context(action)) case .Value(var opts) else {
        command_exit_code = 1;
        return;
    }
    defer opts.free();
    
    var context = CompilerContext.new(allocator);
    defer context.free();
    
    const analysis_context = AnalysisContext.new(&context, &opts);
    defer analysis_context.free();

    command_exit_code = analysis_context.dump_cir_from_source(
        file_path.as_str_const()
    );
}

