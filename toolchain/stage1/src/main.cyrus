import version;

static var command_exit_code: int32 = 0;

pub fn main(argc: c_int, argv: c_char**) {
    run_cli(argc, argv);
    exit(command_exit_code);
}

fn run_cli(argc: c_int, argv: c_char**) {
    const allocator: Allocator = dynamic LibcAllocator.new();

    var opts = cli::Opts.new(allocator);
    defer opts.free();

    var app = cli::App.new(allocator, &opts, "cyrus");
    defer app.free();

    const profile_opt = opts.add(
        *cli::Opt.new(allocator, "profile")
        .arg(.Str)
        ->help("Build profile (debug | release)")
    );

    const jobs_opt = opts.add(
        *cli::Opt.new(allocator, "jobs")
        .short('j')
        ->arg(.Int)
        ->help("Number of parallel jobs")
    );

    const output_opt = opts.add(
        *cli::Opt.new(allocator, "output")
        .short('o')
        ->arg(.Str)
        ->help("Output file path")
    );

    const backend_opt = opts.add(
        *cli::Opt.new(allocator, "backend")
        .arg(.Str)
        ->help("Backend compiler (c | llvm)")
    );

    const release_opt = opts.add(
        *cli::Opt.new(allocator, "release")
        .short('r')
        ->help("Build in release mode")
    );

    const debug_opt = opts.add(
        *cli::Opt.new(allocator, "debug")
        .short('g')
        ->help("Build with debug symbols")
    );

    const verbose_opt = opts.add(
        *cli::Opt.new(allocator, "verbose")
        .short('v')
        ->help("Increase verbosity")
    );

    const stdlib_opt = opts.add(
        *cli::Opt.new(allocator, "stdlib")
        .arg(.Str)
        ->help("Stdlib root directory")
    );

    const quiet_opt = opts.add(
        *cli::Opt.new(allocator, "quiet")
        .short('q')
        ->help("Suppress output")
    );

    const target_opt = opts.add(
        *cli::Opt.new(allocator, "target")
        .short('t')
        ->help("Target triple")
    );

    const color_opt = opts.add(
        *cli::Opt.new(allocator, "color")
        .help("Colored output")
    );

    const new_cmd =
        cli::Cmd.new(allocator, "new", command_new)
        .help("Create new project");

    const run_cmd =
        cli::Cmd.new(allocator, "run", command_run)
        .help("Build and run")
        ->optional_argument(.Str)
        ->add_option(verbose_opt)
        ->add_option(quiet_opt)
        ->add_option(release_opt)
        ->add_option(debug_opt)
        ->add_option(target_opt)
        ->add_option(backend_opt)
        ->add_option(output_opt)
        ->add_option(stdlib_opt)
        ->add_option(profile_opt)
        ->add_option(jobs_opt);

    const build_cmd =
        cli::Cmd.new(allocator, "build", command_build)
        .help("Build project")
        ->optional_argument(.Str)
        ->add_option(verbose_opt)
        ->add_option(quiet_opt)
        ->add_option(release_opt)
        ->add_option(debug_opt)
        ->add_option(backend_opt)
        ->add_option(output_opt)
        ->add_option(stdlib_opt)
        ->add_option(profile_opt)
        ->add_option(jobs_opt);

    const test_cmd =
        cli::Cmd.new(allocator, "test", command_build)
        .help("Run tests")
        ->add_option(verbose_opt)
        ->add_option(quiet_opt)
        ->add_option(target_opt)
        ->add_option(backend_opt)
        ->add_option(output_opt)
        ->add_option(jobs_opt);

    const clean_cmd =
        cli::Cmd.new(allocator, "clean", command_build)
        .help("Clean build artifacts");

    const dump_tokenize_cmd =
        cli::Cmd.new(allocator, "lexer", command_dump_lexer)
        .help("Dump scanned tokens")
        ->optional_argument(.Str);

    const dump_parse_cmd =
        cli::Cmd.new(allocator, "parser", command_dump_parser)
        .help("Parse file and dump the AST")
        ->optional_argument(.Str);

    const dump_resolve_cmd =
        cli::Cmd.new(allocator, "resolver", command_dump_resolver)
        .help("Resolve modules and dump the symbol table")
        ->optional_argument(.Str)
        ->add_option(stdlib_opt)
        ->add_option(profile_opt);

    const dump_analyze_cmd =
        cli::Cmd.new(allocator, "analyzer", command_dump_analyzer)
        .help("Analyze modules and dump the CIR")
        ->optional_argument(.Str)
        ->add_option(stdlib_opt)
        ->add_option(profile_opt);

    const dump_bir_cmd =
        cli::Cmd.new(allocator, "bir", command_dump_bir)
        .help("Analyze modules and dump the BackendIR")
        ->optional_argument(.Str)
        ->add_option(stdlib_opt)
        ->add_option(profile_opt);

    const dump_cmd =
        cli::Cmd.new(allocator, "dump", command_dump)
        .help("Dump compiler intermediate representations");

    dump_cmd->add_sub_command(*dump_tokenize_cmd);
    dump_cmd->add_sub_command(*dump_parse_cmd);
    dump_cmd->add_sub_command(*dump_resolve_cmd);
    dump_cmd->add_sub_command(*dump_analyze_cmd);
    dump_cmd->add_sub_command(*dump_bir_cmd);

    const version_cmd =
        cli::Cmd.new(allocator, "version", command_version)
        .help("Compiler version");

    app.register(*new_cmd);
    app.register(*run_cmd);
    app.register(*build_cmd);
    app.register(*test_cmd);
    app.register(*clean_cmd);
    app.register(*dump_cmd);
    app.register(*version_cmd);

    app.run(struct { argc, argv });
}

/* ************* Commands ************* */

fn command_new(ctx: cli::ActionContext) {
    @todo();
}

fn command_run(ctx: cli::ActionContext) {
    command_exit_code = build_or_run(ctx, true);
}

fn command_build(ctx: cli::ActionContext) {
    command_exit_code = build_or_run(ctx, false);
}

fn command_dump(ctx: cli::ActionContext) {
    ctx.print_help();
}

fn command_dump_lexer(ctx: cli::ActionContext) {
    command_exit_code = dump_lexer(ctx);
}

fn command_dump_parser(ctx: cli::ActionContext) {
    command_exit_code = dump_parser(ctx);
}

fn command_dump_resolver(ctx: cli::ActionContext) {
    command_exit_code = dump_resolver(ctx);
}

fn command_dump_analyzer(ctx: cli::ActionContext) {
    command_exit_code = dump_analyzed(ctx, false);
}

fn command_dump_bir(ctx: cli::ActionContext) {
    command_exit_code = dump_analyzed(ctx, true);
}

fn command_version(ctx: cli::ActionContext) {
    printf("Cyrus %s\n", version::COMPILER_VERSION);
}

/* ************* Compiler ************* */

// FIXME: Move to driver
fn build_or_run(ctx: cli::ActionContext, execute: bool) int32 {
    const allocator: Allocator = dynamic LibcAllocator.new();

    switch (ctx.args->get_str(0)) case .Some(file_path) else {
        compile_error("please provide an input file");
        return 1;
    }

    if (!os::is_file(file_path)) {
        compile_error("input must be a file");
        return 1;
    }

    if (execute) {
        switch (dir::TempDir.create(allocator)) case .Some(temp_dir) else {
            compile_error("failed to create a temporary directory");
            return 1;
        }
        defer temp_dir.free();

        var output_path = std::path::join_path(
            allocator,
            temp_dir.path(),
            "a.out"
        );

        defer output_path.free();
        defer dir::remove_file(output_path.as_str_const());

        const status = compile_file(allocator, ctx, &output_path);

        if (status != 0) {
            return status;
        }

        var command = process::Command.new(
            allocator,
            output_path.as_str_const()
        );
        defer command.free();

        const exit_status = command.exec();

        const child_status = @cast(uint32, exit_status);
        return @cast(int32, (child_status >> 8) & 0xff);
    }

    var output_path = String.new(allocator);
    defer output_path.free();

    var explicit_output: bool = false;

    switch (ctx.opts->find("output")) {
        case .Some(opt) => {
            switch (opt->values.get(0)) {
                case .Some(value) => {
                    switch (*value) {
                        case .Str(str) => {
                            output_path.free();
                            output_path = str.clone(allocator);
                            explicit_output = true;
                        }
                        else => {}
                    }
                }
                else => {}
            }
        }
        else => {}
    }

    if (!explicit_output) {
        var stem = std::path::file_stem(allocator, file_path);
        defer stem.free();

        var parent_dir = dir_of_file(allocator, file_path);
        defer parent_dir.free();

        output_path.free();
        output_path = std::path::join_path(
            allocator,
            parent_dir.as_str_const(),
            stem.as_str_const()
        );
    }

    return compile_file(allocator, ctx, &output_path);
}

// FIXME: Move to driver
fn compile_file(
    allocator: Allocator,
    ctx: cli::ActionContext,
    output_path: const String*
) int32 {
    switch (ctx.args->get_str(0)) case .Some(file_path) else {
        compile_error("please provide an input file");
        return 1;
    }

    var driver = CompilerDriver.new(allocator);
    defer driver.free();

    var opts = ResolverOptions.new(allocator);
    defer opts.free();

    opts.base_path.free();
    opts.base_path = dir::cwd(allocator);
    opts.source_dirs.push(dir_of_file(allocator, file_path));

    apply_stdlib_option(allocator, ctx.opts, &opts);

    if (!apply_profile_option(ctx.opts, &opts)) {
        return 1;
    }

    var resolver = Resolver.new(allocator, &driver, &opts);
    defer resolver.free();

    const lexical = driver.create_lexical_resource();
    const path = Path.new(allocator, file_path);

    switch (lexical.tokenize_source(path)) case .Value(var source_tokens) else {
        return 1;
    }
    defer source_tokens.free();

    switch (lexical.parse_source(source_tokens)) case .Value(var program) else {
        return 1;
    }
    defer program.free();

    resolver.resolve_entry(source_tokens.source_id, file_path, &program);

    if (driver.dctx.has_errors()) {
        driver.render_diags();
        return 1;
    }

    var analyzer_context = AnalyzerContext.new(
        allocator,
        &driver.dctx,
        &resolver.global_symbols,
        &resolver.decl_tables,
        resolver.program_trees
    );
    defer analyzer_context.free();

    trigger_analyzer(&analyzer_context);

    if (driver.dctx.has_errors()) {
        driver.render_diags();
        return 1;
    }

    var backend = String.from_str(allocator, "c");
    defer backend.free();

    switch (ctx.opts->find("backend")) {
        case .Some(opt) => {
            switch (opt->values.get(0)) {
                case .Some(value) => {
                    switch (*value) {
                        case .Str(str) => {
                            backend.free();
                            backend = str.clone(allocator);
                        }
                        else => {}
                    }
                }
                else => {}
            }
        }
        else => {}
    }

    if (backend.as_str_const() == "llvm") {
        compile_error("LLVM backend is not supported yet");
        return 1;
    }

    if (backend.as_str_const() != "c") {
        compile_error("unknown backend (expected `c` or `llvm`)");
        return 1;
    }

    var out = String.new(allocator);
    defer out.free();

    {
        const writer: Writer = dynamic StringWriter.new(&out);

        var codegen = CodegenC.new(
            allocator,
            &resolver.decl_tables,
            &resolver.global_symbols,
            &resolver.program_trees,
            &analyzer_context.vtable_registry,
            &analyzer_context.monomorph_registry,
            &driver.sctx
        );
        codegen.emit(writer);
        codegen.free();
    }

    if (!tcc::compile(
        out.as_str_const(),
        output_path->as_str_const(),
        tcc::OutputKind.EXE
    )) {
        compile_error("tcc failed to compile the input file");
        return 1;
    }

    return 0;
}

// FIXME: Move to driver
fn dump_lexer(ctx: cli::ActionContext) int32 {
    const allocator: Allocator = dynamic LibcAllocator.new();

    switch (ctx.args->get_str(0)) case .Some(file_path) else {
        compile_error("please provide an input file");
        return 1;
    }

    if (!os::is_file(file_path)) {
        compile_error("input must be a file");
        return 1;
    }

    var driver = CompilerDriver.new(allocator);
    defer driver.free();

    const lexical = driver.create_lexical_resource();
    const path = Path.new(allocator, file_path);

    switch (lexical.tokenize_source(path)) case .Value(var source_tokens) else {
        return 1;
    }
    defer source_tokens.free();

    dump_tokens(&source_tokens.tokens);

    return 0;
}

// FIXME: Move to driver
fn dump_parser(ctx: cli::ActionContext) int32 {
    const allocator: Allocator = dynamic LibcAllocator.new();

    switch (ctx.args->get_str(0)) case .Some(file_path) else {
        compile_error("please provide an input file");
        return 1;
    }

    if (!os::is_file(file_path)) {
        compile_error("input must be a file");
        return 1;
    }

    var driver = CompilerDriver.new(allocator);
    defer driver.free();

    const lexical = driver.create_lexical_resource();
    const path = Path.new(allocator, file_path);

    switch (lexical.tokenize_source(path)) case .Value(var source_tokens) else {
        return 1;
    }
    defer source_tokens.free();

    switch (lexical.parse_source(source_tokens)) case .Value(var program) else {
        return 1;
    }
    defer program.free();

    const writer: Writer = dynamic StdoutWriter.new();

    var dump = ASTDump.new(program, writer);
    dump.dump();

    return 0;
}

// FIXME: Move to driver
fn dump_resolver(ctx: cli::ActionContext) int32 {
    const allocator: Allocator = dynamic LibcAllocator.new();

    switch (ctx.args->get_str(0)) case .Some(file_path) else {
        compile_error("please provide an input file");
        return 1;
    }

    if (!os::is_file(file_path)) {
        compile_error("input must be a file");
        return 1;
    }

    var driver = CompilerDriver.new(allocator);
    defer driver.free();

    var opts = ResolverOptions.new(allocator);
    defer opts.free();

    opts.base_path.free();
    opts.base_path = dir::cwd(allocator);
    opts.source_dirs.push(dir_of_file(allocator, file_path));

    apply_stdlib_option(allocator, ctx.opts, &opts);

    if (!apply_profile_option(ctx.opts, &opts)) {
        return 1;
    }

    var resolver = Resolver.new(allocator, &driver, &opts);
    defer resolver.free();

    const lexical = driver.create_lexical_resource();
    const path = Path.new(allocator, file_path);

    switch (lexical.tokenize_source(path)) case .Value(var source_tokens) else {
        if (!driver.dctx.has_errors()) {
            resolver.dump_symbols();
        }
        return 1;
    }
    defer source_tokens.free();

    switch (lexical.parse_source(source_tokens)) case .Value(var program) else {
        if (!driver.dctx.has_errors()) {
            resolver.dump_symbols();
        }
        return 1;
    }
    defer program.free();

    resolver.resolve_entry(source_tokens.source_id, file_path, &program);

    driver.render_diags();

    if (driver.dctx.has_errors()) {
        return 1;
    }

    resolver.dump_symbols();

    return 0;
}

// FIXME: Move to driver
fn dump_analyzed(ctx: cli::ActionContext, backend_ir: bool) int32 {
    const allocator: Allocator = dynamic LibcAllocator.new();
    
    switch (ctx.args->get_str(0)) case .Some(file_path) else {
        compile_error("please provide an input file");
        return 1;
    }

    if (!os::is_file(file_path)) {
        compile_error("input must be a file");
        return 1;
    }

    var driver = CompilerDriver.new(allocator);
    defer driver.free();

    var opts = ResolverOptions.new(allocator);
    defer opts.free();

    opts.base_path.free();
    opts.base_path = dir::cwd(allocator);
    opts.source_dirs.push(dir_of_file(allocator, file_path));

    apply_stdlib_option(allocator, ctx.opts, &opts);

    if (!apply_profile_option(ctx.opts, &opts)) {
        return 1;
    }

    var resolver = Resolver.new(allocator, &driver, &opts);
    defer resolver.free();

    const lexical = driver.create_lexical_resource();
    const path = Path.new(allocator, file_path);

    switch (lexical.tokenize_source(path)) case .Value(var source_tokens) else {
        return 1;
    }
    defer source_tokens.free();

    switch (lexical.parse_source(source_tokens)) case .Value(var program) else {
        return 1;
    }
    defer program.free();

    resolver.resolve_entry(source_tokens.source_id, file_path, &program);

    if (driver.dctx.has_errors()) {
        driver.render_diags();
        return 1;
    }

    var arena = ArenaAllocator.new(allocator, 65000);
    defer arena.destroy();

    var analyzer_context = AnalyzerContext.new(
        dynamic arena,
        &driver.dctx,
        &resolver.global_symbols,
        &resolver.decl_tables,
        resolver.program_trees
    );
    defer analyzer_context.free();

    trigger_analyzer(&analyzer_context);

    if (!backend_ir) {
        driver.render_diags();
    }

    if (driver.dctx.has_errors()) {
        if (backend_ir) {
            driver.render_diags();
        }
        return 1;
    }

    const writer: Writer = dynamic StdoutWriter.new();

    if (backend_ir) {
        var codegen = CodegenC.new(
            allocator,
            &resolver.decl_tables,
            &resolver.global_symbols,
            &resolver.program_trees,
            &analyzer_context.vtable_registry,
            &analyzer_context.monomorph_registry,
            &driver.sctx
        );
        codegen.emit(writer);
        codegen.free();
    } else {
        dump::dump_cir(
            &resolver.global_symbols,
            &resolver.decl_tables,
            &resolver.program_trees,
            writer,
            allocator
        );
    }

    return 0;
}

/* ************* Options Helpers ************* */

fn apply_stdlib_option(
    allocator: Allocator,
    ctx_opts: const cli::Opts*,
    opts: ResolverOptions*
) {
    switch (ctx_opts->find("stdlib")) case .Some(opt) else {
        return;
    }

    switch (opt->values.get(0)) case .Some(value) else {
        return;
    }

    switch (*value) case .Str(value_str) else {
        return;
    }

    var stdlib = value_str.clone(allocator);

    switch (opts->stdlib_path) {
        case .Some(var prev) => {
            prev.free();
        }
        else => {}
    }

    opts->stdlib_path = .Some(stdlib);
}

fn apply_profile_option(
    ctx_opts: const cli::Opts*,
    opts: ResolverOptions*
) bool {
    switch (ctx_opts->find("profile")) case .Some(opt) else {
        return true;
    }

    switch (opt->values.get(0)) case .Some(value) else {
        return true;
    }

    switch (*value) case .Str(value_str) else {
        return true;
    }

    if (value_str.as_str_const() == "release") {
        opts->profile = .Release;
        return true;
    }

    if (value_str.as_str_const() == "debug") {
        opts->profile = .Debug;
        return true;
    }

    compile_error("invalid profile (expected `debug` or `release`)");
    return false;
}
