import std::collections{Vec};
import std::mem{Allocator};

import cir{
    TypedGenericParam,
    InterfaceDeclId,
    GlobalVarDeclId,
    GenericParamId,
    TypedBlockStmt,
    InterfaceDecl,
    GlobalVarDecl,
    TypedefDeclId,
    MethodDeclId,
    StructDeclId,
    UnionDeclId,
    TypedefDecl,
    MethodDecl,
    StructDecl,
    EnumDeclId,
    FuncDeclId,
    VarDeclId,
    UnionDecl,
    EnumDecl,
    FuncDecl,
    VarDecl,
    BodyId,
};

pub struct DeclTables {
    pub allocator: Allocator,
    pub structs: Vec<StructDecl>,
    pub enums: Vec<EnumDecl>,
    pub unions: Vec<UnionDecl>,
    pub funcs: Vec<FuncDecl>,
    pub methods: Vec<MethodDecl>,
    pub interfaces: Vec<InterfaceDecl>,
    pub global_vars: Vec<GlobalVarDecl>,
    pub vars: Vec<VarDecl>,
    pub typedefs: Vec<TypedefDecl>,
    pub generic_params: Vec<TypedGenericParam>,
    pub bodies: Vec<TypedBlockStmt>,

    pub fn new(allocator: Allocator) Self {
        return Self {
            allocator,
            structs: Vec.new(allocator),
            enums: Vec.new(allocator),
            unions: Vec.new(allocator),
            funcs: Vec.new(allocator),
            methods: Vec.new(allocator),
            interfaces: Vec.new(allocator),
            global_vars: Vec.new(allocator),
            vars: Vec.new(allocator),
            typedefs: Vec.new(allocator),
            generic_params: Vec.new(allocator),
            bodies: Vec.new(allocator),
        };
    }

    pub fn free(self: Self*) {
        self->structs.free();
        self->enums.free();
        self->unions.free();
        self->funcs.free();
        self->methods.free();
        self->interfaces.free();
        self->global_vars.free();
        self->vars.free();
        self->typedefs.free();
        self->generic_params.free();
        self->bodies.free();
    }

    pub fn insert_struct(self: Self*, decl: StructDecl) StructDeclId {
        const id = self->structs.len();
        self->structs.push(decl);
        return id;
    }

    pub fn insert_enum(self: Self*, decl: EnumDecl) EnumDeclId {
        const id = self->enums.len();
        self->enums.push(decl);
        return id;
    }

    pub fn insert_union(self: Self*, decl: UnionDecl) UnionDeclId {
        const id = self->unions.len();
        self->unions.push(decl);
        return id;
    }

    pub fn insert_func(self: Self*, decl: FuncDecl) FuncDeclId {
        const id = self->funcs.len();
        self->funcs.push(decl);
        return id;
    }

    pub fn insert_method(self: Self*, decl: MethodDecl) MethodDeclId {
        const id = self->methods.len();
        self->methods.push(decl);
        return id;
    }

    pub fn insert_interface(self: Self*, decl: InterfaceDecl) InterfaceDeclId {
        const id = self->interfaces.len();
        self->interfaces.push(decl);
        return id;
    }

    pub fn insert_global_var(self: Self*, decl: GlobalVarDecl) GlobalVarDeclId {
        const id = self->global_vars.len();
        self->global_vars.push(decl);
        return id;
    }

    pub fn insert_var(self: Self*, decl: VarDecl) VarDeclId {
        const id = self->vars.len();
        self->vars.push(decl);
        return id;
    }

    pub fn insert_typedef(self: Self*, decl: TypedefDecl) TypedefDeclId {
        const id = self->typedefs.len();
        self->typedefs.push(decl);
        return id;
    }

    pub fn insert_generic_param(self: Self*, decl: TypedGenericParam) GenericParamId {
        const id = self->generic_params.len();
        self->generic_params.push(decl);
        return id;
    }

    pub fn insert_body(self: Self*, decl: TypedBlockStmt) BodyId {
        const id = self->bodies.len();
        self->bodies.push(decl);
        return id;
    }
}
