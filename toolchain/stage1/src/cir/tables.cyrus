import std::collections{Vec};
import std::mem{Allocator};

import cir;

pub struct DeclTables {
    pub allocator: Allocator,
    pub structs: Vec<cir::StructDecl>,
    pub enums: Vec<cir::EnumDecl>,
    pub unions: Vec<cir::UnionDecl>,
    pub funcs: Vec<cir::FuncDecl>,
    pub methods: Vec<cir::MethodDecl>,
    pub interfaces: Vec<cir::InterfaceDecl>,
    pub global_vars: Vec<cir::GlobalVarDecl>,
    pub vars: Vec<cir::VarDecl>,
    pub typedefs: Vec<cir::TypedefDecl>,
    pub generic_params: Vec<cir::TypedGenericParam>,
    pub bodies: Vec<cir::TypedBlockStmt>,

    pub fn new(allocator: Allocator) Self {
        return Self {
            allocator,
            structs: Vec.new(allocator),
            enums: Vec.new(allocator),
            unions: Vec.new(allocator),
            funcs: Vec.new(allocator),
            methods: Vec.new(allocator),
            interfaces: Vec.new(allocator),
            global_vars: Vec.new(allocator),
            vars: Vec.new(allocator),
            typedefs: Vec.new(allocator),
            generic_params: Vec.new(allocator),
            bodies: Vec.new(allocator),
        };
    }

    pub fn free(self: Self*) {
        self->structs.free();
        self->enums.free();
        self->unions.free();
        self->funcs.free();
        self->methods.free();
        self->interfaces.free();
        self->global_vars.free();
        self->vars.free();
        self->typedefs.free();
        self->generic_params.free();
        self->bodies.free();
    }

    pub fn insert_struct(self: Self*, decl: cir::StructDecl) cir::StructDeclId {
        const id = self->structs.len();
        self->structs.push(decl);
        return id;
    }

    pub fn insert_enum(self: Self*, decl: cir::EnumDecl) cir::EnumDeclId {
        const id = self->enums.len();
        self->enums.push(decl);
        return id;
    }

    pub fn insert_union(self: Self*, decl: cir::UnionDecl) cir::UnionDeclId {
        const id = self->unions.len();
        self->unions.push(decl);
        return id;
    }

    pub fn insert_func(self: Self*, decl: cir::FuncDecl) cir::FuncDeclId {
        const id = self->funcs.len();
        self->funcs.push(decl);
        return id;
    }

    pub fn insert_method(self: Self*, decl: cir::MethodDecl) cir::MethodDeclId {
        const id = self->methods.len();
        self->methods.push(decl);
        return id;
    }

    pub fn insert_interface(self: Self*, decl: cir::InterfaceDecl) cir::InterfaceDeclId {
        const id = self->interfaces.len();
        self->interfaces.push(decl);
        return id;
    }

    pub fn insert_global_var(self: Self*, decl: cir::GlobalVarDecl) cir::GlobalVarDeclId {
        const id = self->global_vars.len();
        self->global_vars.push(decl);
        return id;
    }

    pub fn insert_var(self: Self*, decl: cir::VarDecl) cir::VarDeclId {
        const id = self->vars.len();
        self->vars.push(decl);
        return id;
    }

    pub fn insert_typedef(self: Self*, decl: cir::TypedefDecl) cir::TypedefDeclId {
        const id = self->typedefs.len();
        self->typedefs.push(decl);
        return id;
    }

    pub fn insert_generic_param(self: Self*, decl: cir::TypedGenericParam) cir::GenericParamId {
        const id = self->generic_params.len();
        self->generic_params.push(decl);
        return id;
    }

    pub fn insert_body(self: Self*, decl: cir::TypedBlockStmt) cir::BodyId {
        const id = self->bodies.len();
        self->bodies.push(decl);
        return id;
    }
}
