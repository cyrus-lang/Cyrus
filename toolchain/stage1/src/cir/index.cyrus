/* ************* Literals ************* */

pub enum IntegerLiteral {
    Signed(int128),
    Unsigned(uint128),
}

/* ************* Builtins ************* */

pub enum TypedBuiltin {
    BuiltinBlock(TypedBuiltinBlock),
    BuiltinFunc(TypedBuiltinFunc),

    [[inline]]
    pub fn span(self: const Self*) Span {
        switch (*self) {
            case .BuiltinBlock(builtin_block) => return builtin_block.span;
            case .BuiltinFunc(builtin_func) => return builtin_func.span;
        }
    }
}

pub enum TypedBuiltinForm {
    Expr,
    Stmt,
}

pub struct TypedBuiltinFunc {
    pub name: ast::ASTIdent,
    pub args: Vec<TypedExpr>,
    pub ret_type: Option<SemaType>,
    pub span: Span,
}

pub struct TypedBuiltinBlock {
    pub name: ast::ASTIdent,
    pub args: Vec<TypedExpr>,
    pub block: TypedBlockStmt*,
    pub is_toplevel: Option<bool>,
    pub span: Span,
}

pub enum TypedBuiltinFamily {
    ConstEval,
    Intrinsic,
}

pub enum TypedBuiltinPhase {
    Resolver,
    ConstEval,
    Codegen,
}

pub enum TypedBuiltinKind {
    FuncName,
    MethodName,
    ModuleName,
    FileName,
    Line,
    Column,

    SizeOf,
    AlignOf,
    OffsetOf,
    TypeOf,

    Cast,
    Memcpy,
    Memset,
    Assert,
    Panic,
    Todo,
    Unimplemented,
    Unreachable,

    Debug,
    Release,
    Unroll,
}

pub struct TypedBuiltinSpec {
    pub kind: TypedBuiltinKind,
    pub name: const uint8*,

    pub family: TypedBuiltinFamily,
    pub phase: TypedBuiltinPhase,
    pub form: TypedBuiltinForm,
    pub unreachable: bool,

    pub min_args: usize,
    pub max_args: Option<usize>,
}

pub fn lookup_builtin(name: const uint8*) Option<TypedBuiltinKind> {
    switch (name) {
        case "unimplemented" => return .Some(.Unimplemented);
        case "unreachable" => return .Some(.Unreachable);
        case "method_name" => return .Some(.MethodName);
        case "module_name" => return .Some(.ModuleName);
        case "func_name" => return .Some(.FuncName);
        case "file_name" => return .Some(.FileName);
        case "offsetof" => return .Some(.OffsetOf);
        case "alignof" => return .Some(.AlignOf);
        case "release" => return .Some(.Release);
        case "typeof" => return .Some(.TypeOf);
        case "column" => return .Some(.Column);
        case "sizeof" => return .Some(.SizeOf);
        case "memcpy" => return .Some(.Memcpy);
        case "memset" => return .Some(.Memset);
        case "assert" => return .Some(.Assert);
        case "panic" => return .Some(.Panic);
        case "debug" => return .Some(.Debug);
        case "line" => return .Some(.Line);
        case "cast" => return .Some(.Cast);
        case "todo" => return .Some(.Todo);
        else => return .None;
    }
}

pub fn builtin_spec_of(kind: TypedBuiltinKind) TypedBuiltinSpec {
    switch (kind) {
        case .FuncName => return TypedBuiltinSpec {
            kind,
            name: "func_name",
            family: .ConstEval,
            phase: .ConstEval,
            form: .Expr,
            unreachable: false,
            min_args: 0,
            max_args: .Some(0),
        };
        
        case .MethodName => return TypedBuiltinSpec {
            kind,
            name: "method_name",
            family: .ConstEval,
            phase: .ConstEval,
            form: .Expr,
            unreachable: false,
            min_args: 0,
            max_args: .Some(0),
        };
        
        case .ModuleName => return TypedBuiltinSpec {
            kind,
            name: "module_name",
            family: .ConstEval,
            phase: .ConstEval,
            form: .Expr,
            unreachable: false,
            min_args: 0,
            max_args: .Some(0),
        };
        
        case .FileName => return TypedBuiltinSpec {
            kind,
            name: "file_name",
            family: .ConstEval,
            phase: .ConstEval,
            form: .Expr,
            unreachable: false,
            min_args: 0,
            max_args: .Some(0),
        };
        
        case .Line => return TypedBuiltinSpec {
            kind,
            name: "line",
            family: .ConstEval,
            phase: .ConstEval,
            form: .Expr,
            unreachable: false,
            min_args: 0,
            max_args: .Some(0),
        };
        
        case .Column => return TypedBuiltinSpec {
            kind,
            name: "column",
            family: .ConstEval,
            phase: .ConstEval,
            form: .Expr,
            unreachable: false,
            min_args: 0,
            max_args: .Some(0),
        };
        
        case .SizeOf => return TypedBuiltinSpec {
            kind,
            name: "sizeof",
            family: .ConstEval,
            phase: .ConstEval,
            form: .Expr,
            unreachable: false,
            min_args: 1,
            max_args: .Some(1),
        };
        
        case .AlignOf => return TypedBuiltinSpec {
            kind,
            name: "alignof",
            family: .ConstEval,
            phase: .ConstEval,
            form: .Expr,
            unreachable: false,
            min_args: 1,
            max_args: .Some(1),
        };
        
        case .OffsetOf => return TypedBuiltinSpec {
            kind,
            name: "offsetof",
            family: .ConstEval,
            phase: .ConstEval,
            form: .Expr,
            unreachable: false,
            min_args: 2,
            max_args: .Some(2),
        };
        
        case .TypeOf => return TypedBuiltinSpec {
            kind,
            name: "typeof",
            family: .ConstEval,
            phase: .ConstEval,
            form: .Expr,
            unreachable: false,
            min_args: 1,
            max_args: .Some(1),
        };
        
        case .Cast => return TypedBuiltinSpec {
            kind,
            name: "cast",
            family: .Intrinsic,
            phase: .Codegen,
            form: .Expr,
            unreachable: false,
            min_args: 2,
            max_args: .Some(2),
        };
        
        case .Memcpy => return TypedBuiltinSpec {
            kind,
            name: "memcpy",
            family: .Intrinsic,
            phase: .Codegen,
            form: .Expr,
            unreachable: false,
            min_args: 3,
            max_args: .Some(3),
        };
        
        case .Memset => return TypedBuiltinSpec {
            kind,
            name: "memset",
            family: .Intrinsic,
            phase: .Codegen,
            form: .Expr,
            unreachable: false,
            min_args: 3,
            max_args: .Some(3),
        };
        
        case .Assert => return TypedBuiltinSpec {
            kind,
            name: "assert",
            family: .Intrinsic,
            phase: .Codegen,
            form: .Expr,
            unreachable: false,
            min_args: 1,
            max_args: .Some(2),
        };
        
        case .Panic => return TypedBuiltinSpec {
            kind,
            name: "panic",
            family: .Intrinsic,
            phase: .Codegen,
            form: .Expr,
            unreachable: true,
            min_args: 0,
            max_args: .Some(1),
        };
        
        case .Todo => return TypedBuiltinSpec {
            kind,
            name: "todo",
            family: .Intrinsic,
            phase: .Codegen,
            form: .Expr,
            unreachable: true,
            min_args: 0,
            max_args: .Some(1),
        };
        
        case .Unimplemented => return TypedBuiltinSpec {
            kind,
            name: "unimplemented",
            family: .Intrinsic,
            phase: .Codegen,
            form: .Expr,
            unreachable: true,
            min_args: 0,
            max_args: .Some(1),
        };
        
        case .Unreachable => return TypedBuiltinSpec {
            kind,
            name: "unreachable",
            family: .Intrinsic,
            phase: .Codegen,
            form: .Expr,
            unreachable: true,
            min_args: 0,
            max_args: .Some(1),
        };
        
        case .Debug => return TypedBuiltinSpec {
            kind,
            name: "debug",
            family: .ConstEval,
            phase: .Resolver,
            form: .Stmt,
            unreachable: false,
            min_args: 0,
            max_args: .Some(0),
        };
        
        case .Release => return TypedBuiltinSpec {
            kind,
            name: "release",
            family: .ConstEval,
            phase: .Resolver,
            form: .Stmt,
            unreachable: false,
            min_args: 0,
            max_args: .Some(0),
        };
        
        case .Unroll => @panic("builtin spec missing");
    }
}

pub fn is_builtin_unreachable(name: const uint8*) bool {
    switch (lookup_builtin(name)) {
        case .Some(builtin_kind) => return builtin_spec_of(builtin_kind).unreachable;
        case .None => @panic("unknown builtin");
    }
}

/* ************* Types ************* */

pub enum SemaType {
    InterfaceObject(InterfaceObjectType),
    GenericParam(GenericParamId),
    Unresolved(UnresolvedType),
    FuncType(TypedFuncType),
    SelfType(TypedSelfType),
    Array(TypedArrayType),
    Tuple(TypedTupleType),
    InferVar(InferVarId),
    Pointer(SemaType*),
    Const(SemaType*),
    Plain(PlainType),
    Named(NamedType),
    Placeholder,
    Err(Span),

    /// Returns true if this type contains `Unresolved` inside it.
    pub fn includes_unresolved_type(self: const Self*) bool {
        switch (*self) {
            case .Unresolved => return true;

            case .Err
            | .Plain
            | .SelfType
            | .GenericParam
            | .InferVar
            | .Placeholder => return false;

            case .Named(named_type) => {
                for (var i: usize = 0; i < named_type.type_args.len(); i += 1) {
                    const type_arg = named_type.type_args.get(i).unwrap();

                    switch (*type_arg) {
                        case .Type(ty, _) => if (ty.includes_unresolved_type()) {
                            return true;
                        }
                    }
                }

                return false;
            }

            case .FuncType(func) => {
                for (var i: usize = 0; i < func.params.list.len(); i += 1) {
                    const ty = func.params.list.get_const(i).unwrap();

                    if (ty->includes_unresolved_type()) {
                        return true;
                    }
                }

                switch (func.params.variadic) {
                    case .Some(variadic) => switch (*variadic) {
                        case .Typed(ty) => if (ty.includes_unresolved_type()) {
                            return true;
                        }
                    }
                }

                return func.ret_type->includes_unresolved_type();
            }

            case .Tuple(tuple) => {
                for (var i: usize = 0; i < tuple.elements.len(); i += 1) {
                    const element = tuple.elements.get_const(i).unwrap();

                    if (element->ty.includes_unresolved_type()) {
                        return true;
                    }
                }

                return false;
            }

            case .InterfaceObject(interface_obj) => {
                for (var i: usize = 0; i < interface_obj.interface_type.type_args.len(); i += 1) {
                    const type_arg = interface_obj.interface_type.type_args.get(i).unwrap();

                    switch (*type_arg) {
                        case .Type(ty, _) => if (ty.includes_unresolved_type()) {
                            return true;
                        }
                    }
                }

                return interface_obj.concrete_type->includes_unresolved_type();
            }

            case .Array(array) => return array.element_type->includes_unresolved_type();
            
            case .Pointer(inner) => return inner->includes_unresolved_type();
            
            case .Const(inner) => return inner->includes_unresolved_type();
        }
    }

    // TODO: Rename
    [[inline]]
    pub fn as_unresolved_decl_id(self: const Self*) Option<SymbolId> {
        switch (*self->const_inner()) {
            case .Unresolved(unresolved_type) => return unresolved_type.as_symbol_id();
            else => return .None;
        }
    }

    // TODO: Rename
    [[inline]]
    pub fn as_unresolved_base_decl_id(self: const Self*) Option<SymbolId> {
        switch (*self->const_inner()) {
            case .Unresolved(unresolved_type) => return unresolved_type.as_base_symbol_id();
            else => return .None;
        }
    }

    [[inline]]
    pub fn const_inner(self: const Self*) const SemaType* {
        switch (*self) {
            case .Const(sema_type) => return sema_type;
            else => return self;
        }
    }

    [[inline]]
    pub fn count_const_layers(self: const Self*) usize {
        switch (*self) {
            case .Const(inner) => return 1 + inner->count_const_layers();
            else => return 0;
        }
    }

    [[inline]]
    pub fn pointer_inner(self: const Self*) const SemaType* {
        switch (*self) {
            case .Pointer(sema_type) => return sema_type;
            else => return self;
        }
    }

    [[inline]]
    pub fn as_plain_type(self: const Self*) Option<PlainType> {
        switch (*self->const_inner()) {
            case .Plain(ty) => return .Some(ty);
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_named_type(self: const Self*) Option<NamedType> {
        switch (*self->const_inner()) {
            case .Named(named_type) => return .Some(named_type);
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_struct(self: const Self*) Option<StructDeclId> {
        switch (*self->const_inner()) {
            case .Named(named_type) => return named_type.type_decl_id.as_struct();
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_union(self: const Self*) Option<UnionDeclId> {
        switch (*self->const_inner()) {
            case .Named(named_type) => return named_type.type_decl_id.as_union();
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_enum(self: const Self*) Option<EnumDeclId> {
        switch (*self->const_inner()) {
            case .Named(named_type) => return named_type.type_decl_id.as_enum();
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_named_interface(self: const Self*) Option<InterfaceDeclId> {
        switch (*self->const_inner()) {
            case .Named(named_type) => return named_type.type_decl_id.as_interface();
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_interface_object(self: const Self*) Option<InterfaceObjectType> {
        switch (*self->const_inner()) {
            case .InterfaceObject(interface_object) => return .Some(interface_object);
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_tuple_type(self: const Self*) Option<TypedTupleType> {
        switch (*self->const_inner()) {
            case .Tuple(tuple_type) => return .Some(tuple_type);
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_func_type(self: const Self*) Option<TypedFuncType> {
        switch (*self->const_inner()) {
            case .FuncType(func_type) => return .Some(func_type);
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_array_type(self: const Self*) Option<TypedArrayType> {
        switch (*self->const_inner()) {
            case .Array(ty) => return .Some(ty);
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_self_type(self: const Self*) Option<TypedSelfType> {
        switch (*self->const_inner()) {
            case .SelfType(self_type) => return .Some(self_type);
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_generic_param(self: const Self*) Option<GenericParamId> {
        switch (*self->const_inner()) {
            case .GenericParam(generic_param_id) => return .Some(generic_param_id);
            else => return .None;
        }
    }

    [[inline]]
    pub fn is_err(self: const Self*) bool {
        switch (*self) {
            case .Err => return true;
            else => return false;
        }
    }

    [[inline]]
    pub fn is_error(self: const Self*) bool {
        switch (*self->const_inner()) {
            case .Err => return true;
            else => return false;
        }
    }

    pub fn contains_error(self: const Self*) bool {
        switch (*self->const_inner()) {
            case .Err => return true;

            case .Unresolved
            | .Plain
            | .SelfType
            | .GenericParam
            | .InferVar
            | .Placeholder => return false;

            case .Named(named_type) => {
                for (var i: usize = 0; i < named_type.type_args.len(); i += 1) {
                    const type_arg = named_type.type_args.get(i).unwrap();

                    switch (*type_arg) {
                        case .Type(ty, _) => if (ty.contains_error()) {
                            return true;
                        }
                    }
                }

                return false;
            }

            case .FuncType(func) => {
                for (var i: usize = 0; i < func.params.list.len(); i += 1) {
                    const ty = func.params.list.get_const(i).unwrap();

                    if (ty->contains_error()) {
                        return true;
                    }
                }

                switch (func.params.variadic) {
                    case .Some(variadic) => switch (*variadic) {
                        case .Typed(ty) => if (ty.contains_error()) {
                            return true;
                        }
                    }
                }

                return func.ret_type->contains_error();
            }

            case .Tuple(tuple) => {
                for (var i: usize = 0; i < tuple.elements.len(); i += 1) {
                    const element = tuple.elements.get_const(i).unwrap();

                    if (element->ty.contains_error()) {
                        return true;
                    }
                }

                return false;
            }

            case .InterfaceObject(interface_obj) => {
                for (var i: usize = 0; i < interface_obj.interface_type.type_args.len(); i += 1) {
                    const type_arg = interface_obj.interface_type.type_args.get(i).unwrap();

                    switch (*type_arg) {
                        case .Type(ty, _) => if (ty.contains_error()) {
                            return true;
                        }
                    }
                }

                return interface_obj.concrete_type->contains_error();
            }

            case .Array(array) => return array.element_type->contains_error();
            
            case .Pointer(inner) => return inner->contains_error();
            
            case .Const(inner) => return inner->contains_error();
        }
    }

    pub fn contains_unresolved(self: const Self*) bool {
        switch (*self->const_inner()) {
            case .Unresolved => return true;

            case .Err
            | .Plain
            | .SelfType
            | .GenericParam
            | .InferVar
            | .Placeholder => return false;

            case .Named(named_type) => {
                for (var i: usize = 0; i < named_type.type_args.len(); i += 1) {
                    const type_arg = named_type.type_args.get(i).unwrap();

                    switch (*type_arg) {
                        case .Type(ty, _) => if (ty.contains_unresolved()) {
                            return true;
                        }
                    }
                }

                return false;
            }

            case .FuncType(func) => {
                for (var i: usize = 0; i < func.params.list.len(); i += 1) {
                    const ty = func.params.list.get_const(i).unwrap();

                    if (ty->contains_unresolved()) {
                        return true;
                    }
                }

                switch (func.params.variadic) {
                    case .Some(variadic) => switch (*variadic) {
                        case .Typed(ty) => if (ty.contains_unresolved()) {
                            return true;
                        }
                    }
                }

                return func.ret_type->contains_unresolved();
            }

            case .Tuple(tuple) => {
                for (var i: usize = 0; i < tuple.elements.len(); i += 1) {
                    const element = tuple.elements.get_const(i).unwrap();

                    if (element->ty.contains_unresolved()) {
                        return true;
                    }
                }

                return false;
            }

            case .InterfaceObject(interface_obj) => {
                for (var i: usize = 0; i < interface_obj.interface_type.type_args.len(); i += 1) {
                    const type_arg = interface_obj.interface_type.type_args.get(i).unwrap();

                    switch (*type_arg) {
                        case .Type(ty, _) => if (ty.contains_unresolved()) {
                            return true;
                        }
                    }
                }

                return interface_obj.concrete_type->contains_unresolved();
            }

            case .Array(array) => return array.element_type->contains_unresolved();
            
            case .Pointer(inner) => return inner->contains_unresolved();
            
            case .Const(inner) => return inner->contains_unresolved();
        }
    }

    [[inline]]
    pub fn is_unresolved(self: const Self*) bool {
        switch (*self) {
            case .Unresolved => return true;
            else => return false;
        }
    }

