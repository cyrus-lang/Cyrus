    [[inline]]
    pub fn new(allocator: Allocator) Self {
        return Self { list: Vec.new(allocator) };
    }

    [[inline]]
    pub fn get(self: const Self*, index: usize) Option<const TypedTypeArg*> {
        return self->list.get_const(index);
    }

    [[inline]]
    pub fn is_empty(self: const Self*) bool {
        return self->list.is_empty();
    }

    [[inline]]
    pub fn len(self: const Self*) usize {
        return self->list.len();
    }

    [[inline]]
    pub fn push(self: Self*, ty: TypedTypeArg) {
        self->list.push(ty);
    }
}

pub enum TypedTypeArg {
    Type(SemaType, Span),
    Infer,
}

pub struct TypedBound {
    pub ty: SemaType,
    pub span: Span,
}

/* ************* Declarations ************* */

pub enum DeclId {
    Interface(InterfaceDeclId),
    GlobalVar(GlobalVarDeclId),
    Typedef(TypedefDeclId),
    Method(MethodDeclId),
    Struct(StructDeclId),
    Union(UnionDeclId),
    Func(FuncDeclId),
    Enum(EnumDeclId),
    Var(VarDeclId),

    [[inline]]
    pub fn as_type_decl_id(self: const Self*) Option<TypeDeclId> {
        switch (*self) {
            case .Struct(id) => return .Some(.Struct(id));
            case .Enum(id) => return .Some(.Enum(id));
            case .Union(id) => return .Some(.Union(id));
            case .Interface(id) => return .Some(.Interface(id));
            case .Typedef(id) => return .Some(.Typedef(id));
            case .Func | .Method | .GlobalVar | .Var => return .None;
        }
    }

    [[inline]]
    pub fn is_var(self: const Self*) bool {
        switch (*self) {
            case .Var => return true;
            else => return false;
        }
    }

    [[inline]]
    pub fn is_global_var(self: const Self*) bool {
        switch (*self) {
            case .GlobalVar => return true;
            else => return false;
        }
    }

    [[inline]]
    pub fn is_var_or_global_var(self: const Self*) bool {
        switch (*self) {
            case .Var | .GlobalVar => return true;
            else => return false;
        }
    }

    [[inline]]
    pub fn is_func(self: const Self*) bool {
        switch (*self) {
            case .Func => return true;
            else => return false;
        }
    }

    [[inline]]
    pub fn as_struct(self: const Self*) Option<StructDeclId> {
        switch (*self) {
            case .Struct(id) => return .Some(id);
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_enum(self: const Self*) Option<EnumDeclId> {
        switch (*self) {
            case .Enum(id) => return .Some(id);
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_union(self: const Self*) Option<UnionDeclId> {
        switch (*self) {
            case .Union(id) => return .Some(id);
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_func(self: const Self*) Option<FuncDeclId> {
        switch (*self) {
            case .Func(id) => return .Some(id);
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_method(self: const Self*) Option<MethodDeclId> {
        switch (*self) {
            case .Method(id) => return .Some(id);
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_interface(self: const Self*) Option<InterfaceDeclId> {
        switch (*self) {
            case .Interface(id) => return .Some(id);
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_global_var(self: const Self*) Option<GlobalVarDeclId> {
        switch (*self) {
            case .GlobalVar(id) => return .Some(id);
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_var(self: const Self*) Option<VarDeclId> {
        switch (*self) {
            case .Var(id) => return .Some(id);
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_typedef(self: const Self*) Option<TypedefDeclId> {
        switch (*self) {
            case .Typedef(id) => return .Some(id);
            else => return .None;
        }
    }
}

pub fn clone_typed_type_args(
    allocator: Allocator,
    src: const TypedTypeArgs*
) TypedTypeArgs {
    var list: Vec<TypedTypeArg> = Vec.new(allocator);
    
    for (var i: usize = 0; i < src->list.len(); i += 1) {
        list.push(*src->list.get_const(i).unwrap());
    }

    return TypedTypeArgs { list };
}

pub fn clone_method_decls(
    allocator: Allocator,
    src: const MethodDecls*
) MethodDecls {
    var out = MethodDecls.new(allocator);
    
    for (var i: usize = 0; i < src->entries.len(); i += 1) {
        const entry = src->entries.get_const(i).unwrap();

        out.entries.push(MethodDeclEntry {
            name: entry->name.clone(allocator),
            id: entry->id,
        });
    }

    return out;
}

pub struct MethodDeclEntry {
    pub name: String,
    pub id: MethodDeclId,
}

pub struct MethodDecls {
    pub entries: Vec<MethodDeclEntry>,

    [[inline]]
    pub fn new(allocator: Allocator) Self {
        return Self { entries: Vec.new(allocator) };
    }

    [[inline]]
    pub fn len(self: const Self*) usize {
        return self->entries.len();
    }

    pub fn insert(self: Self*, name: String, method_decl_id: MethodDeclId) bool {
        for (var i: usize = 0; i < self->entries.len(); i += 1) {
            const entry = self->entries.get(i).unwrap();

            if (entry->name.as_str_const() == name.as_str_const()) {
                entry->id = method_decl_id;
                name.free();
                return false;
            }
        }

        self->entries.push(MethodDeclEntry { name, id: method_decl_id });
        return true;
    }

    pub fn get(self: const Self*, name: const uint8*) Option<MethodDeclId> {
        for (var i: usize = 0; i < self->entries.len(); i += 1) {
            const entry = self->entries.get_const(i).unwrap();

            if (entry->name.as_str_const() == name) {
                return .Some(entry->id);
            }
        }

        return .None;
    }

    [[inline]]
    pub fn contains(self: const Self*, name: const uint8*) bool {
        switch (self->get(name)) {
            case .Some => return true;
            case .None => return false;
        }
    }

    pub fn contains_method_id(self: const Self*, method_decl_id: MethodDeclId) bool {
        for (var i: usize = 0; i < self->entries.len(); i += 1) {
            const entry = self->entries.get_const(i).unwrap();

            if (entry->id == method_decl_id) {
                return true;
            }
        }

        return false;
    }

    pub fn free(self: Self*) {
        for (var i: usize = 0; i < self->entries.len(); i += 1) {
            const entry = self->entries.get(i).unwrap();
            entry->name.free();
        }

        self->entries.free();
    }
}

pub struct StructDecl {
    pub name: Option<String>,
    pub fields: Vec<TypedStructField>,
    pub impls: Vec<TypedImplementInterface>,
    pub methods: MethodDecls,
    pub generic_params: TypedGenericParams,
    pub modifiers: ast::ASTStructModifiers,
    pub align: Option<usize>,
    pub is_normalized: bool,
    pub span: Span,

    [[inline]]
    pub fn is_generic(self: const Self*) bool {
        return !self->generic_params.is_empty();
    }

    pub fn lookup_field(self: const Self*, name: const uint8*) Option<const TypedStructField*> {
        for (var i: usize = 0; i < self->fields.len(); i += 1) {
            const field = self->fields.get_const(i).unwrap();

            if (field->name.as_str_const() == name) {
                return .Some(field);
            }
        }

        return .None;
    }

    pub fn is_packed(self: const Self*) bool {
        switch (self->modifiers.repr_attr) {
            case .Some(repr_attr) => {
                for (var i: usize = 0; i < repr_attr.items.len(); i += 1) {
                    const item = repr_attr.items.get_const(i).unwrap();

                    switch (item->kind) {
                        case .Packed => return true;
                        else => {}
                    }
                }

                return false;
            }
            case .None => return false;
        }
    }
}

pub struct UnionDecl {
    pub name: Option<String>,
    pub fields: Vec<TypedUnionField>,
    pub impls: Vec<TypedImplementInterface>,
    pub methods: MethodDecls,
    pub generic_params: TypedGenericParams,
    pub modifiers: ast::ASTUnionModifiers,
    pub align: Option<usize>,
    pub is_normalized: bool,
    pub span: Span,

    [[inline]]
    pub fn is_generic(self: const Self*) bool {
        return !self->generic_params.is_empty();
    }

    pub fn lookup_field(self: const Self*, name: const uint8*) Option<const TypedUnionField*> {
        for (var i: usize = 0; i < self->fields.len(); i += 1) {
            const field = self->fields.get_const(i).unwrap();

            if (field->name.as_str_const() == name) {
                return .Some(field);
            }
        }

        return .None;
    }
}

pub struct EnumDecl {
    pub name: Option<String>,
    pub methods: MethodDecls,
    pub variants: Vec<TypedEnumVariant>,
    pub impls: Vec<TypedImplementInterface>,
    pub generic_params: TypedGenericParams,
    pub modifiers: ast::ASTEnumModifiers,
    pub tag_type: Option<SemaType>,
    pub align: Option<usize>,
    pub is_normalized: bool,
    pub span: Span,

    [[inline]]
    pub fn is_generic(self: const Self*) bool {
        return !self->generic_params.is_empty();
    }

    pub fn lookup_variant(self: const Self*, name: const uint8*) Option<const TypedEnumVariant*> {
        for (var i: usize = 0; i < self->variants.len(); i += 1) {
            const variant = self->variants.get_const(i).unwrap();

            switch (*variant) {
                case .Unit(ident) => {
                    if (ident.str.as_str_const() == name) {
                        return .Some(variant);
                    }
                }
                case .Valued { ident, .. } => {
                    if (ident.str.as_str_const() == name) {
                        return .Some(variant);
                    }
                }
                case .Tuple { ident, .. } => {
                    if (ident.str.as_str_const() == name) {
                        return .Some(variant);
                    }
                }
                case .Struct { ident, .. } => {
                    if (ident.str.as_str_const() == name) {
                        return .Some(variant);
                    }
                }
            }
        }

        return .None;
    }

    pub fn is_repr_c(self: const Self*) bool {
        switch (self->modifiers.repr_attr) {
            case .Some(repr_attr) => {
                for (var i: usize = 0; i < repr_attr.items.len(); i += 1) {
                    const item = repr_attr.items.get_const(i).unwrap();

                    switch (item->kind) {
                        case .Kind(.C) => return true;
                        else => {}
                    }
                }
            }
            else => {}
        }

        return false;
    }
}

pub struct FuncDecl {
    pub file_id: SourceId,
    pub name: String,
    pub params: TypedFuncParams,
    pub generic_params: TypedGenericParams,
    pub ret_type: SemaType,
    pub body: Option<BodyId>,

    pub is_func_decl: bool,
    pub modifiers: ast::ASTFuncModifiers,
    pub span: Span,

    pub fn is_generic(self: const Self*) bool {
        return !self->generic_params.is_empty();
    }

    pub fn decl_contains_any_infer_var(self: const Self*) bool {
        for (var i: usize = 0; i < self->params.list.len(); i += 1) {
            const param = self->params.list.get_const(i).unwrap();

            switch (*param) {
                case .FuncParam(func_param) => {
                    if (func_param.ty.contains_infer_var()) {
                        return true;
                    }
                }
                case .SelfModifier(self_modifier) => {
                    if (self_modifier.ty.contains_infer_var()) {
                        return true;
                    }
                }
            }
        }

        switch (self->params.variadic) {
            case .Some(.Typed { ty, .. }) => {
                if (ty.contains_infer_var()) {
                    return true;
                }
            }
            else => {}
        }

        return false;
    }
}

pub struct MethodDecl {
    /// Object name is used for name-mangling.
    pub object_name: Option<String>,
    pub func_decl: FuncDecl,
    pub body: Option<BodyId>,

    pub fn is_instance_method(self: const Self*) bool {
        return self->func_decl.params.is_instance_method();
    }
}

pub struct TypedefDecl {
    pub name: String,
    pub ty: SemaType*,
    pub generic_params: TypedGenericParams,
    pub vis: ast::ASTVisibility,
    pub span: Span,
}

pub struct InterfaceDecl {
    pub name: String,
    pub methods: MethodDecls,
    pub generic_params: TypedGenericParams,
    pub is_interface_dynamically_dispatchable: bool,
    pub vis: ast::ASTVisibility,
    pub span: Span,

    pub fn is_generic(self: const Self*) bool {
        return !self->generic_params.is_empty();
    }

    pub fn method_index(self: const Self*, name: const uint8*) Option<usize> {
        for (var i: usize = 0; i < self->methods.entries.len(); i += 1) {
            const entry = self->methods.entries.get_const(i).unwrap();

            if (entry->name.as_str_const() == name) {
                return .Some(i);
            }
        }

        return .None;
    }

    pub fn get_method(self: const Self*, name: const uint8*) Option<MethodDeclId> {
        return self->methods.get(name);
    }
}

pub struct GlobalVarDecl {
    pub file_id: SourceId,
    pub name: String,
    pub ty: Option<SemaType>,
    pub rhs: Option<TypedExpr>,
    pub is_const: bool,
    pub is_static: bool,
    pub analyzed: bool,
    pub modifiers: ast::ASTGlobalVarModifiers,
    pub span: Span,
}

pub struct VarDecl {
    pub name: String,
    pub ty: Option<SemaType>,
    pub rhs: Option<TypedExpr>,
    pub is_const: bool,
    pub analyzed: bool,
    pub span: Span,
}

pub struct TypedProgramTree {
    pub file_id: SourceId,
    pub body: Vec<TypedStmt>,
    pub file_name: String,
    pub module_name: String,
}

pub fn cir_types_eq(a: const SemaType*, b: const SemaType*) bool {
    if (a->is_err() || b->is_err()) {
        return true;
    }

    switch (*a) {
        case .Plain(p1) => {
            switch (*b) {
                case .Plain(p2) => return p1 == p2;
                else => return false;
            }
        }

        case .InferVar(x) => {
            switch (*b) {
                case .InferVar(y) => return x == y;
                else => return false;
            }
        }

        case .Pointer(i1) => {
            switch (*b) {
                case .Pointer(i2) => return cir_types_eq(i1, i2);
                else => return false;
            }
        }

        case .Const(i1) => {
            switch (*b) {
                case .Const(i2) => return cir_types_eq(i1, i2);
                else => return false;
            }
        }

        case .Named(n1) => {
            switch (*b) {
                case .Named(n2) => {
                    if (!type_decl_id_eq(n1.type_decl_id, n2.type_decl_id)) {
                        return false;
                    }
                    
                    if (n1.type_args.len() != n2.type_args.len()) {
                        return false;
                    }

                    for (var i: usize = 0; i < n1.type_args.len(); i += 1) {
                        const arg1 = n1.type_args.get(i).unwrap();
                        const arg2 = n2.type_args.get(i).unwrap();

                        switch (*arg1) {
                            case .Type(t1, _) => {
                                switch (*arg2) {
                                    case .Type(t2, _) => {
                                        if (!cir_types_eq(&t1, &t2)) {
                                            return false;
                                        }
                                    }
                                    case .Infer => {
                                        return false;
                                    }
                                }
                            }
                            case .Infer => {
                                switch (*arg2) {
                                    case .Type => return false;
                                    else => {}
                                }
                            }
                        }
                    }


                    return true;
                }
                else => {}
            }
        }
        case .Array(array1) => {
            switch (*b) {
                case .Array(array2) => {
                    if (!array_capacity_eq(&array1.capacity, &array2.capacity)) {
                        return false;
                    }
                    
                    return cir_types_eq(array1.element_type, array2.element_type);
                }
                else => return false;
            }
        }

        case .Tuple(tuple1) => {
            switch (*b) {
                case .Tuple(tuple2) => {
                    if (tuple1.elements.len() != tuple2.elements.len()) {
                        return false;
                    }

                    for (var i: usize = 0; i < tuple1.elements.len(); i += 1) {
                        const e1 = tuple1.elements.get_const(i).unwrap();
                        const e2 = tuple2.elements.get_const(i).unwrap();
                        
                        if (!cir_types_eq(&e1->ty, &e2->ty)) {
                            return false;
                        }
                    }

                    return true;
                }
                else => return false;
            }
        }

        case .FuncType(func1) => {
            switch (*b) {
                case .FuncType(func2) => {
                    if (func1.params.list.len() != func2.params.list.len()) {
                        return false;
                    }

                    for (var i: usize = 0; i < func1.params.list.len(); i += 1) {
                        const p1 = func1.params.list.get_const(i).unwrap();
                        const p2 = func2.params.list.get_const(i).unwrap();
                        
                        if (!cir_types_eq(p1, p2)) {
                            return false;
                        }
                    }

                    switch (func1.params.variadic) {
                        case .Some(v1) => {
                            switch (func2.params.variadic) {
                                case .Some(v2) => {
                                    switch (*v1) {
                                        case .UntypedCStyle => {
                                            switch (*v2) {
                                                case .UntypedCStyle => {}
                                                else => return false;
                                            }
                                        }
                                        case .Typed(t1) => {
                                            switch (*v2) {
                                                case .Typed(t2) => {
                                                    if (!cir_types_eq(&t1, &t2)) {
                                                        return false;
                                                    }
                                                }
                                                else => return false;
                                            }
                                        }
                                    }
                                }
                                case .None => return false;
                            }
                        }
                        case .None => {
                            switch (func2.params.variadic) {
                                case .Some => return false;
                                case .None => {}
                            }
                        }
                    }

                    return cir_types_eq(func1.ret_type, func2.ret_type);
                }
                else => return false;
            }
        }

        case .InterfaceObject(io1) => {
            switch (*b) {
                case .InterfaceObject(io2) => {
                    if (!type_decl_id_eq(io1.interface_type.type_decl_id, io2.interface_type.type_decl_id)) {
                        return false;
                    }
                    
                    if (!type_args_eq_infer(&io1.interface_type.type_args, &io2.interface_type.type_args)) {
                        return false;
                    }

                    return cir_types_eq(io1.concrete_type, io2.concrete_type);
                }
                else => return false;
            }
        }

        case .Unresolved(u1) => {
            switch (*b) case .Unresolved(u2) else {
                return false;
            }

            switch (u1) {
                case .Decl(id1) => {
                    switch (u2) case .Decl(id2) else {
                        return false;
                    }
                    return id1 == id2;
                }
                case .GenericInst { base_symbol_id: base1, type_args: args1 } => {
                    switch (u2) case .GenericInst { base_symbol_id: base2, type_args: args2 } else {
                        return false;
                    }
                    
                    if (base1 != base2) {
                        return false;
                    }
                    
                    return type_args_eq_infer(&args1, &args2);
                }
                case .BuiltinFunc(b1) => {
                    switch (u2) case .BuiltinFunc(b2) else {
                        return false;
                    }
                    return b1->name.str.as_str_const() == b2->name.str.as_str_const();
                }
            }
        }

        case .GenericParam(g1) => {
            switch (*b) {
                case .GenericParam(g2) => return g1 == g2;
                else => return false;
            }
        }

        case .SelfType => {
            switch (*b) {
                case .SelfType => return true;
                else => return false;
            }
        }

        case .Placeholder => {
            switch (*b) {
                case .Placeholder => return true;
                else => return false;
            }
        }

        else => {}
    }

    return false;
}

pub fn type_args_eq(a: const TypedTypeArgs*, b: const TypedTypeArgs*) bool {
    if (a->len() != b->len()) {
        return false;
    }

    for (var i: usize = 0; i < a->len(); i += 1) {
        const arg1 = a->get(i).unwrap();
        const arg2 = b->get(i).unwrap();

        switch (*arg1) {
            case .Type(t1, _) => {
                switch (*arg2) {
                    case .Type(t2, _) => {
                        if (!cir_types_eq(&t1, &t2)) {
                            return false;
                        }
                    }
                    case .Infer => return false;
                }
            }
            case .Infer => {
                switch (*arg2) {
                    case .Type => return false;
                    case .Infer => {}
                }
            }
        }
    }

    return true;
}


pub fn named_type_eq(a: const NamedType*, b: const NamedType*) bool {
    if (!type_decl_id_eq(a->type_decl_id, b->type_decl_id)) {
        return false;
    }

    return type_args_eq(&a->type_args, &b->type_args);
}


pub fn tuple_type_eq(a: const TypedTupleType*, b: const TypedTupleType*) bool {
    if (a->elements.len() != b->elements.len()) {
        return false;
    }

    for (var i: usize = 0; i < a->elements.len(); i += 1) {
        const e1 = a->elements.get_const(i).unwrap();
        const e2 = b->elements.get_const(i).unwrap();
        
        if (!cir_types_eq(&e1->ty, &e2->ty)) {
            return false;
        }
    }

    return true;
}


pub fn func_type_eq(a: const TypedFuncType*, b: const TypedFuncType*) bool {
    if (a->params.list.len() != b->params.list.len()) {
        return false;
    }

    for (var i: usize = 0; i < a->params.list.len(); i += 1) {
        const p1 = a->params.list.get_const(i).unwrap();
        const p2 = b->params.list.get_const(i).unwrap();
        
        if (!cir_types_eq(p1, p2)) {
            return false;
        }
    }

    switch (a->params.variadic) {
        case .Some(v1) => {
            switch (b->params.variadic) {
                case .None => return false;
                case .Some(v2) => {
                    switch (*v1) {
                        case .UntypedCStyle => {
                            switch (*v2) {
                                case .UntypedCStyle => {}
                                else => return false;
                            }
                        }
                        case .Typed(t1) => {
                            switch (*v2) {
                                case .Typed(t2) => {
                                    if (!cir_types_eq(&t1, &t2)) {
                                        return false;
                                    }
                                }
                                else => return false;
                            }
                        }
                    }
                }
            }
        }
        case .None => {
            switch (b->params.variadic) {
                case .Some => return false;
                case .None => {}
            }
        }
    }

    return cir_types_eq(a->ret_type, b->ret_type);
}


fn type_args_eq_infer(a: const TypedTypeArgs*, b: const TypedTypeArgs*) bool {
    if (a->len() != b->len()) {
        return false;
    }

    for (var i: usize = 0; i < a->len(); i += 1) {
        const arg1 = a->get(i).unwrap();
        const arg2 = b->get(i).unwrap();

        switch (*arg1) {
            case .Type(t1, _) => {
                switch (*arg2) {
                    case .Type(t2, _) => {
                        if (!cir_types_eq(&t1, &t2)) {
                            return false;
                        }
                    }
                    case .Infer => return false;
                }
            }
            case .Infer => {
                switch (*arg2) {
                    case .Type => return false;
                    case .Infer => {}
                }
            }
        }
    }

    return true;
}


fn array_capacity_eq(a: const TypedArrayCapacity*, b: const TypedArrayCapacity*) bool {
    switch (*a) {
        case .Slice => {
            switch (*b) {
                case .Slice => return true;
                else => return false;
            }
        }
        case .Fixed(e1) => {
            switch (*b) {
                case .Fixed(e2) => {
                    switch (e1->literal_const_int_value()) {
                        case .Some(v1) => {
                            switch (e2->literal_const_int_value()) {
                                case .Some(v2) => return integer_literal_eq(v1, v2);
                                else => return false;
                            }
                        }
                        else => return false;
                    }
                }
                else => return false;
            }
        }
    }
}

pub fn type_decl_id_eq(a: TypeDeclId, b: TypeDeclId) bool {
    switch (a) {
        case .Interface(x) => switch (b) {
            case .Interface(y) => return x == y;
            else => {}
        }
        case .Typedef(x) => switch (b) {
            case .Typedef(y) => return x == y;
            else => {}
        }
        case .Struct(x) => switch (b) {
            case .Struct(y) => return x == y;
            else => {}
        }
        case .Union(x) => switch (b) {
            case .Union(y) => return x == y;
            else => {}
        }
        case .Enum(x) => switch (b) {
            case .Enum(y) => return x == y;
            else => {}
        }
    }

    return false;
}

pub fn type_contains_self_by_value(
    field_type: const SemaType*,
    named_type: const NamedType*
) bool {
    switch (*field_type) {
        case .Const(inner) => return type_contains_self_by_value(inner, named_type);
        
        case .Named(named) => return named_type_eq(&named, named_type);
        
        case .Tuple(tuple_type) => {
            for (var i: usize = 0; i < tuple_type.elements.len(); i += 1) {
                const element = tuple_type.elements.get_const(i).unwrap();
                
                if (type_contains_self_by_value(&element->ty, named_type)) {
                    return true;
                }
            }
            return false;
        }

        case .Array(array_type) => {
            return type_contains_self_by_value(array_type.element_type, named_type);
        }

        case .FuncType => return false;
        
        case .Pointer => return false;
        
        else => return false;
    }
}

/// Substitutes generic parameter references inside
/// a semantic type with the concrete type arguments.
pub fn substitute_sema_type_with_type_args(
    allocator: Allocator,
    ty: const SemaType*,
    generic_params: const TypedGenericParams*,
    type_args: const TypedTypeArgs*
) SemaType {
    switch (*ty) {
        case .GenericParam(generic_param_id) => {
            var pos: usize = 0;
            var found = false;
            
            for (var i: usize = 0; i < generic_params->len(); i += 1) {
                const param_id = generic_params->ids.get_const(i).unwrap();

                if (*param_id == generic_param_id) {
                    pos = i;
                    found = true;
                    break;
                }
            }

            if (!found) {
                return *ty;
            }

            const arg = type_args->get(pos).unwrap();

            switch (*arg) {
                case .Type(inner, _) => {
                    return substitute_sema_type_with_type_args(
                        allocator,
                        &inner,
                        generic_params,
                        type_args
                    );
                }
                case .Infer => return *ty;
            }
        }

        case .Named(named_type) => {
            var new_args = TypedTypeArgs.new(allocator);
            
            for (var i: usize = 0; i < named_type.type_args.len(); i += 1) {
                const arg = named_type.type_args.get(i).unwrap();

                switch (*arg) {
                    case .Type(inner, span) => {
                        const subst = substitute_sema_type_with_type_args(
                            allocator,
                            &inner,
                            generic_params,
                            type_args
                        );

                        new_args.push(.Type(subst, span));
                    }
                    case .Infer => {
                        new_args.push(.Infer);
                    }
                }
            }

            return .Named(NamedType {
                type_decl_id: named_type.type_decl_id,
                type_args: new_args,
            });
        }

        case .InterfaceObject(interface_object) => {
            const concrete_type = substitute_sema_type_with_type_args(
                allocator,
                interface_object.concrete_type,
                generic_params,
                type_args
            );

            return .InterfaceObject(InterfaceObjectType {
                interface_type: interface_object.interface_type,
                concrete_type: alloc_init(allocator, concrete_type),
                vtable_id: interface_object.vtable_id,
                span: interface_object.span,
            });
        }

        case .Array(array_type) => {
            const element_type = substitute_sema_type_with_type_args(
                allocator,
                array_type.element_type,
                generic_params,
                type_args
            );

            return .Array(TypedArrayType {
                element_type: alloc_init(allocator, element_type),
                capacity: array_type.capacity,
                span: array_type.span,
            });
        }

        case .Const(inner) => {
            const subst = substitute_sema_type_with_type_args(
                allocator, 
                inner, 
                generic_params, 
                type_args
            );

            return .Const(alloc_init(allocator, subst));
        }

        case .Pointer(inner) => {
            const subst = substitute_sema_type_with_type_args(
                allocator, 
                inner, 
                generic_params, 
                type_args
            );

            return .Pointer(alloc_init(allocator, subst));
        }

        case .Tuple(tuple_type) => {
            var elements: Vec<TypedTupleElement> = Vec.with_capacity(allocator, tuple_type.elements.len());
            
            for (var i: usize = 0; i < tuple_type.elements.len(); i += 1) {
                const element = tuple_type.elements.get_const(i).unwrap();

                const subst = substitute_sema_type_with_type_args(
                    allocator,
                    &element->ty,
                    generic_params,
                    type_args
                );

                elements.push(TypedTupleElement {
                    ty: subst,
                    span: element->span,
                });
            }

            return .Tuple(TypedTupleType {
                elements,
                span: tuple_type.span,
            });
        }

        case .FuncType(func_type) => {
            var params = TypedFuncTypeParams {
                list: Vec.with_capacity(allocator, func_type.params.list.len()),
                variadic: .None,
            };

            for (var i: usize = 0; i < func_type.params.list.len(); i += 1) {
                const param = func_type.params.list.get_const(i).unwrap();
                const subst = substitute_sema_type_with_type_args(
                    allocator, 
                    param, 
                    generic_params, 
                    type_args
                );
                params.list.push(subst);
            }

            switch (func_type.params.variadic) {
                case .Some(variadic) => {
                    switch (*variadic) {
                        case .UntypedCStyle => {
                            params.variadic = .Some(alloc_init(
                                allocator,
                                TypedFuncTypeVariadicParam.UntypedCStyle
                            ));
                        }
                        case .Typed(inner) => {
                            const subst = substitute_sema_type_with_type_args(
                                allocator,
                                &inner,
                                generic_params,
                                type_args
                            );

                            params.variadic = .Some(alloc_init(
                                allocator,
                                TypedFuncTypeVariadicParam.Typed(subst)
                            ));
                        }
                    }
                }
                case .None => {}
            }

            const ret_type = substitute_sema_type_with_type_args(
                allocator,
                func_type.ret_type, 
                generic_params, 
                type_args
            );

            return .FuncType(TypedFuncType {
                params,
                ret_type: alloc_init(allocator, ret_type),
                vis: func_type.vis,
                callconv: func_type.callconv,
                span: func_type.span,
            });
        }

        else => return *ty;
    }
}

pub fn func_decl_eq(a: const FuncDecl*, b: const FuncDecl*) bool {
    if (a->name.as_str_const() != b->name.as_str_const()) {
        return false;
    }

    if (a->params.list.len() != b->params.list.len()) {
        return false;
    }

    for (var i: usize = 0; i < a->params.list.len(); i += 1) {
        const p1 = a->params.list.get_const(i).unwrap();
        const p2 = b->params.list.get_const(i).unwrap();

        if (!func_param_kind_eq(p1, p2)) {
            return false;
        }
    }

    return cir_types_eq(&a->ret_type, &b->ret_type);
}

pub fn func_param_kind_eq(a: const TypedFuncParamKind*, b: const TypedFuncParamKind*) bool {
    switch (*a) {
        case .SelfModifier(m1) => {
            switch (*b) {
                case .SelfModifier(m2) => {
                    return m1.is_indirect() == m2.is_indirect() 
                        && m1.mutability == m2.mutability;
                }
                else => {
                    return false;
                }
            }
        }
        case .FuncParam(p1) => {
            switch (*b) {
                case .FuncParam(p2) => {
                    if (p1.ident.str.as_str_const() != p2.ident.str.as_str_const()) {
                        return false;
                    }

                    return cir_types_eq(&p1.ty, &p2.ty);
                }
                else => {
                    return false;
                }
            }
        }
    }
}

pub fn func_decl_as_func_type(allocator: Allocator, decl: const FuncDecl*) TypedFuncType {
    var list: Vec<SemaType> = Vec.with_capacity(allocator, decl->params.list.len());

    for (var i: usize = 0; i < decl->params.list.len(); i += 1) {
        const kind = decl->params.list.get_const(i).unwrap();

        switch (*kind) {
            case .FuncParam(func_param) => list.push(func_param.ty);
            case .SelfModifier(self_modifier) => list.push(self_modifier.ty);
        }
    }

    var variadic: Option<TypedFuncTypeVariadicParam*> = .None;

    switch (decl->params.variadic) {
        case .Some(.UntypedCStyle) => {
            variadic = .Some(alloc_init(allocator, TypedFuncTypeVariadicParam.UntypedCStyle));
        }
        case .Some(.Typed { ty, .. }) => {
            variadic = .Some(alloc_init(allocator, TypedFuncTypeVariadicParam.Typed(ty)));
        }
        case .None => {}
    }

    const callconv = decl->modifiers.callconv.unwrap_or(.C);

    return TypedFuncType {
        params: TypedFuncTypeParams { list, variadic },
        ret_type: alloc_init(allocator, decl->ret_type),
        vis: decl->modifiers.vis,
        callconv,
        span: decl->span,
    };
}

pub fn repr_attr_kind(repr_attr: const ast::ASTReprAttr*) Option<ast::ASTReprKind> {
    for (var i: usize = 0; i < repr_attr->items.len(); i += 1) {
        const item = repr_attr->items.get_const(i).unwrap();

        switch (item->kind) {
            case .Kind(kind) => return .Some(kind);
            case .Packed => {}
        }
    }

    return .None;
}

pub fn is_attr_repr_packed(repr_attr: const ast::ASTReprAttr*) bool {
    for (var i: usize = 0; i < repr_attr->items.len(); i += 1) {
        const item = repr_attr->items.get_const(i).unwrap();

        switch (item->kind) {
            case .Packed => return true;
            case .Kind => {}
        }
    }

    return false;
}

pub fn instantiate_method_decl(
    allocator: Allocator,
    method_decl: const MethodDecl*,
    generic_params: const TypedGenericParams*,
    type_args: const TypedTypeArgs*
) MethodDecl {
    return MethodDecl {
        object_name: method_decl->object_name,
        func_decl: instantiate_func_decl(
            allocator, 
            &method_decl->func_decl, 
            generic_params, 
            type_args
        ),
        body: method_decl->body,
    };
}

pub fn instantiate_func_decl(
    allocator: Allocator,
    decl: const FuncDecl*,
    generic_params: const TypedGenericParams*,
    type_args: const TypedTypeArgs*
) FuncDecl {
    const params = substitute_func_params_with_type_args(
        allocator,
        &decl->params, 
        generic_params, 
        type_args
    );

    const ret_type = substitute_sema_type_with_type_args(
        allocator,
        &decl->ret_type, 
        generic_params, 
        type_args
    );

    return FuncDecl {
        file_id: decl->file_id,
        name: decl->name,
        params,
        ret_type,
        body: decl->body,
        generic_params: decl->generic_params,
        is_func_decl: decl->is_func_decl,
        modifiers: decl->modifiers,
        span: decl->span,
    };
}

pub fn substitute_func_params_with_type_args(
    allocator: Allocator,
    params: const TypedFuncParams*,
    generic_params: const TypedGenericParams*,
    type_args: const TypedTypeArgs*
) TypedFuncParams {
    var list: Vec<TypedFuncParamKind> = Vec.new(allocator);

    for (var i: usize = 0; i < params->list.len(); i += 1) {
        const kind = params->list.get_const(i).unwrap();

        switch (*kind) {
            case .FuncParam(var param) => {
                param.ty = substitute_sema_type_with_type_args(
                    allocator, 
                    &param.ty,
                    generic_params, 
                    type_args
                );
                list.push(.FuncParam(param));
            }
            case .SelfModifier(var self_modifier) => {
                self_modifier.ty = substitute_sema_type_with_type_args(
                    allocator,
                    &self_modifier.ty,
                    generic_params,
                    type_args
                );
                list.push(.SelfModifier(self_modifier));
            }
        }
    }

    var variadic: Option<TypedFuncVariadicParam> = .None;

    switch (params->variadic) {
        case .Some(.UntypedCStyle) => {
            variadic = .Some(.UntypedCStyle);
        }
        case .Some(.Typed { var_decl_id, ty, span }) => {
            const subst = substitute_sema_type_with_type_args(allocator, &ty, generic_params, type_args);

            variadic = .Some(.Typed {
                var_decl_id,
                ty: subst,
                span,
            });
        }
        case .None => {}
    }

    return TypedFuncParams { variadic, list };
}
