/* ************* Identifiers ************* */

pub type GenericParamId = usize;
pub type InferVarId = usize;
pub type SymbolId = usize;
pub type VTableId = usize;
pub type LabelId = usize;
pub type BodyId = usize;

pub type InterfaceDeclId = usize;
pub type GlobalVarDeclId = usize;
pub type TypedefDeclId = usize;
pub type MethodDeclId = usize;
pub type StructDeclId = usize;
pub type UnionDeclId = usize;
pub type MonomorphId = usize;
pub type FuncDeclId = usize;
pub type EnumDeclId = usize;
pub type VarDeclId = usize;

[[inline]]
pub fn decl_id_key(decl_id: DeclId) usize {
    switch (decl_id) {
        case .Interface(id) => return (1 << 48) | id;
        case .GlobalVar(id) => return (2 << 48) | id;
        case .Typedef(id) => return (3 << 48) | id;
        case .Method(id) => return (4 << 48) | id;
        case .Struct(id) => return (5 << 48) | id;
        case .Union(id) => return (6 << 48) | id;
        case .Func(id) => return (7 << 48) | id;
        case .Enum(id) => return (8 << 48) | id;
        case .Var(id) => return (9 << 48) | id;
    }
}

[[inline]]
pub fn decl_id_as_type_decl_id(decl_id: DeclId) Option<TypeDeclId> {
    switch (decl_id) {
        case .Interface(id) => return .Some(.Interface(id));
        case .Typedef(id) => return .Some(.Typedef(id));
        case .Struct(id) => return .Some(.Struct(id));
        case .Union(id) => return .Some(.Union(id));
        case .Enum(id) => return .Some(.Enum(id));
        else => return .None;
    }
}

/* ************* Literals ************* */

pub enum IntegerLiteral {
    Signed(int128),
    Unsigned(uint128),
}

pub fn integer_literal_as_usize(literal: IntegerLiteral) usize {
    switch (literal) {
        case .Signed(x) => {
            if (x < 0) {
                return 0;
            }
            return @cast(usize, @cast(uint128, x));
        }
        case .Unsigned(x) => {
            return @cast(usize, x);
        }
    }
}

pub fn integer_literal_eq(a: IntegerLiteral, b: IntegerLiteral) bool {
    switch (a) {
        case .Signed(a1) => {
            switch (b) {
                case .Signed(b1) => return a1 == b1;
                case .Unsigned => return false;
            }
        }
        case .Unsigned(a1) => {
            switch (b) {
                case .Unsigned(b1) => return a1 == b1;
                case .Signed => return false;
            }
        }
    }
}

/* ************* Builtins ************* */

pub enum Builtin {
    BuiltinBlock(BuiltinBlock),
    BuiltinFunc(BuiltinFunc),

    [[inline]]
    pub fn span(self: const Self*) Span {
        switch (*self) {
            case .BuiltinBlock(builtin_block) => return builtin_block.span;
            case .BuiltinFunc(builtin_func) => return builtin_func.span;
        }
    }
}

pub enum BuiltinForm {
    Expr,
    Stmt,
}

pub struct BuiltinFunc {
    pub name: ast::ASTIdent,
    pub args: Vec<Expr>,
    pub ret_type: Option<SemaType>,
    pub span: Span,
}

pub struct BuiltinBlock {
    pub name: ast::ASTIdent,
    pub args: Vec<Expr>,
    pub block: BlockStmt*,
    pub is_toplevel: Option<bool>,
    pub span: Span,
}

pub enum BuiltinFamily {
    ConstEval,
    Intrinsic,
}

pub enum BuiltinPhase {
    Resolver,
    ConstEval,
    Codegen,
}

pub enum BuiltinKind {
    FuncName,
    MethodName,
    ModuleName,
    FileName,
    Line,
    Column,

    SizeOf,
    AlignOf,
    OffsetOf,
    TypeOf,

    Cast,
    Memcpy,
    Memset,
    Assert,
    Panic,
    Todo,
    Unimplemented,
    Unreachable,

    Debug,
    Release,
    Unroll,
}

pub struct BuiltinSpec {
    pub kind: BuiltinKind,
    pub name: const uint8*,

    pub family: BuiltinFamily,
    pub phase: BuiltinPhase,
    pub form: BuiltinForm,
    pub unreachable: bool,

    pub min_args: usize,
    pub max_args: Option<usize>,
}

pub fn lookup_builtin(name: const uint8*) Option<BuiltinKind> {
    switch (name) {
        case "unimplemented" => return .Some(.Unimplemented);
        case "unreachable" => return .Some(.Unreachable);
        case "method_name" => return .Some(.MethodName);
        case "module_name" => return .Some(.ModuleName);
        case "func_name" => return .Some(.FuncName);
        case "file_name" => return .Some(.FileName);
        case "offsetof" => return .Some(.OffsetOf);
        case "alignof" => return .Some(.AlignOf);
        case "release" => return .Some(.Release);
        case "typeof" => return .Some(.TypeOf);
        case "column" => return .Some(.Column);
        case "sizeof" => return .Some(.SizeOf);
        case "memcpy" => return .Some(.Memcpy);
        case "memset" => return .Some(.Memset);
        case "assert" => return .Some(.Assert);
        case "panic" => return .Some(.Panic);
        case "debug" => return .Some(.Debug);
        case "line" => return .Some(.Line);
        case "cast" => return .Some(.Cast);
        case "todo" => return .Some(.Todo);
        else => return .None;
    }
}

pub fn builtin_spec_of(kind: BuiltinKind) BuiltinSpec {
    switch (kind) {
        case .FuncName => return BuiltinSpec {
            kind,
            name: "func_name",
            family: .ConstEval,
            phase: .ConstEval,
            form: .Expr,
            unreachable: false,
            min_args: 0,
            max_args: .Some(0),
        };
        
        case .MethodName => return BuiltinSpec {
            kind,
            name: "method_name",
            family: .ConstEval,
            phase: .ConstEval,
            form: .Expr,
            unreachable: false,
            min_args: 0,
            max_args: .Some(0),
        };
        
        case .ModuleName => return BuiltinSpec {
            kind,
            name: "module_name",
            family: .ConstEval,
            phase: .ConstEval,
            form: .Expr,
            unreachable: false,
            min_args: 0,
            max_args: .Some(0),
        };
        
        case .FileName => return BuiltinSpec {
            kind,
            name: "file_name",
            family: .ConstEval,
            phase: .ConstEval,
            form: .Expr,
            unreachable: false,
            min_args: 0,
            max_args: .Some(0),
        };
        
        case .Line => return BuiltinSpec {
            kind,
            name: "line",
            family: .ConstEval,
            phase: .ConstEval,
            form: .Expr,
            unreachable: false,
            min_args: 0,
            max_args: .Some(0),
        };
        
        case .Column => return BuiltinSpec {
            kind,
            name: "column",
            family: .ConstEval,
            phase: .ConstEval,
            form: .Expr,
            unreachable: false,
            min_args: 0,
            max_args: .Some(0),
        };
        
        case .SizeOf => return BuiltinSpec {
            kind,
            name: "sizeof",
            family: .ConstEval,
            phase: .ConstEval,
            form: .Expr,
            unreachable: false,
            min_args: 1,
            max_args: .Some(1),
        };
        
        case .AlignOf => return BuiltinSpec {
            kind,
            name: "alignof",
            family: .ConstEval,
            phase: .ConstEval,
            form: .Expr,
            unreachable: false,
            min_args: 1,
            max_args: .Some(1),
        };
        
        case .OffsetOf => return BuiltinSpec {
            kind,
            name: "offsetof",
            family: .ConstEval,
            phase: .ConstEval,
            form: .Expr,
            unreachable: false,
            min_args: 2,
            max_args: .Some(2),
        };
        
        case .TypeOf => return BuiltinSpec {
            kind,
            name: "typeof",
            family: .ConstEval,
            phase: .ConstEval,
            form: .Expr,
            unreachable: false,
            min_args: 1,
            max_args: .Some(1),
        };
        
        case .Cast => return BuiltinSpec {
            kind,
            name: "cast",
            family: .Intrinsic,
            phase: .Codegen,
            form: .Expr,
            unreachable: false,
            min_args: 2,
            max_args: .Some(2),
        };
        
        case .Memcpy => return BuiltinSpec {
            kind,
            name: "memcpy",
            family: .Intrinsic,
            phase: .Codegen,
            form: .Expr,
            unreachable: false,
            min_args: 3,
            max_args: .Some(3),
        };
        
        case .Memset => return BuiltinSpec {
            kind,
            name: "memset",
            family: .Intrinsic,
            phase: .Codegen,
            form: .Expr,
            unreachable: false,
            min_args: 3,
            max_args: .Some(3),
        };
        
        case .Assert => return BuiltinSpec {
            kind,
            name: "assert",
            family: .Intrinsic,
            phase: .Codegen,
            form: .Expr,
            unreachable: false,
            min_args: 1,
            max_args: .Some(2),
        };
        
        case .Panic => return BuiltinSpec {
            kind,
            name: "panic",
            family: .Intrinsic,
            phase: .Codegen,
            form: .Expr,
            unreachable: true,
            min_args: 0,
            max_args: .Some(1),
        };
        
        case .Todo => return BuiltinSpec {
            kind,
            name: "todo",
            family: .Intrinsic,
            phase: .Codegen,
            form: .Expr,
            unreachable: true,
            min_args: 0,
            max_args: .Some(1),
        };
        
        case .Unimplemented => return BuiltinSpec {
            kind,
            name: "unimplemented",
            family: .Intrinsic,
            phase: .Codegen,
            form: .Expr,
            unreachable: true,
            min_args: 0,
            max_args: .Some(1),
        };
        
        case .Unreachable => return BuiltinSpec {
            kind,
            name: "unreachable",
            family: .Intrinsic,
            phase: .Codegen,
            form: .Expr,
            unreachable: true,
            min_args: 0,
            max_args: .Some(1),
        };
        
        case .Debug => return BuiltinSpec {
            kind,
            name: "debug",
            family: .ConstEval,
            phase: .Resolver,
            form: .Stmt,
            unreachable: false,
            min_args: 0,
            max_args: .Some(0),
        };
        
        case .Release => return BuiltinSpec {
            kind,
            name: "release",
            family: .ConstEval,
            phase: .Resolver,
            form: .Stmt,
            unreachable: false,
            min_args: 0,
            max_args: .Some(0),
        };
        
        case .Unroll => @panic("builtin spec missing");
    }
}

pub fn is_builtin_unreachable(name: const uint8*) bool {
    switch (lookup_builtin(name)) {
        case .Some(builtin_kind) => return builtin_spec_of(builtin_kind).unreachable;
        case .None => @panic("unknown builtin");
    }
}

/* ************* Types ************* */

pub enum SemaType {
    InterfaceObject(InterfaceObjectType),
    GenericParam(GenericParamId),
    Unresolved(UnresolvedType),
    FuncType(FuncType),
    SelfType(SelfType),
    Array(ArrayType),
    Tuple(TupleType),
    InferVar(InferVarId),
    Pointer(SemaType*),
    Const(SemaType*),
    Plain(PlainType),
    Named(NamedType),
    Placeholder,
    Err(Span),

    /// Returns true if this type contains `Unresolved` inside it.
    pub fn includes_unresolved_type(self: const Self*) bool {
        switch (*self) {
            case .Unresolved => return true;

            case .Err
            | .Plain
            | .SelfType
            | .GenericParam
            | .InferVar
            | .Placeholder => return false;

            case .Named(named_type) => {
                for (var i: usize = 0; i < named_type.type_args.len(); i += 1) {
                    const type_arg = named_type.type_args.get(i).unwrap();

                    switch (*type_arg) {
                        case .Type(ty, _) => {
                            if (ty.includes_unresolved_type()) {
                                return true;
                            }
                        }
                        else => {}
                    }
                }

                return false;
            }

            case .FuncType(func) => {
                for (var i: usize = 0; i < func.params.list.len(); i += 1) {
                    const ty = func.params.list.get_const(i).unwrap();

                    if (ty->includes_unresolved_type()) {
                        return true;
                    }
                }

                switch (func.params.variadic) {
                    case .Some(variadic) => switch (*variadic) {
                        case .Typed(ty) => {
                            if (ty.includes_unresolved_type()) {
                                return true;
                            }
                        }
                        else => {}
                    }
                    else => {}
                }

                return func.ret_type->includes_unresolved_type();
            }

            case .Tuple(tuple) => {
                for (var i: usize = 0; i < tuple.elements.len(); i += 1) {
                    const element = tuple.elements.get_const(i).unwrap();

                    if (element->ty.includes_unresolved_type()) {
                        return true;
                    }
                }

                return false;
            }

            case .InterfaceObject(interface_obj) => {
                for (var i: usize = 0; i < interface_obj.interface_type.type_args.len(); i += 1) {
                    const type_arg = interface_obj.interface_type.type_args.get(i).unwrap();

                    switch (*type_arg) {
                        case .Type(ty, _) => {
                            if (ty.includes_unresolved_type()) {
                                return true;
                            }
                        }
                        else => {}
                    }
                }

                return interface_obj.concrete_type->includes_unresolved_type();
            }

            case .Array(array) => return array.element_type->includes_unresolved_type();
            
            case .Pointer(inner) => return inner->includes_unresolved_type();
            
            case .Const(inner) => return inner->includes_unresolved_type();
        }
    }

    [[inline]]
    pub fn as_unresolved_decl_id(self: const Self*) Option<SymbolId> {
        switch (*self->const_inner()) {
            case .Unresolved(unresolved_type) => return unresolved_type.as_symbol_id();
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_unresolved_base_decl_id(self: const Self*) Option<SymbolId> {
        switch (*self->const_inner()) {
            case .Unresolved(unresolved_type) => return unresolved_type.as_base_symbol_id();
            else => return .None;
        }
    }

    [[inline]]
    pub fn const_inner(self: const Self*) const SemaType* {
        switch (*self) {
            case .Const(sema_type) => return sema_type;
            else => return self;
        }
    }

    [[inline]]
    pub fn count_const_layers(self: const Self*) usize {
        switch (*self) {
            case .Const(inner) => return 1 + inner->count_const_layers();
            else => return 0;
        }
    }

    [[inline]]
    pub fn pointer_inner(self: const Self*) const SemaType* {
        switch (*self) {
            case .Pointer(sema_type) => return sema_type;
            else => return self;
        }
    }

    [[inline]]
    pub fn as_plain_type(self: const Self*) Option<PlainType> {
        switch (*self->const_inner()) {
            case .Plain(ty) => return .Some(ty);
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_named_type(self: const Self*) Option<NamedType> {
        switch (*self->const_inner()) {
            case .Named(named_type) => return .Some(named_type);
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_struct(self: const Self*) Option<StructDeclId> {
        switch (*self->const_inner()) {
            case .Named(named_type) => return named_type.type_decl_id.as_struct();
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_union(self: const Self*) Option<UnionDeclId> {
        switch (*self->const_inner()) {
            case .Named(named_type) => return named_type.type_decl_id.as_union();
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_enum(self: const Self*) Option<EnumDeclId> {
        switch (*self->const_inner()) {
            case .Named(named_type) => return named_type.type_decl_id.as_enum();
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_named_interface(self: const Self*) Option<InterfaceDeclId> {
        switch (*self->const_inner()) {
            case .Named(named_type) => return named_type.type_decl_id.as_interface();
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_interface_object(self: const Self*) Option<InterfaceObjectType> {
        switch (*self->const_inner()) {
            case .InterfaceObject(interface_object) => return .Some(interface_object);
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_tuple_type(self: const Self*) Option<TupleType> {
        switch (*self->const_inner()) {
            case .Tuple(tuple_type) => return .Some(tuple_type);
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_func_type(self: const Self*) Option<FuncType> {
        switch (*self->const_inner()) {
            case .FuncType(func_type) => return .Some(func_type);
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_array_type(self: const Self*) Option<ArrayType> {
        switch (*self->const_inner()) {
            case .Array(ty) => return .Some(ty);
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_self_type(self: const Self*) Option<SelfType> {
        switch (*self->const_inner()) {
            case .SelfType(self_type) => return .Some(self_type);
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_generic_param(self: const Self*) Option<GenericParamId> {
        switch (*self->const_inner()) {
            case .GenericParam(generic_param_id) => return .Some(generic_param_id);
            else => return .None;
        }
    }

    [[inline]]
    pub fn is_err(self: const Self*) bool {
        switch (*self) {
            case .Err => return true;
            else => return false;
        }
    }

    [[inline]]
    pub fn is_error(self: const Self*) bool {
        switch (*self->const_inner()) {
            case .Err => return true;
            else => return false;
        }
    }

    pub fn contains_error(self: const Self*) bool {
        switch (*self->const_inner()) {
            case .Err => return true;

            case .Unresolved
            | .Plain
            | .SelfType
            | .GenericParam
            | .InferVar
            | .Placeholder => return false;

            case .Named(named_type) => {
                for (var i: usize = 0; i < named_type.type_args.len(); i += 1) {
                    const type_arg = named_type.type_args.get(i).unwrap();

                    switch (*type_arg) {
                        case .Type(ty, _) => {
                            if (ty.contains_error()) {
                                return true;
                            }
                        }
                        else => {}
                    }
                }

                return false;
            }

            case .FuncType(func) => {
                for (var i: usize = 0; i < func.params.list.len(); i += 1) {
                    const ty = func.params.list.get_const(i).unwrap();

                    if (ty->contains_error()) {
                        return true;
                    }
                }

                switch (func.params.variadic) {
                    case .Some(variadic) => switch (*variadic) {
                        case .Typed(ty) => {
                            if (ty.contains_error()) {
                                return true;
                            }
                        }
                        else => {}
                    }
                    else => {}
                }

                return func.ret_type->contains_error();
            }

            case .Tuple(tuple) => {
                for (var i: usize = 0; i < tuple.elements.len(); i += 1) {
                    const element = tuple.elements.get_const(i).unwrap();

                    if (element->ty.contains_error()) {
                        return true;
                    }
                }

                return false;
            }

            case .InterfaceObject(interface_obj) => {
                for (var i: usize = 0; i < interface_obj.interface_type.type_args.len(); i += 1) {
                    const type_arg = interface_obj.interface_type.type_args.get(i).unwrap();

                    switch (*type_arg) {
                        case .Type(ty, _) => {
                            if (ty.contains_error()) {
                                return true;
                            }
                        }
                        else => {}
                    }
                }

                return interface_obj.concrete_type->contains_error();
            }

            case .Array(array) => return array.element_type->contains_error();
            
            case .Pointer(inner) => return inner->contains_error();
            
            case .Const(inner) => return inner->contains_error();
        }
    }

    pub fn contains_unresolved(self: const Self*) bool {
        switch (*self->const_inner()) {
            case .Unresolved => return true;

            case .Err
            | .Plain
            | .SelfType
            | .GenericParam
            | .InferVar
            | .Placeholder => return false;

            case .Named(named_type) => {
                for (var i: usize = 0; i < named_type.type_args.len(); i += 1) {
                    const type_arg = named_type.type_args.get(i).unwrap();

                    switch (*type_arg) {
                        case .Type(ty, _) => {
                            if (ty.contains_unresolved()) {
                                return true;
                            }
                        }
                        else => {}
                    }
                }

                return false;
            }

            case .FuncType(func) => {
                for (var i: usize = 0; i < func.params.list.len(); i += 1) {
                    const ty = func.params.list.get_const(i).unwrap();

                    if (ty->contains_unresolved()) {
                        return true;
                    }
                }

                switch (func.params.variadic) {
                    case .Some(variadic) => switch (*variadic) {
                        case .Typed(ty) => {
                            if (ty.contains_unresolved()) {
                                return true;
                            }
                        }
                        else => {}
                    }
                    else => {}
                }

                return func.ret_type->contains_unresolved();
            }

            case .Tuple(tuple) => {
                for (var i: usize = 0; i < tuple.elements.len(); i += 1) {
                    const element = tuple.elements.get_const(i).unwrap();

                    if (element->ty.contains_unresolved()) {
                        return true;
                    }
                }

                return false;
            }

            case .InterfaceObject(interface_obj) => {
                for (var i: usize = 0; i < interface_obj.interface_type.type_args.len(); i += 1) {
                    const type_arg = interface_obj.interface_type.type_args.get(i).unwrap();

                    switch (*type_arg) {
                        case .Type(ty, _) => {
                            if (ty.contains_unresolved()) {
                                return true;
                            }
                        }
                        else => {}
                    }
                }

                return interface_obj.concrete_type->contains_unresolved();
            }

            case .Array(array) => return array.element_type->contains_unresolved();
            
            case .Pointer(inner) => return inner->contains_unresolved();
            
            case .Const(inner) => return inner->contains_unresolved();
        }
    }

    [[inline]]
    pub fn is_unresolved(self: const Self*) bool {
        switch (*self) {
            case .Unresolved => return true;
            else => return false;
        }
    }

    [[inline]]
    pub fn is_uint8(self: const Self*) bool {
        switch (*self->const_inner()) {
            case .Plain(p) => {
                switch (p) {
                    case .UInt8 => return true;
                    else => return false;
                }
            }
            else => return false;
        }
    }

    [[inline]]
    pub fn is_uint8_pointer(self: const Self*) bool {
        switch (*self->const_inner()) {
            case .Pointer(inner) => return inner->is_uint8();
            else => return false;
        }
    }

    [[inline]]
    pub fn is_scalar(self: const Self*) bool {
        switch (*self->const_inner()) {
            case .Plain(plain_type) => return plain_type.is_scalar();
            else => return false;
        }
    }

    [[inline]]
    pub fn is_signed_integer_type(self: const Self*) bool {
        switch (self->as_plain_type()) {
            case .Some(plain) => {
                return plain.is_integer() && plain.is_signed();
            }
            case .None => {
                return false;
            }
        }
    }

    [[inline]]
    pub fn is_self_type(self: const Self*) bool {
        switch (*self) {
            case .SelfType => return true;
            else => return false;
        }
    }

    [[inline]]
    pub fn is_plain_type(self: const Self*) bool {
        switch (*self->const_inner()) {
            case .Plain => return true;
            else => return false;
        }
    }

    [[inline]]
    pub fn is_integer(self: const Self*) bool {
        switch (*self->const_inner()) {
            case .Plain(basic) => return basic.is_integer();
            else => return false;
        }
    }

    [[inline]]
    pub fn is_float(self: const Self*) bool {
        switch (*self->const_inner()) {
            case .Plain(basic) => return basic.is_float();
            else => return false;
        }
    }

    [[inline]]
    pub fn is_bool(self: const Self*) bool {
        switch (*self->const_inner()) {
            case .Plain(p) => {
                switch (p) {
                    case .Bool => return true;
                    else => return false;
                }
            }
            else => return false;
        }
    }

    [[inline]]
    pub fn is_array(self: const Self*) bool {
        switch (*self->const_inner()) {
            case .Array => return true;
            else => return false;
        }
    }

    [[inline]]
    pub fn is_func_type(self: const Self*) bool {
        switch (*self->const_inner()) {
            case .FuncType => return true;
            else => return false;
        }
    }

    [[inline]]
    pub fn is_const(self: const Self*) bool {
        switch (*self) {
            case .Const => return true;
            else => return false;
        }
    }

    [[inline]]
    pub fn is_void(self: const Self*) bool {
        switch (*self->const_inner()) {
            case .Plain(p) => {
                switch (p) {
                    case .Void => return true;
                    else => return false;
                }
            }
            else => return false;
        }
    }

    [[inline]]
    pub fn is_plain_null(self: const Self*) bool {
        switch (*self) {
            case .Plain(plain) => {
                switch (plain) {
                    case .Null => return true;
                    else => return false;
                }
            }
            else => return false;
        }
    }

    [[inline]]
    pub fn is_pointer(self: const Self*) bool {
        switch (*self->const_inner()) {
            case .Pointer => return true;
            else => return false;
        }
    }

    [[inline]]
    pub fn is_struct(self: const Self*) bool {
        switch (*self->const_inner()) {
            case .Named(named_type) => return named_type.type_decl_id.is_struct();
            else => return false;
        }
    }

    [[inline]]
    pub fn is_union(self: const Self*) bool {
        switch (*self->const_inner()) {
            case .Named(named_type) => return named_type.type_decl_id.is_union();
            else => return false;
        }
    }

    [[inline]]
    pub fn is_enum(self: const Self*) bool {
        switch (*self->const_inner()) {
            case .Named(named_type) => return named_type.type_decl_id.is_enum();
            else => return false;
        }
    }

    [[inline]]
    pub fn is_interface(self: const Self*) bool {
        switch (*self->const_inner()) {
            case .Named(named_type) => return named_type.type_decl_id.is_interface();
            else => return false;
        }
    }

    [[inline]]
    pub fn is_interface_object(self: const Self*) bool {
        switch (*self) {
            case .InterfaceObject => return true;
            else => return false;
        }
    }

    pub fn contains_infer_var(self: const Self*) bool {
        switch (*self) {
            case .Placeholder | .GenericParam | .Err | .Unresolved | .Plain | .SelfType | .InterfaceObject => return false;
            case .InferVar => return true;
            case .Const(inner) => return inner->contains_infer_var();
            case .Pointer(inner) => return inner->contains_infer_var();

            case .Array(array) => return array.element_type->contains_infer_var();

            case .Tuple(tuple) => {
                for (var i: usize = 0; i < tuple.elements.len(); i += 1) {
                    const element = tuple.elements.get_const(i).unwrap();

                    if (element->ty.contains_infer_var()) {
                        return true;
                    }
                }

                return false;
            }

            case .FuncType(func) => {
                for (var i: usize = 0; i < func.params.list.len(); i += 1) {
                    const ty = func.params.list.get_const(i).unwrap();

                    if (ty->contains_infer_var()) {
                        return true;
                    }
                }

                switch (func.params.variadic) {
                    case .Some(variadic) => switch (*variadic) {
                        case .UntypedCStyle => {}
                        case .Typed(ty) => {
                            if (ty.contains_infer_var()) {
                                return true;
                            }
                        }
                    }
                    else => {}
                }

                return func.ret_type->contains_infer_var();
            }

            case .Named(named_type) => {
                for (var i: usize = 0; i < named_type.type_args.len(); i += 1) {
                    const type_arg = named_type.type_args.get(i).unwrap();

                    switch (*type_arg) {
                        case .Type(ty, _) => {
                            if (ty.contains_infer_var()) {
                                return true;
                            }
                        }
                        case .Infer => return true;
                    }
                }

                return false;
            }
        }
    }

    pub fn contains_generic_param(self: const Self*) bool {
        switch (*self) {
            case .Array(array) => return array.element_type->contains_generic_param();
            
            case .Pointer(inner) => return inner->contains_generic_param();
            
            case .Const(inner) => return inner->contains_generic_param();
            
            case .GenericParam => return true;

            case .Placeholder 
            | .InferVar 
            | .Err 
            | .Unresolved 
            | .Plain 
            | .SelfType 
            | .InterfaceObject => return false;

            case .Tuple(tuple) => {
                for (var i: usize = 0; i < tuple.elements.len(); i += 1) {
                    const element = tuple.elements.get_const(i).unwrap();

                    if (element->ty.contains_generic_param()) {
                        return true;
                    }
                }

                return false;
            }

            case .FuncType(func) => {
                for (var i: usize = 0; i < func.params.list.len(); i += 1) {
                    const ty = func.params.list.get_const(i).unwrap();

                    if (ty->contains_generic_param()) {
                        return true;
                    }
                }

                switch (func.params.variadic) {
                    case .Some(variadic) => switch (*variadic) {
                        case .Typed(ty) => {
                            if (ty.contains_generic_param()) {
                                return true;
                            }
                        }
                        else => {}
                    }
                    else => {}
                }

                return func.ret_type->contains_generic_param();
            }

            case .Named(named_type) => {
                for (var i: usize = 0; i < named_type.type_args.len(); i += 1) {
                    const type_arg = named_type.type_args.get(i).unwrap();

                    switch (*type_arg) {
                        case .Type(ty, _) => {
                            if (ty.contains_generic_param()) {
                                return true;
                            }
                        }
                        else => {}
                    }
                }

                return false;
            }
        }
    }

    /// Returns true if this type contains `SelfType` inside it.
    pub fn contains_self_type(self: const Self*) bool {
        switch (*self) {
            case .Named(named_type) => {
                for (var i: usize = 0; i < named_type.type_args.len(); i += 1) {
                    const type_arg = named_type.type_args.get(i).unwrap();

                    switch (*type_arg) {
                        case .Type(ty, _) => {
                            if (ty.contains_self_type()) {
                                return true;
                            }
                        }
                        else => {}
                    }
                }

                return false;
            }

            case .FuncType(func_ty) => {
                for (var i: usize = 0; i < func_ty.params.list.len(); i += 1) {
                    const ty = func_ty.params.list.get_const(i).unwrap();

                    if (ty->contains_self_type()) {
                        return true;
                    }
                }

                return func_ty.ret_type->contains_self_type();
            }

            case .Tuple(ty) => {
                for (var i: usize = 0; i < ty.elements.len(); i += 1) {
                    const element = ty.elements.get_const(i).unwrap();

                    if (element->ty.contains_self_type()) {
                        return true;
                    }
                }

                return false;
            }

            case .Pointer(inner_type) => return inner_type->contains_self_type();
            
            case .Array(array) => return array.element_type->contains_self_type();

            case .Const(inner_type) => return inner_type->contains_self_type();
            
            case .SelfType => return true;

            case .InterfaceObject
            | .Plain
            | .GenericParam
            | .InferVar
            | .Unresolved
            | .Err
            | .Placeholder => return false;
        }
    }
}

pub enum UnresolvedType {
    GenericInst { base_symbol_id: SymbolId, type_args: TypeArgs },
    BuiltinFunc(BuiltinFunc*),
    Decl(SymbolId),

    [[inline]]
    pub fn as_symbol_id(self: const Self*) Option<SymbolId> {
        switch (*self) {
            case .Decl(symbol_id) => return .Some(symbol_id);
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_base_symbol_id(self: const Self*) Option<SymbolId> {
        switch (*self) {
            case .GenericInst { base_symbol_id, .. } => return .Some(base_symbol_id);
            case .Decl(symbol_id) => return .Some(symbol_id);
            case .BuiltinFunc => return .None;
        }
    }
}

