pub fn literal_expr(allocator: Allocator, lit: Literal, span: Span) Option<TypedExpr> {
    const ty = infer_literal_type_or_default(allocator, &lit, span);

    return .Some(TypedExpr {
        kind: .Literal(TypedLiteralExpr {
            ty,
            kind: lit,
            span,
        }),
        ty: .None,
        val_cat: .Unknown,
        analyzed: false,
        span,
    });
}

pub fn infer_literal_type_or_default(
    allocator: Allocator,
    lit: const Literal*,
    span: Span
) Option<SemaType> {
    switch (*lit) {
        // FIXME: Make a helper method to convert IntegerSuffix
        // into SemaType
        case .Integer { suffix: .Some(sfx), .. } => switch (sfx) {
            case .ISize => return .Some(.Plain(.ISize));
            case .USize => return .Some(.Plain(.USize));
            case .Int8 => return .Some(.Plain(.Int8));
            case .Int16 => return .Some(.Plain(.Int16));
            case .Int32 => return .Some(.Plain(.Int32));
            case .Int64 => return .Some(.Plain(.Int64));
            case .Int128 => return .Some(.Plain(.Int128));
            case .UInt8 => return .Some(.Plain(.UInt8));
            case .UInt16 => return .Some(.Plain(.UInt16));
            case .UInt32 => return .Some(.Plain(.UInt32));
            case .UInt64 => return .Some(.Plain(.UInt64));
            case .UInt128 => return .Some(.Plain(.UInt128));
        }

        case .Integer { suffix: .None, .. } => return .None;
        
        // FIXME: Make a helper method to convert FloatSuffix
        // into SemaType
        case .Float { suffix: .Some(sfx), .. } => switch (sfx) {
            case .Float16 => return .Some(.Plain(.Float16));
            case .Float32 => return .Some(.Plain(.Float32));
            case .Float64 => return .Some(.Plain(.Float64));
            case .Float128 => return .Some(.Plain(.Float128));
        }

        case .Float { suffix: .None, .. } => return .None;

        case .String { suffix: .None, .. } => {
            return .Some(.Pointer(alloc_init(
                allocator, 
                SemaType.Plain(.UInt8)
            )));
        }
        
        case .String { suffix: .Some(.Byte), value } => {
            const element_type: SemaType = .Plain(.UInt8);
            const len = value.len() + 1;

            return .Some(.Array(TypedArrayType {
                element_type: alloc_init(allocator, element_type),
                capacity: .Fixed(alloc_init(
                    allocator,
                    const_untyped_integer_expr(@cast(uint128, len), span)
                )),
                span,
            }));
        }
        
        case .Null => {
            return .Some(.Pointer(alloc_init(
                allocator, 
                SemaType.Plain(.Void)
            )));
        }
        
        case .Bool => {
            return .Some(.Plain(.Bool));
        }
        
        case .Char => {
            return .Some(.Plain(.UInt8));
        }
    }
}

pub fn const_untyped_integer_expr(value: uint128, span: Span) TypedExpr {
    return TypedExpr {
        kind: .Literal(TypedLiteralExpr {
            ty: .None,
            kind: .Integer {
                value: .Unsigned(value),
                suffix: .None,
            },
            span,
        }),
        ty: .None,
        val_cat: .RValue,
        analyzed: false,
        span,
    };
}

