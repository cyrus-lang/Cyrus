    }

    [[inline]]
    pub fn is_interface_object(self: const Self*) bool {
        switch (*self) {
            case .InterfaceObject => return true;
            else => return false;
        }
    }

    pub fn contains_infer_var(self: const Self*) bool {
        switch (*self) {
            case .Placeholder | .GenericParam | .Err | .Unresolved | .Plain | .SelfType | .InterfaceObject => return false;
            case .InferVar => return true;
            case .Const(inner) => return inner->contains_infer_var();
            case .Pointer(inner) => return inner->contains_infer_var();

            case .Array(array) => return array.element_type->contains_infer_var();

            case .Tuple(tuple) => {
                for (var i: usize = 0; i < tuple.elements.len(); i += 1) {
                    const element = tuple.elements.get_const(i).unwrap();

                    if (element->ty.contains_infer_var()) {
                        return true;
                    }
                }

                return false;
            }

            case .FuncType(func) => {
                for (var i: usize = 0; i < func.params.list.len(); i += 1) {
                    const ty = func.params.list.get_const(i).unwrap();

                    if (ty->contains_infer_var()) {
                        return true;
                    }
                }

                switch (func.params.variadic) {
                    case .Some(variadic) => switch (*variadic) {
                        case .UntypedCStyle => {}
                        case .Typed(ty) => {
                            if (ty.contains_infer_var()) {
                                return true;
                            }
                        }
                    }
                }

                return func.ret_type->contains_infer_var();
            }

            case .Named(named_type) => {
                for (var i: usize = 0; i < named_type.type_args.len(); i += 1) {
                    const type_arg = named_type.type_args.get(i).unwrap();

                    switch (*type_arg) {
                        case .Type(ty, _) => {
                            if (ty.contains_infer_var()) {
                                return true;
                            }
                        }
                        case .Infer => return true;
                    }
                }

                return false;
            }
        }
    }

    pub fn contains_generic_param(self: const Self*) bool {
        switch (*self) {
            case .Array(array) => return array.element_type->contains_generic_param();
            
            case .Pointer(inner) => return inner->contains_generic_param();
            
            case .Const(inner) => return inner->contains_generic_param();
            
            case .GenericParam => return true;

            case .Placeholder 
            | .InferVar 
            | .Err 
            | .Unresolved 
            | .Plain 
            | .SelfType 
            | .InterfaceObject => return false;

            case .Tuple(tuple) => {
                for (var i: usize = 0; i < tuple.elements.len(); i += 1) {
                    const element = tuple.elements.get_const(i).unwrap();

                    if (element->ty.contains_generic_param()) {
                        return true;
                    }
                }

                return false;
            }

            case .FuncType(func) => {
                for (var i: usize = 0; i < func.params.list.len(); i += 1) {
                    const ty = func.params.list.get_const(i).unwrap();

                    if (ty->contains_generic_param()) {
                        return true;
                    }
                }

                switch (func.params.variadic) {
                    case .Some(variadic) => switch (*variadic) {
                        case .Typed(ty) => if (ty.contains_generic_param()) {
                            return true;
                        }
                    }
                }

                return func.ret_type->contains_generic_param();
            }

            case .Named(named_type) => {
                for (var i: usize = 0; i < named_type.type_args.len(); i += 1) {
                    const type_arg = named_type.type_args.get(i).unwrap();

                    switch (*type_arg) {
                        case .Type(ty, _) => if (ty.contains_generic_param()) {
                            return true;
                        }
                    }
                }

                return false;
            }
        }
    }

    /// Returns true if this type contains `SelfType` inside it.
    pub fn contains_self_type(self: const Self*) bool {
        switch (*self) {
            case .Named(named_type) => {
                for (var i: usize = 0; i < named_type.type_args.len(); i += 1) {
                    const type_arg = named_type.type_args.get(i).unwrap();

                    switch (*type_arg) {
                        case .Type(ty, _) => if (ty.contains_self_type()) {
                            return true;
                        }
                    }
                }

                return false;
            }

            case .FuncType(func_ty) => {
                for (var i: usize = 0; i < func_ty.params.list.len(); i += 1) {
                    const ty = func_ty.params.list.get_const(i).unwrap();

                    if (ty->contains_self_type()) {
                        return true;
                    }
                }

                return func_ty.ret_type->contains_self_type();
            }

            case .Tuple(ty) => {
                for (var i: usize = 0; i < ty.elements.len(); i += 1) {
                    const element = ty.elements.get_const(i).unwrap();

                    if (element->ty.contains_self_type()) {
                        return true;
                    }
                }

                return false;
            }

            case .Pointer(inner_type) => return inner_type->contains_self_type();
            
            case .Array(array) => return array.element_type->contains_self_type();

            case .Const(inner_type) => return inner_type->contains_self_type();
            
            case .SelfType => return true;

            case .InterfaceObject
            | .Plain
            | .GenericParam
            | .InferVar
            | .Unresolved
            | .Err
            | .Placeholder => return false;
        }
    }
}

pub enum UnresolvedType {
    GenericInst { base_symbol_id: SymbolId, type_args: TypedTypeArgs },
    BuiltinFunc(TypedBuiltinFunc*),
    Decl(SymbolId),

    [[inline]]
    pub fn as_symbol_id(self: const Self*) Option<SymbolId> {
        switch (*self) {
            case .Decl(symbol_id) => return .Some(symbol_id);
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_base_symbol_id(self: const Self*) Option<SymbolId> {
        switch (*self) {
            case .GenericInst { base_symbol_id, .. } => return .Some(base_symbol_id);
            case .Decl(symbol_id) => return .Some(symbol_id);
            case .BuiltinFunc => return .None;
        }
    }
}

pub struct NamedType {
    pub type_decl_id: TypeDeclId,
    pub type_args: TypedTypeArgs,
}

pub enum TypeDeclId {
    Interface(InterfaceDeclId),
    Typedef(TypedefDeclId),
    Struct(StructDeclId),
    Union(UnionDeclId),
    Enum(EnumDeclId),

    [[inline]]
    pub fn as_struct(self: const Self*) Option<StructDeclId> {
        switch (*self) {
            case .Struct(struct_decl_id) => return .Some(struct_decl_id);
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_enum(self: const Self*) Option<EnumDeclId> {
        switch (*self) {
            case .Enum(enum_decl_id) => return .Some(enum_decl_id);
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_union(self: const Self*) Option<UnionDeclId> {
        switch (*self) {
            case .Union(union_decl_id) => return .Some(union_decl_id);
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_interface(self: const Self*) Option<InterfaceDeclId> {
        switch (*self) {
            case .Interface(interface_decl_id) => return .Some(interface_decl_id);
            else => return .None;
        }
    }

    [[inline]]
    pub fn is_struct(self: const Self*) bool {
        switch (*self) {
            case .Struct => return true;
            else => return false;
        }
    }

    [[inline]]
    pub fn is_enum(self: const Self*) bool {
        switch (*self) {
            case .Enum => return true;
            else => return false;
        }
    }

    [[inline]]
    pub fn is_union(self: const Self*) bool {
        switch (*self) {
            case .Union => return true;
            else => return false;
        }
    }

    [[inline]]
    pub fn is_interface(self: const Self*) bool {
        switch (*self) {
            case .Interface => return true;
            else => return false;
        }
    }
}

pub enum PlainType {
    UIntPtr,
    IntPtr,
    ISize,
    USize,
    Int8,
    Int16,
    Int32,
    Int64,
    Int128,
    UInt8,
    UInt16,
    UInt32,
    UInt64,
    UInt128,
    Float16,
    Float32,
    Float64,
    Float128,
    Bool,
    Void,
    Null,

    [[inline]]
    pub fn map_integer_size_to_type(size: usize) Option<PlainType> {
        switch (size) {
            case 1 => return .Some(.Int8);
            case 2 => return .Some(.Int16);
            case 4 => return .Some(.Int32);
            case 8 => return .Some(.Int64);
            case 16 => return .Some(.Int128);
            else => return .None;
        }
    }

    [[inline]]
    pub fn is_scalar(self: const Self*) bool {
        switch (*self) {
            case .UIntPtr 
            | .IntPtr 
            | .ISize 
            | .USize => return true;

            case .Int8 
            | .Int16 
            | .Int32 
            | .Int64 
            | .Int128 => return true;

            case .UInt8 
            | .UInt16 
            | .UInt32 
            | .UInt64 
            | .UInt128 => return true;

            case .Float16 
            | .Float32 
            | .Float64 
            | .Float128 => return true;

            case .Void | .Null => return false;
            
            case .Bool => return true;
        }
    }

    [[inline]]
    pub fn is_void(self: const Self*) bool {
        switch (*self) {
            case .Void => return true;
            else => return false;
        }
    }

    [[inline]]
    pub fn is_bool(self: const Self*) bool {
        switch (*self) {
            case .Bool => return true;
            else => return false;
        }
    }

    [[inline]]
    pub fn is_uint8(self: const Self*) bool {
        switch (*self) {
            case .UInt8 => return true;
            else => return false;
        }
    }

    [[inline]]
    pub fn is_integer_or_bool(self: const Self*) bool {
        return self->is_integer() || self->is_bool();
    }

    [[inline]]
    pub fn is_integer(self: const Self*) bool {
        switch (*self) {
            case .UIntPtr
            | .IntPtr
            | .ISize
            | .USize
            | .Int8
            | .Int16
            | .Int32
            | .Int64
            | .Int128
            | .UInt8
            | .UInt16
            | .UInt32
            | .UInt64
            | .UInt128 => return true;

            else => return false;
        }
    }

    [[inline]]
    pub fn is_float(self: const Self*) bool {
        switch (*self) {
            case .Float16 | .Float32 | .Float64 | .Float128 => return true;
            else => return false;
        }
    }

    [[inline]]
    pub fn is_signed(self: const Self*) bool {
        switch (*self) {
            case .UIntPtr
            | .UInt8
            | .UInt16
            | .UInt32
            | .UInt64
            | .UInt128
            | .USize => return false;

            case .ISize
            | .IntPtr
            | .Int8
            | .Int16
            | .Int32
            | .Int64
            | .Int128 => return true;

            case .Bool | .Void | .Null => return false;

            case .Float16 | .Float32 | .Float64 | .Float128 => return false;
        }
    }

    // TODO: I believe bool also should be added here.
    [[inline]]
    pub fn plain_type_rank(ty: const PlainType*) Option<uint8> {
        switch (*ty) {
            case .Int8 | .UInt8 => return .Some(2);
            
            case .Int16 | .UInt16 => return .Some(3);
            
            case .Int32 | .UInt32 => return .Some(4);
            
            case .Int64 | .UInt64 => return .Some(5);
            
            case .IntPtr 
            | .UIntPtr 
            | .ISize 
            | .USize => return .Some(6);

            case .Int128 | .UInt128 => return .Some(7);

            case .Float16 => return .Some(8);
            case .Float32 => return .Some(9);
            case .Float64 => return .Some(10);
            case .Float128 => return .Some(11);

            else => return .None;
        }
    }

    [[inline]]
    pub fn widen_type(a: PlainType, b: PlainType) Option<PlainType> {
        switch (PlainType.plain_type_rank(&a)) {
            case .Some(ar) => switch (PlainType.plain_type_rank(&b)) {
                case .Some(br) => if (ar >= br) {
                    return .Some(a);
                } else {
                    return .Some(b);
                }
            }
        }

        return .None;
    }

    [[inline]]
    pub fn to_str(self: const Self*) const uint8* {
        switch (*self) {
            case .UIntPtr => return "uintptr";
            case .IntPtr => return "intptr";
            case .ISize => return "isize";
            case .USize => return "usize";
            case .Int8 => return "int8";
            case .Int16 => return "int16";
            case .Int32 => return "int32";
            case .Int64 => return "int64";
            case .Int128 => return "int128";
            case .UInt8 => return "uint8";
            case .UInt16 => return "uint16";
            case .UInt32 => return "uint32";
            case .UInt64 => return "uint64";
            case .UInt128 => return "uint128";
            case .Float16 => return "float16";
            case .Float32 => return "float32";
            case .Float64 => return "float64";
            case .Float128 => return "float128";
            case .Bool => return "bool";
            case .Void => return "void";
            case .Null => return "null";
        }
    }
}

pub struct TypedTupleType {
    pub elements: Vec<TypedTupleElement>,
    pub span: Span,
}

pub struct TypedTupleElement {
    pub ty: SemaType,
    pub span: Span,
}

pub struct TypedFuncType {
    pub params: TypedFuncTypeParams,
    pub ret_type: SemaType*,
    pub vis: ast::ASTVisibility,
    pub callconv: ast::ASTCallconv,
    pub span: Span,
}

pub struct TypedArrayType {
    pub element_type: SemaType*,
    pub capacity: TypedArrayCapacity,
    pub span: Span,
}

pub enum TypedArrayCapacity {
    Fixed(TypedExpr*),
    Slice,
}

pub struct InterfaceObjectType {
    pub interface_type: NamedType,
    pub concrete_type: SemaType*,
    pub vtable_id: VTableId,
    pub span: Span,
}

[[inline]]
pub fn map_integer_suffix_to_sema_type(suffix: const TokenKind*) Option<SemaType> {
    switch (*suffix) {
        case .UIntPtr => return .Some(.Plain(.UIntPtr));
        case .IntPtr => return .Some(.Plain(.IntPtr));
        case .USize => return .Some(.Plain(.USize));
        case .ISize => return .Some(.Plain(.ISize));
        case .Int8 => return .Some(.Plain(.Int8));
        case .Int16 => return .Some(.Plain(.Int16));
        case .Int32 => return .Some(.Plain(.Int32));
        case .Int64 => return .Some(.Plain(.Int64));
        case .Int128 => return .Some(.Plain(.Int128));
        case .UInt8 => return .Some(.Plain(.UInt8));
        case .UInt16 => return .Some(.Plain(.UInt16));
        case .UInt32 => return .Some(.Plain(.UInt32));
        case .UInt64 => return .Some(.Plain(.UInt64));
        case .UInt128 => return .Some(.Plain(.UInt128));
        else => return .None;
    }
}

[[inline]]
pub fn map_float_suffix_to_sema_type(suffix: const TokenKind*) Option<SemaType> {
    switch (*suffix) {
        case .Float16 => return .Some(.Plain(.Float16));
        case .Float32 => return .Some(.Plain(.Float32));
        case .Float64 => return .Some(.Plain(.Float64));
        case .Float128 => return .Some(.Plain(.Float128));
        else => return .None;
    }
}

/* ************* Expressions ************* */

pub struct TypedExpr {
    pub kind: TypedExprKind,
    pub ty: Option<SemaType>,
    pub val_cat: ValueCategory,
    pub analyzed: bool,
    pub span: Span,

    [[inline]]
    pub fn new(kind: TypedExprKind, span: Span) Self {
        return Self {
            kind,
            ty: .None,
            val_cat: .Unknown,
            analyzed: false,
            span,
        };
    }

    [[inline]]
    pub fn is_lvalue(self: const Self*) bool {
        switch (self->val_cat) {
            case .LValue => return true;
            else => return false;
        }
    }

    [[inline]]
    pub fn is_rvalue(self: const Self*) bool {
        switch (self->val_cat) {
            case .RValue => return true;
            else => return false;
        }
    }

    pub fn is_comptime_expr(self: const Self*) bool {
        switch (self->kind) {
            case .Literal => return true;
            case .Lambda => return true;

            case .Array(array) => {
                for (var i: usize = 0; i < array.elements.len(); i += 1) {
                    const element = array.elements.get_const(i).unwrap();

                    if (!element->is_comptime_expr()) {
                        return false;
                    }
                }

                return true;
            }

            case .Tuple(tuple) => {
                for (var i: usize = 0; i < tuple.elements.len(); i += 1) {
                    const element = tuple.elements.get_const(i).unwrap();

                    if (!element->is_comptime_expr()) {
                        return false;
                    }
                }

                return true;
            }

            case .EnumInit(enum_init) => {
                switch (enum_init.arg) {
                    case .Unit => return true;
                    
                    case .Tuple(exprs) => {
                        for (var i: usize = 0; i < exprs.len(); i += 1) {
                            const element = exprs.get_const(i).unwrap();

                            if (!element->is_comptime_expr()) {
                                return false;
                            }
                        }

                        return true;
                    }
                    
                    case .Struct(field_inits) => {
                        for (var i: usize = 0; i < field_inits.len(); i += 1) {
                            const field_init = field_inits.get_const(i).unwrap();

                            if (!field_init->value->is_comptime_expr()) {
                                return false;
                            }
                        }

                        return true;
                    }
                }
            }

            case .StructInit(struct_init) => {
                for (var i: usize = 0; i < struct_init.fields.len(); i += 1) {
                    const field = struct_init.fields.get_const(i).unwrap();

                    if (!field->value.is_comptime_expr()) {
                        return false;
                    }
                }

                return true;
            }

            case .UnionInit(union_init) => {
                return union_init.field->value.is_comptime_expr();
            }

            else => return false;
        }
    }

    pub fn literal_const_int_value(self: const Self*) Option<IntegerLiteral> {
        switch (self->kind) case .Literal(lit) else {
            return .None;
        }

        switch (lit.kind) {
            case .Integer { value, .. } => {
                switch (value) {
                    case .Unsigned(val) => return .Some(.Unsigned(val));
                    case .Signed(val) => return .Some(.Signed(val));
                }
            }
            case .Bool(v) => {
                if (v) {
                    return .Some(.Unsigned(1));
                } else {
                    return .Some(.Unsigned(0));
                }
            }
        }

        return .None;
    }

    pub fn literal_const_string_value(self: const Self*) Option<const uint8*> {
        switch (self->kind) case .Literal(lit) else {
            return .None;
        }

        switch (lit.kind) {
            case .String { value, suffix } => {
                switch (suffix) {
                    case .None => return .Some(value.as_str_const());
                    case .Some => return .None;
                }
            }
        }

        return .None;
    }
}

pub enum ValueCategory {
    LValue(ast::ASTConstness),
    Unknown,
    RValue,
    Type,

    [[inline]]
    pub fn is_const_lvalue(self: const Self*) bool {
        switch (*self) {
            case .LValue(.Const) => return true;
            else => return false;
        }
    }
}

pub enum TypedExprKind {
    EnumStructVariantInit(TypedEnumStructVariantInit),
    UnnamedStructValue(TypedUnnamedStructValue),
    UnnamedUnionValue(TypedUnnamedUnionValue),
    UnnamedEnumValue(TypedUnnamedEnumValue),
    TupleAccess(TypedTupleAccessExpr),
    StructInit(TypedStructInitExpr),
    ArrayIndex(TypedArrayIndexExpr),
    FieldAccess(TypedFieldAccess),
    UnionInit(TypedUnionInitExpr),
    MethodCall(TypedMethodCall),
    InlineAsm(TypedInlineAsm),
    Literal(TypedLiteralExpr),
    Dynamic(TypedDynamicExpr),
    FuncCall(TypedFuncCall),
    EnumInit(TypedEnumInit),
    Lambda(TypedLambdaExpr),
    AddrOf(TypedAddrOfExpr),
    Assign(TypedAssignExpr),
    Symbol(TypedSymbolExpr),
    Prefix(TypedPrefixExpr),
    Builtin(TypedBuiltin),
    Infix(TypedInfixExpr),
    Deref(TypedDerefExpr),
    Array(TypedArrayExpr),
    Tuple(TypedTupleExpr),
    SemaType {
        ty: SemaType,
        span: Span
    },
    Poisoned,

    [[inline]]
    pub fn as_literal(self: const Self*) Option<TypedLiteralExpr> {
        switch (*self) {
            case .Literal(literal) => return .Some(literal);
            else => return .None;
        }
    }

    pub fn as_type_expr(self: const Self*, allocator: Allocator) Option<SemaType> {
        switch (*self) {
            case .Symbol(symbol_expr) => {
                switch (symbol_expr.as_decl_id()) {
                    case .Some(decl_id) => {
                        switch (decl_id.as_type_decl_id()) {
                            case .Some(type_decl_id) => {
                                return .Some(.Named(NamedType {
                                    type_decl_id,
                                    type_args: TypedTypeArgs.new(allocator),
                                }));
                            }
                        }
                    }
                }
            }
            case .SemaType { ty, .. } => return .Some(ty);
        }

        return .None;
    }

    [[inline]]
    pub fn is_dynamic(self: const Self*) bool {
        switch (*self) {
            case .Dynamic => return true;
            else => return false;
        }
    }

    [[inline]]
    pub fn as_unresolved_symbol_id(self: const Self*) Option<SymbolId> {
        switch (*self) {
            case .Symbol(symbol_expr) => return symbol_expr.as_symbol_id();
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_resolved_decl_id(self: const Self*) Option<DeclId> {
        switch (*self) {
            case .Symbol(symbol_expr) => return symbol_expr.as_decl_id();
            else => return .None;
        }
    }

    [[inline]]
    pub fn is_lvalue(self: const Self*) bool {
        switch (*self) {
            case .Symbol | .ArrayIndex | .Deref | .FieldAccess | .TupleAccess => return true;

            case .Poisoned 
            | .MethodCall
            | .FuncCall
            | .StructInit
            | .UnnamedStructValue
            | .UnnamedEnumValue
            | .Literal
            | .Prefix
            | .Infix
            | .Assign
            | .AddrOf
            | .Array
            | .Lambda
            | .Tuple
            | .Dynamic
            | .UnnamedUnionValue
            | .Builtin
            | .InlineAsm
            | .EnumStructVariantInit
            | .UnionInit
            | .EnumInit
            | .SemaType => return false;
        }
    }
}

pub struct TypedAsmOperand {
    pub constraint: String,
    pub expr: TypedExpr*,
    pub span: Span,
}

pub struct TypedAsmClobber {
    pub name: String,
    pub span: Span,
}

pub struct TypedInlineAsm {
    pub template: Vec<String>,
    pub outputs: Vec<TypedAsmOperand>,
    pub inputs: Vec<TypedAsmOperand>,
    pub clobbers: Vec<TypedAsmClobber>,
    pub is_volatile: bool,
    pub span: Span,
}

pub enum TypedSymbolExpr {
    Unresolved {
        symbol_id: SymbolId,
        span: Span,
    },
    Resolved {
        decl_id: DeclId,
        span: Span,
    },

    [[inline]]
    pub fn to_resolved_decl_id(self: Self*, decl_id: DeclId) {
        switch (*self) {
            case .Unresolved { span, .. } => {
                *self = .Resolved { decl_id, span };
            }
        }
    }

    [[inline]]
    pub fn as_decl_id(self: const Self*) Option<DeclId> {
        switch (*self) {
            case .Resolved { decl_id, .. } => return .Some(decl_id);
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_symbol_id(self: const Self*) Option<SymbolId> {
        switch (*self) {
            case .Unresolved { symbol_id, .. } => return .Some(symbol_id);
            else => return .None;
        }
    }

    [[inline]]
    pub fn span(self: const Self*) Span {
        switch (*self) {
            case .Unresolved { span, .. } => return span;
            case .Resolved { span, .. } => return span;
        }
    }
}

pub struct TypedDynamicExpr {
    pub operand: TypedExpr*,
    pub object_name: Option<String>,
    pub interface_object_type: Option<InterfaceObjectType>,
    pub concrete_type: Option<SemaType>,
    pub span: Span,
}

pub struct TypedTupleAccessExpr {
    pub operand: TypedExpr*,
    pub index: usize,
