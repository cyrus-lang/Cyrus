/* ************* Statements ************* */

pub struct Stmt {
    pub kind: StmtKind,
    pub is_dead: bool,

    [[inline]]
    pub fn new(kind: StmtKind) Self {
        return Self { kind, is_dead: false };
    }
}

pub enum StmtKind {
    TupleExport(TupleExportStmt),
    Interface(InterfaceStmt),
    GlobalVar(GlobalVarStmt),
    Continue(ContinueStmt),
    FuncDecl(FuncDeclStmt),
    FuncDef(FuncDefStmt),
    InlineAsm(InlineAsm),
    Typedef(TypedefStmt),
    BlockStmt(BlockStmt),
    Switch(SwitchStmt),
    Return(ReturnStmt),
    Struct(StructStmt),
    Variable(VarStmt),
    Builtin(Builtin),
    While(WhileStmt),
    Label(LabelStmt),
    Union(UnionStmt),
    Break(BreakStmt),
    Defer(DeferStmt),
    Goto(GotoStmt),
    Enum(EnumStmt),
    For(ForStmt),
    If(IfStmt),
    Expr(Expr),

    pub fn span(self: const Self*) Span {
        switch (*self) {
            case .BlockStmt(typed_block_statement) => return typed_block_statement.span;
            case .GlobalVar(typed_global_variable) => return typed_global_variable.span;
            case .TupleExport(export_tuple_values) => return export_tuple_values.span;
            case .Interface(typed_interface) => return typed_interface.span;
            case .FuncDecl(typed_func_decl) => return typed_func_decl.span;
            case .Label(typed_label_stmt) => return typed_label_stmt.span;
            case .Variable(typed_variable) => return typed_variable.span;
            case .Continue(typed_continue) => return typed_continue.span;
            case .FuncDef(typed_func_def) => return typed_func_def.span;
            case .Builtin(typed_builtin) => return typed_builtin.span();
            case .Goto(typed_goto_stmt) => return typed_goto_stmt.span;
            case .Typedef(typed_typedef) => return typed_typedef.span;
            case .Switch(typed_switch) => return typed_switch.span;
            case .Return(typed_return) => return typed_return.span;
            case .Struct(struct_stmt) => return struct_stmt.span;
            case .Defer(typed_defer) => return typed_defer.span;
            case .Break(typed_break) => return typed_break.span;
            case .While(while_stmt) => return while_stmt.span;
            case .Union(union_stmt) => return union_stmt.span;
            case .Expr(typed_expr) => return typed_expr.span;
            case .Enum(typed_enum) => return typed_enum.span;
            case .For(typed_for) => return typed_for.span;
            case .If(typed_if) => return typed_if.span;
            case .InlineAsm(asm) => return asm.span;
        }
    }
}

