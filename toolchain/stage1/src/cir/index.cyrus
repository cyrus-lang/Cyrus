    pub fn format_kind(self: const Self*) const uint8* {
        switch (self->kind) {
            case .Integer => return "integer";
            case .Float => return "float";
            case .String => return "string";
            case .Bool => return "bool";
            case .Char => return "char";
            case .Null => return "null";
        }
    }
