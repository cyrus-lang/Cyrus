    [[inline]]
    pub fn is_enum(self: const Self*) bool {
        switch (*self) {
            case .Enum => return true;
            else => return false;
        }
    }

    [[inline]]
    pub fn is_union(self: const Self*) bool {
        switch (*self) {
            case .Union => return true;
            else => return false;
        }
    }

    [[inline]]
    pub fn is_interface(self: const Self*) bool {
