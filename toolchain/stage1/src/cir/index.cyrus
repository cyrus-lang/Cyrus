pub struct TypedEnumStmt {
    pub enum_decl_id: EnumDeclId,
    pub variants: Vec<TypedEnumVariant>,
    pub generic_params: TypedGenericParams,
    pub impls: Vec<TypedImplementInterface>,
    pub modifiers: ast::ASTEnumModifiers,
    pub tag_type: Option<SemaType>,
    pub align: Option<usize>,
    pub methods: MethodDecls,
    pub name: String,
    pub span: Span,

    [[inline]]
    pub fn is_generic(self: const Self*) bool {
        return !self->generic_params.is_empty();
    }

    pub fn is_repr_c(self: const Self*) bool {
        switch (self->modifiers.repr_attr) {
            case .Some(repr_attr) => {
                for (var i: usize = 0; i < repr_attr.items.len(); i += 1) {
                    const item = repr_attr.items.get_const(i).unwrap();

                    switch (item->kind) {
                        case .Kind(.C) => return true;
                        else => {}
                    }
                }
            }
            else => {}
        }

        return false;
    }
}

pub enum TypedEnumVariant {
    Struct { ident: ast::ASTIdent, fields: Vec<TypedEnumVariantStructField> },
    Tuple { ident: ast::ASTIdent, fields: Vec<TypedEnumVariantTupleField> },
    Valued { ident: ast::ASTIdent, value: TypedExpr* },
    Unit(ast::ASTIdent),

    [[inline]]
    pub fn name(self: const Self*) const uint8* {
        switch (*self) {
            case .Valued { ident, .. } => return ident.str.as_str_const();
            case .Struct { ident, .. } => return ident.str.as_str_const();
            case .Tuple { ident, .. } => return ident.str.as_str_const();
            case .Unit(ident) => return ident.str.as_str_const();
        }
    }

    [[inline]]
    pub fn span(self: const Self*) Span {
        switch (*self) {
            case .Valued { ident, .. } => return ident.span;
            case .Struct { ident, .. } => return ident.span;
            case .Tuple { ident, .. } => return ident.span;
            case .Unit(ident) => return ident.span;
        }
    }
}

