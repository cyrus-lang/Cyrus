pub struct TypedFuncParams {
    pub variadic: Option<TypedFuncVariadicParam>,
    pub list: Vec<TypedFuncParamKind>,

    pub fn lookup_param(self: const Self*, name: const uint8*) Option<const TypedFuncParamKind*> {
        for (var i: usize = 0; i < self->list.len(); i += 1) {
            const param_kind = self->list.get_const(i).unwrap();

            if (param_kind->name_str() == name) {
                return .Some(param_kind);
            }
        }

        return .None;
    }

    [[inline]]
    pub fn is_instance_method(self: const Self*) bool {
        if (self->list.len() == 0) {
            return false;
        }

        switch (self->list.first_const()) {
            case .Some(param) => switch (param->as_self_modifier()) {
                case .Some => return true;
                case .None => return false;
            }
        }

        return false;
    }

    [[inline]]
    pub fn get_self_modifier(self: const Self*) Option<TypedSelfModifier> {
        switch (self->list.first_const()) {
            case .Some(param) => return param->as_self_modifier();
            case .None => return .None;
        }
    }
}

pub enum TypedFuncVariadicParam {
    Typed {
        var_decl_id: VarDeclId,
        ty: SemaType,
        span: Span,
    },
    UntypedCStyle,
}

pub struct TypedFuncTypeParams {
    pub variadic: Option<TypedFuncTypeVariadicParam*>,
    pub list: Vec<SemaType>,
}

pub enum TypedFuncTypeVariadicParam {
    UntypedCStyle,
    Typed(SemaType),
}

pub enum TypedFuncParamKind {
    SelfModifier(TypedSelfModifier),
    FuncParam(TypedFuncParam),

    [[inline]]
    pub fn is_const(self: const Self*) bool {
        switch (*self) {
            case .FuncParam(func_param) => return func_param.mutability == .Const;
            case .SelfModifier(self_modifier) => return self_modifier.mutability == .Const;
        }
    }

    [[inline]]
    pub fn name_str(self: const Self*) const uint8* {
        switch (*self) {
            case .FuncParam(func_param) => return func_param.ident.str.as_str_const();
            case .SelfModifier => return "self";
        }
    }

    [[inline]]
    pub fn span(self: const Self*) Span {
        switch (*self) {
            case .FuncParam(typed_func_param) => return typed_func_param.span;
            case .SelfModifier(typed_self_modifier) => return typed_self_modifier.span;
        }
    }

    [[inline]]
    pub fn var_decl_id(self: const Self*) Option<VarDeclId> {
        switch (*self) {
            case .FuncParam(func_param) => return func_param.var_decl_id;
            case .SelfModifier(self_modifier) => return self_modifier.var_decl_id;
        }
    }

    [[inline]]
    pub fn as_self_modifier(self: const Self*) Option<TypedSelfModifier> {
        switch (*self) {
            case .SelfModifier(self_modifier) => return .Some(self_modifier);
            else => return .None;
        }
    }
}

pub struct TypedSelfModifier {
    pub var_decl_id: Option<VarDeclId>,
    pub ty: SemaType,
    pub mutability: ast::ASTConstness,
    pub span: Span,

    [[inline]]
    pub fn is_indirect(self: const Self*) bool {
        return self->ty.is_pointer();
    }
}

pub struct TypedFuncParam {
    pub var_decl_id: Option<VarDeclId>,
    pub ident: ast::ASTIdent,
    pub ty: SemaType,
    pub mutability: ast::ASTConstness,
    pub span: Span,
}

pub struct TypedForStmt {
    pub initializer: Option<TypedVarStmt>,
    pub cond: Option<TypedExpr>,
    pub increment: Option<TypedExpr>,
    pub body: TypedBlockStmt*,
    pub span: Span,
}

pub struct TypedWhileStmt {
    pub cond: TypedExpr,
    pub body: TypedBlockStmt*,
    pub span: Span,
}

pub struct TypedSwitchStmt {
    pub operand: TypedExpr,
    pub cases: Vec<TypedSwitchCase>,
    pub default_case: Option<TypedBlockStmt>,
    pub all_cases_covered: Option<bool>,
    pub span: Span,

    pub fn includes_any_range(self: const Self*) bool {
        for (var i: usize = 0; i < self->cases.len(); i += 1) {
            const switch_case = self->cases.get_const(i).unwrap();

            for (var j: usize = 0; j < switch_case->patterns.len(); j += 1) {
                const pattern = switch_case->patterns.get_const(j).unwrap();

                switch (pattern->kind) {
                    case .Range => return true;
                }
            }
        }

        return false;
    }

    pub fn includes_only_integer(self: const Self*) bool {
        for (var i: usize = 0; i < self->cases.len(); i += 1) {
            const switch_case = self->cases.get_const(i).unwrap();

            for (var j: usize = 0; j < switch_case->patterns.len(); j += 1) {
                const pattern = switch_case->patterns.get_const(j).unwrap();

                switch (pattern->kind) {
                    case .Expr(expr) => {
                        switch (expr.ty) {
                            case .Some(ty) => if (ty.is_uint8() || ty.is_integer()) {
                                return true;
                            }
                        }
                    }
                }
            }
        }

        return false;
    }
}

pub struct TypedSwitchCase {
    pub patterns: Vec<TypedSwitchCasePattern>,
    pub body: TypedBlockStmt*,
    pub span: Span,
}

pub struct TypedSwitchCasePattern {
    pub kind: TypedSwitchCasePatternKind,
    pub span: Span,
}

pub enum TypedSwitchCasePatternKind {
    /// `_`
    Wildcard,

    Binding {
        name: ast::ASTIdent,
        var_decl_id: VarDeclId,
    },

    /// `1..10` or `1..=10`
    Range(TypedRange),

    /// literal / constant expression
    Expr(TypedExpr),

    /// .Variant
    EnumUnit(ast::ASTIdent),

    /// .Variant(a, b, _)
    EnumTupleVariant {
        ident: ast::ASTIdent,
        items: Vec<TypedSwitchCasePattern>,
    },

    /// .Variant { a, b: x, c: _, .. }
    EnumStructVariant {
        ident: ast::ASTIdent,
        items: Vec<TypedSwitchCaseEnumStructPatternField>,
        has_rest: bool,
    },
}

pub struct TypedSwitchCaseEnumStructPatternField {
    pub name: ast::ASTIdent,
    pub pattern: TypedSwitchCasePattern,
}

pub struct TypedRange {
    pub lower: TypedExpr,
    pub upper: TypedExpr,
    pub inclusive_upper: bool,
    pub span: Span,
}

pub struct TypedBreakStmt {
    pub span: Span,
}

pub struct TypedContinueStmt {
    pub span: Span,
}

pub struct TypedGenericParams {
    pub ids: Vec<GenericParamId>,

    [[inline]]
    pub fn new(allocator: Allocator) Self {
        return Self { ids: Vec.new(allocator) };
    }

    [[inline]]
    pub fn is_empty(self: const Self*) bool {
        return self->ids.is_empty();
    }

    [[inline]]
    pub fn len(self: const Self*) usize {
        return self->ids.len();
    }

    [[inline]]
    pub fn contains(self: const Self*, id: GenericParamId) bool {
        switch (self->ids.index(id)) {
            case .Some => return true;
            case .None => return false;
        }
    }
}

pub struct TypedGenericParam {
    pub name: ast::ASTIdent,
    pub bounds: Vec<TypedBound>,
    pub default: Option<SemaType*>,
}

pub struct TypedTypeArgs {
    pub list: Vec<TypedTypeArg>,

    [[inline]]
    pub fn new(allocator: Allocator) Self {
        return Self { list: Vec.new(allocator) };
    }

    [[inline]]
    pub fn get(self: const Self*, index: usize) Option<const TypedTypeArg*> {
        return self->list.get_const(index);
    }

    [[inline]]
    pub fn is_empty(self: const Self*) bool {
        return self->list.is_empty();
    }

    [[inline]]
    pub fn len(self: const Self*) usize {
        return self->list.len();
    }

    [[inline]]
    pub fn push(self: Self*, ty: TypedTypeArg) {
        self->list.push(ty);
    }
}

pub enum TypedTypeArg {
    Type(SemaType, Span),
    Infer,
}

pub struct TypedBound {
    pub ty: SemaType,
    pub span: Span,
}

/* ************* Declarations ************* */

pub enum DeclId {
    Interface(InterfaceDeclId),
    GlobalVar(GlobalVarDeclId),
    Typedef(TypedefDeclId),
    Method(MethodDeclId),
    Struct(StructDeclId),
    Union(UnionDeclId),
    Func(FuncDeclId),
    Enum(EnumDeclId),
    Var(VarDeclId),

    [[inline]]
    pub fn as_type_decl_id(self: const Self*) Option<TypeDeclId> {
        switch (*self) {
            case .Struct(id) => return .Some(.Struct(id));
            case .Enum(id) => return .Some(.Enum(id));
            case .Union(id) => return .Some(.Union(id));
            case .Interface(id) => return .Some(.Interface(id));
            case .Typedef(id) => return .Some(.Typedef(id));
            case .Func | .Method | .GlobalVar | .Var => return .None;
        }
    }

    [[inline]]
    pub fn is_var(self: const Self*) bool {
        switch (*self) {
            case .Var => return true;
            else => return false;
        }
    }

    [[inline]]
    pub fn is_global_var(self: const Self*) bool {
        switch (*self) {
            case .GlobalVar => return true;
            else => return false;
        }
    }

    [[inline]]
    pub fn is_var_or_global_var(self: const Self*) bool {
        switch (*self) {
            case .Var | .GlobalVar => return true;
            else => return false;
        }
    }

    [[inline]]
    pub fn is_func(self: const Self*) bool {
        switch (*self) {
            case .Func => return true;
            else => return false;
        }
    }

    [[inline]]
    pub fn as_struct(self: const Self*) Option<StructDeclId> {
        switch (*self) {
            case .Struct(id) => return .Some(id);
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_enum(self: const Self*) Option<EnumDeclId> {
        switch (*self) {
            case .Enum(id) => return .Some(id);
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_union(self: const Self*) Option<UnionDeclId> {
        switch (*self) {
            case .Union(id) => return .Some(id);
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_func(self: const Self*) Option<FuncDeclId> {
        switch (*self) {
            case .Func(id) => return .Some(id);
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_method(self: const Self*) Option<MethodDeclId> {
        switch (*self) {
            case .Method(id) => return .Some(id);
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_interface(self: const Self*) Option<InterfaceDeclId> {
        switch (*self) {
            case .Interface(id) => return .Some(id);
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_global_var(self: const Self*) Option<GlobalVarDeclId> {
        switch (*self) {
            case .GlobalVar(id) => return .Some(id);
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_var(self: const Self*) Option<VarDeclId> {
        switch (*self) {
            case .Var(id) => return .Some(id);
            else => return .None;
        }
    }

    [[inline]]
    pub fn as_typedef(self: const Self*) Option<TypedefDeclId> {
        switch (*self) {
            case .Typedef(id) => return .Some(id);
            else => return .None;
        }
    }
}

pub struct MethodDeclEntry {
    pub name: String,
    pub id: MethodDeclId,
}

pub struct MethodDecls {
    pub entries: Vec<MethodDeclEntry>,

    [[inline]]
    pub fn new(allocator: Allocator) Self {
        return Self { entries: Vec.new(allocator) };
    }

    [[inline]]
    pub fn len(self: const Self*) usize {
        return self->entries.len();
    }

    pub fn insert(self: Self*, name: String, method_decl_id: MethodDeclId) bool {
        for (var i: usize = 0; i < self->entries.len(); i += 1) {
            const entry = self->entries.get(i).unwrap();

            if (strcmp(entry->name.as_str_const(), name.as_str_const()) == 0) {
                entry->id = method_decl_id;
                name.free();
                return false;
            }
        }

        self->entries.push(MethodDeclEntry { name, id: method_decl_id });
        return true;
    }

    pub fn get(self: const Self*, name: const uint8*) Option<MethodDeclId> {
        for (var i: usize = 0; i < self->entries.len(); i += 1) {
            const entry = self->entries.get_const(i).unwrap();

            if (strcmp(entry->name.as_str_const(), name) == 0) {
                return .Some(entry->id);
            }
        }

        return .None;
    }

    [[inline]]
    pub fn contains(self: const Self*, name: const uint8*) bool {
        switch (self->get(name)) {
            case .Some => return true;
            case .None => return false;
        }
    }

    pub fn contains_method_id(self: const Self*, method_decl_id: MethodDeclId) bool {
        for (var i: usize = 0; i < self->entries.len(); i += 1) {
            const entry = self->entries.get_const(i).unwrap();

            if (entry->id == method_decl_id) {
                return true;
            }
        }

        return false;
    }
}

pub struct StructDecl {
    pub name: Option<String>,
    pub fields: Vec<TypedStructField>,
    pub impls: Vec<TypedImplementInterface>,
    pub methods: MethodDecls,
    pub generic_params: TypedGenericParams,
    pub modifiers: ast::ASTStructModifiers,
    pub align: Option<usize>,
    pub is_normalized: bool,
    pub span: Span,

    [[inline]]
    pub fn is_generic(self: const Self*) bool {
        return !self->generic_params.is_empty();
    }

    pub fn lookup_field(self: const Self*, name: const uint8*) Option<const TypedStructField*> {
        for (var i: usize = 0; i < self->fields.len(); i += 1) {
            const field = self->fields.get_const(i).unwrap();

            if (strcmp(field->name.as_str_const(), name) == 0) {
                return .Some(field);
            }
        }

        return .None;
    }

    pub fn is_packed(self: const Self*) bool {
        switch (self->modifiers.repr_attr) {
            case .Some(repr_attr) => {
                for (var i: usize = 0; i < repr_attr.items.len(); i += 1) {
                    const item = repr_attr.items.get_const(i).unwrap();

                    switch (item->kind) {
                        case .Packed => return true;
                    }
                }

                return false;
            }
            case .None => return false;
        }
    }
}

pub struct UnionDecl {
    pub name: Option<String>,
    pub fields: Vec<TypedUnionField>,
    pub impls: Vec<TypedImplementInterface>,
    pub methods: MethodDecls,
    pub generic_params: TypedGenericParams,
    pub modifiers: ast::ASTUnionModifiers,
    pub align: Option<usize>,
    pub is_normalized: bool,
    pub span: Span,

    [[inline]]
    pub fn is_generic(self: const Self*) bool {
        return !self->generic_params.is_empty();
    }

    pub fn lookup_field(self: const Self*, name: const uint8*) Option<const TypedUnionField*> {
        for (var i: usize = 0; i < self->fields.len(); i += 1) {
            const field = self->fields.get_const(i).unwrap();

            if (strcmp(field->name.as_str_const(), name) == 0) {
                return .Some(field);
            }
        }

        return .None;
    }
}

pub struct EnumDecl {
    pub name: Option<String>,
    pub methods: MethodDecls,
    pub variants: Vec<TypedEnumVariant>,
    pub impls: Vec<TypedImplementInterface>,
    pub generic_params: TypedGenericParams,
    pub modifiers: ast::ASTEnumModifiers,
    pub tag_type: Option<SemaType>,
    pub align: Option<usize>,
    pub is_normalized: bool,
    pub span: Span,

    [[inline]]
    pub fn is_generic(self: const Self*) bool {
        return !self->generic_params.is_empty();
    }

    pub fn lookup_variant(self: const Self*, name: const uint8*) Option<const TypedEnumVariant*> {
        for (var i: usize = 0; i < self->variants.len(); i += 1) {
            const variant = self->variants.get_const(i).unwrap();

            switch (*variant) {
                case .Unit(ident) => {
                    if (strcmp(ident.str.as_str_const(), name) == 0) {
                        return .Some(variant);
                    }
                }
                case .Valued { ident, .. } => {
                    if (strcmp(ident.str.as_str_const(), name) == 0) {
                        return .Some(variant);
                    }
                }
                case .Tuple { ident, .. } => {
                    if (strcmp(ident.str.as_str_const(), name) == 0) {
                        return .Some(variant);
                    }
                }
                case .Struct { ident, .. } => {
                    if (strcmp(ident.str.as_str_const(), name) == 0) {
                        return .Some(variant);
                    }
                }
            }
        }

        return .None;
    }

    pub fn is_repr_c(self: const Self*) bool {
        switch (self->modifiers.repr_attr) {
            case .Some(repr_attr) => {
                for (var i: usize = 0; i < repr_attr.items.len(); i += 1) {
                    const item = repr_attr.items.get_const(i).unwrap();

                    switch (item->kind) {
                        case .Kind(kind) => {
                            switch (kind) {
                                case .C => return true;
                            }
                        }
                    }
                }
            }
        }

        return false;
    }
}

pub struct FuncDecl {
    pub file_id: SourceId,
    pub name: String,
    pub params: TypedFuncParams,
    pub generic_params: TypedGenericParams,
    pub ret_type: SemaType,
    pub body: Option<BodyId>,

    pub is_func_decl: bool,
    pub modifiers: ast::ASTFuncModifiers,
    pub span: Span,

    pub fn is_generic(self: const Self*) bool {
        return !self->generic_params.is_empty();
    }

    pub fn decl_contains_any_infer_var(self: const Self*) bool {
        for (var i: usize = 0; i < self->params.list.len(); i += 1) {
            const param = self->params.list.get_const(i).unwrap();

            switch (*param) {
                case .FuncParam(func_param) => {
                    if (func_param.ty.contains_infer_var()) {
                        return true;
                    }
                }
                case .SelfModifier(self_modifier) => {
                    if (self_modifier.ty.contains_infer_var()) {
                        return true;
                    }
                }
            }
        }

        switch (self->params.variadic) {
            case .Some(variadic) => {
                switch (variadic) {
                    case .Typed { ty, .. } => {
                        if (ty.contains_infer_var()) {
                            return true;
                        }
                    }
                }
            }
        }

        return false;
    }
}

pub struct MethodDecl {
    /// Object name is used for name-mangling.
    pub object_name: Option<String>,
    pub func_decl: FuncDecl,
    pub body: Option<BodyId>,

    pub fn is_instance_method(self: const Self*) bool {
        return self->func_decl.params.is_instance_method();
    }
}

pub struct TypedefDecl {
    pub name: String,
    pub ty: SemaType*,
    pub generic_params: TypedGenericParams,
    pub vis: ast::ASTVisibility,
    pub span: Span,
}

pub struct InterfaceDecl {
    pub name: String,
    pub methods: MethodDecls,
    pub generic_params: TypedGenericParams,
    pub is_interface_dynamically_dispatchable: bool,
    pub vis: ast::ASTVisibility,
    pub span: Span,

    pub fn is_generic(self: const Self*) bool {
        return !self->generic_params.is_empty();
    }

    pub fn method_index(self: const Self*, name: const uint8*) Option<usize> {
        for (var i: usize = 0; i < self->methods.entries.len(); i += 1) {
            const entry = self->methods.entries.get_const(i).unwrap();

            if (strcmp(entry->name.as_str_const(), name) == 0) {
                return .Some(i);
            }
        }

        return .None;
    }

    pub fn get_method(self: const Self*, name: const uint8*) Option<MethodDeclId> {
        return self->methods.get(name);
    }
}

pub struct GlobalVarDecl {
    pub file_id: SourceId,
    pub name: String,
    pub ty: Option<SemaType>,
    pub rhs: Option<TypedExpr>,
    pub is_const: bool,
    pub is_static: bool,
    pub analyzed: bool,
    pub modifiers: ast::ASTGlobalVarModifiers,
    pub span: Span,
}

pub struct VarDecl {
    pub name: String,
    pub ty: Option<SemaType>,
    pub rhs: Option<TypedExpr>,
    pub is_const: bool,
    pub analyzed: bool,
    pub span: Span,
}

pub struct TypedProgramTree {
    pub file_id: SourceId,
    pub body: Vec<TypedStmt>,
    pub file_name: String,
    pub module_name: String,
}