import std::collections{Vec};
import std::mem{Allocator};
import std::string{String};

import parser::ast;

pub fn format_module_segments(
    allocator: Allocator,
    segments: const Vec<ast::ASTModuleSegment>*
) String {
    return format_module_segments_upto(allocator, segments, segments->len());
}

/// Formats the first `count` segments of an import path.
pub fn format_module_segments_upto(
    allocator: Allocator,
    segments: const Vec<ast::ASTModuleSegment>*,
    count: usize,
) String {
    var out = String.new(allocator);
    var limit = segments->len();

    if (count < limit) {
        limit = count;
    }

    for (var i: usize = 0; i < limit; i += 1) {
        const seg = segments->get_const(i).unwrap();

        switch (*seg) {
            case .SubModule(ident) => {
                out.push_str(ident.str.as_str_const());

                if (i + 1 < limit) {
                    const next = segments->get_const(i + 1).unwrap();

                    switch (*next) {
                        case .SubModule => out.push_str("::");
                    }
                }
            }
            case .Single(singles) => {
                out.push('{');

                for (var j: usize = 0; j < singles.len(); j += 1) {
                    const single = singles.get_const(j).unwrap();

                    switch (single->renamed) {
                        case .Some(renamed) => {
                            out.push_str(renamed.str.as_str_const());
                            out.push(':');
                        }
                    }

                    out.push_str(single->ident.str.as_str_const());

                    if (j + 1 != singles.len()) {
                        out.push_str(", ");
                    }
                }

                out.push('}');
            }
        }
    }

    return out;
}

pub fn format_sub_module_names(allocator: Allocator, names: const Vec<String>*) String {
    var out = String.new(allocator);

    for (var i: usize = 0; i < names->len(); i += 1) {
        const name = names->get_const(i).unwrap();

        if (i > 0) {
            out.push_str("::");
        }
        out.push_str(name->as_str_const());
    }

    return out;
}

pub fn sub_module_names(allocator: Allocator, segments: const Vec<ast::ASTModuleSegment>*) Vec<String> {
    var names: Vec<String> = Vec.new(allocator);

    for (var i: usize = 0; i < segments->len(); i += 1) {
        const seg = segments->get_const(i).unwrap();

        switch (*seg) {
            case .SubModule(ident) => names.push(String.from_str(allocator, ident.str.as_str_const()));
        }
    }

    return names;
}

/// Formats AST types into displayable strings.
pub struct TypeFormatter {
    allocator: Allocator,
    program: const ast::ASTProgram*,

    pub fn new(allocator: Allocator, program: const ast::ASTProgram*) Self {
        return Self {
            allocator,
            program,
        };
    }

    pub fn display(self: const Self*, ty: const ast::ASTType*) String {
        switch (*ty) {
            case .ModuleImport(module_import) => {
                return format_module_segments(self->allocator, &module_import.segments);
            }
            case .Ident(ident) => {
                return String.from_str(self->allocator, ident.str.as_str_const());
            }
            case .Primitive(prim) => {
                return String.from_str(self->allocator, prim.as_str());
            }
            case .SelfType => {
                return String.from_str(self->allocator, "Self");
            }
            case .Pointer(inner) => {
                const node = self->program->nodes.get_const(inner).unwrap();

                var inner_name = String.new(self->allocator);

                switch (*node) {
                    case .Type(inner_ty) => {
                        var name = self->display(&inner_ty);
                        inner_name.push('*');
                        inner_name.push_str(name.as_str_const());
                        name.free();
                    }
                    else => {
                        inner_name.push('*');
                    }
                }

                return inner_name;
            }
            case .Const(inner) => {
                const node = self->program->nodes.get_const(inner).unwrap();

                var inner_name = String.new(self->allocator);

                switch (*node) {
                    case .Type(inner_ty) => {
                        var name = self->display(&inner_ty);
                        inner_name.push_str("const ");
                        inner_name.push_str(name.as_str_const());
                        name.free();
                    }
                    else => {
                        inner_name.push_str("const");
                    }
                }

                return inner_name;
            }
            // TODO: Implement format for other types also.
            else => {
                return String.from_str(self->allocator, "type");
            }
        }
    }
}