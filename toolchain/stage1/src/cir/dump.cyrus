import std::format{format_usize};
import std::collections{Vec};
import std::string{String};
import std::mem{Allocator};
import std::option{Option};
import std::io{Writer};

import resolver::symbols{GlobalSymbolRegistry};
import cir::tables{DeclTables};
import analyzer::format;
import cir;

pub fn dump_cir(
    registry: const GlobalSymbolRegistry*,
    tables: const DeclTables*,
    trees: const Vec<cir::ProgramTree>*,
    writer: Writer,
    allocator: Allocator
) {
    var ctx = DumpContext {
        writer,
        allocator,
        registry,
        tables,
    };

    ctx.dump(trees);
}

struct DumpContext {
    writer: Writer,
    allocator: Allocator,
    registry: const GlobalSymbolRegistry*,
    tables: const DeclTables*,

    fn write(self: Self*, text: const uint8*) {
        self->writer.write(text);
    }

    fn write_owned(self: Self*, var text: String) {
        self->writer.write(text.as_str_const());
        text.free();
    }

    fn write_bool(self: Self*, value: bool) {
        if (value) {
            self->write("true");
        } else {
            self->write("false");
        }
    }

    fn indent(self: Self*, depth: usize) {
        for (var i: usize = 0; i < depth; i += 1) {
            self->write("  ");
        }
    }

    fn write_type(self: Self*, ty: const cir::SemaType*) {
        self->write_owned(format::format_sema_type(
            self->allocator,
            self->tables,
            ty
        ));
    }

    fn write_opt_type(self: Self*, ty: const Option<cir::SemaType>*) {
        switch (*ty) {
            case .Some(value) => self->write_type(&value);
            case .None => self->write("?");
        }
    }

    fn write_opt_name(self: Self*, name: const Option<String>*) {
        switch (*name) {
            case .Some(value) => self->write(value.as_str_const());
            case .None => self->write("<anon>");
        }
    }

    fn write_expr(self: Self*, expr: const cir::Expr*) {
        self->write_owned(format::format_typed_expr(
            self->allocator,
            self->registry,
            self->tables,
            expr
        ));
    }

    fn write_expr_typed(self: Self*, expr: const cir::Expr*) {
        self->write_expr(expr);
    }

    fn write_impls(self: Self*, impls: const Vec<cir::ImplementInterface>*) {
        if (impls->len() == 0) {
            return;
        }

        self->write(" impls (");

        for (var i: usize = 0; i < impls->len(); i += 1) {
            const item = impls->get_const(i).unwrap();
            
            self->write_type(&item->ty);

            if (i + 1 != impls->len()) {
                self->write(", ");
            }
        }

        self->write(")");
    }

    fn write_func_params(self: Self*, params: const cir::FuncParams*) {
        self->write("(");

        for (var i: usize = 0; i < params->list.len(); i += 1) {
            const param = params->list.get_const(i).unwrap();

            switch (*param) {
                case .SelfModifier(self_modifier) => {
                    self->write("self: ");
                    self->write_type(&self_modifier.ty);
                }
                case .FuncParam(param) => {
                    self->write(param.ident.str.as_str_const());
                    self->write(": ");
                    self->write_type(&param.ty);
                }
            }

            if (i + 1 != params->list.len() || params->variadic.is_some()) {
                self->write(", ");
            }
        }

        switch (params->variadic) {
            case .Some(variadic) => {
                switch (variadic) {
                    case .Typed { ty, .. } => {
                        self->write_type(&ty);
                        self->write("...");
                    }
                    case .UntypedCStyle => {
                        self->write("...");
                    }
                }
            }
            case .None => {}
        }

        self->write(")");
    }

    fn write_method_header(self: Self*, decl: const cir::MethodDecl*) {
        self->write("fn ");

        switch (decl->object_name) {
            case .Some(object_name) => {
                self->write(object_name.as_str_const());
                self->write("::");
            }
            case .None => {}
        }

        self->write(decl->func_decl.name.as_str_const());
        self->write_func_params(&decl->func_decl.params);
        self->write(" ");
        self->write_type(&decl->func_decl.ret_type);
    }

    fn write_variants(self: Self*, variants: const Vec<cir::EnumVariant>*) {
        for (var i: usize = 0; i < variants->len(); i += 1) {
            const variant = variants->get_const(i).unwrap();

            switch (*variant) {
                case .Unit(ident) => {
                    self->write(ident.str.as_str_const());
                }
                case .Valued { ident, value } => {
                    self->write(ident.str.as_str_const());
                    self->write(" = ");
                    self->write_expr(value);
                }
                case .Tuple { ident, fields } => {
                    self->write(ident.str.as_str_const());
                    self->write("(");

                    for (var j: usize = 0; j < fields.len(); j += 1) {
                        const field = fields.get_const(j).unwrap();
                        self->write_type(&field->ty);

                        if (j + 1 != fields.len()) {
                            self->write(", ");
                        }
                    }

                    self->write(")");
                }
                case .Struct { ident, fields } => {
                    self->write(ident.str.as_str_const());
                    self->write(" { ");

                    for (var j: usize = 0; j < fields.len(); j += 1) {
                        const field = fields.get_const(j).unwrap();
                        
                        self->write(field->name.str.as_str_const());
                        self->write(": ");
                        self->write_type(&field->ty);

                        if (j + 1 != fields.len()) {
                            self->write(", ");
                        }
                    }

                    self->write(" }");
                }
            }

            if (i + 1 != variants->len()) {
                self->write(", ");
            }
        }
    }

    fn write_export_pattern(self: Self*, pattern: const cir::TupleExportPattern*) {
        switch (pattern->kind) {
            case .Tuple(elements) => {
                self->write("(");

                for (var i: usize = 0; i < elements.len(); i += 1) {
                    const element = elements.get_const(i).unwrap();
                    
                    self->write_export_pattern(element);

                    if (i + 1 != elements.len()) {
                        self->write(", ");
                    }
                }

                self->write(")");
            }
            case .Ident(var_decl_id) => {
                switch (self->tables->vars.get(var_decl_id)) {
                    case .Some(var_decl) => self->write(var_decl->name.as_str_const());
                    case .None => self->write("<unknown>");
                }
            }
            case .Ignore => {
                self->write("_");
            }
        }
    }

    fn write_switch_pattern(self: Self*, pattern: const cir::SwitchCasePattern*) {
        switch (pattern->kind) {
            case .Wildcard => {
                self->write("_");
            }
            case .Binding { name, .. } => {
                self->write(name.str.as_str_const());
            }
            case .Range(range) => {
                self->write_expr(&range.lower);

                if (range.inclusive_upper) {
                    self->write("..=");
                } else {
                    self->write("..");
                }

                self->write_expr(&range.upper);
            }
            case .Expr(expr) => {
                self->write_expr(&expr);
            }
            case .EnumUnit(ident) => {
                self->write(".");
                self->write(ident.str.as_str_const());
            }
            case .EnumTupleVariant { ident, items } => {
                self->write(".");
                self->write(ident.str.as_str_const());
                self->write("(");

                for (var i: usize = 0; i < items.len(); i += 1) {
                    const item = items.get_const(i).unwrap();
                    
                    self->write_switch_pattern(item);

                    if (i + 1 != items.len()) {
                        self->write(", ");
                    }
                }

                self->write(")");
            }
            case .EnumStructVariant { ident, items, ignore } => {
                self->write(".");
                self->write(ident.str.as_str_const());
                self->write(" { ");

                for (var i: usize = 0; i < items.len(); i += 1) {
                    const item = items.get_const(i).unwrap();
                    
                    self->write(item->name.str.as_str_const());
                    self->write(": ");
                    self->write_switch_pattern(&item->pattern);

                    if (i + 1 != items.len() || ignore) {
                        self->write(", ");
                    }
                }

                if (ignore) {
                    self->write("..");
                }

                self->write(" }");
            }
        }
    }

    fn write_var_content(self: Self*, var_stmt: const cir::VarStmt*) {
        if (var_stmt->is_const) {
            self->write("const ");
        } else {
            self->write("var ");
        }

        self->write(var_stmt->name.as_str_const());
        self->write(": ");
        self->write_opt_type(&var_stmt->ty);

        switch (var_stmt->rhs) {
            case .Some(rhs) => {
                self->write(" = ");
                self->write_expr(&rhs);
            }
            case .None => {
                if (var_stmt->is_undef) {
                    self->write(" = undefined");
                }
            }
        }
    }

    fn write_global_var_content(self: Self*, global_stmt: const cir::GlobalVarStmt*) {
        if (global_stmt->is_static) {
            self->write("static ");
        }

        if (global_stmt->is_const) {
            self->write("const ");
        }

        self->write("global ");
        self->write(global_stmt->name.as_str_const());
        self->write(": ");
        self->write_opt_type(&global_stmt->ty);

        switch (global_stmt->rhs) {
            case .Some(rhs) => {
                self->write(" = ");
                self->write_expr(&rhs);
            }
            case .None => {
                if (global_stmt->is_undef) {
                    self->write(" = undefined");
                }
            }
        }
    }

    fn write_var_decl(self: Self*, decl: const cir::VarDecl*) {
        if (decl->is_const) {
            self->write("const ");
        } else {
            self->write("var ");
        }

        self->write(decl->name.as_str_const());
        self->write(": ");
        self->write_opt_type(&decl->ty);

        switch (decl->rhs) {
            case .Some(rhs) => {
                self->write(" = ");
                self->write_expr(&rhs);
            }
            case .None => {}
        }
    }

    fn write_global_var_decl(self: Self*, decl: const cir::GlobalVarDecl*) {
        if (decl->is_static) {
            self->write("static ");
        }

        if (decl->is_const) {
            self->write("const ");
        }

        self->write("global ");
        self->write(decl->name.as_str_const());
        self->write(": ");
        self->write_opt_type(&decl->ty);

        switch (decl->rhs) {
            case .Some(rhs) => {
                self->write(" = ");
                self->write_expr(&rhs);
            }
            case .None => {}
        }
    }

    fn write_args(self: Self*, args: const Vec<cir::Expr>*) {
        self->write("(");

        for (var i: usize = 0; i < args->len(); i += 1) {
            const arg = args->get_const(i).unwrap();
            self->write_expr(arg);

            if (i + 1 != args->len()) {
                self->write(", ");
            }
        }

        self->write(")");
    }

    pub fn dump(self: Self*, trees: const Vec<cir::ProgramTree>*) {
        // Emit a clean categorized source file
        self->dump_tree_category(trees, 0);
        self->dump_tree_category(trees, 1);
        self->dump_tree_category(trees, 2);
        self->dump_tree_category(trees, 3);
        self->dump_tree_category(trees, 5);
        self->dump_tree_category(trees, 4);
        self->dump_method_bodies();
    }

    fn decl_category(self: Self*, stmt: const cir::Stmt*) usize {
        switch (stmt->kind) {
            case .Interface => return 0;
            case .Struct => return 1;
            case .Enum => return 2;
            case .Union => return 3;
            case .FuncDef | .FuncDecl => return 4;
            else => return 5;
        }
    }

    fn dump_tree_category(self: Self*, trees: const Vec<cir::ProgramTree>*, category: usize) {
        for (var i: usize = 0; i < trees->len(); i += 1) {
            const tree = trees->get_const(i).unwrap();
            self->dump_tree_stmts_category(&tree->body, category);
        }
    }

    fn dump_tree_stmts_category(self: Self*, stmts: const Vec<cir::Stmt>*, category: usize) {
        for (var i: usize = 0; i < stmts->len(); i += 1) {
            const stmt = stmts->get_const(i).unwrap();

            if (self->decl_category(stmt) == category) {
                self->dump_stmt(stmt, 0);
            }
        }
    }

    fn dump_method_bodies(self: Self*) {
        for (var i: usize = 0; i < self->tables->methods.len(); i += 1) {
            const decl = self->tables->methods.get_const(i).unwrap();
            self->write_method_header(decl);

            switch (decl->body) {
                case .Some(body_id) => {
                    const block = self->tables->bodies.get_const(body_id).unwrap();
                    self->write(" {\n");
                    self->dump_block_body(block, 0);
                    self->write("}\n");
                }
                case .None => {
                    self->write(";\n");
                }
            }
        }
    }

    fn dump_stmts(self: Self*, stmts: const Vec<cir::Stmt>*, depth: usize) {
        for (var i: usize = 0; i < stmts->len(); i += 1) {
            const stmt = stmts->get_const(i).unwrap();
            self->dump_stmt(stmt, depth);
        }
    }

    fn dump_block_body(self: Self*, block: const cir::BlockStmt*, depth: usize) {
        self->dump_stmts(&block->stmts, depth + 1);

        for (var i: usize = 0; i < block->defers.len(); i += 1) {
            const defer_stmt = block->defers.get_const(i).unwrap();

            self->indent(depth + 1);
            self->write("defer {\n");
            self->dump_stmt(defer_stmt->operand, depth + 2);
            self->indent(depth + 1);
            self->write("}\n");
        }
    }

    fn dump_if(self: Self*, if_stmt: const cir::IfStmt*, depth: usize) {
        self->write("if ");
        self->write_expr(&if_stmt->cond);
        self->write(" {\n");
        self->dump_block_body(if_stmt->then_block, depth);
        self->indent(depth);
        self->write("}");

        for (var i: usize = 0; i < if_stmt->branches.len(); i += 1) {
            const branch = if_stmt->branches.get_const(i).unwrap();

            self->write(" else if ");
            self->write_expr(&branch->cond);
            self->write(" {\n");
            self->dump_block_body(branch->then_block, depth);
            self->indent(depth);
            self->write("}");
        }

        switch (if_stmt->else_block) {
            case .Some(block) => {
                self->write(" else {\n");
                self->dump_block_body(block, depth);
                self->indent(depth);
                self->write("}");
            }
            case .None => {}
        }

        self->write("\n");
    }

    fn dump_stmt(self: Self*, stmt: const cir::Stmt*, depth: usize) {
        self->indent(depth);

        if (stmt->is_dead) {
            self->write("[dead] ");
        }

        switch (stmt->kind) {
            case .Expr(expr) => {
                self->write_expr_typed(&expr);
                self->write(";\n");
            }
            case .Variable(var_stmt) => {
                self->write_var_content(&var_stmt);
                self->write(";\n");
            }
            case .GlobalVar(global_stmt) => {
                self->write_global_var_content(&global_stmt);
                self->write(";\n");
            }
            case .BlockStmt(block) => {
                self->write("{\n");
                self->dump_block_body(&block, depth);
                self->indent(depth);
                self->write("}\n");
            }
            case .If(if_stmt) => self->dump_if(&if_stmt, depth);
            case .While(while_stmt) => {
                self->write("while ");
                self->write_expr(&while_stmt.cond);
                self->write(" {\n");
                self->dump_block_body(while_stmt.body, depth);
                self->indent(depth);
                self->write("}\n");
            }
            case .For(for_stmt) => {
                self->write("for (");

                switch (for_stmt.initializer) {
                    case .Some(initializer) => self->write_var_content(&initializer);
                    case .None => {}
                }

                self->write("; ");

                switch (for_stmt.cond) {
                    case .Some(cond) => self->write_expr(&cond);
                    case .None => {}
                }

                self->write("; ");

                switch (for_stmt.increment) {
                    case .Some(increment) => self->write_expr(&increment);
                    case .None => {}
                }

                self->write(") {\n");
                self->dump_block_body(for_stmt.body, depth);
                self->indent(depth);
                self->write("}\n");
            }
            case .Return(return_stmt) => {
                self->write("return");

                switch (return_stmt.arg) {
                    case .Some(arg) => {
                        self->write(" ");
                        self->write_expr_typed(&arg);
                    }
                    case .None => {}
                }

                self->write(";\n");
            }
            case .Break => self->write("break;\n");
            case .Continue => self->write("continue;\n");
            case .Switch(switch_stmt) => self->dump_switch(&switch_stmt, depth);
            case .FuncDef(func_def) => {
                self->write("fn ");
                self->write(func_def.name.as_str_const());
                self->write_func_params(&func_def.params);
                self->write(" ");
                self->write_type(&func_def.ret_type);
                self->write(" {\n");
                self->dump_block_body(func_def.body, depth);
                self->indent(depth);
                self->write("}\n");
            }
            case .FuncDecl(func_decl) => {
                self->write("fn ");
                self->write(func_decl.name.as_str_const());
                self->write_func_params(&func_decl.params);
                self->write(" ");
                self->write_type(&func_decl.ret_type);
                self->write(";\n");
            }
            case .Struct(struct_stmt) => {
                self->write("struct ");
                self->write(struct_stmt.name.as_str_const());
                self->write(" { ");

                for (var j: usize = 0; j < struct_stmt.fields.len(); j += 1) {
                    const field = struct_stmt.fields.get_const(j).unwrap();
                    self->write(field->name.as_str_const());
                    self->write(": ");
                    self->write_type(&field->ty);

                    if (j + 1 != struct_stmt.fields.len()) {
                        self->write(", ");
                    }
                }

                self->write(" }");
                self->write_impls(&struct_stmt.impls);
                self->write("\n");
            }
            case .Union(union_stmt) => {
                self->write("union ");
                self->write(union_stmt.name.as_str_const());
                self->write(" { ");

                for (var j: usize = 0; j < union_stmt.fields.len(); j += 1) {
                    const field = union_stmt.fields.get_const(j).unwrap();
                    self->write(field->name.as_str_const());
                    self->write(": ");
                    self->write_type(&field->ty);

                    if (j + 1 != union_stmt.fields.len()) {
                        self->write(", ");
                    }
                }

                self->write(" }");
                self->write_impls(&union_stmt.impls);
                self->write("\n");
            }
            case .Enum(enum_stmt) => {
                self->write("enum ");
                self->write(enum_stmt.name.as_str_const());

                switch (enum_stmt.tag_type) {
                    case .Some(tag_type) => {
                        self->write(" : ");
                        self->write_type(&tag_type);
                    }
                    case .None => {}
                }

                self->write(" { ");
                self->write_variants(&enum_stmt.variants);
                self->write(" }");
                self->write_impls(&enum_stmt.impls);
                self->write("\n");
            }
            case .Interface(interface_stmt) => {
                self->write("interface ");
                self->write(interface_stmt.name.as_str_const());
                self->write(" { ");

                for (var j: usize = 0; j < interface_stmt.methods.entries.len(); j += 1) {
                    const entry = interface_stmt.methods.entries.get_const(j).unwrap();
                    self->write(entry->name.as_str_const());

                    if (j + 1 != interface_stmt.methods.entries.len()) {
                        self->write(", ");
                    }
                }

                self->write(" }\n");
            }
            case .Typedef(typedef_stmt) => {
                self->write("typedef ");
                self->write(typedef_stmt.name.as_str_const());
                self->write(" = ");
                self->write_type(&typedef_stmt.ty);
                self->write(";\n");
            }
            case .TupleExport(export_stmt) => {
                if (export_stmt.is_const) {
                    self->write("const ");
                }

                self->write_export_pattern(&export_stmt.pattern);
                self->write(" = ");

                switch (export_stmt.rhs) {
                    case .Some(rhs) => self->write_expr_typed(&rhs);
                    case .None => self->write("undefined");
                }

                self->write(";\n");
            }
            case .InlineAsm(asm_stmt) => {
                self->write("asm");

                if (asm_stmt.is_volatile) {
                    self->write(" volatile");
                }

                self->write(" {\n");

                for (var j: usize = 0; j < asm_stmt.template.len(); j += 1) {
                    const line = asm_stmt.template.get_const(j).unwrap();
                    self->indent(depth + 1);
                    self->write("\"");
                    self->write(line->as_str_const());
                    self->write("\"\n");
                }

                self->indent(depth + 1);
                self->write("outputs=");
                format_usize(self->writer, asm_stmt.outputs.len());
                self->write(" inputs=");
                format_usize(self->writer, asm_stmt.inputs.len());
                self->write(" clobbers=");
                format_usize(self->writer, asm_stmt.clobbers.len());
                self->write("\n");
                self->indent(depth);
                self->write("}\n");
            }
            case .Builtin(builtin_stmt) => {
                switch (builtin_stmt) {
                    case .BuiltinFunc(func) => {
                        self->write("builtin ");
                        self->write(func.name.str.as_str_const());
                        self->write_args(&func.args);
                        self->write(";\n");
                    }
                    case .BuiltinBlock(block) => {
                        self->write("builtin ");
                        self->write(block.name.str.as_str_const());
                        self->write_args(&block.args);
                        self->write(" {\n");
                        self->dump_block_body(block.block, depth);
                        self->indent(depth);
                        self->write("}\n");
                    }
                }
            }
            case .Label(label_stmt) => {
                self->write("label ");
                self->write(label_stmt.name.as_str_const());
                self->write(":\n");
            }
            case .Goto(goto_stmt) => {
                self->write("goto ");
                self->write(goto_stmt.name.as_str_const());
                self->write(";\n");
            }
            case .Defer(defer_stmt) => {
                self->write("defer {\n");
                self->dump_stmt(defer_stmt.operand, depth + 1);
                self->indent(depth);
                self->write("}\n");
            }
        }
    }

    fn dump_switch(self: Self*, switch_stmt: const cir::SwitchStmt*, depth: usize) {
        self->write("switch ");
        self->write_expr(&switch_stmt->operand);
        self->write(" {\n");

        for (var i: usize = 0; i < switch_stmt->cases.len(); i += 1) {
            const switch_case = switch_stmt->cases.get_const(i).unwrap();

            self->indent(depth + 1);
            self->write("case ");

            for (var j: usize = 0; j < switch_case->patterns.len(); j += 1) {
                const pattern = switch_case->patterns.get_const(j).unwrap();
                self->write_switch_pattern(pattern);

                if (j + 1 != switch_case->patterns.len()) {
                    self->write(", ");
                }
            }

            self->write(": {\n");
            self->dump_block_body(switch_case->body, depth + 1);
            self->indent(depth + 1);
            self->write("}\n");
        }

        switch (switch_stmt->else_case) {
            case .Some(default_block) => {
                self->indent(depth + 1);
                self->write("else {\n");
                self->dump_block_body(&default_block, depth + 1);
                self->indent(depth + 1);
                self->write("}\n");
            }
            case .None => {}
        }

        switch (switch_stmt->all_cases_covered) {
            case .Some(covered) => {
                self->indent(depth + 1);
                self->write("all_cases_covered=");
                self->write_bool(covered);
                self->write("\n");
            }
            case .None => {}
        }

        self->indent(depth);
        self->write("}\n");
    }
}
